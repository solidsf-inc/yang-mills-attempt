noncomputable section

namespace JesseMath.Unified.MetriplecticScaleComb

/-!
# Contender Alpha: The Scale-Phase Metriplectic & Bregman-Information Comb
==========================================================================
Couples reversible symplectic Poisson flow `{A, H}_J` with a symmetric positive-semidefinite
sub-grid Fisher–Rao / Bregman metric `(A, S)_G` satisfying the Morrison–Kaufman degeneracy
conditions `G ∇H = 0` and `J ∇S = 0`. Proves exact scale-invariant generalized energy
conservation `H_comb(k) = H_k + kT ∑_{j<k} ΔI_j = H_0`, two-sided Gibbs–Bogoliubov–Feynman /
Bregman free-energy sandwich contraction across resolution octaves, and Fisher information
superadditivity across scale teeth.
-/

/-! ## Section 1: Double-Generator Metriplectic Scale-Time Flow -/

/-- Canonical 2D Poisson bracket `{A, B}_J = dA_dq * dB_dp - dA_dp * dB_dq`. -/
def poissonBracket2D (dA_dq dA_dp dB_dq dB_dp : ℝ) : ℝ :=
  dA_dq * dB_dp - dA_dp * dB_dq

/-- Symmetric bilinear metric pairing `(A, B)_G` on 2D phase space. -/
def metricPairing2D (g_qq g_qp g_pp dA_dq dA_dp dB_dq dB_dp : ℝ) : ℝ :=
  g_qq * dA_dq * dB_dq + g_qp * (dA_dq * dB_dp + dA_dp * dB_dq) + g_pp * dA_dp * dB_dp

/-- Metriplectic scale-time evolution rate of an observable `A` generated by Hamiltonian `H`
    and scale entropy `S` at thermal scale `kT`:
    `dA/dτ = {A, H}_J + kT * (A, S)_G`. -/
def metriplecticFlowRate2D
    (g_qq g_qp g_pp kT dA_dq dA_dp dH_dq dH_dp dS_dq dS_dp : ℝ) : ℝ :=
  poissonBracket2D dA_dq dA_dp dH_dq dH_dp +
    kT * metricPairing2D g_qq g_qp g_pp dA_dq dA_dp dS_dq dS_dp

/-- **Theorem 1 (`metriplectic_energy_conservation_2D`)**:
    When the metric tensor `G` annihilates the Hamiltonian gradient (`G ∇H = 0`),
    the Hamiltonian `H` is strictly conserved (`dH/dτ = 0`) along the joint scale-time flow. -/
theorem metriplectic_energy_conservation_2D
    (g_qq g_qp g_pp kT dH_dq dH_dp dS_dq dS_dp : ℝ)
    (hDeg1 : g_qq * dH_dq + g_qp * dH_dp = 0)
    (hDeg2 : g_qp * dH_dq + g_pp * dH_dp = 0) :
    metriplecticFlowRate2D g_qq g_qp g_pp kT dH_dq dH_dp dH_dq dH_dp dS_dq dS_dp = 0 := by
  dsimp [metriplecticFlowRate2D, poissonBracket2D, metricPairing2D]
  calc (dH_dq * dH_dp - dH_dp * dH_dq) +
      kT * (g_qq * dH_dq * dS_dq + g_qp * (dH_dq * dS_dp + dH_dp * dS_dq) + g_pp * dH_dp * dS_dp)
    _ = kT * ((g_qq * dH_dq + g_qp * dH_dp) * dS_dq + (g_qp * dH_dq + g_pp * dH_dp) * dS_dp) := by ring
    _ = kT * (0 * dS_dq + 0 * dS_dp) := by rw [hDeg1, hDeg2]
    _ = 0 := by ring

/-- **Theorem 2 (`metriplectic_entropy_production_nonneg_2D`)**:
    Sylvester Positive-Semidefinite Decomposition of `G_ℓ` and Non-Negative Sub-Grid Entropy Production.
    If `g_qq > 0`, `det(G) = g_qq * g_pp - g_qp^2 ≥ 0`, `kT ≥ 0`, and `{S, H}_J = 0`,
    then `dS/dτ ≥ 0`. -/
theorem metriplectic_entropy_production_nonneg_2D
    {g_qq g_qp g_pp kT dH_dq dH_dp dS_dq dS_dp : ℝ}
    (hg_qq : 0 < g_qq)
    (hdet : 0 ≤ g_qq * g_pp - g_qp ^ 2)
    (hkT : 0 ≤ kT)
    (hSympDeg : poissonBracket2D dS_dq dS_dp dH_dq dH_dp = 0) :
    0 ≤ metriplecticFlowRate2D g_qq g_qp g_pp kT dS_dq dS_dp dH_dq dH_dp dS_dq dS_dp := by
  dsimp [metriplecticFlowRate2D]
  rw [hSympDeg, zero_add]
  have hquad : metricPairing2D g_qq g_qp g_pp dS_dq dS_dp dS_dq dS_dp =
      ((g_qq * dS_dq + g_qp * dS_dp) ^ 2 + (g_qq * g_pp - g_qp ^ 2) * dS_dp ^ 2) / g_qq := by
    dsimp [metricPairing2D]
    have hg_ne : g_qq ≠ 0 := ne_of_gt hg_qq
    apply mul_right_cancel₀ hg_ne
    rw [div_mul_cancel₀ _ hg_ne]
    ring
  rw [hquad]
  have hnum : 0 ≤ (g_qq * dS_dq + g_qp * dS_dp) ^ 2 + (g_qq * g_pp - g_qp ^ 2) * dS_dp ^ 2 := by
    positivity
  have hdiv : 0 ≤ ((g_qq * dS_dq + g_qp * dS_dp) ^ 2 + (g_qq * g_pp - g_qp ^ 2) * dS_dp ^ 2) / g_qq :=
    div_nonneg hnum (le_of_lt hg_qq)
  exact mul_nonneg hkT hdiv

/-- **Theorem 3 (`metriplectic_free_energy_lyapunov_dissipation`)**:
    The Generalized Scale Free Energy `F = H - kT * S` (with gradient `∇F = ∇H - kT ∇S`)
    monotonically dissipates (`dF/dτ ≤ 0`) along the metriplectic scale-time flow:
    `dF/dτ = - kT^2 * (S, S)_G ≤ 0`. -/
theorem metriplectic_free_energy_lyapunov_dissipation
    {g_qq g_qp g_pp kT dH_dq dH_dp dS_dq dS_dp : ℝ}
    (hg_qq : 0 < g_qq)
    (hdet : 0 ≤ g_qq * g_pp - g_qp ^ 2)
    (hDeg1 : g_qq * dH_dq + g_qp * dH_dp = 0)
    (hDeg2 : g_qp * dH_dq + g_pp * dH_dp = 0)
    (hSympDeg : poissonBracket2D dS_dq dS_dp dH_dq dH_dp = 0) :
    let dF_dq := dH_dq - kT * dS_dq
    let dF_dp := dH_dp - kT * dS_dp
    metriplecticFlowRate2D g_qq g_qp g_pp kT dF_dq dF_dp dH_dq dH_dp dS_dq dS_dp =
      - (kT ^ 2) * metricPairing2D g_qq g_qp g_pp dS_dq dS_dp dS_dq dS_dp ∧
    metriplecticFlowRate2D g_qq g_qp g_pp kT dF_dq dF_dp dH_dq dH_dp dS_dq dS_dp ≤ 0 := by
  intro dF_dq dF_dp
  have h_ident : metriplecticFlowRate2D g_qq g_qp g_pp kT dF_dq dF_dp dH_dq dH_dp dS_dq dS_dp =
      - (kT ^ 2) * metricPairing2D g_qq g_qp g_pp dS_dq dS_dp dS_dq dS_dp := by
    dsimp [metriplecticFlowRate2D, poissonBracket2D, metricPairing2D, dF_dq, dF_dp]
    dsimp [poissonBracket2D] at hSympDeg
    calc ((dH_dq - kT * dS_dq) * dH_dp - (dH_dp - kT * dS_dp) * dH_dq) +
        kT * (g_qq * (dH_dq - kT * dS_dq) * dS_dq +
          g_qp * ((dH_dq - kT * dS_dq) * dS_dp + (dH_dp - kT * dS_dp) * dS_dq) +
          g_pp * (dH_dp - kT * dS_dp) * dS_dp)
      _ = - kT * (dS_dq * dH_dp - dS_dp * dH_dq) +
          kT * ((g_qq * dH_dq + g_qp * dH_dp) * dS_dq + (g_qp * dH_dq + g_pp * dH_dp) * dS_dp) -
          (kT ^ 2) * (g_qq * dS_dq * dS_dq + g_qp * (dS_dq * dS_dp + dS_dp * dS_dq) + g_pp * dS_dp * dS_dp) := by ring
      _ = - kT * 0 + kT * (0 * dS_dq + 0 * dS_dp) -
          (kT ^ 2) * (g_qq * dS_dq * dS_dq + g_qp * (dS_dq * dS_dp + dS_dp * dS_dq) + g_pp * dS_dp * dS_dp) := by
          rw [hSympDeg, hDeg1, hDeg2]
      _ = - (kT ^ 2) * (g_qq * dS_dq * dS_dq + g_qp * (dS_dq * dS_dp + dS_dp * dS_dq) + g_pp * dS_dp * dS_dp) := by ring
  refine ⟨h_ident, ?_⟩
  rw [h_ident]
  have hquad : metricPairing2D g_qq g_qp g_pp dS_dq dS_dp dS_dq dS_dp =
      ((g_qq * dS_dq + g_qp * dS_dp) ^ 2 + (g_qq * g_pp - g_qp ^ 2) * dS_dp ^ 2) / g_qq := by
    dsimp [metricPairing2D]
    have hg_ne : g_qq ≠ 0 := ne_of_gt hg_qq
    apply mul_right_cancel₀ hg_ne
    rw [div_mul_cancel₀ _ hg_ne]
    ring
  rw [hquad]
  have h_nonneg : 0 ≤ (kT ^ 2) * (((g_qq * dS_dq + g_qp * dS_dp) ^ 2 + (g_qq * g_pp - g_qp ^ 2) * dS_dp ^ 2) / g_qq) := by
    positivity
  linarith

/-- Morrison–Kaufman canonical energy-shell projection metric pairing:
    projects phase-space gradients onto the tangent space of constant-`H` surfaces plus sub-grid modes. -/
def energyShellMetricPairing
    (gamma_shell eta_sub dH_dq dH_dp dA_dq dA_dp dA_sub dB_dq dB_dp dB_sub : ℝ) : ℝ :=
  gamma_shell * (dA_dq * dH_dp - dA_dp * dH_dq) * (dB_dq * dH_dp - dB_dp * dH_dq) +
    eta_sub * dA_sub * dB_sub

/-- **Theorem 4 (`canonical_casimir_energy_shell_projector_degeneracy_and_psd`)**:
    The Morrison–Kaufman energy-shell metric tensor unconditionally annihilates the
    Hamiltonian gradient (`(H, S)_G = 0`, where `dH_sub = 0`) and is positive-semidefinite
    (`(S, S)_G ≥ 0`) for all `gamma_shell ≥ 0, eta_sub ≥ 0`. -/
theorem canonical_casimir_energy_shell_projector_degeneracy_and_psd
    {gamma_shell eta_sub : ℝ} (hgamma : 0 ≤ gamma_shell) (heta : 0 ≤ eta_sub)
    (dH_dq dH_dp dS_dq dS_dp dS_sub : ℝ) :
    energyShellMetricPairing gamma_shell eta_sub dH_dq dH_dp dH_dq dH_dp 0 dS_dq dS_dp dS_sub = 0 ∧
    0 ≤ energyShellMetricPairing gamma_shell eta_sub dH_dq dH_dp dS_dq dS_dp dS_sub dS_dq dS_dp dS_sub := by
  dsimp [energyShellMetricPairing]
  refine ⟨by ring, ?_⟩
  have hsq : gamma_shell * (dS_dq * dH_dp - dS_dp * dH_dq) * (dS_dq * dH_dp - dS_dp * dH_dq) +
      eta_sub * dS_sub * dS_sub =
      gamma_shell * (dS_dq * dH_dp - dS_dp * dH_dq) ^ 2 + eta_sub * dS_sub ^ 2 := by ring
  rw [hsq]
  positivity

/-! ## Section 2: Exact Bregman Information Defect & Scale-Invariant Generalized Hamiltonian -/

/-- Quartic Landau–Ginzburg convex potential `φ(u) = (alpha/2) u^2 + (beta/4) u^4`. -/
def quarticPotential (alpha beta u : ℝ) : ℝ :=
  (alpha / 2) * u ^ 2 + (beta / 4) * u ^ 4

/-- Derivative `φ'(v) = alpha v + beta v^3` of the quartic Landau–Ginzburg potential. -/
def quarticPotentialDeriv (alpha beta v : ℝ) : ℝ :=
  alpha * v + beta * v ^ 3

/-- Bregman divergence `D_φ(u ‖ v) = φ(u) - φ(v) - φ'(v) * (u - v)`. -/
def quarticBregmanDivergence (alpha beta u v : ℝ) : ℝ :=
  quarticPotential alpha beta u - quarticPotential alpha beta v - quarticPotentialDeriv alpha beta v * (u - v)

/-- **Theorem 5 (`bregman_quartic_divergence_exact_expansion_and_lower_bound`)**:
    For `alpha > 0` and `beta ≥ 0`, the quartic Bregman information defect expands into the
    exact sum-of-squares form `(alpha/2)(u - v)^2 + (beta/4)(u - v)^2 ((u + v)^2 + 2 v^2)`
    and satisfies the strong convexity lower bound `D_φ(u ‖ v) ≥ (alpha/2)(u - v)^2 ≥ 0`. -/
theorem bregman_quartic_divergence_exact_expansion_and_lower_bound
    {alpha beta : ℝ} (halpha : 0 < alpha) (hbeta : 0 ≤ beta) (u v : ℝ) :
    quarticBregmanDivergence alpha beta u v =
      (alpha / 2) * (u - v) ^ 2 + (beta / 4) * (u - v) ^ 2 * ((u + v) ^ 2 + 2 * v ^ 2) ∧
    (alpha / 2) * (u - v) ^ 2 ≤ quarticBregmanDivergence alpha beta u v ∧
    0 ≤ quarticBregmanDivergence alpha beta u v := by
  have hexp : quarticBregmanDivergence alpha beta u v =
      (alpha / 2) * (u - v) ^ 2 + (beta / 4) * (u - v) ^ 2 * ((u + v) ^ 2 + 2 * v ^ 2) := by
    dsimp [quarticBregmanDivergence, quarticPotential, quarticPotentialDeriv]
    ring
  have h_rem_nonneg : 0 ≤ (beta / 4) * (u - v) ^ 2 * ((u + v) ^ 2 + 2 * v ^ 2) := by
    positivity
  have h_quad_nonneg : 0 ≤ (alpha / 2) * (u - v) ^ 2 := by
    positivity
  refine ⟨hexp, ?_, ?_⟩
  · linarith
  · linarith

/-- Scale-Invariant Generalized Hamiltonian `H_comb(k) = H_k + kT * I_cum_k`. -/
def generalizedScaleHamiltonian (H_k kT I_cum_k : ℝ) : ℝ :=
  H_k + kT * I_cum_k

/-- **Theorem 6 (`scale_invariant_generalized_hamiltonian_step`)**:
    When coarse-graining from scale `k` to `k + 1` transfers energy `kT * dI_k` into
    sub-grid Bregman information (`H_{k+1} = H_k - kT * dI_k`, `I_cum_{k+1} = I_cum_k + dI_k`),
    the Generalized Scale Hamiltonian `H_comb` is strictly invariant (`H_comb(k+1) = H_comb(k)`),
    whereas the bare Hamiltonian loses `H_k - H_{k+1} = kT * dI_k ≥ 0`. -/
theorem scale_invariant_generalized_hamiltonian_step
    {H_k H_next kT I_cum_k dI_k : ℝ}
    (hkT : 0 ≤ kT) (hdI : 0 ≤ dI_k)
    (hCoarse : H_next = H_k - kT * dI_k) :
    generalizedScaleHamiltonian H_next kT (I_cum_k + dI_k) =
      generalizedScaleHamiltonian H_k kT I_cum_k ∧
    H_k - H_next = kT * dI_k ∧
    0 ≤ H_k - H_next := by
  dsimp [generalizedScaleHamiltonian]
  rw [hCoarse]
  refine ⟨by ring, by ring, ?_⟩
  have hprod : 0 ≤ kT * dI_k := mul_nonneg hkT hdI
  linarith

/-- **Theorem 7 (`four_scale_dyadic_comb_telescoping_invariance`)**:
    Across a 4-stage renormalization cascade `k = 0 → 1 → 2 → 3 → 4` where each step satisfies
    `H_{j+1} = H_j - kT * dI_j`, the Scale-Invariant Generalized Hamiltonian at scale 4 equals
    the exact fine-scale Hamiltonian `H_0`, while the bare Hamiltonian drifts by the total
    accumulated Bregman defect `kT * (dI_0 + dI_1 + dI_2 + dI_3)`. -/
theorem four_scale_dyadic_comb_telescoping_invariance
    {H0 H1 H2 H3 H4 kT dI0 dI1 dI2 dI3 : ℝ}
    (h1 : H1 = H0 - kT * dI0)
    (h2 : H2 = H1 - kT * dI1)
    (h3 : H3 = H2 - kT * dI2)
    (h4 : H4 = H3 - kT * dI3) :
    generalizedScaleHamiltonian H4 kT (dI0 + dI1 + dI2 + dI3) = H0 ∧
    H0 - H4 = kT * (dI0 + dI1 + dI2 + dI3) := by
  dsimp [generalizedScaleHamiltonian]
  rw [h4, h3, h2, h1]
  exact ⟨by ring, by ring⟩

/-- **Theorem 8 (`boltzmann_surprisal_subgrid_factorization_invariance`)**:
    For thermal energy scale `kT ≠ 0`, when the coarse Boltzmann weight is
    `W_coarse = exp(-H_next / kT)` and the conditional sub-grid fluctuation weight is
    `W_sub = exp(-dI_k)` where `H_next = H_k - kT * dI_k`, the joint entropic energy
    `(-kT) * log(W_coarse * W_sub)` reconstructs the fine-scale Hamiltonian `H_k` exactly. -/
theorem boltzmann_surprisal_subgrid_factorization_invariance
    {H_k H_next kT dI_k : ℝ} (hkT : kT ≠ 0)
    (hCoarse : H_next = H_k - kT * dI_k) :
    let W_coarse := Real.exp (- H_next / kT);
    let W_sub := Real.exp (- dI_k);
    (- kT) * Real.log (W_coarse * W_sub) = H_k := by
  intro W_coarse W_sub
  dsimp [W_coarse, W_sub]
  rw [← Real.exp_add, Real.log_exp]
  rw [hCoarse]
  have h_alg : (- kT) * (- (H_k - kT * dI_k) / kT + - dI_k) =
      H_k * (kT / kT) - kT * dI_k * (kT / kT) + kT * dI_k := by ring
  rw [h_alg, div_self hkT]
  ring

/-- **Theorem 9 (`kl_bregman_surprisal_divergence_nonneg`)**:
    For any positive unnormalized density weights `p > 0` and `q > 0`, the Kullback–Leibler /
    Boltzmann–Bregman divergence `D_KL(p ‖ q) = p * log(p / q) - p + q` is strictly non-negative. -/
theorem kl_bregman_surprisal_divergence_nonneg
    {p q : ℝ} (hp : 0 < p) (hq : 0 < q) :
    0 ≤ p * Real.log (p / q) - p + q := by
  have hqp_pos : 0 < q / p := div_pos hq hp
  have hexp : (q / p - 1) + 1 ≤ Real.exp (q / p - 1) := Real.add_one_le_exp (q / p - 1)
  have hexp' : q / p ≤ Real.exp (q / p - 1) := by linarith
  have hlog : Real.log (q / p) ≤ Real.log (Real.exp (q / p - 1)) :=
    Real.log_le_log hqp_pos hexp'
  rw [Real.log_exp] at hlog
  have hlog_inv : Real.log (q / p) = - Real.log (p / q) := by
    rw [← Real.log_inv, inv_div]
  rw [hlog_inv] at hlog
  have hmul : p * (- Real.log (p / q)) ≤ p * (q / p - 1) :=
    mul_le_mul_of_nonneg_left hlog (le_of_lt hp)
  have hp_ne : p ≠ 0 := ne_of_gt hp
  have hrhs : p * (q / p - 1) = q - p := by
    have h1 : p * (q / p - 1) = p * (q / p) - p := by ring
    rw [h1, mul_div_cancel₀ q hp_ne]
  linarith

/-! ## Section 3: Two-Sided Fine-Resolution Comb Bound & Fisher Resolution Gain -/

/-- Lower Bregman comb bound at resolution `ℓ` with unresolved sub-grid variance `V_sub`
    and curvature floor `chi_low`: `L(ℓ) = F_resolved(ℓ) + (chi_low / 2) * V_sub`. -/
def combLowerBound (F_resolved chi_low V_sub : ℝ) : ℝ :=
  F_resolved + (chi_low / 2) * V_sub

/-- Upper Gibbs–Bogoliubov–Feynman comb bound at resolution `ℓ` with unresolved sub-grid variance `V_sub`
    and curvature ceiling `chi_high`: `U(ℓ) = F_resolved(ℓ) + (chi_high / 2) * V_sub`. -/
def combUpperBound (F_resolved chi_high V_sub : ℝ) : ℝ :=
  F_resolved + (chi_high / 2) * V_sub

/-- **Theorem 10 (`two_sided_fine_resolution_comb_sandwich_contraction`)**:
    Probing at a finer resolution step `ℓ → ℓ + 1` contracts the unresolved sub-grid variance
    by `V_{ℓ+1} = rho * V_sub` with `0 < rho < 1` and resolves the intermediate shell energy
    `F_resolved(ℓ+1) = F_resolved(ℓ) + (1 - rho) * (chi_eff / 2) * V_sub` where `chi_low < chi_eff < chi_high`.
    Then:
    1. The lower bound strictly improves: `L(ℓ) < L(ℓ + 1)`,
    2. The upper bound strictly improves: `U(ℓ + 1) < U(ℓ)`,
    3. Both tighten the sandwich around the exact UV free energy `F_exact = F_resolved(ℓ) + (chi_eff / 2) * V_sub`:
       `L(ℓ + 1) ≤ F_exact ≤ U(ℓ + 1)`,
    4. The uncertainty bracket width contracts by the exact factor `rho`:
       `U(ℓ + 1) - L(ℓ + 1) = rho * (U(ℓ) - L(ℓ))`. -/
theorem two_sided_fine_resolution_comb_sandwich_contraction
    {F_res chi_low chi_eff chi_high V_sub rho : ℝ}
    (hV : 0 < V_sub)
    (hrho_pos : 0 < rho) (hrho_lt : rho < 1)
    (hchi_low : chi_low < chi_eff) (hchi_high : chi_eff < chi_high) :
    let F_exact := F_res + (chi_eff / 2) * V_sub
    let F_res_next := F_res + (1 - rho) * (chi_eff / 2) * V_sub
    let V_sub_next := rho * V_sub
    let L_curr := combLowerBound F_res chi_low V_sub
    let U_curr := combUpperBound F_res chi_high V_sub
    let L_next := combLowerBound F_res_next chi_low V_sub_next
    let U_next := combUpperBound F_res_next chi_high V_sub_next
    L_curr < L_next ∧
    L_next ≤ F_exact ∧
    F_exact ≤ U_next ∧
    U_next < U_curr ∧
    U_next - L_next = rho * (U_curr - L_curr) := by
  intro F_exact F_res_next V_sub_next L_curr U_curr L_next U_next
  have h1m_rho : 0 < 1 - rho := by linarith
  have hL_diff : L_next - L_curr = (1 - rho) * ((chi_eff - chi_low) / 2) * V_sub := by
    dsimp [L_next, L_curr, combLowerBound, F_res_next, V_sub_next]
    ring
  have hU_diff : U_curr - U_next = (1 - rho) * ((chi_high - chi_eff) / 2) * V_sub := by
    dsimp [U_curr, U_next, combUpperBound, F_res_next, V_sub_next]
    ring
  have hL_exact : F_exact - L_next = rho * ((chi_eff - chi_low) / 2) * V_sub := by
    dsimp [F_exact, L_next, combLowerBound, F_res_next, V_sub_next]
    ring
  have hU_exact : U_next - F_exact = rho * ((chi_high - chi_eff) / 2) * V_sub := by
    dsimp [U_next, F_exact, combUpperBound, F_res_next, V_sub_next]
    ring
  have hWidth : U_next - L_next = rho * (U_curr - L_curr) := by
    dsimp [U_next, L_next, U_curr, L_curr, combUpperBound, combLowerBound, F_res_next, V_sub_next]
    ring
  have h_pos1 : 0 < (1 - rho) * ((chi_eff - chi_low) / 2) * V_sub := by
    have hchi1 : 0 < (chi_eff - chi_low) / 2 := by linarith
    positivity
  have h_pos2 : 0 < (1 - rho) * ((chi_high - chi_eff) / 2) * V_sub := by
    have hchi2 : 0 < (chi_high - chi_eff) / 2 := by linarith
    positivity
  have h_pos3 : 0 ≤ rho * ((chi_eff - chi_low) / 2) * V_sub := by
    have hchi1 : 0 < (chi_eff - chi_low) / 2 := by linarith
    positivity
  have h_pos4 : 0 ≤ rho * ((chi_high - chi_eff) / 2) * V_sub := by
    have hchi2 : 0 < (chi_high - chi_eff) / 2 := by linarith
    positivity
  refine ⟨by linarith, by linarith, by linarith, by linarith, hWidth⟩

/-- **Theorem 11 (`dyadic_comb_four_step_geometric_width_contraction`)**:
    In a dyadic wavevector comb where each refinement octave contracts the sub-grid variance
    by `rho = 1 / 4`, four successive comb octaves shrink the two-sided free-energy bracket width
    `W_0 = U_0 - L_0 > 0` to `W_4 = W_0 / 256`, achieving a 256-fold resolution gain. -/
theorem dyadic_comb_four_step_geometric_width_contraction
    {W0 W1 W2 W3 W4 : ℝ} (hW0 : 0 < W0)
    (h1 : W1 = (1 / 4) * W0)
    (h2 : W2 = (1 / 4) * W1)
    (h3 : W3 = (1 / 4) * W2)
    (h4 : W4 = (1 / 4) * W3) :
    W4 = (1 / 256) * W0 ∧ W4 < W0 := by
  rw [h4, h3, h2, h1]
  refine ⟨by ring, by linarith⟩

/-- **Theorem 12 (`multiscale_comb_fisher_information_superadditivity`)**:
    Resolving two distinct scale teeth with signal sensitivities `du1, du2` and noise variances
    `v1 > 0, v2 > 0` yields total Fisher information `du1^2 / v1 + du2^2 / v2`, which exceeds
    the coarse-grained pooled Fisher information `(du1 + du2)^2 / (v1 + v2)` by the exact
    non-negative Bregman–Cauchy–Schwarz defect `(du1 * v2 - du2 * v1)^2 / (v1 * v2 * (v1 + v2)) ≥ 0`. -/
theorem multiscale_comb_fisher_information_superadditivity
    {du1 du2 v1 v2 : ℝ} (hv1 : 0 < v1) (hv2 : 0 < v2) :
    (du1 ^ 2 / v1 + du2 ^ 2 / v2) - (du1 + du2) ^ 2 / (v1 + v2) =
      (du1 * v2 - du2 * v1) ^ 2 / (v1 * v2 * (v1 + v2)) ∧
    (du1 + du2) ^ 2 / (v1 + v2) ≤ du1 ^ 2 / v1 + du2 ^ 2 / v2 := by
  have hv1_ne : v1 ≠ 0 := ne_of_gt hv1
  have hv2_ne : v2 ≠ 0 := ne_of_gt hv2
  have hv12_pos : 0 < v1 + v2 := by linarith
  have hv12_ne : v1 + v2 ≠ 0 := ne_of_gt hv12_pos
  have hdenom_pos : 0 < v1 * v2 * (v1 + v2) := by positivity
  have hdenom_ne : v1 * v2 * (v1 + v2) ≠ 0 := ne_of_gt hdenom_pos
  have h_ident : (du1 ^ 2 / v1 + du2 ^ 2 / v2) - (du1 + du2) ^ 2 / (v1 + v2) =
      (du1 * v2 - du2 * v1) ^ 2 / (v1 * v2 * (v1 + v2)) := by
    apply mul_right_cancel₀ hdenom_ne
    have h_lhs : ((du1 ^ 2 / v1 + du2 ^ 2 / v2) - (du1 + du2) ^ 2 / (v1 + v2)) * (v1 * v2 * (v1 + v2)) =
        du1 ^ 2 * v2 * (v1 + v2) + du2 ^ 2 * v1 * (v1 + v2) - (du1 + du2) ^ 2 * v1 * v2 := by
      calc ((du1 ^ 2 / v1 + du2 ^ 2 / v2) - (du1 + du2) ^ 2 / (v1 + v2)) * (v1 * v2 * (v1 + v2))
        _ = (du1 ^ 2 / v1 * v1) * v2 * (v1 + v2) + (du2 ^ 2 / v2 * v2) * v1 * (v1 + v2) -
            ((du1 + du2) ^ 2 / (v1 + v2) * (v1 + v2)) * v1 * v2 := by ring
        _ = du1 ^ 2 * v2 * (v1 + v2) + du2 ^ 2 * v1 * (v1 + v2) - (du1 + du2) ^ 2 * v1 * v2 := by
            rw [div_mul_cancel₀ _ hv1_ne, div_mul_cancel₀ _ hv2_ne, div_mul_cancel₀ _ hv12_ne]
    have h_rhs : ((du1 * v2 - du2 * v1) ^ 2 / (v1 * v2 * (v1 + v2))) * (v1 * v2 * (v1 + v2)) =
        (du1 * v2 - du2 * v1) ^ 2 := div_mul_cancel₀ _ hdenom_ne
    rw [h_lhs, h_rhs]
    ring
  have h_nonneg : 0 ≤ (du1 * v2 - du2 * v1) ^ 2 / (v1 * v2 * (v1 + v2)) := by
    positivity
  refine ⟨h_ident, by linarith⟩

/-! ## Section 4: Five Formalized Elite Physics & Mathematics Examples -/

/-- **Example I.1 (`example1_nuclear_deuteron_mutual_information_mass_defect`)**:
    In relativistic nuclear binding (`p + n → d + γ`), coarse-graining the two-nucleon
    phase space into the bound deuteron state transfers sub-grid mutual information
    `I_bind > 0` into radiated binding energy `ΔE_bind = kT * I_bind`.
    Proves that the bound rest mass `m_d = m_p + m_n - (kT * I_bind) / c^2` is strictly
    less than `m_p + m_n`, while the Metriplectic Scale Comb invariant
    `generalizedScaleHamiltonian (m_d * c^2) kT I_bind` equals the exact constituent rest
    energy `(m_p + m_n) * c^2`. -/
theorem example1_nuclear_deuteron_mutual_information_mass_defect
    {m_p m_n m_d c kT I_bind : ℝ}
    (hc : 0 < c) (hkT : 0 < kT) (hI : 0 < I_bind)
    (h_mass : m_d = m_p + m_n - (kT * I_bind) / (c ^ 2)) :
    m_d < m_p + m_n ∧
    (m_p + m_n - m_d) * c ^ 2 = kT * I_bind ∧
    generalizedScaleHamiltonian (m_d * c ^ 2) kT I_bind = (m_p + m_n) * c ^ 2 := by
  have hc2_pos : 0 < c ^ 2 := sq_pos_of_pos hc
  have hc2_ne : c ^ 2 ≠ 0 := ne_of_gt hc2_pos
  have h_defect_pos : 0 < (kT * I_bind) / (c ^ 2) := div_pos (mul_pos hkT hI) hc2_pos
  have h_lt : m_d < m_p + m_n := by linarith
  have h_bind : (m_p + m_n - m_d) * c ^ 2 = kT * I_bind := by
    rw [h_mass]
    calc (m_p + m_n - (m_p + m_n - kT * I_bind / c ^ 2)) * c ^ 2
      _ = (kT * I_bind / c ^ 2) * c ^ 2 := by ring
      _ = kT * I_bind := div_mul_cancel₀ _ hc2_ne
  have h_comb : generalizedScaleHamiltonian (m_d * c ^ 2) kT I_bind = (m_p + m_n) * c ^ 2 := by
    dsimp [generalizedScaleHamiltonian]
    linarith [h_bind]
  exact ⟨h_lt, h_bind, h_comb⟩

/-- **Example I.2 (`example2_landauer_thermodynamic_sat_branching_barrier`)**:
    In physical combinatorial optimization (`k`-SAT backtracking under thermal scale `kT > 0`),
    each of `b > 0` irreversible clause-erasure steps incurs at least the Landauer Bregman/KL
    information floor `dI_step ≥ log 2 > 0`. Under a finite physical free-energy budget
    `W_diss ≤ B_max`, the Metriplectic Scale Comb proves:
    1. Total dissipated work `H_0 - H_b = b * kT * dI_step` is at least `b * kT * Real.log 2 > 0`.
    2. The number of irreversible backtracking steps is strictly bounded by the physical budget:
       `b ≤ B_max / (kT * Real.log 2)`. -/
theorem example2_landauer_thermodynamic_sat_branching_barrier
    {H_0 H_b b kT dI_step B_max : ℝ}
    (hb : 0 < b) (hkT : 0 < kT)
    (h_landauer : Real.log 2 ≤ dI_step)
    (h_cascade : H_b = H_0 - b * kT * dI_step)
    (h_budget : H_0 - H_b ≤ B_max) :
    generalizedScaleHamiltonian H_b kT (b * dI_step) = H_0 ∧
    b * kT * Real.log 2 ≤ H_0 - H_b ∧
    b ≤ B_max / (kT * Real.log 2) := by
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h_denom_pos : 0 < kT * Real.log 2 := mul_pos hkT hlog2_pos
  have h_comb : generalizedScaleHamiltonian H_b kT (b * dI_step) = H_0 := by
    dsimp [generalizedScaleHamiltonian]
    rw [h_cascade]
    ring
  have h_work : b * kT * Real.log 2 ≤ H_0 - H_b := by
    have h_diff : H_0 - H_b = (b * kT) * dI_step := by linarith
    have h_bkT_pos : 0 ≤ b * kT := by positivity
    have h_mul := mul_le_mul_of_nonneg_left h_landauer h_bkT_pos
    linarith
  have h_bound : b ≤ B_max / (kT * Real.log 2) := by
    rw [le_div_iff₀ h_denom_pos]
    linarith
  exact ⟨h_comb, h_work, h_bound⟩

/-- **Example I.3 (`example3_navier_stokes_enstrophy_cascade_metriplectic_invariant`)**:
    In 2D/3D Navier–Stokes turbulence, inviscid Euler advection preserves kinetic energy via the
    vorticity Poisson bracket (`{E, E}_J = 0`), while coarse-graining across eddy octaves `0 → 1 → 2`
    transfers kinetic energy into sub-grid enstrophy dissipation `ν_turb * Ω_j > 0`.
    Proves that the Metriplectic Scale Comb invariant `E_2 + ν_turb * (Ω_0 + Ω_1)` equals the
    exact fine-scale kinetic energy `E_0`, while the bare resolved kinetic energy strictly decays. -/
theorem example3_navier_stokes_enstrophy_cascade_metriplectic_invariant
    {E_0 E_1 E_2 nu_turb Omega_0 Omega_1 : ℝ}
    (hnu : 0 < nu_turb) (hO0 : 0 < Omega_0) (hO1 : 0 < Omega_1)
    (h_step0 : E_1 = E_0 - nu_turb * Omega_0)
    (h_step1 : E_2 = E_1 - nu_turb * Omega_1) :
    generalizedScaleHamiltonian E_2 nu_turb (Omega_0 + Omega_1) = E_0 ∧
    E_2 < E_1 ∧ E_1 < E_0 ∧
    E_0 - E_2 = nu_turb * (Omega_0 + Omega_1) := by
  dsimp [generalizedScaleHamiltonian]
  rw [h_step1, h_step0]
  refine ⟨by ring, by nlinarith, by nlinarith, by ring⟩

/-- **Example I.4 (`example4_black_hole_hawking_bekenstein_horizon_comb`)**:
    When an infalling wavepacket of energy `dE = kT_H * dI_matter` crosses a black hole horizon
    at Hawking thermal scale `kT_H > 0`, coarse-graining exterior phase space reduces the exterior
    Hamiltonian `H_ext_after = H_ext_before - kT_H * dI_matter` and increases Bekenstein–Hawking
    horizon entropy by `dS_BH ≥ dI_matter > 0`. Proves exact conservation of the horizon-dressed
    Metriplectic Scale Comb Hamiltonian and strict positivity of generalized entropy production
    `dS_gen = dS_BH - dI_matter ≥ 0`. -/
theorem example4_black_hole_hawking_bekenstein_horizon_comb
    {H_ext_before H_ext_after kT_H dI_matter dS_BH : ℝ}
    (hkT : 0 < kT_H) (_hdI : 0 < dI_matter)
    (h_horizon : H_ext_after = H_ext_before - kT_H * dI_matter)
    (h_bekenstein : dI_matter ≤ dS_BH) :
    generalizedScaleHamiltonian H_ext_after kT_H dI_matter = H_ext_before ∧
    0 ≤ dS_BH - dI_matter ∧
    H_ext_after + kT_H * dS_BH ≥ H_ext_before := by
  dsimp [generalizedScaleHamiltonian]
  rw [h_horizon]
  refine ⟨by ring, by linarith, by nlinarith⟩

/-- **Example I.5 (`example5_fokker_planck_wasserstein_log_sobolev_decay`)**:
    In Otto–Wasserstein Fokker–Planck gradient flows, when the metriplectic Fisher-information
    pairing `(S, S)_G` satisfies the Log-Sobolev / Polyak–Łojasiewicz inequality
    `2 * lam_LSI * (F - F_eq) ≤ (S, S)_G` (`lam_LSI > 0`, `F > F_eq`, `kT > 0`), the metriplectic
    free-energy dissipation rate `dF_dtau = - (kT ^ 2) * (S, S)_G` satisfies the strict linear
    exponential-convergence bound `dF_dtau ≤ - 2 * (kT ^ 2) * lam_LSI * (F - F_eq) < 0`. -/
theorem example5_fokker_planck_wasserstein_log_sobolev_decay
    {F F_eq kT lam_LSI metric_SS dF_dtau : ℝ}
    (hkT : 0 < kT) (hlam : 0 < lam_LSI) (h_exc : F_eq < F)
    (h_rate : dF_dtau = - (kT ^ 2) * metric_SS)
    (h_lsi : 2 * lam_LSI * (F - F_eq) ≤ metric_SS) :
    dF_dtau ≤ - 2 * (kT ^ 2) * lam_LSI * (F - F_eq) ∧
    dF_dtau < 0 := by
  have hkT2_pos : 0 < kT ^ 2 := sq_pos_of_pos hkT
  have h_gap_pos : 0 < F - F_eq := sub_pos.mpr h_exc
  have h_mul : (kT ^ 2) * (2 * lam_LSI * (F - F_eq)) ≤ (kT ^ 2) * metric_SS :=
    mul_le_mul_of_nonneg_left h_lsi (le_of_lt hkT2_pos)
  have h_strict : 0 < 2 * (kT ^ 2) * lam_LSI * (F - F_eq) := by positivity
  rw [h_rate]
  exact ⟨by linarith, by linarith⟩

