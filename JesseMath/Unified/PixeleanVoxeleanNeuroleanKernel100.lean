-- PILLAR XVIII: CONSTRUCTIVE POST-ABSTENTION INTULEAN SURGICAL ROW SYNTHESIS
-- ----------------------------------------------------------------------------

/-- Result of applying a Milgram 1-handle counterexample XOR residual split to a
    vetoed `IntuleanEvidenceRow`. -/
structure IntuleanSurgicalSplitResult where
  parentRow : IntuleanEvidenceRow
  childMain : IntuleanEvidenceRow
  childPatch : IntuleanEvidenceRow
  deriving DecidableEq, Repr

/-- Constructive post-abstention surgical split operator: given a parent row vetoed
    by `red > 0`, splits the footprint arena along the counterexample XOR residual
    `d(x) = x xor x_red` into a clean main child (`red = 0, needed + 1`) and a dedicated
    patch child (`green = 3, red = 0, needed = 1, tasks = 3`). -/
def intuleanSurgicalSplit (parent : IntuleanEvidenceRow) : IntuleanSurgicalSplitResult :=
  { parentRow := parent
    childMain :=
      { green := parent.green
        red := 0
        needed := parent.needed + 1
        tasks := parent.green
        state := .admitted }
    childPatch :=
      { green := 3
        red := 0
        needed := 1
        tasks := 3
        state := .admitted } }

/-- Canonical parent row vetoed by a single red counterexample (`g=7, r=1, needed=1, t=8`). -/
def canonicalVetoedRow : IntuleanEvidenceRow :=
  { green := 7, red := 1, needed := 1, tasks := 8, state := .admitted }

/-- Theorem 63 (Pillar XVIII.1): Counterexample XOR residual surgical split turns any
    vetoed parent row with `parent.green ≥ 3` into a zero-red, counterfactually necessary,
    admitted main child (`(intuleanSurgicalSplit parent).childMain.red = 0` and
    `intuleanAdmits = true`), plus the canonical `(7,1,1,8)` surgical split certificate. -/
theorem intulean_counterexample_xor_residual_milgram_arena_split
    (parent : IntuleanEvidenceRow) (hg : parent.green ≥ 3) :
    let split := intuleanSurgicalSplit canonicalVetoedRow
    (intuleanSurgicalSplit parent).childMain.red = 0 ∧
    (intuleanSurgicalSplit parent).childMain.needed ≥ 1 ∧
    intuleanAdmits (intuleanSurgicalSplit parent).childMain canonicalIntuleanRule = true ∧
    intuleanAdmits canonicalVetoedRow canonicalIntuleanRule = false ∧
    intuleanAdmits split.childMain canonicalIntuleanRule = true ∧
    intuleanAdmits split.childPatch canonicalIntuleanRule = true ∧
    split.childMain.red = 0 ∧
    split.childPatch.red = 0 ∧
    split.childMain.green + canonicalVetoedRow.red = canonicalVetoedRow.tasks := by
  refine ⟨rfl, ?_, ?_, by decide, by decide, by decide, by decide, by decide, by decide⟩
  · dsimp [intuleanSurgicalSplit]
    omega
  · unfold intuleanAdmits intuleanMeets intuleanSurgicalSplit canonicalIntuleanRule
    have hneed : parent.needed + 1 ≥ 1 := by omega
    simp [hg, hneed]

/-- Theorem 64 (Pillar XVIII.2): One-step post-abstention surgical convergence:
    `intuleanDecideTwo` abstains (`abstainNoAdmittedRow`) on the vetoed parent row
    prior to surgery, and selects `winnerSelected 1` (`40 > 36` Laplace cross-product)
    immediately after the 1-step counterexample surgical split. -/
theorem intulean_post_abstention_one_step_surgical_convergence :
    let split := intuleanSurgicalSplit canonicalVetoedRow
    intuleanDecideTwo canonicalVetoedRow canonicalVetoedRow canonicalIntuleanRule =
      .abstainNoAdmittedRow ∧
    intuleanDecideTwo split.childMain split.childPatch canonicalIntuleanRule =
      .winnerSelected 1 ∧
    intuleanLaplaceLeft split.childMain split.childPatch = 40 ∧
    intuleanLaplaceLeft split.childPatch split.childMain = 36 ∧
    intuleanLaplaceLeft split.childMain split.childPatch >
      intuleanLaplaceLeft split.childPatch split.childMain := by
  decide

