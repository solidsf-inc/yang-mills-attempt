    canonicalSolidPuSpec.reflexBudgetNs >
      3333 * canonicalSolidPuSpec.totalPipelineCycles ∧
    solidPuOneRedKillWire (r + 1) false out = 0 ∧
    solidPuOneRedKillWire 0 true out = 0 ∧
    solidPuOneRedKillWire 0 false 42 = 42 ∧
