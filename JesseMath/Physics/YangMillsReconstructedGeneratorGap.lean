open YangMillsContinuumCompactness

/-! ## 1. Obligation `R5` — Scheduled `MultiStepHaarRGChain` & 18/20 Field Reduction of `BalabanMultiScaleUVToIRFlow` -/

/-- Scheduled downward Haar RG state starting from `pureWilson` at `j = 0` (`m = K`),
    using a prescribed non-negative coupling schedule `β_sched (j + 1)` and empty polymer family
    `PolymerActivityFamily.empty L_m` at each coarse step `j + 1`, with exact remainder
    `R_trunc V = A_norm V - wilsonAction (β_sched (j + 1)) V`. -/
noncomputable def scheduledHaarRGStateAux (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ) :
    ∀ (_j m : ℕ), InteractingEffectiveActionState (dyadicScaleSide L_ir m)
  | 0, m => InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv
  | j + 1, m =>
      let L_m := dyadicScaleSide L_ir m
      let st_prev := scheduledHaarRGStateAux L_ir β_uv β_sched j (m + 1)
      let A_eff : GaugeConfig L_m → ℝ :=
        YangMillsRGBridgeObstruction.interactingBlockedEffectiveAction (haarBlockDisintegration L_m)
          st_prev.β (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
      let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
      let β_next : ℝ := β_sched (j + 1)
      { c_vac := st_prev.c_vac + A_eff (vacuumConfig L_m)
        β := β_next
        polymers := PolymerActivityFamily.empty L_m
        R_trunc := fun V => A_norm V - wilsonAction β_next V }

/-- Scale-indexed state family for `scheduledHaarRGStateAux`. -/
noncomputable def scheduledHaarRGState (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ)
    (m : ℕ) : InteractingEffectiveActionState (dyadicScaleSide L_ir m) :=
  if m ≤ K then
    scheduledHaarRGStateAux L_ir β_uv β_sched (K - m) m
  else
    InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv

theorem scheduledHaarRGStateAux_polymers_eq_empty
    (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ) (j m : ℕ) :
    (scheduledHaarRGStateAux L_ir β_uv β_sched j m).polymers =
      PolymerActivityFamily.empty (dyadicScaleSide L_ir m) := by
  cases j <;> rfl

theorem scheduledHaarRGState_polymers_eq_empty
    (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ) (m : ℕ) :
    (scheduledHaarRGState L_ir K β_uv β_sched m).polymers =
      PolymerActivityFamily.empty (dyadicScaleSide L_ir m) := by
  dsimp [scheduledHaarRGState]
  split_ifs
  · exact scheduledHaarRGStateAux_polymers_eq_empty L_ir β_uv β_sched (K - m) m
  · rfl

theorem scheduledHaarRGStateAux_beta_nonneg
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    {β_sched : ℕ → ℝ} (hsched : ∀ j : ℕ, 0 ≤ β_sched j) :
    ∀ (j m : ℕ), 0 ≤ (scheduledHaarRGStateAux L_ir β_uv β_sched j m).β
  | 0, _ => hβ
  | j + 1, _ => hsched (j + 1)

/-- Explicit inhabitant of `MultiStepHaarRGChain L_ir K β_uv` for any non-negative schedule `β_sched`. -/
noncomputable def scheduledHaarRGChain (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (β_sched : ℕ → ℝ) (hsched : ∀ j : ℕ, 0 ≤ β_sched j) :
    MultiStepHaarRGChain L_ir K β_uv where
  state := scheduledHaarRGState L_ir K β_uv β_sched
  ε_trunc := fun m V => |((scheduledHaarRGState L_ir K β_uv β_sched m).R_trunc V)|
  h_uv := by simp [scheduledHaarRGState, scheduledHaarRGStateAux]
  h_β_nonneg := fun m hm => by
    simp only [scheduledHaarRGState, hm, ↓reduceIte]
    exact scheduledHaarRGStateAux_beta_nonneg L_ir hβ hsched (K - m) m
  h_ε_nonneg := fun _ _ _ => abs_nonneg _
  h_R_trunc_le := fun _ _ _ => le_rfl
  h_step_exact := fun m hm V => by
    have hm_le : m ≤ K := Nat.le_of_lt hm
    have hm1_le : m + 1 ≤ K := hm
    have hsub : K - m = (K - (m + 1)) + 1 := by omega
    have h_lhs : scheduledHaarRGState L_ir K β_uv β_sched m =
        scheduledHaarRGStateAux L_ir β_uv β_sched ((K - (m + 1)) + 1) m := by
      simp only [scheduledHaarRGState, hm_le, ↓reduceIte, hsub]
    have h_rhs : scheduledHaarRGState L_ir K β_uv β_sched (m + 1) =
        scheduledHaarRGStateAux L_ir β_uv β_sched (K - (m + 1)) (m + 1) := by
      simp only [scheduledHaarRGState, hm1_le, ↓reduceIte]
    rw [h_lhs, h_rhs]
    dsimp [scheduledHaarRGStateAux, InteractingEffectiveActionState.totalAction]
    rw [PolymerActivityFamily.eval_empty]
    ring

/-- Unconditional discharge of `h_polymer_local` (`#L24223`) for any `scheduledHaarRGChain`. -/
theorem scheduledHaarRGChain_h_polymer_local_unconditional
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (β_sched : ℕ → ℝ) (hsched : ∀ j : ℕ, 0 ≤ β_sched j)
    (e : Link (dyadicScaleSide L_ir 0)) :
    let L_m := dyadicScaleSide L_ir 0
    let P_m := ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state 0).polymers
    (∑ i : P_m.idx,
      if e ∈ latticePathSupport L_m (P_m.bases i) (P_m.loops i) then
        ((P_m.loops i).length : ℝ) *
          ((4 / 3 : ℝ) ^ (P_m.loops i).length * (4 * |P_m.weights i|))
      else 0) ≤ canonicalBalabanEtaStep (K - 0) := by
  have hP : ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state 0).polymers =
      PolymerActivityFamily.empty (dyadicScaleSide L_ir 0) :=
    scheduledHaarRGState_polymers_eq_empty L_ir K β_uv β_sched 0
  dsimp only
  rw [hP, PolymerActivityFamily.empty_weighted_incident_sum_eq_zero]
  exact canonicalBalabanEtaStep_nonneg (K - 0)

/-- Unconditional discharge of `PolymerDobrushinNormBound` at `η_star = 0` for any `scheduledHaarRGChain`. -/
theorem scheduledHaarRGChain_polymerDobrushinNormBound_zero
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (β_sched : ℕ → ℝ) (hsched : ∀ j : ℕ, 0 ≤ β_sched j) :
    PolymerDobrushinNormBound ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state 0).polymers 0 := by
  have hP : ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state 0).polymers =
      PolymerActivityFamily.empty (dyadicScaleSide L_ir 0) :=
    scheduledHaarRGState_polymers_eq_empty L_ir K β_uv β_sched 0
  rw [hP]
  refine ⟨le_rfl, fun V e g1 g2 => ?_, fun _ _ => 0, fun _ _ => le_rfl,
    fun V e e' g1 g2 h1 h2 => ?_, fun e => ?_⟩
  · simp [PolymerActivityFamily.eval_empty]
  · simp [twoLinkMixedDifference, PolymerActivityFamily.eval_empty]
  · simp

/-- Unconditional discharge of `h_β_absorb` (`#L24218`) along `dyadicOneLoopPath` with
    `K n = n`, `Δβ_1loop = 11 / (3 * Real.pi ^ 2) * Real.log 2`, and `δ_2loop = 0`. -/
theorem ARGON_SET4_R5_dyadicOneLoopPath_h_beta_absorb_unconditional :
