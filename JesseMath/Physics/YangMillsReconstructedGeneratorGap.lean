    · rw [probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 0) g,
          sideWeight_update_top_of_ne hL β (by decide : (0 : Fin 4) ≠ 1) U g,
          sideWeight_update_top_of_ne hL β (by decide : (0 : Fin 4) ≠ 2) U g,
          sideWeight_update_top_of_ne hL β (by decide : (0 : Fin 4) ≠ 3) U g]
  have h1 :
      (∫ U, probeExteriorBoltzmannWeight β U *
          sideBridge L β 0 U * sideWeight L β 1 U * sideWeight L β 2 U * sideWeight L β 3 U *
          ΦB U * ΦT U ∂(gaugeHaarMeasure L)) =
        ∫ U, probeExteriorBoltzmannWeight β U *
          sideBridge L β 0 U * sideBridge L β 1 U * sideWeight L β 2 U * sideWeight L β 3 U *
          ΦB U * ΦT U ∂(gaugeHaarMeasure L) := by
    have h_a1 :
        (fun U => probeExteriorBoltzmannWeight β U *
