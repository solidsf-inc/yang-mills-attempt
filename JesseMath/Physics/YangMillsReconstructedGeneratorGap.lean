  have s_bt := abs_le.mp h_bt_diff
  have s_rem := abs_le.mp h_rem4_int
  have s0 := abs_le.mp hw0'
  have s1 := abs_le.mp hw1'
  have s2 := abs_le.mp hw2'
  have s3 := abs_le.mp hw3'
  dsimp only [w, Δ, W] at h_bt_diff h_4tw_eq h_decomp_W s_bt ⊢
  rw [h_4tw_eq, h_decomp_W] at s_bt
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Explicit multi-order polynomial remainder bound for the full-torus pure-Wilson probe covariance
`wilsonProbeCov L β` around its leading 6-face unit-cube Haar integral `cubeSixFaceHaarIntegral * β ^ 4`:
for every torus side `L ≥ 3` and every coupling `0 ≤ β ≤ 1 / 6912`,
`|wilsonProbeCov L β - cubeSixFaceHaarIntegral * β ^ 4| ≤ ((48 + 2) / 1024) * β ^ 5 + (2400 + 600 + 24 * 8 + 32 + 13) * β ^ 6 + (6912 + 24 * 24 * 6) ^ 2 * β ^ 8`,
where `((48 + 2) / 1024) * β ^ 5` is the `probeExteriorPartition / characterPartition` normalization shift,
`(2400 + 600 + 24 * 8 + 32 + 13) * β ^ 6` is the connected 4-side bridge + wing-pair remainder, and
`(6912 + 24 * 24 * 6) ^ 2 * β ^ 8` is the exact degree-8 disconnected centered single-probe expectation product. -/
theorem abs_wilsonProbeCov_sub_cubeSixFace_beta_pow_four_le
    {L : ℕ} [NeZero L] (hL3 : 3 ≤ L) {β : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912) :
    |wilsonProbeCov L β - cubeSixFaceHaarIntegral * β ^ 4| ≤
      ((48 + 2) / 1024 : ℝ) * β ^ 5 + (2400 + 600 + 24 * 8 + 32 + 13) * β ^ 6 +
        (6912 + 24 * 24 * 6) ^ 2 * β ^ 8 := by
  have hL2 : 2 ≤ L := by omega
  let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
  let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
  let c : ℝ := su2CharMean β
  have hZ_pos : 0 < characterPartition L β := characterPartition_pos hL2 β
  have h_cov_eq := wilsonProbeCov_eq_centered_probe_cov hL2 hβ0
  have h_num_eq := integral_characterBoltzmannWeight_mul_centeredProbes_eq_sideBridge hL3 β
  have h_num_bound := abs_integral_sideBridge_centeredProbes_sub_leading_le hL3 hβ0 hβ_hi
  obtain ⟨h_single_t, h_single_b⟩ := abs_centeredSingleProbe_expectations_le hL3 hβ0 hβ_hi
  obtain ⟨h_Z_ratio_le, h_Z_ratio_diff⟩ :=
    probeExteriorPartition_div_characterPartition_le_and_abs_sub_one_le hL2 hβ0 hβ_hi
  let I_num := ∫ U : GaugeConfig L,
    probeExteriorBoltzmannWeight β U *
      sideBridge L β 0 U * sideBridge L β 1 U * sideBridge L β 2 U * sideBridge L β 3 U *
      ((b U - c) * Real.exp (β * b U)) * ((t U - c) * Real.exp (β * t U))
    ∂(gaugeHaarMeasure L)
  let E_b := (∫ U : GaugeConfig L, characterBoltzmannWeight β U * (b U - c) ∂(gaugeHaarMeasure L)) /
    characterPartition L β
  let E_t := (∫ U : GaugeConfig L, characterBoltzmannWeight β U * (t U - c) ∂(gaugeHaarMeasure L)) /
    characterPartition L β
  have h_cov_formula :
      wilsonProbeCov L β = I_num / characterPartition L β - E_b * E_t := by
    dsimp only [I_num, E_b, E_t, b, t, c]
    rw [h_cov_eq, h_num_eq]
  have h_disc_le : |E_b * E_t| ≤ 107495424 * β ^ 8 := by
    rw [abs_mul]
    dsimp only [E_b, E_t, b, t, c]
    have h_prod := mul_le_mul h_single_b h_single_t (abs_nonneg _) (by positivity)
    linarith [show (10368 * β ^ 4) * (10368 * β ^ 4) = 107495424 * β ^ 8 by ring]
  have h_num_div_le :
      |I_num / characterPartition L β -
        (cubeSixFaceHaarIntegral * β ^ 4) * (probeExteriorPartition L β / characterPartition L β)| ≤
      3237 * β ^ 6 := by
    have h_eq :
        I_num / characterPartition L β -
          (cubeSixFaceHaarIntegral * β ^ 4) * (probeExteriorPartition L β / characterPartition L β) =
        (I_num - cubeSixFaceHaarIntegral * β ^ 4 * probeExteriorPartition L β) / characterPartition L β := by
      ring
    rw [h_eq, abs_div, abs_of_pos hZ_pos, div_le_iff₀ hZ_pos]
    have h1 : |I_num - cubeSixFaceHaarIntegral * β ^ 4 * probeExteriorPartition L β| ≤
        3214 * β ^ 6 * probeExteriorPartition L β := h_num_bound
    have h2 : probeExteriorPartition L β ≤ (144 / 143 : ℝ) * characterPartition L β :=
      (div_le_iff₀ hZ_pos).mp h_Z_ratio_le
    have hβ6 : 0 ≤ β ^ 6 := by positivity
    have h3 : 3214 * β ^ 6 * probeExteriorPartition L β ≤
        3214 * β ^ 6 * ((144 / 143 : ℝ) * characterPartition L β) :=
      mul_le_mul_of_nonneg_left h2 (by positivity)
    have h4 : 3214 * β ^ 6 * ((144 / 143 : ℝ) * characterPartition L β) ≤
        3237 * β ^ 6 * characterPartition L β := by
      nlinarith
    exact h1.trans (h3.trans h4)
  have h_part_shift_le :
      |(cubeSixFaceHaarIntegral * β ^ 4) * (probeExteriorPartition L β / characterPartition L β) -
        cubeSixFaceHaarIntegral * β ^ 4| ≤
      (50 / 1024 : ℝ) * β ^ 5 := by
    have h_fac :
        (cubeSixFaceHaarIntegral * β ^ 4) * (probeExteriorPartition L β / characterPartition L β) -
          cubeSixFaceHaarIntegral * β ^ 4 =
        (cubeSixFaceHaarIntegral * β ^ 4) * (probeExteriorPartition L β / characterPartition L β - 1) := by
      ring
    have h_c6 : cubeSixFaceHaarIntegral = (1 / 1024 : ℝ) := by
      rw [cubeSixFaceHaarIntegral_eq_one_fourth_pow_five]
      norm_num
    have hβ4 : 0 ≤ β ^ 4 := by positivity
    rw [h_fac, h_c6, abs_mul, abs_of_nonneg (by positivity : 0 ≤ (1 / 1024 : ℝ) * β ^ 4)]
    have h := mul_le_mul_of_nonneg_left h_Z_ratio_diff (by positivity : 0 ≤ (1 / 1024 : ℝ) * β ^ 4)
    linarith [show ((1 / 1024 : ℝ) * β ^ 4) * (50 * β) = (50 / 1024 : ℝ) * β ^ 5 by ring]
  rw [h_cov_formula]
  have s1 := abs_le.mp h_num_div_le
  have s2 := abs_le.mp h_part_shift_le
  have s3 := abs_le.mp h_disc_le
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Unconditional full-torus cluster-expansion remainder bound (`R1`) on `(0, canonicalCrossoverBetaHi]`
(`canonicalCrossoverBetaHi = 1 / 6912`):
for every torus side `L ≥ 4` and every coupling `0 < β ≤ canonicalCrossoverBetaHi`, the full-torus
Gibbs covariance `wilsonProbeCov L β` satisfies
`|wilsonProbeCov L β - cubeSixFaceHaarIntegral * β ^ 4| ≤ (1 / 4) * ((1 / 4) ^ 5 * β ^ 4)`. -/
theorem canonicalProbeClusterRemainder_canonicalCrossoverBetaHi :
    CanonicalProbeClusterRemainder (canonicalCrossoverBetaHi : ℝ) := by
  intro L _ hL β hβ_pos hβ_le
  have hL3 : 3 ≤ L := by omega
  have hβ0 : 0 ≤ β := hβ_pos.le
  have hβ_hi : β ≤ 1 / 6912 :=
    hβ_le.trans (by norm_num [canonicalCrossoverBetaHi])
  have h_tot_le := abs_wilsonProbeCov_sub_cubeSixFace_beta_pow_four_le hL3 hβ0 hβ_hi
  have h_β8 : 107495424 * β ^ 8 ≤ 3 * β ^ 6 := by
    have hβ6 : 0 ≤ β ^ 6 := by positivity
    have h6912 : 6912 * β ≤ 1 := by linarith
    have h_sq : (6912 * β) ^ 2 ≤ 1 := by
      have h_nonneg : 0 ≤ 6912 * β := by positivity
      nlinarith
    have h_id : 107495424 * β ^ 8 = (9 / 4 : ℝ) * (6912 * β) ^ 2 * β ^ 6 := by ring
    rw [h_id]
    nlinarith
  have h_budget :
      ((48 + 2) / 1024 : ℝ) * β ^ 5 + (2400 + 600 + 24 * 8 + 32 + 13) * β ^ 6 +
          (6912 + 24 * 24 * 6) ^ 2 * β ^ 8 ≤
        (1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4) := by
    have hβ4 : 0 ≤ β ^ 4 := by positivity
    have h_quad : (50 / 1024 : ℝ) * β + 3240 * β ^ 2 ≤ (1 / 4096 : ℝ) := by
      have hsq : β ^ 2 ≤ (1 / 6912 : ℝ) * β := by nlinarith
      linarith
    have h_mul := mul_le_mul_of_nonneg_right h_quad hβ4
    have h_lhs : ((50 / 1024 : ℝ) * β + 3240 * β ^ 2) * β ^ 4 =
        (50 / 1024 : ℝ) * β ^ 5 + 3240 * β ^ 6 := by ring
    have h_rhs : (1 / 4096 : ℝ) * β ^ 4 = (1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4) := by ring
    linarith
  exact h_tot_le.trans h_budget


namespace InteractingEffectiveActionState

/-- Two-action single-link conditional Gibbs expectation oscillation bound:
if two actions `S₁, S₂ : GroupGaugeConfig G L → ℝ` have measurable slices at link `e`, `S₂` is
slice-bounded, and their centered single-link difference satisfies
`∀ g : G, |S₁ (update V e g) - S₂ (update V e g) - d0| ≤ Δ`, then for any `[0, 1]`-valued
measurable test function `φ : G → ℝ`,
`|groupSingleLinkCondExp G L S₁ V e φ - groupSingleLinkCondExp G L S₂ V e φ| ≤ Real.exp (2 * Δ) - 1`. -/
theorem groupSingleLinkCondExp_two_actions_oscillation_of_action_diff_bound
    (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    {L : ℕ} (S₁ S₂ : GroupGaugeConfig G L → ℝ)
    (V : GroupGaugeConfig G L) (e : Link L) (φ : G → ℝ) {d0 Δ B : ℝ}
    (hS₁_meas : Measurable (fun g : G => S₁ (updateGroupGaugeLink L V e.x e.μ g)))
    (hS₂_meas : Measurable (fun g : G => S₂ (updateGroupGaugeLink L V e.x e.μ g)))
    (hS₂_bdd : ∀ g : G, |S₂ (updateGroupGaugeLink L V e.x e.μ g)| ≤ B)
    (hφ_meas : Measurable φ)
    (hφ_bounds : ∀ g : G, 0 ≤ φ g ∧ φ g ≤ 1)
    (h_diff : ∀ g : G,
      |S₁ (updateGroupGaugeLink L V e.x e.μ g) -
        S₂ (updateGroupGaugeLink L V e.x e.μ g) - d0| ≤ Δ) :
    |groupSingleLinkCondExp G L S₁ V e φ -
        groupSingleLinkCondExp G L S₂ V e φ| ≤ Real.exp (2 * Δ) - 1 := by
  have h_w2_le (g : G) :
      Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) ≤ Real.exp B :=
    Real.exp_le_exp.mpr (by linarith [(abs_le.mp (hS₂_bdd g)).1])
  have h_w2_ge (g : G) :
      Real.exp (-B) ≤ Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) :=
    Real.exp_le_exp.mpr (by linarith [(abs_le.mp (hS₂_bdd g)).2])
  have h_w1_le (g : G) :
      Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) ≤ Real.exp (B - d0 + Δ) :=
    Real.exp_le_exp.mpr
      (by linarith [(abs_le.mp (hS₂_bdd g)).1, (abs_le.mp (h_diff g)).1])
  have h_int_w1 :
      Integrable (fun g : G => Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)))
        (compactGroupHaarProbability G) := by
    refine (integrable_const (Real.exp (B - d0 + Δ))).mono'
      (Real.continuous_exp.measurable.comp hS₁_meas.neg).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun g => by
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact h_w1_le g
  have h_int_w2 :
      Integrable (fun g : G => Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)))
        (compactGroupHaarProbability G) := by
    refine (integrable_const (Real.exp B)).mono'
      (Real.continuous_exp.measurable.comp hS₂_meas.neg).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun g => by
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact h_w2_le g
  have h_int_φ1 :
      Integrable (fun g : G => Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) * φ g)
        (compactGroupHaarProbability G) := by
    refine (integrable_const (Real.exp (B - d0 + Δ))).mono'
      ((Real.continuous_exp.measurable.comp hS₁_meas.neg).mul hφ_meas).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun g => by
      have h_nonneg : 0 ≤ Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) * φ g :=
        mul_nonneg (Real.exp_pos _).le (hφ_bounds g).1
      rw [Real.norm_eq_abs, abs_of_nonneg h_nonneg]
      calc
        Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
          ≤ Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) * 1 :=
            mul_le_mul_of_nonneg_left (hφ_bounds g).2 (Real.exp_pos _).le
        _ = Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) := mul_one _
        _ ≤ Real.exp (B - d0 + Δ) := h_w1_le g
  have h_int_φ2 :
      Integrable (fun g : G => Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g)
        (compactGroupHaarProbability G) := by
    refine (integrable_const (Real.exp B)).mono'
      ((Real.continuous_exp.measurable.comp hS₂_meas.neg).mul hφ_meas).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun g => by
      have h_nonneg : 0 ≤ Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g :=
        mul_nonneg (Real.exp_pos _).le (hφ_bounds g).1
      rw [Real.norm_eq_abs, abs_of_nonneg h_nonneg]
      calc
        Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
          ≤ Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * 1 :=
            mul_le_mul_of_nonneg_left (hφ_bounds g).2 (Real.exp_pos _).le
        _ = Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) := mul_one _
        _ ≤ Real.exp B := h_w2_le g
  have hZ2_pos : 0 < groupSingleLinkPartition G L S₂ V e := by
    have h_lo :
        (∫ _ : G, Real.exp (-B) ∂(compactGroupHaarProbability G : Measure G)) ≤
          groupSingleLinkPartition G L S₂ V e :=
      integral_mono (integrable_const _) h_int_w2 h_w2_ge
    rw [integral_const, probReal_univ, one_smul] at h_lo
    exact lt_of_lt_of_le (Real.exp_pos (-B)) h_lo
  have hE2_le_one : groupSingleLinkCondExp G L S₂ V e φ ≤ 1 := by
    unfold groupSingleLinkCondExp
    rw [div_le_iff₀ hZ2_pos, one_mul]
    refine integral_mono h_int_φ2 h_int_w2 fun g => ?_
    calc
      Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
        ≤ Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * 1 :=
          mul_le_mul_of_nonneg_left (hφ_bounds g).2 (Real.exp_pos _).le
      _ = Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) := mul_one _
  have h_lo_g (g : G) :
      Real.exp (-d0 - Δ) * Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) ≤
        Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) := by
    rw [← Real.exp_add]
    exact Real.exp_le_exp.mpr (by linarith [(abs_le.mp (h_diff g)).2])
  have h_hi_g (g : G) :
      Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) ≤
        Real.exp (-d0 + Δ) * Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) := by
    rw [← Real.exp_add]
    exact Real.exp_le_exp.mpr (by linarith [(abs_le.mp (h_diff g)).1])
  have hZ_lo :
      Real.exp (-d0 - Δ) * groupSingleLinkPartition G L S₂ V e ≤
        groupSingleLinkPartition G L S₁ V e := by
    unfold groupSingleLinkPartition
    rw [← integral_const_mul]
    exact integral_mono (h_int_w2.const_mul _) h_int_w1 h_lo_g
  have hZ_hi :
      groupSingleLinkPartition G L S₁ V e ≤
        Real.exp (-d0 + Δ) * groupSingleLinkPartition G L S₂ V e := by
    unfold groupSingleLinkPartition
    rw [← integral_const_mul]
    exact integral_mono h_int_w1 (h_int_w2.const_mul _) h_hi_g
  have hN_lo :
      Real.exp (-d0 - Δ) *
        (∫ g : G, Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
          ∂(compactGroupHaarProbability G : Measure G)) ≤
      ∫ g : G, Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
        ∂(compactGroupHaarProbability G : Measure G) := by
    rw [← integral_const_mul]
    refine integral_mono (h_int_φ2.const_mul _) h_int_φ1 fun g => ?_
    dsimp only
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right (h_lo_g g) (hφ_bounds g).1
  have hN_hi :
      (∫ g : G, Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
        ∂(compactGroupHaarProbability G : Measure G)) ≤
      Real.exp (-d0 + Δ) *
        (∫ g : G, Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
          ∂(compactGroupHaarProbability G : Measure G)) := by
    rw [← integral_const_mul]
    refine integral_mono h_int_φ1 (h_int_φ2.const_mul _) fun g => ?_
    dsimp only
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right (h_hi_g g) (hφ_bounds g).1
  have hZ1 : 0 < groupSingleLinkPartition G L S₁ V e :=
    lt_of_lt_of_le (mul_pos (Real.exp_pos _) hZ2_pos) hZ_lo
  have hN2 :
      0 ≤ ∫ g : G, Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
        ∂(compactGroupHaarProbability G : Measure G) :=
    integral_nonneg fun g => mul_nonneg (Real.exp_pos _).le (hφ_bounds g).1
  have hE2_nonneg : 0 ≤ groupSingleLinkCondExp G L S₂ V e φ :=
    div_nonneg hN2 hZ2_pos.le
  have h_cancel2 :
      groupSingleLinkCondExp G L S₂ V e φ * groupSingleLinkPartition G L S₂ V e =
        ∫ g : G, Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
          ∂(compactGroupHaarProbability G : Measure G) :=
    div_mul_cancel₀ _ hZ2_pos.ne'
  have h_exp_lo : Real.exp (-d0 - Δ) = Real.exp (-2 * Δ) * Real.exp (-d0 + Δ) := by
    rw [← Real.exp_add]; congr 1; ring
  have h_exp_hi : Real.exp (-d0 + Δ) = Real.exp (2 * Δ) * Real.exp (-d0 - Δ) := by
    rw [← Real.exp_add]; congr 1; ring
  have h_ratio_lo :
      Real.exp (-2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ ≤
        groupSingleLinkCondExp G L S₁ V e φ := by
    unfold groupSingleLinkCondExp
    rw [le_div_iff₀ hZ1]
    change Real.exp (-2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ *
        groupSingleLinkPartition G L S₁ V e ≤ _
    calc
      Real.exp (-2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ *
          groupSingleLinkPartition G L S₁ V e
        ≤ Real.exp (-2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ *
            (Real.exp (-d0 + Δ) * groupSingleLinkPartition G L S₂ V e) :=
          mul_le_mul_of_nonneg_left hZ_hi (mul_nonneg (Real.exp_pos _).le hE2_nonneg)
      _ = Real.exp (-2 * Δ) * Real.exp (-d0 + Δ) *
            (groupSingleLinkCondExp G L S₂ V e φ * groupSingleLinkPartition G L S₂ V e) := by
          ring
      _ = Real.exp (-d0 - Δ) *
            (∫ g : G, Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
              ∂(compactGroupHaarProbability G : Measure G)) := by
          rw [← h_exp_lo, h_cancel2]
      _ ≤ _ := hN_lo
  have h_ratio_hi :
      groupSingleLinkCondExp G L S₁ V e φ ≤
        Real.exp (2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ := by
    unfold groupSingleLinkCondExp
    rw [div_le_iff₀ hZ1]
    change _ ≤ Real.exp (2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ *
        groupSingleLinkPartition G L S₁ V e
    calc
      (∫ g : G, Real.exp (-S₁ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
          ∂(compactGroupHaarProbability G : Measure G))
        ≤ Real.exp (-d0 + Δ) *
            (∫ g : G, Real.exp (-S₂ (updateGroupGaugeLink L V e.x e.μ g)) * φ g
              ∂(compactGroupHaarProbability G : Measure G)) := hN_hi
      _ = Real.exp (2 * Δ) * Real.exp (-d0 - Δ) *
            (groupSingleLinkCondExp G L S₂ V e φ * groupSingleLinkPartition G L S₂ V e) := by
          rw [h_exp_hi, h_cancel2]
      _ = Real.exp (2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ *
            (Real.exp (-d0 - Δ) * groupSingleLinkPartition G L S₂ V e) := by
          ring
      _ ≤ Real.exp (2 * Δ) * groupSingleLinkCondExp G L S₂ V e φ *
            groupSingleLinkPartition G L S₁ V e :=
          mul_le_mul_of_nonneg_left hZ_lo (mul_nonneg (Real.exp_pos _).le hE2_nonneg)
  have hΔ_nonneg : 0 ≤ Δ := le_trans (abs_nonneg _) (h_diff 1)
  have h_exp2Δ_ge_one : 1 ≤ Real.exp (2 * Δ) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by linarith)
  have h_exp_neg2Δ_le_one : Real.exp (-2 * Δ) ≤ 1 := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by linarith)
  have h_cosh :
      (Real.exp (2 * Δ) - 1) - (1 - Real.exp (-2 * Δ)) =
        (Real.exp Δ - Real.exp (-Δ)) ^ 2 := by
    have h1 : Real.exp (2 * Δ) = Real.exp Δ * Real.exp Δ := by
      rw [← Real.exp_add]; congr 1; ring
    have h2 : Real.exp (-2 * Δ) = Real.exp (-Δ) * Real.exp (-Δ) := by
      rw [← Real.exp_add]; congr 1; ring
    have h3 : Real.exp Δ * Real.exp (-Δ) = 1 := by
      rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
    calc
      (Real.exp (2 * Δ) - 1) - (1 - Real.exp (-2 * Δ))
        = Real.exp (2 * Δ) - 2 * (Real.exp Δ * Real.exp (-Δ)) + Real.exp (-2 * Δ) := by
          rw [h3]; ring
      _ = (Real.exp Δ - Real.exp (-Δ)) ^ 2 := by
          rw [h1, h2]; ring
  have h_sq_nonneg : 0 ≤ (Real.exp Δ - Real.exp (-Δ)) ^ 2 := sq_nonneg _
  have h_up :
      groupSingleLinkCondExp G L S₁ V e φ - groupSingleLinkCondExp G L S₂ V e φ ≤
        Real.exp (2 * Δ) - 1 := by
    have h_mul :
        (Real.exp (2 * Δ) - 1) * groupSingleLinkCondExp G L S₂ V e φ ≤
          (Real.exp (2 * Δ) - 1) * 1 :=
      mul_le_mul_of_nonneg_left hE2_le_one (by linarith)
    linarith
  have h_down :
      -(Real.exp (2 * Δ) - 1) ≤
        groupSingleLinkCondExp G L S₁ V e φ - groupSingleLinkCondExp G L S₂ V e φ := by
    have h_mul :
        (1 - Real.exp (-2 * Δ)) * groupSingleLinkCondExp G L S₂ V e φ ≤
          (1 - Real.exp (-2 * Δ)) * 1 :=
      mul_le_mul_of_nonneg_left hE2_le_one (by linarith)
    linarith
  exact abs_le.mpr ⟨h_down, h_up⟩

/-- Two-action single-link Gibbs operator perturbation bound (local step of Georgii Theorem 8.23):
if the action difference `S₁ - S₂` has single-link oscillation at most `Δ` at link `e₀`, then for
every bounded measurable observable `h : GroupGaugeConfig G L → ℝ`,
`|singleLinkGibbsOperator G L S₁ e₀ h V - singleLinkGibbsOperator G L S₂ e₀ h V| ≤ (Real.exp (2 * Δ) - 1) * linkOscillation G L h e₀`. -/
theorem abs_singleLinkGibbsOperator_two_actions_sub_le
    (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    {L : ℕ} (S₁ S₂ : GroupGaugeConfig G L → ℝ)
    (V : GroupGaugeConfig G L) (e₀ : Link L) (h : GroupGaugeConfig G L → ℝ)
    {Δ B₁ B₂ M : ℝ}
    (hS₁_meas : Measurable (fun g : G => S₁ (updateGroupGaugeLink L V e₀.x e₀.μ g)))
    (hS₁_bdd : ∀ g : G, |S₁ (updateGroupGaugeLink L V e₀.x e₀.μ g)| ≤ B₁)
    (hS₂_meas : Measurable (fun g : G => S₂ (updateGroupGaugeLink L V e₀.x e₀.μ g)))
    (hS₂_bdd : ∀ g : G, |S₂ (updateGroupGaugeLink L V e₀.x e₀.μ g)| ≤ B₂)
    (hh_meas : Measurable (fun g : G => h (updateGroupGaugeLink L V e₀.x e₀.μ g)))
    (hh_bdd : ∀ U : GroupGaugeConfig G L, |h U| ≤ M)
    (h_osc : ∀ g1 g2 : G,
      |(S₁ (updateGroupGaugeLink L V e₀.x e₀.μ g1) -
          S₂ (updateGroupGaugeLink L V e₀.x e₀.μ g1)) -
        (S₁ (updateGroupGaugeLink L V e₀.x e₀.μ g2) -
          S₂ (updateGroupGaugeLink L V e₀.x e₀.μ g2))| ≤ Δ) :
    |singleLinkGibbsOperator G L S₁ e₀ h V -
        singleLinkGibbsOperator G L S₂ e₀ h V| ≤
      (Real.exp (2 * Δ) - 1) * linkOscillation G L h e₀ := by
  let φ : G → ℝ := fun g => h (updateGroupGaugeLink L V e₀.x e₀.μ g)
  let c : ℝ := sInf (Set.range φ)
  let d : ℝ := linkOscillation G L h e₀
  have hd_nonneg : 0 ≤ d := linkOscillation_nonneg G L h e₀
  have h_range_bdd : BddBelow (Set.range φ) := by
    refine ⟨-M, ?_⟩
    rintro _ ⟨g, rfl⟩
    exact (abs_le.mp (hh_bdd _)).1
  have h_range_nonempty : (Set.range φ).Nonempty := ⟨φ 1, 1, rfl⟩
  have hc_le (g : G) : c ≤ φ g := csInf_le h_range_bdd ⟨g, rfl⟩
  have hφ_sub_le (g : G) : φ g - c ≤ d := by
    have hc_ge : φ g - d ≤ c := by
      refine le_csInf h_range_nonempty ?_
      rintro _ ⟨g', rfl⟩
      have h_osc_h := abs_sub_updateGroupGaugeLink_le_linkOscillation G h e₀ hh_bdd V g g'
      have h_up := (abs_le.mp h_osc_h).2
      dsimp [φ, d] at *
      linarith
    linarith
  by_cases hd0 : d = 0
  · have hφ_const (g : G) : φ g = c + 0 * (0 : ℝ) := by
      have h1_le := hc_le g
      have h2_le := hφ_sub_le g
      linarith
    have hφ_eq : φ = fun _ : G => c + 0 * (0 : ℝ) := funext hφ_const
    change |groupSingleLinkCondExp G L S₁ V e₀ φ -
        groupSingleLinkCondExp G L S₂ V e₀ φ| ≤ _
    rw [hφ_eq,
      groupSingleLinkCondExp_const_add_mul G S₁ V e₀ c 0 (fun _ => 0)
        hS₁_meas ⟨B₁, hS₁_bdd⟩ measurable_const ⟨0, fun _ => by simp⟩,
      groupSingleLinkCondExp_const_add_mul G S₂ V e₀ c 0 (fun _ => 0)
        hS₂_meas ⟨B₂, hS₂_bdd⟩ measurable_const ⟨0, fun _ => by simp⟩]
    simp [d, hd0]
  · have hd_pos : 0 < d := lt_of_le_of_ne hd_nonneg (Ne.symm hd0)
    let ψ : G → ℝ := fun g => (φ g - c) / d
    have hψ_meas : Measurable ψ := (hh_meas.sub measurable_const).div_const d
    have hψ_bounds (g : G) : 0 ≤ ψ g ∧ ψ g ≤ 1 := by
      refine ⟨div_nonneg (sub_nonneg.mpr (hc_le g)) hd_pos.le, ?_⟩
      rw [div_le_iff₀ hd_pos, one_mul]
      exact hφ_sub_le g
    have hφ_decomp : φ = fun g : G => c + d * ψ g := by
      funext g
      dsimp [ψ]
      rw [mul_div_cancel₀ _ hd_pos.ne']
      ring
    have hψ_bdd : ∃ M_ψ : ℝ, ∀ g : G, |ψ g| ≤ M_ψ :=
      ⟨1, fun g => abs_le.mpr ⟨by linarith [(hψ_bounds g).1], (hψ_bounds g).2⟩⟩
    have h_lin1 := groupSingleLinkCondExp_const_add_mul G S₁ V e₀ c d ψ
      hS₁_meas ⟨B₁, hS₁_bdd⟩ hψ_meas hψ_bdd
    have h_lin2 := groupSingleLinkCondExp_const_add_mul G S₂ V e₀ c d ψ
      hS₂_meas ⟨B₂, hS₂_bdd⟩ hψ_meas hψ_bdd
    change |groupSingleLinkCondExp G L S₁ V e₀ φ -
        groupSingleLinkCondExp G L S₂ V e₀ φ| ≤ _
    have h_sub :
        groupSingleLinkCondExp G L S₁ V e₀ φ -
          groupSingleLinkCondExp G L S₂ V e₀ φ =
        d * (groupSingleLinkCondExp G L S₁ V e₀ ψ -
          groupSingleLinkCondExp G L S₂ V e₀ ψ) := by
      rw [hφ_decomp, h_lin1, h_lin2]
      ring
    rw [h_sub, abs_mul, abs_of_pos hd_pos, mul_comm (Real.exp (2 * Δ) - 1) d]
    refine mul_le_mul_of_nonneg_left ?_ hd_pos.le
    let d0 :=
      S₁ (updateGroupGaugeLink L V e₀.x e₀.μ 1) -
        S₂ (updateGroupGaugeLink L V e₀.x e₀.μ 1)
    exact groupSingleLinkCondExp_two_actions_oscillation_of_action_diff_bound
      G S₁ S₂ V e₀ ψ hS₁_meas hS₂_meas hS₂_bdd hψ_meas hψ_bounds (fun g => h_osc g 1)

/-- For any two probability measures `μ₁, μ₂` on `GroupGaugeConfig G L` and any bounded measurable
observable `h : GroupGaugeConfig G L → ℝ`,
`|(∫ V, h V ∂μ₁) - (∫ V, h V ∂μ₂)| ≤ 2 * ∑ e : Link L, linkOscillation G L h e`. -/
theorem abs_integral_sub_integral_le_two_mul_sum_linkOscillation
    (G : Type*) [One G] [MeasurableSpace G] {L : ℕ} [NeZero L]
    (μ₁ μ₂ : Measure (GroupGaugeConfig G L))
    [IsProbabilityMeasure μ₁] [IsProbabilityMeasure μ₂]
    (h : GroupGaugeConfig G L → ℝ) {M_h : ℝ}
    (hh_meas : Measurable h) (hh_bdd : ∀ V : GroupGaugeConfig G L, |h V| ≤ M_h) :
    |(∫ V, h V ∂μ₁) - (∫ V, h V ∂μ₂)| ≤
      2 * (∑ e : Link L, linkOscillation G L h e) := by
  let U₀ : GroupGaugeConfig G L := fun _ => 1
  let c : ℝ := h U₀
  let D : ℝ := ∑ e : Link L, linkOscillation G L h e
  let h₀ : GroupGaugeConfig G L → ℝ := fun V => h V - c
  have hh₀_meas : Measurable h₀ := hh_meas.sub measurable_const
  have hh₀_bdd (V : GroupGaugeConfig G L) : |h₀ V| ≤ D :=
    abs_sub_le_sum_linkOscillation G h hh_bdd V U₀
  have h_int₁ : Integrable h₀ μ₁ := by
    refine (integrable_const D).mono' hh₀_meas.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun V => by rw [Real.norm_eq_abs]; exact hh₀_bdd V
  have h_int₂ : Integrable h₀ μ₂ := by
    refine (integrable_const D).mono' hh₀_meas.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun V => by rw [Real.norm_eq_abs]; exact hh₀_bdd V
  have h_eq : (fun V => h V) = fun V => h₀ V + c := by funext V; dsimp [h₀]; ring
  have h_diff_eq :
      (∫ V, h V ∂μ₁) - (∫ V, h V ∂μ₂) =
        (∫ V, h₀ V ∂μ₁) - (∫ V, h₀ V ∂μ₂) := by
    rw [h_eq, integral_add h_int₁ (integrable_const c),
      integral_add h_int₂ (integrable_const c),
      integral_const, probReal_univ, one_smul,
      integral_const, probReal_univ, one_smul]
    ring
  have h_le₁ : |∫ V, h₀ V ∂μ₁| ≤ D := by
    calc
      |∫ V, h₀ V ∂μ₁| ≤ ∫ V, |h₀ V| ∂μ₁ := abs_integral_le_integral_abs
      _ ≤ ∫ _ : GroupGaugeConfig G L, D ∂μ₁ :=
          integral_mono h_int₁.abs (integrable_const _) hh₀_bdd
      _ = D := by rw [integral_const, probReal_univ, one_smul]
  have h_le₂ : |∫ V, h₀ V ∂μ₂| ≤ D := by
    calc
      |∫ V, h₀ V ∂μ₂| ≤ ∫ V, |h₀ V| ∂μ₂ := abs_integral_le_integral_abs
      _ ≤ ∫ _ : GroupGaugeConfig G L, D ∂μ₂ :=
          integral_mono h_int₂.abs (integrable_const _) hh₀_bdd
      _ = D := by rw [integral_const, probReal_univ, one_smul]
  rw [h_diff_eq]
  calc
    |(∫ V, h₀ V ∂μ₁) - (∫ V, h₀ V ∂μ₂)|
      ≤ |∫ V, h₀ V ∂μ₁| + |∫ V, h₀ V ∂μ₂| := abs_sub _ _
    _ ≤ D + D := add_le_add h_le₁ h_le₂
    _ = 2 * D := by ring

/-- **Georgii Theorem 8.23 (Local Single-Link Perturbation Bound for Gibbs Measures):**
if `S₁, S₂ : GroupGaugeConfig G L → ℝ` are measurable bounded actions such that:
1. `S₂` satisfies Dobrushin's uniqueness condition with row-sum bound `0 ≤ q < 1`
   (`∀ e : Link L, (∑ e' : Link L, dobrushinSupMatrix G L S₂ e e') ≤ q`), and
2. The action difference `S₁ - S₂` has **single-link oscillation** at most `Δ ≥ 0` at every link `e`:
   `∀ V e g1 g2, |(S₁ (update V e g1) - S₂ (update V e g1)) - (S₁ (update V e g2) - S₂ (update V e g2))| ≤ Δ`,
then for every bounded measurable observable `f : GroupGaugeConfig G L → ℝ`,
`|(∫ V, f V ∂(groupGibbsMeasure G L S₁)) - (∫ V, f V ∂(groupGibbsMeasure G L S₂))| ≤ ((Real.exp (2 * Δ) - 1) / (1 - q)) * ∑ e : Link L, linkOscillation G L f e`,
which depends **only** on the local single-link oscillation `Δ` and the observable's total link
oscillation `∑ e, linkOscillation G L f e`—with **zero** dependence on the global supremum of
`|S₁ - S₂|` or the lattice volume `Fintype.card (Link L)`. -/
theorem groupGibbsMeasure_expectation_diff_le_of_singleLink_osc
    (G : Type*) [Group G] [TopologicalSpace G] [SecondCountableTopology G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    {L : ℕ} [NeZero L] (S₁ S₂ : GroupGaugeConfig G L → ℝ)
    {q Δ B₁ B₂ M : ℝ} (hq : 0 ≤ q) (hq_lt : q < 1) (hΔ : 0 ≤ Δ)
    (h_row : ∀ e : Link L, (∑ e' : Link L, dobrushinSupMatrix G L S₂ e e') ≤ q)
    (hS₁_meas : Measurable S₁) (hS₁_bdd : ∀ V : GroupGaugeConfig G L, |S₁ V| ≤ B₁)
    (hS₂_meas : Measurable S₂) (hS₂_bdd : ∀ V : GroupGaugeConfig G L, |S₂ V| ≤ B₂)
    (h_osc : ∀ (V : GroupGaugeConfig G L) (e : Link L) (g1 g2 : G),
      |(S₁ (updateGroupGaugeLink L V e.x e.μ g1) -
          S₂ (updateGroupGaugeLink L V e.x e.μ g1)) -
        (S₁ (updateGroupGaugeLink L V e.x e.μ g2) -
          S₂ (updateGroupGaugeLink L V e.x e.μ g2))| ≤ Δ)
    (f : GroupGaugeConfig G L → ℝ)
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GroupGaugeConfig G L, |f V| ≤ M) :
    |(∫ V, f V ∂(groupGibbsMeasure G L S₁)) -
        (∫ V, f V ∂(groupGibbsMeasure G L S₂))| ≤
      ((Real.exp (2 * Δ) - 1) / (1 - q)) *
        (∑ e : Link L, linkOscillation G L f e) := by
  let μ₁ := groupGibbsMeasure G L S₁
  let μ₂ := groupGibbsMeasure G L S₂
  have : IsProbabilityMeasure μ₁ :=
    groupGibbsMeasure_isProbabilityMeasure G S₁ hS₁_meas hS₁_bdd
  have : IsProbabilityMeasure μ₂ :=
    groupGibbsMeasure_isProbabilityMeasure G S₂ hS₂_meas hS₂_bdd
  have h1q_pos : 0 < 1 - q := sub_pos.mpr hq_lt
  have h_exp_nonneg : 0 ≤ Real.exp (2 * Δ) - 1 := by
    have : (1 : ℝ) ≤ Real.exp (2 * Δ) := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by linarith)
    linarith
  have h_coeff_nonneg : 0 ≤ (Real.exp (2 * Δ) - 1) / (1 - q) :=
    div_nonneg h_exp_nonneg h1q_pos.le
  let F := greedySingleLinkGibbsChain G L S₂ f
  let e_seq := greedySingleLinkGibbsLinkSeq G L S₂ f
  have hF_meas (K : ℕ) : Measurable (F K) :=
    measurable_greedySingleLinkGibbsChain G S₂ f hS₂_meas hf_meas K
  have hF_bdd (K : ℕ) (V : GroupGaugeConfig G L) : |F K V| ≤ M :=
    abs_greedySingleLinkGibbsChain_le G S₂ f hS₂_meas hS₂_bdd hf_meas hf_bdd K V
  have h_inv_μ₂ (K : ℕ) : (∫ V, F K V ∂μ₂) = ∫ V, f V ∂μ₂ := by
    induction K with
    | zero => rfl
    | succ K ih =>
      change (∫ V, singleLinkGibbsOperator G L S₂ (e_seq K) (F K) V ∂μ₂) = _
      rw [integral_groupGibbsMeasure_singleLinkGibbsOperator_eq
        G S₂ hS₂_meas hS₂_bdd (e_seq K) (F K) (hF_meas K) (hF_bdd K)]
      exact ih
  have h_step_μ₁ (K : ℕ) :
      |(∫ V, F K V ∂μ₁) - (∫ V, F (K + 1) V ∂μ₁)| +
        ((Real.exp (2 * Δ) - 1) / (1 - q)) *
          (∑ e : Link L, linkOscillation G L (F (K + 1)) e) ≤
      ((Real.exp (2 * Δ) - 1) / (1 - q)) *
        (∑ e : Link L, linkOscillation G L (F K) e) := by
    have h_inv_1 :
        (∫ V, F K V ∂μ₁) =
          ∫ V, singleLinkGibbsOperator G L S₁ (e_seq K) (F K) V ∂μ₁ :=
      (integral_groupGibbsMeasure_singleLinkGibbsOperator_eq
        G S₁ hS₁_meas hS₁_bdd (e_seq K) (F K) (hF_meas K) (hF_bdd K)).symm
    have hP1_meas : Measurable (singleLinkGibbsOperator G L S₁ (e_seq K) (F K)) :=
      measurable_singleLinkGibbsOperator G S₁ (e_seq K) (F K) hS₁_meas (hF_meas K)
    have hP2_meas : Measurable (singleLinkGibbsOperator G L S₂ (e_seq K) (F K)) :=
      measurable_singleLinkGibbsOperator G S₂ (e_seq K) (F K) hS₂_meas (hF_meas K)
    have hP1_int : Integrable (singleLinkGibbsOperator G L S₁ (e_seq K) (F K)) μ₁ := by
      refine (integrable_const M).mono' hP1_meas.aestronglyMeasurable ?_
      exact Filter.Eventually.of_forall fun V => by
        rw [Real.norm_eq_abs]
        exact abs_singleLinkGibbsOperator_le G S₁ (e_seq K) (F K)
          (fun W => hS₁_meas.comp (measurable_updateGroupGaugeLink_right G W _ _))
          (fun W => ⟨B₁, fun u => hS₁_bdd _⟩)
          (fun W => (hF_meas K).comp (measurable_updateGroupGaugeLink_right G W _ _))
          (hF_bdd K) V
    have hP2_int : Integrable (singleLinkGibbsOperator G L S₂ (e_seq K) (F K)) μ₁ := by
      refine (integrable_const M).mono' hP2_meas.aestronglyMeasurable ?_
      exact Filter.Eventually.of_forall fun V => by
        rw [Real.norm_eq_abs]
        exact hF_bdd (K + 1) V
    have h_diff_int :
        |(∫ V, F K V ∂μ₁) - (∫ V, F (K + 1) V ∂μ₁)| ≤
          (Real.exp (2 * Δ) - 1) * linkOscillation G L (F K) (e_seq K) := by
      rw [h_inv_1]
      change |(∫ V, singleLinkGibbsOperator G L S₁ (e_seq K) (F K) V ∂μ₁) -
          (∫ V, singleLinkGibbsOperator G L S₂ (e_seq K) (F K) V ∂μ₁)| ≤ _
      rw [← integral_sub hP1_int hP2_int]
      calc
        |∫ V, (singleLinkGibbsOperator G L S₁ (e_seq K) (F K) V -
            singleLinkGibbsOperator G L S₂ (e_seq K) (F K) V) ∂μ₁|
          ≤ ∫ V, |singleLinkGibbsOperator G L S₁ (e_seq K) (F K) V -
              singleLinkGibbsOperator G L S₂ (e_seq K) (F K) V| ∂μ₁ :=
            abs_integral_le_integral_abs
        _ ≤ ∫ _ : GroupGaugeConfig G L,
              (Real.exp (2 * Δ) - 1) * linkOscillation G L (F K) (e_seq K) ∂μ₁ := by
            refine integral_mono (hP1_int.sub hP2_int).abs (integrable_const _) fun V => ?_
            exact abs_singleLinkGibbsOperator_two_actions_sub_le
              G S₁ S₂ V (e_seq K) (F K)
              (hS₁_meas.comp (measurable_updateGroupGaugeLink_right G V _ _))
              (fun g => hS₁_bdd _)
              (hS₂_meas.comp (measurable_updateGroupGaugeLink_right G V _ _))
              (fun g => hS₂_bdd _)
              ((hF_meas K).comp (measurable_updateGroupGaugeLink_right G V _ _))
              (hF_bdd K)
              (h_osc V (e_seq K))
        _ = (Real.exp (2 * Δ) - 1) * linkOscillation G L (F K) (e_seq K) := by
            rw [integral_const, probReal_univ, one_smul]
    have h_georgii :=
      sum_linkOscillation_singleLinkGibbsOperator_le G S₂ h_row (e_seq K) (F K)
        (fun W => hS₂_meas.comp (measurable_updateGroupGaugeLink_right G W _ _))
        (fun W => ⟨B₂, fun u => hS₂_bdd _⟩)
        (fun W => (hF_meas K).comp (measurable_updateGroupGaugeLink_right G W _ _))
        ⟨M, hF_bdd K⟩
    have h_mul_georgii := mul_le_mul_of_nonneg_left h_georgii h_coeff_nonneg
    have h_cancel :
        ((Real.exp (2 * Δ) - 1) / (1 - q)) * ((1 - q) * linkOscillation G L (F K) (e_seq K)) =
          (Real.exp (2 * Δ) - 1) * linkOscillation G L (F K) (e_seq K) := by
      rw [← mul_assoc, div_mul_cancel₀ _ h1q_pos.ne']
    change |(∫ V, F K V ∂μ₁) - (∫ V, F (K + 1) V ∂μ₁)| +
        ((Real.exp (2 * Δ) - 1) / (1 - q)) *
          (∑ e : Link L,
            linkOscillation G L (singleLinkGibbsOperator G L S₂ (e_seq K) (F K)) e) ≤ _
    linarith
  have h_tele (K : ℕ) :
      |(∫ V, f V ∂μ₁) - (∫ V, F K V ∂μ₁)| +
        ((Real.exp (2 * Δ) - 1) / (1 - q)) *
          (∑ e : Link L, linkOscillation G L (F K) e) ≤
      ((Real.exp (2 * Δ) - 1) / (1 - q)) *
        (∑ e : Link L, linkOscillation G L f e) := by
    induction K with
    | zero => simp [F, greedySingleLinkGibbsChain]
    | succ K ih =>
      have h_st := h_step_μ₁ K
      have h_tri :
          |(∫ V, f V ∂μ₁) - (∫ V, F (K + 1) V ∂μ₁)| ≤
            |(∫ V, f V ∂μ₁) - (∫ V, F K V ∂μ₁)| +
              |(∫ V, F K V ∂μ₁) - (∫ V, F (K + 1) V ∂μ₁)| := by
        have h_split :
            (∫ V, f V ∂μ₁) - (∫ V, F (K + 1) V ∂μ₁) =
              ((∫ V, f V ∂μ₁) - (∫ V, F K V ∂μ₁)) +
                ((∫ V, F K V ∂μ₁) - (∫ V, F (K + 1) V ∂μ₁)) := by ring
        rw [h_split]
        exact abs_add_le _ _
      linarith
  have h_bound_K (K : ℕ) :
      |(∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)| ≤
        2 * (∑ e : Link L, linkOscillation G L (F K) e) +
          ((Real.exp (2 * Δ) - 1) / (1 - q)) *
            (∑ e : Link L, linkOscillation G L f e) := by
    have h_rem_K :
        |(∫ V, F K V ∂μ₁) - (∫ V, f V ∂μ₂)| ≤
          2 * (∑ e : Link L, linkOscillation G L (F K) e) := by
      rw [← h_inv_μ₂ K]
      exact abs_integral_sub_integral_le_two_mul_sum_linkOscillation
        G μ₁ μ₂ (F K) (hF_meas K) (hF_bdd K)
    have h_tri :
        |(∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)| ≤
          |(∫ V, f V ∂μ₁) - (∫ V, F K V ∂μ₁)| +
            |(∫ V, F K V ∂μ₁) - (∫ V, f V ∂μ₂)| := by
      have h_split :
          (∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂) =
            ((∫ V, f V ∂μ₁) - (∫ V, F K V ∂μ₁)) +
              ((∫ V, F K V ∂μ₁) - (∫ V, f V ∂μ₂)) := by ring
      rw [h_split]
      exact abs_add_le _ _
    have h_nonneg_osc :
        0 ≤ ((Real.exp (2 * Δ) - 1) / (1 - q)) *
          (∑ e : Link L, linkOscillation G L (F K) e) :=
      mul_nonneg h_coeff_nonneg
        (Finset.sum_nonneg fun e _ => linkOscillation_nonneg G L (F K) e)
    linarith [h_tele K]
  have h_tendsto_osc :=
    tendsto_sum_linkOscillation_greedySingleLinkGibbsChain_zero
      G S₂ hq hq_lt h_row f hS₂_meas hS₂_bdd hf_meas hf_bdd
  have h_tendsto_mul :
      Filter.Tendsto
        (fun K : ℕ => 2 * (∑ e : Link L, linkOscillation G L (F K) e))
        Filter.atTop (nhds 0) := by
    simpa [mul_zero] using h_tendsto_osc.const_mul (2 : ℝ)
  have h_tendsto_rhs :
      Filter.Tendsto
        (fun K : ℕ =>
          2 * (∑ e : Link L, linkOscillation G L (F K) e) +
            ((Real.exp (2 * Δ) - 1) / (1 - q)) *
              (∑ e : Link L, linkOscillation G L f e))
        Filter.atTop
        (nhds (0 + ((Real.exp (2 * Δ) - 1) / (1 - q)) *
          (∑ e : Link L, linkOscillation G L f e))) :=
    h_tendsto_mul.add tendsto_const_nhds
  rw [zero_add] at h_tendsto_rhs
  exact le_of_tendsto_of_tendsto tendsto_const_nhds h_tendsto_rhs
    (Filter.Eventually.of_forall h_bound_K)

/-- Single-link oscillation subadditivity for products of `[-1, 1]`-valued observables:
if `∀ V, |f V| ≤ 1` and `∀ V, |g V| ≤ 1`, then for every link `e : Link L`,
`linkOscillation G L (fun V => f V * g V) e ≤ linkOscillation G L f e + linkOscillation G L g e`. -/
theorem linkOscillation_mul_le_add_of_abs_le_one
    (G : Type*) [One G] {L : ℕ}
    (f g : GroupGaugeConfig G L → ℝ)
    (hf_bdd : ∀ V : GroupGaugeConfig G L, |f V| ≤ 1)
    (hg_bdd : ∀ V : GroupGaugeConfig G L, |g V| ≤ 1)
    (e : Link L) :
    linkOscillation G L (fun V => f V * g V) e ≤
      linkOscillation G L f e + linkOscillation G L g e := by
  refine linkOscillation_le_of_forall_le G (fun V => f V * g V) e ?_
  intro V g1 g2
  let V1 := updateGroupGaugeLink L V e.x e.μ g1
  let V2 := updateGroupGaugeLink L V e.x e.μ g2
  have h_split :
      f V1 * g V1 - f V2 * g V2 =
        (f V1 - f V2) * g V1 + f V2 * (g V1 - g V2) := by ring
  have hf_osc : |f V1 - f V2| ≤ linkOscillation G L f e :=
    abs_sub_updateGroupGaugeLink_le_linkOscillation G f e hf_bdd V g1 g2
  have hg_osc : |g V1 - g V2| ≤ linkOscillation G L g e :=
    abs_sub_updateGroupGaugeLink_le_linkOscillation G g e hg_bdd V g1 g2
  have hg1 : |g V1| ≤ 1 := hg_bdd V1
  have hf2 : |f V2| ≤ 1 := hf_bdd V2
  have h1 : |(f V1 - f V2) * g V1| ≤ linkOscillation G L f e := by
    rw [abs_mul]
    calc
      |f V1 - f V2| * |g V1| ≤ linkOscillation G L f e * 1 :=
        mul_le_mul hf_osc hg1 (abs_nonneg _) (linkOscillation_nonneg G L f e)
      _ = linkOscillation G L f e := mul_one _
  have h2 : |f V2 * (g V1 - g V2)| ≤ linkOscillation G L g e := by
    rw [abs_mul]
    calc
      |f V2| * |g V1 - g V2| ≤ 1 * linkOscillation G L g e :=
        mul_le_mul hf2 hg_osc (abs_nonneg _) zero_le_one
      _ = linkOscillation G L g e := one_mul _
  rw [h_split]
  exact (abs_add_le _ _).trans (add_le_add h1 h2)

/-- Volume-independent total single-link oscillation budget of the renormalized reflected probe
Wilson-loop pair `(ℓ_probe.timeReflect, ℓ_probe)` at coarse lattice spacing `a`:
equals `2 * ((ℓ_probe.timeReflect.latticeLoop a).length + (ℓ_probe.latticeLoop a).length)`
(`= 16` for a unit plaquette), completely independent of the torus side `L`. -/
def probeLoopOscillationBudget (a : ℝ) (ℓ_probe : PhysicalRectangle) : ℝ :=
  2 * (((ℓ_probe.timeReflect.latticeLoop a).length + (ℓ_probe.latticeLoop a).length : ℕ) : ℝ)

theorem probeLoopOscillationBudget_nonneg (a : ℝ) (ℓ_probe : PhysicalRectangle) :
    0 ≤ probeLoopOscillationBudget a ℓ_probe := by
  unfold probeLoopOscillationBudget
  positivity

/-- For any torus side `L ≥ 1`, coarse spacing `a : ℝ`, rectangle `ℓ : PhysicalRectangle`, and
renormalization factor `z : ℝ` with `|z| ≤ 1`, the torus-wide sum of single-link oscillations of
`fun V => z * physicalWilsonLoop L a ℓ V` is bounded by `2 * ((ℓ.latticeLoop a).length : ℝ)`,
independent of `L`. -/
theorem sum_linkOscillation_mul_physicalWilsonLoop_le_two_mul_length
    (L : ℕ) [NeZero L] (a : ℝ) (ℓ : PhysicalRectangle) {z : ℝ} (hz : |z| ≤ 1) :
    (∑ e : Link L, linkOscillation SU2 L (fun V => z * physicalWilsonLoop L a ℓ V) e) ≤
      2 * ((ℓ.latticeLoop a).length : ℝ) := by
  let f : GroupGaugeConfig SU2 L → ℝ := fun V => z * physicalWilsonLoop L a ℓ V
  have h_vanish (e : Link L) (he : e ∉ physicalRectangleSupport L a ℓ) :
      linkOscillation SU2 L f e = 0 := by
    refine linkOscillation_eq_zero_of_independent SU2 f e fun V g1 g2 => ?_
    dsimp [f]
    rw [physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a ℓ V he g1,
      physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a ℓ V he g2]
  have h_le_two (e : Link L) : linkOscillation SU2 L f e ≤ 2 := by
    refine linkOscillation_le_of_forall_le SU2 f e fun V g1 g2 => ?_
    dsimp [f]
    have h1 := abs_physicalWilsonLoop_le_one L a ℓ (updateGroupGaugeLink L V e.x e.μ g1)
    have h2 := abs_physicalWilsonLoop_le_one L a ℓ (updateGroupGaugeLink L V e.x e.μ g2)
    have hb1 : |z * physicalWilsonLoop L a ℓ (updateGroupGaugeLink L V e.x e.μ g1)| ≤ 1 := by
      rw [abs_mul]
      nlinarith [abs_nonneg z,
        abs_nonneg (physicalWilsonLoop L a ℓ (updateGroupGaugeLink L V e.x e.μ g1))]
    have hb2 : |z * physicalWilsonLoop L a ℓ (updateGroupGaugeLink L V e.x e.μ g2)| ≤ 1 := by
      rw [abs_mul]
      nlinarith [abs_nonneg z,
        abs_nonneg (physicalWilsonLoop L a ℓ (updateGroupGaugeLink L V e.x e.μ g2))]
    exact (abs_sub _ _).trans (by linarith)
  have h_supp :
      (∑ e : Link L, linkOscillation SU2 L f e) =
        ∑ e ∈ physicalRectangleSupport L a ℓ, linkOscillation SU2 L f e := by
    rw [← Finset.sum_subset (Finset.subset_univ (physicalRectangleSupport L a ℓ))]
    intro e _ he
    exact h_vanish e he
  have h_card :
      ((physicalRectangleSupport L a ℓ).card : ℝ) ≤ ((ℓ.latticeLoop a).length : ℝ) :=
    Nat.cast_le.mpr (card_physicalRectangleSupport_le_length L a ℓ)
  change (∑ e : Link L, linkOscillation SU2 L f e) ≤ 2 * ((ℓ.latticeLoop a).length : ℝ)
  rw [h_supp]
  calc
    (∑ e ∈ physicalRectangleSupport L a ℓ, linkOscillation SU2 L f e)
      ≤ ∑ _e ∈ physicalRectangleSupport L a ℓ, (2 : ℝ) :=
        Finset.sum_le_sum fun e _ => h_le_two e
    _ = 2 * ((physicalRectangleSupport L a ℓ).card : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul]
        ring
    _ ≤ 2 * ((ℓ.latticeLoop a).length : ℝ) :=
        mul_le_mul_of_nonneg_left h_card (by norm_num)

/-- The combined torus-wide link oscillation of the renormalized reflected probe Wilson-loop pair
`(ℓ_probe.timeReflect, ℓ_probe)` with `|z_ref| ≤ 1` and `|z_pos| ≤ 1` is bounded by
`probeLoopOscillationBudget a ℓ_probe`, uniformly in `L`. -/
theorem sum_linkOscillation_physicalWilsonLoop_probe_le
    (L : ℕ) [NeZero L] (a : ℝ) (ℓ_probe : PhysicalRectangle)
    {z_ref z_pos : ℝ} (hz_ref : |z_ref| ≤ 1) (hz_pos : |z_pos| ≤ 1) :
    (∑ e : Link L,
        linkOscillation SU2 L (fun V => z_ref * physicalWilsonLoop L a ℓ_probe.timeReflect V) e) +
      (∑ e : Link L,
        linkOscillation SU2 L (fun V => z_pos * physicalWilsonLoop L a ℓ_probe V) e) ≤
      probeLoopOscillationBudget a ℓ_probe := by
  have h1 := sum_linkOscillation_mul_physicalWilsonLoop_le_two_mul_length L a ℓ_probe.timeReflect hz_ref
  have h2 := sum_linkOscillation_mul_physicalWilsonLoop_le_two_mul_length L a ℓ_probe hz_pos
  unfold probeLoopOscillationBudget
  push_cast
  linarith

/-- The combined torus-wide link oscillation of the undressed reflected probe Wilson-loop pair
`(physicalWilsonLoop L a ℓ_probe.timeReflect, physicalWilsonLoop L a ℓ_probe)` is bounded by
`probeLoopOscillationBudget a ℓ_probe`, uniformly in `L`. -/
theorem sum_linkOscillation_undressed_physicalWilsonLoop_probe_le
    (L : ℕ) [NeZero L] (a : ℝ) (ℓ_probe : PhysicalRectangle) :
    (∑ e : Link L,
        linkOscillation SU2 L (physicalWilsonLoop L a ℓ_probe.timeReflect) e) +
      (∑ e : Link L,
        linkOscillation SU2 L (physicalWilsonLoop L a ℓ_probe) e) ≤
      probeLoopOscillationBudget a ℓ_probe := by
  have h := sum_linkOscillation_physicalWilsonLoop_probe_le L a ℓ_probe
    (z_ref := 1) (z_pos := 1) (by simp) (by simp)
  simpa only [one_mul] using h

/-- Non-vacuity and strong-coupling consistency of the 3-cube degree-4 character floor
`c_char * β ^ 4 = (1 / 4) ^ 5 * β ^ 4 = β ^ 4 / 1024` inside the crossover coupling window
`canonicalCrossoverBetaLo ≤ β ≤ canonicalCrossoverBetaHi`:
for `c_char = (1 / 4) ^ 5 = 1 / 1024` and any local single-link remainder oscillation budget
`0 ≤ δ_rem_link` with `0 ≤ M_osc` and `M_osc * δ_rem_link ≤ (canonicalCrossoverCovLo : ℝ) / 12`
(and `δ_rem_link ≤ 1 / 4`), the degree-4 character floor `(1 / 4) ^ 5 * β ^ 4` simultaneously:
1. Dominates `(canonicalCrossoverCovLo : ℝ) + 3 * M_osc * (Real.exp (2 * δ_rem_link) - 1)`, and
2. Lies strictly below the center-twist strong-coupling upper bound `12 * β ≤ Real.exp (12 * β) - 1`. -/
theorem canonicalCrossover_character_floor_consistent_with_centerTwist_upper_bound
    {β δ_rem : ℝ}
    (hβ_lo : (canonicalCrossoverBetaLo : ℝ) ≤ β)
    (hβ_hi : β ≤ (canonicalCrossoverBetaHi : ℝ))
    (hδ0 : 0 ≤ δ_rem)
    (hδ_le : δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12) :
    (canonicalCrossoverCovLo : ℝ) + 3 * (Real.exp (2 * δ_rem) - 1) ≤
      (1 / 4 : ℝ) ^ 5 * β ^ 4 ∧
    (1 / 4 : ℝ) ^ 5 * β ^ 4 < 12 * β ∧
    12 * β ≤ Real.exp (12 * β) - 1 := by
  have h_lo_pos : (0 : ℝ) < (canonicalCrossoverBetaLo : ℝ) := by
    norm_num [canonicalCrossoverBetaLo]
  have hβ_pos : 0 < β := h_lo_pos.trans_le hβ_lo
  have h_cov_eq :
      (canonicalCrossoverCovLo : ℝ) =
        ((1 / 4 : ℝ) ^ 5 * (canonicalCrossoverBetaLo : ℝ) ^ 4) / 2 := by
    norm_num [canonicalCrossoverCovLo, canonicalCrossoverBetaLo]
  have h_pow_mono :
      (canonicalCrossoverBetaLo : ℝ) ^ 4 ≤ β ^ 4 :=
    pow_le_pow_left₀ h_lo_pos.le hβ_lo 4
  have h_two_cov :
      2 * (canonicalCrossoverCovLo : ℝ) ≤ (1 / 4 : ℝ) ^ 5 * β ^ 4 := by
    rw [h_cov_eq]
    linarith
  have h_2δ_half : 2 * δ_rem ≤ 1 / 2 := by
    have h_cov_small : (canonicalCrossoverCovLo : ℝ) ≤ 1 := by
      norm_num [canonicalCrossoverCovLo]
    linarith
  have h_exp_rem :
      3 * (Real.exp (2 * δ_rem) - 1) ≤ (canonicalCrossoverCovLo : ℝ) := by
    have h2 := exp_sub_one_le_two_mul_of_nonneg_of_le_half (by linarith : 0 ≤ 2 * δ_rem) h_2δ_half
    linarith
  have h_beta_lt_one : β < 1 := by
    have : (canonicalCrossoverBetaHi : ℝ) < 1 := by norm_num [canonicalCrossoverBetaHi]
    exact hβ_hi.trans_lt this
  have h_b4_lt : (1 / 4 : ℝ) ^ 5 * β ^ 4 < 12 * β := by
    have h_b3_lt_one : β ^ 3 < 1 := by nlinarith [sq_nonneg β]
    have h_b4_le_b : β ^ 4 ≤ β := by nlinarith [sq_nonneg β]
    nlinarith
  have h_12b_le_exp : 12 * β ≤ Real.exp (12 * β) - 1 := by
    have := Real.add_one_le_exp (12 * β)
    linarith
  exact ⟨by linarith, h_b4_lt, h_12b_le_exp⟩

/-- Whenever a probe rectangle `ℓ_probe` has at least one lattice step at spacing `a`
(`1 ≤ (ℓ_probe.latticeLoop a).length`), its total link oscillation budget satisfies
`1 ≤ probeLoopOscillationBudget a ℓ_probe`. -/
theorem one_le_probeLoopOscillationBudget_of_length_pos
    (a : ℝ) (ℓ_probe : PhysicalRectangle)
    (h_len : 1 ≤ (ℓ_probe.latticeLoop a).length) :
    1 ≤ probeLoopOscillationBudget a ℓ_probe := by
  unfold probeLoopOscillationBudget
  have h1 : (1 : ℝ) ≤ ((ℓ_probe.latticeLoop a).length : ℝ) := Nat.one_le_cast.mpr h_len
  have h0 : (0 : ℝ) ≤ ((ℓ_probe.timeReflect.latticeLoop a).length : ℝ) := Nat.cast_nonneg _
  push_cast
  linarith

/-- Unconditional crossover character-dominance theorem (`canonicalCrossover_char_dom_of_beta_lo_and_probe_osc`):
for any coupling `β ≥ canonicalCrossoverBetaLo`, non-negative observable oscillation budget `M_osc ≥ 0`,
and local single-link remainder oscillation `0 ≤ δ_rem ≤ 1 / 4` satisfying
`M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12`, the 6-face unit 3-cube degree-4 character floor
`(1 / 4) ^ 5 * β ^ 4` dominates the Georgii Theorem 8.23 perturbation budget:
`(canonicalCrossoverCovLo : ℝ) + 3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤ (1 / 4 : ℝ) ^ 5 * β ^ 4`. -/
theorem canonicalCrossover_char_dom_of_beta_lo_and_probe_osc
    {β δ_rem M_osc : ℝ}
    (hβ_lo : (canonicalCrossoverBetaLo : ℝ) ≤ β)
    (hδ0 : 0 ≤ δ_rem)
    (hδ_quarter : δ_rem ≤ 1 / 4)
    (hM0 : 0 ≤ M_osc)
    (h_prod_le : M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12) :
    (canonicalCrossoverCovLo : ℝ) + 3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤
      (1 / 4 : ℝ) ^ 5 * β ^ 4 := by
  have h_lo_pos : (0 : ℝ) < (canonicalCrossoverBetaLo : ℝ) := by
    norm_num [canonicalCrossoverBetaLo]
  have h_cov_eq :
      (canonicalCrossoverCovLo : ℝ) =
        ((1 / 4 : ℝ) ^ 5 * (canonicalCrossoverBetaLo : ℝ) ^ 4) / 2 := by
    norm_num [canonicalCrossoverCovLo, canonicalCrossoverBetaLo]
  have h_pow_mono :
      (canonicalCrossoverBetaLo : ℝ) ^ 4 ≤ β ^ 4 :=
    pow_le_pow_left₀ h_lo_pos.le hβ_lo 4
  have h_two_cov :
      2 * (canonicalCrossoverCovLo : ℝ) ≤ (1 / 4 : ℝ) ^ 5 * β ^ 4 := by
    rw [h_cov_eq]
    linarith
  have h_2δ_nonneg : 0 ≤ 2 * δ_rem := by linarith
  have h_2δ_half : 2 * δ_rem ≤ 1 / 2 := by linarith
  have h_exp_le : Real.exp (2 * δ_rem) - 1 ≤ 4 * δ_rem := by
    have h2 := exp_sub_one_le_two_mul_of_nonneg_of_le_half h_2δ_nonneg h_2δ_half
    linarith
  have h_3M_nonneg : 0 ≤ 3 * M_osc := by linarith
  have h_mul_exp :
      3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤ 3 * M_osc * (4 * δ_rem) :=
    mul_le_mul_of_nonneg_left h_exp_le h_3M_nonneg
  have h_alg : 3 * M_osc * (4 * δ_rem) = 12 * (M_osc * δ_rem) := by ring
  rw [h_alg] at h_mul_exp
  have h_exp_rem :
      3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤ (canonicalCrossoverCovLo : ℝ) := by
    linarith
  linarith

/-- Whenever `1 ≤ M_osc` and `0 ≤ δ_rem`, the product bound
`M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12` automatically implies `δ_rem ≤ 1 / 4`. -/
theorem delta_rem_le_one_fourth_of_one_le_and_mul_le_covLo_div_twelve
    {δ_rem M_osc : ℝ}
    (hδ0 : 0 ≤ δ_rem)
    (hM1 : 1 ≤ M_osc)
    (h_prod_le : M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12) :
    δ_rem ≤ 1 / 4 := by
  have h_le_prod : δ_rem ≤ M_osc * δ_rem := by
    calc
      δ_rem = 1 * δ_rem := (one_mul δ_rem).symm
      _ ≤ M_osc * δ_rem := mul_le_mul_of_nonneg_right hM1 hδ0
  have h_cov_quarter : (canonicalCrossoverCovLo : ℝ) / 12 ≤ 1 / 4 := by
    norm_num [canonicalCrossoverCovLo]
  exact (h_le_prod.trans h_prod_le).trans h_cov_quarter

/-- When `1 ≤ M_osc` (in particular for `M_osc = probeLoopOscillationBudget a ℓ_probe` whenever
`1 ≤ (ℓ_probe.latticeLoop a).length`), `M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12` with
`0 ≤ δ_rem` suffices to establish character dominance without assuming `δ_rem ≤ 1 / 4` separately. -/
theorem canonicalCrossover_char_dom_of_beta_lo_and_one_le_osc
    {β δ_rem M_osc : ℝ}
    (hβ_lo : (canonicalCrossoverBetaLo : ℝ) ≤ β)
    (hδ0 : 0 ≤ δ_rem)
    (hM1 : 1 ≤ M_osc)
    (h_prod_le : M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12) :
    (canonicalCrossoverCovLo : ℝ) + 3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤
      (1 / 4 : ℝ) ^ 5 * β ^ 4 :=
  canonicalCrossover_char_dom_of_beta_lo_and_probe_osc hβ_lo hδ0
    (delta_rem_le_one_fourth_of_one_le_and_mul_le_covLo_div_twelve hδ0 hM1 h_prod_le)
    (by linarith) h_prod_le

/-- Strengthened `((3 / 4) * (1 / 4) ^ 5) * β ^ 4` character dominance under
`M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 24` and `1 ≤ M_osc`:
matches the exact coefficient-`1` 3-cube cluster floor `((3 / 4) * (1 / 4) ^ 5) * β ^ 4` from
`wilsonMeasure_irCov_ge_of_cube_sixFace_and_cluster_remainder` without assuming `δ_rem ≤ 1 / 4`. -/
theorem canonicalCrossover_char_dom_three_fourths_of_beta_lo_and_one_le_osc
    {β δ_rem M_osc : ℝ}
    (hβ_lo : (canonicalCrossoverBetaLo : ℝ) ≤ β)
    (hδ0 : 0 ≤ δ_rem)
    (hM1 : 1 ≤ M_osc)
    (h_prod_le : M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 24) :
    (canonicalCrossoverCovLo : ℝ) + 3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤
      ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * β ^ 4 := by
  have h_cov_pos : (0 : ℝ) < (canonicalCrossoverCovLo : ℝ) := by
    norm_num [canonicalCrossoverCovLo]
  have h_prod12 : M_osc * δ_rem ≤ (canonicalCrossoverCovLo : ℝ) / 12 := by linarith
  have hδ_quarter : δ_rem ≤ 1 / 4 :=
    delta_rem_le_one_fourth_of_one_le_and_mul_le_covLo_div_twelve hδ0 hM1 h_prod12
  have h_lo_pos : (0 : ℝ) < (canonicalCrossoverBetaLo : ℝ) := by
    norm_num [canonicalCrossoverBetaLo]
  have h_cov_eq :
      (canonicalCrossoverCovLo : ℝ) =
        ((1 / 4 : ℝ) ^ 5 * (canonicalCrossoverBetaLo : ℝ) ^ 4) / 2 := by
    norm_num [canonicalCrossoverCovLo, canonicalCrossoverBetaLo]
  have h_pow_mono :
      (canonicalCrossoverBetaLo : ℝ) ^ 4 ≤ β ^ 4 :=
    pow_le_pow_left₀ h_lo_pos.le hβ_lo 4
  have h_2δ_nonneg : 0 ≤ 2 * δ_rem := by linarith
  have h_2δ_half : 2 * δ_rem ≤ 1 / 2 := by linarith
  have h_exp_le : Real.exp (2 * δ_rem) - 1 ≤ 4 * δ_rem := by
    have h2 := exp_sub_one_le_two_mul_of_nonneg_of_le_half h_2δ_nonneg h_2δ_half
    linarith
  have h_3M_nonneg : 0 ≤ 3 * M_osc := by linarith
  have h_mul_exp :
      3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤ 3 * M_osc * (4 * δ_rem) :=
    mul_le_mul_of_nonneg_left h_exp_le h_3M_nonneg
  have h_alg : 3 * M_osc * (4 * δ_rem) = 12 * (M_osc * δ_rem) := by ring
  rw [h_alg] at h_mul_exp
  have h_exp_rem :
      3 * M_osc * (Real.exp (2 * δ_rem) - 1) ≤ (canonicalCrossoverCovLo : ℝ) / 2 := by
    linarith
  rw [h_cov_eq] at h_exp_rem ⊢
  linarith

/-- Translation-invariant non-abelian gauge configuration on `GaugeConfig L` assigning `su2PauliI`
to temporal links (`e.μ = 0`) and `su2PauliJ` to spatial links (`e.μ ≠ 0`). -/
def constantPauliIJConfig (L : ℕ) : GaugeConfig L :=
  fun e => if e.μ = 0 then su2PauliI else su2PauliJ

/-- Every `(0, 1)` plaquette `⟨x, 0, 1, by decide⟩` on `constantPauliIJConfig L` has non-abelian
commutator holonomy `su2PauliI * su2PauliJ * su2PauliI⁻¹ * su2PauliJ⁻¹ = su2QuatCenterFlip = -1`
and maximal plaquette action `plaquetteAction = 2`. -/
theorem plaquetteAction_constantPauliIJConfig_zero_one {L : ℕ} (x : Lattice4D L) :
    plaquetteAction (constantPauliIJConfig L) ⟨x, 0, 1, by decide⟩ = 2 := by
  have h_hol :
      plaquetteHolonomy (constantPauliIJConfig L) ⟨x, 0, 1, by decide⟩ = su2QuatCenterFlip := by
    dsimp [plaquetteHolonomy, constantPauliIJConfig]
    exact su2Pauli_and_pythagorean345_identities.2.2.1
  unfold plaquetteAction
  rw [h_hol, su2Pauli_and_pythagorean345_identities.2.2.2.2.2.1]
  ring

/-- Resolution of the extensive-polymer remainder obstruction:
for any non-negative per-plaquette polymer weight `w ≥ 0` and every torus size `L ≥ 1`:
1. **Local single-link oscillation is volume-independent:** updating any single link `e : Link L`
   changes `(PolymerActivityFamily.localPlaquette L w).eval` by at most `12 * w`, uniformly for all
   `L ≥ 1` (since each link belongs to at most 6 plaquettes), whereas
2. **Global evaluation grows with volume $L^4$:** on `constantPauliIJConfig L`,
   `(2 * w) * (L ^ 4 : ℝ) ≤ (PolymerActivityFamily.localPlaquette L w).eval (constantPauliIJConfig L)`. -/
theorem localPlaquette_satisfies_local_osc_and_grows_with_volume
    (L : ℕ) [NeZero L] {w : ℝ} (hw : 0 ≤ w) :
    (∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |(PolymerActivityFamily.localPlaquette L w).eval (updateGaugeLink L V e.x e.μ g1) -
        (PolymerActivityFamily.localPlaquette L w).eval (updateGaugeLink L V e.x e.μ g2)| ≤
        12 * w) ∧
    (2 * w) * ((L ^ 4 : ℕ) : ℝ) ≤
      (PolymerActivityFamily.localPlaquette L w).eval (constantPauliIJConfig L) := by
  refine ⟨fun V e g1 g2 => ?_, ?_⟩
  · rw [PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction,
      PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction]
    exact wilsonAction_singleLink_oscillation_le L hw V e.x e.μ g1 g2
  · rw [PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction]
    unfold wilsonAction
    let emb : Lattice4D L ↪ Plaquette L :=
      ⟨fun x => ⟨x, 0, 1, by decide⟩, fun x1 x2 h => by injection h⟩
    have h_sub :
        (∑ x : Lattice4D L, plaquetteAction (constantPauliIJConfig L) (emb x)) ≤
          ∑ p : Plaquette L, plaquetteAction (constantPauliIJConfig L) p := by
      rw [← Finset.sum_map Finset.univ emb]
      exact Finset.sum_le_univ_sum_of_nonneg fun p =>
        plaquetteAction_nonneg (constantPauliIJConfig L) p
    have h_emb (x : Lattice4D L) : emb x = ⟨x, 0, 1, by decide⟩ := rfl
    have h_eval_sum :
        (∑ x : Lattice4D L, plaquetteAction (constantPauliIJConfig L) (emb x)) =
          2 * ((L ^ 4 : ℕ) : ℝ) := by
      simp_rw [h_emb, plaquetteAction_constantPauliIJConfig_zero_one]
      rw [Finset.sum_const, Finset.card_univ, card_lattice4D L, nsmul_eq_mul]
      ring
    have h_mul := mul_le_mul_of_nonneg_left h_sub hw
    rw [h_eval_sum] at h_mul
    linarith

/-- Gap 3 Theorem (Global-Remainder Variant):
for any interacting effective action state `st : InteractingEffectiveActionState L` whose polymer +
truncation remainder satisfies `∀ V, |st.polymers.eval V + st.R_trunc V| ≤ δ_rem`, if the pure
Wilson measure `wilsonMeasure (gaugeHaarMeasure L) st.β` has leading degree-4 $O(\beta^4)$ Haar
character probe covariance lower bound
`c_char * st.β ^ 4 ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g|`
dominating the Boltzmann perturbation `3 * (Real.exp (2 * δ_rem) - 1)` via
`c_vac + 3 * (Real.exp (2 * δ_rem) - 1) ≤ c_char * st.β ^ 4`, then
`c_vac ≤ |irCov st.gibbsMeasure f g|`. -/
theorem irCov_lower_bound_of_wilson_character_floor {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) {ε_star δ_rem c_char c_vac : ℝ}
    (hδ : 0 ≤ δ_rem)
    (hβ0 : 0 ≤ st.β) (hR_meas : Measurable st.R_trunc)
    (hR_bdd : ∀ V : GaugeConfig L, |st.R_trunc V| ≤ ε_star)
    (h_rem : ∀ V : GaugeConfig L, |st.polymers.eval V + st.R_trunc V| ≤ δ_rem)
    {f g : GaugeConfig L → ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GaugeConfig L, |f V| ≤ 1)
    (hg_meas : Measurable g) (hg_bdd : ∀ V : GaugeConfig L, |g V| ≤ 1)
    (h_char_floor :
      c_char * st.β ^ 4 ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g|)
    (h_dom : c_vac + 3 * (Real.exp (2 * δ_rem) - 1) ≤ c_char * st.β ^ 4) :
    c_vac ≤ |irCov st.gibbsMeasure f g| := by
  have h_diff_pw (V : GaugeConfig L) :
      |(wilsonAction st.β V + st.polymers.eval V + st.R_trunc V) -
        (wilsonAction (pureWilson L st.β).β V +
          (pureWilson L st.β).polymers.eval V + (pureWilson L st.β).R_trunc V)| ≤ δ_rem := by
    dsimp [pureWilson]
    rw [PolymerActivityFamily.eval_empty]
    have h_eq :
        (wilsonAction st.β V + st.polymers.eval V + st.R_trunc V) -
          (wilsonAction st.β V + 0 + 0) =
        st.polymers.eval V + st.R_trunc V := by ring
    rw [h_eq]
    exact h_rem V
  have h_pert :=
    gibbsMeasure_irCov_diff_le_of_action_diff
      st (pureWilson L st.β) hδ hβ0 hR_meas hR_bdd
      hβ0 measurable_const (fun _ => by simp : ∀ V : GaugeConfig L, |(0 : ℝ)| ≤ 0)
      h_diff_pw hf_meas hf_bdd hg_meas hg_bdd
  rw [gibbsMeasure_pureWilson_eq_wilsonMeasure] at h_pert
  have h_rev :
      |irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g| -
        |irCov st.gibbsMeasure f g| ≤
      |irCov st.gibbsMeasure f g -
        irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g| := by
    rw [abs_sub_comm]
    exact abs_sub_abs_le_abs_sub _ _
  linarith

/-- Local Single-Link Remainder Perturbation Theorem for `irCov` (Georgii Theorem 8.23 applied to
`st.gibbsMeasure` vs `wilsonMeasure (gaugeHaarMeasure L) st.β`):
for any `st : InteractingEffectiveActionState L` with `0 ≤ st.β ≤ canonicalCrossoverBetaHi` and
single-link remainder oscillation
`∀ V e g1 g2, |(st.polymers.eval (update V e g1) + st.R_trunc (update V e g1)) - (st.polymers.eval (update V e g2) + st.R_trunc (update V e g2))| ≤ δ_rem_link`,
and any `[-1, 1]`-valued measurable observables `f, g : GaugeConfig L → ℝ`,
`|irCov st.gibbsMeasure f g - irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g| ≤ 3 * ((∑ e, linkOscillation SU2 L f e) + (∑ e, linkOscillation SU2 L g e)) * (Real.exp (2 * δ_rem_link) - 1)`,
which depends **only** on the local single-link oscillation `δ_rem_link` and the observable link
oscillations—never on the global sum of `st.polymers.eval` across the torus. -/
theorem gibbsMeasure_irCov_diff_le_of_singleLink_osc {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) {ε_star δ_rem_link : ℝ}
    (hδ : 0 ≤ δ_rem_link)
    (hβ0 : 0 ≤ st.β) (hβ_hi : st.β ≤ (canonicalCrossoverBetaHi : ℝ))
    (hR_meas : Measurable st.R_trunc)
    (hR_bdd : ∀ V : GaugeConfig L, |st.R_trunc V| ≤ ε_star)
    (h_rem_osc : ∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |(st.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
          st.R_trunc (updateGaugeLink L V e.x e.μ g1)) -
        (st.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
          st.R_trunc (updateGaugeLink L V e.x e.μ g2))| ≤ δ_rem_link)
    {f g : GaugeConfig L → ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GaugeConfig L, |f V| ≤ 1)
    (hg_meas : Measurable g) (hg_bdd : ∀ V : GaugeConfig L, |g V| ≤ 1) :
    |irCov st.gibbsMeasure f g -
        irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g| ≤
      3 * ((∑ e : Link L, linkOscillation SU2 L f e) +
            (∑ e : Link L, linkOscillation SU2 L g e)) *
        (Real.exp (2 * δ_rem_link) - 1) := by
  let st₀ := pureWilson L st.β
  have hS₁_meas : Measurable st.totalAction := st.measurable_totalAction hR_meas
  have hS₁_bdd := st.abs_totalAction_le hβ0 hR_bdd
  have hR₀_meas : Measurable st₀.R_trunc := measurable_const
  have hR₀_bdd (V : GaugeConfig L) : |st₀.R_trunc V| ≤ 0 := by simp [st₀, pureWilson]
  have hS₂_meas : Measurable st₀.totalAction := st₀.measurable_totalAction hR₀_meas
  have hS₂_bdd := st₀.abs_totalAction_le hβ0 hR₀_bdd
  have h_poly₀ : PolymerDobrushinNormBound st₀.polymers 0 := by
    refine ⟨le_rfl, fun V e g1 g2 => ?_, fun _ _ => 0, fun _ _ => le_rfl,
      fun V e e' g1 g2 h1 h2 => ?_, fun e => by simp⟩
    · simp [st₀, pureWilson]
    · simp [st₀, pureWilson, twoLinkMixedDifference]
  have h_trunc₀ : TruncationDobrushinNormBound st₀.R_trunc 0 := by
    refine ⟨⟨0, hR₀_bdd⟩, hR₀_meas, fun _ _ => 0, fun _ _ => le_rfl,
      fun V e e' g1 g2 h1 h2 => ?_, fun e => by simp⟩
    simp [st₀, pureWilson, twoLinkMixedDifference]
  have h_beta_star : (0 : ℝ) ≤ (canonicalCrossoverBetaHi : ℝ) := by
    norm_num [canonicalCrossoverBetaHi]
  have h_land₀ : 4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) + 0 + 0) < 1 := by
    norm_num [canonicalCrossoverBetaHi]
  have h_row_sup :=
    (st₀.totalAction_dobrushinSupMatrix_rowSum_le
      hβ0 hβ_hi h_beta_star le_rfl le_rfl h_poly₀ h_trunc₀ h_land₀).1
  set q : ℝ := 4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) + 0 + 0)
  have hq_eq : q = 1 / 4 := by norm_num [q, canonicalCrossoverBetaHi]
  have hq0 : 0 ≤ q := by linarith
  have hq_lt : q < 1 := by linarith
  have h_act_osc (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2) :
      |(st.totalAction (updateGroupGaugeLink L V e.x e.μ g1) -
          st₀.totalAction (updateGroupGaugeLink L V e.x e.μ g1)) -
        (st.totalAction (updateGroupGaugeLink L V e.x e.μ g2) -
          st₀.totalAction (updateGroupGaugeLink L V e.x e.μ g2))| ≤ δ_rem_link := by
    have h_alg :
        (st.totalAction (updateGroupGaugeLink L V e.x e.μ g1) -
            st₀.totalAction (updateGroupGaugeLink L V e.x e.μ g1)) -
          (st.totalAction (updateGroupGaugeLink L V e.x e.μ g2) -
            st₀.totalAction (updateGroupGaugeLink L V e.x e.μ g2)) =
        (st.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st.R_trunc (updateGaugeLink L V e.x e.μ g1)) -
          (st.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st.R_trunc (updateGaugeLink L V e.x e.μ g2)) := by
      have h_ug1 : updateGroupGaugeLink L V e.x e.μ g1 = updateGaugeLink L V e.x e.μ g1 := rfl
      have h_ug2 : updateGroupGaugeLink L V e.x e.μ g2 = updateGaugeLink L V e.x e.μ g2 := rfl
      rw [h_ug1, h_ug2]
      dsimp [st₀, pureWilson, totalAction]
      rw [PolymerActivityFamily.eval_empty, PolymerActivityFamily.eval_empty]
      ring
    rw [h_alg]
    exact h_rem_osc V e g1 g2
  have h_exp_f :=
    groupGibbsMeasure_expectation_diff_le_of_singleLink_osc
      SU2 st.totalAction st₀.totalAction hq0 hq_lt hδ
      (fun e => (h_row_sup e).1) hS₁_meas hS₁_bdd hS₂_meas hS₂_bdd h_act_osc
      f hf_meas hf_bdd
  have h_exp_g :=
    groupGibbsMeasure_expectation_diff_le_of_singleLink_osc
      SU2 st.totalAction st₀.totalAction hq0 hq_lt hδ
      (fun e => (h_row_sup e).1) hS₁_meas hS₁_bdd hS₂_meas hS₂_bdd h_act_osc
      g hg_meas hg_bdd
  have hfg_bdd (V : GaugeConfig L) : |f V * g V| ≤ 1 := by
    rw [abs_mul]
    nlinarith [hf_bdd V, hg_bdd V, abs_nonneg (f V), abs_nonneg (g V)]
  have h_exp_fg :=
    groupGibbsMeasure_expectation_diff_le_of_singleLink_osc
      SU2 st.totalAction st₀.totalAction hq0 hq_lt hδ
      (fun e => (h_row_sup e).1) hS₁_meas hS₁_bdd hS₂_meas hS₂_bdd h_act_osc
      (fun V => f V * g V) (hf_meas.mul hg_meas) hfg_bdd
  rw [← st.gibbsMeasure_eq_groupGibbsMeasure,
    ← st₀.gibbsMeasure_eq_groupGibbsMeasure,
    gibbsMeasure_pureWilson_eq_wilsonMeasure] at h_exp_f h_exp_g h_exp_fg
  let μ₁ := st.gibbsMeasure
  let μ₂ := wilsonMeasure (gaugeHaarMeasure L) st.β
  have : IsProbabilityMeasure μ₁ := by
    dsimp [μ₁]
    rw [st.gibbsMeasure_eq_groupGibbsMeasure]
    exact groupGibbsMeasure_isProbabilityMeasure SU2 st.totalAction hS₁_meas hS₁_bdd
  have : IsProbabilityMeasure μ₂ := by
    dsimp [μ₂]
    rw [← gibbsMeasure_pureWilson_eq_wilsonMeasure, st₀.gibbsMeasure_eq_groupGibbsMeasure]
    exact groupGibbsMeasure_isProbabilityMeasure SU2 st₀.totalAction hS₂_meas hS₂_bdd
  have h_f_int_μ₁ : Integrable f μ₁ := by
    refine (integrable_const 1).mono' hf_meas.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun V => by rw [Real.norm_eq_abs]; exact hf_bdd V
  have h_g_int_μ₂ : Integrable g μ₂ := by
    refine (integrable_const 1).mono' hg_meas.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun V => by rw [Real.norm_eq_abs]; exact hg_bdd V
  have h_int_f₁ : |∫ V, f V ∂μ₁| ≤ 1 := by
    calc
      |∫ V, f V ∂μ₁| ≤ ∫ V, |f V| ∂μ₁ := abs_integral_le_integral_abs
      _ ≤ ∫ _ : GaugeConfig L, (1 : ℝ) ∂μ₁ :=
          integral_mono h_f_int_μ₁.abs (integrable_const 1) hf_bdd
      _ = 1 := by rw [integral_const, probReal_univ, one_smul]
  have h_int_g₂ : |∫ V, g V ∂μ₂| ≤ 1 := by
    calc
      |∫ V, g V ∂μ₂| ≤ ∫ V, |g V| ∂μ₂ := abs_integral_le_integral_abs
      _ ≤ ∫ _ : GaugeConfig L, (1 : ℝ) ∂μ₂ :=
          integral_mono h_g_int_μ₂.abs (integrable_const 1) hg_bdd
      _ = 1 := by rw [integral_const, probReal_univ, one_smul]
  have h_prod_diff :
      |(∫ V, f V ∂μ₁) * (∫ V, g V ∂μ₁) - (∫ V, f V ∂μ₂) * (∫ V, g V ∂μ₂)| ≤
        |(∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)| + |(∫ V, g V ∂μ₁) - (∫ V, g V ∂μ₂)| := by
    have h_split :
        (∫ V, f V ∂μ₁) * (∫ V, g V ∂μ₁) - (∫ V, f V ∂μ₂) * (∫ V, g V ∂μ₂) =
          (∫ V, f V ∂μ₁) * ((∫ V, g V ∂μ₁) - (∫ V, g V ∂μ₂)) +
            ((∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)) * (∫ V, g V ∂μ₂) := by ring
    rw [h_split]
    have h1 :
        |(∫ V, f V ∂μ₁) * ((∫ V, g V ∂μ₁) - (∫ V, g V ∂μ₂))| ≤
          |(∫ V, g V ∂μ₁) - (∫ V, g V ∂μ₂)| := by
      rw [abs_mul]
      calc
        |∫ V, f V ∂μ₁| * |(∫ V, g V ∂μ₁) - (∫ V, g V ∂μ₂)|
          ≤ 1 * |(∫ V, g V ∂μ₁) - (∫ V, g V ∂μ₂)| :=
            mul_le_mul_of_nonneg_right h_int_f₁ (abs_nonneg _)
        _ = |(∫ V, g V ∂μ₁) - (∫ V, g V ∂μ₂)| := one_mul _
    have h2 :
        |((∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)) * (∫ V, g V ∂μ₂)| ≤
          |(∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)| := by
      rw [abs_mul]
      calc
        |(∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)| * |∫ V, g V ∂μ₂|
          ≤ |(∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)| * 1 :=
            mul_le_mul_of_nonneg_left h_int_g₂ (abs_nonneg _)
        _ = |(∫ V, f V ∂μ₁) - (∫ V, f V ∂μ₂)| := mul_one _
    exact (abs_add_le _ _).trans (by linarith)
  have h_osc_fg :
      (∑ e : Link L, linkOscillation SU2 L (fun V => f V * g V) e) ≤
        (∑ e : Link L, linkOscillation SU2 L f e) +
          (∑ e : Link L, linkOscillation SU2 L g e) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum fun e _ =>
      linkOscillation_mul_le_add_of_abs_le_one SU2 f g hf_bdd hg_bdd e
  have h_exp_nonneg : 0 ≤ Real.exp (2 * δ_rem_link) - 1 := by
    have : (1 : ℝ) ≤ Real.exp (2 * δ_rem_link) := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by linarith)
    linarith
  have h_coeff : (Real.exp (2 * δ_rem_link) - 1) / (1 - q) =
      (4 / 3 : ℝ) * (Real.exp (2 * δ_rem_link) - 1) := by
    rw [hq_eq]
    ring
  rw [h_coeff] at h_exp_f h_exp_g h_exp_fg
  have h_sum_nonneg :
      0 ≤ (∑ e : Link L, linkOscillation SU2 L f e) +
        (∑ e : Link L, linkOscillation SU2 L g e) :=
    add_nonneg
      (Finset.sum_nonneg fun e _ => linkOscillation_nonneg SU2 L f e)
      (Finset.sum_nonneg fun e _ => linkOscillation_nonneg SU2 L g e)
  have h_fg_bound :
      |(∫ V, f V * g V ∂μ₁) - (∫ V, f V * g V ∂μ₂)| ≤
        (4 / 3 : ℝ) * (Real.exp (2 * δ_rem_link) - 1) *
          ((∑ e : Link L, linkOscillation SU2 L f e) +
            (∑ e : Link L, linkOscillation SU2 L g e)) :=
    h_exp_fg.trans (mul_le_mul_of_nonneg_left h_osc_fg (by linarith))
  have h_cov_tri :
      |irCov μ₁ f g - irCov μ₂ f g| ≤
        |(∫ V, f V * g V ∂μ₁) - (∫ V, f V * g V ∂μ₂)| +
          |(∫ V, f V ∂μ₁) * (∫ V, g V ∂μ₁) - (∫ V, f V ∂μ₂) * (∫ V, g V ∂μ₂)| := by
    unfold irCov
    have h_split :
        ((∫ V, f V * g V ∂μ₁) - (∫ V, f V ∂μ₁) * (∫ V, g V ∂μ₁)) -
          ((∫ V, f V * g V ∂μ₂) - (∫ V, f V ∂μ₂) * (∫ V, g V ∂μ₂)) =
        ((∫ V, f V * g V ∂μ₁) - (∫ V, f V * g V ∂μ₂)) -
          ((∫ V, f V ∂μ₁) * (∫ V, g V ∂μ₁) - (∫ V, f V ∂μ₂) * (∫ V, g V ∂μ₂)) := by ring
    rw [h_split]
    exact abs_sub _ _
  have h_exp_f' :
      |(∫ V : GaugeConfig L, f V ∂μ₁) - (∫ V : GaugeConfig L, f V ∂μ₂)| ≤
        (4 / 3 : ℝ) * (Real.exp (2 * δ_rem_link) - 1) *
          (∑ e : Link L, linkOscillation SU2 L f e) := h_exp_f
  have h_exp_g' :
      |(∫ V : GaugeConfig L, g V ∂μ₁) - (∫ V : GaugeConfig L, g V ∂μ₂)| ≤
        (4 / 3 : ℝ) * (Real.exp (2 * δ_rem_link) - 1) *
          (∑ e : Link L, linkOscillation SU2 L g e) := h_exp_g
  have h_83_le_3 :
      (8 / 3 : ℝ) *
          ((∑ e : Link L, linkOscillation SU2 L f e) +
            (∑ e : Link L, linkOscillation SU2 L g e)) *
          (Real.exp (2 * δ_rem_link) - 1) ≤
        3 *
          ((∑ e : Link L, linkOscillation SU2 L f e) +
            (∑ e : Link L, linkOscillation SU2 L g e)) *
          (Real.exp (2 * δ_rem_link) - 1) := by
    have h_prod_nonneg :
        0 ≤ ((∑ e : Link L, linkOscillation SU2 L f e) +
              (∑ e : Link L, linkOscillation SU2 L g e)) *
            (Real.exp (2 * δ_rem_link) - 1) :=
      mul_nonneg h_sum_nonneg h_exp_nonneg
    linarith
  change |irCov μ₁ f g - irCov μ₂ f g| ≤
    3 * ((∑ e : Link L, linkOscillation SU2 L f e) +
          (∑ e : Link L, linkOscillation SU2 L g e)) *
      (Real.exp (2 * δ_rem_link) - 1)
  linarith [h_cov_tri, h_fg_bound, h_prod_diff, h_exp_f', h_exp_g', h_83_le_3]

/-- Gap 3 Theorem (Local Single-Link Remainder Perturbation via Georgii Theorem 8.23):
for any interacting effective action state `st : InteractingEffectiveActionState L` with
`0 ≤ st.β ≤ canonicalCrossoverBetaHi` whose polymer + truncation remainder has **local single-link
oscillation** bounded by `δ_rem_link`
(`∀ V e g1 g2, |(st.polymers.eval (update V e g1) + st.R_trunc (update V e g1)) - (st.polymers.eval (update V e g2) + st.R_trunc (update V e g2))| ≤ δ_rem_link`),
and any `[-1, 1]`-valued measurable observables `f, g : GaugeConfig L → ℝ` with total link
oscillation `(∑ e, linkOscillation SU2 L f e) + (∑ e, linkOscillation SU2 L g e) ≤ M_osc`, if the
pure Wilson measure `wilsonMeasure (gaugeHaarMeasure L) st.β` has leading degree-4 $O(\beta^4)$
Haar character probe covariance lower bound
`c_char * st.β ^ 4 ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g|`
dominating the local Georgii perturbation `3 * M_osc * (Real.exp (2 * δ_rem_link) - 1)` via
`c_vac + 3 * M_osc * (Real.exp (2 * δ_rem_link) - 1) ≤ c_char * st.β ^ 4`, then
`c_vac ≤ |irCov st.gibbsMeasure f g|`. -/
theorem irCov_lower_bound_of_wilson_character_floor_local {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) {ε_star δ_rem_link M_osc c_char c_vac : ℝ}
    (hδ : 0 ≤ δ_rem_link)
    (hβ0 : 0 ≤ st.β) (hβ_hi : st.β ≤ (canonicalCrossoverBetaHi : ℝ))
    (hR_meas : Measurable st.R_trunc)
    (hR_bdd : ∀ V : GaugeConfig L, |st.R_trunc V| ≤ ε_star)
    (h_rem_osc : ∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |(st.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
          st.R_trunc (updateGaugeLink L V e.x e.μ g1)) -
        (st.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
          st.R_trunc (updateGaugeLink L V e.x e.μ g2))| ≤ δ_rem_link)
    {f g : GaugeConfig L → ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GaugeConfig L, |f V| ≤ 1)
    (hg_meas : Measurable g) (hg_bdd : ∀ V : GaugeConfig L, |g V| ≤ 1)
    (h_osc_sum :
      (∑ e : Link L, linkOscillation SU2 L f e) +
        (∑ e : Link L, linkOscillation SU2 L g e) ≤ M_osc)
    (h_char_floor :
      c_char * st.β ^ 4 ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g|)
    (h_dom : c_vac + 3 * M_osc * (Real.exp (2 * δ_rem_link) - 1) ≤ c_char * st.β ^ 4) :
    c_vac ≤ |irCov st.gibbsMeasure f g| := by
  have h_pert :=
    st.gibbsMeasure_irCov_diff_le_of_singleLink_osc
      hδ hβ0 hβ_hi hR_meas hR_bdd h_rem_osc hf_meas hf_bdd hg_meas hg_bdd
  have h_exp_nonneg : 0 ≤ Real.exp (2 * δ_rem_link) - 1 := by
    have : (1 : ℝ) ≤ Real.exp (2 * δ_rem_link) := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by linarith)
    linarith
  have h_pert_M :
      |irCov st.gibbsMeasure f g -
          irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g| ≤
        3 * M_osc * (Real.exp (2 * δ_rem_link) - 1) := by
    nlinarith
  have h_rev :
      |irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g| -
        |irCov st.gibbsMeasure f g| ≤
      |irCov st.gibbsMeasure f g -
        irCov (wilsonMeasure (gaugeHaarMeasure L) st.β) f g| := by
    rw [abs_sub_comm]
    exact abs_sub_abs_le_abs_sub _ _
  linarith

end InteractingEffectiveActionState

/-! ### Gap 4: Fine-to-Coarse Observable Transfer & Two-Cutoff Contraction -/

/-- Telescoping bound across the `K` blocking steps of a multi-scale RG chain: if `obs_step : ℕ → ℝ`
tracks the dressed Wilson loop expectation from scale `m = K` (`obs_step K = renormalizedSchwinger Z n F`)
down to scale `m = 0` (`obs_step 0 = landedIrSchwinger T Z n F`) with per-step smearing /
axial-gauge block-averaging defect `|obs_step (k + 1) - obs_step k| ≤ δ_step k`, then
`dist (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F) ≤ ∑ k ∈ Finset.range (T.K n), δ_step k`. -/
theorem dist_renormalizedSchwinger_landedIrSchwinger_le_of_telescoped_steps
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) (F : DisjointLoopFamily)
    (obs_step : ℕ → ℝ) (δ_step : ℕ → ℝ)
    (h_uv : obs_step (T.K n) = renormalizedSchwinger Z n F)
    (h_ir : obs_step 0 = landedIrSchwinger T Z n F)
    (h_step : ∀ k < T.K n, |obs_step (k + 1) - obs_step k| ≤ δ_step k) :
    dist (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F) ≤
      ∑ k ∈ Finset.range (T.K n), δ_step k := by
  rw [Real.dist_eq, ← h_uv, ← h_ir]
  have h_tele :
      ∀ m ≤ T.K n,
        |obs_step m - obs_step 0| ≤ ∑ k ∈ Finset.range m, δ_step k := by
    intro m
    induction m with
    | zero =>
        intro _
        simp
    | succ k ih =>
        intro hk
        rw [Finset.sum_range_succ]
        have h_split :
            obs_step (k + 1) - obs_step 0 =
              (obs_step k - obs_step 0) + (obs_step (k + 1) - obs_step k) := by ring
        rw [h_split]
        exact (abs_add_le _ _).trans (add_le_add (ih (Nat.le_of_lt hk)) (h_step k hk))
  exact h_tele (T.K n) le_rfl

/-- Pointwise upper bound on the product of renormalized physical Wilson loops:
`|(loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod| ≤ (loops.map (fun ℓ => |z ℓ|)).prod`. -/
theorem abs_list_prod_mul_physicalWilsonLoop_le_prod_abs
    (L : ℕ) (a : ℝ) (z : PhysicalRectangle → ℝ) (V : GaugeConfig L) :
    ∀ loops : List PhysicalRectangle,
      |(loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod| ≤
        (loops.map (fun ℓ => |z ℓ|)).prod
  | [] => by simp
  | ℓ :: ls => by
      simp only [List.map_cons, List.prod_cons, abs_mul]
      have hW := abs_physicalWilsonLoop_le_one L a ℓ V
      have h1 : |z ℓ| * |physicalWilsonLoop L a ℓ V| ≤ |z ℓ| := by
        nlinarith [abs_nonneg (z ℓ)]
      have h2 := abs_list_prod_mul_physicalWilsonLoop_le_prod_abs L a z V ls
      exact mul_le_mul h1 h2 (abs_nonneg _) (abs_nonneg (z ℓ))

/-- Converting action proximity into renormalized multi-loop expectation proximity on a shared IR
torus `L`: when two landed states `st1, st2 : InteractingEffectiveActionState L` have non-vacuum
action difference bounded by `δ ≥ 0`, their renormalized multi-loop expectations differ by at most
`(Real.exp (2 * δ) - 1) * (F.loops.map (fun ℓ => |z ℓ|)).prod`. -/
theorem renormalizedLoopExpectation_diff_le_of_action_diff {L : ℕ} [NeZero L]
    (st1 st2 : InteractingEffectiveActionState L) {ε₁ ε₂ δ : ℝ} (hδ : 0 ≤ δ)
    (hβ1 : 0 ≤ st1.β) (hR1_meas : Measurable st1.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L, |st1.R_trunc V| ≤ ε₁)
    (hβ2 : 0 ≤ st2.β) (hR2_meas : Measurable st2.R_trunc)
    (hR2_bdd : ∀ V : GaugeConfig L, |st2.R_trunc V| ≤ ε₂)
    (h_diff : ∀ V : GaugeConfig L,
      |(wilsonAction st1.β V + st1.polymers.eval V + st1.R_trunc V) -
        (wilsonAction st2.β V + st2.polymers.eval V + st2.R_trunc V)| ≤ δ)
    (a : ℝ) (z : PhysicalRectangle → ℝ) (F : DisjointLoopFamily) :
    |(∫ V, (F.loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod ∂st1.gibbsMeasure) -
      (∫ V, (F.loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod ∂st2.gibbsMeasure)| ≤
      (Real.exp (2 * δ) - 1) * (F.loops.map (fun ℓ => |z ℓ|)).prod := by
  have h_cont :
      Continuous (fun V : GaugeConfig L =>
        (F.loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod) :=
    (continuous_and_bdd_list_prod_physicalWilsonLoop L a z F.loops).1
  exact st1.gibbsMeasure_expectation_diff_le_of_action_diff
    st2 hδ hβ1 hR1_meas hR1_bdd hβ2 hR2_meas hR2_bdd h_diff
    h_cont.measurable (fun V => abs_list_prod_mul_physicalWilsonLoop_le_prod_abs L a z V F.loops)

theorem continuous_irDressedLoopFamilyObservable {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) (L n : ℕ) (a : ℝ)
    (F : DisjointLoopFamily) :
    Continuous (irDressedLoopFamilyObservable Z L n a F) := by
  have h_eq :
      irDressedLoopFamilyObservable Z L n a F =
        fun V => (F.loops.map (fun ℓ => Z.factor n ℓ)).prod * irLoopFamilyObservable L a F V :=
    funext (irDressedLoopFamilyObservable_eq_prod_mul Z L n a F)
  rw [h_eq]
  exact continuous_const.mul (continuous_irLoopFamilyObservable L a F)

theorem abs_irDressedLoopFamilyObservable_le_one {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) (L n : ℕ) (a : ℝ)
    (F : DisjointLoopFamily)
    (hZ : ∀ ℓ : PhysicalRectangle, |Z.factor n ℓ| ≤ 1)
    (V : GaugeConfig L) :
    |irDressedLoopFamilyObservable Z L n a F V| ≤ 1 := by
  rw [irDressedLoopFamilyObservable_eq_prod_mul, abs_mul]
  have h1 : |(F.loops.map (fun ℓ => Z.factor n ℓ)).prod| ≤ 1 :=
    abs_list_prod_le_one_of_abs_le_one (fun ℓ => Z.factor n ℓ) F.loops (fun ℓ _ => hZ ℓ)
  have h2 : |irLoopFamilyObservable L a F V| ≤ 1 :=
    abs_irLoopFamilyObservable_le_one L a F V
  nlinarith [abs_nonneg ((F.loops.map (fun ℓ => Z.factor n ℓ)).prod),
    abs_nonneg (irLoopFamilyObservable L a F V)]

theorem linkOscillation_irDressedLoopFamilyObservable_eq_zero_of_not_mem
    {P : ContinuumCutoffPath} (Z : LoopRenormalization P.toCutoffPath)
    (L n : ℕ) (a : ℝ) (F : DisjointLoopFamily) {e : Link L}
    (h_not_mem : e ∉ physicalLoopListSupport L a F.loops) :
    linkOscillation SU2 L (irDressedLoopFamilyObservable Z L n a F) e = 0 := by
  refine linkOscillation_eq_zero_of_independent SU2
    (irDressedLoopFamilyObservable Z L n a F) e ?_
  intro V g1 g2
  rw [irDressedLoopFamilyObservable_eq_prod_mul Z L n a F (updateGroupGaugeLink L V e.x e.μ g1),
    irDressedLoopFamilyObservable_eq_prod_mul Z L n a F (updateGroupGaugeLink L V e.x e.μ g2)]
  unfold irLoopFamilyObservable
  rw [list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a V g1 F.loops h_not_mem,
    list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a V g2 F.loops h_not_mem]

theorem linkOscillation_irDressedLoopFamilyObservable_le_two
    {P : ContinuumCutoffPath} (Z : LoopRenormalization P.toCutoffPath)
    (L n : ℕ) (a : ℝ) (F : DisjointLoopFamily)
    (hZ : ∀ ℓ : PhysicalRectangle, |Z.factor n ℓ| ≤ 1)
    (e : Link L) :
    linkOscillation SU2 L (irDressedLoopFamilyObservable Z L n a F) e ≤ 2 := by
  refine linkOscillation_le_of_forall_le SU2
    (irDressedLoopFamilyObservable Z L n a F) e ?_
  intro V g1 g2
  have h1 := abs_irDressedLoopFamilyObservable_le_one Z L n a F hZ
    (updateGroupGaugeLink L V e.x e.μ g1)
  have h2 := abs_irDressedLoopFamilyObservable_le_one Z L n a F hZ
    (updateGroupGaugeLink L V e.x e.μ g2)
  have h_tri := abs_sub
    (irDressedLoopFamilyObservable Z L n a F (updateGroupGaugeLink L V e.x e.μ g1))
    (irDressedLoopFamilyObservable Z L n a F (updateGroupGaugeLink L V e.x e.μ g2))
  linarith

/-- For any renormalization scheme `Z : LoopRenormalization P.toCutoffPath` with
`∀ ℓ, |Z.factor n ℓ| ≤ 1` and any multi-loop family `F : DisjointLoopFamily`, the torus-wide
total link oscillation of `irDressedLoopFamilyObservable Z L n a F` is bounded by
`2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ)`, completely independent
of the torus side `L`. -/
theorem sum_linkOscillation_irDressedLoopFamilyObservable_le
    {P : ContinuumCutoffPath} (Z : LoopRenormalization P.toCutoffPath)
    (L : ℕ) [NeZero L] (n : ℕ) (a : ℝ) (F : DisjointLoopFamily)
    (hZ : ∀ ℓ : PhysicalRectangle, |Z.factor n ℓ| ≤ 1) :
    (∑ e : Link L, linkOscillation SU2 L (irDressedLoopFamilyObservable Z L n a F) e) ≤
      2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ) := by
  have h_supp :
      (∑ e : Link L, linkOscillation SU2 L (irDressedLoopFamilyObservable Z L n a F) e) =
        ∑ e ∈ physicalLoopListSupport L a F.loops,
          linkOscillation SU2 L (irDressedLoopFamilyObservable Z L n a F) e := by
    rw [← Finset.sum_subset (Finset.subset_univ (physicalLoopListSupport L a F.loops))]
    intro e _ he
    exact linkOscillation_irDressedLoopFamilyObservable_eq_zero_of_not_mem Z L n a F he
  have h_card :
      ((physicalLoopListSupport L a F.loops).card : ℝ) ≤
        (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ) :=
    Nat.cast_le.mpr (card_physicalLoopListSupport_le_sum_length L a F.loops)
  rw [h_supp]
  calc
    (∑ e ∈ physicalLoopListSupport L a F.loops,
      linkOscillation SU2 L (irDressedLoopFamilyObservable Z L n a F) e)
      ≤ ∑ _e ∈ physicalLoopListSupport L a F.loops, (2 : ℝ) :=
        Finset.sum_le_sum fun e _ =>
          linkOscillation_irDressedLoopFamilyObservable_le_two Z L n a F hZ e
    _ = 2 * ((physicalLoopListSupport L a F.loops).card : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul]
        ring
    _ ≤ 2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ) :=
        mul_le_mul_of_nonneg_left h_card (by norm_num)

/-- Volume-independent two-state renormalized multi-loop expectation comparison via Georgii
Theorem 8.23 (`groupGibbsMeasure_expectation_diff_le_of_singleLink_osc`):
if `st₂ : InteractingEffectiveActionState L` lies in the canonical Dobrushin uniqueness tube
(`0 ≤ st₂.β ≤ canonicalCrossoverBetaHi`, `PolymerDobrushinNormBound st₂.polymers canonicalCrossoverEtaHi`,
`TruncationDobrushinNormBound st₂.R_trunc canonicalCrossoverEpsHi`, so its Dobrushin row sum is
`≤ 3 / 4 < 1`) and the non-vacuum action difference between `st₁` and `st₂` has **single-link
oscillation** bounded by `Δ_link ≥ 0`, then for every `Z` with `∀ ℓ, |Z.factor n ℓ| ≤ 1` and
every `F : DisjointLoopFamily`,
`|(∫ V, irDressedLoopFamilyObservable Z L n a F V ∂st₁.gibbsMeasure) - (∫ V, irDressedLoopFamilyObservable Z L n a F V ∂st₂.gibbsMeasure)| ≤ 4 * (Real.exp (2 * Δ_link) - 1) * (2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ))`,
with **zero dependence on the torus volume `L^4`**. -/
theorem InteractingEffectiveActionState.renormalizedLoopExpectation_diff_le_of_singleLink_osc
    {L : ℕ} [NeZero L]
    (st₁ st₂ : InteractingEffectiveActionState L) {B₁ Δ_link : ℝ}
    (hΔ : 0 ≤ Δ_link)
    (hβ1 : 0 ≤ st₁.β) (hR1_meas : Measurable st₁.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L, |st₁.R_trunc V| ≤ B₁)
    (hβ2_0 : 0 ≤ st₂.β) (hβ2_hi : st₂.β ≤ (canonicalCrossoverBetaHi : ℝ))
    (h_poly2 : PolymerDobrushinNormBound st₂.polymers (canonicalCrossoverEtaHi : ℝ))
    (h_trunc2 : TruncationDobrushinNormBound st₂.R_trunc (canonicalCrossoverEpsHi : ℝ))
    (h_act_osc : ∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g1) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g1)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g1) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g1))) -
        ((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g2) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g2)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g2) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g2)))| ≤ Δ_link)
    {P : ContinuumCutoffPath} (Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) (a : ℝ)
    (hZ : ∀ ℓ : PhysicalRectangle, |Z.factor n ℓ| ≤ 1)
    (F : DisjointLoopFamily) :
    |(∫ V, irDressedLoopFamilyObservable Z L n a F V ∂st₁.gibbsMeasure) -
      (∫ V, irDressedLoopFamilyObservable Z L n a F V ∂st₂.gibbsMeasure)| ≤
      4 * (Real.exp (2 * Δ_link) - 1) *
        (2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ)) := by
  have hS₁_meas : Measurable st₁.totalAction := st₁.measurable_totalAction hR1_meas
  have hS₁_bdd := st₁.abs_totalAction_le hβ1 hR1_bdd
  have ⟨⟨B₂, hR2_bdd⟩, hR2_meas, _⟩ := h_trunc2
  have hS₂_meas : Measurable st₂.totalAction := st₂.measurable_totalAction hR2_meas
  have hS₂_bdd := st₂.abs_totalAction_le hβ2_0 hR2_bdd
  have h_beta_star : (0 : ℝ) ≤ (canonicalCrossoverBetaHi : ℝ) := by
    norm_num [canonicalCrossoverBetaHi]
  have h_eta_star : (0 : ℝ) ≤ (canonicalCrossoverEtaHi : ℝ) := by
    norm_num [canonicalCrossoverEtaHi]
  have h_eps_star : (0 : ℝ) ≤ (canonicalCrossoverEpsHi : ℝ) := by
    norm_num [canonicalCrossoverEpsHi]
  have h_land₂ :
      4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) +
        (canonicalCrossoverEtaHi : ℝ) + (canonicalCrossoverEpsHi : ℝ)) < 1 := by
    norm_num [canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]
  have h_row_sup :=
    (st₂.totalAction_dobrushinSupMatrix_rowSum_le
      hβ2_0 hβ2_hi h_beta_star h_eta_star h_eps_star h_poly2 h_trunc2 h_land₂).1
  set q : ℝ :=
    4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) +
      (canonicalCrossoverEtaHi : ℝ) + (canonicalCrossoverEpsHi : ℝ))
  have hq_eq : q = 3 / 4 := by
    norm_num [q, canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]
  have hq0 : 0 ≤ q := by linarith
  have hq_lt : q < 1 := by linarith
  have h_total_osc (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2) :
      |(st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g1) -
          st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g1)) -
        (st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g2) -
          st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g2))| ≤ Δ_link := by
    have h_alg :
        (st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g1) -
            st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g1)) -
          (st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g2) -
            st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g2)) =
        ((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g1) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g1)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g1) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g1))) -
        ((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g2) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g2)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g2) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g2))) := by
      have h_ug1 : updateGroupGaugeLink L V e.x e.μ g1 = updateGaugeLink L V e.x e.μ g1 := rfl
      have h_ug2 : updateGroupGaugeLink L V e.x e.μ g2 = updateGaugeLink L V e.x e.μ g2 := rfl
      rw [h_ug1, h_ug2]
      dsimp [InteractingEffectiveActionState.totalAction]
      ring
    rw [h_alg]
    exact h_act_osc V e g1 g2
  have h_exp :=
    groupGibbsMeasure_expectation_diff_le_of_singleLink_osc
      SU2 st₁.totalAction st₂.totalAction hq0 hq_lt hΔ
      (fun e => (h_row_sup e).1) hS₁_meas hS₁_bdd hS₂_meas hS₂_bdd h_total_osc
      (irDressedLoopFamilyObservable Z L n a F)
      (continuous_irDressedLoopFamilyObservable Z L n a F).measurable
      (abs_irDressedLoopFamilyObservable_le_one Z L n a F hZ)
  rw [← st₁.gibbsMeasure_eq_groupGibbsMeasure,
    ← st₂.gibbsMeasure_eq_groupGibbsMeasure] at h_exp
  have h_coeff : (Real.exp (2 * Δ_link) - 1) / (1 - q) =
      4 * (Real.exp (2 * Δ_link) - 1) := by
    rw [hq_eq]
    ring
  rw [h_coeff] at h_exp
  have h_exp_nonneg : 0 ≤ 4 * (Real.exp (2 * Δ_link) - 1) := by
    have : (1 : ℝ) ≤ Real.exp (2 * Δ_link) := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by linarith)
    linarith
  have h_osc := sum_linkOscillation_irDressedLoopFamilyObservable_le Z L n a F hZ
  exact h_exp.trans (mul_le_mul_of_nonneg_left h_osc h_exp_nonneg)

/-- Volume-independent two-state IR multi-loop expectation comparison for `irLoopFamilyObservable`
via Georgii Theorem 8.23 (`groupGibbsMeasure_expectation_diff_le_of_singleLink_osc`), requiring no
renormalization factor bound. -/
theorem InteractingEffectiveActionState.irLoopFamilyObservable_expectation_diff_le_of_singleLink_osc
    {L : ℕ} [NeZero L]
    (st₁ st₂ : InteractingEffectiveActionState L) {B₁ Δ_link : ℝ}
    (hΔ : 0 ≤ Δ_link)
    (hβ1 : 0 ≤ st₁.β) (hR1_meas : Measurable st₁.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L, |st₁.R_trunc V| ≤ B₁)
    (hβ2_0 : 0 ≤ st₂.β) (hβ2_hi : st₂.β ≤ (canonicalCrossoverBetaHi : ℝ))
    (h_poly2 : PolymerDobrushinNormBound st₂.polymers (canonicalCrossoverEtaHi : ℝ))
    (h_trunc2 : TruncationDobrushinNormBound st₂.R_trunc (canonicalCrossoverEpsHi : ℝ))
    (h_act_osc : ∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g1) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g1)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g1) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g1))) -
        ((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g2) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g2)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g2) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g2)))| ≤ Δ_link)
    (a : ℝ) (F : DisjointLoopFamily) :
    |(∫ V, irLoopFamilyObservable L a F V ∂st₁.gibbsMeasure) -
      (∫ V, irLoopFamilyObservable L a F V ∂st₂.gibbsMeasure)| ≤
      4 * (Real.exp (2 * Δ_link) - 1) *
        (2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ)) := by
  have hS₁_meas : Measurable st₁.totalAction := st₁.measurable_totalAction hR1_meas
  have hS₁_bdd := st₁.abs_totalAction_le hβ1 hR1_bdd
  have ⟨⟨B₂, hR2_bdd⟩, hR2_meas, _⟩ := h_trunc2
  have hS₂_meas : Measurable st₂.totalAction := st₂.measurable_totalAction hR2_meas
  have hS₂_bdd := st₂.abs_totalAction_le hβ2_0 hR2_bdd
  have h_beta_star : (0 : ℝ) ≤ (canonicalCrossoverBetaHi : ℝ) := by
    norm_num [canonicalCrossoverBetaHi]
  have h_eta_star : (0 : ℝ) ≤ (canonicalCrossoverEtaHi : ℝ) := by
    norm_num [canonicalCrossoverEtaHi]
  have h_eps_star : (0 : ℝ) ≤ (canonicalCrossoverEpsHi : ℝ) := by
    norm_num [canonicalCrossoverEpsHi]
  have h_land₂ :
      4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) +
        (canonicalCrossoverEtaHi : ℝ) + (canonicalCrossoverEpsHi : ℝ)) < 1 := by
    norm_num [canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]
  have h_row_sup :=
    (st₂.totalAction_dobrushinSupMatrix_rowSum_le
      hβ2_0 hβ2_hi h_beta_star h_eta_star h_eps_star h_poly2 h_trunc2 h_land₂).1
  set q : ℝ :=
    4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) +
      (canonicalCrossoverEtaHi : ℝ) + (canonicalCrossoverEpsHi : ℝ))
  have hq_eq : q = 3 / 4 := by
    norm_num [q, canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]
  have hq0 : 0 ≤ q := by linarith
  have hq_lt : q < 1 := by linarith
  have h_total_osc (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2) :
      |(st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g1) -
          st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g1)) -
        (st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g2) -
          st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g2))| ≤ Δ_link := by
    have h_alg :
        (st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g1) -
            st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g1)) -
          (st₁.totalAction (updateGroupGaugeLink L V e.x e.μ g2) -
            st₂.totalAction (updateGroupGaugeLink L V e.x e.μ g2)) =
        ((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g1) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g1)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g1) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g1) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g1))) -
        ((wilsonAction st₁.β (updateGaugeLink L V e.x e.μ g2) +
            st₁.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₁.R_trunc (updateGaugeLink L V e.x e.μ g2)) -
          (wilsonAction st₂.β (updateGaugeLink L V e.x e.μ g2) +
            st₂.polymers.eval (updateGaugeLink L V e.x e.μ g2) +
            st₂.R_trunc (updateGaugeLink L V e.x e.μ g2))) := by
      have h_ug1 : updateGroupGaugeLink L V e.x e.μ g1 = updateGaugeLink L V e.x e.μ g1 := rfl
      have h_ug2 : updateGroupGaugeLink L V e.x e.μ g2 = updateGaugeLink L V e.x e.μ g2 := rfl
      rw [h_ug1, h_ug2]
      dsimp [InteractingEffectiveActionState.totalAction]
      ring
    rw [h_alg]
    exact h_act_osc V e g1 g2
  have h_exp :=
    groupGibbsMeasure_expectation_diff_le_of_singleLink_osc
      SU2 st₁.totalAction st₂.totalAction hq0 hq_lt hΔ
      (fun e => (h_row_sup e).1) hS₁_meas hS₁_bdd hS₂_meas hS₂_bdd h_total_osc
      (irLoopFamilyObservable L a F)
      (continuous_irLoopFamilyObservable L a F).measurable
      (abs_irLoopFamilyObservable_le_one L a F)
  rw [← st₁.gibbsMeasure_eq_groupGibbsMeasure,
    ← st₂.gibbsMeasure_eq_groupGibbsMeasure] at h_exp
  have h_coeff : (Real.exp (2 * Δ_link) - 1) / (1 - q) =
      4 * (Real.exp (2 * Δ_link) - 1) := by
    rw [hq_eq]
    ring
  rw [h_coeff] at h_exp
  have h_exp_nonneg : 0 ≤ 4 * (Real.exp (2 * Δ_link) - 1) := by
    have : (1 : ℝ) ≤ Real.exp (2 * Δ_link) := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by linarith)
    linarith
  have h_supp :
      (∑ e : Link L, linkOscillation SU2 L (irLoopFamilyObservable L a F) e) =
        ∑ e ∈ physicalLoopListSupport L a F.loops,
          linkOscillation SU2 L (irLoopFamilyObservable L a F) e := by
    rw [← Finset.sum_subset (Finset.subset_univ (physicalLoopListSupport L a F.loops))]
    intro e _ he
    exact linkOscillation_irLoopFamilyObservable_eq_zero_of_not_mem a F he
  have h_osc :
      (∑ e : Link L, linkOscillation SU2 L (irLoopFamilyObservable L a F) e) ≤
        2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ) := by
    rw [h_supp]
    exact sum_linkOscillation_irLoopFamilyObservable_le L a F
  exact h_exp.trans (mul_le_mul_of_nonneg_left h_osc h_exp_nonneg)

/-- Gap 4 Theorem (`TwoCutoffComparison` from RG stable-manifold contraction and telescoped
fine-to-coarse observable dressing): constructs `TwoCutoffComparison T Z` from:
1. `hZ_eq : Z = T.Z_tube`,
2. One-extra-UV-step RG stable-manifold coupling contraction
   `|((T.chain n).state 0).β - ((T.chain (n + 1)).state 0).β| ≤ C_act * (landingTubeContraction T) ^ n`,
3. Two-cutoff landed IR expectation contraction
   `dist (landedIrSchwinger T Z n F) (landedIrSchwinger T Z (n + 1) F) ≤ C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n`, and
4. Telescoped `K_n`-step fine-to-coarse observable dressing bound
   `∑ k ∈ Finset.range (T.K n), δ_step n F k ≤ C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n`. -/
theorem twoCutoffComparison_of_stableManifold_and_dressing
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (hZ_eq : Z = T.Z_tube)
    {C_act C_tube : ℝ} (hC_act : 0 ≤ C_act) (hC_tube : 0 ≤ C_tube)
    (h_beta_contraction : ∀ n : ℕ,
      |((T.chain n).state 0).β - ((T.chain (n + 1)).state 0).β| ≤
        C_act * (landingTubeContraction T) ^ n)
    (h_landed_contraction : ∀ (F : DisjointLoopFamily) (n : ℕ),
      dist (landedIrSchwinger T Z n F) (landedIrSchwinger T Z (n + 1) F) ≤
        C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n)
    (obs_step : ℕ → DisjointLoopFamily → ℕ → ℝ)
    (δ_step : ℕ → DisjointLoopFamily → ℕ → ℝ)
    (h_uv : ∀ n F, obs_step n F (T.K n) = renormalizedSchwinger Z n F)
    (h_ir : ∀ n F, obs_step n F 0 = landedIrSchwinger T Z n F)
    (h_step : ∀ n F k, k < T.K n → |obs_step n F (k + 1) - obs_step n F k| ≤ δ_step n F k)
    (h_sum_le : ∀ F n,
      (∑ k ∈ Finset.range (T.K n), δ_step n F k) ≤
        C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n) :
    TwoCutoffComparison T Z where
  hZ_eq := hZ_eq
  h_effective_action_comparison := ⟨C_act, hC_act, h_beta_contraction⟩
  h_landed_and_dressing := ⟨C_tube, hC_tube, fun F =>
    ⟨h_landed_contraction F, fun n =>
      (dist_renormalizedSchwinger_landedIrSchwinger_le_of_telescoped_steps
        T Z n F (obs_step n F) (δ_step n F) (h_uv n F) (h_ir n F) (h_step n F)).trans
        (h_sum_le F n)⟩⟩

/-! ### Gap 5: Continuum `SO(4)` Rotational Symmetry Restoration via Dimension-6 $O(a_n^2)$ Symanzik Suppression -/

/-- General $O((P.\mathrm{spacing}\;n)^2)$ dimension-6 lattice artifact vanishing lemma: if a
sequence `d : ℕ → ℝ` satisfies `|d n| ≤ C * (P.spacing n) ^ 2` eventually along
`P : ContinuumCutoffPath`, then `Tendsto d atTop (𝓝 0)`. -/
theorem tendsto_zero_of_abs_le_const_mul_spacing_sq
    (P : ContinuumCutoffPath) {d : ℕ → ℝ} {C : ℝ}
    (h_bound : ∀ᶠ n in atTop, |d n| ≤ C * (P.spacing n) ^ 2) :
    Tendsto d atTop (𝓝 0) := by
  have h_sp_sq : Tendsto (fun n => C * (P.spacing n) ^ 2) atTop (𝓝 0) := by
    have h0 : Tendsto (fun n => (P.spacing n) ^ 2) atTop (𝓝 (0 ^ 2)) :=
      P.spacing_tendsto_zero.pow 2
    have h_mul : Tendsto (fun n => C * (P.spacing n) ^ 2) atTop (𝓝 (C * (0 ^ 2))) :=
      tendsto_const_nhds.mul h0
    simpa using h_mul
  refine squeeze_zero_norm' ?_ h_sp_sq
  filter_upwards [h_bound] with n hn
  simpa [Real.norm_eq_abs] using hn

/-- Evaluation of a concatenated loop family `⟨F.loops ++ G.loops⟩` factors as the product of evaluations. -/
theorem DisjointLoopFamily.eval_append {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (F G : DisjointLoopFamily) (U : GaugeConfig (P.side n)) :
    (DisjointLoopFamily.mk (F.loops ++ G.loops)).eval Z n U =
      F.eval Z n U * G.eval Z n U := by
  simp [DisjointLoopFamily.eval, List.map_append, List.prod_append]

/-- Every `DisjointLoopFamily.eval Z n G` is integrable with respect to the cutoff Wilson probability
measure `P.configLaw n`. -/
theorem DisjointLoopFamily.integrable_eval {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (G : DisjointLoopFamily) :
    Integrable (fun U : GaugeConfig (P.side n) => G.eval Z n U)
      (P.configLaw n : Measure (GaugeConfig (P.side n))) := by
  refine Integrable.of_bound (DisjointLoopFamily.continuous_eval Z n G).aestronglyMeasurable
    ((G.loops.map (fun ℓ => |Z.factor n ℓ|)).prod) (Eventually.of_forall fun U => ?_)
  rw [Real.norm_eq_abs]
  exact abs_list_prod_mul_physicalWilsonLoop_le_prod_abs
    (P.side n) (P.spacing n) (Z.factor n) U G.loops

/-- The product of two renormalized loop-family evaluations is integrable with respect to
`P.configLaw n`. -/
theorem DisjointLoopFamily.integrable_eval_mul {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (F G : DisjointLoopFamily) :
    Integrable (fun U : GaugeConfig (P.side n) => F.eval Z n U * G.eval Z n U)
      (P.configLaw n : Measure (GaugeConfig (P.side n))) := by
  simpa only [DisjointLoopFamily.eval_append] using
    DisjointLoopFamily.integrable_eval Z n ⟨F.loops ++ G.loops⟩

/-! ### Exact Commensurate Translation Invariance at Every Finite Cutoff -/

/-- Pointwise physical Wilson loop translation identity for a shift `c` that is an integer multiple
`c i = k i * a` of the lattice spacing `a`. -/
theorem physicalWilsonLoop_translate_of_eq_mul {L : ℕ} {a : ℝ} (ha : 0 < a)
    {c : Fin 4 → ℚ} {k : Fin 4 → ℤ} (hk : ∀ i, (c i : ℝ) = k i * a)
    (ℓ : PhysicalRectangle) (U : GaugeConfig L) :
    physicalWilsonLoop L a (ℓ.translate c) U =
      physicalWilsonLoop L a ℓ
        (YangMillsContinuumCompactness.latticeTranslate (latticeSite L k) U) :=
  congr_fun (translateObservables_wilsonLoopVector (L := L) ha hk U) ℓ

/-- Pointwise translation equivariance of `DisjointLoopFamily.eval` for any translation-invariant
renormalization scheme `Z` and lattice-commensurate shift `c i = k i * P.spacing n`. -/
theorem DisjointLoopFamily.eval_translate_eq_of_isTranslationInvariant {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    {c : Fin 4 → ℚ} {k : Fin 4 → ℤ} (hk : ∀ i, (c i : ℝ) = k i * P.spacing n)
    (F : DisjointLoopFamily) (U : GaugeConfig (P.side n)) :
    (F.translate c).eval Z n U =
      F.eval Z n
        (YangMillsContinuumCompactness.latticeTranslate (latticeSite (P.side n) k) U) := by
  simp only [DisjointLoopFamily.eval, DisjointLoopFamily.translate, List.map_map]
  congr 1
  refine List.map_congr_left fun ℓ _ => ?_
  dsimp
  rw [hZ n c ℓ, physicalWilsonLoop_translate_of_eq_mul (P.spacing_pos n) hk ℓ U]

/-- Exact translation invariance of `renormalizedSchwinger` at cutoff `n` for any
translation-invariant loop renormalization scheme `Z` and any shift `c` that is a lattice vector
at spacing `P.spacing n` (`IsLatticeVector (P.spacing n) c`):
`renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F`. -/
theorem renormalizedSchwinger_translate_eq_of_isTranslationInvariant {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    {c : Fin 4 → ℚ} (hc : IsLatticeVector (P.spacing n) c) (F : DisjointLoopFamily) :
    renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
  choose k hk using hc
  unfold renormalizedSchwinger CutoffPath.configLaw
  have h_eq : ∀ U : GaugeConfig (P.side n),
      (F.translate c).eval Z n U =
        F.eval Z n
          (YangMillsContinuumCompactness.latticeTranslate (latticeSite (P.side n) k) U) :=
    DisjointLoopFamily.eval_translate_eq_of_isTranslationInvariant hZ n hk F
  simp only [h_eq]
  have hinv := congrArg ProbabilityMeasure.toMeasure
    (YangMillsContinuumCompactness.wilsonProbability_translation_invariant
      (P.side n) (P.coupling n) (P.coupling_nonneg n) (latticeSite (P.side n) k))
  rw [ProbabilityMeasure.toMeasure_map] at hinv
  conv_rhs => rw [← hinv]
  have hcont : Continuous (fun U : GaugeConfig (P.side n) => F.eval Z n U) :=
    DisjointLoopFamily.continuous_eval Z n F
  rw [integral_map
    (YangMillsContinuumCompactness.continuous_latticeTranslate
      (latticeSite (P.side n) k)).aemeasurable
    hcont.aestronglyMeasurable]

/-- Along any `LandingTube P`, for any fixed `m : ℕ`, `m ≤ T.K n` holds eventually for large `n`
because `P.spacing n → 0` and `P.spacing n * (2 : ℝ) ^ (T.K n) = T.ℓstar > 0`. -/
theorem LandingTube.eventually_le_K {P : ContinuumCutoffPath}
    (T : LandingTube P) (m : ℕ) :
    ∀ᶠ n in atTop, m ≤ T.K n := by
  have hℓ_pos : (0 : ℝ) < (T.ℓstar : ℝ) / (2 : ℝ) ^ m := by
    have : (0 : ℝ) < (T.ℓstar : ℝ) := Rat.cast_pos.mpr T.hℓstar
    positivity
  have h_sp_lt : ∀ᶠ n in atTop, P.spacing n < (T.ℓstar : ℝ) / (2 : ℝ) ^ m :=
    P.spacing_tendsto_zero.eventually (Iio_mem_nhds hℓ_pos)
  filter_upwards [h_sp_lt, T.hK] with n hn hKn
  by_contra h_not
  have h_le : T.K n ≤ m := by omega
  have h_pow : (2 : ℝ) ^ (T.K n) ≤ (2 : ℝ) ^ m :=
    pow_le_pow_right₀ (by norm_num) h_le
  have h_sp_pos : 0 < P.spacing n := P.spacing_pos n
  have h_2m_pos : (0 : ℝ) < (2 : ℝ) ^ m := by positivity
  have h1 : P.spacing n * (2 : ℝ) ^ m < (T.ℓstar : ℝ) :=
    (lt_div_iff₀ h_2m_pos).mp hn
  have h2 : P.spacing n * (2 : ℝ) ^ (T.K n) ≤ P.spacing n * (2 : ℝ) ^ m :=
    mul_le_mul_of_nonneg_left h_pow h_sp_pos.le
  linarith

/-- Along any `LandingTube P`, every `T.ℓstar`-dyadic shift `c : Fin 4 → ℚ` (any shift that is a
lattice vector at dyadic subdivision `(T.ℓstar : ℝ) / (2 : ℝ) ^ m` for some `m : ℕ`) is eventually
a lattice vector at UV spacing `P.spacing n`. -/
theorem LandingTube.eventually_isLatticeVector_spacing_of_dyadic {P : ContinuumCutoffPath}
    (T : LandingTube P) {c : Fin 4 → ℚ}
    (hc : ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) c) :
    ∀ᶠ n in atTop, IsLatticeVector (P.spacing n) c := by
  obtain ⟨m, hm⟩ := hc
  filter_upwards [T.eventually_le_K m, T.hK] with n hmK hKn i
  obtain ⟨k, hk⟩ := hm i
  refine ⟨k * (2 : ℤ) ^ (T.K n - m), ?_⟩
  have h_pow_split : (2 : ℝ) ^ (T.K n) = (2 : ℝ) ^ (T.K n - m) * (2 : ℝ) ^ m := by
    rw [← pow_add, Nat.sub_add_cancel hmK]
  have h_sp_eq : (T.ℓstar : ℝ) / (2 : ℝ) ^ m = P.spacing n * (2 : ℝ) ^ (T.K n - m) := by
    rw [← hKn, h_pow_split]
    have h2m : (2 : ℝ) ^ m ≠ 0 := by positivity
    field_simp [h2m]
  rw [hk, h_sp_eq]
  push_cast
  ring

/-- Along any `LandingTube P`, every shift `c` that is a lattice vector at the reference coarse
scale `T.ℓstar` is eventually a lattice vector at UV spacing `P.spacing n`. -/
theorem LandingTube.eventually_isLatticeVector_spacing_of_ellstar {P : ContinuumCutoffPath}
    (T : LandingTube P) {c : Fin 4 → ℚ} (hc : IsLatticeVector (T.ℓstar : ℝ) c) :
    ∀ᶠ n in atTop, IsLatticeVector (P.spacing n) c :=
  T.eventually_isLatticeVector_spacing_of_dyadic ⟨0, by simpa using hc⟩

/-- Unconditional dimension-6 $O(a_n^2)$ translation bound (`C_tr = 0`) for any eventually
lattice-commensurate shift `c` and translation-invariant renormalization scheme `Z`. -/
theorem exists_translate_dim6_of_eventually_isLatticeVector {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} (hZ : Z.IsTranslationInvariant) {c : Fin 4 → ℚ}
    (hc : ∀ᶠ n in atTop, IsLatticeVector (P.spacing n) c) (F : DisjointLoopFamily) :
    ∃ C_tr : ℝ, 0 ≤ C_tr ∧
      ∀ᶠ n in atTop,
        |renormalizedSchwinger Z n (F.translate c) - renormalizedSchwinger Z n F| ≤
          C_tr * (P.spacing n) ^ 2 := by
  refine ⟨0, le_rfl, ?_⟩
  filter_upwards [hc] with n hn
  rw [renormalizedSchwinger_translate_eq_of_isTranslationInvariant hZ n hn F,
    sub_self, abs_zero, zero_mul]

/-- For any eventually lattice-commensurate shift `c`, the translation defect of a
translation-invariant renormalization scheme `Z` vanishes eventually and therefore tends to `0`. -/
theorem tendsto_translate_defect_zero_of_eventually_isLatticeVector {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) {c : Fin 4 → ℚ}
    (hc : ∀ᶠ n in atTop, IsLatticeVector (P.spacing n) c) (F : DisjointLoopFamily) :
    Tendsto (fun n => renormalizedSchwinger Z n (F.translate c) - renormalizedSchwinger Z n F)
      atTop (𝓝 0) := by
  refine Tendsto.congr' ?_ tendsto_const_nhds
  filter_upwards [hc] with n hn
  rw [renormalizedSchwinger_translate_eq_of_isTranslationInvariant hZ n hn F, sub_self]

/-! ### Osterwalder–Seiler Reflection Positivity Discharge for `reflectedConnected` -/

/-- Pointwise time-reflection equivariance of `DisjointLoopFamily.eval` for time-commensurate loops
under reflection-invariant renormalization factors:
`F.reflect.eval Z n U = F.eval Z n (reflectConfig U)`. -/
theorem DisjointLoopFamily.eval_reflect_eq_of_isTimeCommensurate {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : HasReflectionInvariantFactors Z) (n : ℕ)
    (F : DisjointLoopFamily) (hF : ∀ ℓ ∈ F.loops, IsTimeCommensurate (P.spacing n) ℓ)
    (U : GaugeConfig (P.side n)) :
    F.reflect.eval Z n U = F.eval Z n (reflectConfig U) := by
  simp only [DisjointLoopFamily.eval, DisjointLoopFamily.reflect, List.map_map]
  congr 1
  refine List.map_congr_left fun ℓ hℓ => ?_
  dsimp
  rw [hZ n ℓ, physicalWilsonLoop_timeReflect (P.spacing_pos n) (hF ℓ hℓ) U]

/-- Exact time-reflection invariance of `renormalizedSchwinger` at cutoff `n` for any family `F`
of time-commensurate loops under reflection-invariant renormalization factors:
`renormalizedSchwinger Z n F.reflect = renormalizedSchwinger Z n F`. -/
theorem renormalizedSchwinger_reflect_eq_of_isTimeCommensurate {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : HasReflectionInvariantFactors Z) (n : ℕ)
    (F : DisjointLoopFamily) (hF : ∀ ℓ ∈ F.loops, IsTimeCommensurate (P.spacing n) ℓ) :
    renormalizedSchwinger Z n F.reflect = renormalizedSchwinger Z n F := by
  unfold renormalizedSchwinger CutoffPath.configLaw
  have h_eq : ∀ U : GaugeConfig (P.side n),
      F.reflect.eval Z n U = F.eval Z n (reflectConfig U) :=
    DisjointLoopFamily.eval_reflect_eq_of_isTimeCommensurate hZ n F hF
  simp only [h_eq]
  have hinv := congrArg ProbabilityMeasure.toMeasure
    (wilsonProbability_reflect_invariant (P.side n) (P.coupling n) (P.coupling_nonneg n))
  rw [ProbabilityMeasure.toMeasure_map] at hinv
  conv_rhs => rw [← hinv]
  have hcont : Continuous (fun U : GaugeConfig (P.side n) => F.eval Z n U) :=
    DisjointLoopFamily.continuous_eval Z n F
  rw [integral_map continuous_reflectConfig.aemeasurable hcont.aestronglyMeasurable]

/-- Positive-half locality of `DisjointLoopFamily.eval`: when `P.side n = 2 * M` and every loop in
`F` is adapted to the half-torus reflection (`IsReflectionAdapted (P.spacing n) M ℓ`), `F.eval Z n U`
depends only on links in the positive half-torus `IsPositiveLink M`. -/
theorem DisjointLoopFamily.eval_congr_of_isReflectionAdapted {P : CutoffPath}
    (Z : LoopRenormalization P) (n M : ℕ) (hL : P.side n = 2 * M)
    (F : DisjointLoopFamily) (hF : ∀ ℓ ∈ F.loops, IsReflectionAdapted (P.spacing n) M ℓ)
    {U U' : GaugeConfig (P.side n)} (h : ∀ e, IsPositiveLink M e → U e = U' e) :
    F.eval Z n U = F.eval Z n U' := by
  unfold DisjointLoopFamily.eval
  congr 1
  refine List.map_congr_left fun ℓ hℓ => ?_
  rw [physicalWilsonLoop_congr_of_adapted hL (P.spacing_pos n) (hF ℓ hℓ) h]

/-- Osterwalder–Seiler reflection positivity of the diagonal reflected connected correlator
`0 ≤ reflectedConnected Z n F F` at any even lattice side `P.side n = 2 * M` for any family `F`
of reflection-adapted loops. Proved by applying `wilson_reflection_positive` to the centered
positive-half observable `H U := F.eval Z n U - renormalizedSchwinger Z n F`. -/
theorem reflectedConnected_self_nonneg_of_isReflectionAdapted {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : HasReflectionInvariantFactors Z)
    (n M : ℕ) (hL : P.side n = 2 * M)
    (F : DisjointLoopFamily) (hF : ∀ ℓ ∈ F.loops, IsReflectionAdapted (P.spacing n) M ℓ) :
    0 ≤ reflectedConnected Z n F F := by
  let μ : Measure (GaugeConfig (P.side n)) :=
    (P.configLaw n : Measure (GaugeConfig (P.side n)))
  let c : ℝ := renormalizedSchwinger Z n F
  let H : GaugeConfig (P.side n) → ℝ := fun U => F.eval Z n U - c
  have hH_cont : Continuous H :=
    (DisjointLoopFamily.continuous_eval Z n F).sub continuous_const
  have hH_loc : ∀ U U' : GaugeConfig (P.side n),
      (∀ e, IsPositiveLink M e → U e = U' e) → H U = H U' := by
    intro U U' h
    dsimp [H]
    rw [DisjointLoopFamily.eval_congr_of_isReflectionAdapted Z n M hL F hF h]
  have h_rp : 0 ≤ ∫ U, H (reflectConfig U) * H U ∂μ :=
    wilson_reflection_positive hL (P.coupling n) (P.coupling_nonneg n) H hH_cont hH_loc
  have hF_comm : ∀ ℓ ∈ F.loops, IsTimeCommensurate (P.spacing n) ℓ :=
    fun ℓ hℓ => (hF ℓ hℓ).isTimeCommensurate
  have h_integrand :
      (fun U : GaugeConfig (P.side n) => H (reflectConfig U) * H U) =
      (fun U =>
        (F.reflect.eval Z n U * F.eval Z n U - F.reflect.eval Z n U * c) -
          (c * F.eval Z n U - c * c)) := by
    ext U
    dsimp [H]
    rw [← DisjointLoopFamily.eval_reflect_eq_of_isTimeCommensurate hZ n F hF_comm U]
    ring
  have hX_int : Integrable (fun U => F.reflect.eval Z n U) μ :=
    DisjointLoopFamily.integrable_eval Z n F.reflect
  have hY_int : Integrable (fun U => F.eval Z n U) μ :=
    DisjointLoopFamily.integrable_eval Z n F
  have hXY_int : Integrable (fun U => F.reflect.eval Z n U * F.eval Z n U) μ :=
    DisjointLoopFamily.integrable_eval_mul Z n F.reflect F
  have h1 : Integrable (fun U => F.reflect.eval Z n U * F.eval Z n U - F.reflect.eval Z n U * c) μ :=
    hXY_int.sub (hX_int.mul_const c)
  have h2 : Integrable (fun U => c * F.eval Z n U - c * c) μ :=
    (hY_int.const_mul c).sub (integrable_const (c * c))
  have h_eq : (∫ U, H (reflectConfig U) * H U ∂μ) = reflectedConnected Z n F F := by
    rw [h_integrand]
    change (∫ U, (fun U => F.reflect.eval Z n U * F.eval Z n U - F.reflect.eval Z n U * c) U -
      (fun U => c * F.eval Z n U - c * c) U ∂μ) = reflectedConnected Z n F F
    rw [integral_sub h1 h2]
    have h_left :
        (∫ U, F.reflect.eval Z n U * F.eval Z n U - F.reflect.eval Z n U * c ∂μ) =
          (∫ U, F.reflect.eval Z n U * F.eval Z n U ∂μ) -
            (∫ U, F.reflect.eval Z n U ∂μ) * c := by
      change (∫ U, (fun U => F.reflect.eval Z n U * F.eval Z n U) U -
        (fun U => F.reflect.eval Z n U * c) U ∂μ) = _
      rw [integral_sub hXY_int (hX_int.mul_const c), integral_mul_const]
    have h_right :
        (∫ U, c * F.eval Z n U - c * c ∂μ) =
          c * (∫ U, F.eval Z n U ∂μ) - c * c := by
      change (∫ U, (fun U => c * F.eval Z n U) U - (fun _ => c * c) U ∂μ) = _
      rw [integral_sub (hY_int.const_mul c) (integrable_const (c * c)),
        integral_const_mul, integral_const, probReal_univ, one_smul]
    rw [h_left, h_right]
    dsimp [c, μ, reflectedConnected, renormalizedSchwinger]
    ring
  linarith

/-- Unconditional dimension-6 $O(a_n^2)$ translation bound (`C_tr = 0`) along any `LandingTube P`
for every `T.ℓstar`-dyadic translation `c : Fin 4 → ℚ`. -/
theorem LandingTube.exists_translate_dim6_of_dyadic {P : ContinuumCutoffPath}
    (T : LandingTube P) {c : Fin 4 → ℚ}
    (hc : ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) c)
    (F : DisjointLoopFamily) :
    ∃ C_tr : ℝ, 0 ≤ C_tr ∧
      ∀ᶠ n in atTop,
        |renormalizedSchwinger T.Z_tube n (F.translate c) - renormalizedSchwinger T.Z_tube n F| ≤
          C_tr * (P.spacing n) ^ 2 :=
  exists_translate_dim6_of_eventually_isLatticeVector T.z_tube_isTranslationInvariant
    (T.eventually_isLatticeVector_spacing_of_dyadic hc) F

/-- Along any `LandingTube P`, `1 ≤ T.K n` and `Even (P.side n)` hold eventually for large `n`,
because `P.spacing n → 0`, `0 < T.ℓstar`, `P.spacing n * 2 ^ (T.K n) = T.ℓstar`, and
`P.side n = dyadicScaleSide (T.irSide n) (T.K n)`. -/
theorem LandingTube.eventually_K_pos_and_even_side {P : ContinuumCutoffPath}
    (T : LandingTube P) :
    ∀ᶠ n in atTop, 1 ≤ T.K n ∧ Even (P.side n) := by
  have hℓ_pos : (0 : ℝ) < (T.ℓstar : ℝ) := Rat.cast_pos.mpr T.hℓstar
  have h_sp_lt : ∀ᶠ n in atTop, P.spacing n < (T.ℓstar : ℝ) :=
    P.spacing_tendsto_zero.eventually (Iio_mem_nhds hℓ_pos)
  filter_upwards [h_sp_lt, T.hK, T.hside] with n hn hKn hside
  have hK1 : 1 ≤ T.K n := by
    by_contra h_not
    have hK0 : T.K n = 0 := by omega
    rw [hK0, pow_zero, mul_one] at hKn
    linarith
  refine ⟨hK1, ?_⟩
  have h_pow : (2 : ℕ) ^ (T.K n) = 2 * 2 ^ (T.K n - 1) := by
    conv_lhs => rw [← Nat.sub_add_cancel hK1]
    rw [pow_succ]
    ring
  refine ⟨2 ^ (T.K n - 1) * T.irSide n, ?_⟩
  rw [hside, dyadicScaleSide_eq_two_pow_mul, h_pow]
  ring

/-- Along any `ContinuumCutoffPath` with eventually even sides, every positive-time loop that is
eventually time-commensurate is eventually reflection-adapted at half-torus side `P.side n / 2`. -/
theorem eventually_isReflectionAdapted_of_eventually_isTimeCommensurate
    (P : ContinuumCutoffPath) (heven : ∀ᶠ n in atTop, Even (P.side n))
    {ℓ : PhysicalRectangle} (hpos : ℓ.IsPositiveTime)
    (hcomm : ∀ᶠ n in atTop, IsTimeCommensurate (P.spacing n) ℓ) :
    ∀ᶠ n in atTop, IsReflectionAdapted (P.spacing n) (P.side n / 2) ℓ := by
  have hb : (0 : ℝ) < (ℓ.base 0 : ℝ) := by exact_mod_cast hpos
  have hsideμ : (0 : ℝ) < (ℓ.sideμ : ℝ) := by exact_mod_cast ℓ.sideμ_pos
  have hbig : ∀ᶠ n in atTop,
      2 * ((ℓ.base 0 : ℝ) + (ℓ.sideμ : ℝ)) ≤ (P.side n : ℝ) * P.spacing n :=
    P.physicalSide_tendsto_atTop.eventually (eventually_ge_atTop _)
  filter_upwards [heven, hbig, hcomm] with n hev hbn ⟨⟨k_int, hk⟩, hr⟩
  have ha : 0 < P.spacing n := P.spacing_pos n
  have hk_pos : (0 : ℝ) < (k_int : ℝ) := by nlinarith
  have hk_nonneg : 0 ≤ k_int := by exact_mod_cast hk_pos.le
  let k : ℕ := k_int.toNat
  have hk_nat : (ℓ.base 0 : ℝ) = (k : ℝ) * P.spacing n := by
    have hkt : ((k : ℕ) : ℝ) = (k_int : ℝ) := by exact_mod_cast Int.toNat_of_nonneg hk_nonneg
    rw [hkt, hk]
  let r : ℕ := if hμ : ℓ.μ = 0 then (hr hμ).choose else 0
  have hr_eq : ℓ.μ = 0 → (ℓ.sideμ : ℝ) = (r : ℝ) * P.spacing n := by
    intro hμ
    simp only [r, hμ, dite_true]
    exact (hr hμ).choose_spec
  have hr_le : (r : ℝ) * P.spacing n ≤ (ℓ.sideμ : ℝ) := by
    by_cases hμ : ℓ.μ = 0
    · rw [hr_eq hμ]
    · simp only [r, hμ, dite_false, Nat.cast_zero, zero_mul]
      exact hsideμ.le
  refine ⟨k, r, hk_nat, hr_eq, ?_⟩
  have h2_div : P.side n = 2 * (P.side n / 2) := by
    obtain ⟨m, hm⟩ := hev
    omega
  have hside_cast : (P.side n : ℝ) = 2 * ((P.side n / 2 : ℕ) : ℝ) := by
    exact_mod_cast h2_div
  have hkr_le : ((k + r : ℕ) : ℝ) ≤ ((P.side n / 2 : ℕ) : ℝ) := by
    have h_sum : ((k + r : ℕ) : ℝ) * P.spacing n ≤ (ℓ.base 0 : ℝ) + (ℓ.sideμ : ℝ) := by
      push_cast
      linarith
    rw [hside_cast] at hbn
    nlinarith
  exact_mod_cast hkr_le

/-- Unconditional eventual Osterwalder–Seiler reflection positivity along a `LandingTube P`:
for any positive-time loop family `F` whose loops are eventually time-commensurate with `P.spacing n`,
`∀ᶠ n in atTop, 0 ≤ reflectedConnected T.Z_tube n F F`. -/
theorem LandingTube.eventually_reflectedConnected_self_nonneg_of_isTimeCommensurate
    {P : ContinuumCutoffPath} (T : LandingTube P) (F : DisjointLoopFamily)
    (hFpos : F.PositiveTime)
    (h_comm : ∀ ℓ ∈ F.loops, ∀ᶠ n in atTop, IsTimeCommensurate (P.spacing n) ℓ) :
    ∀ᶠ n in atTop, 0 ≤ reflectedConnected T.Z_tube n F F := by
  classical
  have heven : ∀ᶠ n in atTop, Even (P.side n) :=
    T.eventually_K_pos_and_even_side.mono fun _ hn => hn.2
  have h_adapt_all : ∀ᶠ n in atTop,
      ∀ ℓ ∈ F.loops.toFinset, IsReflectionAdapted (P.spacing n) (P.side n / 2) ℓ := by
    rw [Filter.eventually_all_finset]
    intro ℓ hℓ
    have hℓ_mem : ℓ ∈ F.loops := List.mem_toFinset.mp hℓ
    exact eventually_isReflectionAdapted_of_eventually_isTimeCommensurate P heven
      (hFpos ℓ hℓ_mem) (h_comm ℓ hℓ_mem)
  filter_upwards [heven, h_adapt_all] with n hev hadapt
  have hL : P.side n = 2 * (P.side n / 2) := by
    obtain ⟨m, hm⟩ := hev
    omega
  exact reflectedConnected_self_nonneg_of_isReflectionAdapted
    T.z_tube_hasReflectionInvariantFactors n (P.side n / 2) hL F
    (fun ℓ hℓ => hadapt ℓ (List.mem_toFinset.mpr hℓ))

/-- Along any `LandingTube P`, any `T.ℓstar`-dyadic loop `ℓ` (`∃ m : ℕ, IsTimeCommensurate ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ`)
is eventually time-commensurate with `P.spacing n`. -/
theorem LandingTube.eventually_isTimeCommensurate_spacing_of_dyadic
    {P : ContinuumCutoffPath} (T : LandingTube P) {ℓ : PhysicalRectangle}
    (hℓ : ∃ m : ℕ, IsTimeCommensurate ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ) :
    ∀ᶠ n in atTop, IsTimeCommensurate (P.spacing n) ℓ := by
  rcases hℓ with ⟨m, ⟨⟨k, hk⟩, hr⟩⟩
  filter_upwards [T.eventually_le_K m, T.hK] with n hmK hKn
  have h_pow_split : (2 : ℝ) ^ (T.K n) = (2 : ℝ) ^ (T.K n - m) * (2 : ℝ) ^ m := by
    rw [← pow_add, Nat.sub_add_cancel hmK]
  have h_sp_eq : (T.ℓstar : ℝ) / (2 : ℝ) ^ m = P.spacing n * (2 : ℝ) ^ (T.K n - m) := by
    rw [← hKn, h_pow_split]
    have h2m : (2 : ℝ) ^ m ≠ 0 := by positivity
    field_simp [h2m]
  refine ⟨⟨k * (2 : ℤ) ^ (T.K n - m), ?_⟩, fun hμ => ?_⟩
  · rw [hk, h_sp_eq]
    push_cast
    ring
  · obtain ⟨r, hr_eq⟩ := hr hμ
    refine ⟨r * 2 ^ (T.K n - m), ?_⟩
    rw [hr_eq, h_sp_eq]
    push_cast
    ring

/-- Along any `LandingTube P`, any loop `ℓ` that is time-commensurate with the coarse reference
scale `T.ℓstar` is eventually time-commensurate with `P.spacing n`. -/
theorem LandingTube.eventually_isTimeCommensurate_spacing_of_ellstar
    {P : ContinuumCutoffPath} (T : LandingTube P) {ℓ : PhysicalRectangle}
    (hℓ : IsTimeCommensurate (T.ℓstar : ℝ) ℓ) :
    ∀ᶠ n in atTop, IsTimeCommensurate (P.spacing n) ℓ :=
  T.eventually_isTimeCommensurate_spacing_of_dyadic ⟨0, by simpa using hℓ⟩

/-- Unconditional eventual Osterwalder–Seiler reflection positivity along a `LandingTube P` for
every positive-time `T.ℓstar`-dyadic loop family `F`:
if every `ℓ ∈ F.loops` satisfies `∃ m : ℕ, IsTimeCommensurate ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ`,
then `∀ᶠ n in atTop, 0 ≤ reflectedConnected T.Z_tube n F F`. -/
theorem LandingTube.eventually_reflectedConnected_self_nonneg_of_dyadic
    {P : ContinuumCutoffPath} (T : LandingTube P) (F : DisjointLoopFamily)
    (hFpos : F.PositiveTime)
    (h_dyadic : ∀ ℓ ∈ F.loops, ∃ m : ℕ, IsTimeCommensurate ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ) :
    ∀ᶠ n in atTop, 0 ≤ reflectedConnected T.Z_tube n F F :=
  T.eventually_reflectedConnected_self_nonneg_of_isTimeCommensurate F hFpos
    (fun ℓ hℓ => T.eventually_isTimeCommensurate_spacing_of_dyadic (h_dyadic ℓ hℓ))

/-- Unconditional `T.ℓstar`-dyadic reflection positivity along any `T : LandingTube P`. -/
theorem LandingTube.schwingerDyadicReflectionPositive {P : ContinuumCutoffPath}
    (T : LandingTube P) :
    SchwingerDyadicReflectionPositive T.Z_tube T.ℓstar :=
  fun F hF hd => T.eventually_reflectedConnected_self_nonneg_of_dyadic F hF hd

/-- Negative control: `canonicalSpatialProbe a ha` has base time `a / 2`, which is not an integer
multiple of `a`, so `LandingTube.eventually_reflectedConnected_probe_nonneg_of_ellstar` does not
apply to `canonicalSpatialProbe a ha` at `m = 0`. -/
theorem not_isTimeCommensurate_canonicalSpatialProbe {a : ℚ} (ha : 0 < a) :
    ¬ IsTimeCommensurate (a : ℝ) (canonicalSpatialProbe a ha) := by
  rintro ⟨⟨k, hk⟩, _⟩
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  change ((a / 2 : ℚ) : ℝ) = (k : ℝ) * (a : ℝ) at hk
  push_cast at hk
  have h_two : (2 * k : ℝ) * (a : ℝ) = 1 * (a : ℝ) := by linarith
  have h_eq : (2 * k : ℝ) = 1 := mul_right_cancel₀ ha_real.ne' h_two
  have h_int : 2 * k = 1 := by exact_mod_cast h_eq
  omega

/-- The canonical spatial probe `canonicalSpatialProbe a ha` is time-commensurate with the
first dyadic subdivision `a / 2 ^ 1 = a / 2` (`m = 1`). -/
theorem isTimeCommensurate_half_canonicalSpatialProbe {a : ℚ} (ha : 0 < a) :
    IsTimeCommensurate ((a : ℝ) / (2 : ℝ) ^ 1) (canonicalSpatialProbe a ha) :=
  ⟨⟨1, by simp [canonicalSpatialProbe]⟩, fun hμ => nomatch hμ⟩

/-- Unconditional eventual nonnegativity of the reflected connected self-correlator of the
canonical spatial probe `⟨[T.ℓ_probe]⟩` along any `T : LandingTube P`. -/
theorem LandingTube.eventually_reflectedConnected_canonicalProbe_nonneg
    {P : ContinuumCutoffPath} (T : LandingTube P) :
    ∀ᶠ n in atTop, 0 ≤ reflectedConnected T.Z_tube n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩ := by
  apply T.eventually_reflectedConnected_self_nonneg_of_dyadic ⟨[T.ℓ_probe]⟩
  · intro ℓ hℓ
    rcases List.mem_singleton.mp hℓ with rfl
    exact T.hℓ_probe_pos
  · intro ℓ hℓ
    rcases List.mem_singleton.mp hℓ with rfl
    exact ⟨1, isTimeCommensurate_half_canonicalSpatialProbe T.hℓstar⟩

/-- Every loop family `F` admissible on `(a, halfOffset)` is `a`-dyadic in time (`m = 1`). -/
theorem DisjointLoopFamily.isDyadicTime_of_isAdmissible_halfOffset {a : ℚ} (_ha : 0 < a)
    {F : DisjointLoopFamily} (hF : F.IsAdmissible a halfOffset) :
    F.IsDyadicTime a := by
  intro ℓ hℓ
  have h_grid := hF.1 ℓ hℓ
  obtain ⟨k, hk⟩ := h_grid.1 0
  refine ⟨1, ⟨⟨2 * k + 1, ?_⟩, fun _ => ?_⟩⟩
  · have hk_real : (ℓ.base 0 : ℝ) = ((k : ℝ) + 1 / 2) * (a : ℝ) := by
      simpa [halfOffset] using congrArg (Rat.cast : ℚ → ℝ) hk
    rw [hk_real]
    push_cast
    ring
  · obtain ⟨r, _, hr⟩ := h_grid.2.1
    refine ⟨2 * r, ?_⟩
    have hr_real : (ℓ.sideμ : ℝ) = (r : ℝ) * (a : ℝ) := by exact_mod_cast hr
    rw [hr_real]
    push_cast
    ring

/-- VACUOUS (`not_twoCutoffComparison_of_observableTransferAndSymmetryBridge`):
Conditional bridge from `T : LandingTube P`, `TwoCutoffComparison T Z`, and
`ObservableTransferAndSymmetryBridge T Z` to the Schwinger-level continuum existence and positive
mass gap `QYMSchwingerGap P` at rate `m = transferGapRate T.ℓstar (landingTubeContraction T) > 0`,
discharging the exponential IR covariance decay via `ObservableTransferAndSymmetryBridge.ir_cov_decay`
and discharging dyadic reflection positivity (`T.schwingerDyadicReflectionPositive`),
`h_permute_defect`, `h_cov_transfer_le`, and `h_probe_transfer` directly from `T` and `hC`. -/
theorem qymSchwingerGap_of_landingTube {P : ContinuumCutoffPath}
    (T : LandingTube P) {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z)
    (hTrans : ObservableTransferAndSymmetryBridge T Z) :
    QYMSchwingerGap P := by
  obtain ⟨S, hS⟩ := schwingerConverges_of_twoCutoffComparison hC
  obtain ⟨hq0, hq1, hm_pos⟩ := landingTube_contraction_and_transferGapRate_pos T
  have hZ_perm : Z.IsPermutationInvariant := hC.hZ_eq ▸ T.z_tube_isPermutationInvariant
  have h_probe_pos : (⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).PositiveTime := by
    intro ℓ hℓ
    rcases List.mem_singleton.mp hℓ with rfl
    exact T.hℓ_probe_pos
  set q := landingTubeContraction T
  refine ⟨Z, S, T.ℓstar, q, transferGapRate T.ℓstar q,
    T.hℓstar, hq0, hq1, rfl, hm_pos, hS,
    hC.hZ_eq ▸ T.schwingerDyadicReflectionPositive, ?_, ?_, ?_⟩
  · intro c σ F
    have htr : S (F.translate c) - S F = 0 :=
      tendsto_nhds_unique ((hS (F.translate c)).sub (hS F)) (hTrans.h_translate_defect c F)
    have hpm : S (F.permute σ) - S F = 0 :=
      tendsto_nhds_unique ((hS (F.permute σ)).sub (hS F))
        (tendsto_permute_defect_zero_of_isPermutationInvariant hZ_perm σ F)
    exact ⟨sub_eq_zero.mp htr, sub_eq_zero.mp hpm⟩
  · intro F hFpos
    obtain ⟨C_decay, _, h_ir⟩ := hTrans.ir_cov_decay F hFpos
    refine ⟨C_decay + 1, fun t => ?_⟩
    filter_upwards [h_ir t, hC.eventually_cov_transfer_le F t]
      with n hir htr
    linarith
  · refine ⟨⟨[T.ℓ_probe]⟩, T.c_floor / 2, h_probe_pos, half_pos T.hc_floor, ?_⟩
    filter_upwards [T.h_floor,
      hC.eventually_probe_transfer
        (hC.hZ_eq ▸ T.eventually_reflectedConnected_canonicalProbe_nonneg)]
      with n hfl htr
    linarith

/-- VACUOUS (`not_twoCutoffComparison_of_observableTransferAndSymmetryBridge`):
A verified `IntervalArithmeticCrossoverCertificate P` combined with `TwoCutoffComparison` and
