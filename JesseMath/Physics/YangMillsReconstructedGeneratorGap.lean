/-- Volume-uniform supremum-based Dobrushin interdependence row-sum and `t`-step iterated
contraction bound for the full blocked effective action
`st.totalAction V = st.c_vac + wilsonAction st.β V + st.polymers.eval V + st.R_trunc V` on
`GaugeConfig L`: whenever `0 ≤ st.β ≤ β_star`, `PolymerDobrushinNormBound st.polymers η_star`,
`TruncationDobrushinNormBound st.R_trunc ε_star`, and
`4 * (18 * (24 * β_star) + η_star + ε_star) < 1`, Dobrushin's supremum interdependence matrix
`dobrushinSupMatrix SU2 L st.totalAction` (taking the supremum over all configurations `V`,
exterior link updates `h1, h2 : SU2`, and measurable test functions `φ : SU2 → [0, 1]`) has
torus-wide row sum bounded by `4 * (18 * (24 * β_star) + η_star + ε_star) < 1` at every link
`e : Link L`, and its `t`-step iterated row sum contracts geometrically as
`(4 * (18 * (24 * β_star) + η_star + ε_star)) ^ t`. -/
theorem totalAction_dobrushinSupMatrix_rowSum_le {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L)
    {β_star η_star ε_star : ℝ}
    (hβ0 : 0 ≤ st.β) (hβ_le : st.β ≤ β_star)
    (_hβ_star : 0 ≤ β_star) (hη_star : 0 ≤ η_star) (hε_star : 0 ≤ ε_star)
    (h_poly : PolymerDobrushinNormBound st.polymers η_star)
    (h_trunc : TruncationDobrushinNormBound st.R_trunc ε_star)
    (h_land : 4 * (18 * (24 * β_star) + η_star + ε_star) < 1) :
    (∀ e : Link L,
      (∑ e' : Link L, dobrushinSupMatrix SU2 L st.totalAction e e') ≤
        4 * (18 * (24 * β_star) + η_star + ε_star) ∧
      (∑ e' : Link L, dobrushinSupMatrix SU2 L st.totalAction e e') < 1) ∧
    (∀ (t : ℕ) (e : Link L),
      0 ≤ dobrushinIteratedRowSum (dobrushinSupMatrix SU2 L st.totalAction) t e ∧
      dobrushinIteratedRowSum (dobrushinSupMatrix SU2 L st.totalAction) t e ≤
        (4 * (18 * (24 * β_star) + η_star + ε_star)) ^ t) := by
  classical
  obtain ⟨c_poly, hc_poly_nonneg, hc_poly_mix, hc_poly_sum⟩ := h_poly.2.2
  obtain ⟨⟨B_R, hR_bdd⟩, hR_meas, c_trunc, hc_trunc_nonneg, hc_trunc_mix, hc_trunc_sum⟩ := h_trunc
  let B : ℝ :=
    |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
      (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|) + B_R
