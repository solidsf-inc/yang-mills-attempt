    | zero => simp
    | succ k ih =>
      have hpow : x ^ (k + 1) ≤ 1 := pow_le_one₀ hx0 hx1
      have hmul := mul_le_mul_of_nonneg_left ih hx0
      have htail := mul_le_mul_of_nonneg_right hpow (sub_nonneg.mpr hx1)
      simp only [Nat.cast_add, Nat.cast_one, pow_succ] at *
      nlinarith
  apply (le_div_iff₀ (by positivity : 0 < (n : ℝ) + 1)).mpr
  have hp := pow_nonneg hx0 (n + 1)
  nlinarith [hstrong n]

theorem positiveContraction_norm_pow_mul_one_sub_le : ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (P : H →L[ℂ] H), 0 ≤ P → ‖P‖ ≤ 1 → ∀ n : ℕ,
  ‖P ^ n * (1 - P)‖ ≤ 1 / ((n : ℝ) + 1) := by
  intro H _ _ _ P hP hnorm n
  have hsa : IsSelfAdjoint P := IsSelfAdjoint.of_nonneg hP
  have hformula : cfc (fun x : ℝ => x ^ n * (1 - x)) P = P ^ n * (1 - P) := by
    rw [cfc_mul (fun x : ℝ => x ^ n) (fun x : ℝ => 1 - x) P,
      cfc_pow_id P n hsa, cfc_sub (fun _ : ℝ => 1) (fun x : ℝ => x) P,
      cfc_const_one ℝ P hsa, cfc_id' ℝ P hsa]
  rw [← hformula]
  apply norm_cfc_le (by positivity)
  intro x hx
  have hx0 : 0 ≤ x := spectrum_nonneg_of_nonneg hP hx
  have hx1 : x ≤ 1 := calc
    x ≤ ‖x‖ := Real.le_norm_self x
    _ ≤ ‖P‖ := IsometricContinuousFunctionalCalculus.norm_spectrum_le P hx hsa
    _ ≤ 1 := hnorm
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (pow_nonneg hx0 n) (sub_nonneg.mpr hx1))]
  exact power_mul_one_sub_le_inv_succ x hx0 hx1 n

theorem sub_one_mul_pow_mul_eq_neg : ∀ (A : Type) [Ring A] (p q : A) (n : ℕ), (p - 1) * (p ^ n * q) = -(p ^ n * (1 - p) * q) := by
  intro A _ p q n
  rw [← mul_assoc, sub_mul, one_mul, ← pow_succ', mul_sub, mul_one, ← pow_succ,
    ← neg_mul, neg_sub]

theorem positiveContraction_norm_smoothed_increment_le : ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (P Q : H →L[ℂ] H), 0 ≤ P → ‖P‖ ≤ 1 → ‖Q‖ ≤ 1 → ∀ n : ℕ,
  ‖(P - 1) * (P ^ n * Q)‖ ≤ 1 / ((n : ℝ) + 1) := by
  intro H _ _ _ P Q hP hnorm hQ n
  rw [sub_one_mul_pow_mul_eq_neg (H →L[ℂ] H) P Q n, norm_neg]
  simpa only [mul_one] using norm_mul_le_of_le (positiveContraction_norm_pow_mul_one_sub_le H P hP hnorm n) hQ

theorem nonnegativeRatSemigroup_nat_mul : ∀ (A : Type) [Ring A] (T : ℚ → A), T 0 = 1 →
  (∀ s t : ℚ, 0 ≤ s → 0 ≤ t → T (s + t) = T s * T t) →
  ∀ (t : ℚ), 0 ≤ t → ∀ n : ℕ, T ((n : ℚ) * t) = (T t) ^ n := by
  intro A _ T hzero hadd t ht n
  induction n with
  | zero => simpa using hzero
  | succ n ih =>
    rw [Nat.cast_add, Nat.cast_one, add_mul, one_mul,
      hadd ((n : ℚ) * t) t (mul_nonneg (Nat.cast_nonneg n) ht) ht, ih, pow_succ]

theorem positiveRat_floor_remainder_and_inverse_bound : ∀ (a t : ℚ), 0 < a → 0 < t →
  0 ≤ a - (Nat.floor (a / t) : ℚ) * t ∧
  1 / ((Nat.floor (a / t) : ℝ) + 1) ≤ (t : ℝ) / (a : ℝ) := by
  intro a t ha ht
  have hf := Nat.floor_le (div_nonneg ha.le ht.le)
  have hmul : (Nat.floor (a / t) : ℚ) * t ≤ a := (le_div_iff₀ ht).mp hf
  have htop : a < ((Nat.floor (a / t) : ℚ) + 1) * t :=
    (div_lt_iff₀ ht).mp (Nat.lt_floor_add_one (a / t))
  refine ⟨sub_nonneg.mpr hmul, ?_⟩
  have haR : 0 < (a : ℝ) := by exact_mod_cast ha
  have htopR : (a : ℝ) < ((Nat.floor (a / t) : ℝ) + 1) * (t : ℝ) := by exact_mod_cast htop
  apply (div_le_div_iff₀ (by positivity : 0 < (Nat.floor (a / t) : ℝ) + 1) haR).mpr
  nlinarith

theorem nonnegativeRatSemigroup_floor_factorization : ∀ (A : Type) [Ring A] (T : ℚ → A), T 0 = 1 →
  (∀ s t : ℚ, 0 ≤ s → 0 ≤ t → T (s + t) = T s * T t) →
  ∀ (a t : ℚ), 0 < a → 0 < t →
  T a = (T t) ^ Nat.floor (a / t) * T (a - (Nat.floor (a / t) : ℚ) * t) := by
  intro A _ T hzero hadd a t ha ht
  have hr := (positiveRat_floor_remainder_and_inverse_bound a t ha ht).1
  have htime : a = (Nat.floor (a / t) : ℚ) * t + (a - (Nat.floor (a / t) : ℚ) * t) := by ring
  calc
    T a = T ((Nat.floor (a / t) : ℚ) * t + (a - (Nat.floor (a / t) : ℚ) * t)) := congrArg T htime
    _ = T ((Nat.floor (a / t) : ℚ) * t) * T (a - (Nat.floor (a / t) : ℚ) * t) :=
      hadd _ _ (mul_nonneg (Nat.cast_nonneg _) ht.le) hr
    _ = (T t) ^ Nat.floor (a / t) * T (a - (Nat.floor (a / t) : ℚ) * t) := by
      rw [nonnegativeRatSemigroup_nat_mul A T hzero hadd t ht.le]

theorem positiveRatSemigroup_norm_buffered_increment_le : ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (T : ℚ → (H →L[ℂ] H)), T 0 = 1 →
  (∀ q : ℚ, 0 ≤ q → 0 ≤ T q) →
  (∀ q : ℚ, 0 ≤ q → ‖T q‖ ≤ 1) →
  (∀ s t : ℚ, 0 ≤ s → 0 ≤ t → T (s + t) = T s * T t) →
  ∀ (a t : ℚ), 0 < a → 0 < t → ‖(T t - 1) * T a‖ ≤ (t : ℝ) / (a : ℝ) := by
  intro H _ _ _ T hzero hpos hnorm hadd a t ha ht
  have hr := (positiveRat_floor_remainder_and_inverse_bound a t ha ht).1
  have hbound := positiveContraction_norm_smoothed_increment_le H (T t) (T (a - (Nat.floor (a / t) : ℚ) * t))
    (hpos t ht.le) (hnorm t ht.le) (hnorm _ hr) (Nat.floor (a / t))
  have hfactor := nonnegativeRatSemigroup_floor_factorization (H →L[ℂ] H) T hzero hadd a t ha ht
  rw [← hfactor] at hbound
  exact hbound.trans (positiveRat_floor_remainder_and_inverse_bound a t ha ht).2

theorem contraction_buffer_approximation_estimate : ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (P Q : H →L[ℂ] H) (c : ℝ), ‖P‖ ≤ 1 → ‖(P - 1) * Q‖ ≤ c →
  ∀ u v : H, ‖P u - u‖ ≤ 2 * ‖u - Q v‖ + c * ‖v‖ := by
  intro H _ _ _ P Q c hP hbound u v
  have hfirst : ‖P (u - Q v)‖ ≤ ‖u - Q v‖ :=
    (P.le_opNorm _).trans (mul_le_of_le_one_left (norm_nonneg _) hP)
  have hmid : ‖((P - 1) * Q) v‖ ≤ c * ‖v‖ :=
    (((P - 1) * Q).le_opNorm v).trans (mul_le_mul_of_nonneg_right hbound (norm_nonneg v))
  have heq : P u - u = P (u - Q v) + ((P - 1) * Q) v - (u - Q v) := by
    simp only [map_sub, mul_apply_eq_comp, sub_apply,
      one_apply_eq_self]
    abel
  rw [heq]
  calc
    ‖P (u - Q v) + ((P - 1) * Q) v - (u - Q v)‖ ≤
        ‖P (u - Q v) + ((P - 1) * Q) v‖ + ‖u - Q v‖ := norm_sub_le _ _
    _ ≤ (‖P (u - Q v)‖ + ‖((P - 1) * Q) v‖) + ‖u - Q v‖ :=
      add_le_add (norm_add_le _ _) le_rfl
    _ ≤ (‖u - Q v‖ + c * ‖v‖) + ‖u - Q v‖ :=
      add_le_add (add_le_add hfirst hmid) le_rfl
    _ = 2 * ‖u - Q v‖ + c * ‖v‖ := by ring

theorem ratTransfer_stronglyContinuous_of_smoothing_and_dense_ranges : ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (T : ℚ → (H →L[ℂ] H)),
  (∀ q : ℚ, 0 ≤ q → ‖T q‖ ≤ 1) →
  (∀ (a t : ℚ), 0 < a → 0 < t → ‖(T t - 1) * T a‖ ≤ (t : ℝ) / (a : ℝ)) →
  (∀ (u : H) (ε : ℝ), 0 < ε → ∃ (a : ℚ), 0 < a ∧ ∃ v : H, ‖u - T a v‖ < ε) →
  ∀ u : H, Filter.Tendsto (fun t : ℚ => T t u)
    (nhdsWithin 0 (Set.Ioi 0)) (nhds u) := by
  intro H _ _ _ T hnorm hsmooth happrox u
  apply Metric.tendsto_nhdsWithin_nhds.mpr
  intro ε hε
  obtain ⟨a, ha, v, hv⟩ := happrox u (ε / 4) (by positivity)
  have haR : 0 < (a : ℝ) := by exact_mod_cast ha
  have hvp : 0 < ‖v‖ + 1 := by positivity
  let δ : ℝ := (ε / (4 * (‖v‖ + 1))) * (a : ℝ)
  refine ⟨δ, by dsimp [δ]; positivity, ?_⟩
  intro t ht hdist
  have htq : 0 < t := ht
  have htR : 0 < (t : ℝ) := by exact_mod_cast htq
  have htδ : (t : ℝ) < δ := by
    rwa [dist_zero_right, ← Rat.norm_cast_real, Real.norm_eq_abs, abs_of_pos htR] at hdist
  have hratio : (t : ℝ) / (a : ℝ) < ε / (4 * (‖v‖ + 1)) :=
    (div_lt_iff₀ haR).mpr htδ
  have htail : (t : ℝ) / (a : ℝ) * ‖v‖ < ε / 4 := by
    calc
      (t : ℝ) / (a : ℝ) * ‖v‖ ≤ (t : ℝ) / (a : ℝ) * (‖v‖ + 1) :=
        mul_le_mul_of_nonneg_left (by linarith) (div_nonneg htR.le haR.le)
      _ < (ε / (4 * (‖v‖ + 1))) * (‖v‖ + 1) :=
        mul_lt_mul_of_pos_right hratio hvp
      _ = ε / 4 := by field_simp
  have hbound := contraction_buffer_approximation_estimate H (T t) (T a) ((t : ℝ) / (a : ℝ))
    (hnorm t htq.le) (hsmooth a t ha htq) u v
  rw [dist_eq_norm]
  linarith

theorem rationalTransfer_stronglyContinuous_of_bufferApproximation : ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (T : ℚ → (H →L[ℂ] H)), T 0 = 1 →
  (∀ q : ℚ, 0 ≤ q → 0 ≤ T q) →
  (∀ q : ℚ, 0 ≤ q → ‖T q‖ ≤ 1) →
  (∀ s t : ℚ, 0 ≤ s → 0 ≤ t → T (s + t) = T s * T t) →
  (∀ (u : H) (ε : ℝ), 0 < ε → ∃ (a : ℚ), 0 < a ∧ ∃ v : H, ‖u - T a v‖ < ε) →
  ∀ u : H, Filter.Tendsto (fun t : ℚ => T t u)
    (nhdsWithin 0 (Set.Ioi 0)) (nhds u) := by
  intro H _ _ _ T hzero hpos hnorm hadd happrox
  exact ratTransfer_stronglyContinuous_of_smoothing_and_dense_ranges H T hnorm
    (positiveRatSemigroup_norm_buffered_increment_le H T hzero hpos hnorm hadd) happrox


theorem finitePositiveTime_buffer : ∀ (S : Finset JesseMath.Physics.YangMillsRenormalizedObservableLimits.PhysicalRectangle),
  (∀ ℓ ∈ S, ℓ.IsPositiveTime) →
  ∃ a : ℚ, 0 < a ∧ ∀ ℓ ∈ S, a < ℓ.base 0 := by
  classical
  intro S
  induction S using Finset.induction_on with
  | empty =>
      intro hS
      exact ⟨1, by norm_num, by simp⟩
  | @insert ℓ S hnot ih =>
      intro hS
      have hℓ : 0 < ℓ.base 0 := hS ℓ (Finset.mem_insert_self ℓ S)
      obtain ⟨a, ha, hbound⟩ := ih (fun k hk => hS k (Finset.mem_insert_of_mem hk))
      refine ⟨min a (ℓ.base 0 / 2), lt_min ha (half_pos hℓ), ?_⟩
      intro k hk
      rcases Finset.mem_insert.mp hk with rfl | hk
      · exact lt_of_le_of_lt (min_le_right _ _) (half_lt_self hℓ)
      · exact lt_of_le_of_lt (min_le_left _ _) (hbound k hk)

theorem finiteCylinder_timeBufferFactorization : ∀ (L : JesseMath.Physics.YangMillsReconstructedGeneratorGap.ReflectionPositiveLaw) (S : Finset JesseMath.Physics.YangMillsRenormalizedObservableLimits.PhysicalRectangle)
  (F : BoundedContinuousFunction JesseMath.Physics.YangMillsRenormalizedObservableLimits.WilsonLoopSpace ℂ) (a : ℚ) (ha : 0 < a),
  (∀ ℓ ∈ S, a < ℓ.base 0) →
  (∀ w w' : JesseMath.Physics.YangMillsRenormalizedObservableLimits.WilsonLoopSpace, (∀ ℓ ∈ S, w ℓ = w' ℓ) → F w = F w') →
  ∃ B : JesseMath.Physics.YangMillsReconstructedGeneratorGap.OSVector L,
    (JesseMath.Physics.YangMillsReconstructedGeneratorGap.OSVector.translate L ha.le B).toBCF = F := by
  intro L S F a ha hbound hF
  let B0 := F.compContinuous (JesseMath.Physics.YangMillsReconstructedGeneratorGap.translateCM (-a))
  have hB0 : JesseMath.Physics.YangMillsReconstructedGeneratorGap.PositiveTimeLocal B0 := by
    intro w w' hw
    change F (JesseMath.Physics.YangMillsRenormalizedObservableLimits.translateObservables (JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift (-a)) w) =
      F (JesseMath.Physics.YangMillsRenormalizedObservableLimits.translateObservables (JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift (-a)) w')
    apply hF
    intro ℓ hℓ
    change w (ℓ.translate (JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift (-a))) =
      w' (ℓ.translate (JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift (-a)))
    apply hw
    change 0 < (ℓ.base + JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift (-a)) 0
    simpa [JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift, sub_eq_add_neg] using sub_pos.mpr (hbound ℓ hℓ)
  refine ⟨JesseMath.Physics.YangMillsReconstructedGeneratorGap.OSVector.mk B0 hB0, ?_⟩
  ext w
  change F (JesseMath.Physics.YangMillsRenormalizedObservableLimits.translateObservables (JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift (-a))
    (JesseMath.Physics.YangMillsRenormalizedObservableLimits.translateObservables (JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift a) w)) = F w
  have hshift : JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift (-a) + JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift a = 0 := by
    rw [JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift_add]
    funext i
    simp [JesseMath.Physics.YangMillsReconstructedGeneratorGap.timeShift]
  rw [JesseMath.Physics.YangMillsReconstructedGeneratorGap.translateObservables_translateObservables, hshift,
    JesseMath.Physics.YangMillsReconstructedGeneratorGap.translateObservables_zero]

theorem finitePositiveCylinder_timeBufferFactorization : ∀ (L : JesseMath.Physics.YangMillsReconstructedGeneratorGap.ReflectionPositiveLaw) (S : Finset JesseMath.Physics.YangMillsRenormalizedObservableLimits.PhysicalRectangle)
  (F : BoundedContinuousFunction JesseMath.Physics.YangMillsRenormalizedObservableLimits.WilsonLoopSpace ℂ),
  (∀ ℓ ∈ S, ℓ.IsPositiveTime) →
  (∀ w w' : JesseMath.Physics.YangMillsRenormalizedObservableLimits.WilsonLoopSpace, (∀ ℓ ∈ S, w ℓ = w' ℓ) → F w = F w') →
  ∃ (a : ℚ) (ha : 0 < a) (B : JesseMath.Physics.YangMillsReconstructedGeneratorGap.OSVector L),
    (JesseMath.Physics.YangMillsReconstructedGeneratorGap.OSVector.translate L ha.le B).toBCF = F := by
  intro L S F hS hF
  obtain ⟨a, ha, hbound⟩ := finitePositiveTime_buffer S hS
  obtain ⟨B, hB⟩ := finiteCylinder_timeBufferFactorization L S F a ha hbound hF
  exact ⟨a, ha, B, hB⟩


section CompletedTransfer

variable (L : ReflectionPositiveLaw)
    (hτ : ∀ q : ℚ,
      (L.law : Measure WilsonLoopSpace).map
        (translateObservables (timeShift q)) = L.law)

theorem reconstructedTransfer_zero_of_invariant :
    reconstructedTransfer L (le_refl (0 : ℚ)) (hτ 0) =
      (1 : OSHilbert L →L[ℂ] OSHilbert L) := by
  ext x
  change reconstructedTransfer L (le_refl (0 : ℚ)) (hτ 0) x = x
  refine UniformSpace.Completion.induction_on x ?_ fun F => ?_
  · exact isClosed_eq
      (reconstructedTransfer L (le_refl (0 : ℚ)) (hτ 0)).continuous
      continuous_id
  · rw [reconstructedTransfer_coe]
    have hcore : OSVector.translate L (le_refl (0 : ℚ)) F = F := by
      apply OSVector.ext
      ext w
      change F.toBCF (translateObservables (timeShift 0) w) = F.toBCF w
      have hzero : timeShift (0 : ℚ) = 0 := by
        funext i
        simp [timeShift]
      rw [hzero, translateObservables_zero]
    exact congrArg (fun B : OSVector L => (B : OSHilbert L)) hcore

theorem reconstructedTransfer_add_of_invariant
    {s t : ℚ} (hs : 0 ≤ s) (ht : 0 ≤ t) :
    reconstructedTransfer L (add_nonneg hs ht) (hτ (s + t)) =
      (reconstructedTransfer L hs (hτ s)).comp
        (reconstructedTransfer L ht (hτ t)) := by
  ext x
  change reconstructedTransfer L (add_nonneg hs ht) (hτ (s + t)) x =
    reconstructedTransfer L hs (hτ s)
      (reconstructedTransfer L ht (hτ t) x)
  refine UniformSpace.Completion.induction_on x ?_ fun F => ?_
  · exact isClosed_eq
      (reconstructedTransfer L (add_nonneg hs ht) (hτ (s + t))).continuous
      ((reconstructedTransfer L hs (hτ s)).continuous.comp
        (reconstructedTransfer L ht (hτ t)).continuous)
  · rw [reconstructedTransfer_coe, reconstructedTransfer_coe,
      reconstructedTransfer_coe, OSVector.translate_translate]
    exact congrArg (fun B : OSVector L => (B : OSHilbert L))
      (OSVector.translate_eq_of_eq
        (add_nonneg hs ht) (add_nonneg ht hs) (add_comm s t) F)


end CompletedTransfer


theorem osVector_finite_positive_cylinder_approximation
    (L : ReflectionPositiveLaw) (F : OSVector L) :
    ∃ (S : ℕ → Finset PhysicalRectangle) (G : ℕ → OSVector L),
      (∀ n ℓ, ℓ ∈ S n → ℓ.IsPositiveTime) ∧
      (∀ n (w w' : WilsonLoopSpace),
        (∀ ℓ ∈ S n, w ℓ = w' ℓ) → (G n).toBCF w = (G n).toBCF w') ∧
      Tendsto (fun n => ‖G n - F‖) atTop (𝓝 0) := by
  classical
  obtain ⟨e, he⟩ := exists_surjective_nat PhysicalRectangle
  let S : ℕ → Finset PhysicalRectangle := fun N =>
    ((Finset.range N).image e).filter PhysicalRectangle.IsPositiveTime
  have hSA : ∀ N ℓ, ℓ ∈ S N → ℓ.IsPositiveTime := by
    intro N ℓ hℓ
    exact (Finset.mem_filter.mp hℓ).2
  let FN : ℕ → WilsonLoopSpace →ᵇ ℂ := fun N =>
    F.toBCF.compContinuous ⟨fun w => (S N : Set PhysicalRectangle).indicator w,
      continuous_indicator_loops _⟩
  have hFN : ∀ N (w w' : WilsonLoopSpace),
      (∀ ℓ ∈ S N, w ℓ = w' ℓ) → FN N w = FN N w' := by
    intro N w w' hw
    change F.toBCF ((S N : Set PhysicalRectangle).indicator w) =
      F.toBCF ((S N : Set PhysicalRectangle).indicator w')
    congr 1
    funext ℓ
    by_cases hℓ : ℓ ∈ (S N : Set PhysicalRectangle)
    · simp only [Set.indicator_of_mem hℓ, hw ℓ hℓ]
    · simp only [Set.indicator_of_notMem hℓ]
  have hlocal : ∀ N, PositiveTimeLocal (FN N) := by
    intro N w w' hw
    exact hFN N w w' (fun ℓ hℓ => hw ℓ (hSA N ℓ hℓ))
  let G : ℕ → OSVector L := fun N => OSVector.mk (FN N) (hlocal N)
  refine ⟨S, G, hSA, hFN, ?_⟩
  have hconv : ∀ w : WilsonLoopSpace,
      Tendsto (fun N => (S N : Set PhysicalRectangle).indicator w) atTop
        (𝓝 ({ℓ : PhysicalRectangle | ℓ.IsPositiveTime}.indicator w)) := by
    intro w
    rw [tendsto_pi_nhds]
    intro ℓ
    by_cases hℓ : ℓ ∈ {k : PhysicalRectangle | k.IsPositiveTime}
    · obtain ⟨k, rfl⟩ := he ℓ
      rw [Set.indicator_of_mem hℓ]
      apply tendsto_const_nhds.congr'
      filter_upwards [eventually_gt_atTop k] with N hN
      have hmem : e k ∈ (S N : Set PhysicalRectangle) := by
        simp only [S, Finset.coe_filter, Finset.mem_image, Finset.mem_range, Set.mem_ofPred_eq]
        exact ⟨⟨k, hN, rfl⟩, hℓ⟩
      rw [Set.indicator_of_mem hmem]
    · rw [Set.indicator_of_notMem hℓ]
      apply tendsto_const_nhds.congr'
      filter_upwards with N
      rw [Set.indicator_of_notMem (fun hmem => hℓ (hSA N ℓ hmem))]
  have hFind : ∀ w : WilsonLoopSpace,
      F.toBCF ({ℓ : PhysicalRectangle | ℓ.IsPositiveTime}.indicator w) = F.toBCF w := by
    intro w
    apply F.toBCF_mem
    intro ℓ hℓ
    rw [Set.indicator_of_mem (s := {k : PhysicalRectangle | k.IsPositiveTime}) hℓ]
  have hFconv : ∀ w : WilsonLoopSpace,
      Tendsto (fun N => FN N w) atTop (𝓝 (F.toBCF w)) := by
    intro w
    have h := (F.toBCF.continuous.tendsto _).comp (hconv w)
    rw [hFind] at h
    exact h
  have hdiff : ∀ w : WilsonLoopSpace,
      Tendsto (fun N => (G N - F).toBCF w) atTop (𝓝 (0 : ℂ)) := by
    intro w
    change Tendsto (fun N => FN N w - F.toBCF w) atTop (𝓝 0)
    simpa only [sub_self] using (hFconv w).sub
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => F.toBCF w) atTop (𝓝 (F.toBCF w)))
  have hlim : ∀ w : WilsonLoopSpace,
      Tendsto (fun N => osIntegrand (G N - F).toBCF (G N - F).toBCF w)
        atTop (𝓝 (0 : ℂ)) := by
    intro w
    change Tendsto (fun N => star ((G N - F).toBCF (reflectObservables w)) *
      (G N - F).toBCF w) atTop (𝓝 (0 : ℂ))
    have h := ((hdiff (reflectObservables w)).star).mul (hdiff w)
    simpa only [star_zero, zero_mul] using h
  have hbound : ∀ N, ∀ᵐ w ∂(L.law : Measure WilsonLoopSpace),
      ‖osIntegrand (G N - F).toBCF (G N - F).toBCF w‖ ≤
        (2 * ‖F.toBCF‖) * (2 * ‖F.toBCF‖) := by
    intro N
    have hd : ∀ w : WilsonLoopSpace, ‖(G N - F).toBCF w‖ ≤ 2 * ‖F.toBCF‖ := by
      intro w
      change ‖FN N w - F.toBCF w‖ ≤ 2 * ‖F.toBCF‖
      calc
        ‖FN N w - F.toBCF w‖ ≤ ‖FN N w‖ + ‖F.toBCF w‖ := norm_sub_le _ _
        _ ≤ ‖F.toBCF‖ + ‖F.toBCF‖ :=
          add_le_add (F.toBCF.norm_coe_le_norm _) (F.toBCF.norm_coe_le_norm _)
        _ = 2 * ‖F.toBCF‖ := by ring
    filter_upwards with w
    rw [osIntegrand_apply, norm_mul, RCLike.norm_conj]
    exact mul_le_mul (hd _) (hd _) (norm_nonneg _) (by positivity)
  have hmeas : ∀ N, AEStronglyMeasurable
      (fun w => osIntegrand (G N - F).toBCF (G N - F).toBCF w)
      (L.law : Measure WilsonLoopSpace) :=
    fun N => (osIntegrand (G N - F).toBCF (G N - F).toBCF).continuous.aestronglyMeasurable
  have hint := tendsto_integral_of_dominated_convergence
    (fun _ => (2 * ‖F.toBCF‖) * (2 * ‖F.toBCF‖)) hmeas
    (integrable_const _) hbound (Eventually.of_forall hlim)
  simp only [integral_zero] at hint
  have hsq : Tendsto (fun N => ‖G N - F‖ ^ 2) atTop (𝓝 0) := by
    have hre := Complex.continuous_re.tendsto 0 |>.comp hint
    simpa only [Function.comp_def, Complex.zero_re, OSVector.norm_sq_eq_osForm, osForm] using hre
  have hroot := Real.continuous_sqrt.tendsto 0 |>.comp hsq
  simpa only [Function.comp_def, Real.sqrt_sq_eq_abs, abs_norm, Real.sqrt_zero] using hroot




theorem osHilbert_positive_time_range_approximation
    (L : ReflectionPositiveLaw)
    (hτ : ∀ q : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift q)) = L.law)
    (u : OSHilbert L) (ε : ℝ) (hε : 0 < ε) :
    ∃ (a : ℚ) (ha : 0 < a) (v : OSHilbert L),
      ‖u - reconstructedTransfer L ha.le (hτ a) v‖ < ε := by
  obtain ⟨F, hF⟩ := UniformSpace.Completion.denseRange_coe.exists_dist_lt u (half_pos hε)
  obtain ⟨S, G, hS, hG, hlim⟩ := osVector_finite_positive_cylinder_approximation L F
  obtain ⟨N, hN⟩ := ((tendsto_order.mp hlim).2 (ε / 2) (half_pos hε)).exists
  obtain ⟨a, ha, B, hB⟩ := finitePositiveCylinder_timeBufferFactorization L (S N)
    (G N).toBCF (hS N) (hG N)
  have hcore : OSVector.translate L ha.le B = G N := OSVector.ext hB
  refine ⟨a, ha, (B : OSHilbert L), ?_⟩
  rw [reconstructedTransfer_coe, hcore]
  have hnear : ‖(F : OSHilbert L) - (G N : OSHilbert L)‖ < ε / 2 := by
    rw [← UniformSpace.Completion.coe_sub, UniformSpace.Completion.norm_coe, norm_sub_rev]
    exact hN
  have hfirst : ‖u - (F : OSHilbert L)‖ < ε / 2 := by
    simpa only [dist_eq_norm] using hF
  have htriangle := dist_triangle u (F : OSHilbert L) (G N : OSHilbert L)
  simp only [dist_eq_norm] at htriangle
  linarith

theorem reconstructedTransfer_stronglyContinuous_zero
    (L : ReflectionPositiveLaw)
    (hτ : ∀ q : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift q)) = L.law)
    (u : OSHilbert L) :
    Tendsto (fun q : ℚ => if hq : 0 ≤ q then reconstructedTransfer L hq (hτ q) u else u)
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 u) := by
  let T : ℚ → (OSHilbert L →L[ℂ] OSHilbert L) := fun q =>
    if hq : 0 ≤ q then reconstructedTransfer L hq (hτ q) else 1
  have hT : ∀ (q : ℚ) (hq : 0 ≤ q), T q = reconstructedTransfer L hq (hτ q) := by
    intro q hq
    simp only [T, dite_eq_left hq]
  have hzero : T 0 = 1 := by
    rw [hT 0 le_rfl]
    exact reconstructedTransfer_zero_of_invariant L hτ
  have hpos : ∀ q : ℚ, 0 ≤ q → 0 ≤ T q := by
    intro q hq
    rw [hT q hq]
    exact (reconstructedTransferOperator L hq (hτ (q / 2))).nonneg
  have hnorm : ∀ q : ℚ, 0 ≤ q → ‖T q‖ ≤ 1 := by
    intro q hq
    rw [hT q hq]
    exact (reconstructedTransferOperator L hq (hτ (q / 2))).norm_le_one
  have hadd : ∀ s t : ℚ, 0 ≤ s → 0 ≤ t → T (s + t) = T s * T t := by
    intro s t hs ht
    rw [hT (s + t) (add_nonneg hs ht), hT s hs, hT t ht]
    exact reconstructedTransfer_add_of_invariant L hτ hs ht
  have happrox : ∀ (v : OSHilbert L) (δ : ℝ), 0 < δ →
      ∃ a : ℚ, 0 < a ∧ ∃ w : OSHilbert L, ‖v - T a w‖ < δ := by
    intro v δ hδ
    obtain ⟨a, ha, w, hw⟩ := osHilbert_positive_time_range_approximation L hτ v δ hδ
    refine ⟨a, ha, w, ?_⟩
    rwa [hT a ha.le]
  have hresult := rationalTransfer_stronglyContinuous_of_bufferApproximation
    (OSHilbert L) T hzero hpos hnorm hadd happrox u
  have hfunc : (fun q : ℚ => T q u) =
      (fun q : ℚ => if hq : 0 ≤ q then reconstructedTransfer L hq (hτ q) u else u) := by
    funext q
    by_cases hq : 0 ≤ q <;> simp [T, hq]
  rwa [hfunc] at hresult

theorem wilsonLimitTransfer_stronglyContinuous_zero
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    (u : WilsonLimitHilbert P Z hP hZ R ν hν) :
    Tendsto (fun q : ℚ => if hq : 0 ≤ q then
      (wilsonLimitTransfer P Z hP hZ R ν hν hq).op u else u)
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 u) := by
  let L := wilsonLimitLaw P Z hP hZ R ν hν
  have hτ : ∀ q : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift q)) = L.law := by
    intro q
    exact congrArg (fun μ : ProbabilityMeasure WilsonLoopSpace => (μ : Measure WilsonLoopSpace))
      (R.translation_invariant ν hν (timeShift q))
  have h := reconstructedTransfer_stronglyContinuous_zero L hτ u
  convert h using 1
  funext q
  by_cases hq : 0 ≤ q
  · simp only [dite_eq_left hq]
    rfl
  · simp only [dite_eq_right hq]

end OSTimeContinuity


section OSTransferRange

open JesseMath.Physics.YangMillsOsterwalderSchraderInheritance

theorem reconstructedTransfer_injective
    (L : ReflectionPositiveLaw)
    (hτ : ∀ q : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift q)) = L.law)
    {s : ℚ} (hs : 0 < s) :
    Function.Injective (reconstructedTransfer L hs.le (hτ s)) := by
  let T : ℚ → (OSHilbert L →L[ℂ] OSHilbert L) := fun q =>
    if hq : 0 ≤ q then reconstructedTransfer L hq (hτ q) else 1
  have hT : ∀ (q : ℚ) (hq : 0 ≤ q),
      T q = reconstructedTransfer L hq (hτ q) := by
    intro q hq
    simp only [T, dite_eq_left hq]
  have hadd : ∀ r t : ℚ, 0 ≤ r → 0 ≤ t →
      T (r + t) = (T r).comp (T t) := by
    intro r t hr ht
    rw [hT (r + t) (add_nonneg hr ht), hT r hr, hT t ht]
    exact reconstructedTransfer_add_of_invariant L hτ hr ht
  have hhalf (r : ℚ) (hr : 0 < r) (u : OSHilbert L)
      (hu : T r u = 0) : T (r / 2) u = 0 := by
    have hr2 : 0 ≤ r / 2 := (half_pos hr).le
    have hsa : IsSelfAdjoint (T (r / 2)) := by
      rw [hT (r / 2) hr2]
      exact (reconstructedTransferOperator L hr2 (hτ ((r / 2) / 2))).isSelfAdjoint
    have hsum : r / 2 + r / 2 = r := by ring
    have hsquare : T r = (T (r / 2)).comp (T (r / 2)) := by
      simpa only [hsum] using hadd (r / 2) (r / 2) hr2 hr2
    have hk := (T (r / 2)).ker_adjoint_comp_self
    rw [hsa.adjoint_eq] at hk
    have hmem : u ∈ (T r).ker := hu
    rw [hsquare, hk] at hmem
    exact hmem
  have hker : ∀ u : OSHilbert L, T s u = 0 → u = 0 := by
    intro u hu
    let q : ℕ → ℚ := fun n => s * (1 / 2) ^ n
    have hqpos (n : ℕ) : 0 < q n :=
      mul_pos hs (pow_pos (by norm_num : (0 : ℚ) < 1 / 2) n)
    have hqsucc (n : ℕ) : q (n + 1) = q n / 2 := by
      dsimp [q]
      rw [pow_succ]
      ring
    have hzero : ∀ n, T (q n) u = 0 := by
      intro n
      induction n with
      | zero => simpa [q] using hu
      | succ n ih =>
        rw [hqsucc]
        exact hhalf (q n) (hqpos n) u ih
    have hlim0 : Tendsto q atTop (𝓝 (0 : ℚ)) := by
      simpa only [mul_zero] using
        (tendsto_pow_atTop_nhds_zero_of_lt_one
          (by norm_num : (0 : ℚ) ≤ 1 / 2)
          (by norm_num : (1 / 2 : ℚ) < 1)).const_mul s
    have hlim : Tendsto q atTop (nhdsWithin 0 (Set.Ioi 0)) :=
      tendsto_nhdsWithin_iff.mpr
        ⟨hlim0, Filter.Eventually.of_forall hqpos⟩
    have hc := (reconstructedTransfer_stronglyContinuous_zero L hτ u).comp hlim
    have heq : (fun n : ℕ =>
        if hq : 0 ≤ q n then reconstructedTransfer L hq (hτ (q n)) u else u) =
        (fun _ : ℕ => (0 : OSHilbert L)) := by
      funext n
      rw [dite_eq_left (hqpos n).le, ← hT (q n) (hqpos n).le]
      exact hzero n
    simp only [Function.comp_def] at hc
    rw [heq] at hc
    exact tendsto_nhds_unique hc tendsto_const_nhds
  apply (LinearMap.ker_eq_bot).mp
  apply (LinearMap.ker_eq_bot').mpr
  intro u hu
  apply hker u
  rwa [hT s hs.le]

theorem reconstructedTransfer_denseRange
    (L : ReflectionPositiveLaw)
    (hτ : ∀ q : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift q)) = L.law)
    {s : ℚ} (hs : 0 < s) :
    DenseRange (reconstructedTransfer L hs.le (hτ s)) := by
  let S := reconstructedTransfer L hs.le (hτ s)
  have hsa : IsSelfAdjoint S :=
    (reconstructedTransferOperator L hs.le (hτ (s / 2))).isSelfAdjoint
  have hk : S.ker = ⊥ := LinearMap.ker_eq_bot.mpr
    (reconstructedTransfer_injective L hτ hs)
  change Dense (S.range : Set (OSHilbert L))
  rw [Submodule.dense_iff_topologicalClosure_eq_top,
    Submodule.topologicalClosure_eq_top_iff,
    S.orthogonal_range, hsa.adjoint_eq]
  exact hk

theorem wilsonLimitTransfer_injective_and_denseRange
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s : ℚ} (hs : 0 < s) :
    Function.Injective (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op ∧
      DenseRange (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op := by
  let L := wilsonLimitLaw P Z hP hZ R ν hν
  have hτ : ∀ q : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift q)) = L.law := by
    intro q
    exact congrArg (fun μ : ProbabilityMeasure WilsonLoopSpace => (μ : Measure WilsonLoopSpace))
      (R.translation_invariant ν hν (timeShift q))
  exact ⟨reconstructedTransfer_injective L hτ hs,
    reconstructedTransfer_denseRange L hτ hs⟩

namespace PositiveTransferOperator

theorem continuousOn_resolventKernel {a : ℝ} (ha : 0 < a) :
    ContinuousOn (resolventKernel a) (Set.Icc 0 1) := by
  intro x hx
  by_cases hx0 : x = 0
  · subst x
    have hdiv : Tendsto (fun x : ℝ => Real.log x / a)
        (𝓝[>] (0 : ℝ)) atBot :=
      Real.tendsto_log_nhdsGT_zero.atBot_div_const ha
    have hneg : Tendsto (fun x : ℝ => -(Real.log x / a))
        (𝓝[>] (0 : ℝ)) atTop := tendsto_neg_atBot_atTop.comp hdiv
    have hden : Tendsto (fun x : ℝ => 1 - Real.log x / a)
        (𝓝[>] (0 : ℝ)) atTop := by
      simpa only [sub_eq_add_neg] using
        (tendsto_atTop_add_const_left (𝓝[>] (0 : ℝ)) (1 : ℝ) hneg)
    have hinv : Tendsto (fun x : ℝ => (1 - Real.log x / a)⁻¹)
        (𝓝[>] (0 : ℝ)) (𝓝 0) := hden.inv_tendsto_atTop
    have hkernel : Tendsto (resolventKernel a)
        (𝓝[>] (0 : ℝ)) (𝓝 0) := by
      apply hinv.congr'
      filter_upwards [self_mem_nhdsWithin] with y hy
      simp only [Set.mem_Ioi] at hy
      simp [resolventKernel, not_le.mpr hy]
    have hright : ContinuousWithinAt (resolventKernel a) (Set.Ioi 0) 0 := by
      simpa only [ContinuousWithinAt, resolventKernel_zero] using hkernel
    have hclosed : ContinuousWithinAt (resolventKernel a) (Set.Ici 0) 0 :=
      continuousWithinAt_Ioi_iff_Ici.mp hright
    exact hclosed.mono (fun _ hy => hy.1)
  · have hxpos : 0 < x := lt_of_le_of_ne hx.1 (Ne.symm hx0)
    have hlog : Real.log x ≤ 0 := Real.log_nonpos hx.1 hx.2
    have hdiv : Real.log x / a ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg hlog ha.le
    have hden : 1 - Real.log x / a ≠ 0 := by linarith
    have hc : ContinuousAt (fun y : ℝ => (1 - Real.log y / a)⁻¹) x :=
      (continuousAt_const.sub
        ((Real.continuousAt_log hxpos.ne').div_const a)).inv₀ hden
    have heq : resolventKernel a =ᶠ[𝓝 x]
        (fun y : ℝ => (1 - Real.log y / a)⁻¹) := by
      filter_upwards [Ioi_mem_nhds hxpos] with y hy
      simp only [Set.mem_Ioi] at hy
      simp [resolventKernel, not_le.mpr hy]
    exact (hc.congr_of_eventuallyEq heq).continuousWithinAt

theorem mul_resolventKernel_recover {a x : ℝ} (ha : 0 < a)
    (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    (x - x * Real.log x / a) * resolventKernel a x = x := by
  by_cases hx0 : x = 0
  · subst x
    simp
  · have hxpos : 0 < x := lt_of_le_of_ne hx.1 (Ne.symm hx0)
    have hlog : Real.log x ≤ 0 := Real.log_nonpos hx.1 hx.2
    have hdiv : Real.log x / a ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg hlog ha.le
    have hden : 1 - Real.log x / a ≠ 0 := by linarith
    rw [resolventKernel, ite_eq_right (not_le.mpr hxpos)]
    calc
      (x - x * Real.log x / a) * (1 - Real.log x / a)⁻¹ =
          (x * (1 - Real.log x / a)) * (1 - Real.log x / a)⁻¹ := by ring
      _ = x := by rw [mul_assoc, mul_inv_cancel₀ hden, mul_one]

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem cfc_resolvent_recover_transfer (S : PositiveTransferOperator H)
    {a : ℝ} (ha : 0 < a) :
    cfc (fun x : ℝ => x - x * Real.log x / a) S.op * S.resolventMinusOne a = S.op := by
  have hg : ContinuousOn (fun x : ℝ => x - x * Real.log x / a) (spectrum ℝ S.op) :=
    (continuous_id.sub (Real.continuous_mul_log.div_const a)).continuousOn
  have hr : ContinuousOn (resolventKernel a) (spectrum ℝ S.op) :=
    (continuousOn_resolventKernel ha).mono S.spectrum_op_subset_Icc
  calc
    cfc (fun x : ℝ => x - x * Real.log x / a) S.op * S.resolventMinusOne a =
        cfc (fun x : ℝ => (x - x * Real.log x / a) * resolventKernel a x) S.op := by
      exact (cfc_mul (fun x : ℝ => x - x * Real.log x / a)
        (resolventKernel a) S.op hg hr).symm
    _ = cfc (fun x : ℝ => x) S.op :=
      cfc_congr (fun x hx => mul_resolventKernel_recover ha (S.spectrum_op_subset_Icc hx))
    _ = S.op := cfc_id' ℝ S.op S.isSelfAdjoint

theorem resolventMinusOne_injective (S : PositiveTransferOperator H)
    {a : ℝ} (ha : 0 < a) (hS : Function.Injective S.op) :
    Function.Injective (S.resolventMinusOne a) := by
  intro u v huv
  apply hS
  let B : H →L[ℂ] H := cfc (fun x : ℝ => x - x * Real.log x / a) S.op
  have h := congrArg (fun w : H => B w) huv
  change (cfc (fun x : ℝ => x - x * Real.log x / a) S.op * S.resolventMinusOne a) u =
    (cfc (fun x : ℝ => x - x * Real.log x / a) S.op * S.resolventMinusOne a) v at h
  rwa [S.cfc_resolvent_recover_transfer ha] at h

theorem resolventMinusOne_denseRange (S : PositiveTransferOperator H)
    {a : ℝ} (ha : 0 < a) (hS : Function.Injective S.op) :
    DenseRange (S.resolventMinusOne a) := by
  have hk : (S.resolventMinusOne a).ker = ⊥ := LinearMap.ker_eq_bot.mpr
    (S.resolventMinusOne_injective ha hS)
  change Dense ((S.resolventMinusOne a).range : Set H)
  rw [Submodule.dense_iff_topologicalClosure_eq_top,
    Submodule.topologicalClosure_eq_top_iff,
    (S.resolventMinusOne a).orthogonal_range,
    (S.resolventMinusOne_selfAdjoint a).adjoint_eq]
  exact hk

end PositiveTransferOperator

theorem wilsonLimitResolventMinusOne_injective_and_denseRange
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s : ℚ} (hs : 0 < s) :
    Function.Injective
      ((wilsonLimitTransfer P Z hP hZ R ν hν hs.le).resolventMinusOne (s : ℝ)) ∧
      DenseRange
        ((wilsonLimitTransfer P Z hP hZ R ν hν hs.le).resolventMinusOne (s : ℝ)) := by
  have ha : 0 < (s : ℝ) := by exact_mod_cast hs
  have hS := (wilsonLimitTransfer_injective_and_denseRange P Z hP hZ R ν hν hs).1
  exact ⟨(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).resolventMinusOne_injective ha hS,
    (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).resolventMinusOne_denseRange ha hS⟩

end OSTransferRange

