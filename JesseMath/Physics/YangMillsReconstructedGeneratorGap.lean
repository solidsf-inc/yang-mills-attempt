  rw [h_pt,
      integral_gaugeHaarMeasure_add_of_continuous
        (fun U => H U * sideBridge L β k U * ΦB U * ΦT U +
          (H U * (Real.exp (β * botWingCharSum L k U) - 1) * ΦB U) * ΦT U)
        (fun U => (H U * Real.exp (β * topWingCharSum L k U) * ΦT U) * ΦB U)
        (((hH_cont.mul (continuous_sideBridge β k)).mul hΦB_cont).mul hΦT_cont |>.add
          (((hH_cont.mul ((Real.continuous_exp.comp (continuous_const.mul (continuous_botWingCharSum k))).sub
            continuous_const)).mul hΦB_cont).mul hΦT_cont))
        (((hH_cont.mul (Real.continuous_exp.comp (continuous_const.mul (continuous_topWingCharSum k)))).mul
          hΦT_cont).mul hΦB_cont),
      integral_gaugeHaarMeasure_add_of_continuous
        (fun U => H U * sideBridge L β k U * ΦB U * ΦT U)
        (fun U => (H U * (Real.exp (β * botWingCharSum L k U) - 1) * ΦB U) * ΦT U)
        (((hH_cont.mul (continuous_sideBridge β k)).mul hΦB_cont).mul hΦT_cont)
        (((hH_cont.mul ((Real.continuous_exp.comp (continuous_const.mul (continuous_botWingCharSum k))).sub
          continuous_const)).mul hΦB_cont).mul hΦT_cont),
