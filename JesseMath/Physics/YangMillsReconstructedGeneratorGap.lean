/-- Updating a single link `e ∉ latticePathSupport L x p` leaves `wilsonLoop V x p` invariant. -/
theorem wilsonLoop_updateGaugeLink_eq_of_not_mem {L : ℕ}
    (V : GaugeConfig L) (x : Lattice4D L) (p : List LatticeStep)
    {e : Link L} (h_not_mem : e ∉ latticePathSupport L x p) (g : SU2) :
    wilsonLoop (updateGaugeLink L V e.x e.μ g) x p = wilsonLoop V x p := by
  unfold wilsonLoop
  change halfTraceRe (pathHolonomy (updateGroupGaugeLink L V e.x e.μ g) x p) =
    halfTraceRe (pathHolonomy V x p)
  rw [pathHolonomy_updateGroupGaugeLink_eq_of_not_mem V e g x p h_not_mem]

/-- Updating the same link twice overwrites the first update:
`updateTwoGaugeLinks L V e.x e.μ g1 e.x e.μ h = updateGaugeLink L V e.x e.μ h`. -/
theorem updateTwoGaugeLinks_same_link {L : ℕ}
    (V : GaugeConfig L) (e : Link L) (g h : SU2) :
    updateTwoGaugeLinks L V e.x e.μ g e.x e.μ h = updateGaugeLink L V e.x e.μ h := by
  funext f
  by_cases hf : f = e
  · subst hf
    exact ((updateGroupGaugeLink_same_and_other L
      (updateGroupGaugeLink L V f.x f.μ g) f.x f.μ h).1).trans
      ((updateGroupGaugeLink_same_and_other L V f.x f.μ h).1).symm
  · have h1 := (updateGroupGaugeLink_same_and_other L
      (updateGroupGaugeLink L V e.x e.μ g) e.x e.μ h).2 f hf
    have h2 := (updateGroupGaugeLink_same_and_other L V e.x e.μ g).2 f hf
    have h3 := (updateGroupGaugeLink_same_and_other L V e.x e.μ h).2 f hf
    exact (h1.trans h2).trans h3.symm

/-- Vanishing of `twoLinkMixedDifference` on `wilsonLoop · x p` when the second link
`e' ∉ latticePathSupport L x p`. -/
theorem twoLinkMixedDifference_wilsonLoop_eq_zero_of_not_mem_right {L : ℕ}
    (V : GaugeConfig L) (x : Lattice4D L) (p : List LatticeStep)
    (e e' : Link L) (h_not_mem : e' ∉ latticePathSupport L x p)
    (g1 g2 h1 h2 : SU2) :
    twoLinkMixedDifference L (fun W => wilsonLoop W x p) V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0 := by
  refine (twoLinkMixedDifference_eq_zero_of_independent_and_oscillation_bound
    L (fun W => wilsonLoop W x p) V e.x e.μ g1 g2 e'.x e'.μ h1 h2).1 fun W => ?_
  rw [wilsonLoop_updateGaugeLink_eq_of_not_mem W x p h_not_mem h1,
    wilsonLoop_updateGaugeLink_eq_of_not_mem W x p h_not_mem h2]

/-- Vanishing of `twoLinkMixedDifference` on `wilsonLoop · x p` when the first link
`e ∉ latticePathSupport L x p`. -/
theorem twoLinkMixedDifference_wilsonLoop_eq_zero_of_not_mem_left {L : ℕ}
    (V : GaugeConfig L) (x : Lattice4D L) (p : List LatticeStep)
    (e e' : Link L) (h_not_mem : e ∉ latticePathSupport L x p)
    (g1 g2 h1 h2 : SU2) :
    twoLinkMixedDifference L (fun W => wilsonLoop W x p) V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0 := by
  by_cases h_eq : e = e'
  · subst h_eq
    dsimp [twoLinkMixedDifference]
    rw [updateTwoGaugeLinks_same_link V e g1 h1, updateTwoGaugeLinks_same_link V e g2 h1,
      updateTwoGaugeLinks_same_link V e g1 h2, updateTwoGaugeLinks_same_link V e g2 h2]
    ring
  · have h_comm (g h : SU2) :
        updateTwoGaugeLinks L V e.x e.μ g e'.x e'.μ h =
          updateGaugeLink L (updateGaugeLink L V e'.x e'.μ h) e.x e.μ g :=
      updateGroupGaugeLink_comm L V h_eq g h
    dsimp [twoLinkMixedDifference]
    rw [h_comm g1 h1, h_comm g2 h1, h_comm g1 h2, h_comm g2 h2,
      wilsonLoop_updateGaugeLink_eq_of_not_mem _ x p h_not_mem g1,
      wilsonLoop_updateGaugeLink_eq_of_not_mem _ x p h_not_mem g2,
      wilsonLoop_updateGaugeLink_eq_of_not_mem _ x p h_not_mem g1,
      wilsonLoop_updateGaugeLink_eq_of_not_mem _ x p h_not_mem g2]
    ring

/-- Uniform bound `|twoLinkMixedDifference L (fun W => 1 - wilsonLoop W x p) V ...| ≤ 4` for any
closed or open lattice path `p`. -/
theorem twoLinkMixedDifference_one_sub_wilsonLoop_abs_le_four {L : ℕ}
    (V : GaugeConfig L) (x : Lattice4D L) (p : List LatticeStep)
    (e e' : Link L) (g1 g2 h1 h2 : SU2) :
    |twoLinkMixedDifference L (fun W => 1 - wilsonLoop W x p)
      V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 4 := by
  have h_w (W : GaugeConfig L) : -1 ≤ wilsonLoop W x p ∧ wilsonLoop W x p ≤ 1 :=
    halfTraceRe_mem_Icc (pathHolonomy W x p)
  have h11 := h_w (updateTwoGaugeLinks L V e.x e.μ g1 e'.x e'.μ h1)
  have h21 := h_w (updateTwoGaugeLinks L V e.x e.μ g2 e'.x e'.μ h1)
  have h12 := h_w (updateTwoGaugeLinks L V e.x e.μ g1 e'.x e'.μ h2)
  have h22 := h_w (updateTwoGaugeLinks L V e.x e.μ g2 e'.x e'.μ h2)
  dsimp [twoLinkMixedDifference]
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Support-localized bound on the two-link mixed derivative of any multi-loop polymer activity
family `P : PolymerActivityFamily L`: only polymer loops `i : P.idx` whose link support
`latticePathSupport L (P.bases i) (P.loops i)` contains both `e` and `e'` contribute to
`twoLinkMixedDifference L P.eval V e.x e.μ g1 g2 e'.x e'.μ h1 h2`. -/
theorem PolymerActivityFamily.abs_twoLinkMixedDifference_eval_le_sum_support
    {L : ℕ} [NeZero L] (P : PolymerActivityFamily L)
    (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2) :
    |twoLinkMixedDifference L P.eval V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
      ∑ i : P.idx,
        if e ∈ latticePathSupport L (P.bases i) (P.loops i) ∧
           e' ∈ latticePathSupport L (P.bases i) (P.loops i) then
          4 * |P.weights i|
        else 0 := by
  classical
  have h_decomp :
      twoLinkMixedDifference L P.eval V e.x e.μ g1 g2 e'.x e'.μ h1 h2 =
        ∑ i : P.idx,
          P.weights i *
            twoLinkMixedDifference L (fun W => 1 - wilsonLoop W (P.bases i) (P.loops i))
              V e.x e.μ g1 g2 e'.x e'.μ h1 h2 := by
    dsimp [PolymerActivityFamily.eval, twoLinkMixedDifference]
    rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  rw [h_decomp]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  by_cases h_both :
      e ∈ latticePathSupport L (P.bases i) (P.loops i) ∧
        e' ∈ latticePathSupport L (P.bases i) (P.loops i)
  · simp only [h_both, and_self, ↓reduceIte, abs_mul]
    have h4 :=
      twoLinkMixedDifference_one_sub_wilsonLoop_abs_le_four
        V (P.bases i) (P.loops i) e e' g1 g2 h1 h2
    linarith [mul_le_mul_of_nonneg_left h4 (abs_nonneg (P.weights i))]
  · simp only [h_both, ↓reduceIte]
    have h_zero :
        twoLinkMixedDifference L (fun W => 1 - wilsonLoop W (P.bases i) (P.loops i))
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0 := by
      have h_neg :
          twoLinkMixedDifference L (fun W => 1 - wilsonLoop W (P.bases i) (P.loops i))
            V e.x e.μ g1 g2 e'.x e'.μ h1 h2 =
          -twoLinkMixedDifference L (fun W => wilsonLoop W (P.bases i) (P.loops i))
            V e.x e.μ g1 g2 e'.x e'.μ h1 h2 := by
        dsimp [twoLinkMixedDifference]
        ring
      rw [h_neg, neg_eq_zero]
      by_cases he : e ∈ latticePathSupport L (P.bases i) (P.loops i)
      · have he' : e' ∉ latticePathSupport L (P.bases i) (P.loops i) :=
          fun he' => h_both ⟨he, he'⟩
        exact twoLinkMixedDifference_wilsonLoop_eq_zero_of_not_mem_right
          V (P.bases i) (P.loops i) e e' he' g1 g2 h1 h2
      · exact twoLinkMixedDifference_wilsonLoop_eq_zero_of_not_mem_left
          V (P.bases i) (P.loops i) e e' he g1 g2 h1 h2
    rw [h_zero, mul_zero, abs_zero]

/-- Exponential link-distance decay of `twoLinkMixedDifference L P.eval` from tree-length
exponential polymer weight decay: if every loop `i : P.idx` has link-support diameter bounded by
its step length `(P.loops i).length` in `distLink` and satisfies
`4 * |P.weights i| ≤ w₀ i * Real.exp (-κ * ((P.loops i).length : ℝ))` with `0 ≤ κ` and `0 ≤ w₀ i`,
then `|twoLinkMixedDifference L P.eval V e.x e.μ g1 g2 e'.x e'.μ h1 h2|` decays exponentially as
`exp(-κ * distLink e e')`. -/
theorem PolymerActivityFamily.abs_twoLinkMixedDifference_eval_le_exp_treeLength
    {L : ℕ} [NeZero L] (P : PolymerActivityFamily L)
    (distLink : Link L → Link L → ℕ)
    (w₀ : P.idx → ℝ) {κ : ℝ} (hκ : 0 ≤ κ)
    (hw₀ : ∀ i : P.idx, 0 ≤ w₀ i)
    (h_diam : ∀ (i : P.idx) {e e' : Link L},
      e ∈ latticePathSupport L (P.bases i) (P.loops i) →
      e' ∈ latticePathSupport L (P.bases i) (P.loops i) →
      distLink e e' ≤ (P.loops i).length)
    (h_weight_exp : ∀ i : P.idx,
      4 * |P.weights i| ≤ w₀ i * Real.exp (-κ * ((P.loops i).length : ℝ)))
    (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2) :
    |twoLinkMixedDifference L P.eval V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
      (∑ i : P.idx,
        if e ∈ latticePathSupport L (P.bases i) (P.loops i) ∧
           e' ∈ latticePathSupport L (P.bases i) (P.loops i) then
          w₀ i
        else 0) * Real.exp (-κ * (distLink e e' : ℝ)) := by
  classical
  have h_supp := P.abs_twoLinkMixedDifference_eval_le_sum_support V e e' g1 g2 h1 h2
  rw [Finset.sum_mul]
  refine h_supp.trans (Finset.sum_le_sum fun i _ => ?_)
  by_cases h_both :
      e ∈ latticePathSupport L (P.bases i) (P.loops i) ∧
        e' ∈ latticePathSupport L (P.bases i) (P.loops i)
  · simp only [h_both, and_self, ↓reduceIte]
    have h_le_len : (distLink e e' : ℝ) ≤ ((P.loops i).length : ℝ) :=
      Nat.cast_le.mpr (h_diam i h_both.1 h_both.2)
    have h_exp_le :
        Real.exp (-κ * ((P.loops i).length : ℝ)) ≤ Real.exp (-κ * (distLink e e' : ℝ)) :=
      Real.exp_le_exp.mpr (by nlinarith)
    exact (h_weight_exp i).trans (mul_le_mul_of_nonneg_left h_exp_le (hw₀ i))
  · simp [h_both]

/-- Local single-link oscillation bound for a polymer activity family `P`:
when link `e` is updated from `g1` to `g2`, only polymer loops `i : P.idx` whose support
`latticePathSupport L (P.bases i) (P.loops i)` contains `e` can change, contributing at most
`2 * |P.weights i|` each (since `1 - wilsonLoop W (P.bases i) (P.loops i) ∈ [0, 2]`). -/
theorem PolymerActivityFamily.abs_singleLink_osc_le_sum_support {L : ℕ} [NeZero L]
    (P : PolymerActivityFamily L) (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2) :
    |P.eval (updateGaugeLink L V e.x e.μ g1) - P.eval (updateGaugeLink L V e.x e.μ g2)| ≤
      ∑ i : P.idx,
        if e ∈ latticePathSupport L (P.bases i) (P.loops i) then
          2 * |P.weights i|
        else 0 := by
  classical
  dsimp [PolymerActivityFamily.eval]
  rw [← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  have h_sub :
      P.weights i * (1 - wilsonLoop (updateGaugeLink L V e.x e.μ g1) (P.bases i) (P.loops i)) -
        P.weights i * (1 - wilsonLoop (updateGaugeLink L V e.x e.μ g2) (P.bases i) (P.loops i)) =
      P.weights i *
        (wilsonLoop (updateGaugeLink L V e.x e.μ g2) (P.bases i) (P.loops i) -
          wilsonLoop (updateGaugeLink L V e.x e.μ g1) (P.bases i) (P.loops i)) := by ring
  rw [h_sub, abs_mul]
  by_cases he : e ∈ latticePathSupport L (P.bases i) (P.loops i)
  · simp only [he, ↓reduceIte]
    have h_w2 :
        |wilsonLoop (updateGaugeLink L V e.x e.μ g2) (P.bases i) (P.loops i) -
          wilsonLoop (updateGaugeLink L V e.x e.μ g1) (P.bases i) (P.loops i)| ≤ 2 := by
      have h1 := halfTraceRe_mem_Icc
        (pathHolonomy (updateGaugeLink L V e.x e.μ g1) (P.bases i) (P.loops i))
      have h2 := halfTraceRe_mem_Icc
        (pathHolonomy (updateGaugeLink L V e.x e.μ g2) (P.bases i) (P.loops i))
      change _ ∈ Set.Icc (-1 : ℝ) 1 at h1 h2
      rw [abs_le]
      unfold wilsonLoop
      exact ⟨by linarith [h1.2, h2.1], by linarith [h1.1, h2.2]⟩
    nlinarith [abs_nonneg (P.weights i)]
  · simp only [he, ↓reduceIte]
    have h_eq1 :
        wilsonLoop (updateGaugeLink L V e.x e.μ g1) (P.bases i) (P.loops i) =
          wilsonLoop V (P.bases i) (P.loops i) :=
      wilsonLoop_updateGaugeLink_eq_of_not_mem V (P.bases i) (P.loops i) he g1
    have h_eq2 :
        wilsonLoop (updateGaugeLink L V e.x e.μ g2) (P.bases i) (P.loops i) =
          wilsonLoop V (P.bases i) (P.loops i) :=
      wilsonLoop_updateGaugeLink_eq_of_not_mem V (P.bases i) (P.loops i) he g2
    rw [h_eq1, h_eq2, sub_self, abs_zero, mul_zero]

/-- Volume-independent local row-sum bound for a polymer activity family `P`:
exchanging the sum over `e' ∈ Finset.univ.erase e` and the sum over `i : P.idx` shows that the
Dobrushin row sum of two-link support indicators at link `e` is bounded purely by the local sum over
loops incident to `e`, weighted by loop length `(P.loops i).length` — with **zero** factor of
`Fintype.card (Link L)`. -/
theorem PolymerActivityFamily.rowSum_support_mixedDifference_le_sum_incident_length
    {L : ℕ} [NeZero L] (P : PolymerActivityFamily L)
    (w : P.idx → ℝ) (hw : ∀ i : P.idx, 0 ≤ w i) (e : Link L) :
    (∑ e' ∈ (Finset.univ : Finset (Link L)).erase e,
      ∑ i : P.idx,
        if e ∈ latticePathSupport L (P.bases i) (P.loops i) ∧
           e' ∈ latticePathSupport L (P.bases i) (P.loops i) then
          w i
        else 0) ≤
      ∑ i : P.idx,
        if e ∈ latticePathSupport L (P.bases i) (P.loops i) then
          ((P.loops i).length : ℝ) * w i
        else 0 := by
  classical
  rw [Finset.sum_comm]
  refine Finset.sum_le_sum fun i _ => ?_
  by_cases he : e ∈ latticePathSupport L (P.bases i) (P.loops i)
  · simp only [he, true_and, ↓reduceIte]
    have h_sub :
        (∑ e' ∈ (Finset.univ : Finset (Link L)).erase e,
          if e' ∈ latticePathSupport L (P.bases i) (P.loops i) then w i else 0) ≤
        ∑ e' ∈ latticePathSupport L (P.bases i) (P.loops i), w i := by
      rw [← Finset.sum_filter]
      refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun _ _ _ => hw i)
      intro e' he'
      exact (Finset.mem_filter.mp he').2
    rw [Finset.sum_const, nsmul_eq_mul] at h_sub
    have h_card :
        ((latticePathSupport L (P.bases i) (P.loops i)).card : ℝ) ≤ ((P.loops i).length : ℝ) :=
      Nat.cast_le.mpr (card_latticePathSupport_le_length L (P.bases i) (P.loops i))
    exact h_sub.trans (mul_le_mul_of_nonneg_right h_card (hw i))
  · simp [he]

/-- Local, volume-independent `PolymerDobrushinNormBound` theorem:
if for every link `e : Link L`, the local incident-loop sum
`∑ i : P.idx, if e ∈ latticePathSupport L (P.bases i) (P.loops i) then ((P.loops i).length : ℝ) * (4 * |P.weights i|) else 0`
is bounded by `η ≥ 0`, then `PolymerDobrushinNormBound P η` holds unconditionally without any
lattice-volume factor `Fintype.card (Link L)`. -/
theorem PolymerActivityFamily.polymerDobrushinNormBound_of_local_support
    {L : ℕ} [NeZero L] (P : PolymerActivityFamily L) {η : ℝ} (hη : 0 ≤ η)
    (h_local : ∀ e : Link L,
      (∑ i : P.idx,
        if e ∈ latticePathSupport L (P.bases i) (P.loops i) then
          ((P.loops i).length : ℝ) * (4 * |P.weights i|)
        else 0) ≤ η) :
    PolymerDobrushinNormBound P η := by
  classical
  refine ⟨hη, ?_,
    fun e e' =>
      ∑ i : P.idx,
        if e ∈ latticePathSupport L (P.bases i) (P.loops i) ∧
           e' ∈ latticePathSupport L (P.bases i) (P.loops i) then
          4 * |P.weights i|
        else 0,
    fun e e' => Finset.sum_nonneg fun i _ => by
      split_ifs
      · positivity
      · exact le_rfl,
    fun V e e' g1 g2 h1 h2 => P.abs_twoLinkMixedDifference_eval_le_sum_support V e e' g1 g2 h1 h2,
    fun e =>
      (P.rowSum_support_mixedDifference_le_sum_incident_length
        (fun i => 4 * |P.weights i|) (fun i => by positivity) e).trans (h_local e)⟩
  intro V e g1 g2
  refine (P.abs_singleLink_osc_le_sum_support V e g1 g2).trans ?_
  refine (Finset.sum_le_sum fun i _ => ?_).trans (h_local e)
  by_cases he : e ∈ latticePathSupport L (P.bases i) (P.loops i)
  · simp only [he, ↓reduceIte]
    have h_len_pos : 1 ≤ (P.loops i).length := by
      cases h_list : P.loops i with
      | nil =>
          rw [h_list, latticePathSupport] at he
          exact False.elim (Finset.notMem_empty e he)
      | cons _ _ =>
          simp
    have h_len_real : (1 : ℝ) ≤ ((P.loops i).length : ℝ) := Nat.one_le_cast.mpr h_len_pos
    nlinarith [abs_nonneg (P.weights i)]
  · simp [he]

/-- Concrete, non-empty local plaquette polymer family on `(ℤ/Lℤ)^4` indexed by all oriented
plaquettes `p : Plaquette L` (`6 * L^4` loops of length `4`) with uniform per-plaquette weight `w`:
evaluates identically to `wilsonAction w V` (`eval_localPlaquette_eq_wilsonAction`) and satisfies a
volume-independent `PolymerDobrushinNormBound` controlled only by the local link-plaquette incidence
count (`≤ 6` plaquettes per link) and the Dobrushin neighbor count (`18` neighbors per link). -/
def PolymerActivityFamily.localPlaquette (L : ℕ) [NeZero L] (w : ℝ) : PolymerActivityFamily L where
  idx := Plaquette L
  bases := fun p => p.x
  loops := fun p => rectangleSteps p.μ p.ν 1 1
  weights := fun _ => w
  h_closed := fun p => pathTarget_rectangleSteps p.x p.μ p.ν 1 1

theorem PolymerActivityFamily.localPlaquette_card_idx_pos (L : ℕ) [NeZero L] (w : ℝ) :
    0 < Fintype.card (PolymerActivityFamily.localPlaquette L w).idx := by
  dsimp [PolymerActivityFamily.localPlaquette]
  exact Fintype.card_pos_iff.mpr ⟨(⟨0, 0, 1, by decide⟩ : Plaquette L)⟩

theorem PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction {L : ℕ} [NeZero L]
    (w : ℝ) (V : GaugeConfig L) :
    (PolymerActivityFamily.localPlaquette L w).eval V = wilsonAction w V := by
  dsimp [PolymerActivityFamily.localPlaquette, PolymerActivityFamily.eval, wilsonAction]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [wilsonLoop_rectangleSteps_one_one]
  ring

/-- Unconditional, volume-independent `PolymerDobrushinNormBound` for the concrete non-empty local
plaquette polymer family `PolymerActivityFamily.localPlaquette L w`: for every torus size `L ≥ 1`
and `w ≥ 0`, `PolymerDobrushinNormBound (PolymerActivityFamily.localPlaquette L w) (18 * (2 * (24 * w)))`
holds with **zero** factor of `Fintype.card (Link L)`. -/
theorem PolymerActivityFamily.polymerDobrushinNormBound_localPlaquette
    (L : ℕ) [NeZero L] {w : ℝ} (hw : 0 ≤ w) :
    PolymerDobrushinNormBound (PolymerActivityFamily.localPlaquette L w) (18 * (2 * (24 * w))) := by
  classical
  refine ⟨by linarith, ?_,
    fun e e' => if e' ∈ dobrushinNeighbors e then 2 * (24 * w) else 0,
    fun e e' => by
      dsimp only
      split_ifs
      · linarith
      · exact le_rfl,
    ?_,
    fun e => ?_⟩
  · intro V e g1 g2
    rw [PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction,
      PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction]
    have h_osc := wilsonAction_singleLink_oscillation_le L hw V e.x e.μ g1 g2
    linarith
  · intro V e e' g1 g2 h1 h2
    have h_eval : (PolymerActivityFamily.localPlaquette L w).eval = wilsonAction w := by
      funext U
      exact PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction w U
    rw [h_eval]
    by_cases h_mem : e' ∈ dobrushinNeighbors e
    · simp only [h_mem, ↓reduceIte]
      have h_re :
          twoLinkMixedDifference L (wilsonAction w) V e.x e.μ g1 g2 e'.x e'.μ h1 h2 =
            (wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h1) -
              wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h2)) -
            (wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h1) -
              wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h2)) := by
        dsimp [twoLinkMixedDifference, updateTwoGaugeLinks]
        ring
      have h_tri := abs_sub
        (wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h1) -
          wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h2))
        (wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h1) -
          wilsonAction w (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h2))
      rw [← h_re] at h_tri
      have h1_osc := wilsonAction_singleLink_oscillation_le L hw
        (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h1 h2
      have h2_osc := wilsonAction_singleLink_oscillation_le L hw
        (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h1 h2
      linarith
    · simp only [h_mem, ↓reduceIte]
      by_cases h_eq : e' = e
      · subst h_eq
        have h_zero :
            twoLinkMixedDifference L (wilsonAction w) V e'.x e'.μ g1 g2 e'.x e'.μ h1 h2 = 0 := by
          dsimp [twoLinkMixedDifference]
          rw [updateTwoGaugeLinks_same_link V e' g1 h1, updateTwoGaugeLinks_same_link V e' g2 h1,
            updateTwoGaugeLinks_same_link V e' g1 h2, updateTwoGaugeLinks_same_link V e' g2 h2]
          ring
        rw [h_zero, abs_zero]
      · change |groupTwoLinkMixedDifference L (groupWilsonAction su2CompactGaugeClassTrace w)
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 0
        rw [groupTwoLinkMixedDifference_groupWilsonAction_eq_zero_of_not_mem_dobrushinNeighbors
          su2CompactGaugeClassTrace w V e e' h_eq h_mem g1 g2 h1 h2, abs_zero]
  · have h_sub :
        (∑ e' ∈ (Finset.univ : Finset (Link L)).erase e,
          if e' ∈ dobrushinNeighbors e then 2 * (24 * w) else 0) ≤
        ∑ _e' ∈ dobrushinNeighbors e, (2 * (24 * w)) := by
      rw [← Finset.sum_filter]
      refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun _ _ _ => by linarith)
      intro e' he'
      exact (Finset.mem_filter.mp he').2
    rw [Finset.sum_const, nsmul_eq_mul] at h_sub
    have h_card : ((dobrushinNeighbors e).card : ℝ) ≤ 18 :=
      Nat.cast_le.mpr (dobrushinNeighbors_card_le_eighteen e)
    exact h_sub.trans (mul_le_mul_of_nonneg_right h_card (by linarith))

/-- Every plaquette `p : Plaquette L` whose unit-rectangle path support
`latticePathSupport L p.x (rectangleSteps p.μ p.ν 1 1)` contains link `e : Link L` belongs to the
at-most-6-plaquette set `incidentPlaquettes e`. -/
theorem mem_incidentPlaquettes_of_mem_latticePathSupport_rectangleSteps_one_one
    {L : ℕ} (p : Plaquette L) (e : Link L)
    (he : e ∈ latticePathSupport L p.x (rectangleSteps p.μ p.ν 1 1)) :
    p ∈ incidentPlaquettes e := by
  classical
  have h1 : p.x + unitVec L p.μ + unitVec L p.ν - unitVec L p.μ = shift p.x p.ν := by
    simp only [shift]
    abel
  have h2 : p.x + unitVec L p.μ + unitVec L p.ν + -unitVec L p.μ - unitVec L p.ν = p.x := by
    abel
  rw [rectangleSteps_one_one] at he
  simp only [latticePathSupport, latticeStepLink, stepTarget,
    LatticeStep.displacement_forward, LatticeStep.displacement_backward,
    h1, h2, Finset.mem_insert, Finset.notMem_empty, or_false] at he
  have hμν : p.μ ≠ p.ν := ne_of_lt p.h
  have hνμ : p.ν ≠ p.μ := hμν.symm
  have hnot : ¬p.ν < p.μ := not_lt_of_ge p.h.le
  rcases he with rfl | rfl | rfl | rfl
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.ν, hνμ⟩, false), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, p.h]
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.μ, hμν⟩, true), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, hnot]
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.ν, hνμ⟩, true), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, p.h, shift]
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.μ, hμν⟩, false), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, hnot]

/-- Unconditional, volume-independent `(4 / 3)^length`-weighted incident-loop sum bound for
`PolymerActivityFamily.localPlaquette L w`: for any `L : ℕ` `[NeZero L]`, `0 ≤ w`, and `e : Link L`,
at most `6` plaquettes `p ∈ incidentPlaquettes e` contain `e` in their 4-step boundary support, each
contributing `4 * ((4 / 3) ^ 4 * (4 * w))`, so the sum is at most
`6 * (4 * ((4 / 3) ^ 4 * (4 * w)))` with zero factor of `Fintype.card (Link L)`. -/
theorem PolymerActivityFamily.localPlaquette_weighted_incident_sum_le
    (L : ℕ) [NeZero L] {w : ℝ} (hw : 0 ≤ w) (e : Link L) :
    let P := PolymerActivityFamily.localPlaquette L w
    (∑ i : P.idx,
      if e ∈ latticePathSupport L (P.bases i) (P.loops i) then
        ((P.loops i).length : ℝ) * ((4 / 3 : ℝ) ^ (P.loops i).length * (4 * |P.weights i|))
      else 0) ≤ 6 * (4 * ((4 / 3 : ℝ) ^ 4 * (4 * w))) := by
  classical
  dsimp [PolymerActivityFamily.localPlaquette]
  have h_sub :
      (∑ p : Plaquette L,
        if e ∈ latticePathSupport L p.x (rectangleSteps p.μ p.ν 1 1) then
          ((rectangleSteps p.μ p.ν 1 1).length : ℝ) *
            ((4 / 3 : ℝ) ^ (rectangleSteps p.μ p.ν 1 1).length * (4 * |w|))
        else 0) =
      ∑ p ∈ incidentPlaquettes e,
        if e ∈ latticePathSupport L p.x (rectangleSteps p.μ p.ν 1 1) then
          ((rectangleSteps p.μ p.ν 1 1).length : ℝ) *
            ((4 / 3 : ℝ) ^ (rectangleSteps p.μ p.ν 1 1).length * (4 * |w|))
        else 0 := by
    symm
    refine Finset.sum_subset (Finset.subset_univ _) fun p _ hp => ?_
    have he : e ∉ latticePathSupport L p.x (rectangleSteps p.μ p.ν 1 1) :=
      fun h => hp (mem_incidentPlaquettes_of_mem_latticePathSupport_rectangleSteps_one_one p e h)
    simp [he]
  rw [h_sub]
  have h_term (p : Plaquette L) :
      (if e ∈ latticePathSupport L p.x (rectangleSteps p.μ p.ν 1 1) then
        ((rectangleSteps p.μ p.ν 1 1).length : ℝ) *
          ((4 / 3 : ℝ) ^ (rectangleSteps p.μ p.ν 1 1).length * (4 * |w|))
      else 0) ≤ 4 * ((4 / 3 : ℝ) ^ 4 * (4 * w)) := by
    have h_len : (rectangleSteps p.μ p.ν 1 1).length = 4 := rfl
    rw [h_len, abs_of_nonneg hw]
    split_ifs
    · norm_num
    · positivity
  have h_card : ((incidentPlaquettes e).card : ℝ) ≤ 6 :=
    Nat.cast_le.mpr (incidentPlaquettes_card_le_six e)
  calc
    (∑ p ∈ incidentPlaquettes e,
      if e ∈ latticePathSupport L p.x (rectangleSteps p.μ p.ν 1 1) then
        ((rectangleSteps p.μ p.ν 1 1).length : ℝ) *
          ((4 / 3 : ℝ) ^ (rectangleSteps p.μ p.ν 1 1).length * (4 * |w|))
      else 0)
      ≤ ∑ _p ∈ incidentPlaquettes e, (4 * ((4 / 3 : ℝ) ^ 4 * (4 * w))) :=
        Finset.sum_le_sum fun p _ => h_term p
    _ = ((incidentPlaquettes e).card : ℝ) * (4 * ((4 / 3 : ℝ) ^ 4 * (4 * w))) := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ 6 * (4 * ((4 / 3 : ℝ) ^ 4 * (4 * w))) :=
        mul_le_mul_of_nonneg_right h_card (by positivity)

/-- Gap 2 (Exponential Locality of the Blocked Remainder):
the landed effective action `((T.chain n).state 0)` on `T : LandingTube P` has:
1. Volume-independent local `exp(κ * length)`-weighted polymer incident-loop sum bounded by `T.η_star`
   (feeding both `PolymerActivityFamily.rowSum_support_mixedDifference_le_sum_incident_length` and
   `PolymerActivityFamily.abs_twoLinkMixedDifference_eval_le_exp_treeLength`, with loop support
   diameter in `linkTemporalDist` proved unconditionally via
   `linkTemporalDist_le_length_of_mem_latticePathSupport`), and
2. Truncation two-link mixed differences bounded by `c_trunc_base n e e' * exp(-κ * linkTemporalDist e e')`
   with `(landingTubeContraction T)⁻¹ ≤ exp(κ)` and base row sum bounded by `T.ε_star`
inside the tilted Dobrushin tube `4 * (18 * (24 * (landingTubeContraction T)⁻¹ * T.β_star) + T.η_star + T.ε_star) < 1`. -/
structure ExponentialRemainderLocalityBound {P : ContinuumCutoffPath}
    (T : LandingTube P) where
  κ : ℝ
  h_tilt_le_exp : (landingTubeContraction T)⁻¹ ≤ Real.exp κ
  h_tilted_tube :
    4 * (18 * (24 * (landingTubeContraction T)⁻¹ * T.β_star) + T.η_star + T.ε_star) < 1
  h_exp_decay : ∀ᶠ n in atTop,
    let P_n := ((T.chain n).state 0).polymers
    ∃ c_trunc_base : Link (T.irSide n) → Link (T.irSide n) → ℝ,
      (∀ e : Link (T.irSide n),
        (∑ i : P_n.idx,
          if e ∈ latticePathSupport (T.irSide n) (P_n.bases i) (P_n.loops i) then
            ((P_n.loops i).length : ℝ) *
              (Real.exp (κ * ((P_n.loops i).length : ℝ)) * (4 * |P_n.weights i|))
          else 0) ≤ T.η_star) ∧
      (∀ e e' : Link (T.irSide n), 0 ≤ c_trunc_base e e') ∧
      (∀ (V : GaugeConfig (T.irSide n)) (e e' : Link (T.irSide n)) (g1 g2 h1 h2 : SU2),
        |twoLinkMixedDifference (T.irSide n) (((T.chain n).state 0).R_trunc)
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
          c_trunc_base e e' * Real.exp (-κ * (linkTemporalDist e e' : ℝ))) ∧
      (∀ e : Link (T.irSide n),
        (∑ e' ∈ Finset.univ.erase e, c_trunc_base e e') ≤ T.ε_star)

/-- Unconditional strict positivity `0 < hLoc.κ` derived from `0 < landingTubeContraction T < 1`
and `hLoc.h_tilt_le_exp : (landingTubeContraction T)⁻¹ ≤ Real.exp hLoc.κ`. -/
theorem ExponentialRemainderLocalityBound.κ_pos {P : ContinuumCutoffPath}
    {T : LandingTube P} (hLoc : ExponentialRemainderLocalityBound T) :
    0 < hLoc.κ := by
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  have h_gt_one : 1 < (landingTubeContraction T)⁻¹ := (one_lt_inv₀ hq0).mpr hq1
  have h_exp_gt : Real.exp 0 < Real.exp hLoc.κ := by
    rw [Real.exp_zero]
    exact h_gt_one.trans_le hLoc.h_tilt_le_exp
  exact Real.exp_lt_exp.mp h_exp_gt

/-- Unconditional non-negativity `0 ≤ hLoc.κ` derived from `ExponentialRemainderLocalityBound.κ_pos`. -/
theorem ExponentialRemainderLocalityBound.hκ_nonneg {P : ContinuumCutoffPath}
    {T : LandingTube P} (hLoc : ExponentialRemainderLocalityBound T) :
    0 ≤ hLoc.κ :=
  hLoc.κ_pos.le

/-- Gap 2 Theorem: `ExponentialRemainderLocalityBound T` invokes
`PolymerActivityFamily.rowSum_support_mixedDifference_le_sum_incident_length` and
`PolymerActivityFamily.abs_twoLinkMixedDifference_eval_le_exp_treeLength` on the polymer family,
establishes the tilted Dobrushin row-sum bound with zero lattice-volume dependence, and discharges
`ObservableTransferAndSymmetryBridge.h_dobrushin_spatial_decay` unconditionally via Georgii
Theorem 8.20 (`LandingTube.dobrushin_spatial_decay_of_tilted_rowSum`). -/
theorem LandingTube.dobrushin_spatial_decay_of_exponentialRemainderLocality
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (hLoc : ExponentialRemainderLocalityBound T) :
    ∃ C_spatial : ℝ, 0 ≤ C_spatial ∧
      ∀ (t : ℕ), ∀ᶠ n in atTop,
        ∀ (e : Link (T.irSide n)) (S : Finset (Link (T.irSide n))),
          (∀ e' ∈ S, t ≤ linkTemporalDist e e') →
          (∑ e' ∈ S,
            dobrushinComparisonSeries
              (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e') ≤
            C_spatial * (landingTubeContraction T) ^ t := by
  classical
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  set μ := (landingTubeContraction T)⁻¹
  have hμ_ge_one : 1 ≤ μ := ((one_lt_inv₀ hq0).mpr hq1).le
  have hμ_nonneg : 0 ≤ μ := by linarith
  set q_tilde := 4 * (18 * (24 * μ * T.β_star) + T.η_star + T.ε_star)
  have hq_tilde_nonneg : 0 ≤ q_tilde := by
    have := T.hβ_star_nonneg
    have := T.hη_star_nonneg
    have := T.hε_star_nonneg
    have : 0 ≤ 24 * μ * T.β_star := mul_nonneg (mul_nonneg (by norm_num) hμ_nonneg) T.hβ_star_nonneg
    dsimp [q_tilde]
    linarith
  refine T.dobrushin_spatial_decay_of_tilted_rowSum hq_tilde_nonneg hLoc.h_tilted_tube ?_
  filter_upwards [T.h_tube, hLoc.h_exp_decay] with n h_tube h_exp e
  rcases h_exp with ⟨c_trunc_base, hcp_local, hct_nn, hct_mix, hct_sum⟩
  let P_n := ((T.chain n).state 0).polymers
  let w₀ : P_n.idx → ℝ := fun i =>
    Real.exp (hLoc.κ * ((P_n.loops i).length : ℝ)) * (4 * |P_n.weights i|)
  have hw₀ (i : P_n.idx) : 0 ≤ w₀ i :=
    mul_nonneg (Real.exp_pos _).le (mul_nonneg (by norm_num) (abs_nonneg _))
  have h_weight_exp (i : P_n.idx) :
      4 * |P_n.weights i| ≤ w₀ i * Real.exp (-hLoc.κ * ((P_n.loops i).length : ℝ)) := by
    dsimp [w₀]
    have h_prod :
        Real.exp (hLoc.κ * ((P_n.loops i).length : ℝ)) *
          Real.exp (-hLoc.κ * ((P_n.loops i).length : ℝ)) = 1 := by
      rw [← Real.exp_add]
      ring_nf
      exact Real.exp_zero
    have h_eq :
        4 * |P_n.weights i| =
          (Real.exp (hLoc.κ * ((P_n.loops i).length : ℝ)) * (4 * |P_n.weights i|)) *
            Real.exp (-hLoc.κ * ((P_n.loops i).length : ℝ)) := by
      calc
        4 * |P_n.weights i|
          = (4 * |P_n.weights i|) *
              (Real.exp (hLoc.κ * ((P_n.loops i).length : ℝ)) *
                Real.exp (-hLoc.κ * ((P_n.loops i).length : ℝ))) := by
            rw [h_prod, mul_one]
        _ = (Real.exp (hLoc.κ * ((P_n.loops i).length : ℝ)) * (4 * |P_n.weights i|)) *
              Real.exp (-hLoc.κ * ((P_n.loops i).length : ℝ)) := by ring
    exact h_eq.le
  let c_poly_base : Link (T.irSide n) → Link (T.irSide n) → ℝ := fun e1 e2 =>
    ∑ i : P_n.idx,
      if e1 ∈ latticePathSupport (T.irSide n) (P_n.bases i) (P_n.loops i) ∧
         e2 ∈ latticePathSupport (T.irSide n) (P_n.bases i) (P_n.loops i) then
        w₀ i
      else 0
  have hcp_sum (e1 : Link (T.irSide n)) :
      (∑ e2 ∈ Finset.univ.erase e1, c_poly_base e1 e2) ≤ T.η_star :=
    (P_n.rowSum_support_mixedDifference_le_sum_incident_length w₀ hw₀ e1).trans (hcp_local e1)
  have hcp_nn (e1 e2 : Link (T.irSide n)) : 0 ≤ c_poly_base e1 e2 := by
    refine Finset.sum_nonneg fun i _ => ?_
    split_ifs
    · exact hw₀ i
    · exact le_rfl
  have hcp_mix (V : GaugeConfig (T.irSide n)) (e1 e2 : Link (T.irSide n)) (g1 g2 h1 h2 : SU2) :
      |twoLinkMixedDifference (T.irSide n) P_n.eval V e1.x e1.μ g1 g2 e2.x e2.μ h1 h2| ≤
        c_poly_base e1 e2 * Real.exp (-hLoc.κ * (linkTemporalDist e1 e2 : ℝ)) :=
    P_n.abs_twoLinkMixedDifference_eval_le_exp_treeLength
      linkTemporalDist w₀ hLoc.hκ_nonneg hw₀
      (fun i _ _ he he' => linkTemporalDist_le_length_of_mem_latticePathSupport he he')
      h_weight_exp V e1 e2 g1 g2 h1 h2
  have hβ0 : 0 ≤ ((T.chain n).state 0).β := (T.chain n).h_β_nonneg 0 (Nat.zero_le _)
  let c_poly : Link (T.irSide n) → Link (T.irSide n) → ℝ := fun e1 e2 =>
    c_poly_base e1 e2 * Real.exp (-hLoc.κ * (linkTemporalDist e1 e2 : ℝ))
  let c_trunc : Link (T.irSide n) → Link (T.irSide n) → ℝ := fun e1 e2 =>
    c_trunc_base e1 e2 * Real.exp (-hLoc.κ * (linkTemporalDist e1 e2 : ℝ))
  have h_factor_le_one (d : ℕ) : μ ^ d * Real.exp (-hLoc.κ * (d : ℝ)) ≤ 1 := by
    have h_pow : μ ^ d ≤ (Real.exp hLoc.κ) ^ d :=
      pow_le_pow_left₀ hμ_nonneg hLoc.h_tilt_le_exp d
    have h_exp_pow : (Real.exp hLoc.κ) ^ d = Real.exp (hLoc.κ * (d : ℝ)) := by
      rw [← Real.exp_nat_mul]
      ring_nf
    calc
      μ ^ d * Real.exp (-hLoc.κ * (d : ℝ))
        ≤ (Real.exp hLoc.κ) ^ d * Real.exp (-hLoc.κ * (d : ℝ)) :=
          mul_le_mul_of_nonneg_right h_pow (Real.exp_pos _).le
      _ = Real.exp (hLoc.κ * (d : ℝ)) * Real.exp (-hLoc.κ * (d : ℝ)) := by
          rw [h_exp_pow]
      _ = Real.exp (hLoc.κ * (d : ℝ) + (-hLoc.κ * (d : ℝ))) := (Real.exp_add _ _).symm
      _ = 1 := by ring_nf; exact Real.exp_zero
  have h_exp_le_one (d : ℕ) : Real.exp (-hLoc.κ * (d : ℝ)) ≤ 1 := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by nlinarith [hLoc.hκ_nonneg, (Nat.cast_nonneg d : (0 : ℝ) ≤ d)])
  have hc_poly_sum (e1 : Link (T.irSide n)) :
      (∑ e2 ∈ Finset.univ.erase e1, c_poly e1 e2) ≤ T.η_star := by
    refine (Finset.sum_le_sum fun e2 _ => ?_).trans (hcp_sum e1)
    dsimp [c_poly]
    exact mul_le_of_le_one_right (hcp_nn e1 e2) (h_exp_le_one (linkTemporalDist e1 e2))
  have hc_poly_tilt (e1 : Link (T.irSide n)) :
      (∑ e2 ∈ Finset.univ.erase e1, μ ^ (linkTemporalDist e1 e2) * c_poly e1 e2) ≤ T.η_star := by
    refine (Finset.sum_le_sum fun e2 _ => ?_).trans (hcp_sum e1)
    dsimp [c_poly]
    have h_re :
        μ ^ (linkTemporalDist e1 e2) *
          (c_poly_base e1 e2 * Real.exp (-hLoc.κ * (linkTemporalDist e1 e2 : ℝ))) =
        c_poly_base e1 e2 *
          (μ ^ (linkTemporalDist e1 e2) * Real.exp (-hLoc.κ * (linkTemporalDist e1 e2 : ℝ))) := by
      ring
    rw [h_re]
    exact mul_le_of_le_one_right (hcp_nn e1 e2) (h_factor_le_one (linkTemporalDist e1 e2))
  have hc_trunc_sum (e1 : Link (T.irSide n)) :
      (∑ e2 ∈ Finset.univ.erase e1, c_trunc e1 e2) ≤ T.ε_star := by
    refine (Finset.sum_le_sum fun e2 _ => ?_).trans (hct_sum e1)
    dsimp [c_trunc]
    exact mul_le_of_le_one_right (hct_nn e1 e2) (h_exp_le_one (linkTemporalDist e1 e2))
  have hc_trunc_tilt (e1 : Link (T.irSide n)) :
      (∑ e2 ∈ Finset.univ.erase e1, μ ^ (linkTemporalDist e1 e2) * c_trunc e1 e2) ≤ T.ε_star := by
    refine (Finset.sum_le_sum fun e2 _ => ?_).trans (hct_sum e1)
    dsimp [c_trunc]
    have h_re :
        μ ^ (linkTemporalDist e1 e2) *
          (c_trunc_base e1 e2 * Real.exp (-hLoc.κ * (linkTemporalDist e1 e2 : ℝ))) =
        c_trunc_base e1 e2 *
          (μ ^ (linkTemporalDist e1 e2) * Real.exp (-hLoc.κ * (linkTemporalDist e1 e2 : ℝ))) := by
      ring
    rw [h_re]
    exact mul_le_of_le_one_right (hct_nn e1 e2) (h_factor_le_one (linkTemporalDist e1 e2))
  obtain ⟨B_R, hR_bdd⟩ := h_tube.2.2.1
  exact ((T.chain n).state 0).totalAction_dobrushinTiltedMatrix_rowSum_le
    linkTemporalDist
    (fun _ _ h_nb => linkTemporalDist_le_one_of_mem_dobrushinNeighbors h_nb)
    hμ_ge_one hβ0 h_tube.1 T.hβ_star_nonneg T.hη_star_nonneg T.hε_star_nonneg
    T.h_land hR_bdd h_tube.2.2.2.1
    c_poly c_trunc
    (fun e1 e2 => mul_nonneg (hcp_nn e1 e2) (Real.exp_pos _).le)
    hcp_mix hc_poly_sum hc_poly_tilt
    (fun e1 e2 => mul_nonneg (hct_nn e1 e2) (Real.exp_pos _).le)
    hct_mix hc_trunc_sum hc_trunc_tilt e

/-! ### Gap 3: Non-Vanishing IR Probe Variance Floor via Gibbs Perturbation & Haar Character Dominance -/

namespace InteractingEffectiveActionState

/-- Strict positivity `0 < st.partitionFunction` and integrability of `st.boltzmannDensity` on
`gaugeHaarMeasure L` for any `st : InteractingEffectiveActionState L` with `0 ≤ st.β`,
`Measurable st.R_trunc`, and `|st.R_trunc V| ≤ ε_star`. -/
theorem partitionFunction_pos_and_integrable_boltzmannDensity {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) {ε_star : ℝ}
    (hβ0 : 0 ≤ st.β)
    (hR_meas : Measurable st.R_trunc)
    (hR_bdd : ∀ V : GaugeConfig L, |st.R_trunc V| ≤ ε_star) :
    0 < st.partitionFunction ∧
    Integrable st.boltzmannDensity (gaugeHaarMeasure L) := by
  have hS_meas : Measurable st.totalAction := st.measurable_totalAction hR_meas
  let B : ℝ :=
    |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
      (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|) + ε_star
  have hS_bdd : ∀ V : GaugeConfig L, |st.totalAction V| ≤ B :=
    st.abs_totalAction_le hβ0 hR_bdd
  have hZ_tot : 0 < groupGibbsPartition SU2 L st.totalAction :=
    groupGibbsPartition_pos SU2 st.totalAction hS_meas hS_bdd
  have h_eq := st.groupGibbsPartition_totalAction_eq
  have hZ_pos : 0 < st.partitionFunction := by
    have h_exp : 0 < Real.exp (-st.c_vac) := Real.exp_pos _
    nlinarith
  have h_dens_eq :
      st.boltzmannDensity = fun V => Real.exp st.c_vac * Real.exp (-st.totalAction V) := by
    funext V
    unfold boltzmannDensity totalAction
    rw [← Real.exp_add]
    congr 1
    ring
  have h_int_tot : Integrable (fun V => Real.exp (-st.totalAction V)) (gaugeHaarMeasure L) := by
    refine (integrable_const (Real.exp B)).mono'
      (Real.continuous_exp.measurable.comp hS_meas.neg).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun V => by
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_exp.mpr (by linarith [(abs_le.mp (hS_bdd V)).1])
  rw [h_dens_eq]
  exact ⟨hZ_pos, h_int_tot.const_mul (Real.exp st.c_vac)⟩

/-- Two-sided partition-function sandwich: when two effective action states
`st1, st2 : InteractingEffectiveActionState L` have non-vacuum action difference bounded by `δ` at
every configuration `V : GaugeConfig L`, their partition functions satisfy
`exp(-δ) * st2.partitionFunction ≤ st1.partitionFunction ≤ exp(δ) * st2.partitionFunction`. -/
theorem partitionFunction_sandwich_of_action_diff {L : ℕ} [NeZero L]
    (st1 st2 : InteractingEffectiveActionState L) {ε₁ ε₂ δ : ℝ}
    (hβ1 : 0 ≤ st1.β) (hR1_meas : Measurable st1.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L, |st1.R_trunc V| ≤ ε₁)
    (hβ2 : 0 ≤ st2.β) (hR2_meas : Measurable st2.R_trunc)
    (hR2_bdd : ∀ V : GaugeConfig L, |st2.R_trunc V| ≤ ε₂)
    (h_diff : ∀ V : GaugeConfig L,
      |(wilsonAction st1.β V + st1.polymers.eval V + st1.R_trunc V) -
        (wilsonAction st2.β V + st2.polymers.eval V + st2.R_trunc V)| ≤ δ) :
    Real.exp (-δ) * st2.partitionFunction ≤ st1.partitionFunction ∧
    st1.partitionFunction ≤ Real.exp δ * st2.partitionFunction := by
  have h_int1 := (st1.partitionFunction_pos_and_integrable_boltzmannDensity hβ1 hR1_meas hR1_bdd).2
  have h_int2 := (st2.partitionFunction_pos_and_integrable_boltzmannDensity hβ2 hR2_meas hR2_bdd).2
  unfold partitionFunction
  constructor
  · rw [← integral_const_mul]
    exact integral_mono (h_int2.const_mul _) h_int1 fun V =>
      (boltzmannDensity_sandwich_of_action_diff st1 st2 V (h_diff V)).1
  · rw [← integral_const_mul]
    exact integral_mono h_int1 (h_int2.const_mul _) fun V =>
      (boltzmannDensity_sandwich_of_action_diff st1 st2 V (h_diff V)).2

/-- Pointwise normalized Boltzmann density perturbation bound: when `st1, st2` have non-vacuum
action difference bounded by `δ ≥ 0`,
`|st1.boltzmannDensity V / st1.partitionFunction - st2.boltzmannDensity V / st2.partitionFunction| ≤ (exp(2 * δ) - 1) * (st2.boltzmannDensity V / st2.partitionFunction)`. -/
theorem boltzmannNormalizedDensity_abs_sub_le {L : ℕ} [NeZero L]
    (st1 st2 : InteractingEffectiveActionState L) {ε₁ ε₂ δ : ℝ} (_hδ : 0 ≤ δ)
    (hβ1 : 0 ≤ st1.β) (hR1_meas : Measurable st1.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L, |st1.R_trunc V| ≤ ε₁)
    (hβ2 : 0 ≤ st2.β) (hR2_meas : Measurable st2.R_trunc)
    (hR2_bdd : ∀ V : GaugeConfig L, |st2.R_trunc V| ≤ ε₂)
    (h_diff : ∀ V : GaugeConfig L,
      |(wilsonAction st1.β V + st1.polymers.eval V + st1.R_trunc V) -
        (wilsonAction st2.β V + st2.polymers.eval V + st2.R_trunc V)| ≤ δ)
    (V : GaugeConfig L) :
    |st1.boltzmannDensity V / st1.partitionFunction -
        st2.boltzmannDensity V / st2.partitionFunction| ≤
      (Real.exp (2 * δ) - 1) * (st2.boltzmannDensity V / st2.partitionFunction) := by
  have hZ1_pos := (st1.partitionFunction_pos_and_integrable_boltzmannDensity hβ1 hR1_meas hR1_bdd).1
  have hZ2_pos := (st2.partitionFunction_pos_and_integrable_boltzmannDensity hβ2 hR2_meas hR2_bdd).1
  have h_w := boltzmannDensity_sandwich_of_action_diff st1 st2 V (h_diff V)
  have h_Z := partitionFunction_sandwich_of_action_diff
    st1 st2 hβ1 hR1_meas hR1_bdd hβ2 hR2_meas hR2_bdd h_diff
  have hw2_nonneg : 0 ≤ st2.boltzmannDensity V := (Real.exp_pos _).le
  have hρ2_nonneg : 0 ≤ st2.boltzmannDensity V / st2.partitionFunction :=
    div_nonneg hw2_nonneg hZ2_pos.le
  have h_upper :
      st1.boltzmannDensity V / st1.partitionFunction ≤
        Real.exp (2 * δ) * (st2.boltzmannDensity V / st2.partitionFunction) := by
    rw [div_le_iff₀ hZ1_pos]
    have h_z_inv :
        st2.partitionFunction ≤ Real.exp δ * st1.partitionFunction := by
      calc
        st2.partitionFunction
          = Real.exp δ * (Real.exp (-δ) * st2.partitionFunction) := by
              rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
        _ ≤ Real.exp δ * st1.partitionFunction :=
              mul_le_mul_of_nonneg_left h_Z.1 (Real.exp_pos _).le
    have h_div_z :
        st2.boltzmannDensity V / st2.partitionFunction * st1.partitionFunction ≥
          Real.exp (-δ) * st2.boltzmannDensity V := by
      rw [ge_iff_le, div_mul_eq_mul_div, le_div_iff₀ hZ2_pos]
      calc
        Real.exp (-δ) * st2.boltzmannDensity V * st2.partitionFunction
          ≤ Real.exp (-δ) * st2.boltzmannDensity V * (Real.exp δ * st1.partitionFunction) :=
            mul_le_mul_of_nonneg_left h_z_inv (mul_nonneg (Real.exp_pos _).le hw2_nonneg)
        _ = st2.boltzmannDensity V * st1.partitionFunction := by
            have h_e : Real.exp (-δ) * Real.exp δ = 1 := by
              rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
            calc
              Real.exp (-δ) * st2.boltzmannDensity V * (Real.exp δ * st1.partitionFunction)
                = (Real.exp (-δ) * Real.exp δ) * (st2.boltzmannDensity V * st1.partitionFunction) := by ring
              _ = st2.boltzmannDensity V * st1.partitionFunction := by rw [h_e, one_mul]
    calc
      st1.boltzmannDensity V
        ≤ Real.exp δ * st2.boltzmannDensity V := h_w.2
      _ = Real.exp (2 * δ) * (Real.exp (-δ) * st2.boltzmannDensity V) := by
          rw [← mul_assoc, ← Real.exp_add]
          congr 2
          ring
      _ ≤ Real.exp (2 * δ) *
            (st2.boltzmannDensity V / st2.partitionFunction * st1.partitionFunction) :=
          mul_le_mul_of_nonneg_left h_div_z (Real.exp_pos _).le
      _ = Real.exp (2 * δ) * (st2.boltzmannDensity V / st2.partitionFunction) *
            st1.partitionFunction := by ring
  have h_lower :
      Real.exp (-(2 * δ)) * (st2.boltzmannDensity V / st2.partitionFunction) ≤
        st1.boltzmannDensity V / st1.partitionFunction := by
    rw [le_div_iff₀ hZ1_pos]
    have h_div_z :
        st2.boltzmannDensity V / st2.partitionFunction * st1.partitionFunction ≤
          Real.exp δ * st2.boltzmannDensity V := by
      rw [div_mul_eq_mul_div, div_le_iff₀ hZ2_pos]
      calc
        st2.boltzmannDensity V * st1.partitionFunction
          ≤ st2.boltzmannDensity V * (Real.exp δ * st2.partitionFunction) :=
            mul_le_mul_of_nonneg_left h_Z.2 hw2_nonneg
        _ = Real.exp δ * st2.boltzmannDensity V * st2.partitionFunction := by ring
    calc
      Real.exp (-(2 * δ)) * (st2.boltzmannDensity V / st2.partitionFunction) * st1.partitionFunction
        = Real.exp (-(2 * δ)) *
            (st2.boltzmannDensity V / st2.partitionFunction * st1.partitionFunction) := by ring
      _ ≤ Real.exp (-(2 * δ)) * (Real.exp δ * st2.boltzmannDensity V) :=
          mul_le_mul_of_nonneg_left h_div_z (Real.exp_pos _).le
      _ = Real.exp (-δ) * st2.boltzmannDensity V := by
          rw [← mul_assoc, ← Real.exp_add]
          congr 2
          ring
      _ ≤ st1.boltzmannDensity V := h_w.1
  have h_exp_symm : 1 - Real.exp (-(2 * δ)) ≤ Real.exp (2 * δ) - 1 := by
    have h1 := Real.add_one_le_exp (2 * δ)
    have h2 := Real.add_one_le_exp (-(2 * δ))
    linarith
  have h_lower2 :
      (1 - (Real.exp (2 * δ) - 1)) * (st2.boltzmannDensity V / st2.partitionFunction) ≤
        st1.boltzmannDensity V / st1.partitionFunction := by
    have h_le : 1 - (Real.exp (2 * δ) - 1) ≤ Real.exp (-(2 * δ)) := by linarith
    exact (mul_le_mul_of_nonneg_right h_le hρ2_nonneg).trans h_lower
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Bounded-observable Gibbs expectation perturbation theorem: if `st1, st2 : InteractingEffectiveActionState L`
have non-vacuum action difference bounded by `δ ≥ 0` and `F : GaugeConfig L → ℝ` is measurable with
`∀ V, |F V| ≤ M_F`, then
`|(∫ V, F V ∂st1.gibbsMeasure) - (∫ V, F V ∂st2.gibbsMeasure)| ≤ (Real.exp (2 * δ) - 1) * M_F`. -/
theorem gibbsMeasure_expectation_diff_le_of_action_diff {L : ℕ} [NeZero L]
    (st1 st2 : InteractingEffectiveActionState L) {ε₁ ε₂ δ M_F : ℝ} (hδ : 0 ≤ δ)
    (hβ1 : 0 ≤ st1.β) (hR1_meas : Measurable st1.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L, |st1.R_trunc V| ≤ ε₁)
    (hβ2 : 0 ≤ st2.β) (hR2_meas : Measurable st2.R_trunc)
    (hR2_bdd : ∀ V : GaugeConfig L, |st2.R_trunc V| ≤ ε₂)
    (h_diff : ∀ V : GaugeConfig L,
      |(wilsonAction st1.β V + st1.polymers.eval V + st1.R_trunc V) -
        (wilsonAction st2.β V + st2.polymers.eval V + st2.R_trunc V)| ≤ δ)
    {F : GaugeConfig L → ℝ} (hF_meas : Measurable F)
    (hF_bdd : ∀ V : GaugeConfig L, |F V| ≤ M_F) :
    |(∫ V, F V ∂st1.gibbsMeasure) - (∫ V, F V ∂st2.gibbsMeasure)| ≤
      (Real.exp (2 * δ) - 1) * M_F := by
  have hMF_nonneg : 0 ≤ M_F := le_trans (abs_nonneg _) (hF_bdd (vacuumConfig L))
  have hZ1 := st1.partitionFunction_pos_and_integrable_boltzmannDensity hβ1 hR1_meas hR1_bdd
  have hZ2 := st2.partitionFunction_pos_and_integrable_boltzmannDensity hβ2 hR2_meas hR2_bdd
  let ρ₁ : GaugeConfig L → ℝ := fun V => st1.boltzmannDensity V / st1.partitionFunction
  let ρ₂ : GaugeConfig L → ℝ := fun V => st2.boltzmannDensity V / st2.partitionFunction
  have hρ₁_nonneg (V : GaugeConfig L) : 0 ≤ ρ₁ V := div_nonneg (Real.exp_pos _).le hZ1.1.le
  have hρ₂_nonneg (V : GaugeConfig L) : 0 ≤ ρ₂ V := div_nonneg (Real.exp_pos _).le hZ2.1.le
  have h_meas_w1 : Measurable st1.boltzmannDensity := by
    have h_eq : st1.boltzmannDensity = fun V => Real.exp st1.c_vac * Real.exp (-st1.totalAction V) := by
      funext V
      unfold boltzmannDensity totalAction
      rw [← Real.exp_add]
      congr 1
      ring
    rw [h_eq]
    exact measurable_const.mul (Real.continuous_exp.measurable.comp (st1.measurable_totalAction hR1_meas).neg)
  have h_meas_w2 : Measurable st2.boltzmannDensity := by
    have h_eq : st2.boltzmannDensity = fun V => Real.exp st2.c_vac * Real.exp (-st2.totalAction V) := by
      funext V
      unfold boltzmannDensity totalAction
      rw [← Real.exp_add]
      congr 1
      ring
    rw [h_eq]
    exact measurable_const.mul (Real.continuous_exp.measurable.comp (st2.measurable_totalAction hR2_meas).neg)
  have h_int_rew1 :
      (∫ V, F V ∂st1.gibbsMeasure) = ∫ V, ρ₁ V * F V ∂(gaugeHaarMeasure L) := by
    unfold gibbsMeasure
    have hm1 : Measurable (fun V => ENNReal.ofReal (ρ₁ V)) :=
      (h_meas_w1.div_const st1.partitionFunction).ennreal_ofReal
    rw [integral_withDensity_eq_integral_toReal_smul hm1
      (Filter.Eventually.of_forall fun _ => ENNReal.ofReal_lt_top) F]
    simp only [ENNReal.toReal_ofReal (hρ₁_nonneg _), smul_eq_mul]
  have h_int_rew2 :
      (∫ V, F V ∂st2.gibbsMeasure) = ∫ V, ρ₂ V * F V ∂(gaugeHaarMeasure L) := by
    unfold gibbsMeasure
    have hm2 : Measurable (fun V => ENNReal.ofReal (ρ₂ V)) :=
      (h_meas_w2.div_const st2.partitionFunction).ennreal_ofReal
    rw [integral_withDensity_eq_integral_toReal_smul hm2
      (Filter.Eventually.of_forall fun _ => ENNReal.ofReal_lt_top) F]
    simp only [ENNReal.toReal_ofReal (hρ₂_nonneg _), smul_eq_mul]
  have h_int_ρ1F : Integrable (fun V => ρ₁ V * F V) (gaugeHaarMeasure L) := by
    refine ((hZ1.2.div_const st1.partitionFunction).mul_const M_F).mono'
      ((h_meas_w1.div_const _).mul hF_meas).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun V => by
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hρ₁_nonneg V)]
      exact mul_le_mul_of_nonneg_left (hF_bdd V) (hρ₁_nonneg V)
  have h_int_ρ2F : Integrable (fun V => ρ₂ V * F V) (gaugeHaarMeasure L) := by
    refine ((hZ2.2.div_const st2.partitionFunction).mul_const M_F).mono'
      ((h_meas_w2.div_const _).mul hF_meas).aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun V => by
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hρ₂_nonneg V)]
      exact mul_le_mul_of_nonneg_left (hF_bdd V) (hρ₂_nonneg V)
  have h_int_ρ2 : (∫ V, ρ₂ V ∂(gaugeHaarMeasure L)) = 1 := by
    dsimp [ρ₂]
    rw [integral_div]
    exact div_self (ne_of_gt hZ2.1)
  rw [h_int_rew1, h_int_rew2, ← integral_sub h_int_ρ1F h_int_ρ2F]
  have h_pt (V : GaugeConfig L) :
      |ρ₁ V * F V - ρ₂ V * F V| ≤ (Real.exp (2 * δ) - 1) * M_F * ρ₂ V := by
    have h_dens := boltzmannNormalizedDensity_abs_sub_le
      st1 st2 hδ hβ1 hR1_meas hR1_bdd hβ2 hR2_meas hR2_bdd h_diff V
    calc
      |ρ₁ V * F V - ρ₂ V * F V|
        = |ρ₁ V - ρ₂ V| * |F V| := by rw [← sub_mul, abs_mul]
      _ ≤ ((Real.exp (2 * δ) - 1) * ρ₂ V) * M_F :=
          mul_le_mul h_dens (hF_bdd V) (abs_nonneg _)
            (mul_nonneg (by linarith [Real.one_le_exp (by linarith : 0 ≤ 2 * δ)]) (hρ₂_nonneg V))
      _ = (Real.exp (2 * δ) - 1) * M_F * ρ₂ V := by ring
  calc
    |∫ V, (ρ₁ V * F V - ρ₂ V * F V) ∂(gaugeHaarMeasure L)|
      ≤ ∫ V, |ρ₁ V * F V - ρ₂ V * F V| ∂(gaugeHaarMeasure L) :=
        abs_integral_le_integral_abs
    _ ≤ ∫ V, (Real.exp (2 * δ) - 1) * M_F * ρ₂ V ∂(gaugeHaarMeasure L) :=
        integral_mono (h_int_ρ1F.sub h_int_ρ2F).abs
          ((hZ2.2.div_const st2.partitionFunction).const_mul ((Real.exp (2 * δ) - 1) * M_F)) h_pt
    _ = (Real.exp (2 * δ) - 1) * M_F * (∫ V, ρ₂ V ∂(gaugeHaarMeasure L)) :=
        integral_const_mul _ _
    _ = (Real.exp (2 * δ) - 1) * M_F := by rw [h_int_ρ2, mul_one]

/-- Connected covariance (`irCov`) perturbation bound between `st1.gibbsMeasure` and
`st2.gibbsMeasure` for any `[-1, 1]`-bounded measurable observables `f, g : GaugeConfig L → ℝ`:
`|irCov st1.gibbsMeasure f g - irCov st2.gibbsMeasure f g| ≤ 3 * (Real.exp (2 * δ) - 1)`. -/
theorem gibbsMeasure_irCov_diff_le_of_action_diff {L : ℕ} [NeZero L]
    (st1 st2 : InteractingEffectiveActionState L) {ε₁ ε₂ δ : ℝ} (hδ : 0 ≤ δ)
    (hβ1 : 0 ≤ st1.β) (hR1_meas : Measurable st1.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L, |st1.R_trunc V| ≤ ε₁)
    (hβ2 : 0 ≤ st2.β) (hR2_meas : Measurable st2.R_trunc)
    (hR2_bdd : ∀ V : GaugeConfig L, |st2.R_trunc V| ≤ ε₂)
    (h_diff : ∀ V : GaugeConfig L,
      |(wilsonAction st1.β V + st1.polymers.eval V + st1.R_trunc V) -
        (wilsonAction st2.β V + st2.polymers.eval V + st2.R_trunc V)| ≤ δ)
    {f g : GaugeConfig L → ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GaugeConfig L, |f V| ≤ 1)
    (hg_meas : Measurable g) (hg_bdd : ∀ V : GaugeConfig L, |g V| ≤ 1) :
    |irCov st1.gibbsMeasure f g - irCov st2.gibbsMeasure f g| ≤
      3 * (Real.exp (2 * δ) - 1) := by
  have hfg_bdd (V : GaugeConfig L) : |f V * g V| ≤ 1 := by
    rw [abs_mul]
    nlinarith [hf_bdd V, hg_bdd V, abs_nonneg (f V), abs_nonneg (g V)]
  have h_fg := gibbsMeasure_expectation_diff_le_of_action_diff
    (F := fun V => f V * g V)
    st1 st2 hδ hβ1 hR1_meas hR1_bdd hβ2 hR2_meas hR2_bdd h_diff (hf_meas.mul hg_meas) hfg_bdd
  have h_f := gibbsMeasure_expectation_diff_le_of_action_diff
    st1 st2 hδ hβ1 hR1_meas hR1_bdd hβ2 hR2_meas hR2_bdd h_diff hf_meas hf_bdd
  have h_g := gibbsMeasure_expectation_diff_le_of_action_diff
    st1 st2 hδ hβ1 hR1_meas hR1_bdd hβ2 hR2_meas hR2_bdd h_diff hg_meas hg_bdd
  have h_prob1 : IsProbabilityMeasure st1.gibbsMeasure := by
    rw [st1.gibbsMeasure_eq_groupGibbsMeasure]
    exact groupGibbsMeasure_isProbabilityMeasure SU2 st1.totalAction
      (st1.measurable_totalAction hR1_meas) (st1.abs_totalAction_le hβ1 hR1_bdd)
  have h_prob2 : IsProbabilityMeasure st2.gibbsMeasure := by
    rw [st2.gibbsMeasure_eq_groupGibbsMeasure]
    exact groupGibbsMeasure_isProbabilityMeasure SU2 st2.totalAction
      (st2.measurable_totalAction hR2_meas) (st2.abs_totalAction_le hβ2 hR2_bdd)
  have h_ef1 : |∫ V, f V ∂st1.gibbsMeasure| ≤ 1 := by
    calc
      |∫ V, f V ∂st1.gibbsMeasure|
        ≤ ∫ V, |f V| ∂st1.gibbsMeasure := abs_integral_le_integral_abs
      _ ≤ ∫ _V, (1 : ℝ) ∂st1.gibbsMeasure :=
          integral_mono ((integrable_const 1).mono' hf_meas.aestronglyMeasurable
            (Filter.Eventually.of_forall fun V => by rw [Real.norm_eq_abs]; exact hf_bdd V)).abs
            (integrable_const 1) hf_bdd
      _ = 1 := by simp
  have h_eg2 : |∫ V, g V ∂st2.gibbsMeasure| ≤ 1 := by
    calc
      |∫ V, g V ∂st2.gibbsMeasure|
        ≤ ∫ V, |g V| ∂st2.gibbsMeasure := abs_integral_le_integral_abs
      _ ≤ ∫ _V, (1 : ℝ) ∂st2.gibbsMeasure :=
          integral_mono ((integrable_const 1).mono' hg_meas.aestronglyMeasurable
            (Filter.Eventually.of_forall fun V => by rw [Real.norm_eq_abs]; exact hg_bdd V)).abs
            (integrable_const 1) hg_bdd
      _ = 1 := by simp
  set ef1 := ∫ V, f V ∂st1.gibbsMeasure
  set ef2 := ∫ V, f V ∂st2.gibbsMeasure
  set eg1 := ∫ V, g V ∂st1.gibbsMeasure
  set eg2 := ∫ V, g V ∂st2.gibbsMeasure
  set efg1 := ∫ V, f V * g V ∂st1.gibbsMeasure
  set efg2 := ∫ V, f V * g V ∂st2.gibbsMeasure
  have h_split :
      (efg1 - ef1 * eg1) - (efg2 - ef2 * eg2) =
        (efg1 - efg2) - (ef1 * (eg1 - eg2) + (ef1 - ef2) * eg2) := by
    ring
  unfold irCov
  rw [h_split]
  have h_tri1 := abs_sub (efg1 - efg2) (ef1 * (eg1 - eg2) + (ef1 - ef2) * eg2)
  have h_tri2 := abs_add_le (ef1 * (eg1 - eg2)) ((ef1 - ef2) * eg2)
  rw [abs_mul, abs_mul] at h_tri2
  have h_prod1 : |ef1| * |eg1 - eg2| ≤ 1 * ((Real.exp (2 * δ) - 1) * 1) :=
    mul_le_mul h_ef1 h_g (abs_nonneg _) zero_le_one
  have h_prod2 : |ef1 - ef2| * |eg2| ≤ ((Real.exp (2 * δ) - 1) * 1) * 1 :=
    mul_le_mul h_f h_eg2 (abs_nonneg _)
      (mul_nonneg (by linarith [Real.one_le_exp (by linarith : 0 ≤ 2 * δ)]) zero_le_one)
  linarith

/-- Center-twist upper bound on pure-Wilson expectations of sign-flipping observables:
if `F : GaugeConfig L → ℝ` is measurable, bounded by `M_F`, and satisfies
`F (twistLinkNegOne e₀ U) = -F U` for all `U` at some link `e₀ : Link L`, then under the pure
Wilson measure `wilsonMeasure (gaugeHaarMeasure L) β` (`β ≥ 0`),
`|∫ U, F U ∂(wilsonMeasure (gaugeHaarMeasure L) β)| ≤ ((Real.exp (12 * β) - 1) / 2) * M_F`. -/
theorem abs_integral_wilsonMeasure_le_half_exp_twelve_beta_sub_one_of_twistLinkNegOne_neg
    {L : ℕ} [NeZero L] {β M_F : ℝ} (hβ : 0 ≤ β) (e₀ : Link L)
    {F : GaugeConfig L → ℝ}
    (hF_meas : Measurable F)
    (hF_bdd : ∀ U : GaugeConfig L, |F U| ≤ M_F)
    (hF_twist : ∀ U : GaugeConfig L, F (twistLinkNegOne e₀ U) = -F U) :
    |∫ U, F U ∂(wilsonMeasure (gaugeHaarMeasure L) β)| ≤
      ((Real.exp (12 * β) - 1) / 2) * M_F := by
  have hM : 0 ≤ M_F := (abs_nonneg (F (vacuumConfig L))).trans (hF_bdd (vacuumConfig L))
  let st := pureWilson L β
  have hR_meas : Measurable st.R_trunc := measurable_const
  have hR_bdd : ∀ V : GaugeConfig L, |st.R_trunc V| ≤ (0 : ℝ) := fun _ => by
    simp [st, pureWilson]
  have hZ := st.partitionFunction_pos_and_integrable_boltzmannDensity hβ hR_meas hR_bdd
  have hZ_pos : 0 < st.partitionFunction := hZ.1
  let ρ : GaugeConfig L → ℝ := fun V =>
    st.boltzmannDensity V / st.partitionFunction
  have hρ_nonneg (V : GaugeConfig L) : 0 ≤ ρ V :=
    div_nonneg (Real.exp_pos _).le hZ_pos.le
  have h_meas_w : Measurable st.boltzmannDensity := by
    have h_eq : st.boltzmannDensity = fun V => Real.exp st.c_vac * Real.exp (-st.totalAction V) := by
      funext V
      unfold boltzmannDensity totalAction
      rw [← Real.exp_add]
      congr 1
      ring
    rw [h_eq]
    exact measurable_const.mul
      (Real.continuous_exp.measurable.comp (st.measurable_totalAction hR_meas).neg)
  have h_int_ρ : ∫ V, ρ V ∂(gaugeHaarMeasure L) = 1 := by
    dsimp [ρ]
    rw [integral_div]
    exact div_self hZ_pos.ne'
  have h_eq_int :
      ∫ U, F U ∂(wilsonMeasure (gaugeHaarMeasure L) β) =
        ∫ U, ρ U * F U ∂(gaugeHaarMeasure L) := by
    rw [← gibbsMeasure_pureWilson_eq_wilsonMeasure L β]
    unfold gibbsMeasure
    have hm : Measurable (fun V => ENNReal.ofReal (ρ V)) :=
      (h_meas_w.div_const st.partitionFunction).ennreal_ofReal
    rw [integral_withDensity_eq_integral_toReal_smul hm
      (Filter.Eventually.of_forall fun _ => ENNReal.ofReal_lt_top) F]
    simp only [ENNReal.toReal_ofReal (hρ_nonneg _), smul_eq_mul]
  rw [h_eq_int]
  have h_ρ_diff_and_le (U : GaugeConfig L) :
      ρ (twistLinkNegOne e₀ U) ≤ Real.exp (12 * β) * ρ U ∧
      |ρ U - ρ (twistLinkNegOne e₀ U)| ≤ (Real.exp (12 * β) - 1) * ρ U := by
    have h_act_diff :
        |wilsonAction β (twistLinkNegOne e₀ U) - wilsonAction β U| ≤ 12 * β :=
      wilsonAction_twistLinkNegOne_abs_sub_le L hβ e₀ U
    have h_w_pos : 0 < st.boltzmannDensity U := Real.exp_pos _
    have h_boltz_eq (W : GaugeConfig L) :
        st.boltzmannDensity W = Real.exp (-wilsonAction β W) := by
      dsimp [st, pureWilson, boltzmannDensity]
      rw [PolymerActivityFamily.eval_empty, sub_zero, sub_zero]
    have h_ratio_le :
        st.boltzmannDensity (twistLinkNegOne e₀ U) /
          st.boltzmannDensity U ≤ Real.exp (12 * β) := by
      rw [h_boltz_eq, h_boltz_eq, ← Real.exp_sub]
      refine Real.exp_le_exp.mpr ?_
      have h_le := (abs_le.mp h_act_diff).1
      linarith
    have h_ratio_ge :
        Real.exp (-12 * β) ≤
          st.boltzmannDensity (twistLinkNegOne e₀ U) /
            st.boltzmannDensity U := by
      rw [h_boltz_eq, h_boltz_eq, ← Real.exp_sub]
      refine Real.exp_le_exp.mpr ?_
      have h_le := (abs_le.mp h_act_diff).2
      linarith
    have h_sub_ge :
        1 - Real.exp (-12 * β) ≤ 1 - (1 - (Real.exp (12 * β) - 1)) := by
      have h_exp_pos : 0 < Real.exp (12 * β) := Real.exp_pos _
      have h_one_le : 1 ≤ Real.exp (12 * β) := Real.one_le_exp (by linarith)
      have h_prod : Real.exp (-12 * β) * Real.exp (12 * β) = 1 := by
        rw [← Real.exp_add]
        ring_nf
        exact Real.exp_zero
      have h_sq : 0 ≤ (Real.exp (12 * β) - 1) ^ 2 := sq_nonneg _
      nlinarith
    have h_div_diff :
        |1 - st.boltzmannDensity (twistLinkNegOne e₀ U) /
            st.boltzmannDensity U| ≤ Real.exp (12 * β) - 1 := by
      rw [abs_le]
      constructor <;> linarith
    have h_id_le :
        ρ (twistLinkNegOne e₀ U) =
          (st.boltzmannDensity (twistLinkNegOne e₀ U) / st.boltzmannDensity U) * ρ U := by
      dsimp [ρ]
      have hw_ne : st.boltzmannDensity U ≠ 0 := h_w_pos.ne'
      field_simp [hw_ne]
    have h_id :
        ρ U - ρ (twistLinkNegOne e₀ U) =
          (1 - st.boltzmannDensity (twistLinkNegOne e₀ U) /
            st.boltzmannDensity U) * ρ U := by
      dsimp [ρ]
      have hw_ne : st.boltzmannDensity U ≠ 0 := h_w_pos.ne'
      field_simp [hw_ne]
    refine ⟨?_, ?_⟩
    · rw [h_id_le]
      exact mul_le_mul_of_nonneg_right h_ratio_le (hρ_nonneg U)
    · rw [h_id, abs_mul, abs_of_nonneg (hρ_nonneg U)]
      exact mul_le_mul_of_nonneg_right h_div_diff (hρ_nonneg U)
  have h_int_ρF : Integrable (fun U : GaugeConfig L => ρ U * F U) (gaugeHaarMeasure L) := by
    refine ((hZ.2.div_const st.partitionFunction).mul_const M_F).mono'
      ((h_meas_w.div_const st.partitionFunction).mul hF_meas).aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall fun U => ?_
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hρ_nonneg U)]
    exact mul_le_mul_of_nonneg_left (hF_bdd U) (hρ_nonneg U)
  have hmap := (measurePreserving_twistLinkNegOne (L := L) e₀).map_eq
  have h_inv_int :
      ∫ U, ρ (twistLinkNegOne e₀ U) * F (twistLinkNegOne e₀ U) ∂(gaugeHaarMeasure L) =
        ∫ U, ρ U * F U ∂(gaugeHaarMeasure L) := by
    conv_rhs => rw [← hmap]
    exact (integral_map (continuous_twistLinkNegOne e₀).aemeasurable
      ((h_meas_w.div_const st.partitionFunction).mul hF_meas).aestronglyMeasurable).symm
  have h_neg_int :
      ∫ U, ρ (twistLinkNegOne e₀ U) * F (twistLinkNegOne e₀ U) ∂(gaugeHaarMeasure L) =
        -∫ U, ρ (twistLinkNegOne e₀ U) * F U ∂(gaugeHaarMeasure L) := by
    have h_pt :
        (fun U : GaugeConfig L => ρ (twistLinkNegOne e₀ U) * F (twistLinkNegOne e₀ U)) =
          fun U => -(ρ (twistLinkNegOne e₀ U) * F U) := by
      funext U
      rw [hF_twist U, mul_neg]
    rw [h_pt, integral_neg]
  have h_int_twist : Integrable (fun U : GaugeConfig L => ρ (twistLinkNegOne e₀ U) * F U)
      (gaugeHaarMeasure L) := by
    refine ((hZ.2.div_const st.partitionFunction).const_mul (Real.exp (12 * β) * M_F)).mono'
      (((h_meas_w.div_const st.partitionFunction).comp
        (continuous_twistLinkNegOne e₀).measurable).mul hF_meas).aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall fun U => ?_
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hρ_nonneg (twistLinkNegOne e₀ U))]
    calc
      ρ (twistLinkNegOne e₀ U) * |F U|
        ≤ (Real.exp (12 * β) * ρ U) * M_F :=
          mul_le_mul (h_ρ_diff_and_le U).1 (hF_bdd U) (abs_nonneg _)
            (mul_nonneg (Real.exp_pos _).le (hρ_nonneg U))
      _ = (Real.exp (12 * β) * M_F) * ρ U := by ring
  have h_half_id :
      ∫ U, ρ U * F U ∂(gaugeHaarMeasure L) =
        (1 / 2 : ℝ) *
          ∫ U, (ρ U - ρ (twistLinkNegOne e₀ U)) * F U ∂(gaugeHaarMeasure L) := by
    have h_sub :
        ∫ U, (ρ U - ρ (twistLinkNegOne e₀ U)) * F U ∂(gaugeHaarMeasure L) =
          (∫ U, ρ U * F U ∂(gaugeHaarMeasure L)) -
            (∫ U, ρ (twistLinkNegOne e₀ U) * F U ∂(gaugeHaarMeasure L)) := by
      have h_sub_fn :
          (fun U : GaugeConfig L => (ρ U - ρ (twistLinkNegOne e₀ U)) * F U) =
            fun U => ρ U * F U - ρ (twistLinkNegOne e₀ U) * F U := by
        funext U
        ring
      rw [h_sub_fn, integral_sub h_int_ρF h_int_twist]
    linarith [h_inv_int, h_neg_int, h_sub]
  have h_pt (U : GaugeConfig L) :
      |(ρ U - ρ (twistLinkNegOne e₀ U)) * F U| ≤
        ((Real.exp (12 * β) - 1) * M_F) * ρ U := by
    rw [abs_mul]
    calc
      |ρ U - ρ (twistLinkNegOne e₀ U)| * |F U|
        ≤ ((Real.exp (12 * β) - 1) * ρ U) * M_F :=
          mul_le_mul (h_ρ_diff_and_le U).2 (hF_bdd U) (abs_nonneg _)
            (mul_nonneg (by linarith [Real.one_le_exp (by linarith : 0 ≤ 12 * β)]) (hρ_nonneg U))
      _ = ((Real.exp (12 * β) - 1) * M_F) * ρ U := by ring
  rw [h_half_id, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
  have h_int_bound :
      |∫ U, (ρ U - ρ (twistLinkNegOne e₀ U)) * F U ∂(gaugeHaarMeasure L)| ≤
        (Real.exp (12 * β) - 1) * M_F := by
    calc
      |∫ U, (ρ U - ρ (twistLinkNegOne e₀ U)) * F U ∂(gaugeHaarMeasure L)|
        ≤ ∫ U, |(ρ U - ρ (twistLinkNegOne e₀ U)) * F U| ∂(gaugeHaarMeasure L) :=
          abs_integral_le_integral_abs
      _ ≤ ∫ U, ((Real.exp (12 * β) - 1) * M_F) * ρ U ∂(gaugeHaarMeasure L) := by
          have h_sub_int :
              Integrable (fun U : GaugeConfig L => |(ρ U - ρ (twistLinkNegOne e₀ U)) * F U|)
                (gaugeHaarMeasure L) := by
            have h_sub_fn :
                (fun U : GaugeConfig L => |(ρ U - ρ (twistLinkNegOne e₀ U)) * F U|) =
                  fun U => |ρ U * F U - ρ (twistLinkNegOne e₀ U) * F U| := by
              funext U
              congr 1
              ring
            rw [h_sub_fn]
            exact (h_int_ρF.sub h_int_twist).abs
          exact integral_mono h_sub_int
            ((hZ.2.div_const st.partitionFunction).const_mul ((Real.exp (12 * β) - 1) * M_F))
            h_pt
      _ = ((Real.exp (12 * β) - 1) * M_F) * ∫ U, ρ U ∂(gaugeHaarMeasure L) :=
          integral_const_mul _ _
      _ = (Real.exp (12 * β) - 1) * M_F := by rw [h_int_ρ, mul_one]
  linarith

/-- Center-twist upper bound on pure-Wilson connected covariance `irCov`:
if `f, g : GaugeConfig L → ℝ` are measurable and bounded by `1`, and at some link `e₀ : Link L`
the center twist `twistLinkNegOne e₀` flips `g` (`g (twistLinkNegOne e₀ U) = -g U`) while leaving
`f` invariant (`f (twistLinkNegOne e₀ U) = f U`), then
`|irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g| ≤ Real.exp (12 * β) - 1`. -/
theorem abs_irCov_wilsonMeasure_le_exp_twelve_beta_sub_one_of_twistLinkNegOne
    {L : ℕ} [NeZero L] {β : ℝ} (hβ : 0 ≤ β) (e₀ : Link L)
    {f g : GaugeConfig L → ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ U : GaugeConfig L, |f U| ≤ 1)
    (hg_meas : Measurable g) (hg_bdd : ∀ U : GaugeConfig L, |g U| ≤ 1)
    (hf_inv : ∀ U : GaugeConfig L, f (twistLinkNegOne e₀ U) = f U)
    (hg_flip : ∀ U : GaugeConfig L, g (twistLinkNegOne e₀ U) = -g U) :
    |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g| ≤
      Real.exp (12 * β) - 1 := by
  have hfg_bdd (U : GaugeConfig L) : |f U * g U| ≤ 1 := by
    rw [abs_mul]
    nlinarith [hf_bdd U, hg_bdd U, abs_nonneg (f U), abs_nonneg (g U)]
  have hfg_flip (U : GaugeConfig L) :
      f (twistLinkNegOne e₀ U) * g (twistLinkNegOne e₀ U) = -(f U * g U) := by
    rw [hf_inv U, hg_flip U, mul_neg]
  have h_fg := abs_integral_wilsonMeasure_le_half_exp_twelve_beta_sub_one_of_twistLinkNegOne_neg
    (F := fun U => f U * g U) hβ e₀ (hf_meas.mul hg_meas) hfg_bdd hfg_flip
  have h_g := abs_integral_wilsonMeasure_le_half_exp_twelve_beta_sub_one_of_twistLinkNegOne_neg
    hβ e₀ hg_meas hg_bdd hg_flip
  have h_prob : IsProbabilityMeasure (wilsonMeasure (gaugeHaarMeasure L) β) := by
    rw [← gibbsMeasure_pureWilson_eq_wilsonMeasure L β]
    rw [(pureWilson L β).gibbsMeasure_eq_groupGibbsMeasure]
    exact groupGibbsMeasure_isProbabilityMeasure SU2 (pureWilson L β).totalAction
      ((pureWilson L β).measurable_totalAction measurable_const)
      ((pureWilson L β).abs_totalAction_le (ε_star := 0) hβ (fun _ => by simp [pureWilson]))
  have h_ef : |∫ U, f U ∂(wilsonMeasure (gaugeHaarMeasure L) β)| ≤ 1 := by
    calc
      |∫ U, f U ∂(wilsonMeasure (gaugeHaarMeasure L) β)|
        ≤ ∫ U, |f U| ∂(wilsonMeasure (gaugeHaarMeasure L) β) := abs_integral_le_integral_abs
      _ ≤ ∫ _U, (1 : ℝ) ∂(wilsonMeasure (gaugeHaarMeasure L) β) :=
          integral_mono ((integrable_const 1).mono' hf_meas.aestronglyMeasurable
            (Filter.Eventually.of_forall fun U => by rw [Real.norm_eq_abs]; exact hf_bdd U)).abs
            (integrable_const 1) hf_bdd
      _ = 1 := by simp
  unfold irCov
  have h_prod :
      |(∫ U, f U ∂(wilsonMeasure (gaugeHaarMeasure L) β)) *
        (∫ U, g U ∂(wilsonMeasure (gaugeHaarMeasure L) β))| ≤
      ((Real.exp (12 * β) - 1) / 2) * 1 := by
    rw [abs_mul]
    calc
      |∫ U, f U ∂(wilsonMeasure (gaugeHaarMeasure L) β)| *
        |∫ U, g U ∂(wilsonMeasure (gaugeHaarMeasure L) β)|
        ≤ 1 * (((Real.exp (12 * β) - 1) / 2) * 1) :=
          mul_le_mul h_ef h_g (abs_nonneg _) zero_le_one
      _ = ((Real.exp (12 * β) - 1) / 2) * 1 := one_mul _
  have h_tri := abs_sub
    (∫ U, f U * g U ∂(wilsonMeasure (gaugeHaarMeasure L) β))
    ((∫ U, f U ∂(wilsonMeasure (gaugeHaarMeasure L) β)) *
      (∫ U, g U ∂(wilsonMeasure (gaugeHaarMeasure L) β)))
  linarith

/-- Elementary real exponential bound `Real.exp x - 1 ≤ 2 * x` for `0 ≤ x ≤ 1 / 2`. -/
theorem exp_sub_one_le_two_mul_of_nonneg_of_le_half {x : ℝ} (hx0 : 0 ≤ x) (hx_half : x ≤ 1 / 2) :
    Real.exp x - 1 ≤ 2 * x := by
  have h_one_sub_pos : 0 < 1 - x := by linarith
  have h_le_inv : Real.exp x ≤ 1 / (1 - x) := by
    have h_inv_exp : Real.exp (-x) * Real.exp x = 1 := by
      rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
    have h_lower : 1 - x ≤ Real.exp (-x) := by
      have := Real.add_one_le_exp (-x)
      linarith
    rw [le_div_iff₀ h_one_sub_pos]
    calc
      Real.exp x * (1 - x) ≤ Real.exp x * Real.exp (-x) :=
        mul_le_mul_of_nonneg_left h_lower (Real.exp_pos x).le
      _ = 1 := by rw [mul_comm, h_inv_exp]
  have h_div_le : 1 / (1 - x) - 1 ≤ 2 * x := by
    rw [div_sub_one h_one_sub_pos.ne', div_le_iff₀ h_one_sub_pos]
    nlinarith
  linarith

/-- Formal refutation of the `1 / 16` pure-Wilson covariance floor at `β ≤ canonicalCrossoverBetaHi`
(`β ≤ 1 / 6912`): for any `[-1, 1]`-bounded measurable observables `f, g` where a single-link center
twist `twistLinkNegOne e₀` flips `g` and leaves `f` invariant (such as any unit-plaquette positive-time
Wilson loop and its time reflection),
`|irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g| ≤ 24 * β ≤ 1 / 288 < 1 / 16`, so
`1 / 16 ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g|` is **false**. -/
theorem not_wilsonMeasure_irCov_ge_one_sixteenth_at_canonicalCrossoverBetaHi
    {L : ℕ} [NeZero L] {β : ℝ} (hβ0 : 0 ≤ β)
    (hβ_hi : β ≤ (canonicalCrossoverBetaHi : ℝ))
    (e₀ : Link L)
    {f g : GaugeConfig L → ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ U : GaugeConfig L, |f U| ≤ 1)
    (hg_meas : Measurable g) (hg_bdd : ∀ U : GaugeConfig L, |g U| ≤ 1)
    (hf_inv : ∀ U : GaugeConfig L, f (twistLinkNegOne e₀ U) = f U)
    (hg_flip : ∀ U : GaugeConfig L, g (twistLinkNegOne e₀ U) = -g U) :
    |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g| ≤ 1 / 288 ∧
    ¬ ((1 / 16 : ℝ) ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g|) := by
  have h_cov := abs_irCov_wilsonMeasure_le_exp_twelve_beta_sub_one_of_twistLinkNegOne
    hβ0 e₀ hf_meas hf_bdd hg_meas hg_bdd hf_inv hg_flip
  have h_beta_val : (canonicalCrossoverBetaHi : ℝ) = 1 / 6912 := by
    norm_num [canonicalCrossoverBetaHi]
  have h12_half : 12 * β ≤ 1 / 2 := by linarith
  have h_exp_le : Real.exp (12 * β) - 1 ≤ 24 * β := by
    have h2 := exp_sub_one_le_two_mul_of_nonneg_of_le_half (by linarith : 0 ≤ 12 * β) h12_half
    linarith
  have h_288 : |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g| ≤ 1 / 288 := by
    linarith
  refine ⟨h_288, ?_⟩
  intro h_contra
  linarith

/-- Concrete refutation for any unit-plaquette positive-time physical probe rectangle `ℓ` and its
time reflection `ℓ.timeReflect` on any torus `L > 2 * loopTimeSpanBound a ℓ` at
`0 ≤ β ≤ canonicalCrossoverBetaHi` with `|z_ref| ≤ 1` and `|z_pr| ≤ 1`:
`|irCov (wilsonMeasure (gaugeHaarMeasure L) β) (z_ref * W(ℓ.timeReflect)) (z_pr * W(ℓ))| ≤ 1 / 288 < 1 / 16`. -/
theorem unitPlaquetteProbe_irCov_wilsonMeasure_lt_one_sixteenth_at_canonicalCrossoverBetaHi
    (L : ℕ) [NeZero L] {a β z_ref z_pr : ℝ}
    (ha : 0 < a) (hβ0 : 0 ≤ β) (hβ_hi : β ≤ (canonicalCrossoverBetaHi : ℝ))
    (hz_ref : |z_ref| ≤ 1) (hz_pr : |z_pr| ≤ 1)
    (ℓ : PhysicalRectangle) (h_pos : ℓ.IsPositiveTime)
    (h_span : 2 * loopTimeSpanBound a ℓ < L)
    (hr : ℓ.stepsμ a = 1) (hs : ℓ.stepsν a = 1) :
    |irCov (wilsonMeasure (gaugeHaarMeasure L) β)
      (fun V => z_ref * physicalWilsonLoop L a ℓ.timeReflect V)
      (fun V => z_pr * physicalWilsonLoop L a ℓ V)| ≤ 1 / 288 ∧
    ¬ ((1 / 16 : ℝ) ≤
      |irCov (wilsonMeasure (gaugeHaarMeasure L) β)
        (fun V => z_ref * physicalWilsonLoop L a ℓ.timeReflect V)
        (fun V => z_pr * physicalWilsonLoop L a ℓ V)|) := by
  let e₀ : Link L := ⟨latticeSite L (ℓ.latticeBase a), ℓ.μ⟩
  have h_sign := physicalWilsonLoop_unitPlaquette_twistLinkNegOne_sign_and_timeReflect_inv
    L ha h_pos hr hs h_span
  have hf_meas :
      Measurable (fun V : GaugeConfig L => z_ref * physicalWilsonLoop L a ℓ.timeReflect V) :=
    measurable_const.mul (continuous_physicalWilsonLoop L a ℓ.timeReflect).measurable
  have hg_meas :
      Measurable (fun V : GaugeConfig L => z_pr * physicalWilsonLoop L a ℓ V) :=
    measurable_const.mul (continuous_physicalWilsonLoop L a ℓ).measurable
  have hf_bdd (V : GaugeConfig L) : |z_ref * physicalWilsonLoop L a ℓ.timeReflect V| ≤ 1 := by
    rw [abs_mul]
    have hW := abs_physicalWilsonLoop_le_one L a ℓ.timeReflect V
    nlinarith [abs_nonneg z_ref, abs_nonneg (physicalWilsonLoop L a ℓ.timeReflect V)]
  have hg_bdd (V : GaugeConfig L) : |z_pr * physicalWilsonLoop L a ℓ V| ≤ 1 := by
    rw [abs_mul]
    have hW := abs_physicalWilsonLoop_le_one L a ℓ V
    nlinarith [abs_nonneg z_pr, abs_nonneg (physicalWilsonLoop L a ℓ V)]
  refine not_wilsonMeasure_irCov_ge_one_sixteenth_at_canonicalCrossoverBetaHi
    hβ0 hβ_hi e₀ hf_meas hf_bdd hg_meas hg_bdd
    (fun U => by rw [(h_sign U).2])
    (fun U => by rw [(h_sign U).1, mul_neg])

/-- The special-unitary quaternion matrix `k_quat = [[0, i], [i, 0]] ∈ SU(2)`. -/
def su2PauliK : SU2 :=
  su2OfUnitQuat 0 0 0 1 (by norm_num)

/-- Orthonormal quaternion frame `1, i_quat, j_quat, k_quat ∈ SU(2)` indexing the four real
coordinates of `SU(2) ≅ S³`. -/
def su2QuatBasis : Fin 4 → SU2
  | 0 => 1
  | 1 => su2PauliI
  | 2 => su2PauliJ
  | 3 => su2PauliK

/-- Pointwise right-inverse quaternion-frame identity on `SU(2)`:
for any `X, Y : SU2`, summing `halfTraceRe (X * (su2QuatBasis α)⁻¹) * halfTraceRe (Y * (su2QuatBasis α)⁻¹)`
over the 4 quaternion basis elements `α : Fin 4` reproduces `halfTraceRe (X * Y⁻¹)`. -/
theorem sum_su2QuatBasis_halfTraceRe_right_inv_eq (X Y : SU2) :
    (∑ α : Fin 4,
      halfTraceRe (X * (su2QuatBasis α)⁻¹) *
        halfTraceRe (Y * (su2QuatBasis α)⁻¹)) =
    halfTraceRe (X * Y⁻¹) := by
  have h100 : ((1 : SU2).mat 0 0) = 1 := rfl
  have h110 : ((1 : SU2).mat 1 0) = 0 := rfl
  simp_rw [YangMillsOsterwalderSchraderInheritance.halfTraceRe_mul_inv_eq_sum_su2Coord]
  simp [Fin.sum_univ_four, su2QuatBasis, su2PauliI, su2PauliJ, su2PauliK,
    su2OfUnitQuat, su2QuatMatrix, YangMillsOsterwalderSchraderInheritance.su2Coord,
    h100, h110]

/-- Pointwise left-translated quaternion-frame identity on `SU(2)`:
for all `U, V, g : SU2`, averaging `halfTraceRe (U * (su2QuatBasis α * g)⁻¹) * halfTraceRe ((su2QuatBasis α * g) * V⁻¹)`
over `α : Fin 4` equals `halfTraceRe (U * V⁻¹)` identically before integration. -/
theorem sum_su2QuatBasis_halfTraceRe_mul_inv_eq (U V g : SU2) :
    (∑ α : Fin 4,
      halfTraceRe (U * (su2QuatBasis α * g)⁻¹) *
        halfTraceRe ((su2QuatBasis α * g) * V⁻¹)) =
    halfTraceRe (U * V⁻¹) := by
  have h_term (α : Fin 4) :
      halfTraceRe (U * (su2QuatBasis α * g)⁻¹) *
        halfTraceRe ((su2QuatBasis α * g) * V⁻¹) =
      halfTraceRe ((U * g⁻¹) * (su2QuatBasis α)⁻¹) *
        halfTraceRe ((V * g⁻¹) * (su2QuatBasis α)⁻¹) := by
    have h1 : U * (su2QuatBasis α * g)⁻¹ = (U * g⁻¹) * (su2QuatBasis α)⁻¹ := by
      rw [mul_inv_rev, mul_assoc]
    have h2 : ((V * g⁻¹) * (su2QuatBasis α)⁻¹)⁻¹ = (su2QuatBasis α * g) * V⁻¹ := by
      rw [mul_inv_rev, inv_inv, mul_inv_rev, inv_inv, mul_assoc]
    rw [h1, ← h2, halfTraceRe_inv]
  simp_rw [h_term]
  rw [sum_su2QuatBasis_halfTraceRe_right_inv_eq (U * g⁻¹) (V * g⁻¹)]
  have h_cancel : (U * g⁻¹) * (V * g⁻¹)⁻¹ = U * V⁻¹ := by
    rw [mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel_left]
  rw [h_cancel]

/-- Exact `SU(2)` Schur character convolution theorem on `SU2.haarProbability`:
for all `U, V : SU2`,
`∫ g : SU2, halfTraceRe (U * g⁻¹) * halfTraceRe (g * V⁻¹) ∂SU2.haarProbability = (1 / 4) * halfTraceRe (U * V⁻¹)`. -/
theorem integral_halfTraceRe_mul_inv_mul_halfTraceRe_eq_quarter (U V : SU2) :
    (∫ g : SU2,
      halfTraceRe (U * g⁻¹) * halfTraceRe (g * V⁻¹)
      ∂SU2.haarProbability) =
    (1 / 4 : ℝ) * halfTraceRe (U * V⁻¹) := by
  let F : SU2 → ℝ := fun g => halfTraceRe (U * g⁻¹) * halfTraceRe (g * V⁻¹)
  have hF_cont : Continuous F := by
    refine (continuous_halfTraceRe.comp (continuous_const.mul continuous_inv)).mul
      (continuous_halfTraceRe.comp (continuous_id.mul continuous_const))
  have hF_int : Integrable F SU2.haarProbability :=
    hF_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_shift (α : Fin 4) :
      (∫ g : SU2, F (su2QuatBasis α * g) ∂SU2.haarProbability) =
        ∫ g : SU2, F g ∂SU2.haarProbability := by
    have hmp : MeasurePreserving (fun g : SU2 => su2QuatBasis α * g)
        (SU2.haarProbability : Measure SU2) (SU2.haarProbability : Measure SU2) :=
      measurePreserving_mul_left (SU2.haarProbability : Measure SU2) (su2QuatBasis α)
    symm
    conv_lhs => rw [← hmp.map_eq]
    exact integral_map (continuous_const.mul continuous_id).aemeasurable hF_cont.aestronglyMeasurable
  have h_sum_int :
      (∫ g : SU2, (∑ α : Fin 4, F (su2QuatBasis α * g)) ∂SU2.haarProbability) =
        ∑ α : Fin 4, ∫ g : SU2, F (su2QuatBasis α * g) ∂SU2.haarProbability := by
    refine integral_finsetSum Finset.univ fun α _ => ?_
    exact (hF_cont.comp (continuous_const.mul continuous_id)).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_lhs :
      (∫ g : SU2, (∑ α : Fin 4, F (su2QuatBasis α * g)) ∂SU2.haarProbability) =
        halfTraceRe (U * V⁻¹) := by
    have h_pt : (fun g : SU2 => ∑ α : Fin 4, F (su2QuatBasis α * g)) =
        fun _ : SU2 => halfTraceRe (U * V⁻¹) := by
      funext g
      exact sum_su2QuatBasis_halfTraceRe_mul_inv_eq U V g
    rw [h_pt, integral_const, probReal_univ, one_smul]
  have h_rhs :
      (∑ α : Fin 4, ∫ g : SU2, F (su2QuatBasis α * g) ∂SU2.haarProbability) =
        4 * ∫ g : SU2, F g ∂SU2.haarProbability := by
    simp_rw [h_shift, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    ring
  change ∫ g : SU2, F g ∂SU2.haarProbability = (1 / 4 : ℝ) * halfTraceRe (U * V⁻¹)
  linarith [h_sum_int, h_lhs, h_rhs]

/-- Left-translated `SU(2)` Schur character convolution identity:
for every `A : SU2`, `∫ g : SU2, halfTraceRe g * halfTraceRe (A * g) ∂SU2.haarProbability = (1 / 4) * halfTraceRe A`. -/
theorem integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter (A : SU2) :
    (∫ g : SU2,
      halfTraceRe g * halfTraceRe (A * g)
      ∂SU2.haarProbability) =
    (1 / 4 : ℝ) * halfTraceRe A := by
  have h_rew (g : SU2) :
      halfTraceRe g * halfTraceRe (A * g) =
        halfTraceRe (1 * g⁻¹) * halfTraceRe (g * A⁻¹⁻¹) := by
    rw [one_mul, halfTraceRe_inv g, inv_inv]
    have h_conj : halfTraceRe (A * g) = halfTraceRe (g * A) := by
      have := halfTraceRe_conj A⁻¹ (A * g)
      have h_eq : A⁻¹ * (A * g) * A⁻¹⁻¹ = g * A := by
        rw [ inv_inv, ← mul_assoc, inv_mul_cancel, one_mul]
      rw [h_eq] at this
      exact this.symm
    rw [h_conj]
  simp_rw [h_rew]
  rw [integral_halfTraceRe_mul_inv_mul_halfTraceRe_eq_quarter 1 A⁻¹, one_mul, inv_inv]

/-- First moment of `halfTraceRe` under `SU2.haarProbability` vanishes by center-flip (`negOne`)
left Haar invariance: `∫ g : SU2, halfTraceRe g ∂SU2.haarProbability = 0`. -/
theorem integral_halfTraceRe_eq_zero :
    (∫ g : SU2, halfTraceRe g ∂SU2.haarProbability) = 0 := by
  have hmp : MeasurePreserving (fun g : SU2 => negOne * g)
      (SU2.haarProbability : Measure SU2) (SU2.haarProbability : Measure SU2) :=
    measurePreserving_mul_left (SU2.haarProbability : Measure SU2) negOne
  have h_shift :
      (∫ g : SU2, halfTraceRe (negOne * g) ∂SU2.haarProbability) =
        ∫ g : SU2, halfTraceRe g ∂SU2.haarProbability := by
    symm
    conv_lhs => rw [← hmp.map_eq]
    exact integral_map (continuous_const.mul continuous_id).aemeasurable
      continuous_halfTraceRe.aestronglyMeasurable
  have h_neg :
      (∫ g : SU2, halfTraceRe (negOne * g) ∂SU2.haarProbability) =
        -(∫ g : SU2, halfTraceRe g ∂SU2.haarProbability) := by
    simp_rw [YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul, integral_neg]
  linarith

/-- Left-translated first moment of `halfTraceRe` under `SU2.haarProbability` vanishes for every
`A : SU2`: `∫ g : SU2, halfTraceRe (A * g) ∂SU2.haarProbability = 0`. -/
theorem integral_halfTraceRe_mul_left_eq_zero (A : SU2) :
    (∫ g : SU2, halfTraceRe (A * g) ∂SU2.haarProbability) = 0 := by
  have hmp : MeasurePreserving (fun g : SU2 => A * g)
      (SU2.haarProbability : Measure SU2) (SU2.haarProbability : Measure SU2) :=
    measurePreserving_mul_left (SU2.haarProbability : Measure SU2) A
  have h_shift :
      (∫ g : SU2, halfTraceRe (A * g) ∂SU2.haarProbability) =
        ∫ g : SU2, halfTraceRe g ∂SU2.haarProbability := by
    symm
    conv_lhs => rw [← hmp.map_eq]
    exact integral_map (continuous_const.mul continuous_id).aemeasurable
      continuous_halfTraceRe.aestronglyMeasurable
  rw [h_shift, integral_halfTraceRe_eq_zero]

/-- Single-plaquette linearized Boltzmann contraction on `SU2.haarProbability`:
integrating `(1 + β * halfTraceRe g) * halfTraceRe (A * g)` over `g : SU2` kills the degree-0
piece `1 * halfTraceRe (A * g)` by `integral_halfTraceRe_mul_left_eq_zero` and contracts the
degree-1 character piece `β * halfTraceRe g * halfTraceRe (A * g)` to `(β / 4) * halfTraceRe A`. -/
theorem integral_one_add_beta_halfTraceRe_mul_halfTraceRe_left_eq (β : ℝ) (A : SU2) :
    (∫ g : SU2, (1 + β * halfTraceRe g) * halfTraceRe (A * g) ∂SU2.haarProbability) =
      (β / 4) * halfTraceRe A := by
  have h_int1 : Integrable (fun g : SU2 => halfTraceRe (A * g)) SU2.haarProbability :=
    (continuous_halfTraceRe.comp (continuous_const.mul continuous_id)).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_int2 :
      Integrable (fun g : SU2 => β * (halfTraceRe g * halfTraceRe (A * g))) SU2.haarProbability :=
    (continuous_const.mul (continuous_halfTraceRe.mul
      (continuous_halfTraceRe.comp (continuous_const.mul continuous_id)))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_expand :
      (fun g : SU2 => (1 + β * halfTraceRe g) * halfTraceRe (A * g)) =
        fun g : SU2 => halfTraceRe (A * g) + β * (halfTraceRe g * halfTraceRe (A * g)) := by
    funext g; ring
  rw [h_expand, integral_add h_int1 h_int2, integral_halfTraceRe_mul_left_eq_zero A,
    zero_add, integral_const_mul, integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter A]
  ring

/-- Second moment of `halfTraceRe` under `SU2.haarProbability`:
`∫ g : SU2, halfTraceRe g * halfTraceRe g ∂SU2.haarProbability = 1 / 4`. -/
theorem integral_halfTraceRe_sq_eq_quarter :
    (∫ g : SU2, halfTraceRe g * halfTraceRe g ∂SU2.haarProbability) = 1 / 4 := by
  have h := integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter 1
  simp only [one_mul] at h
  have h1 : halfTraceRe 1 = 1 := by
    unfold halfTraceRe SU2.trace
    change (1 / 2 : ℝ) * (Matrix.trace (1 : Matrix (Fin 2) (Fin 2) ℂ)).re = 1
    simp [Matrix.trace]
  rw [h1, mul_one] at h
  exact h

/-- Exact 5-fold `SU(2)` Haar character integral on the 6-face unit 3-cube:
after gauge-fixing a spanning tree of `7` edges on the 12-edge unit 3-cube connecting a positive-time
spatial unit plaquette and its time reflection across `4` lateral temporal plaquettes, the 5-fold
iterated `SU2.haarProbability` integral of the 6-face product
`halfTraceRe W₀ * halfTraceRe W₁ * halfTraceRe W₂ * halfTraceRe W₃ * halfTraceRe W₄ * halfTraceRe ((W₀ * W₁ * W₂ * W₃ * W₄)⁻¹)`
equals `(1 / 4) ^ 5 = 1 / 1024`. -/
theorem integral_cube_sixFace_halfTraceRe_eq_one_div_1024 :
    (∫ W₀ : SU2,
      halfTraceRe W₀ *
        (∫ W₁ : SU2,
          halfTraceRe W₁ *
            (∫ W₂ : SU2,
              halfTraceRe W₂ *
                (∫ W₃ : SU2,
                  halfTraceRe W₃ *
                    (∫ W₄ : SU2,
                      halfTraceRe W₄ *
                        halfTraceRe ((W₀ * W₁ * W₂ * W₃ * W₄)⁻¹)
                      ∂SU2.haarProbability)
                  ∂SU2.haarProbability)
              ∂SU2.haarProbability)
          ∂SU2.haarProbability)
      ∂SU2.haarProbability) =
    (1 / 4 : ℝ) ^ 5 ∧
    ((1 / 4 : ℝ) ^ 5 = 1 / 1024) := by
  refine ⟨?_, by norm_num⟩
  simp_rw [halfTraceRe_inv]
  simp_rw [integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter]
  have h_pull (A : SU2 → ℝ) (c : ℝ) :
      (∫ g : SU2, halfTraceRe g * (c * A g) ∂SU2.haarProbability) =
        c * ∫ g : SU2, halfTraceRe g * A g ∂SU2.haarProbability := by
    have h_eq : (fun g : SU2 => halfTraceRe g * (c * A g)) =
        fun g : SU2 => c * (halfTraceRe g * A g) := by
      funext g; ring
    rw [h_eq, integral_const_mul]
  simp_rw [h_pull, integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter]
  simp_rw [h_pull, integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter]
  simp_rw [h_pull, integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter]
  simp_rw [h_pull, integral_halfTraceRe_sq_eq_quarter]
  ring

/-- The 5-fold iterated `SU2.haarProbability` integral over the 6-face unit 3-cube spanning-tree
holonomies `(W₀, W₁, W₂, W₃, W₄)`. -/
noncomputable def cubeSixFaceHaarIntegral : ℝ :=
  ∫ W₀ : SU2,
    halfTraceRe W₀ *
      (∫ W₁ : SU2,
        halfTraceRe W₁ *
          (∫ W₂ : SU2,
            halfTraceRe W₂ *
              (∫ W₃ : SU2,
                halfTraceRe W₃ *
                  (∫ W₄ : SU2,
                    halfTraceRe W₄ *
                      halfTraceRe ((W₀ * W₁ * W₂ * W₃ * W₄)⁻¹)
                    ∂SU2.haarProbability)
                ∂SU2.haarProbability)
            ∂SU2.haarProbability)
        ∂SU2.haarProbability)
    ∂SU2.haarProbability

theorem cubeSixFaceHaarIntegral_eq_one_fourth_pow_five :
    cubeSixFaceHaarIntegral = (1 / 4 : ℝ) ^ 5 :=
  integral_cube_sixFace_halfTraceRe_eq_one_div_1024.1

/-- Linearized Boltzmann 6-face unit 3-cube contraction identity:
integrating the top and bottom probe holonomies `halfTraceRe W₀` and
`halfTraceRe ((W₀ * W₁ * W₂ * W₃ * W₄)⁻¹)` against the product of linearized single-plaquette
Boltzmann weights `∏_{i=1}^4 (1 + β * halfTraceRe W_i)` on the `4` lateral temporal plaquettes
of the unit 3-cube kills all lower-degree terms ($O(\beta^0), O(\beta^1), O(\beta^2), O(\beta^3)$)
by `SU(2)` character orthogonality (`integral_one_add_beta_halfTraceRe_mul_halfTraceRe_left_eq`)
and evaluates to `cubeSixFaceHaarIntegral * β ^ 4 = (1 / 4) ^ 5 * β ^ 4`. -/
theorem integral_cube_sixFace_linearizedBoltzmann_eq_cubeSixFaceHaarIntegral_mul_beta_pow_four
    (β : ℝ) :
    (∫ W₀ : SU2,
      halfTraceRe W₀ *
        (∫ W₁ : SU2,
          (1 + β * halfTraceRe W₁) *
            (∫ W₂ : SU2,
              (1 + β * halfTraceRe W₂) *
                (∫ W₃ : SU2,
                  (1 + β * halfTraceRe W₃) *
                    (∫ W₄ : SU2,
                      (1 + β * halfTraceRe W₄) *
                        halfTraceRe ((W₀ * W₁ * W₂ * W₃ * W₄)⁻¹)
                      ∂SU2.haarProbability)
                  ∂SU2.haarProbability)
              ∂SU2.haarProbability)
          ∂SU2.haarProbability)
      ∂SU2.haarProbability) =
    cubeSixFaceHaarIntegral * β ^ 4 := by
  simp_rw [halfTraceRe_inv]
  simp_rw [integral_one_add_beta_halfTraceRe_mul_halfTraceRe_left_eq]
  have h_pull (A : SU2 → ℝ) (c : ℝ) :
      (∫ g : SU2, (1 + β * halfTraceRe g) * (c * A g) ∂SU2.haarProbability) =
        c * ∫ g : SU2, (1 + β * halfTraceRe g) * A g ∂SU2.haarProbability := by
    have h_eq : (fun g : SU2 => (1 + β * halfTraceRe g) * (c * A g)) =
        fun g : SU2 => c * ((1 + β * halfTraceRe g) * A g) := by
      funext g; ring
    rw [h_eq, integral_const_mul]
  simp_rw [h_pull, integral_one_add_beta_halfTraceRe_mul_halfTraceRe_left_eq]
  simp_rw [h_pull, integral_one_add_beta_halfTraceRe_mul_halfTraceRe_left_eq]
  simp_rw [h_pull, integral_one_add_beta_halfTraceRe_mul_halfTraceRe_left_eq]
  have h_pull0 (A : SU2 → ℝ) (c : ℝ) :
      (∫ g : SU2, halfTraceRe g * (c * A g) ∂SU2.haarProbability) =
        c * ∫ g : SU2, halfTraceRe g * A g ∂SU2.haarProbability := by
    have h_eq : (fun g : SU2 => halfTraceRe g * (c * A g)) =
        fun g : SU2 => c * (halfTraceRe g * A g) := by
      funext g; ring
    rw [h_eq, integral_const_mul]
  simp_rw [h_pull0, integral_halfTraceRe_sq_eq_quarter]
  rw [cubeSixFaceHaarIntegral_eq_one_fourth_pow_five]
  ring

/-- Torus-to-3-cube cluster remainder decomposition theorem for the pure-Wilson degree-4 character
covariance floor (`wilsonMeasure_irCov_ge_of_cube_sixFace_and_cluster_remainder`):
if the pure-Wilson probe covariance `irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g` decomposes
into the exact leading 6-face unit 3-cube Haar character contribution `I_cube * β ^ 4` (where `I_cube`
is the 5-fold `SU2.haarProbability` integral in `integral_cube_sixFace_halfTraceRe_eq_one_div_1024`,
equal to `(1 / 4 : ℝ) ^ 5`) plus a torus cluster remainder `R_cluster` satisfying the `1 / 4`
relative bound `|R_cluster| ≤ (1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4)`, then
`(3 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4) ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g|`. -/
theorem wilsonMeasure_irCov_ge_of_cube_sixFace_and_cluster_remainder
    {L : ℕ} [NeZero L] {β R_cluster : ℝ}
    {f g : GaugeConfig L → ℝ}
    (h_decomp :
      let I_cube : ℝ :=
        ∫ W₀ : SU2,
          halfTraceRe W₀ *
            (∫ W₁ : SU2,
              halfTraceRe W₁ *
                (∫ W₂ : SU2,
                  halfTraceRe W₂ *
                    (∫ W₃ : SU2,
                      halfTraceRe W₃ *
                        (∫ W₄ : SU2,
                          halfTraceRe W₄ *
                            halfTraceRe ((W₀ * W₁ * W₂ * W₃ * W₄)⁻¹)
                          ∂SU2.haarProbability)
                      ∂SU2.haarProbability)
                  ∂SU2.haarProbability)
              ∂SU2.haarProbability)
          ∂SU2.haarProbability
      irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g =
        I_cube * β ^ 4 + R_cluster)
    (h_rem : |R_cluster| ≤ (1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4)) :
    ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * β ^ 4 ≤
      |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g| := by
  dsimp only at h_decomp
  rw [integral_cube_sixFace_halfTraceRe_eq_one_div_1024.1] at h_decomp
  have h_rem_lo : -((1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4)) ≤ R_cluster := (abs_le.mp h_rem).1
  have h_cov_lo :
      ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * β ^ 4 ≤
        irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g := by
    linarith
  exact h_cov_lo.trans (le_abs_self _)

/-- Linearized Boltzmann unit-cube decomposition bound for `irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g`:
if `irCov` equals the 5-fold linearized-Boltzmann 6-face unit-cube integral plus a cluster remainder
`R_cluster` bounded by `(1 / 4) * ((1 / 4) ^ 5 * β ^ 4)`, then
`((3 / 4) * (1 / 4) ^ 5) * β ^ 4 ≤ |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g|`. -/
theorem wilsonMeasure_irCov_ge_of_linearizedBoltzmann_cube_and_cluster_remainder
    {L : ℕ} [NeZero L] {β R_cluster : ℝ}
    {f g : GaugeConfig L → ℝ}
    (h_decomp :
      irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g =
        (∫ W₀ : SU2,
          halfTraceRe W₀ *
            (∫ W₁ : SU2,
              (1 + β * halfTraceRe W₁) *
                (∫ W₂ : SU2,
                  (1 + β * halfTraceRe W₂) *
                    (∫ W₃ : SU2,
                      (1 + β * halfTraceRe W₃) *
                        (∫ W₄ : SU2,
                          (1 + β * halfTraceRe W₄) *
                            halfTraceRe ((W₀ * W₁ * W₂ * W₃ * W₄)⁻¹)
                          ∂SU2.haarProbability)
                      ∂SU2.haarProbability)
                  ∂SU2.haarProbability)
              ∂SU2.haarProbability)
          ∂SU2.haarProbability) + R_cluster)
    (h_rem : |R_cluster| ≤ (1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4)) :
    ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * β ^ 4 ≤
      |irCov (wilsonMeasure (gaugeHaarMeasure L) β) f g| := by
  rw [integral_cube_sixFace_linearizedBoltzmann_eq_cubeSixFaceHaarIntegral_mul_beta_pow_four] at h_decomp
  exact wilsonMeasure_irCov_ge_of_cube_sixFace_and_cluster_remainder h_decomp h_rem

/-- Restatement: because `R_cluster` is free, `h_decomp ∧ h_rem` says exactly
`|irCov − cubeSixFaceHaarIntegral·β⁴| ≤ ¼·(1/4)^5·β⁴` eventually. The open content is that bound.
This lemma does not discharge `BalabanMultiScaleUVToIRFlow.WilsonCharFloor` (formerly the field `h_wilson_char_floor`). The witness-free form of the open bound is
`CanonicalProbeClusterRemainder`. -/
theorem eventually_wilsonMeasure_irCov_ge_of_cube_sixFace_and_cluster_remainder
    (L : ℕ → ℕ) [∀ n, NeZero (L n)] (β R_cluster : ℕ → ℝ)
    (f g : ∀ n : ℕ, GaugeConfig (L n) → ℝ)
    (h_decomp : ∀ᶠ n in atTop,
      irCov (wilsonMeasure (gaugeHaarMeasure (L n)) (β n)) (f n) (g n) =
        cubeSixFaceHaarIntegral * (β n) ^ 4 + R_cluster n)
    (h_rem : ∀ᶠ n in atTop, |R_cluster n| ≤ (1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * (β n) ^ 4)) :
    ∀ᶠ n in atTop,
      ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * (β n) ^ 4 ≤
        |irCov (wilsonMeasure (gaugeHaarMeasure (L n)) (β n)) (f n) (g n)| := by
  filter_upwards [h_decomp, h_rem] with n hd hr
  exact wilsonMeasure_irCov_ge_of_cube_sixFace_and_cluster_remainder hd hr

end InteractingEffectiveActionState

open InteractingEffectiveActionState

/-! ### Stage p3.B3 (Part 1): `wilsonProbeCov`, `CanonicalProbeClusterRemainder` (R1), and Pure-Wilson Floor Bridge -/

/-- Pure-Wilson connected covariance of the canonical spatial unit plaquette and its time reflection,
on the side-`L` torus at coupling `β`, in lattice units (spacing `1`). -/
noncomputable def wilsonProbeCov (L : ℕ) [NeZero L] (β : ℝ) : ℝ :=
  irCov (wilsonMeasure (gaugeHaarMeasure L) β)
    (physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect)
    (physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos))

theorem physicalWilsonLoop_canonicalSpatialProbe_spacing_indep (L : ℕ) {a : ℚ} (ha : 0 < a) :
    physicalWilsonLoop L (a : ℝ) (canonicalSpatialProbe a ha) =
        physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) ∧
      physicalWilsonLoop L (a : ℝ) (canonicalSpatialProbe a ha).timeReflect =
        physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect := by
  have h_steps_a := canonicalSpatialProbe_steps ha
  have h_steps_1 := canonicalSpatialProbe_steps (one_pos : (0 : ℚ) < 1)
  have h_loop :
      (canonicalSpatialProbe a ha).latticeLoop (a : ℝ) =
        (canonicalSpatialProbe 1 one_pos).latticeLoop ((1 : ℚ) : ℝ) := by
    unfold PhysicalRectangle.latticeLoop
    rw [h_steps_a.1, h_steps_a.2, h_steps_1.1, h_steps_1.2]
    rfl
  refine ⟨funext fun U => ?_, funext fun U => ?_⟩
  · unfold physicalWilsonLoop
    rw [latticeBase_canonicalSpatialProbe_eq_zero ha,
      latticeBase_canonicalSpatialProbe_eq_zero (one_pos : (0 : ℚ) < 1), h_loop]
  · unfold physicalWilsonLoop
    rw [latticeBase_timeReflect_canonicalSpatialProbe ha,
      latticeBase_timeReflect_canonicalSpatialProbe (one_pos : (0 : ℚ) < 1)]
    exact congrArg (wilsonLoop U _) h_loop

theorem wilsonProbeCov_eq (L : ℕ) [NeZero L] (β : ℝ) {a : ℚ} (ha : 0 < a) :
    irCov (wilsonMeasure (gaugeHaarMeasure L) β)
        (physicalWilsonLoop L (a : ℝ) (canonicalSpatialProbe a ha).timeReflect)
        (physicalWilsonLoop L (a : ℝ) (canonicalSpatialProbe a ha)) = wilsonProbeCov L β := by
  obtain ⟨h1, h2⟩ := physicalWilsonLoop_canonicalSpatialProbe_spacing_indep L ha
  rw [h1, h2]
  rfl

/-- RESEARCH TARGET: (R1, strong-coupling cluster remainder for the canonical probe.) For every torus
side `L ≥ 4` and every coupling `0 < β ≤ β₀`, the pure-Wilson probe covariance `wilsonProbeCov L β`
differs from its leading unit-cube term `cubeSixFaceHaarIntegral * β ^ 4` by at most a quarter of
that term. Status: UNKNOWN in Lean. Expected true for small `β₀` (convergent strong-coupling
character expansion; the unit cube between `Θp` and `p` is the unique minimal closing surface);
not proved here. Only instances with `β₀ ≥ canonicalCrossoverBetaHi` are used below. -/
def CanonicalProbeClusterRemainder (β₀ : ℝ) : Prop :=
  ∀ (L : ℕ) [NeZero L], 4 ≤ L → ∀ β : ℝ, 0 < β → β ≤ β₀ →
    |wilsonProbeCov L β - cubeSixFaceHaarIntegral * β ^ 4| ≤
      (1 / 4 : ℝ) * ((1 / 4 : ℝ) ^ 5 * β ^ 4)

/-- DEGENERACY: for `β₀ ≤ 0` the statement is vacuously true. Only `0 < β₀` instances carry content. -/
theorem canonicalProbeClusterRemainder_of_nonpos {β₀ : ℝ} (h : β₀ ≤ 0) :
    CanonicalProbeClusterRemainder β₀ := by
  intro L _ _ β hβ hβ₀
  linarith

theorem CanonicalProbeClusterRemainder.mono {β₀ β₁ : ℝ} (h : β₁ ≤ β₀)
    (hR : CanonicalProbeClusterRemainder β₀) : CanonicalProbeClusterRemainder β₁ :=
  fun L _ hL β hβ hβ₁ => hR L hL β hβ (hβ₁.trans h)

