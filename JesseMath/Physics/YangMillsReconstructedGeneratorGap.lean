/-- All 6 faces of the canonical unit 3-cube belong to `cubeTouchPlaquettes L` (`L ≥ 1`). -/
theorem cubeSixFaceFinset_subset_cubeTouchPlaquettes (L : ℕ) [NeZero L] :
    cubeSixFaceFinset L ⊆ cubeTouchPlaquettes L := by
