/-- Exact evaluation `probeLoopOscillationBudget (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar) = 16`
    for any `ℓstar : ℚ` with `0 < ℓstar`. -/
theorem probeLoopOscillationBudget_canonicalSpatialProbe_eq_sixteen
    (ℓstar : ℚ) (hℓstar : 0 < ℓstar) :
    InteractingEffectiveActionState.probeLoopOscillationBudget (ℓstar : ℝ)
      (canonicalSpatialProbe ℓstar hℓstar) = 16 := by
  obtain ⟨hμ, hν⟩ := canonicalSpatialProbe_steps hℓstar
  have h_ref_eq :
      ((canonicalSpatialProbe ℓstar hℓstar).timeReflect.latticeLoop (ℓstar : ℝ)).length =
        ((canonicalSpatialProbe ℓstar hℓstar).latticeLoop (ℓstar : ℝ)).length := rfl
  have h_len : ((canonicalSpatialProbe ℓstar hℓstar).latticeLoop (ℓstar : ℝ)).length = 4 := by
    simp only [PhysicalRectangle.latticeLoop, rectangleSteps, List.length_append,
      List.length_replicate, hμ, hν]
