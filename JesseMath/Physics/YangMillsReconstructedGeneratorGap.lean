/-- Exact 2-replica local-exterior factorization of `wilsonProbeCov L β` (`L ≥ 2`, `0 ≤ β`):
separates the local exponential factor `exp (β * (cubeTouchCharacterSum U + cubeTouchCharacterSum U'))`
(whose exponent has uniform pointwise magnitude `≤ 288 * β ≤ 1 / 24`) from the `cubeLinks`-invariant
exterior product weight `cubeExteriorBoltzmannWeight β U * cubeExteriorBoltzmannWeight β U'`. -/
theorem wilsonProbeCov_eq_iterated_replica_local_touch_mul_exterior_div_characterPartition_sq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ : 0 ≤ β) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    wilsonProbeCov L β =
      (∫ U : GaugeConfig L,
        (∫ U' : GaugeConfig L,
          Real.exp (β * (cubeTouchCharacterSum U + cubeTouchCharacterSum U')) *
            (cubeExteriorBoltzmannWeight β U * cubeExteriorBoltzmannWeight β U') *
            fΘ U * (fp U - fp U') ∂(gaugeHaarMeasure L))
        ∂(gaugeHaarMeasure L)) /
        (characterPartition L β ^ 2) := by
  dsimp only
  rw [(wilsonProbeCov_eq_iterated_replica_div_characterPartition_sq hL hβ).2]
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
  dsimp only
  refine integral_congr_ae (Filter.Eventually.of_forall fun U' => ?_)
  dsimp only
  rw [characterBoltzmannWeight_eq_exp_cubeTouch_mul_cubeExteriorBoltzmannWeight β U,
      characterBoltzmannWeight_eq_exp_cubeTouch_mul_cubeExteriorBoltzmannWeight β U',
      mul_add, Real.exp_add]
  ring

/-! ### Stage p3.B3 (Part 6): Exterior-Weighted 6-Face Haar Reduction and Degree-`0..4` Connected Cancellation

Under the `cubeLinks`-invariant exterior Boltzmann weight `cubeExteriorBoltzmannWeight β U`, the
five single-link Haar integrations of `integral_gaugeHaarMeasure_cubeSixFace_general_eq` and all
probe boundary-link updates/twists leave the exterior weight strictly unchanged. Consequently,
for all `β ∈ ℝ` and `L ≥ 3`, the local Taylor coefficients of `cubeTouchCharacterSum U` against
`cubeExteriorBoltzmannWeight β U` satisfy `C_0^ext = C_1^ext = C_2^ext = C_3^ext = 0` and
`C_4^ext = cubeSixFaceHaarIntegral * (cubeExteriorPartition L β ^ 2)`. -/

theorem cubeExteriorBoltzmannWeight_update_of_mem_cubeLinks
    {L : ℕ} [NeZero L] (β : ℝ) (U : GaugeConfig L) {e : Link L}
    (he : e ∈ cubeLinks L) (g : SU2) :
    cubeExteriorBoltzmannWeight β (updateGaugeLink L U e.x e.μ g) =
      cubeExteriorBoltzmannWeight β U := by
  unfold cubeExteriorBoltzmannWeight
  rw [cubeExteriorCharacterSum_update_of_mem_cubeLinks U he g]

theorem cubeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_cubeLinks
    {L : ℕ} [NeZero L] (β : ℝ) (U : GaugeConfig L) {e : Link L}
    (he : e ∈ cubeLinks L) :
    cubeExteriorBoltzmannWeight β (twistLinkNegOne e U) =
      cubeExteriorBoltzmannWeight β U := by
  unfold cubeExteriorBoltzmannWeight
  rw [cubeExteriorCharacterSum_twistLinkNegOne_of_mem_cubeLinks U he]

theorem plaquetteLinkAt_cubeBottomPlaquette_mem_cubeLinks (L : ℕ) (k : Fin 4) :
    plaquetteLinkAt (cubeBottomPlaquette L) k ∈ cubeLinks L :=
  plaquetteLinks_subset_cubeLinks_of_mem_cubeSixFaceFinset
    (by simp [cubeSixFaceFinset]) (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)

theorem plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks (L : ℕ) (k : Fin 4) :
    plaquetteLinkAt (cubeTopPlaquette L) k ∈ cubeLinks L :=
  plaquetteLinks_subset_cubeLinks_of_mem_cubeSixFaceFinset
    (by simp [cubeSixFaceFinset]) (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)

theorem updateGaugeLink_self {L : ℕ} (U : GaugeConfig L) (e : Link L) :
    updateGaugeLink L U e.x e.μ (U e) = U := by
  funext f
  by_cases hf : f = e
  · subst hf; exact (updateGaugeLink_same_and_other L U f.x f.μ (U f)).1
  · exact (updateGaugeLink_same_and_other L U e.x e.μ (U e)).2 f hf

theorem halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks
    {L : ℕ} (hL : 2 ≤ L) (U : GaugeConfig L) (p : Plaquette L)
    {e : Link L} (he : e ∈ plaquetteLinks p) :
    halfTraceRe (plaquetteHolonomy (twistLinkNegOne e U) p) =
      - halfTraceRe (plaquetteHolonomy U p) := by
  have h_mul (C g : SU2) : halfTraceRe (C * (negOne * g)) = - halfTraceRe (C * g) := by
    rw [← mul_assoc, ← negOne_mul_comm C, mul_assoc,
        YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul]
  rw [twistLinkNegOne_eq_updateGaugeLink e U]
  conv_rhs => rw [← updateGaugeLink_self U e]
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl
  · rw [halfTraceRe_plaquetteHolonomy_update_first hL U p,
        halfTraceRe_plaquetteHolonomy_update_first hL U p, h_mul]
  · rw [halfTraceRe_plaquetteHolonomy_update_second hL U p,
        halfTraceRe_plaquetteHolonomy_update_second hL U p, h_mul]
  · rw [halfTraceRe_plaquetteHolonomy_update_third hL U p,
        halfTraceRe_plaquetteHolonomy_update_third hL U p, h_mul]
  · rw [halfTraceRe_plaquetteHolonomy_update_fourth hL U p,
        halfTraceRe_plaquetteHolonomy_update_fourth hL U p, h_mul]

private theorem integral_add_cont {L : ℕ} [NeZero L]
    {f g : GaugeConfig L → ℝ} (hf : Continuous f) (hg : Continuous g) :
    (∫ U : GaugeConfig L, (f U + g U) ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, f U ∂(gaugeHaarMeasure L)) +
      (∫ U : GaugeConfig L, g U ∂(gaugeHaarMeasure L)) :=
  integral_add_apply f g hf hg

private theorem integral_sub_cont {L : ℕ} [NeZero L]
    {f g : GaugeConfig L → ℝ} (hf : Continuous f) (hg : Continuous g) :
    (∫ U : GaugeConfig L, (f U - g U) ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, f U ∂(gaugeHaarMeasure L)) -
      (∫ U : GaugeConfig L, g U ∂(gaugeHaarMeasure L)) :=
  integral_sub_apply f g hf hg

private theorem integral_add3_cont {L : ℕ} [NeZero L]
    {f₁ f₂ f₃ : GaugeConfig L → ℝ}
    (h₁ : Continuous f₁) (h₂ : Continuous f₂) (h₃ : Continuous f₃) :
    (∫ U : GaugeConfig L, ((f₁ U + f₂ U) + f₃ U) ∂(gaugeHaarMeasure L)) =
      ((∫ U : GaugeConfig L, f₁ U ∂(gaugeHaarMeasure L)) +
        (∫ U : GaugeConfig L, f₂ U ∂(gaugeHaarMeasure L))) +
      (∫ U : GaugeConfig L, f₃ U ∂(gaugeHaarMeasure L)) :=
  integral_add3_apply f₁ f₂ f₃ h₁ h₂ h₃

private theorem integral_add4_cont {L : ℕ} [NeZero L]
    {f₁ f₂ f₃ f₄ : GaugeConfig L → ℝ}
    (h₁ : Continuous f₁) (h₂ : Continuous f₂) (h₃ : Continuous f₃) (h₄ : Continuous f₄) :
    (∫ U : GaugeConfig L, (((f₁ U + f₂ U) + f₃ U) + f₄ U) ∂(gaugeHaarMeasure L)) =
      (((∫ U : GaugeConfig L, f₁ U ∂(gaugeHaarMeasure L)) +
        (∫ U : GaugeConfig L, f₂ U ∂(gaugeHaarMeasure L))) +
        (∫ U : GaugeConfig L, f₃ U ∂(gaugeHaarMeasure L))) +
      (∫ U : GaugeConfig L, f₄ U ∂(gaugeHaarMeasure L)) :=
  integral_add4_apply f₁ f₂ f₃ f₄ h₁ h₂ h₃ h₄

private theorem integral_add5_cont {L : ℕ} [NeZero L]
    {f₁ f₂ f₃ f₄ f₅ : GaugeConfig L → ℝ}
    (h₁ : Continuous f₁) (h₂ : Continuous f₂) (h₃ : Continuous f₃)
    (h₄ : Continuous f₄) (h₅ : Continuous f₅) :
    (∫ U : GaugeConfig L, ((((f₁ U + f₂ U) + f₃ U) + f₄ U) + f₅ U) ∂(gaugeHaarMeasure L)) =
      ((((∫ U : GaugeConfig L, f₁ U ∂(gaugeHaarMeasure L)) +
        (∫ U : GaugeConfig L, f₂ U ∂(gaugeHaarMeasure L))) +
        (∫ U : GaugeConfig L, f₃ U ∂(gaugeHaarMeasure L))) +
        (∫ U : GaugeConfig L, f₄ U ∂(gaugeHaarMeasure L))) +
      (∫ U : GaugeConfig L, f₅ U ∂(gaugeHaarMeasure L)) :=
  integral_add5_apply f₁ f₂ f₃ f₄ f₅ h₁ h₂ h₃ h₄ h₅

theorem integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq
    {L : ℕ} [NeZero L] (e : Link L) {H F G : GaugeConfig L → ℝ}
    (hH : Continuous H) (hF : Continuous F)
    (hH_inv : ∀ (U : GaugeConfig L) (g : SU2), H (updateGaugeLink L U e.x e.μ g) = H U)
    (hFG : ∀ U : GaugeConfig L,
      (∫ g : SU2, F (updateGaugeLink L U e.x e.μ g) ∂SU2.haarProbability) = G U) :
    (∫ U : GaugeConfig L, H U * F U ∂(gaugeHaarMeasure L)) =
      ∫ U : GaugeConfig L, H U * G U ∂(gaugeHaarMeasure L) := by
  rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous e
        (fun U => H U * F U) (hH.mul hF)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
  dsimp only
  simp_rw [hH_inv U, integral_const_mul, hFG U]

theorem integral_gaugeHaarMeasure_mul_four_plaquetteHolonomy_sq_sub_one_eq_zero_of_mem_plaquetteLinks
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (p : Plaquette L)
    (e : Link L) (he : e ∈ plaquetteLinks p)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ (U : GaugeConfig L) (g : SU2), H (updateGaugeLink L U e.x e.μ g) = H U) :
    (∫ U : GaugeConfig L,
      H U * (4 * (halfTraceRe (plaquetteHolonomy U p)) ^ 2 - 1) ∂(gaugeHaarMeasure L)) = 0 := by
  have hp : Continuous (fun U : GaugeConfig L => halfTraceRe (plaquetteHolonomy U p)) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p)
  rw [integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq e
        (F := fun U => 4 * (halfTraceRe (plaquetteHolonomy U p)) ^ 2 - 1)
        (G := fun _ => 0)
        hH_cont ((continuous_const.mul (hp.pow 2)).sub continuous_const) hH_inv]
  · simp
  · intro U
    have h_int : Integrable (fun g : SU2 =>
        4 * (halfTraceRe (plaquetteHolonomy (updateGaugeLink L U e.x e.μ g) p)) ^ 2)
        SU2.haarProbability := by
      refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
      fun_prop
    rw [integral_sub h_int (integrable_const 1), integral_const_mul,
        integral_plaquetteHolonomy_sq_update_eq_quarter_of_mem_plaquetteLinks hL U p he,
        integral_const, probReal_univ, one_smul]
    norm_num

theorem integral_gaugeHaarMeasure_mul_eq_zero_of_twistLinkNegOne_neg
    {L : ℕ} [NeZero L] (e : Link L) {H F : GaugeConfig L → ℝ}
    (hH : Continuous H) (hF : Continuous F)
    (hH_inv : ∀ U : GaugeConfig L, H (twistLinkNegOne e U) = H U)
    (hF_neg : ∀ U : GaugeConfig L, F (twistLinkNegOne e U) = - F U) :
    (∫ U : GaugeConfig L, H U * F U ∂(gaugeHaarMeasure L)) = 0 := by
  refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg e (hH.mul hF) (fun U => ?_)
  rw [hH_inv U, hF_neg U, mul_neg]

theorem integral_mul_finsetSum_plaquette_eq_zero
    {L : ℕ} [NeZero L] (S : Finset (Plaquette L))
    (F : GaugeConfig L → ℝ) (hF : Continuous F)
    (h_zero : ∀ q ∈ S,
      (∫ U : GaugeConfig L, F U * halfTraceRe (plaquetteHolonomy U q) ∂(gaugeHaarMeasure L)) = 0) :
    (∫ U : GaugeConfig L,
      F U * (∑ q ∈ S, halfTraceRe (plaquetteHolonomy U q)) ∂(gaugeHaarMeasure L)) = 0 := by
  have h_pt :
      (fun U : GaugeConfig L => F U * ∑ q ∈ S, halfTraceRe (plaquetteHolonomy U q)) =
      fun U : GaugeConfig L => ∑ q ∈ S, F U * halfTraceRe (plaquetteHolonomy U q) := by
    funext U; exact Finset.mul_sum _ _ _
  rw [h_pt, integral_finsetSum]
  · exact Finset.sum_eq_zero h_zero
  · intro q _
    exact (hF.mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)

/-- `cubeLinks`-invariant weighted 6-face Haar reduction (`L ≥ 2`):
for any continuous weight `H : GaugeConfig L → ℝ` invariant under updating links in `cubeLinks L`,
the 6-face integral reduces to `(∫ U, H U ∂(gaugeHaarMeasure L)) * (cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄))`. -/
theorem integral_gaugeHaarMeasure_mul_cubeSixFace_general_eq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ e ∈ cubeLinks L, ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U e.x e.μ g) = H U)
    (α₁ α₂ α₃ α₄ β₁ β₂ β₃ β₄ : ℝ) :
    (∫ U : GaugeConfig L,
      H U *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
          (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
          (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
          (α₄ + β₄ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L))) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) =
    (∫ U : GaugeConfig L, H U ∂(gaugeHaarMeasure L)) *
      (cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄)) := by
  let F₄ : GaugeConfig L → ℝ := fun U =>
    halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
      (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
      (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
      (α₄ + β₄ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L))) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
  let F₃ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
        halfTraceRe
          (U ⟨shift 0 2, 1⟩ * (U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ *
            (U ⟨cubeBottomBase L, 0⟩)⁻¹ * U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 0⟩))
  let F₂ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) * (β₃ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        halfTraceRe
          ((U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 0⟩)⁻¹ *
            U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 1⟩ *
            U ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩))
  let F₁ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) * (β₃ / 4) * (β₂ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        halfTraceRe
          (U ⟨0, 1⟩ * (U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * U ⟨shift (cubeBottomBase L) 1, 2⟩ *
            (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
            U ⟨cubeBottomBase L, 0⟩))
  let F₀ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) * (β₃ / 4) * (β₂ / 4) * (β₁ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
  have hF₄_cont : Continuous F₄ := by dsimp [F₄]; fun_prop
  have hF₃_cont : Continuous F₃ := by dsimp [F₃]; fun_prop
  have hF₂_cont : Continuous F₂ := by dsimp [F₂]; fun_prop
  have hF₁_cont : Continuous F₁ := by dsimp [F₁]; fun_prop
  have hF₀_cont : Continuous F₀ := by dsimp [F₀]; fun_prop
  have h_step4 : (∫ U, H U * F₄ U ∂(gaugeHaarMeasure L)) = ∫ U, H U * F₃ U ∂(gaugeHaarMeasure L) := by
    refine integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq ⟨0, 2⟩ hH_cont hF₄_cont
      (hH_inv ⟨0, 2⟩ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 3)) (fun U => ?_)
    have h_eq (g : SU2) :
        F₄ (updateGaugeLink L U 0 2 g) =
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
            (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
            (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L)))) *
          ((α₄ + β₄ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeLateralPlaquette4 L))) *
            halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeTopPlaquette L))) := by
      dsimp [F₄]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U 0 rfl 2 g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette1 L) rfl rfl 0 g,
          plaquetteHolonomy_cubeLateralPlaquette2_update_topLink4 hL U g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette3 L) rfl rfl 0 g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink4_cubeLateral4_mul_cubeTop hL α₄ β₄ U]
    dsimp [F₃]; ring
  have h_step3 : (∫ U, H U * F₃ U ∂(gaugeHaarMeasure L)) = ∫ U, H U * F₂ U ∂(gaugeHaarMeasure L) := by
    refine integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq ⟨shift 0 2, 1⟩ hH_cont hF₃_cont
      (hH_inv ⟨shift 0 2, 1⟩ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 2)) (fun U => ?_)
    have h_eq (g : SU2) :
        F₃ (updateGaugeLink L U (shift 0 2) 1 g) =
          ((β₄ / 4) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
              (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))))) *
          ((α₃ + β₃ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 2) 1 g) (cubeLateralPlaquette3 L))) *
            halfTraceRe
              (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 2, 1⟩ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 1, 2⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨0, 1⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
                updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 2⟩ *
                updateGaugeLink L U (shift 0 2) 1 g ⟨shift (cubeBottomBase L) 2, 0⟩)) := by
      dsimp [F₃]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U (shift 0 2) (by simp [shift, unitVec]) 1 g,
          plaquetteHolonomy_cubeLateralPlaquette1_update_topLink3 hL U g,
          plaquetteHolonomy_of_plane02_update_dir1 U (cubeLateralPlaquette2 L) rfl rfl (shift 0 2) g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink3_cubeLateral3_mul_step1 hL α₃ β₃ U]
    dsimp [F₂]; ring
  have h_step2 : (∫ U, H U * F₂ U ∂(gaugeHaarMeasure L)) = ∫ U, H U * F₁ U ∂(gaugeHaarMeasure L) := by
    refine integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq ⟨shift 0 1, 2⟩ hH_cont hF₂_cont
      (hH_inv ⟨shift 0 1, 2⟩ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 1)) (fun U => ?_)
    have h_eq (g : SU2) :
        F₂ (updateGaugeLink L U (shift 0 1) 2 g) =
          ((β₄ / 4) * (β₃ / 4) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))))) *
          ((α₂ + β₂ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 1) 2 g) (cubeLateralPlaquette2 L))) *
            halfTraceRe
              ((updateGaugeLink L U (shift 0 1) 2 g ⟨shift 0 1, 2⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 1) 2 g ⟨0, 1⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 2⟩ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨shift (cubeBottomBase L) 2, 1⟩ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)) := by
      dsimp [F₂]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U (shift 0 1) (by simp [shift, unitVec]) 2 g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette1 L) rfl rfl (shift 0 1) g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink2_cubeLateral2_mul_step2 hL α₂ β₂ U]
    dsimp [F₁]; ring
  have h_step1 : (∫ U, H U * F₁ U ∂(gaugeHaarMeasure L)) = ∫ U, H U * F₀ U ∂(gaugeHaarMeasure L) := by
    refine integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq ⟨0, 1⟩ hH_cont hF₁_cont
      (hH_inv ⟨0, 1⟩ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 0)) (fun U => ?_)
    have h_eq (g : SU2) :
        F₁ (updateGaugeLink L U 0 1 g) =
          ((β₄ / 4) * (β₃ / 4) * (β₂ / 4) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
          ((α₁ + β₁ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 1 g) (cubeLateralPlaquette1 L))) *
            halfTraceRe
              (updateGaugeLink L U 0 1 g ⟨0, 1⟩ *
                (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ *
                updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 2⟩ *
                (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
                (updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 2⟩)⁻¹ *
                updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 0⟩)) := by
      dsimp [F₁]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U 0 rfl 1 g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink1_cubeLateral1_mul_step3 hL α₁ β₁ U]
    dsimp [F₀]; ring
  have h_step0 :
      (∫ U, H U * F₀ U ∂(gaugeHaarMeasure L)) =
        (∫ U, H U ∂(gaugeHaarMeasure L)) * (cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄)) := by
    rw [integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq ⟨cubeBottomBase L, 1⟩ hH_cont hF₀_cont
          (hH_inv ⟨cubeBottomBase L, 1⟩ (plaquetteLinkAt_cubeBottomPlaquette_mem_cubeLinks L 0))
          (G := fun _ => cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄))]
    · exact integral_mul_const _ _
    · intro U
      dsimp [F₀]
      rw [integral_const_mul, integral_bottomLink1_cubeBottom_sq hL U,
          cubeSixFaceHaarIntegral_eq_one_fourth_pow_five]
      ring
  change (∫ U, H U * F₄ U ∂(gaugeHaarMeasure L)) =
    (∫ U, H U ∂(gaugeHaarMeasure L)) * (cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄))
  rw [h_step4, h_step3, h_step2, h_step1, h_step0]

/-- Non-probe local touching plaquette finset `cubeTouchPlaquettes L \ {cubeBottomPlaquette L, cubeTopPlaquette L}`. -/
def restTouchPlaquettes (L : ℕ) [NeZero L] : Finset (Plaquette L) :=
  (cubeTouchPlaquettes L).filter (fun q => q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)

noncomputable def restTouchCharacterSum {L : ℕ} [NeZero L] (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ restTouchPlaquettes L, halfTraceRe (plaquetteHolonomy U q)

@[continuity, fun_prop]
theorem continuous_restTouchCharacterSum {L : ℕ} [NeZero L] :
    Continuous (restTouchCharacterSum (L := L)) := by
  unfold restTouchCharacterSum
  fun_prop

theorem restTouchPlaquettes_subset_restPlaquettes (L : ℕ) [NeZero L] :
    restTouchPlaquettes L ⊆ restPlaquettes L := by
  intro q hq
  simp only [restTouchPlaquettes, restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq ⊢
  exact hq.2

theorem cubeLateralSet_subset_restTouchPlaquettes (L : ℕ) [NeZero L] :
    cubeLateralSet L ⊆ restTouchPlaquettes L := by
  intro q hq
  simp only [restTouchPlaquettes, Finset.mem_filter]
  refine ⟨cubeSixFaceFinset_subset_cubeTouchPlaquettes L ?_, ?_⟩
  · simp only [cubeLateralSet, Finset.mem_insert, Finset.mem_singleton] at hq
    rcases hq with rfl | rfl | rfl | rfl <;> simp [cubeSixFaceFinset, cubeLateralSet]
  · have h_rest := cubeLateralSet_subset_restPlaquettes L hq
    simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at h_rest
    exact h_rest

theorem cubeTouchCharacterSum_eq_probeSum_add_restTouchCharacterSum
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (U : GaugeConfig L) :
    cubeTouchCharacterSum U =
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
      restTouchCharacterSum U := by
  unfold cubeTouchCharacterSum restTouchCharacterSum restTouchPlaquettes
  have h_split := (Finset.sum_filter_add_sum_filter_not (s := cubeTouchPlaquettes L)
    (p := fun q : Plaquette L => q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)
    (f := fun q => halfTraceRe (plaquetteHolonomy U q))).symm
  have h_bot_mem : cubeBottomPlaquette L ∈ cubeTouchPlaquettes L :=
    cubeSixFaceFinset_subset_cubeTouchPlaquettes L (by simp [cubeSixFaceFinset])
  have h_top_mem : cubeTopPlaquette L ∈ cubeTouchPlaquettes L :=
    cubeSixFaceFinset_subset_cubeTouchPlaquettes L (by simp [cubeSixFaceFinset])
  have h_compl :
      (cubeTouchPlaquettes L).filter (fun q : Plaquette L => ¬(q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)) =
        {cubeBottomPlaquette L, cubeTopPlaquette L} := by
    ext q
    simp only [Finset.mem_filter, not_and_or, not_ne_iff, Finset.mem_insert, Finset.mem_singleton]
    constructor
    · rintro ⟨_, h⟩; exact h
    · rintro (rfl | rfl)
      · exact ⟨h_bot_mem, Or.inl rfl⟩
      · exact ⟨h_top_mem, Or.inr rfl⟩
  rw [h_split, h_compl, Finset.sum_pair (cubeBottomPlaquette_ne_cubeTopPlaquette hL), add_comm]

theorem integral_mul_probeTemplate_eq_zero
    {L : ℕ} [NeZero L] (hL : 2 ≤ L)
    (k_bot k_top : Fin 4)
    (M : GaugeConfig L → ℝ) (hM_cont : Continuous M)
    (hM_upd_bot : ∀ (U : GaugeConfig L) (g : SU2),
      M (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k_bot).x
          (plaquetteLinkAt (cubeBottomPlaquette L) k_bot).μ g) = M U)
    (hM_upd_top : ∀ (U : GaugeConfig L) (g : SU2),
      M (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k_top).x
          (plaquetteLinkAt (cubeTopPlaquette L) k_top).μ g) = M U)
    (P₁ P₂ : ℝ → ℝ → ℝ) (hP₁ : Continuous (Function.uncurry P₁)) (hP₂ : Continuous (Function.uncurry P₂))
    (Q₁ Q₂ : ℝ → ℝ) (hQ₁ : Continuous Q₁) (hQ₂ : Continuous Q₂) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    (∫ U : GaugeConfig L,
      M U *
        (t U * P₁ (b U) (t U ^ 2) +
          b U * P₂ (b U ^ 2) (t U) +
          Q₁ (b U) * (4 * t U ^ 2 - 1) +
          Q₂ (t U) * (4 * b U ^ 2 - 1))
      ∂(gaugeHaarMeasure L)) = 0 := by
  intro b t
  have hb : Continuous b := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht : Continuous t := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  let e_bot := plaquetteLinkAt (cubeBottomPlaquette L) k_bot
  let e_top := plaquetteLinkAt (cubeTopPlaquette L) k_top
  have he_bot_mem : e_bot ∈ plaquetteLinks (cubeBottomPlaquette L) :=
    plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k_bot
  have he_top_mem : e_top ∈ plaquetteLinks (cubeTopPlaquette L) :=
    plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k_top
  have he_bot_not_top : e_bot ∉ plaquetteLinks (cubeTopPlaquette L) :=
    not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL he_bot_mem
  have he_top_not_bot : e_top ∉ plaquetteLinks (cubeBottomPlaquette L) :=
    not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL he_top_mem
  have h1_cont : Continuous (fun U => M U * (t U * P₁ (b U) (t U ^ 2))) :=
    hM_cont.mul (ht.mul (hP₁.comp (hb.prodMk (ht.pow 2))))
  have h2_cont : Continuous (fun U => M U * (b U * P₂ (b U ^ 2) (t U))) :=
    hM_cont.mul (hb.mul (hP₂.comp ((hb.pow 2).prodMk ht)))
  have h3_cont : Continuous (fun U => M U * (Q₁ (b U) * (4 * t U ^ 2 - 1))) :=
    hM_cont.mul ((hQ₁.comp hb).mul ((continuous_const.mul (ht.pow 2)).sub continuous_const))
  have h4_cont : Continuous (fun U => M U * (Q₂ (t U) * (4 * b U ^ 2 - 1))) :=
    hM_cont.mul ((hQ₂.comp ht).mul ((continuous_const.mul (hb.pow 2)).sub continuous_const))
  have h1_zero : (∫ U, M U * (t U * P₁ (b U) (t U ^ 2)) ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg e_top h1_cont (fun U => ?_)
    have hM_tw : M (twistLinkNegOne e_top U) = M U := by
      rw [twistLinkNegOne_eq_updateGaugeLink]; exact hM_upd_top U _
    have hb_tw : b (twistLinkNegOne e_top U) = b U :=
      congrArg halfTraceRe (plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ he_top_not_bot)
    have ht_sq : t (twistLinkNegOne e_top U) ^ 2 = t U ^ 2 :=
      halfTraceRe_plaquetteHolonomy_twistLinkNegOne_sq e_top U (cubeTopPlaquette L)
    have ht_tw : t (twistLinkNegOne e_top U) = - t U :=
      halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL U (cubeTopPlaquette L) he_top_mem
    rw [hM_tw, hb_tw, ht_sq, ht_tw]; ring
  have h2_zero : (∫ U, M U * (b U * P₂ (b U ^ 2) (t U)) ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg e_bot h2_cont (fun U => ?_)
    have hM_tw : M (twistLinkNegOne e_bot U) = M U := by
      rw [twistLinkNegOne_eq_updateGaugeLink]; exact hM_upd_bot U _
    have ht_tw : t (twistLinkNegOne e_bot U) = t U :=
      congrArg halfTraceRe (plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ he_bot_not_top)
    have hb_sq : b (twistLinkNegOne e_bot U) ^ 2 = b U ^ 2 :=
      halfTraceRe_plaquetteHolonomy_twistLinkNegOne_sq e_bot U (cubeBottomPlaquette L)
    have hb_tw : b (twistLinkNegOne e_bot U) = - b U :=
      halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL U (cubeBottomPlaquette L) he_bot_mem
    rw [hM_tw, ht_tw, hb_sq, hb_tw]; ring
  have h3_zero : (∫ U, M U * (Q₁ (b U) * (4 * t U ^ 2 - 1)) ∂(gaugeHaarMeasure L)) = 0 := by
    have h_assoc : (fun U => M U * (Q₁ (b U) * (4 * t U ^ 2 - 1))) =
        fun U => (M U * Q₁ (b U)) * (4 * t U ^ 2 - 1) := by funext U; ring
    rw [h_assoc]
    refine integral_gaugeHaarMeasure_mul_four_plaquetteHolonomy_sq_sub_one_eq_zero_of_mem_plaquetteLinks
      hL (cubeTopPlaquette L) e_top he_top_mem _ (hM_cont.mul (hQ₁.comp hb)) (fun U g => ?_)
    dsimp only [b]
    rw [hM_upd_top U g, plaquetteHolonomy_update_of_not_mem_plaquetteLinks U _ he_top_not_bot g]
  have h4_zero : (∫ U, M U * (Q₂ (t U) * (4 * b U ^ 2 - 1)) ∂(gaugeHaarMeasure L)) = 0 := by
    have h_assoc : (fun U => M U * (Q₂ (t U) * (4 * b U ^ 2 - 1))) =
        fun U => (M U * Q₂ (t U)) * (4 * b U ^ 2 - 1) := by funext U; ring
    rw [h_assoc]
    refine integral_gaugeHaarMeasure_mul_four_plaquetteHolonomy_sq_sub_one_eq_zero_of_mem_plaquetteLinks
      hL (cubeBottomPlaquette L) e_bot he_bot_mem _ (hM_cont.mul (hQ₂.comp ht)) (fun U g => ?_)
    dsimp only [t]
    rw [hM_upd_bot U g, plaquetteHolonomy_update_of_not_mem_plaquetteLinks U _ he_bot_not_top g]
  have h_pt :
      (fun U => M U * (t U * P₁ (b U) (t U ^ 2) + b U * P₂ (b U ^ 2) (t U) +
          Q₁ (b U) * (4 * t U ^ 2 - 1) + Q₂ (t U) * (4 * b U ^ 2 - 1))) =
      fun U =>
        ((M U * (t U * P₁ (b U) (t U ^ 2)) + M U * (b U * P₂ (b U ^ 2) (t U))) +
          M U * (Q₁ (b U) * (4 * t U ^ 2 - 1))) +
          M U * (Q₂ (t U) * (4 * b U ^ 2 - 1)) := by
    funext U; ring
  rw [h_pt, integral_add4_cont h1_cont h2_cont h3_cont h4_cont,
      h1_zero, h2_zero, h3_zero, h4_zero]
  ring

theorem integral_mul_triple_probeTemplate_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ e ∈ cubeLinks L, ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U e.x e.μ g) = H U)
    {m : ℕ} (hm : m ≤ 3) (Q : Fin m → Plaquette L)
    (hQ : ∀ j : Fin m, Q j ∈ restPlaquettes L)
    (P₁ P₂ : ℝ → ℝ → ℝ) (hP₁ : Continuous (Function.uncurry P₁)) (hP₂ : Continuous (Function.uncurry P₂))
    (Q₁ Q₂ : ℝ → ℝ) (hQ₁ : Continuous Q₁) (hQ₂ : Continuous Q₂) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    (∫ U : GaugeConfig L,
      (H U * ∏ j : Fin m, halfTraceRe (plaquetteHolonomy U (Q j))) *
        (t U * P₁ (b U) (t U ^ 2) +
          b U * P₂ (b U ^ 2) (t U) +
          Q₁ (b U) * (4 * t U ^ 2 - 1) +
          Q₂ (t U) * (4 * b U ^ 2 - 1))
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  have hQ_bot : ∀ j : Fin m, Q j ≠ cubeBottomPlaquette L := fun j => by
    have h := hQ j; simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at h; exact h.1
  have hQ_top : ∀ j : Fin m, Q j ≠ cubeTopPlaquette L := fun j => by
    have h := hQ j; simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at h; exact h.2
  obtain ⟨k_bot, hk_bot⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL (cubeBottomPlaquette L) hm Q hQ_bot
  obtain ⟨k_top, hk_top⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL (cubeTopPlaquette L) hm Q hQ_top
  have h_prod_cont : Continuous (fun U : GaugeConfig L => ∏ j : Fin m, halfTraceRe (plaquetteHolonomy U (Q j))) :=
    continuous_finsetProd _ (fun j _ => continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (Q j)))
  refine integral_mul_probeTemplate_eq_zero hL2 k_bot k_top
    (fun U : GaugeConfig L => H U * ∏ j : Fin m, halfTraceRe (plaquetteHolonomy U (Q j)))
    (hH_cont.mul h_prod_cont)
    (fun U g => congrArg₂ (· * ·)
      (hH_inv (plaquetteLinkAt (cubeBottomPlaquette L) k_bot)
        (plaquetteLinkAt_cubeBottomPlaquette_mem_cubeLinks L k_bot) U g)
      (Finset.prod_congr rfl fun j _ =>
        congrArg halfTraceRe (plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (Q j) (hk_bot j) g)))
    (fun U g => congrArg₂ (· * ·)
      (hH_inv (plaquetteLinkAt (cubeTopPlaquette L) k_top)
        (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L k_top) U g)
      (Finset.prod_congr rfl fun j _ =>
        congrArg halfTraceRe (plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (Q j) (hk_top j) g)))
    P₁ P₂ hP₁ hP₂ Q₁ Q₂ hQ₁ hQ₂

theorem integral_mul_restTouchCharacterSum_pow_probeTemplate_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ e ∈ cubeLinks L, ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U e.x e.μ g) = H U)
    (P₁ P₂ : ℝ → ℝ → ℝ) (hP₁ : Continuous (Function.uncurry P₁)) (hP₂ : Continuous (Function.uncurry P₂))
    (Q₁ Q₂ : ℝ → ℝ) (hQ₁ : Continuous Q₁) (hQ₂ : Continuous Q₂) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    let R := restTouchCharacterSum (L := L)
    let K : GaugeConfig L → ℝ := fun U =>
      t U * P₁ (b U) (t U ^ 2) + b U * P₂ (b U ^ 2) (t U) +
        Q₁ (b U) * (4 * t U ^ 2 - 1) + Q₂ (t U) * (4 * b U ^ 2 - 1)
    (∫ U, H U * K U ∂(gaugeHaarMeasure L)) = 0 ∧
    (∫ U, H U * R U * K U ∂(gaugeHaarMeasure L)) = 0 ∧
    (∫ U, H U * R U ^ 2 * K U ∂(gaugeHaarMeasure L)) = 0 ∧
    (∫ U, H U * R U ^ 3 * K U ∂(gaugeHaarMeasure L)) = 0 := by
  intro b t R K
  have hb : Continuous b := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht : Continuous t := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  have hK : Continuous K :=
    (((ht.mul (hP₁.comp (hb.prodMk (ht.pow 2)))).add
      (hb.mul (hP₂.comp ((hb.pow 2).prodMk ht)))).add
      ((hQ₁.comp hb).mul ((continuous_const.mul (ht.pow 2)).sub continuous_const))).add
      ((hQ₂.comp ht).mul ((continuous_const.mul (hb.pow 2)).sub continuous_const))
  have hR : Continuous R := continuous_restTouchCharacterSum
  have h_sub := restTouchPlaquettes_subset_restPlaquettes L
  refine ⟨?_, ?_, ?_, ?_⟩
  · have h0 := integral_mul_triple_probeTemplate_eq_zero hL H hH_cont hH_inv (by omega : 0 ≤ 3)
      Fin.elim0 (fun j => Fin.elim0 j) P₁ P₂ hP₁ hP₂ Q₁ Q₂ hQ₁ hQ₂
    simpa [K, b, t] using h0
  · have h_assoc : (fun U => H U * R U * K U) = fun U => (H U * K U) * R U := by funext U; ring
    rw [h_assoc]
    refine integral_mul_finsetSum_plaquette_eq_zero _ _ (hH_cont.mul hK) (fun q₁ hq₁ => ?_)
    have h1 := integral_mul_triple_probeTemplate_eq_zero hL H hH_cont hH_inv (by omega : 1 ≤ 3)
      ![q₁] (fun j => by fin_cases j; exact h_sub hq₁) P₁ P₂ hP₁ hP₂ Q₁ Q₂ hQ₁ hQ₂
    have h_eq : (fun U => (H U * K U) * halfTraceRe (plaquetteHolonomy U q₁)) =
        fun U => (H U * ∏ j : Fin 1, halfTraceRe (plaquetteHolonomy U (![q₁] j))) * K U := by
      funext U; simp; ring
    rw [h_eq]; exact h1
  · have h_assoc : (fun U => H U * R U ^ 2 * K U) = fun U => (H U * K U * R U) * R U := by funext U; ring
    rw [h_assoc]
    refine integral_mul_finsetSum_plaquette_eq_zero _ _ ((hH_cont.mul hK).mul hR) (fun q₁ hq₁ => ?_)
    have h_a1 : (fun U => (H U * K U * R U) * halfTraceRe (plaquetteHolonomy U q₁)) =
        fun U => (H U * K U * halfTraceRe (plaquetteHolonomy U q₁)) * R U := by funext U; ring
    rw [h_a1]
    refine integral_mul_finsetSum_plaquette_eq_zero _ _
      ((hH_cont.mul hK).mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁))) (fun q₂ hq₂ => ?_)
    have h2 := integral_mul_triple_probeTemplate_eq_zero hL H hH_cont hH_inv (by omega : 2 ≤ 3)
      ![q₁, q₂] (fun j => by fin_cases j <;> [exact h_sub hq₁; exact h_sub hq₂]) P₁ P₂ hP₁ hP₂ Q₁ Q₂ hQ₁ hQ₂
    have h_eq : (fun U => (H U * K U * halfTraceRe (plaquetteHolonomy U q₁)) * halfTraceRe (plaquetteHolonomy U q₂)) =
        fun U => (H U * ∏ j : Fin 2, halfTraceRe (plaquetteHolonomy U (![q₁, q₂] j))) * K U := by
      funext U; simp [Fin.prod_univ_two]; ring
    rw [h_eq]; exact h2
  · have h_assoc : (fun U => H U * R U ^ 3 * K U) = fun U => (H U * K U * R U ^ 2) * R U := by funext U; ring
    rw [h_assoc]
    refine integral_mul_finsetSum_plaquette_eq_zero _ _ ((hH_cont.mul hK).mul (hR.pow 2)) (fun q₁ hq₁ => ?_)
    have h_a1 : (fun U => (H U * K U * R U ^ 2) * halfTraceRe (plaquetteHolonomy U q₁)) =
        fun U => (H U * K U * halfTraceRe (plaquetteHolonomy U q₁) * R U) * R U := by funext U; ring
    rw [h_a1]
    refine integral_mul_finsetSum_plaquette_eq_zero _ _
      (((hH_cont.mul hK).mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁))).mul hR) (fun q₂ hq₂ => ?_)
    have h_a2 : (fun U => (H U * K U * halfTraceRe (plaquetteHolonomy U q₁) * R U) * halfTraceRe (plaquetteHolonomy U q₂)) =
        fun U => (H U * K U * halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂)) * R U := by
      funext U; ring
    rw [h_a2]
    refine integral_mul_finsetSum_plaquette_eq_zero _ _
      (((hH_cont.mul hK).mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁))).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))) (fun q₃ hq₃ => ?_)
    have h3 := integral_mul_triple_probeTemplate_eq_zero hL H hH_cont hH_inv (by omega : 3 ≤ 3)
      ![q₁, q₂, q₃] (fun j => by fin_cases j <;> [exact h_sub hq₁; exact h_sub hq₂; exact h_sub hq₃])
      P₁ P₂ hP₁ hP₂ Q₁ Q₂ hQ₁ hQ₂
    have h_eq : (fun U => (H U * K U * halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂)) *
        halfTraceRe (plaquetteHolonomy U q₃)) =
        fun U => (H U * ∏ j : Fin 3, halfTraceRe (plaquetteHolonomy U (![q₁, q₂, q₃] j))) * K U := by
      funext U; simp [Fin.prod_univ_three]; ring
    rw [h_eq]; exact h3

theorem integral_mul_quartic_probes_eq_zero_of_not_mem_cubeLateralSet
    {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ e ∈ cubeLinks L, ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U e.x e.μ g) = H U)
    {q₁ q₂ q₃ q₄ : Plaquette L}
    (hq₁ : q₁ ∈ restPlaquettes L) (hq₂ : q₂ ∈ restPlaquettes L)
    (hq₃ : q₃ ∈ restPlaquettes L) (hq₄ : q₄ ∈ restPlaquettes L)
    (hq₄_not_lat : q₄ ∉ cubeLateralSet L) :
    (∫ U : GaugeConfig L,
      H U *
        (halfTraceRe (plaquetteHolonomy U q₁) *
          halfTraceRe (plaquetteHolonomy U q₂) *
          halfTraceRe (plaquetteHolonomy U q₃) *
          halfTraceRe (plaquetteHolonomy U q₄) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq₁ hq₂ hq₃ hq₄
  let Q : Fin 4 → Plaquette L := ![q₁, q₂, q₃, q₄]
  have h_uncov :
      (∃ k : Fin 4, ∀ j : Fin 4, plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks (Q j)) ∨
      (∃ k : Fin 4, ∀ j : Fin 4, plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks (Q j)) := by
    by_contra h_neither
    have h_all_bot :
        ∀ k : Fin 4, ∃ j : Fin 4, plaquetteLinkAt (cubeBottomPlaquette L) k ∈ plaquetteLinks (Q j) := by
      intro k; by_contra hk; exact h_neither (Or.inl ⟨k, fun j hj => hk ⟨j, hj⟩⟩)
    have h_all_top :
        ∀ k : Fin 4, ∃ j : Fin 4, plaquetteLinkAt (cubeTopPlaquette L) k ∈ plaquetteLinks (Q j) := by
      intro k; by_contra hk; exact h_neither (Or.inr ⟨k, fun j hj => hk ⟨j, hj⟩⟩)
    choose f_bot hf_bot using h_all_bot
    choose f_top hf_top using h_all_top
    have hQ_bot : ∀ j : Fin 4, Q j ≠ cubeBottomPlaquette L := by
      intro j; fin_cases j <;> [exact hq₁.1; exact hq₂.1; exact hq₃.1; exact hq₄.1]
    have hQ_top : ∀ j : Fin 4, Q j ≠ cubeTopPlaquette L := by
      intro j; fin_cases j <;> [exact hq₁.2; exact hq₂.2; exact hq₃.2; exact hq₄.2]
    have hf_bot_inj : Function.Injective f_bot := fun k₁ k₂ hfk =>
      plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL (hQ_bot (f_bot k₁)) (hf_bot k₁) (hfk ▸ hf_bot k₂)
    have hf_top_inj : Function.Injective f_top := fun k₁ k₂ hfk =>
      plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL (hQ_top (f_top k₁)) (hf_top k₁) (hfk ▸ hf_top k₂)
    obtain ⟨k_bot, hk_bot⟩ := Finite.surjective_of_injective hf_bot_inj (3 : Fin 4)
    obtain ⟨k_top, hk_top⟩ := Finite.surjective_of_injective hf_top_inj (3 : Fin 4)
    have h_mem_bot : plaquetteLinkAt (cubeBottomPlaquette L) k_bot ∈ plaquetteLinks q₄ := by
      have h := hf_bot k_bot; rw [hk_bot] at h; exact h
    have h_mem_top : plaquetteLinkAt (cubeTopPlaquette L) k_top ∈ plaquetteLinks q₄ := by
      have h := hf_top k_top; rw [hk_top] at h; exact h
    have hq4_eq : q₄ = cubeLateralAt L k_bot :=
      eq_cubeLateralAt_of_mem_plaquetteLinks_bottom_and_top hL h_mem_bot h_mem_top
    exact hq₄_not_lat (hq4_eq ▸ cubeLateralAt_mem_cubeLateralSet L k_bot)
  have h1 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)
  have h2 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂)
  have h3 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)
  have h4 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₄)
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  rcases h_uncov with ⟨k, hk⟩ | ⟨k, hk⟩
  · have hk_top : plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks (cubeTopPlaquette L) :=
      not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL2
        (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)
    have h_pt : (fun U => H U * (halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂) *
          halfTraceRe (plaquetteHolonomy U q₃) * halfTraceRe (plaquetteHolonomy U q₄) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))) =
        fun U => (H U * halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂) *
          halfTraceRe (plaquetteHolonomy U q₃) * halfTraceRe (plaquetteHolonomy U q₄) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by funext U; ring
    rw [h_pt]
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeBottomPlaquette L) (plaquetteLinkAt (cubeBottomPlaquette L) k)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k) _
      (((((hH_cont.mul h1).mul h2).mul h3).mul h4).mul ht) (fun U g => ?_)
    rw [hH_inv _ (plaquetteLinkAt_cubeBottomPlaquette_mem_cubeLinks L k) U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ (hk 0) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ (hk 1) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ (hk 2) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₄ (hk 3) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) hk_top g]
  · have hk_bot : plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks (cubeBottomPlaquette L) :=
      not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
        (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)
    have h_pt : (fun U => H U * (halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂) *
          halfTraceRe (plaquetteHolonomy U q₃) * halfTraceRe (plaquetteHolonomy U q₄) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))) =
        fun U => (H U * halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂) *
          halfTraceRe (plaquetteHolonomy U q₃) * halfTraceRe (plaquetteHolonomy U q₄) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by funext U; ring
    rw [h_pt]
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) k)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k) _
      (((((hH_cont.mul h1).mul h2).mul h3).mul h4).mul hb) (fun U g => ?_)
    rw [hH_inv _ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L k) U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ (hk 0) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ (hk 1) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ (hk 2) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₄ (hk 3) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) hk_bot g]

theorem integral_mul_sum_cube_mul_sub_lateral_probes_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ e ∈ cubeLinks L, ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U e.x e.μ g) = H U)
    (S₁ S₂ S₃ : Finset (Plaquette L))
    (hS₁ : S₁ ⊆ restPlaquettes L) (hS₂ : S₂ ⊆ restPlaquettes L) (hS₃ : S₃ ⊆ restPlaquettes L) :
    (∫ U : GaugeConfig L,
      H U *
        ((∑ q₁ ∈ S₁, halfTraceRe (plaquetteHolonomy U q₁)) *
          (∑ q₂ ∈ S₂, halfTraceRe (plaquetteHolonomy U q₂)) *
          (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
          (restTouchCharacterSum U - lateralCharacterSum U) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  have h_sub_eq (U : GaugeConfig L) :
      restTouchCharacterSum U - lateralCharacterSum U =
        ∑ q₄ ∈ restTouchPlaquettes L \ cubeLateralSet L, halfTraceRe (plaquetteHolonomy U q₄) := by
    unfold restTouchCharacterSum lateralCharacterSum
    exact (Finset.sum_sdiff_eq_sub (cubeLateralSet_subset_restTouchPlaquettes L)).symm
  have hS_cont (S : Finset (Plaquette L)) :
      Continuous (fun U : GaugeConfig L => ∑ q ∈ S, halfTraceRe (plaquetteHolonomy U q)) :=
