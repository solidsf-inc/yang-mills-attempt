theorem sideBridge_fourTwist_eq_sideFourTwist
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) (k : Fin 4) (U : GaugeConfig L) :
    let eB := plaquetteLinkAt (cubeBottomPlaquette L) k
    let eT := plaquetteLinkAt (cubeTopPlaquette L) k
    (((sideBridge L β k U - sideBridge L β k (twistLinkNegOne eB U)) / 2) -
      ((sideBridge L β k (twistLinkNegOne eT U) -
        sideBridge L β k (twistLinkNegOne eB (twistLinkNegOne eT U))) / 2)) / 2 =
      sideFourTwist L β k U := by
  intro eB eT
  have hL2 : 2 ≤ L := by omega
  have hx_B (V : GaugeConfig L) : latChar L k (twistLinkNegOne eB V) = - latChar L k V :=
    latChar_twist_bottom_same hL2 k V
  have hx_T (V : GaugeConfig L) : latChar L k (twistLinkNegOne eT V) = - latChar L k V :=
    latChar_twist_top_same hL2 k V
  have hyB_B (V : GaugeConfig L) : botWingCharSum L k (twistLinkNegOne eB V) = - botWingCharSum L k V :=
    botWingCharSum_twist_bottom_same hL k V
  have hyB_T (V : GaugeConfig L) : botWingCharSum L k (twistLinkNegOne eT V) = botWingCharSum L k V := by
    rw [twistLinkNegOne_eq_updateGaugeLink]; exact botWingCharSum_update_top hL k k V _
  have hyT_B (V : GaugeConfig L) : topWingCharSum L k (twistLinkNegOne eB V) = topWingCharSum L k V := by
    rw [twistLinkNegOne_eq_updateGaugeLink]; exact topWingCharSum_update_bottom hL k k V _
  have hyT_T (V : GaugeConfig L) : topWingCharSum L k (twistLinkNegOne eT V) = - topWingCharSum L k V :=
    topWingCharSum_twist_top_same hL k V
  unfold sideBridge sideWeight sideFourTwist fourTwistExp
  rw [hx_B, hyB_B, hyT_B, hx_B, hyB_B, hyT_B, hx_T, hyB_T, hyT_T]
  have h1 : β * (- -latChar L k U + -botWingCharSum L k U + -topWingCharSum L k U) =
      β * (latChar L k U - botWingCharSum L k U - topWingCharSum L k U) := by ring
  have h2 : β * (-latChar L k U + -botWingCharSum L k U + topWingCharSum L k U) =
      β * (-latChar L k U - botWingCharSum L k U + topWingCharSum L k U) := by ring
  have h3 : β * (-latChar L k U + botWingCharSum L k U + -topWingCharSum L k U) =
      β * (-latChar L k U + botWingCharSum L k U - topWingCharSum L k U) := by ring
  rw [h1, h2, h3]
  ring

theorem integral_mul_sideBridge_bt_eq_sideFourTwist
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) (k : Fin 4)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_bot : ∀ U : GaugeConfig L,
      H (twistLinkNegOne (plaquetteLinkAt (cubeBottomPlaquette L) k) U) = H U)
    (hH_top : ∀ U : GaugeConfig L,
      H (twistLinkNegOne (plaquetteLinkAt (cubeTopPlaquette L) k) U) = H U) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    (∫ U : GaugeConfig L, H U * sideBridge L β k U * (b U * t U) ∂(gaugeHaarMeasure L)) =
      ∫ U : GaugeConfig L, H U * sideFourTwist L β k U * (b U * t U) ∂(gaugeHaarMeasure L) := by
  intro b t
  have hL2 : 2 ≤ L := by omega
  let eB := plaquetteLinkAt (cubeBottomPlaquette L) k
  let eT := plaquetteLinkAt (cubeTopPlaquette L) k
  let P (U : GaugeConfig L) : ℝ := b U * t U
  have hP_cont : Continuous P := by dsimp [P, b, t]; fun_prop
  have hP_bot (U : GaugeConfig L) : P (twistLinkNegOne eB U) = - P U := by
    dsimp [P, b, t]
    rw [halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL2 U
          (cubeBottomPlaquette L) (plaquetteLinkAt_mem_plaquetteLinks _ k),
        plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U (cubeTopPlaquette L)
          (not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k))]
    ring
  have hP_top (U : GaugeConfig L) : P (twistLinkNegOne eT U) = - P U := by
    dsimp [P, b, t]
    rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)),
        halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL2 U
          (cubeTopPlaquette L) (plaquetteLinkAt_mem_plaquetteLinks _ k)]
    ring
  let F1 (U : GaugeConfig L) : ℝ :=
    (sideBridge L β k U - sideBridge L β k (twistLinkNegOne eB U)) / 2
  have hF1_cont : Continuous F1 :=
    ((continuous_sideBridge β k).sub ((continuous_sideBridge β k).comp (continuous_twistLinkNegOne eB))).div_const 2
  have h_step1 :
      (∫ U, H U * sideBridge L β k U * P U ∂(gaugeHaarMeasure L)) =
        ∫ U, H U * F1 U * P U ∂(gaugeHaarMeasure L) :=
    integral_gaugeHaarMeasure_mul_odd_eq_half_sub_twistLinkNegOne eB hH_cont
      (continuous_sideBridge β k) hP_cont hH_bot hP_bot
  have h_step2 :
      (∫ U, H U * F1 U * P U ∂(gaugeHaarMeasure L)) =
        ∫ U, H U * ((F1 U - F1 (twistLinkNegOne eT U)) / 2) * P U ∂(gaugeHaarMeasure L) :=
    integral_gaugeHaarMeasure_mul_odd_eq_half_sub_twistLinkNegOne eT hH_cont
      hF1_cont hP_cont hH_top hP_top
  change (∫ U, H U * sideBridge L β k U * P U ∂(gaugeHaarMeasure L)) =
    ∫ U, H U * sideFourTwist L β k U * P U ∂(gaugeHaarMeasure L)
  rw [h_step1, h_step2]
  congr 1; funext U
  dsimp [F1]
  rw [sideBridge_fourTwist_eq_sideFourTwist hL β k U]

theorem integral_sideBridge_bt_eq_sideFourTwist
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    (∫ U : GaugeConfig L,
      probeExteriorBoltzmannWeight β U *
        sideBridge L β 0 U * sideBridge L β 1 U * sideBridge L β 2 U * sideBridge L β 3 U *
        (b U * t U) ∂(gaugeHaarMeasure L)) =
    ∫ U : GaugeConfig L,
      probeExteriorBoltzmannWeight β U *
        sideFourTwist L β 0 U * sideFourTwist L β 1 U * sideFourTwist L β 2 U * sideFourTwist L β 3 U *
        (b U * t U) ∂(gaugeHaarMeasure L) := by
  intro b t
  let w := probeExteriorBoltzmannWeight (L := L) β
  let Δ := sideBridge L β
  let W := sideFourTwist L β
  have h0 :
      (∫ U, w U * Δ 0 U * Δ 1 U * Δ 2 U * Δ 3 U * (b U * t U) ∂(gaugeHaarMeasure L)) =
        ∫ U, w U * W 0 U * Δ 1 U * Δ 2 U * Δ 3 U * (b U * t U) ∂(gaugeHaarMeasure L) := by
    have h_a1 : (fun U => w U * Δ 0 U * Δ 1 U * Δ 2 U * Δ 3 U * (b U * t U)) =
        fun U => (w U * Δ 1 U * Δ 2 U * Δ 3 U) * Δ 0 U * (b U * t U) := by funext U; ring
    have h_a2 : (fun U => w U * W 0 U * Δ 1 U * Δ 2 U * Δ 3 U * (b U * t U)) =
        fun U => (w U * Δ 1 U * Δ 2 U * Δ 3 U) * W 0 U * (b U * t U) := by funext U; ring
    rw [h_a1, h_a2]
    refine integral_mul_sideBridge_bt_eq_sideFourTwist hL β 0 _ (by dsimp [w, Δ]; fun_prop) (fun U => ?_) (fun U => ?_)
    · dsimp only [w, Δ]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 0),
          sideBridge_twist_bottom_of_ne hL β (by decide : (0 : Fin 4) ≠ 1) U,
          sideBridge_twist_bottom_of_ne hL β (by decide : (0 : Fin 4) ≠ 2) U,
          sideBridge_twist_bottom_of_ne hL β (by decide : (0 : Fin 4) ≠ 3) U]
    · dsimp only [w, Δ]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 0),
          sideBridge_twist_top_of_ne hL β (by decide : (0 : Fin 4) ≠ 1) U,
          sideBridge_twist_top_of_ne hL β (by decide : (0 : Fin 4) ≠ 2) U,
          sideBridge_twist_top_of_ne hL β (by decide : (0 : Fin 4) ≠ 3) U]
  have h1 :
      (∫ U, w U * W 0 U * Δ 1 U * Δ 2 U * Δ 3 U * (b U * t U) ∂(gaugeHaarMeasure L)) =
        ∫ U, w U * W 0 U * W 1 U * Δ 2 U * Δ 3 U * (b U * t U) ∂(gaugeHaarMeasure L) := by
    have h_a1 : (fun U => w U * W 0 U * Δ 1 U * Δ 2 U * Δ 3 U * (b U * t U)) =
        fun U => (w U * W 0 U * Δ 2 U * Δ 3 U) * Δ 1 U * (b U * t U) := by funext U; ring
    have h_a2 : (fun U => w U * W 0 U * W 1 U * Δ 2 U * Δ 3 U * (b U * t U)) =
        fun U => (w U * W 0 U * Δ 2 U * Δ 3 U) * W 1 U * (b U * t U) := by funext U; ring
    rw [h_a1, h_a2]
    refine integral_mul_sideBridge_bt_eq_sideFourTwist hL β 1 _ (by dsimp [w, W, Δ]; fun_prop) (fun U => ?_) (fun U => ?_)
    · dsimp only [w, W, Δ]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 1),
          sideFourTwist_twist_bottom_of_ne hL β (by decide : (1 : Fin 4) ≠ 0) U,
          sideBridge_twist_bottom_of_ne hL β (by decide : (1 : Fin 4) ≠ 2) U,
          sideBridge_twist_bottom_of_ne hL β (by decide : (1 : Fin 4) ≠ 3) U]
    · dsimp only [w, W, Δ]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 1),
          sideFourTwist_twist_top_of_ne hL β (by decide : (1 : Fin 4) ≠ 0) U,
          sideBridge_twist_top_of_ne hL β (by decide : (1 : Fin 4) ≠ 2) U,
          sideBridge_twist_top_of_ne hL β (by decide : (1 : Fin 4) ≠ 3) U]
  have h2 :
      (∫ U, w U * W 0 U * W 1 U * Δ 2 U * Δ 3 U * (b U * t U) ∂(gaugeHaarMeasure L)) =
        ∫ U, w U * W 0 U * W 1 U * W 2 U * Δ 3 U * (b U * t U) ∂(gaugeHaarMeasure L) := by
    have h_a1 : (fun U => w U * W 0 U * W 1 U * Δ 2 U * Δ 3 U * (b U * t U)) =
        fun U => (w U * W 0 U * W 1 U * Δ 3 U) * Δ 2 U * (b U * t U) := by funext U; ring
    have h_a2 : (fun U => w U * W 0 U * W 1 U * W 2 U * Δ 3 U * (b U * t U)) =
        fun U => (w U * W 0 U * W 1 U * Δ 3 U) * W 2 U * (b U * t U) := by funext U; ring
    rw [h_a1, h_a2]
    refine integral_mul_sideBridge_bt_eq_sideFourTwist hL β 2 _ (by dsimp [w, W, Δ]; fun_prop) (fun U => ?_) (fun U => ?_)
    · dsimp only [w, W, Δ]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 2),
          sideFourTwist_twist_bottom_of_ne hL β (by decide : (2 : Fin 4) ≠ 0) U,
          sideFourTwist_twist_bottom_of_ne hL β (by decide : (2 : Fin 4) ≠ 1) U,
          sideBridge_twist_bottom_of_ne hL β (by decide : (2 : Fin 4) ≠ 3) U]
    · dsimp only [w, W, Δ]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 2),
          sideFourTwist_twist_top_of_ne hL β (by decide : (2 : Fin 4) ≠ 0) U,
          sideFourTwist_twist_top_of_ne hL β (by decide : (2 : Fin 4) ≠ 1) U,
          sideBridge_twist_top_of_ne hL β (by decide : (2 : Fin 4) ≠ 3) U]
  have h3 :
      (∫ U, w U * W 0 U * W 1 U * W 2 U * Δ 3 U * (b U * t U) ∂(gaugeHaarMeasure L)) =
        ∫ U, w U * W 0 U * W 1 U * W 2 U * W 3 U * (b U * t U) ∂(gaugeHaarMeasure L) := by
    refine integral_mul_sideBridge_bt_eq_sideFourTwist hL β 3 _ (by dsimp [w, W]; fun_prop) (fun U => ?_) (fun U => ?_)
    · dsimp only [w, W]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 3),
          sideFourTwist_twist_bottom_of_ne hL β (by decide : (3 : Fin 4) ≠ 0) U,
          sideFourTwist_twist_bottom_of_ne hL β (by decide : (3 : Fin 4) ≠ 1) U,
          sideFourTwist_twist_bottom_of_ne hL β (by decide : (3 : Fin 4) ≠ 2) U]
    · dsimp only [w, W]
      rw [probeExteriorBoltzmannWeight_twistLinkNegOne_of_mem_probeLinks β U (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 3),
          sideFourTwist_twist_top_of_ne hL β (by decide : (3 : Fin 4) ≠ 0) U,
          sideFourTwist_twist_top_of_ne hL β (by decide : (3 : Fin 4) ≠ 1) U,
          sideFourTwist_twist_top_of_ne hL β (by decide : (3 : Fin 4) ≠ 2) U]
  rw [h0, h1, h2, h3]

/-! #### Chunk 6: Leading `4⁻⁵ β⁴` Extraction, Vertical-Link Wing-Pair Twist & Final `CanonicalProbeClusterRemainder` Proof -/

theorem integral_probeExterior_mul_beta_latChar_bt_eq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    (∫ U : GaugeConfig L,
      probeExteriorBoltzmannWeight β U *
        (β * latChar L 0 U) * (β * latChar L 1 U) * (β * latChar L 2 U) * (β * latChar L 3 U) *
        (b U * t U) ∂(gaugeHaarMeasure L)) =
    cubeSixFaceHaarIntegral * β ^ 4 * probeExteriorPartition L β := by
  intro b t
  let w := probeExteriorBoltzmannWeight (L := L) β
  let F₄ : GaugeConfig L → ℝ := fun U =>
    w U *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
        (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L))) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  let F₃ : GaugeConfig L → ℝ := fun U =>
    w U *
      ((β / 4) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
          (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
          (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
          halfTraceRe
            (U ⟨shift 0 2, 1⟩ * (U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ *
              (U ⟨cubeBottomBase L, 0⟩)⁻¹ * U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 0⟩)))
  let F₂ : GaugeConfig L → ℝ := fun U =>
    w U *
      ((β / 4) * (β / 4) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
          (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
          halfTraceRe
            ((U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 0⟩)⁻¹ *
              U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 1⟩ *
              U ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)))
  let F₁ : GaugeConfig L → ℝ := fun U =>
    w U *
      ((β / 4) * (β / 4) * (β / 4) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
          halfTraceRe
            (U ⟨0, 1⟩ * (U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * U ⟨shift (cubeBottomBase L) 1, 2⟩ *
              (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
              U ⟨cubeBottomBase L, 0⟩)))
  let F₀ : GaugeConfig L → ℝ := fun U =>
    w U *
      ((β / 4) * (β / 4) * (β / 4) * (β / 4) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))))
  have hF₄_cont : Continuous F₄ := by dsimp [F₄, w]; fun_prop
  have hF₃_cont : Continuous F₃ := by dsimp [F₃, w]; fun_prop
  have hF₂_cont : Continuous F₂ := by dsimp [F₂, w]; fun_prop
  have hF₁_cont : Continuous F₁ := by dsimp [F₁, w]; fun_prop
  have hF₀_cont : Continuous F₀ := by dsimp [F₀, w]; fun_prop
  have h_init :
      (fun U : GaugeConfig L =>
        w U * (β * latChar L 0 U) * (β * latChar L 1 U) * (β * latChar L 2 U) * (β * latChar L 3 U) *
          (b U * t U)) = F₄ := by
    funext U
    unfold latChar cubeLateralAt
    dsimp [F₄, w, b, t]
    ring
  have h_step4 : (∫ U, F₄ U ∂(gaugeHaarMeasure L)) = ∫ U, F₃ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨0, 2⟩ F₄ hF₄_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have hw_inv (g : SU2) : w (updateGaugeLink L U 0 2 g) = w U :=
      probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U
        (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 3) g
    have h_eq (g : SU2) :
        F₄ (updateGaugeLink L U 0 2 g) =
          (w U *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
              (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
              (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))))) *
          ((0 + β * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeLateralPlaquette4 L))) *
            halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeTopPlaquette L))) := by
      dsimp only [F₄]
      rw [hw_inv g,
          plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U 0 rfl 2 g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette1 L) rfl rfl 0 g,
          plaquetteHolonomy_cubeLateralPlaquette2_update_topLink4 hL U g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette3 L) rfl rfl 0 g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink4_cubeLateral4_mul_cubeTop hL 0 β U]
    dsimp [F₃]
    ring
  have h_step3 : (∫ U, F₃ U ∂(gaugeHaarMeasure L)) = ∫ U, F₂ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨shift 0 2, 1⟩ F₃ hF₃_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have hw_inv (g : SU2) : w (updateGaugeLink L U (shift 0 2) 1 g) = w U :=
      probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U
        (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 2) g
    have h_eq (g : SU2) :
        F₃ (updateGaugeLink L U (shift 0 2) 1 g) =
          (w U * ((β / 4) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
              (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L)))))) *
          ((0 + β * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 2) 1 g) (cubeLateralPlaquette3 L))) *
            halfTraceRe
              (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 2, 1⟩ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 1, 2⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨0, 1⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
                updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 2⟩ *
                updateGaugeLink L U (shift 0 2) 1 g ⟨shift (cubeBottomBase L) 2, 0⟩)) := by
      dsimp only [F₃]
      rw [hw_inv g,
          plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U (shift 0 2) (by simp [shift, unitVec]) 1 g,
          plaquetteHolonomy_cubeLateralPlaquette1_update_topLink3 hL U g,
          plaquetteHolonomy_of_plane02_update_dir1 U (cubeLateralPlaquette2 L) rfl rfl (shift 0 2) g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink3_cubeLateral3_mul_step1 hL 0 β U]
    dsimp [F₂]
    ring
  have h_step2 : (∫ U, F₂ U ∂(gaugeHaarMeasure L)) = ∫ U, F₁ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨shift 0 1, 2⟩ F₂ hF₂_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have hw_inv (g : SU2) : w (updateGaugeLink L U (shift 0 1) 2 g) = w U :=
      probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U
        (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 1) g
    have h_eq (g : SU2) :
        F₂ (updateGaugeLink L U (shift 0 1) 2 g) =
          (w U * ((β / 4) * (β / 4) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              (0 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L)))))) *
          ((0 + β * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 1) 2 g) (cubeLateralPlaquette2 L))) *
            halfTraceRe
              ((updateGaugeLink L U (shift 0 1) 2 g ⟨shift 0 1, 2⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 1) 2 g ⟨0, 1⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 2⟩ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨shift (cubeBottomBase L) 2, 1⟩ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)) := by
      dsimp only [F₂]
      rw [hw_inv g,
          plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U (shift 0 1) (by simp [shift, unitVec]) 2 g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette1 L) rfl rfl (shift 0 1) g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink2_cubeLateral2_mul_step2 hL 0 β U]
    dsimp [F₁]
    ring
  have h_step1 : (∫ U, F₁ U ∂(gaugeHaarMeasure L)) = ∫ U, F₀ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨0, 1⟩ F₁ hF₁_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have hw_inv (g : SU2) : w (updateGaugeLink L U 0 1 g) = w U :=
      probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U
        (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 0) g
    have h_eq (g : SU2) :
        F₁ (updateGaugeLink L U 0 1 g) =
          (w U * ((β / 4) * (β / 4) * (β / 4) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))) *
          ((0 + β * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 1 g) (cubeLateralPlaquette1 L))) *
            halfTraceRe
              (updateGaugeLink L U 0 1 g ⟨0, 1⟩ *
                (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ *
                updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 2⟩ *
                (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
                (updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 2⟩)⁻¹ *
                updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 0⟩)) := by
      dsimp only [F₁]
      rw [hw_inv g,
          plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U 0 rfl 1 g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink1_cubeLateral1_mul_step3 hL 0 β U]
    dsimp [F₀]
    ring
  have h_step0 :
      (∫ U, F₀ U ∂(gaugeHaarMeasure L)) =
        cubeSixFaceHaarIntegral * β ^ 4 * probeExteriorPartition L β := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨cubeBottomBase L, 1⟩ F₀ hF₀_cont]
    have h_inner (U : GaugeConfig L) :
        (∫ g : SU2, F₀ (updateGaugeLink L U (cubeBottomBase L) 1 g) ∂SU2.haarProbability) =
          (cubeSixFaceHaarIntegral * β ^ 4) * w U := by
      have hw_inv (g : SU2) : w (updateGaugeLink L U (cubeBottomBase L) 1 g) = w U :=
        probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U
          (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 0) g
      have h_pt (g : SU2) :
          F₀ (updateGaugeLink L U (cubeBottomBase L) 1 g) =
            (w U * ((β / 4) * (β / 4) * (β / 4) * (β / 4))) *
              (halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (cubeBottomBase L) 1 g) (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (cubeBottomBase L) 1 g) (cubeBottomPlaquette L))) := by
        dsimp only [F₀]
        rw [hw_inv g]
        ring
      simp_rw [h_pt, integral_const_mul, integral_bottomLink1_cubeBottom_sq hL U,
        cubeSixFaceHaarIntegral_eq_one_fourth_pow_five]
      ring
    simp_rw [h_inner, integral_const_mul]
    rfl
  rw [h_init, h_step4, h_step3, h_step2, h_step1, h_step0]

theorem not_mem_plaquetteLinks_first_or_second_of_ne {L : ℕ}
    {q p : Plaquette L} (hne : q ≠ p) :
    (⟨p.x, p.μ⟩ : Link L) ∉ plaquetteLinks q ∨ (⟨shift p.x p.μ, p.ν⟩ : Link L) ∉ plaquetteLinks q := by
  by_cases hm1 : (⟨p.x, p.μ⟩ : Link L) ∈ plaquetteLinks q
  · by_cases hm2 : (⟨shift p.x p.μ, p.ν⟩ : Link L) ∈ plaquetteLinks q
    · exfalso
      simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at hm1 hm2
      have hμ_or : p.μ = q.μ ∨ p.μ = q.ν := by
        rcases hm1 with h | h | h | h
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
      have hν_or : p.ν = q.μ ∨ p.ν = q.ν := by
        rcases hm2 with h | h | h | h
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
      have hp_lt : p.μ < p.ν := p.h
      have hq_lt : q.μ < q.ν := q.h
      have hμ_eq : p.μ = q.μ := by
        rcases hμ_or with h1 | h1 <;> rcases hν_or with h2 | h2
        · exact h1
        · exact h1
        · exfalso; exact lt_asymm (h1 ▸ h2 ▸ hp_lt) hq_lt
        · exfalso; exact hp_lt.ne (h1.trans h2.symm)
      have hν_eq : p.ν = q.ν := by
        rcases hν_or with h2 | h2
        · exfalso; exact hp_lt.ne (hμ_eq.trans h2.symm)
        · exact h2
      have hx1 : p.x = q.x ∨ p.x = shift q.x q.ν := by
        rcases hm1 with h | h | h | h
        · exact Or.inl (congrArg Link.x h)
        · exfalso; exact q.h.ne (hμ_eq.symm.trans (congrArg Link.μ h))
        · exact Or.inr (congrArg Link.x h)
        · exfalso; exact q.h.ne (hμ_eq.symm.trans (congrArg Link.μ h))
      have hx2 : shift p.x p.μ = q.x ∨ shift p.x p.μ = shift q.x q.μ := by
        rcases hm2 with h | h | h | h
        · exfalso; exact q.h.ne' (hν_eq.symm.trans (congrArg Link.μ h))
        · exact Or.inr (congrArg Link.x h)
        · exfalso; exact q.h.ne' (hν_eq.symm.trans (congrArg Link.μ h))
        · exact Or.inl (congrArg Link.x h)
      have hx_eq : p.x = q.x := by
        funext i
        by_cases hi : i = q.ν
        · subst hi
          have hp_shift : shift p.x p.μ q.ν = p.x q.ν := by
            simp [shift, unitVec, hμ_eq, q.h.ne']
          rcases hx2 with h | h
          · rw [← hp_shift]; exact congrFun h q.ν
          · rw [← hp_shift, congrFun h q.ν]
            simp [shift, unitVec, q.h.ne']
        · rcases hx1 with h | h
          · exact congrFun h i
          · rw [congrFun h i]
            simp [shift, unitVec, hi]
      apply hne
      cases q with
      | mk qx qμ qν qh =>
        cases p with
        | mk px pμ pν ph =>
          dsimp at hx_eq hμ_eq hν_eq
          subst hx_eq hμ_eq hν_eq
          rfl
    · exact Or.inr hm2
  · exact Or.inl hm1

theorem not_mem_plaquetteLinks_of_dir_ne {L : ℕ} {p : Plaquette L} {e : Link L}
    (hμ : e.μ ≠ p.μ) (hν : e.μ ≠ p.ν) :
    e ∉ plaquetteLinks p := by
  intro hm
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with h | h | h | h
  · exact hμ (by simpa using congrArg Link.μ h)
  · exact hν (by simpa using congrArg Link.μ h)
  · exact hμ (by simpa using congrArg Link.μ h)
  · exact hν (by simpa using congrArg Link.μ h)

theorem not_mem_plaquetteLinks_of_coord_ne {L : ℕ} {p : Plaquette L} {e : Link L}
    (i : Fin 4) (hiμ : i ≠ p.μ) (hiν : i ≠ p.ν) (hx : e.x i ≠ p.x i) :
    e ∉ plaquetteLinks p := by
  intro hm
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with h | h | h | h
  · exact hx (congrFun (congrArg Link.x h) i)
  · have := congrFun (congrArg Link.x h) i
    simp [shift, unitVec, hiμ] at this
    exact hx this
  · have := congrFun (congrArg Link.x h) i
    simp [shift, unitVec, hiν] at this
    exact hx this
  · exact hx (congrFun (congrArg Link.x h) i)

/-- The primary vertical boundary link `⟨(cubeLateralAt L k).x, 0⟩` of lateral plaquette `k`. -/
def latVertLink (L : ℕ) (k : Fin 4) : Link L :=
  plaquetteLinkAt (cubeLateralAt L k) 0

theorem latVertLink_not_mem_probePlaquettes (L : ℕ) (k : Fin 4) :
    latVertLink L k ∉ plaquetteLinks (cubeBottomPlaquette L) ∧
    latVertLink L k ∉ plaquetteLinks (cubeTopPlaquette L) := by
  have hμ : (latVertLink L k).μ = 0 := by
    fin_cases k <;> rfl
  refine ⟨not_mem_plaquetteLinks_of_dir_ne (by rw [hμ]; rintro ⟨⟩) (by rw [hμ]; rintro ⟨⟩),
          not_mem_plaquetteLinks_of_dir_ne (by rw [hμ]; rintro ⟨⟩) (by rw [hμ]; rintro ⟨⟩)⟩

theorem cubeLateralAt_fourth_link_eq_bottom (L : ℕ) (k : Fin 4) :
    (⟨(cubeLateralAt L k).x, (cubeLateralAt L k).ν⟩ : Link L) =
      plaquetteLinkAt (cubeBottomPlaquette L) k := by
  fin_cases k <;> rfl

theorem cubeLateralAt_second_link_eq_top (L : ℕ) (k : Fin 4) :
    (⟨shift (cubeLateralAt L k).x (cubeLateralAt L k).μ, (cubeLateralAt L k).ν⟩ : Link L) =
      plaquetteLinkAt (cubeTopPlaquette L) k := by
  fin_cases k
  · simp [cubeLateralAt, cubeLateralPlaquette1, cubeTopPlaquette, plaquetteLinkAt,
      shift_cubeBottomBase_zero]
  · simp [cubeLateralAt, cubeLateralPlaquette2, cubeTopPlaquette, plaquetteLinkAt,
      shift_shift_cubeBottomBase_one_zero]
  · simp [cubeLateralAt, cubeLateralPlaquette3, cubeTopPlaquette, plaquetteLinkAt,
      shift_shift_cubeBottomBase_two_zero]
  · simp [cubeLateralAt, cubeLateralPlaquette4, cubeTopPlaquette, plaquetteLinkAt,
      shift_cubeBottomBase_zero]

theorem latVertLink_not_mem_of_mem_botWingPlaquettes {L : ℕ} [NeZero L]
    {k : Fin 4} {q : Plaquette L} (hq : q ∈ botWingPlaquettes L k) :
    latVertLink L k ∉ plaquetteLinks q := by
  simp only [botWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff] at hq
  have hne : q ≠ cubeLateralAt L k := fun h =>
    hq.1.2 (h ▸ cubeLateralAt_mem_cubeLateralSet L k)
  rcases not_mem_plaquetteLinks_first_or_fourth_of_ne hne with h1 | h4
  · exact h1
  · exfalso
    rw [cubeLateralAt_fourth_link_eq_bottom L k] at h4
    exact h4 hq.2

theorem latVertLink_not_mem_of_mem_topWingPlaquettes {L : ℕ} [NeZero L]
    {k : Fin 4} {q : Plaquette L} (hq : q ∈ topWingPlaquettes L k) :
    latVertLink L k ∉ plaquetteLinks q := by
  simp only [topWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff] at hq
  have hne : q ≠ cubeLateralAt L k := fun h =>
    hq.1.2 (h ▸ cubeLateralAt_mem_cubeLateralSet L k)
  rcases not_mem_plaquetteLinks_first_or_second_of_ne hne with h1 | h2
  · exact h1
  · exfalso
    rw [cubeLateralAt_second_link_eq_top L k] at h2
    exact h2 hq.2

theorem botWingCharSum_twist_latVertLink {L : ℕ} [NeZero L] (k : Fin 4) (U : GaugeConfig L) :
    botWingCharSum L k (twistLinkNegOne (latVertLink L k) U) = botWingCharSum L k U := by
  unfold botWingCharSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U q
    (latVertLink_not_mem_of_mem_botWingPlaquettes hq)]

theorem topWingCharSum_twist_latVertLink {L : ℕ} [NeZero L] (k : Fin 4) (U : GaugeConfig L) :
    topWingCharSum L k (twistLinkNegOne (latVertLink L k) U) = topWingCharSum L k U := by
  unfold topWingCharSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U q
    (latVertLink_not_mem_of_mem_topWingPlaquettes hq)]

theorem latChar_twist_latVertLink_matrix {L : ℕ} (hL2 : 2 ≤ L) (U : GaugeConfig L) :
    (latChar L 1 (twistLinkNegOne (latVertLink L 0) U) = latChar L 1 U ∧
     latChar L 2 (twistLinkNegOne (latVertLink L 0) U) = latChar L 2 U ∧
     latChar L 3 (twistLinkNegOne (latVertLink L 0) U) = - latChar L 3 U) ∧
    (latChar L 0 (twistLinkNegOne (latVertLink L 1) U) = - latChar L 0 U ∧
     latChar L 2 (twistLinkNegOne (latVertLink L 1) U) = latChar L 2 U ∧
     latChar L 3 (twistLinkNegOne (latVertLink L 1) U) = latChar L 3 U) ∧
    (latChar L 0 (twistLinkNegOne (latVertLink L 2) U) = latChar L 0 U ∧
     latChar L 1 (twistLinkNegOne (latVertLink L 2) U) = latChar L 1 U ∧
     latChar L 3 (twistLinkNegOne (latVertLink L 2) U) = - latChar L 3 U) ∧
    (latChar L 0 (twistLinkNegOne (latVertLink L 3) U) = - latChar L 0 U ∧
     latChar L 1 (twistLinkNegOne (latVertLink L 3) U) = latChar L 1 U ∧
     latChar L 2 (twistLinkNegOne (latVertLink L 3) U) = latChar L 2 U) := by
  have h10 : (1 : ZMod L) ≠ 0 := one_ne_zero_of_two_le hL2
  have h01 : (0 : ZMod L) ≠ 1 := h10.symm
  have h_not_0_1 : latVertLink L 0 ∉ plaquetteLinks (cubeLateralAt L 1) :=
    not_mem_plaquetteLinks_of_coord_ne 1 (by rintro ⟨⟩) (by rintro ⟨⟩)
      (by simpa [latVertLink, plaquetteLinkAt, cubeLateralAt, cubeLateralPlaquette1,
            cubeLateralPlaquette2, cubeBottomBase, shift, unitVec] using h01)
  have h_not_0_2 : latVertLink L 0 ∉ plaquetteLinks (cubeLateralAt L 2) :=
    not_mem_plaquetteLinks_of_coord_ne 2 (by rintro ⟨⟩) (by rintro ⟨⟩)
      (by simpa [latVertLink, plaquetteLinkAt, cubeLateralAt, cubeLateralPlaquette1,
            cubeLateralPlaquette3, cubeBottomBase, shift, unitVec] using h01)
  have h_mem_0_3 : latVertLink L 0 ∈ plaquetteLinks (cubeLateralAt L 3) :=
    plaquetteLinkAt_mem_plaquetteLinks (cubeLateralAt L 3) 0
  have h_mem_1_0 : latVertLink L 1 ∈ plaquetteLinks (cubeLateralAt L 0) :=
    plaquetteLinkAt_mem_plaquetteLinks (cubeLateralAt L 0) 2
  have h_not_1_2 : latVertLink L 1 ∉ plaquetteLinks (cubeLateralAt L 2) :=
    not_mem_plaquetteLinks_of_coord_ne 2 (by rintro ⟨⟩) (by rintro ⟨⟩)
      (by simpa [latVertLink, plaquetteLinkAt, cubeLateralAt, cubeLateralPlaquette2,
            cubeLateralPlaquette3, cubeBottomBase, shift, unitVec] using h01)
  have h_not_1_3 : latVertLink L 1 ∉ plaquetteLinks (cubeLateralAt L 3) :=
    not_mem_plaquetteLinks_of_coord_ne 1 (by rintro ⟨⟩) (by rintro ⟨⟩)
      (by simpa [latVertLink, plaquetteLinkAt, cubeLateralAt, cubeLateralPlaquette2,
            cubeLateralPlaquette4, cubeBottomBase, shift, unitVec] using h10)
  have h_not_2_0 : latVertLink L 2 ∉ plaquetteLinks (cubeLateralAt L 0) :=
    not_mem_plaquetteLinks_of_coord_ne 2 (by rintro ⟨⟩) (by rintro ⟨⟩)
      (by simpa [latVertLink, plaquetteLinkAt, cubeLateralAt, cubeLateralPlaquette3,
            cubeLateralPlaquette1, cubeBottomBase, shift, unitVec] using h10)
  have h_not_2_1 : latVertLink L 2 ∉ plaquetteLinks (cubeLateralAt L 1) :=
    not_mem_plaquetteLinks_of_coord_ne 1 (by rintro ⟨⟩) (by rintro ⟨⟩)
      (by simpa [latVertLink, plaquetteLinkAt, cubeLateralAt, cubeLateralPlaquette3,
            cubeLateralPlaquette2, cubeBottomBase, shift, unitVec] using h01)
  have h_mem_2_3 : latVertLink L 2 ∈ plaquetteLinks (cubeLateralAt L 3) :=
    plaquetteLinkAt_mem_plaquetteLinks (cubeLateralAt L 3) 2
  have h_mem_3_0 : latVertLink L 3 ∈ plaquetteLinks (cubeLateralAt L 0) :=
    plaquetteLinkAt_mem_plaquetteLinks (cubeLateralAt L 0) 0
  have h_not_3_1 : latVertLink L 3 ∉ plaquetteLinks (cubeLateralAt L 1) :=
    h_not_0_1
  have h_not_3_2 : latVertLink L 3 ∉ plaquetteLinks (cubeLateralAt L 2) :=
    h_not_0_2
  unfold latChar
  refine ⟨⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩⟩
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_0_1]
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_0_2]
  · exact halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL2 U _ h_mem_0_3
  · exact halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL2 U _ h_mem_1_0
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_1_2]
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_1_3]
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_2_0]
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_2_1]
  · exact halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL2 U _ h_mem_2_3
  · exact halfTraceRe_plaquetteHolonomy_twistLinkNegOne_of_mem_plaquetteLinks hL2 U _ h_mem_3_0
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_3_1]
  · rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _ h_not_3_2]

theorem abs_probeExteriorCharacterSum_twistLinkNegOne_sub_le
    {L : ℕ} [NeZero L] (e : Link L) (U : GaugeConfig L) :
    |probeExteriorCharacterSum (twistLinkNegOne e U) - probeExteriorCharacterSum U| ≤ 12 := by
  let S_in := (probeExteriorPlaquettes L).filter (fun q => e ∈ plaquetteLinks q)
  let S_out := (probeExteriorPlaquettes L).filter (fun q => e ∉ plaquetteLinks q)
  have h_disj : Disjoint S_in S_out := by
    rw [Finset.disjoint_left]
    intro q h1 h2
    simp only [S_in, S_out, Finset.mem_filter] at h1 h2
    exact h2.2 h1.2
  have h_union : S_in ∪ S_out = probeExteriorPlaquettes L := by
    ext q
    simp only [S_in, S_out, Finset.mem_union, Finset.mem_filter]
    exact ⟨fun h => h.elim And.left And.left,
      fun hq => (Classical.em (e ∈ plaquetteLinks q)).imp (fun h => ⟨hq, h⟩) (fun h => ⟨hq, h⟩)⟩
  have h_sub_eq :
      probeExteriorCharacterSum (twistLinkNegOne e U) - probeExteriorCharacterSum U =
        ∑ q ∈ S_in, (halfTraceRe (plaquetteHolonomy (twistLinkNegOne e U) q) -
          halfTraceRe (plaquetteHolonomy U q)) := by
    unfold probeExteriorCharacterSum
    rw [← Finset.sum_sub_distrib, ← h_union, Finset.sum_union h_disj]
    have h_out :
        ∑ q ∈ S_out, (halfTraceRe (plaquetteHolonomy (twistLinkNegOne e U) q) -
          halfTraceRe (plaquetteHolonomy U q)) = 0 := by
      refine Finset.sum_eq_zero fun q hq => ?_
      simp only [S_out, Finset.mem_filter] at hq
      rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U q hq.2, sub_self]
    rw [h_out, add_zero]
  have h_sub_inc : S_in ⊆ incidentPlaquettes e := by
    intro q hq
    simp only [S_in, Finset.mem_filter] at hq
    exact mem_incidentPlaquettes_of_mem_plaquetteLinks q e hq.2
  have h_card : (S_in.card : ℝ) ≤ 6 := by
    have hc : S_in.card ≤ 6 := (Finset.card_le_card h_sub_inc).trans (incidentPlaquettes_card_le_six e)
    exact_mod_cast hc
  rw [h_sub_eq]
  calc
    |∑ q ∈ S_in, (halfTraceRe (plaquetteHolonomy (twistLinkNegOne e U) q) -
        halfTraceRe (plaquetteHolonomy U q))|
      ≤ ∑ q ∈ S_in, |halfTraceRe (plaquetteHolonomy (twistLinkNegOne e U) q) -
          halfTraceRe (plaquetteHolonomy U q)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _q ∈ S_in, (2 : ℝ) := by
        refine Finset.sum_le_sum fun q _ => ?_
        have h1 := abs_le.mp (abs_halfTraceRe_le_one (plaquetteHolonomy (twistLinkNegOne e U) q))
        have h2 := abs_le.mp (abs_halfTraceRe_le_one (plaquetteHolonomy U q))
        exact abs_le.mpr ⟨by linarith, by linarith⟩
    _ = (S_in.card : ℝ) * 2 := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ 12 := by linarith

theorem abs_integral_probeExterior_mul_odd_of_twistLinkNegOne_le
    {L : ℕ} [NeZero L] {β : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912)
    (e : Link L) {P : GaugeConfig L → ℝ} (hP_cont : Continuous P)
    (hP_odd : ∀ U : GaugeConfig L, P (twistLinkNegOne e U) = - P U)
    (hP_bound : ∀ U : GaugeConfig L, |P U| ≤ 16) :
    let _ : Unit := ()
    |∫ U : GaugeConfig L, probeExteriorBoltzmannWeight β U * P U ∂(gaugeHaarMeasure L)| ≤
      104 * β * probeExteriorPartition L β := by
  let w := probeExteriorBoltzmannWeight (L := L) β
  have hw_cont : Continuous w := continuous_probeExteriorBoltzmannWeight β
  have h_one :
      (∫ U : GaugeConfig L, w U * P U ∂(gaugeHaarMeasure L)) =
        ∫ U : GaugeConfig L, ((w U - w (twistLinkNegOne e U)) / 2) * P U ∂(gaugeHaarMeasure L) := by
    have h := integral_gaugeHaarMeasure_mul_odd_eq_half_sub_twistLinkNegOne e
      (H := fun _ => (1 : ℝ)) (F := w) (P := P)
      continuous_const hw_cont hP_cont (fun _ => rfl) hP_odd
    simpa only [one_mul] using h
  have h_pt_eq :
      (fun U : GaugeConfig L => ((w U - w (twistLinkNegOne e U)) / 2) * P U) =
      fun U : GaugeConfig L =>
        w U * (((1 - Real.exp (β * (probeExteriorCharacterSum (twistLinkNegOne e U) -
          probeExteriorCharacterSum U))) / 2) * P U) := by
    funext U
    dsimp only [w]
    unfold probeExteriorBoltzmannWeight
    have h_exp :
        Real.exp (β * probeExteriorCharacterSum (twistLinkNegOne e U)) =
          Real.exp (β * probeExteriorCharacterSum U) *
            Real.exp (β * (probeExteriorCharacterSum (twistLinkNegOne e U) - probeExteriorCharacterSum U)) := by
      rw [← Real.exp_add]
      congr 1
      ring
    rw [h_exp]
    ring
  rw [h_one, h_pt_eq]
  refine abs_integral_mul_le_of_nonneg hw_cont
    (by
      refine Continuous.mul ?_ hP_cont
      refine Continuous.div_const (continuous_const.sub (Real.continuous_exp.comp (continuous_const.mul ?_))) 2
      exact (continuous_probeExteriorCharacterSum.comp (continuous_twistLinkNegOne e)).sub continuous_probeExteriorCharacterSum)
    (fun _ => (Real.exp_pos _).le) (fun U => ?_)
  rw [abs_mul]
  let d := probeExteriorCharacterSum (twistLinkNegOne e U) - probeExteriorCharacterSum U
  have hd : |d| ≤ 12 := abs_probeExteriorCharacterSum_twistLinkNegOne_sub_le e U
  have hu : |β * d| ≤ 12 * β := by
    rw [abs_mul, abs_of_nonneg hβ0]
    nlinarith
  have hu1 : |β * d| ≤ 1 := by linarith
  have heb := abs_exp_sub_one_le_of_abs_le_one hu1
  have hsq : (β * d) ^ 2 ≤ (12 * β) ^ 2 := by
    rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
  have heb13 : |Real.exp (β * d) - 1| ≤ 13 * β := by nlinarith
  have h_half : |(1 - Real.exp (β * d)) / 2| ≤ (13 / 2 : ℝ) * β := by
    rw [abs_div, abs_sub_comm, show |(2 : ℝ)| = 2 by norm_num]
    linarith
  have h_mul := mul_le_mul h_half (hP_bound U) (abs_nonneg _) (by positivity)
  linarith

theorem abs_integral_probeExterior_wingPair_otherLatProd_bt_le
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) {β : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912) :
    let w := probeExteriorBoltzmannWeight (L := L) β
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    let x (k : Fin 4) (U : GaugeConfig L) : ℝ := latChar L k U
    let y (k : Fin 4) (U : GaugeConfig L) : ℝ := botWingCharSum L k U * topWingCharSum L k U
    (|∫ U, w U * (y 0 U * x 1 U * x 2 U * x 3 U * (b U * t U)) ∂(gaugeHaarMeasure L)| ≤
      104 * β * probeExteriorPartition L β) ∧
    (|∫ U, w U * (x 0 U * y 1 U * x 2 U * x 3 U * (b U * t U)) ∂(gaugeHaarMeasure L)| ≤
      104 * β * probeExteriorPartition L β) ∧
    (|∫ U, w U * (x 0 U * x 1 U * y 2 U * x 3 U * (b U * t U)) ∂(gaugeHaarMeasure L)| ≤
      104 * β * probeExteriorPartition L β) ∧
    (|∫ U, w U * (x 0 U * x 1 U * x 2 U * y 3 U * (b U * t U)) ∂(gaugeHaarMeasure L)| ≤
      104 * β * probeExteriorPartition L β) := by
  intro w b t x y
  have hL2 : 2 ≤ L := by omega
  have hy_le (k : Fin 4) (U : GaugeConfig L) : |y k U| ≤ 16 := by
    dsimp [y]
    rw [abs_mul]
    have hB := abs_botWingCharSum_le_four k U
    have hT := abs_topWingCharSum_le_four k U
    have h := mul_le_mul hB hT (abs_nonneg _) (by norm_num)
    linarith
  have hbt_inv (k : Fin 4) (U : GaugeConfig L) :
      b (twistLinkNegOne (latVertLink L k) U) = b U ∧
      t (twistLinkNegOne (latVertLink L k) U) = t U := by
    dsimp [b, t]
    exact ⟨by rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _
                (latVertLink_not_mem_probePlaquettes L k).1],
           by rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U _
                (latVertLink_not_mem_probePlaquettes L k).2]⟩
  have hy_inv (k : Fin 4) (U : GaugeConfig L) :
      y k (twistLinkNegOne (latVertLink L k) U) = y k U := by
    dsimp [y]
    rw [botWingCharSum_twist_latVertLink k U, topWingCharSum_twist_latVertLink k U]
  have h_abs_prod (a c1 c2 c3 c4 c5 : ℝ)
      (ha : |a| ≤ 16) (h1 : |c1| ≤ 1) (h2 : |c2| ≤ 1) (h3 : |c3| ≤ 1)
      (h4 : |c4| ≤ 1) (h5 : |c5| ≤ 1) :
      |a * c1 * c2 * c3 * (c4 * c5)| ≤ 16 := by
