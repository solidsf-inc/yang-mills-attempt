theorem integral_mul_lateralCharacterSum_pow_four_mul_probes_eq
    {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ e ∈ cubeLinks L, ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U e.x e.μ g) = H U) :
    (∫ U : GaugeConfig L,
      H U *
        ((lateralCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
      ∂(gaugeHaarMeasure L)) =
    (∫ U : GaugeConfig L, H U ∂(gaugeHaarMeasure L)) * (24 * cubeSixFaceHaarIntegral) := by
  have hL2 : 2 ≤ L := by omega
  let x₀ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 0))
  let x₁ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 1))
  let x₂ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 2))
  let x₃ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 3))
  have hx₀ : Continuous x₀ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 0))
  have hx₁ : Continuous x₁ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 1))
  have hx₂ : Continuous x₂ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 2))
  have hx₃ : Continuous x₃ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 3))
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  let P₀ : GaugeConfig L → ℝ := fun U =>
    H U * (((x₁ U + x₂ U + x₃ U) ^ 4 - (x₁ U + x₂ U) ^ 4 - (x₁ U + x₃ U) ^ 4 -
      (x₂ U + x₃ U) ^ 4 + x₁ U ^ 4 + x₂ U ^ 4 + x₃ U ^ 4) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
  let P₁ : GaugeConfig L → ℝ := fun U =>
    H U * (((x₀ U + x₂ U + x₃ U) ^ 4 - (x₀ U + x₂ U) ^ 4 - (x₀ U + x₃ U) ^ 4 + x₀ U ^ 4) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
  let P₂ : GaugeConfig L → ℝ := fun U =>
    H U * (((x₀ U + x₁ U + x₃ U) ^ 4 - (x₀ U + x₁ U) ^ 4) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
  let P₃ : GaugeConfig L → ℝ := fun U =>
    H U * ((x₀ U + x₁ U + x₂ U) ^ 4 *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
  have hP₀_cont : Continuous P₀ :=
    hH_cont.mul (((((((((hx₁.add hx₂).add hx₃).pow 4).sub ((hx₁.add hx₂).pow 4)).sub
      ((hx₁.add hx₃).pow 4)).sub ((hx₂.add hx₃).pow 4)).add (hx₁.pow 4)).add
      (hx₂.pow 4) |>.add (hx₃.pow 4)).mul hb)
  have hP₁_cont : Continuous P₁ :=
    hH_cont.mul (((((((hx₀.add hx₂).add hx₃).pow 4).sub ((hx₀.add hx₂).pow 4)).sub
      ((hx₀.add hx₃).pow 4)).add (hx₀.pow 4)).mul hb)
  have hP₂_cont : Continuous P₂ :=
    hH_cont.mul (((((hx₀.add hx₁).add hx₃).pow 4).sub ((hx₀.add hx₁).pow 4)).mul hb)
  have hP₃_cont : Continuous P₃ :=
    hH_cont.mul ((((hx₀.add hx₁).add hx₂).pow 4).mul hb)
  have hP₀_zero : (∫ U, P₀ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 0)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 0) P₀ hP₀_cont (fun U g => ?_)
    dsimp only [P₀, x₁, x₂, x₃]
    rw [hH_inv _ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 0) U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 1)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (0 : Fin 4) ≠ 1)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 2)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (0 : Fin 4) ≠ 2)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 3)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (0 : Fin 4) ≠ 3)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 0)) g]
  have hP₁_zero : (∫ U, P₁ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 1)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 1) P₁ hP₁_cont (fun U g => ?_)
    dsimp only [P₁, x₀, x₂, x₃]
    rw [hH_inv _ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 1) U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 0)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (1 : Fin 4) ≠ 0)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 2)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (1 : Fin 4) ≠ 2)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 3)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (1 : Fin 4) ≠ 3)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 1)) g]
  have hP₂_zero : (∫ U, P₂ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 2)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 2) P₂ hP₂_cont (fun U g => ?_)
    dsimp only [P₂, x₀, x₁, x₃]
    rw [hH_inv _ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 2) U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 0)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (2 : Fin 4) ≠ 0)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 1)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (2 : Fin 4) ≠ 1)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 3)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (2 : Fin 4) ≠ 3)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 2)) g]
  have hP₃_zero : (∫ U, P₃ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 3)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 3) P₃ hP₃_cont (fun U g => ?_)
    dsimp only [P₃, x₀, x₁, x₂]
    rw [hH_inv _ (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLinks L 3) U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 0)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (3 : Fin 4) ≠ 0)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 1)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (3 : Fin 4) ≠ 1)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 2)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (3 : Fin 4) ≠ 2)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 3)) g]
  let M_six : GaugeConfig L → ℝ := fun U =>
    24 * (H U *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (0 + 1 * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (0 + 1 * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        (0 + 1 * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
        (0 + 1 * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L))) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
  have hM_six_cont : Continuous M_six := by dsimp [M_six]; fun_prop
  have hM_six_int :
      (∫ U, M_six U ∂(gaugeHaarMeasure L)) =
        (∫ U, H U ∂(gaugeHaarMeasure L)) * (24 * cubeSixFaceHaarIntegral) := by
    dsimp only [M_six]
    rw [integral_const_mul,
        integral_gaugeHaarMeasure_mul_cubeSixFace_general_eq hL2 H hH_cont hH_inv 0 0 0 0 1 1 1 1]
    ring
  have h_pt :
      (fun U : GaugeConfig L =>
        H U * ((lateralCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))) =
      fun U : GaugeConfig L =>
        ((((M_six U + P₀ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
          P₁ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
          P₂ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
          P₃ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
    funext U
    rw [lateralCharacterSum_eq_sum_four hL2 U]
    dsimp only [M_six, P₀, P₁, P₂, P₃, x₀, x₁, x₂, x₃, cubeLateralAt]
    ring
  rw [h_pt,
      integral_add5_apply M_six
        (fun U => P₀ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        (fun U => P₁ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        (fun U => P₂ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        (fun U => P₃ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        hM_six_cont (hP₀_cont.mul ht) (hP₁_cont.mul ht) (hP₂_cont.mul ht) (hP₃_cont.mul ht),
      hM_six_int, hP₀_zero, hP₁_zero, hP₂_zero, hP₃_zero]
