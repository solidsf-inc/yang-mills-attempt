  norm_num

/-- At every RG step `j` and scale `m`, the truncation remainder `R_trunc` of
    `scheduledHaarRGStateAux L_ir β_uv β_sched j m` vanishes at `vacuumConfig`. -/
theorem scheduledHaarRGStateAux_R_trunc_vacuum_eq_zero
    (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ) :
    ∀ (j m : ℕ),
      (scheduledHaarRGStateAux L_ir β_uv β_sched j m).R_trunc
        (vacuumConfig (dyadicScaleSide L_ir m)) = 0
  | 0, _ => rfl
  | j + 1, m => by
      dsimp [scheduledHaarRGStateAux]
      rw [sub_self, wilsonAction_vacuum, sub_zero]

/-- Exact total-non-vacuum-action invariance between `scheduledHaarRGStateAux` and
    `canonicalRGStateAux`: for any schedule `β_sched : ℕ → ℝ`, at every step `j` and scale `m`,
    `wilsonAction st.β V + st.polymers.eval V + st.R_trunc V` of `scheduledHaarRGStateAux`
    equals that of `canonicalRGStateAux` identically. -/
theorem scheduledHaarRGStateAux_totalNonVacuumAction_eq_canonicalRGStateAux
    (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ) :
    ∀ (j m : ℕ) (V : GaugeConfig (dyadicScaleSide L_ir m)),
      let st_s := scheduledHaarRGStateAux L_ir β_uv β_sched j m
      let st_c := canonicalRGStateAux L_ir β_uv j m
      wilsonAction st_s.β V + st_s.polymers.eval V + st_s.R_trunc V =
        wilsonAction st_c.β V + st_c.polymers.eval V + st_c.R_trunc V
  | 0, _, _ => rfl
  | j + 1, m, V => by
      let L_m := dyadicScaleSide L_ir m
      let st_s_prev := scheduledHaarRGStateAux L_ir β_uv β_sched j (m + 1)
      let st_c_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
      have ih : (fun U => wilsonAction st_s_prev.β U + st_s_prev.polymers.eval U + st_s_prev.R_trunc U) =
          (fun U => wilsonAction st_c_prev.β U + st_c_prev.polymers.eval U + st_c_prev.R_trunc U) :=
        funext (scheduledHaarRGStateAux_totalNonVacuumAction_eq_canonicalRGStateAux L_ir β_uv β_sched j (m + 1))
      have hA_eq :
          interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_s_prev.β
            (fun U => st_s_prev.polymers.eval U + st_s_prev.R_trunc U) =
          interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_c_prev.β
            (fun U => st_c_prev.polymers.eval U + st_c_prev.R_trunc U) := by
        rw [interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction
              (haarBlockDisintegration L_m) st_s_prev,
            interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction
              (haarBlockDisintegration L_m) st_c_prev,
            ih]
      dsimp only [scheduledHaarRGStateAux, canonicalRGStateAux]
      rw [PolymerActivityFamily.eval_empty]
      change wilsonAction (β_sched (j + 1)) V + 0 +
          ((interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_s_prev.β
              (fun U => st_s_prev.polymers.eval U + st_s_prev.R_trunc U) V -
            interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_s_prev.β
              (fun U => st_s_prev.polymers.eval U + st_s_prev.R_trunc U) (vacuumConfig L_m)) -
            wilsonAction (β_sched (j + 1)) V) = _
      rw [hA_eq]
      ring

/-- Unconditional $49^j$-free `R_trunc` measurability, single-link oscillation bound
    `12 * β_uv + 12 * β_sched j`, and two-link mixed-difference bound `24 * (β_uv + β_sched j)`
    for `scheduledHaarRGStateAux L_ir β_uv β_sched j m` at every step `j` and scale `m`. -/
theorem scheduledHaarRGStateAux_unconditional_R_trunc_bounds
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (β_sched : ℕ → ℝ) (hsched : ∀ j : ℕ, 0 ≤ β_sched j) (j m : ℕ) :
    let L_m := dyadicScaleSide L_ir m
    let st := scheduledHaarRGStateAux L_ir β_uv β_sched j m
    Measurable st.R_trunc ∧
    (∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
      |st.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
        st.R_trunc (updateGaugeLink L_m V e.x e.μ g2)| ≤
        12 * β_uv + 12 * β_sched j) ∧
    (∀ (V : GaugeConfig L_m) (e e' : Link L_m) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L_m st.R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
        2 * (12 * β_uv + 12 * β_sched j)) := by
  dsimp only
  let L_m := dyadicScaleSide L_ir m
  let st := scheduledHaarRGStateAux L_ir β_uv β_sched j m
  let st_c := canonicalRGStateAux L_ir β_uv j m
  let S_c : GaugeConfig L_m → ℝ :=
    fun V => wilsonAction st_c.β V + st_c.polymers.eval V + st_c.R_trunc V
  have hc := canonicalRGStateAux_unconditional_R_trunc_bounds L_ir hβ j m
  rcases hc with ⟨_, _, hSc_meas, _, hSc_osc, _, _, _⟩
  have hR_eq : st.R_trunc = fun V => S_c V - wilsonAction st.β V := by
    funext V
    have h_tot := scheduledHaarRGStateAux_totalNonVacuumAction_eq_canonicalRGStateAux
      L_ir β_uv β_sched j m V
    have h_poly : st.polymers = PolymerActivityFamily.empty L_m :=
      scheduledHaarRGStateAux_polymers_eq_empty L_ir β_uv β_sched j m
    dsimp only [S_c]
    rw [← h_tot, h_poly, PolymerActivityFamily.eval_empty]
    ring
  have hR_meas : Measurable st.R_trunc := by
    rw [hR_eq]
    exact hSc_meas.sub (measurable_wilsonAction st.β)
  have hR_osc : ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
      |st.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
        st.R_trunc (updateGaugeLink L_m V e.x e.μ g2)| ≤
        12 * β_uv + 12 * β_sched j := by
    cases j with
    | zero =>
      intro V e g1 g2
      change |(0 : ℝ) - 0| ≤ _
      rw [sub_self, abs_zero]
      have h0 := hsched 0
      positivity
    | succ j =>
      intro V e g1 g2
      have h_split :
          st.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
            st.R_trunc (updateGaugeLink L_m V e.x e.μ g2) =
          (S_c (updateGaugeLink L_m V e.x e.μ g1) -
            S_c (updateGaugeLink L_m V e.x e.μ g2)) -
          (wilsonAction (β_sched (j + 1)) (updateGaugeLink L_m V e.x e.μ g1) -
            wilsonAction (β_sched (j + 1)) (updateGaugeLink L_m V e.x e.μ g2)) := by
        rw [hR_eq]
        change (S_c _ - wilsonAction (β_sched (j + 1)) _) -
          (S_c _ - wilsonAction (β_sched (j + 1)) _) = _
        ring
      rw [h_split]
      have h_tri := abs_sub
        (S_c (updateGaugeLink L_m V e.x e.μ g1) -
          S_c (updateGaugeLink L_m V e.x e.μ g2))
        (wilsonAction (β_sched (j + 1)) (updateGaugeLink L_m V e.x e.μ g1) -
          wilsonAction (β_sched (j + 1)) (updateGaugeLink L_m V e.x e.μ g2))
      have h_w := wilsonAction_singleLink_oscillation_le L_m (hsched (j + 1)) V e.x e.μ g1 g2
      have h_s := hSc_osc V e g1 g2
      linarith
  have h_norm :=
    truncationDobrushinNormBound_of_singleLink_osc
      st.R_trunc
      (by have := hsched j; positivity : 0 ≤ 12 * β_uv + 12 * β_sched j)
      (scheduledHaarRGStateAux_R_trunc_vacuum_eq_zero L_ir β_uv β_sched j m)
      hR_meas hR_osc
  exact ⟨hR_meas, hR_osc, h_norm.2.1⟩

/-- Unconditional single-step Gibbs-measure pushforward theorem for `scheduledHaarRGChain`:
    for any non-negative schedule `β_sched`, pushing `((scheduledHaarRGChain ...).state (m + 1)).gibbsMeasure`
    forward under `dyadicLinkBlockMap (dyadicScaleSide L_ir m)` yields
    `((scheduledHaarRGChain ...).state m).gibbsMeasure` with zero caller-supplied hypotheses. -/
theorem scheduledHaarRGChain_step_gibbsMeasure_map_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (β_sched : ℕ → ℝ) (hsched : ∀ j : ℕ, 0 ≤ β_sched j) {m : ℕ} (hm : m < K) :
    (((scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1)).gibbsMeasure).map
      (dyadicLinkBlockMap (dyadicScaleSide L_ir m)) =
      ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state m).gibbsMeasure := by
  have hm1_le : m + 1 ≤ K := hm
  have h_eq : (scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1) =
      scheduledHaarRGStateAux L_ir β_uv β_sched (K - (m + 1)) (m + 1) := by
    simp [scheduledHaarRGChain, scheduledHaarRGState, hm1_le]
  have h_uncond := scheduledHaarRGStateAux_unconditional_R_trunc_bounds
    L_ir hβ β_sched hsched (K - (m + 1)) (m + 1)
  have hR_meas : Measurable ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1)).R_trunc := by
    rw [h_eq]
    exact h_uncond.1
  have hR_vac : ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1)).R_trunc
      (vacuumConfig (dyadicScaleSide L_ir (m + 1))) = 0 := by
    rw [h_eq]
    exact scheduledHaarRGStateAux_R_trunc_vacuum_eq_zero L_ir β_uv β_sched (K - (m + 1)) (m + 1)
  have hR_osc : ∀ (U : GaugeConfig (dyadicScaleSide L_ir (m + 1)))
      (e : Link (dyadicScaleSide L_ir (m + 1))) (g1 g2 : SU2),
      |((scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g1) -
        ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g2)| ≤
        12 * β_uv + 12 * β_sched (K - (m + 1)) := by
    rw [h_eq]
    exact h_uncond.2.1
  let B_R := (Fintype.card (Link (dyadicScaleSide L_ir (m + 1))) : ℝ) *
    (12 * β_uv + 12 * β_sched (K - (m + 1)))
  have hR_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
      |((scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1)).R_trunc U| ≤ B_R := fun U => by
    have h_sub := abs_sub_le_card_mul_singleLink_osc
      ((scheduledHaarRGChain L_ir K hβ β_sched hsched).state (m + 1)).R_trunc hR_osc U
      (vacuumConfig (dyadicScaleSide L_ir (m + 1)))
    rw [hR_vac, sub_zero] at h_sub
    exact h_sub
  exact ((scheduledHaarRGChain L_ir K hβ β_sched hsched).step_partitionFunction_and_gibbsMeasure_map_eq
    hm hR_meas hR_bdd).2.2.2

/-- **Set 4 (`Argon`) Simplified 2-Obligation Constructor for `BalabanMultiScaleUVToIRFlow` (`R5`) & `LandingTube` (`R3`):**
    Eliminates `polymers.eval` (`= 0`), evaluates `probeLoopOscillationBudget = 16`, discharges `n = 0`
    unconditionally, and discharges `WilsonCharFloor` (`hF`) and `LandingTube.h_floor` unconditionally via
    `BalabanMultiScaleUVToIRFlow.wilsonCharFloor`, so that **both** `BalabanMultiScaleUVToIRFlow dyadicOneLoopPath`
    (all 20 fields) and `LandingTube dyadicOneLoopPath` (all 18 fields) follow from **only**
    the 2 pure `R_trunc` bounds at `m = 0` (`0 < n`). -/
noncomputable def ARGON_SET4_R5_and_R3_of_two_pure_R_trunc_obligations
    (h_R_mixed : ∀ n : ℕ, 0 < n →
      ∀ (V : GaugeConfig (dyadicScaleSide (2 ^ n) 0))
        (e e' : Link (dyadicScaleSide (2 ^ n) 0)) (g1 g2 h1 h2 : SU2),
        |twoLinkMixedDifference (dyadicScaleSide (2 ^ n) 0)
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
          if e' ∈ dobrushinNeighbors e then canonicalBalabanDeltaNbStep (n - 0) else 0)
    (h_R_osc : ∀ n : ℕ, 0 < n →
      ∀ (V : GaugeConfig (2 ^ n)) (e : Link (2 ^ n)) (g1 g2 : SU2),
        |((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
            (updateGaugeLink (2 ^ n) V e.x e.μ g1) -
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
            (updateGaugeLink (2 ^ n) V e.x e.μ g2)| ≤
          (canonicalCrossoverCovLo : ℝ) / 384) :
    BalabanMultiScaleUVToIRFlow dyadicOneLoopPath × LandingTube dyadicOneLoopPath :=
  let h_rem_local_osc : ∀ (n : ℕ) (V : GaugeConfig (2 ^ n)) (e : Link (2 ^ n)) (g1 g2 : SU2),
      InteractingEffectiveActionState.probeLoopOscillationBudget ((1 : ℚ) : ℝ)
        (canonicalSpatialProbe 1 (by norm_num)) *
        |(((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).polymers.eval
            (updateGaugeLink (2 ^ n) V e.x e.μ g1) +
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
            (updateGaugeLink (2 ^ n) V e.x e.μ g1)) -
        (((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).polymers.eval
            (updateGaugeLink (2 ^ n) V e.x e.μ g2) +
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
            (updateGaugeLink (2 ^ n) V e.x e.μ g2))| ≤
        (canonicalCrossoverCovLo : ℝ) / 24 := fun n V e g1 g2 => by
    rw [probeLoopOscillationBudget_canonicalSpatialProbe_eq_sixteen 1 (by norm_num)]
    have hP : ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
        (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).polymers =
        PolymerActivityFamily.empty (2 ^ n) :=
      scheduledHaarRGState_polymers_eq_empty (2 ^ n) n (dyadicOneLoopPath.coupling n)
        (balabanOneLoopDriftSchedule n) 0
    rw [hP, PolymerActivityFamily.eval_empty, PolymerActivityFamily.eval_empty, zero_add, zero_add]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · change 16 * |(0 : ℝ) - 0| ≤ _
      norm_num [canonicalCrossoverCovLo]
    · linarith [h_R_osc n hn V e g1 g2]
  let M := ARGON_SET4_R5_BalabanMultiScaleUVToIRFlow_of_two_core_obligations h_R_mixed h_rem_local_osc
  (M, M.toLandingTube M.wilsonCharFloor)

/-- **Set 4 (`Argon`) Obligation `R3` Reduction Constructor:**
    Unconditionally discharges 16 out of 18 fields of `LandingTube dyadicOneLoopPath`
    (`ℓstar, hℓstar, K, hK, irSide, instNeZeroIrSide, hside, chain, β_star, η_star, ε_star, h_land,
    Z_tube, hZ_tube_scheme, c_floor, hc_floor`) plus the first two conjuncts of `h_tube`
    (`((chain n).state 0).β ≤ β_star` and `PolymerDobrushinNormBound ((chain n).state 0).polymers η_star`),
    reducing `LandingTube dyadicOneLoopPath` to the exact 2 non-perturbative remainder/covariance
    hypotheses `h_trunc_tube` and `h_cov_floor`. -/
noncomputable def ARGON_SET4_R3_LandingTube_of_two_core_obligations
    (h_trunc_tube : ∀ᶠ n in atTop,
      TruncationDobrushinNormBound
        ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
          crossoverLandingSchedule crossoverLandingSchedule_nonneg).state 0).R_trunc
        (canonicalCrossoverBetaLo : ℝ))
    (h_cov_floor : ∀ᶠ n in atTop,
      (canonicalCrossoverCovLo : ℝ) ≤
        |irCov
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            crossoverLandingSchedule crossoverLandingSchedule_nonneg).state 0).gibbsMeasure
          (physicalWilsonLoop (2 ^ n) ((1 : ℚ) : ℝ)
            (canonicalSpatialProbe 1 (by norm_num)).timeReflect)
          (physicalWilsonLoop (2 ^ n) ((1 : ℚ) : ℝ)
            (canonicalSpatialProbe 1 (by norm_num)))|) :
    LandingTube dyadicOneLoopPath where
  ℓstar := 1
  hℓstar := by norm_num
  K := fun n => n
  hK := by
    filter_upwards with n
    dsimp [dyadicOneLoopPath]
    have hpow : (2 : ℝ) ^ n ≠ 0 := pow_ne_zero n (by norm_num)
    rw [one_div_pow, div_mul_cancel₀ 1 hpow]
    norm_num
  irSide := fun n => 2 ^ n
  instNeZeroIrSide := fun n => ⟨pow_ne_zero n (by decide)⟩
  hside := by
    filter_upwards with n
    dsimp [dyadicOneLoopPath]
    rw [dyadicScaleSide_eq_two_pow_mul, ← Nat.mul_pow]
  chain := fun n =>
    scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
