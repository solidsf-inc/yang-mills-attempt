/-! ### Explicit `MultiStepHaarRGChain` Inhabitants, Exact $K$-Step Haar Blocking Pushforward, and Fixed-Scale Strong-Coupling Inhabitant -/

/-- Explicit canonical inhabitant of `MultiStepHaarRGChain L_ir K β_uv` built from
`canonicalRGState L_ir K β_uv`. -/
noncomputable def canonicalRGChain (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    MultiStepHaarRGChain L_ir K β_uv where
  state := canonicalRGState L_ir K β_uv
  ε_trunc := fun m V => |((canonicalRGState L_ir K β_uv m).R_trunc V)|
  h_uv := by simp [canonicalRGState, canonicalRGStateAux]
  h_β_nonneg := fun m hm => by
    simp only [canonicalRGState, hm, ↓reduceIte]
    exact canonicalRGStateAux_β_nonneg L_ir hβ (K - m) m
  h_ε_nonneg := fun _ _ _ => abs_nonneg _
  h_R_trunc_le := fun _ _ _ => le_rfl
  h_step_exact := fun m hm V => by
    have hm_le : m ≤ K := Nat.le_of_lt hm
    have hm1_le : m + 1 ≤ K := hm
    have hsub : K - m = (K - (m + 1)) + 1 := by omega
    have h_lhs : canonicalRGState L_ir K β_uv m =
        canonicalRGStateAux L_ir β_uv ((K - (m + 1)) + 1) m := by
      simp only [canonicalRGState, hm_le, ↓reduceIte, hsub]
    have h_rhs : canonicalRGState L_ir K β_uv (m + 1) =
        canonicalRGStateAux L_ir β_uv (K - (m + 1)) (m + 1) := by
      simp only [canonicalRGState, hm1_le, ↓reduceIte]
    rw [h_lhs, h_rhs]
    dsimp [canonicalRGStateAux, InteractingEffectiveActionState.totalAction]
    rw [PolymerActivityFamily.eval_empty]
    ring

/-- Scale-indexed state family for the contractive local-polymer RG chain of depth `K`
(`localPolymerRGStateAux L_ir β_uv w_poly (K - m) m` for `m ≤ K`, and `pureWilson` above `K`). -/
noncomputable def localPolymerRGState (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ) (w_poly : ℕ → ℝ)
    (m : ℕ) : InteractingEffectiveActionState (dyadicScaleSide L_ir m) :=
  if m ≤ K then
    localPolymerRGStateAux L_ir β_uv w_poly (K - m) m
  else
    InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv

/-- Explicit local-polymer inhabitant of `MultiStepHaarRGChain L_ir K β_uv` with downward-contracting
running coupling `(1 / 2) ^ (K - m) * β_uv` and non-empty local plaquette polymer family
`PolymerActivityFamily.localPlaquette`. -/
noncomputable def localPolymerRGChain (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) : MultiStepHaarRGChain L_ir K β_uv where
  state := localPolymerRGState L_ir K β_uv w_poly
  ε_trunc := fun m V => |((localPolymerRGState L_ir K β_uv w_poly m).R_trunc V)|
  h_uv := by simp [localPolymerRGState, localPolymerRGStateAux]
  h_β_nonneg := fun m hm => by
    simp only [localPolymerRGState, hm, ↓reduceIte]
    rcases eq_or_lt_of_le hm with rfl | hlt
    · simp [localPolymerRGStateAux, InteractingEffectiveActionState.pureWilson, hβ]
    · obtain ⟨j, hj⟩ : ∃ j, K - m = j + 1 := Nat.exists_eq_succ_of_ne_zero (by omega)
      rw [hj]
      dsimp [localPolymerRGStateAux]
      exact mul_nonneg (pow_nonneg (by norm_num) _) hβ
  h_ε_nonneg := fun _ _ _ => abs_nonneg _
  h_R_trunc_le := fun _ _ _ => le_rfl
  h_step_exact := fun m hm V => by
    have hm_le : m ≤ K := Nat.le_of_lt hm
    have hm1_le : m + 1 ≤ K := hm
    have hsub : K - m = (K - (m + 1)) + 1 := by omega
    have h_lhs : localPolymerRGState L_ir K β_uv w_poly m =
        localPolymerRGStateAux L_ir β_uv w_poly ((K - (m + 1)) + 1) m := by
      simp only [localPolymerRGState, hm_le, ↓reduceIte, hsub]
    have h_rhs : localPolymerRGState L_ir K β_uv w_poly (m + 1) =
        localPolymerRGStateAux L_ir β_uv w_poly (K - (m + 1)) (m + 1) := by
      simp only [localPolymerRGState, hm1_le, ↓reduceIte]
    rw [h_lhs, h_rhs]
    dsimp [localPolymerRGStateAux, InteractingEffectiveActionState.totalAction]
    ring

/-- At every RG step `j` and scale `m`, the total action of `canonicalRGStateAux L_ir β_uv j m`
at `vacuumConfig` equals its vacuum offset `c_vac`. -/
theorem canonicalRGStateAux_totalAction_vacuum_eq_c_vac (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) :
    ∀ (j m : ℕ),
      let L_m := dyadicScaleSide L_ir m
      let st := canonicalRGStateAux L_ir β_uv j m
      st.totalAction (vacuumConfig L_m) = st.c_vac
  | 0, m => by
      dsimp [canonicalRGStateAux, InteractingEffectiveActionState.pureWilson,
        InteractingEffectiveActionState.totalAction]
      simp only [wilsonAction_vacuum, PolymerActivityFamily.eval_empty]
      ring
  | j + 1, m => by
      dsimp [canonicalRGStateAux, InteractingEffectiveActionState.totalAction]
      simp only [wilsonAction_vacuum, PolymerActivityFamily.eval_empty]
      ring

/-- Exact non-vacuum effective action identity for `canonicalRGStateAux`: at every step `j + 1`,
`st_next.totalAction V - st_next.totalAction (vacuumConfig L_m)` is identically equal to the
vacuum-normalized Haar-blocked effective action
`interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev V -
 interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev (vacuumConfig L_m)`
with zero lost physics. -/
theorem canonicalRGStateAux_totalAction_sub_vacuum_eq_blockedEffectiveAction
    (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) (j m : ℕ)
    (V : GaugeConfig (dyadicScaleSide L_ir m)) :
    let L_m := dyadicScaleSide L_ir m
    let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
    let st_next := canonicalRGStateAux L_ir β_uv (j + 1) m
    let A_eff := interactingBlockedEffectiveAction (haarBlockDisintegration L_m)
      st_prev.β (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
    st_next.totalAction V - st_next.totalAction (vacuumConfig L_m) =
      A_eff V - A_eff (vacuumConfig L_m) := by
  dsimp [canonicalRGStateAux, InteractingEffectiveActionState.totalAction]
  simp only [PolymerActivityFamily.eval_empty, wilsonAction_vacuum]
  ring

/-- Universal non-vacuum effective action identity for any `C : MultiStepHaarRGChain L_ir K β_uv`:
at every blocking step `m < K`, the vacuum-subtracted total action
`(C.state m).totalAction V - (C.state m).totalAction (vacuumConfig L_m)` is identically equal to
the vacuum-subtracted Haar-blocked effective action of `C.state (m + 1)`. -/
theorem MultiStepHaarRGChain.step_totalAction_sub_vacuum_eq_blockedEffectiveAction
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m < K) (V : GaugeConfig (dyadicScaleSide L_ir m)) :
    let L_m := dyadicScaleSide L_ir m
    let st_prev := C.state (m + 1)
    let A_eff := interactingBlockedEffectiveAction (haarBlockDisintegration L_m)
      st_prev.β (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
    (C.state m).totalAction V - (C.state m).totalAction (vacuumConfig L_m) =
      A_eff V - A_eff (vacuumConfig L_m) := by
  dsimp only
  rw [C.h_step_exact m hm V, C.h_step_exact m hm (vacuumConfig (dyadicScaleSide L_ir m))]
  ring

/-- Exact step-by-step Haar fiber Boltzmann identity for any `C : MultiStepHaarRGChain L_ir K β_uv`:
at every blocking step `m < K` where `(C.state (m + 1)).R_trunc` is measurable and bounded,
integrating `Real.exp (-(C.state (m + 1)).totalAction U)` over the Haar block fiber
`haarBlockKernel L_m V` reproduces `Real.exp (-(C.state m).totalAction V)` identically. -/
theorem MultiStepHaarRGChain.step_fiber_integral_exp_neg_totalAction_eq
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m < K)
    (hR_meas : Measurable (C.state (m + 1)).R_trunc)
    {B_R : ℝ} (hR_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
      |(C.state (m + 1)).R_trunc U| ≤ B_R)
    (V : GaugeConfig (dyadicScaleSide L_ir m)) :
    let L_m := dyadicScaleSide L_ir m
    (∫ U, Real.exp (-(C.state (m + 1)).totalAction U) ∂(haarBlockKernel L_m V)) =
      Real.exp (-(C.state m).totalAction V) := by
  dsimp only
  let L_m := dyadicScaleSide L_ir m
  let st_fine := C.state (m + 1)
  let st_coarse := C.state m
  let K_fine : GaugeConfig (2 * L_m) → ℝ := fun U => st_fine.polymers.eval U + st_fine.R_trunc U
  have hβ_fine : 0 ≤ st_fine.β := C.h_β_nonneg (m + 1) hm
  have hK_meas : Measurable K_fine :=
    st_fine.polymers.continuous_eval.measurable.add hR_meas
  let B_K : ℝ := (∑ i : st_fine.polymers.idx, 2 * |st_fine.polymers.weights i|) + B_R
  have hK_bounds : ∀ U : GaugeConfig (2 * L_m), -B_K ≤ K_fine U ∧ K_fine U ≤ B_K := fun U => by
    have hP := st_fine.polymers.abs_eval_le U
    have hR := hR_bdd U
    have h_tri := abs_add_le (st_fine.polymers.eval U) (st_fine.R_trunc U)
    exact abs_le.mp (by dsimp [K_fine, B_K]; linarith)
  have hW_pos : 0 < interactingBlockedFiberWeight (haarBlockDisintegration L_m) st_fine.β K_fine V :=
    (interactingBlockedFiberWeight_zero_remainder_and_exponential_sandwich
      (haarBlockDisintegration L_m) hβ_fine (measurable_wilsonAction st_fine.β)
      K_fine hK_meas hK_bounds V).2.1.2.2
  have h_pt : ∀ U : GaugeConfig (2 * L_m),
      Real.exp (-st_fine.totalAction U) =
        Real.exp (-st_fine.c_vac) * Real.exp (-wilsonAction st_fine.β U - K_fine U) := fun U => by
    rw [st_fine.exp_neg_totalAction_eq U]
    unfold InteractingEffectiveActionState.boltzmannDensity K_fine
    congr 2
    ring
  calc
    (∫ U, Real.exp (-st_fine.totalAction U) ∂(haarBlockKernel L_m V))
      = ∫ U, Real.exp (-st_fine.c_vac) * Real.exp (-wilsonAction st_fine.β U - K_fine U)
          ∂(haarBlockKernel L_m V) := by
          simp_rw [h_pt]
    _ = Real.exp (-st_fine.c_vac) *
          interactingBlockedFiberWeight (haarBlockDisintegration L_m) st_fine.β K_fine V := by
          rw [integral_const_mul]
          rfl
    _ = Real.exp (-st_coarse.totalAction V) := by
          rw [C.h_step_exact m hm V]
          unfold interactingBlockedEffectiveAction
          rw [show -(st_fine.c_vac + -Real.log
              (interactingBlockedFiberWeight (haarBlockDisintegration L_m) st_fine.β K_fine V)) =
            -st_fine.c_vac + Real.log
              (interactingBlockedFiberWeight (haarBlockDisintegration L_m) st_fine.β K_fine V) by ring,
            Real.exp_add, Real.exp_log hW_pos]

/-- Exact single-step partition-function invariance and Gibbs-measure pushforward identity for any
`C : MultiStepHaarRGChain L_ir K β_uv`: at every blocking step `m < K` where
`(C.state (m + 1)).R_trunc` is measurable and bounded:
1. `(C.state m).totalAction` is measurable and bounded,
2. The total-action partition functions are identically equal across the blocking step:
   `groupGibbsPartition SU2 L_m (C.state m).totalAction =
    groupGibbsPartition SU2 (2 * L_m) (C.state (m + 1)).totalAction`,
3. Pushing `(C.state (m + 1)).gibbsMeasure` forward under `dyadicLinkBlockMap L_m` yields
   `(C.state m).gibbsMeasure` identically:
   `((C.state (m + 1)).gibbsMeasure).map (dyadicLinkBlockMap L_m) = (C.state m).gibbsMeasure`. -/
theorem MultiStepHaarRGChain.step_partitionFunction_and_gibbsMeasure_map_eq
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m < K)
    (hR_meas : Measurable (C.state (m + 1)).R_trunc)
    {B_R : ℝ} (hR_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
      |(C.state (m + 1)).R_trunc U| ≤ B_R) :
    let L_m := dyadicScaleSide L_ir m
    Measurable (C.state m).totalAction ∧
    (∃ B_coarse : ℝ, ∀ V : GaugeConfig L_m, |(C.state m).totalAction V| ≤ B_coarse) ∧
    groupGibbsPartition SU2 L_m (C.state m).totalAction =
      groupGibbsPartition SU2 (dyadicScaleSide L_ir (m + 1)) (C.state (m + 1)).totalAction ∧
    ((C.state (m + 1)).gibbsMeasure).map (dyadicLinkBlockMap L_m) =
      (C.state m).gibbsMeasure := by
  dsimp only
  let L_m := dyadicScaleSide L_ir m
  let st_fine := C.state (m + 1)
  let st_coarse := C.state m
  let K_fine : GaugeConfig (2 * L_m) → ℝ := fun U => st_fine.polymers.eval U + st_fine.R_trunc U
  have hβ_fine : 0 ≤ st_fine.β := C.h_β_nonneg (m + 1) hm
  have hK_meas : Measurable K_fine :=
    st_fine.polymers.continuous_eval.measurable.add hR_meas
  let B_K : ℝ := (∑ i : st_fine.polymers.idx, 2 * |st_fine.polymers.weights i|) + B_R
  have hK_bounds : ∀ U : GaugeConfig (2 * L_m), -B_K ≤ K_fine U ∧ K_fine U ≤ B_K := fun U => by
    have hP := st_fine.polymers.abs_eval_le U
    have hR := hR_bdd U
    have h_tri := abs_add_le (st_fine.polymers.eval U) (st_fine.R_trunc U)
    exact abs_le.mp (by dsimp [K_fine, B_K]; linarith)
  have h_act_eq : st_coarse.totalAction = fun V =>
      st_fine.c_vac + interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V :=
    funext (C.h_step_exact m hm)
  have hS_coarse_meas : Measurable st_coarse.totalAction := by
    rw [h_act_eq]
    exact measurable_const.add
      (measurable_haarInteractingBlockedEffectiveAction st_fine.β K_fine hK_meas)
  let B_W : ℝ := 2 * st_fine.β * (Fintype.card (Plaquette (2 * L_m)) : ℝ)
  let B_coarse : ℝ := |st_fine.c_vac| + |B_K| + |B_W|
  have hS_coarse_bdd : ∀ V : GaugeConfig L_m, |st_coarse.totalAction V| ≤ B_coarse := fun V => by
    have h_sand := (interactingBlockedFiberWeight_zero_remainder_and_exponential_sandwich
      (haarBlockDisintegration L_m) hβ_fine (measurable_wilsonAction st_fine.β)
      K_fine hK_meas hK_bounds V).2.2
    have hW_sand := wilsonBlockedEffectiveAction_bounds_and_exp_neg_eq_weight
      (haarBlockDisintegration L_m) hβ_fine (measurable_wilsonAction st_fine.β) V
    have h_eff_lo : -B_K ≤
        interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V := by
      linarith [h_sand.1, hW_sand.1]
    have h_eff_hi :
        interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V ≤
          B_W + B_K := by
      have h1 : wilsonBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β V ≤ B_W :=
        hW_sand.2.1
      linarith [h_sand.2]
    have h_abs_eff :
        |interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V| ≤
          |B_K| + |B_W| := by
      rw [abs_le]
      refine ⟨?_, ?_⟩
      · have h_bk : B_K ≤ |B_K| := le_abs_self B_K
        have h_bw : 0 ≤ |B_W| := abs_nonneg B_W
        linarith
      · have h_bk : B_K ≤ |B_K| := le_abs_self B_K
        have h_bw : B_W ≤ |B_W| := le_abs_self B_W
        linarith
    rw [C.h_step_exact m hm V]
    have h_tri := abs_add_le st_fine.c_vac
      (interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V)
    dsimp [B_coarse]
    linarith
  have hS_fine_meas : Measurable st_fine.totalAction := st_fine.measurable_totalAction hR_meas
  let B_fine : ℝ :=
    |st_fine.c_vac| + st_fine.β * (∑ _p : Plaquette (2 * L_m), (2 : ℝ)) +
      (∑ i : st_fine.polymers.idx, 2 * |st_fine.polymers.weights i|) + B_R
  have hS_fine_bdd : ∀ U : GaugeConfig (2 * L_m), |st_fine.totalAction U| ≤ B_fine :=
    st_fine.abs_totalAction_le hβ_fine hR_bdd
  let Z_fine := groupGibbsPartition SU2 (2 * L_m) st_fine.totalAction
  let Z_coarse := groupGibbsPartition SU2 L_m st_coarse.totalAction
  have hZ_fine_pos : 0 < Z_fine :=
    groupGibbsPartition_pos SU2 st_fine.totalAction hS_fine_meas hS_fine_bdd
  have hZ_coarse_pos : 0 < Z_coarse :=
    groupGibbsPartition_pos SU2 st_coarse.totalAction hS_coarse_meas hS_coarse_bdd
  have hw_fine_meas : Measurable (fun U : GaugeConfig (2 * L_m) =>
      ENNReal.ofReal (Real.exp (-st_fine.totalAction U) / Z_fine)) :=
    ((Real.continuous_exp.measurable.comp hS_fine_meas.neg).div_const Z_fine).ennreal_ofReal
  have h_gibbs_fine : st_fine.gibbsMeasure =
      (gaugeHaarMeasure (2 * L_m)).withDensity (fun U =>
        ENNReal.ofReal (Real.exp (-st_fine.totalAction U) / Z_fine)) := by
    unfold InteractingEffectiveActionState.gibbsMeasure Z_fine
    rw [st_fine.groupGibbsPartition_totalAction_eq]
    congr 1
    funext U
    rw [st_fine.exp_neg_totalAction_eq,
      mul_div_mul_left (st_fine.boltzmannDensity U) st_fine.partitionFunction
        (Real.exp_ne_zero (-st_fine.c_vac))]
  have h_gibbs_coarse : st_coarse.gibbsMeasure =
      (gaugeHaarMeasure L_m).withDensity (fun V =>
        ENNReal.ofReal (Real.exp (-st_coarse.totalAction V) / Z_coarse)) := by
    unfold InteractingEffectiveActionState.gibbsMeasure Z_coarse
    rw [st_coarse.groupGibbsPartition_totalAction_eq]
    congr 1
    funext V
    rw [st_coarse.exp_neg_totalAction_eq,
      mul_div_mul_left (st_coarse.boltzmannDensity V) st_coarse.partitionFunction
        (Real.exp_ne_zero (-st_coarse.c_vac))]
  have h_map_density :
      (st_fine.gibbsMeasure).map (dyadicLinkBlockMap L_m) =
        (gaugeHaarMeasure L_m).withDensity (fun V =>
          ENNReal.ofReal (Real.exp (-st_coarse.totalAction V) / Z_fine)) := by
    rw [h_gibbs_fine, map_withDensity_of_graph_disintegration
      (gaugeHaarMeasure (2 * L_m)) (gaugeHaarMeasure L_m)
      (dyadicLinkBlockMap L_m) (measurable_dyadicLinkBlockMap L_m)
      (haarBlockKernel L_m) (haarBlockKernel_graph L_m) _ hw_fine_meas]
    congr 1
    funext V
    have h_int_fiber : Integrable
        (fun U : GaugeConfig (2 * L_m) => Real.exp (-st_fine.totalAction U) / Z_fine)
        (haarBlockKernel L_m V) := by
      refine Integrable.div_const ?_ Z_fine
      refine Integrable.mono' (integrable_const (Real.exp B_fine))
        (Real.continuous_exp.measurable.comp hS_fine_meas.neg).aestronglyMeasurable ?_
      refine Filter.Eventually.of_forall fun U => ?_
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_exp.mpr (by linarith [(abs_le.mp (hS_fine_bdd U)).1])
    have h_nonneg_fiber : ∀ᵐ U ∂(haarBlockKernel L_m V),
        0 ≤ Real.exp (-st_fine.totalAction U) / Z_fine :=
      Filter.Eventually.of_forall fun U =>
        div_nonneg (Real.exp_nonneg _) hZ_fine_pos.le
    rw [← ofReal_integral_eq_lintegral_ofReal h_int_fiber h_nonneg_fiber,
      integral_div, C.step_fiber_integral_exp_neg_totalAction_eq hm hR_meas hR_bdd V]
  have hZ_eq : Z_coarse = Z_fine := by
    have h_prob_fine : IsProbabilityMeasure st_fine.gibbsMeasure := by
      rw [st_fine.gibbsMeasure_eq_groupGibbsMeasure]
      exact groupGibbsMeasure_isProbabilityMeasure SU2 st_fine.totalAction
        hS_fine_meas hS_fine_bdd
    have h_univ := congrArg (fun μ : Measure (GaugeConfig L_m) => μ Set.univ) h_map_density
    rw [Measure.map_apply (measurable_dyadicLinkBlockMap L_m) MeasurableSet.univ,
      Set.preimage_univ, measure_univ,
      withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ] at h_univ
    have h_int_coarse : Integrable
        (fun V : GaugeConfig L_m => Real.exp (-st_coarse.totalAction V) / Z_fine)
        (gaugeHaarMeasure L_m) := by
      refine Integrable.div_const ?_ Z_fine
      refine Integrable.mono' (integrable_const (Real.exp B_coarse))
        (Real.continuous_exp.measurable.comp hS_coarse_meas.neg).aestronglyMeasurable ?_
      refine Filter.Eventually.of_forall fun V => ?_
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_exp.mpr (by linarith [(abs_le.mp (hS_coarse_bdd V)).1])
    have h_nonneg_coarse : ∀ᵐ V ∂(gaugeHaarMeasure L_m),
        0 ≤ Real.exp (-st_coarse.totalAction V) / Z_fine :=
      Filter.Eventually.of_forall fun V =>
        div_nonneg (Real.exp_nonneg _) hZ_fine_pos.le
    rw [← ofReal_integral_eq_lintegral_ofReal h_int_coarse h_nonneg_coarse,
      integral_div] at h_univ
    change (1 : ENNReal) = ENNReal.ofReal (Z_coarse / Z_fine) at h_univ
    have h_div_one : Z_coarse / Z_fine = 1 := by
      have h_ofReal : ENNReal.ofReal (Z_coarse / Z_fine) = ENNReal.ofReal 1 := by
        rw [ENNReal.ofReal_one]
        exact h_univ.symm
      exact (ENNReal.ofReal_eq_ofReal_iff (div_nonneg hZ_coarse_pos.le hZ_fine_pos.le) zero_le_one).mp
        h_ofReal
    exact (div_eq_one_iff_eq hZ_fine_pos.ne').mp h_div_one
  refine ⟨hS_coarse_meas, ⟨B_coarse, hS_coarse_bdd⟩, hZ_eq, ?_⟩
  rw [h_map_density, ← hZ_eq, ← h_gibbs_coarse]

/-- Unconditional single-step Gibbs-measure pushforward theorem for `canonicalRGChain`:
for every infrared lattice side `L_ir`, depth `K`, bare coupling `β_uv ≥ 0`, and scale `m < K`,
pushing `((canonicalRGChain L_ir K hβ).state (m + 1)).gibbsMeasure` forward under
`dyadicLinkBlockMap (dyadicScaleSide L_ir m)` yields `((canonicalRGChain L_ir K hβ).state m).gibbsMeasure`
with zero caller-supplied hypotheses. -/
theorem canonicalRGChain_step_gibbsMeasure_map_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) {m : ℕ} (hm : m < K) :
    (((canonicalRGChain L_ir K hβ).state (m + 1)).gibbsMeasure).map
      (dyadicLinkBlockMap (dyadicScaleSide L_ir m)) =
      ((canonicalRGChain L_ir K hβ).state m).gibbsMeasure := by
  have hm1_le : m + 1 ≤ K := hm
  have h_eq : (canonicalRGChain L_ir K hβ).state (m + 1) =
      canonicalRGStateAux L_ir β_uv (K - (m + 1)) (m + 1) := by
    simp [canonicalRGChain, canonicalRGState, hm1_le]
  have h_uncond := canonicalRGStateAux_unconditional_R_trunc_bounds L_ir hβ (K - (m + 1)) (m + 1)
  have hR_meas : Measurable ((canonicalRGChain L_ir K hβ).state (m + 1)).R_trunc := by
    rw [h_eq]
    exact h_uncond.2.1
  have hR_vac : ((canonicalRGChain L_ir K hβ).state (m + 1)).R_trunc
      (vacuumConfig (dyadicScaleSide L_ir (m + 1))) = 0 := by
    rw [h_eq]
    exact canonicalRGStateAux_R_trunc_vacuum_eq_zero L_ir β_uv (K - (m + 1)) (m + 1)
  have hR_osc : ∀ (U : GaugeConfig (dyadicScaleSide L_ir (m + 1)))
      (e : Link (dyadicScaleSide L_ir (m + 1))) (g1 g2 : SU2),
      |((canonicalRGChain L_ir K hβ).state (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g1) -
        ((canonicalRGChain L_ir K hβ).state (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g2)| ≤
        canonicalRGStepOscBound β_uv (K - (m + 1)) := by
    rw [h_eq]
    exact h_uncond.2.2.2.2.2.2.1
  let B_R := (Fintype.card (Link (dyadicScaleSide L_ir (m + 1))) : ℝ) *
    canonicalRGStepOscBound β_uv (K - (m + 1))
  have hR_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
      |((canonicalRGChain L_ir K hβ).state (m + 1)).R_trunc U| ≤ B_R := fun U => by
    have h_sub := abs_sub_le_card_mul_singleLink_osc
      ((canonicalRGChain L_ir K hβ).state (m + 1)).R_trunc hR_osc U
      (vacuumConfig (dyadicScaleSide L_ir (m + 1)))
    rw [hR_vac, sub_zero] at h_sub
    exact h_sub
  exact ((canonicalRGChain L_ir K hβ).step_partitionFunction_and_gibbsMeasure_map_eq
    hm hR_meas hR_bdd).2.2.2

/-- At every RG step `j` and scale `m`, the truncation remainder `R_trunc` of
`localPolymerRGStateAux L_ir β_uv w_poly j m` vanishes at `vacuumConfig (dyadicScaleSide L_ir m)`. -/
theorem localPolymerRGStateAux_R_trunc_vacuum_eq_zero (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ)
    (w_poly : ℕ → ℝ) :
    ∀ (j m : ℕ),
      (localPolymerRGStateAux L_ir β_uv w_poly j m).R_trunc
        (vacuumConfig (dyadicScaleSide L_ir m)) = 0
  | 0, _ => rfl
  | j + 1, m => by
      dsimp [localPolymerRGStateAux]
      rw [sub_self, wilsonAction_vacuum,
        PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction, wilsonAction_vacuum]
      ring

/-- Unconditional single-step Gibbs-measure pushforward theorem for `localPolymerRGChain`:
for every infrared lattice side `L_ir`, depth `K`, bare coupling `β_uv ≥ 0`, non-negative polymer
weight sequence `w_poly`, and scale `m < K`, pushing
`((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).gibbsMeasure` forward under
`dyadicLinkBlockMap (dyadicScaleSide L_ir m)` yields
`((localPolymerRGChain L_ir K hβ w_poly).state m).gibbsMeasure`. -/
theorem localPolymerRGChain_step_gibbsMeasure_map_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j) {m : ℕ} (hm : m < K) :
    (((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).gibbsMeasure).map
      (dyadicLinkBlockMap (dyadicScaleSide L_ir m)) =
      ((localPolymerRGChain L_ir K hβ w_poly).state m).gibbsMeasure := by
  have hm1_le : m + 1 ≤ K := hm
  have h_eq : (localPolymerRGChain L_ir K hβ w_poly).state (m + 1) =
      localPolymerRGStateAux L_ir β_uv w_poly (K - (m + 1)) (m + 1) := by
    simp [localPolymerRGChain, localPolymerRGState, hm1_le]
  have h_uncond := localPolymerRGStateAux_unconditional_bounds L_ir hβ w_poly hw (K - (m + 1)) (m + 1)
  have hR_meas : Measurable ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc := by
    rw [h_eq]
    exact h_uncond.2.2.2.1
  have hR_vac : ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc
      (vacuumConfig (dyadicScaleSide L_ir (m + 1))) = 0 := by
    rw [h_eq]
    exact localPolymerRGStateAux_R_trunc_vacuum_eq_zero L_ir β_uv w_poly (K - (m + 1)) (m + 1)
  let M_osc : ℝ := 12 * (2 * β_uv + w_poly (K - (m + 1)))
  have hR_osc : ∀ (U : GaugeConfig (dyadicScaleSide L_ir (m + 1)))
      (e : Link (dyadicScaleSide L_ir (m + 1))) (g1 g2 : SU2),
      |((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g1) -
        ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g2)| ≤ M_osc := by
    rw [h_eq]
    by_cases hj : 0 < K - (m + 1)
    · exact (h_uncond.2.2.2.2.2.2.2 hj).2.2
    · have hj0 : K - (m + 1) = 0 := Nat.eq_zero_of_not_pos hj
      intro U e g1 g2
      rw [hj0]
      dsimp [localPolymerRGStateAux, InteractingEffectiveActionState.pureWilson, M_osc]
      rw [sub_self, abs_zero]
      have hw0 := hw (K - (m + 1))
      linarith
  let B_R := (Fintype.card (Link (dyadicScaleSide L_ir (m + 1))) : ℝ) * M_osc
  have hR_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
      |((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc U| ≤ B_R := fun U => by
    have h_sub := abs_sub_le_card_mul_singleLink_osc
      ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc hR_osc U
      (vacuumConfig (dyadicScaleSide L_ir (m + 1)))
    rw [hR_vac, sub_zero] at h_sub
    exact h_sub
  exact ((localPolymerRGChain L_ir K hβ w_poly).step_partitionFunction_and_gibbsMeasure_map_eq
    hm hR_meas hR_bdd).2.2.2

/-- Iterated `m`-step dyadic link-blocking map from scale `m` (`dyadicScaleSide L_ir m`)
all the way down to the infrared scale `0` (`L_ir = dyadicScaleSide L_ir 0`). -/
def iteratedDyadicLinkBlockMapToIR (L_ir : ℕ) [NeZero L_ir] :
    ∀ (m : ℕ), GaugeConfig (dyadicScaleSide L_ir m) → GaugeConfig L_ir
  | 0 => id
  | m + 1 =>
      (iteratedDyadicLinkBlockMapToIR L_ir m) ∘
        (dyadicLinkBlockMap (dyadicScaleSide L_ir m))

theorem measurable_iteratedDyadicLinkBlockMapToIR (L_ir : ℕ) [NeZero L_ir] :
    ∀ (m : ℕ), Measurable (iteratedDyadicLinkBlockMapToIR L_ir m)
  | 0 => measurable_id
  | m + 1 =>
      (measurable_iteratedDyadicLinkBlockMapToIR L_ir m).comp
        (measurable_dyadicLinkBlockMap (dyadicScaleSide L_ir m))

/-- Exact `m`-step iterated Gibbs-measure pushforward identity for `canonicalRGChain`:
for every `m ≤ K`, pushing `((canonicalRGChain L_ir K hβ).state m).gibbsMeasure`
forward by `iteratedDyadicLinkBlockMapToIR L_ir m` yields
`((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure`. -/
theorem canonicalRGChain_iterated_gibbsMeasure_map_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    ∀ (m : ℕ), m ≤ K →
      (((canonicalRGChain L_ir K hβ).state m).gibbsMeasure).map
        (iteratedDyadicLinkBlockMapToIR L_ir m) =
        ((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure
  | 0, _ => by
      simp [iteratedDyadicLinkBlockMapToIR]
  | m + 1, hm1 => by
      have hm_lt : m < K := hm1
      have hm_le : m ≤ K := Nat.le_of_lt hm_lt
      have h_step := canonicalRGChain_step_gibbsMeasure_map_eq L_ir K hβ hm_lt
      have h_ih := canonicalRGChain_iterated_gibbsMeasure_map_eq L_ir K hβ m hm_le
      unfold iteratedDyadicLinkBlockMapToIR
      rw [← Measure.map_map
        (measurable_iteratedDyadicLinkBlockMapToIR L_ir m)
        (measurable_dyadicLinkBlockMap (dyadicScaleSide L_ir m)),
        h_step, h_ih]

/-- Unconditional `K`-step UV-to-IR Wilson-measure pushforward theorem for `canonicalRGChain`:
the landed IR Gibbs measure `((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure` at `m = 0` is
identically the pushforward of the exact UV Wilson measure
`wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv` under the `K`-step dyadic
blocking map `iteratedDyadicLinkBlockMapToIR L_ir K`. -/
theorem canonicalRGChain_ir_gibbsMeasure_eq_iterated_map_wilsonMeasure
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    ((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure =
      (wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv).map
        (iteratedDyadicLinkBlockMapToIR L_ir K) := by
  have h_iter := canonicalRGChain_iterated_gibbsMeasure_map_eq L_ir K hβ K le_rfl
  rw [← h_iter, (canonicalRGChain L_ir K hβ).uv_gibbsMeasure_eq_wilsonMeasure]

/-- Unconditional `K`-step UV-to-IR Wilson-measure pushforward theorem for `localPolymerRGChain`:
the landed IR Gibbs measure `((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure` at `m = 0`
is identically the pushforward of the exact UV Wilson measure
`wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv` under
`iteratedDyadicLinkBlockMapToIR L_ir K`. -/
theorem localPolymerRGChain_iterated_gibbsMeasure_map_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j) :
    ∀ (m : ℕ), m ≤ K →
      (((localPolymerRGChain L_ir K hβ w_poly).state m).gibbsMeasure).map
        (iteratedDyadicLinkBlockMapToIR L_ir m) =
        ((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure
  | 0, _ => by
      simp [iteratedDyadicLinkBlockMapToIR]
  | m + 1, hm1 => by
      have hm_lt : m < K := hm1
      have hm_le : m ≤ K := Nat.le_of_lt hm_lt
      have h_step := localPolymerRGChain_step_gibbsMeasure_map_eq L_ir K hβ w_poly hw hm_lt
      have h_ih := localPolymerRGChain_iterated_gibbsMeasure_map_eq L_ir K hβ w_poly hw m hm_le
      unfold iteratedDyadicLinkBlockMapToIR
      rw [← Measure.map_map
        (measurable_iteratedDyadicLinkBlockMapToIR L_ir m)
        (measurable_dyadicLinkBlockMap (dyadicScaleSide L_ir m)),
        h_step, h_ih]

theorem localPolymerRGChain_ir_gibbsMeasure_eq_iterated_map_wilsonMeasure
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j) :
    ((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure =
      (wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv).map
        (iteratedDyadicLinkBlockMapToIR L_ir K) := by
  have h_iter := localPolymerRGChain_iterated_gibbsMeasure_map_eq L_ir K hβ w_poly hw K le_rfl
  rw [← h_iter, (localPolymerRGChain L_ir K hβ w_poly).uv_gibbsMeasure_eq_wilsonMeasure]

/-- Exact Gibbs-measure equivalence between `canonicalRGChain` and `localPolymerRGChain` at the
landed infrared scale `m = 0`: because both chains preserve the exact Haar-blocked effective action
`h_step_exact` with zero lost physics, their landed IR Gibbs measures are identically equal to each
other and to the `K`-step dyadic pushforward of `wilsonMeasure`. -/
theorem canonicalRGChain_and_localPolymerRGChain_ir_gibbsMeasure_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j) :
    ((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure =
      ((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure := by
  rw [canonicalRGChain_ir_gibbsMeasure_eq_iterated_map_wilsonMeasure L_ir K hβ,
    localPolymerRGChain_ir_gibbsMeasure_eq_iterated_map_wilsonMeasure L_ir K hβ w_poly hw]

/-- Exact UV pull-back representation of `landedIrSchwinger` along `canonicalRGChain` and
`localPolymerRGChain`: for any `L_ir`, `K`, `β_uv ≥ 0`, and loop family `F`, the IR expectation of
`irLoopFamilyObservable L_ir a F` under both `((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure`
and `((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure` equals the expectation under the
exact UV Wilson measure `wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv` of the
pulled-back observable `fun U => irLoopFamilyObservable L_ir a F (iteratedDyadicLinkBlockMapToIR L_ir K U)`. -/
theorem canonicalRGChain_irLoopFamilyObservable_integral_eq_uv_wilsonMeasure
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (a : ℝ) (F : DisjointLoopFamily) :
    (∫ V, irLoopFamilyObservable L_ir a F V
        ∂(((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)) =
      ∫ U, irLoopFamilyObservable L_ir a F (iteratedDyadicLinkBlockMapToIR L_ir K U)
        ∂(wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv) := by
  rw [canonicalRGChain_ir_gibbsMeasure_eq_iterated_map_wilsonMeasure L_ir K hβ,
    integral_map (measurable_iteratedDyadicLinkBlockMapToIR L_ir K).aemeasurable
      (continuous_irLoopFamilyObservable L_ir a F).measurable.aestronglyMeasurable]

theorem localPolymerRGChain_irLoopFamilyObservable_integral_eq_uv_wilsonMeasure
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j)
    (a : ℝ) (F : DisjointLoopFamily) :
    (∫ V, irLoopFamilyObservable L_ir a F V
        ∂(((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure)) =
      ∫ U, irLoopFamilyObservable L_ir a F (iteratedDyadicLinkBlockMapToIR L_ir K U)
        ∂(wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv) := by
  rw [← canonicalRGChain_and_localPolymerRGChain_ir_gibbsMeasure_eq L_ir K hβ w_poly hw,
    canonicalRGChain_irLoopFamilyObservable_integral_eq_uv_wilsonMeasure L_ir K hβ a F]

/-- At `K = 0` blocking steps, `canonicalRGChain L_ir 0 hβ` at scale `0` is judgmentally equal to
`InteractingEffectiveActionState.pureWilson L_ir β_uv`, with `polymers = PolymerActivityFamily.empty L_ir`,
`R_trunc = 0`, `η_ir = 0`, `ε_ir = 0`, and `gibbsMeasure = wilsonMeasure (gaugeHaarMeasure L_ir) β_uv`. -/
theorem canonicalRGChain_zero_steps_eq_pureWilson
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    (canonicalRGChain L_ir 0 hβ).state 0 =
      InteractingEffectiveActionState.pureWilson L_ir β_uv ∧
    ((canonicalRGChain L_ir 0 hβ).state 0).β = β_uv ∧
    ((canonicalRGChain L_ir 0 hβ).state 0).polymers = PolymerActivityFamily.empty L_ir ∧
    ((canonicalRGChain L_ir 0 hβ).state 0).R_trunc = (fun _ => 0) ∧
    ((canonicalRGChain L_ir 0 hβ).state 0).gibbsMeasure =
      wilsonMeasure (gaugeHaarMeasure L_ir) β_uv := by
  refine ⟨rfl, rfl, rfl, rfl, ?_⟩
  exact InteractingEffectiveActionState.gibbsMeasure_pureWilson_eq_wilsonMeasure L_ir β_uv

/-- Unconditional Dobrushin norm, uniqueness, and oscillation properties of the `K = 0` fixed-scale
chain `canonicalRGChain L_ir 0 hβ` for any coupling
`β_ir ∈ [canonicalCrossoverBetaLo, canonicalCrossoverBetaHi]`:
- `PolymerDobrushinNormBound st₀.polymers 0` (`η_ir = 0`),
- `TruncationDobrushinNormBound st₀.R_trunc 0` (`ε_ir = 0`),
- Strict Dobrushin contraction `4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) + 0 + 0) < 1` (`= 1 / 4 < 1`),
- Identically zero single-link oscillation for `st₀.polymers.eval` and `st₀.R_trunc`. -/
theorem canonicalRGChain_zero_steps_unconditional_dobrushin
    (L_ir : ℕ) [NeZero L_ir] {β_ir : ℝ} (hβ : 0 ≤ β_ir)
    (_hβ_lo : (canonicalCrossoverBetaLo : ℝ) ≤ β_ir)
    (_hβ_hi : β_ir ≤ (canonicalCrossoverBetaHi : ℝ)) :
    ((canonicalRGChain L_ir 0 hβ).state 0).β = β_ir ∧
    PolymerDobrushinNormBound ((canonicalRGChain L_ir 0 hβ).state 0).polymers 0 ∧
    TruncationDobrushinNormBound ((canonicalRGChain L_ir 0 hβ).state 0).R_trunc 0 ∧
    4 * (18 * (24 * (canonicalCrossoverBetaHi : ℝ)) + 0 + 0) < 1 ∧
    (∀ e : Link L_ir,
      linkOscillation SU2 L_ir ((canonicalRGChain L_ir 0 hβ).state 0).polymers.eval e = 0) ∧
    (∀ e : Link L_ir,
      linkOscillation SU2 L_ir ((canonicalRGChain L_ir 0 hβ).state 0).R_trunc e = 0) := by
  have h_poly_eq :
      ((canonicalRGChain L_ir 0 hβ).state 0).polymers = PolymerActivityFamily.empty L_ir := rfl
  have h_trunc_eq :
      ((canonicalRGChain L_ir 0 hβ).state 0).R_trunc = (fun _ : GaugeConfig L_ir => (0 : ℝ)) := rfl
  have h_poly : PolymerDobrushinNormBound ((canonicalRGChain L_ir 0 hβ).state 0).polymers 0 := by
    rw [h_poly_eq]
    refine ⟨le_rfl, fun _ _ _ _ => ?_, fun _ _ => 0, fun _ _ => le_rfl,
      fun _ _ _ _ _ _ _ => ?_, fun _ => by simp⟩
    · simp [PolymerActivityFamily.eval_empty]
    · simp [twoLinkMixedDifference, PolymerActivityFamily.eval_empty]
  have h_trunc : TruncationDobrushinNormBound ((canonicalRGChain L_ir 0 hβ).state 0).R_trunc 0 := by
    rw [h_trunc_eq]
    refine ⟨⟨0, fun _ => by simp⟩,
      measurable_const, fun _ _ => 0, fun _ _ => le_rfl,
      fun _ _ _ _ _ _ _ => ?_, fun _ => by simp⟩
    simp [twoLinkMixedDifference]
  refine ⟨rfl, h_poly, h_trunc, by norm_num [canonicalCrossoverBetaHi], ?_, ?_⟩
  · intro e
    rw [h_poly_eq]
    refine linkOscillation_eq_zero_of_independent SU2 (PolymerActivityFamily.empty L_ir).eval e ?_
    intro V g1 g2
    change (PolymerActivityFamily.empty L_ir).eval (updateGaugeLink L_ir V e.x e.μ g1) =
      (PolymerActivityFamily.empty L_ir).eval (updateGaugeLink L_ir V e.x e.μ g2)
    rw [PolymerActivityFamily.eval_empty, PolymerActivityFamily.eval_empty]
  · intro e
    rw [h_trunc_eq]
    refine linkOscillation_eq_zero_of_independent SU2 (fun _ : GaugeConfig L_ir => (0 : ℝ)) e ?_
    intro _ _ _
    rfl

/-- Fixed-scale ($K = 0$) strong-coupling counterpart of `LandingTube` / `BalabanMultiScaleUVToIRFlow`
on an arbitrary sequence of infrared lattice sides `irSide : ℕ → ℕ` (`irSide n ≥ 4` even) and
fixed physical block spacing `ℓstar > 0`. -/
structure ToyFixedScaleStrongCouplingFlow where
  irSide : ℕ → ℕ
  [instNeZeroIrSide : ∀ n : ℕ, NeZero (irSide n)]
  h_irSide_ge_four : ∀ n : ℕ, 4 ≤ irSide n
  ℓstar : ℚ
  hℓstar : 0 < ℓstar
  β_seq : ℕ → ℝ
  β_lo : ℝ
  β_hi : ℝ
  hβ_lo_pos : 0 < β_lo
  hβ_range : ∀ n : ℕ, β_lo ≤ β_seq n ∧ β_seq n ≤ β_hi
  h_dobrushin : 4 * (18 * (24 * β_hi) + 0 + 0) < 1
  chain : ∀ n : ℕ, MultiStepHaarRGChain (irSide n) 0 (β_seq n)
  h_poly_zero : ∀ n : ℕ, PolymerDobrushinNormBound ((chain n).state 0).polymers 0
  h_trunc_zero : ∀ n : ℕ, TruncationDobrushinNormBound ((chain n).state 0).R_trunc 0
  h_osc_zero : ∀ (n : ℕ) (e : Link (irSide n)),
    linkOscillation SU2 (irSide n) (((chain n).state 0).polymers.eval) e = 0 ∧
    linkOscillation SU2 (irSide n) (((chain n).state 0).R_trunc) e = 0

attribute [instance] ToyFixedScaleStrongCouplingFlow.instNeZeroIrSide

instance instNeZeroFourMulSucc (n : ℕ) : NeZero (4 * (n + 1)) := ⟨by omega⟩

/-- Unconditional inhabitant of `ToyFixedScaleStrongCouplingFlow` inside the canonical crossover
window `[canonicalCrossoverBetaLo, canonicalCrossoverBetaHi]`, `irSide n = 4 * (n + 1)`. -/
noncomputable def toyFixedScaleStrongCouplingInhabitant : ToyFixedScaleStrongCouplingFlow where
  irSide := fun n => 4 * (n + 1)
  instNeZeroIrSide := instNeZeroFourMulSucc
  h_irSide_ge_four := fun n => by omega
  ℓstar := 1
  hℓstar := by norm_num
  β_seq := fun _ => (canonicalCrossoverBetaLo : ℝ)
  β_lo := (canonicalCrossoverBetaLo : ℝ)
  β_hi := (canonicalCrossoverBetaHi : ℝ)
  hβ_lo_pos := by norm_num [canonicalCrossoverBetaLo]
  hβ_range := fun _ => ⟨le_rfl, by norm_num [canonicalCrossoverBetaLo, canonicalCrossoverBetaHi]⟩
  h_dobrushin := by norm_num [canonicalCrossoverBetaHi]
  chain := fun n =>
    canonicalRGChain (4 * (n + 1)) 0
      (by norm_num [canonicalCrossoverBetaLo] : (0 : ℝ) ≤ (canonicalCrossoverBetaLo : ℝ))
  h_poly_zero := fun n =>
    (canonicalRGChain_zero_steps_unconditional_dobrushin (4 * (n + 1))
      (by norm_num [canonicalCrossoverBetaLo] : (0 : ℝ) ≤ (canonicalCrossoverBetaLo : ℝ))
      le_rfl (by norm_num [canonicalCrossoverBetaLo, canonicalCrossoverBetaHi])).2.1
  h_trunc_zero := fun n =>
    (canonicalRGChain_zero_steps_unconditional_dobrushin (4 * (n + 1))
      (by norm_num [canonicalCrossoverBetaLo] : (0 : ℝ) ≤ (canonicalCrossoverBetaLo : ℝ))
      le_rfl (by norm_num [canonicalCrossoverBetaLo, canonicalCrossoverBetaHi])).2.2.1
  h_osc_zero := fun n e => by
    have h := canonicalRGChain_zero_steps_unconditional_dobrushin (4 * (n + 1))
      (by norm_num [canonicalCrossoverBetaLo] : (0 : ℝ) ≤ (canonicalCrossoverBetaLo : ℝ))
      le_rfl (by norm_num [canonicalCrossoverBetaLo, canonicalCrossoverBetaHi])
    exact ⟨h.2.2.2.2.1 e, h.2.2.2.2.2 e⟩

/-- Unconditional Föllmer–Dobrushin covariance comparison and remainder-oscillation budget for
the `K = 0` fixed-scale chain `canonicalRGChain L_ir 0 hβ` at any coupling
`β_ir ∈ [canonicalCrossoverBetaLo, canonicalCrossoverBetaHi]`. -/
theorem canonicalRGChain_zero_steps_unconditional_cov_and_budget
    (L_ir : ℕ) [NeZero L_ir] {β_ir : ℝ} (hβ : 0 ≤ β_ir)
    (hβ_lo : (canonicalCrossoverBetaLo : ℝ) ≤ β_ir)
    (hβ_hi : β_ir ≤ (canonicalCrossoverBetaHi : ℝ))
    {c_lo : ℝ} (hc_lo : 0 ≤ c_lo)
    {f g : GaugeConfig L_ir → ℝ} {M_f M_g : ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GaugeConfig L_ir, |f V| ≤ M_f)
    (hg_meas : Measurable g) (hg_bdd : ∀ V : GaugeConfig L_ir, |g V| ≤ M_g) :
    let st₀ := (canonicalRGChain L_ir 0 hβ).state 0
    InteractingEffectiveActionState.probeLoopOscillationBudget 1
      { base := 0, μ := 0, ν := 1, plane := by decide,
        sideμ := 1, sideν := 1, sideμ_pos := by norm_num, sideν_pos := by norm_num } * (0 + 0) ≤
        c_lo / 24 ∧
    |groupGibbsCov st₀.gibbsMeasure f g| ≤
      dobrushinObservableComparison SU2 (dobrushinSupMatrix SU2 L_ir st₀.totalAction) f g := by
  dsimp only
  have h_dob := canonicalRGChain_zero_steps_unconditional_dobrushin L_ir hβ hβ_lo hβ_hi
  rcases h_dob with ⟨hβ_eq, h_poly, h_trunc, h_land, _, _⟩
  refine ⟨by linarith, ?_⟩
  exact ((canonicalRGChain L_ir 0 hβ).state 0).gibbsMeasure_abs_cov_le_dobrushinObservableComparison
    (by rw [hβ_eq]; exact hβ)
    (by rw [hβ_eq]; exact hβ_hi)
    (by norm_num [canonicalCrossoverBetaHi])
    le_rfl
    le_rfl
    h_poly
    h_trunc
    h_land
    hf_meas hf_bdd hg_meas hg_bdd

/-- Explicit perimeter-plus-corner renormalization scheme
`perimeterCornerRenormalization P.toCutoffPath (fun _ => 0) (fun n => (1 / 4) * Real.log ((P.spacing n) ^ 2))`
whose per-loop multiplicative factor is identically `(P.spacing n) ^ 2` for every physical rectangle `ℓ`. -/
noncomputable def symanzikDim6PerimeterCornerScheme (P : ContinuumCutoffPath) :
    LoopRenormalization P.toCutoffPath :=
  perimeterCornerRenormalization P.toCutoffPath
    (fun _ => 0)
    (fun n => (1 / 4 : ℝ) * Real.log ((P.spacing n) ^ 2))

theorem symanzikDim6PerimeterCornerScheme_factor_eq (P : ContinuumCutoffPath)
    (n : ℕ) (ℓ : PhysicalRectangle) :
    (symanzikDim6PerimeterCornerScheme P).factor n ℓ = (P.spacing n) ^ 2 := by
  unfold symanzikDim6PerimeterCornerScheme perimeterCornerRenormalization
  dsimp only
  have ha_pos : 0 < (P.spacing n) ^ 2 := sq_pos_of_pos (P.spacing_pos n)
  have h_arg :
      0 * (2 * ((ℓ.sideμ : ℝ) + (ℓ.sideν : ℝ))) +
        4 * ((1 / 4 : ℝ) * Real.log ((P.spacing n) ^ 2)) =
      Real.log ((P.spacing n) ^ 2) := by
    ring
  rw [h_arg, Real.exp_log ha_pos]

theorem abs_list_prod_le_first_of_le_one :
    ∀ (ℓ : PhysicalRectangle) (ls : List PhysicalRectangle) (f : PhysicalRectangle → ℝ),
      (∀ r : PhysicalRectangle, |f r| ≤ 1) →
      |((ℓ :: ls).map f).prod| ≤ |f ℓ|
  | ℓ, [], f, _ => by simp
  | ℓ, r :: ls, f, hf => by
      simp only [List.map_cons, List.prod_cons]
      rw [abs_mul]
      have h_ih := abs_list_prod_le_first_of_le_one r ls f hf
      simp only [List.map_cons, List.prod_cons] at h_ih
      have hr : |f r| ≤ 1 := hf r
      have h_tail : |f r * (ls.map f).prod| ≤ 1 := le_trans h_ih hr
      calc
        |f ℓ| * |f r * (ls.map f).prod|
          ≤ |f ℓ| * 1 := mul_le_mul_of_nonneg_left h_tail (abs_nonneg (f ℓ))
        _ = |f ℓ| := mul_one _

/-- **Unconditional inhabitant** of `SymanzikDimensionSixRotationalSuppression` for **every**
`P : ContinuumCutoffPath` using the corner-rescaled `perimeterCornerRenormalization` scheme
`symanzikDim6PerimeterCornerScheme P = perimeterCornerRenormalization P.toCutoffPath (fun _ => 0) (fun n => (1 / 4) * Real.log ((P.spacing n) ^ 2))`
(demonstrating that `SymanzikDimensionSixRotationalSuppression` alone is unconditionally inhabited,
while killing non-empty loop expectations as $a_n \to 0$ unless paired with a non-zero IR floor). -/
theorem symanzikDimensionSixRotationalSuppression_perimeterCorner_inhabited
    (P : ContinuumCutoffPath) :
    (∃ m c : ℕ → ℝ,
      symanzikDim6PerimeterCornerScheme P = perimeterCornerRenormalization P.toCutoffPath m c) ∧
    SymanzikDimensionSixRotationalSuppression (symanzikDim6PerimeterCornerScheme P) := by
  refine ⟨⟨fun _ => 0, fun n => (1 / 4 : ℝ) * Real.log ((P.spacing n) ^ 2), rfl⟩, ⟨?_⟩⟩
  intro v F
  refine ⟨2, by norm_num, ?_⟩
  have h_ev_le_one : ∀ᶠ n in atTop, P.spacing n ≤ 1 := by
    have h_lt : ∀ᶠ n in atTop, P.spacing n < 1 :=
      (Tendsto.eventually_lt_const (by norm_num : (0 : ℝ) < 1) P.spacing_tendsto_zero)
    exact h_lt.mono fun _ hn => le_of_lt hn
  refine h_ev_le_one.mono fun n hn_le_one => ?_
  cases hF : F.loops with
  | nil =>
      have h_tr : F.translate v = F := by
        cases F with
        | mk loops =>
            dsimp at hF
            subst hF
            rfl
      rw [h_tr, sub_self, abs_zero]
      positivity
  | cons ℓ ls =>
      have ha_nonneg : 0 ≤ P.spacing n := le_of_lt (P.spacing_pos n)
      have ha2_le_one : (P.spacing n) ^ 2 ≤ 1 := by
        nlinarith
      have h_eval_bound (G : DisjointLoopFamily) (hG : G.loops ≠ [])
          (U : GaugeConfig (P.side n)) :
          |G.eval (symanzikDim6PerimeterCornerScheme P) n U| ≤ (P.spacing n) ^ 2 := by
        cases hG_loops : G.loops with
        | nil => exact False.elim (hG hG_loops)
        | cons r rs =>
            unfold DisjointLoopFamily.eval
            rw [hG_loops]
            have hf_le_one (q : PhysicalRectangle) :
                |(symanzikDim6PerimeterCornerScheme P).factor n q *
                  physicalWilsonLoop (P.side n) (P.spacing n) q U| ≤ 1 := by
              rw [abs_mul, symanzikDim6PerimeterCornerScheme_factor_eq,
                abs_of_nonneg (sq_nonneg _)]
              have hW := abs_physicalWilsonLoop_le_one (P.side n) (P.spacing n) q U
              nlinarith
            have h_first := abs_list_prod_le_first_of_le_one r rs
              (fun q => (symanzikDim6PerimeterCornerScheme P).factor n q *
                physicalWilsonLoop (P.side n) (P.spacing n) q U) hf_le_one
            have hr_le :
                |(symanzikDim6PerimeterCornerScheme P).factor n r *
                  physicalWilsonLoop (P.side n) (P.spacing n) r U| ≤ (P.spacing n) ^ 2 := by
              rw [abs_mul, symanzikDim6PerimeterCornerScheme_factor_eq,
                abs_of_nonneg (sq_nonneg _)]
              have hW := abs_physicalWilsonLoop_le_one (P.side n) (P.spacing n) r U
              nlinarith [sq_nonneg (P.spacing n)]
            exact le_trans h_first hr_le
      have h_sch_bound (G : DisjointLoopFamily) (hG : G.loops ≠ []) :
          |renormalizedSchwinger (symanzikDim6PerimeterCornerScheme P) n G| ≤ (P.spacing n) ^ 2 := by
        let μ : Measure (GaugeConfig (P.side n)) :=
          (P.configLaw n : Measure (GaugeConfig (P.side n)))
        change |∫ U, G.eval (symanzikDim6PerimeterCornerScheme P) n U ∂μ| ≤ (P.spacing n) ^ 2
        calc
          |∫ U, G.eval (symanzikDim6PerimeterCornerScheme P) n U ∂μ|
            ≤ ∫ U, |G.eval (symanzikDim6PerimeterCornerScheme P) n U| ∂μ :=
              abs_integral_le_integral_abs
          _ ≤ ∫ _U, (P.spacing n) ^ 2 ∂μ := by
              refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => abs_nonneg _)
                (integrable_const _) (Filter.Eventually.of_forall fun U => h_eval_bound G hG U)
          _ = (P.spacing n) ^ 2 := by
              simp [μ]
      have hF_ne : F.loops ≠ [] := by simp [hF]
      have hF_tr_ne : (F.translate v).loops ≠ [] := by
        unfold DisjointLoopFamily.translate
        simp [hF]
      have h1 := h_sch_bound (F.translate v) hF_tr_ne
      have h2 := h_sch_bound F hF_ne
      have h_tri := abs_sub
        (renormalizedSchwinger (symanzikDim6PerimeterCornerScheme P) n (F.translate v))
        (renormalizedSchwinger (symanzikDim6PerimeterCornerScheme P) n F)
      linarith

/-- On the empty loop family `⟨[]⟩`, both two-cutoff distances in `TwoCutoffComparison` vanish
identically (`= 0`) for every `T : LandingTube P`, every `Z : LoopRenormalization P.toCutoffPath`,
and every cutoff index `n : ℕ` where `((T.chain n).state 0).gibbsMeasure` and
`((T.chain (n + 1)).state 0).gibbsMeasure` are probability measures. -/
theorem twoCutoffComparison_empty_loopFamily_dist_eq_zero
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (Z : LoopRenormalization P.toCutoffPath) (n : ℕ)
    (h_prob_n : IsProbabilityMeasure (((T.chain n).state 0).gibbsMeasure))
    (h_prob_n1 : IsProbabilityMeasure (((T.chain (n + 1)).state 0).gibbsMeasure)) :
    renormalizedSchwinger Z n ⟨[]⟩ = 1 ∧
    landedIrSchwinger T Z n ⟨[]⟩ = 1 ∧
    dist (landedIrSchwinger T Z n ⟨[]⟩) (landedIrSchwinger T Z (n + 1) ⟨[]⟩) = 0 ∧
    dist (renormalizedSchwinger Z n ⟨[]⟩) (landedIrSchwinger T Z n ⟨[]⟩) = 0 := by
  have h_ren : renormalizedSchwinger Z n ⟨[]⟩ = 1 := by
    unfold renormalizedSchwinger DisjointLoopFamily.eval
    simp
  have h_ir_n : landedIrSchwinger T Z n ⟨[]⟩ = 1 := by
    unfold landedIrSchwinger irLoopFamilyObservable
    simp
  have h_ir_n1 : landedIrSchwinger T Z (n + 1) ⟨[]⟩ = 1 := by
    unfold landedIrSchwinger irLoopFamilyObservable
    simp
  refine ⟨h_ren, h_ir_n, ?_, ?_⟩
  · rw [h_ir_n, h_ir_n1, dist_self]
  · rw [h_ren, h_ir_n, dist_self]

/-! ### Exact Translation Invariance for Single-Loop & Dyadic-Base Multi-Loop Families under Arbitrary Shifts `c ∈ ℚ⁴` and Straddling Characterization -/

/-- Translating a physical rectangle by `c : Fin 4 → ℚ` leaves `μ`, `ν`, `sideμ`, `sideν`,
`stepsμ a`, `stepsν a`, and `latticeLoop a` definitionally unchanged at every scale `a : ℝ`. -/
@[simp]
theorem PhysicalRectangle.translate_μ (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    (ℓ.translate c).μ = ℓ.μ := rfl

@[simp]
theorem PhysicalRectangle.translate_ν (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    (ℓ.translate c).ν = ℓ.ν := rfl

@[simp]
theorem PhysicalRectangle.translate_sideμ (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    (ℓ.translate c).sideμ = ℓ.sideμ := rfl

@[simp]
theorem PhysicalRectangle.translate_sideν (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    (ℓ.translate c).sideν = ℓ.sideν := rfl

@[simp]
theorem PhysicalRectangle.translate_stepsμ (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) (a : ℝ) :
    (ℓ.translate c).stepsμ a = ℓ.stepsμ a := rfl

@[simp]
theorem PhysicalRectangle.translate_stepsν (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) (a : ℝ) :
    (ℓ.translate c).stepsν a = ℓ.stepsν a := rfl

@[simp]
theorem PhysicalRectangle.translate_latticeLoop (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) (a : ℝ) :
    (ℓ.translate c).latticeLoop a = ℓ.latticeLoop a := rfl

@[simp]
theorem PhysicalRectangle.translate_translate (b c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    (ℓ.translate b).translate c = ℓ.translate (b + c) := by
  cases ℓ
  simp [PhysicalRectangle.translate, add_assoc]

@[simp]
theorem DisjointLoopFamily.translate_translate (b c : Fin 4 → ℚ) (F : DisjointLoopFamily) :
    (F.translate b).translate c = F.translate (b + c) := by
  simp [DisjointLoopFamily.translate, List.map_map, Function.comp_def]

/-- For any single physical rectangle `ℓ`, any scale `a : ℝ`, and any rational shift `c : Fin 4 → ℚ`
(commensurate or not), if `(ℓ.translate c).latticeBase a = ℓ.latticeBase a + Δk`, then
`physicalWilsonLoop L a (ℓ.translate c) U` equals `physicalWilsonLoop L a ℓ` evaluated on the
lattice-translated configuration `latticeTranslate (latticeSite L Δk) U`. -/
theorem physicalWilsonLoop_translate_of_latticeBase_shift {L : ℕ} {a : ℝ}
    {c : Fin 4 → ℚ} {Δk : Fin 4 → ℤ} {ℓ : PhysicalRectangle}
    (hshift : (ℓ.translate c).latticeBase a = ℓ.latticeBase a + Δk) (U : GaugeConfig L) :
    physicalWilsonLoop L a (ℓ.translate c) U =
      physicalWilsonLoop L a ℓ
        (YangMillsContinuumCompactness.latticeTranslate (latticeSite L Δk) U) := by
  unfold physicalWilsonLoop wilsonLoop
  rw [pathHolonomy_latticeTranslate, hshift, latticeSite_add]
  rfl

/-- Unconditional single-loop lattice-translation identity: for EVERY `L : ℕ`, EVERY `a : ℝ`,
EVERY `c : Fin 4 → ℚ` (including non-dyadic shifts), and EVERY `ℓ : PhysicalRectangle`,
`physicalWilsonLoop L a (ℓ.translate c) U` is an exact torus translation of `U` by
`latticeSite L ((ℓ.translate c).latticeBase a - ℓ.latticeBase a)`. -/
theorem physicalWilsonLoop_translate_eq_latticeTranslate (L : ℕ) (a : ℝ)
    (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) (U : GaugeConfig L) :
    physicalWilsonLoop L a (ℓ.translate c) U =
      physicalWilsonLoop L a ℓ
        (YangMillsContinuumCompactness.latticeTranslate
          (latticeSite L ((ℓ.translate c).latticeBase a - ℓ.latticeBase a)) U) := by
  apply physicalWilsonLoop_translate_of_latticeBase_shift
  abel

/-- Master multi-loop translation equivariance lemma: if every loop `ℓ ∈ F.loops` experiences the
same integer lattice base shift `Δk : Fin 4 → ℤ` under `translate c` at spacing `P.spacing n`,
then `(F.translate c).eval Z n U` is `F.eval Z n` on the lattice-translated configuration. -/
theorem DisjointLoopFamily.eval_translate_eq_of_latticeBase_shift {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    {c : Fin 4 → ℚ} {Δk : Fin 4 → ℤ} (F : DisjointLoopFamily)
    (hshift : ∀ ℓ ∈ F.loops,
      (ℓ.translate c).latticeBase (P.spacing n) = ℓ.latticeBase (P.spacing n) + Δk)
    (U : GaugeConfig (P.side n)) :
    (F.translate c).eval Z n U =
      F.eval Z n
        (YangMillsContinuumCompactness.latticeTranslate (latticeSite (P.side n) Δk) U) := by
  simp only [DisjointLoopFamily.eval, DisjointLoopFamily.translate, List.map_map]
  congr 1
  refine List.map_congr_left fun ℓ hℓ => ?_
  dsimp
  rw [hZ n c ℓ, physicalWilsonLoop_translate_of_latticeBase_shift (hshift ℓ hℓ) U]

/-- Master multi-loop Schwinger translation invariance lemma: whenever all loops in `F` share a
common integer lattice base shift `Δk : Fin 4 → ℤ` under `translate c` at cutoff `n`,
`renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F`. -/
theorem renormalizedSchwinger_translate_eq_of_latticeBase_shift {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    {c : Fin 4 → ℚ} {Δk : Fin 4 → ℤ} (F : DisjointLoopFamily)
    (hshift : ∀ ℓ ∈ F.loops,
      (ℓ.translate c).latticeBase (P.spacing n) = ℓ.latticeBase (P.spacing n) + Δk) :
    renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
  unfold renormalizedSchwinger CutoffPath.configLaw
  have h_eq : ∀ U : GaugeConfig (P.side n),
      (F.translate c).eval Z n U =
        F.eval Z n
          (YangMillsContinuumCompactness.latticeTranslate (latticeSite (P.side n) Δk) U) :=
    DisjointLoopFamily.eval_translate_eq_of_latticeBase_shift hZ n F hshift
  simp only [h_eq]
  have hinv := congrArg ProbabilityMeasure.toMeasure
    (YangMillsContinuumCompactness.wilsonProbability_translation_invariant
      (P.side n) (P.coupling n) (P.coupling_nonneg n) (latticeSite (P.side n) Δk))
  rw [ProbabilityMeasure.toMeasure_map] at hinv
  conv_rhs => rw [← hinv]
  have hcont : Continuous (fun U : GaugeConfig (P.side n) => F.eval Z n U) :=
    DisjointLoopFamily.continuous_eval Z n F
  rw [integral_map
    (YangMillsContinuumCompactness.continuous_latticeTranslate
      (latticeSite (P.side n) Δk)).aemeasurable
    hcont.aestronglyMeasurable]

/-- **Theorem A (`renormalizedSchwinger_singleton_translate_eq`):**
For EVERY translation-invariant `Z : LoopRenormalization P`, EVERY cutoff `n : ℕ`, EVERY physical
rectangle `ℓ : PhysicalRectangle`, and EVERY rational shift `c : Fin 4 → ℚ` whatsoever (including
non-dyadic shifts and non-dyadic rectangles),
`renormalizedSchwinger Z n ((⟨[ℓ]⟩ : DisjointLoopFamily).translate c) = renormalizedSchwinger Z n ⟨[ℓ]⟩`. -/
theorem renormalizedSchwinger_singleton_translate_eq {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    renormalizedSchwinger Z n ((⟨[ℓ]⟩ : DisjointLoopFamily).translate c) =
      renormalizedSchwinger Z n ⟨[ℓ]⟩ := by
  refine renormalizedSchwinger_translate_eq_of_latticeBase_shift hZ n
    (Δk := (ℓ.translate c).latticeBase (P.spacing n) - ℓ.latticeBase (P.spacing n)) ⟨[ℓ]⟩ ?_
  intro ℓ' hℓ'
  rcases List.mem_singleton.mp hℓ' with rfl
  abel

/-- Any loop family `F` with at most one loop (`F.loops.length ≤ 1`) is exactly translation
invariant under EVERY rational shift `c : Fin 4 → ℚ` at EVERY cutoff `n : ℕ`. -/
theorem renormalizedSchwinger_translate_eq_of_length_le_one {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    (c : Fin 4 → ℚ) {F : DisjointLoopFamily} (hF : F.loops.length ≤ 1) :
    renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
  rcases F with ⟨loops⟩
  rcases loops with _ | ⟨ℓ, _ | ⟨ℓ₂, tl⟩⟩
  · rfl
  · exact renormalizedSchwinger_singleton_translate_eq hZ n c ℓ
  · simp at hF

/-- Unconditional dimension-6 translation bound (`C_tr = 0`) for any singleton loop family `⟨[ℓ]⟩`
and EVERY rational shift `c : Fin 4 → ℚ` whatsoever. -/
theorem exists_singleton_translate_dim6 {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} (hZ : Z.IsTranslationInvariant)
    (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    ∃ C_tr : ℝ, 0 ≤ C_tr ∧
      ∀ᶠ n in atTop,
        |renormalizedSchwinger Z n ((⟨[ℓ]⟩ : DisjointLoopFamily).translate c) -
          renormalizedSchwinger Z n ⟨[ℓ]⟩| ≤ C_tr * (P.spacing n) ^ 2 := by
  refine ⟨0, le_rfl, Eventually.of_forall fun n => ?_⟩
  rw [renormalizedSchwinger_singleton_translate_eq hZ n c ℓ, sub_self, abs_zero, zero_mul]

/-- Unconditional vanishing of the translation defect for any singleton loop family `⟨[ℓ]⟩` and
EVERY rational shift `c : Fin 4 → ℚ` whatsoever. -/
theorem tendsto_singleton_translate_defect_zero {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant)
    (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    Tendsto (fun n =>
      renormalizedSchwinger Z n ((⟨[ℓ]⟩ : DisjointLoopFamily).translate c) -
        renormalizedSchwinger Z n ⟨[ℓ]⟩) atTop (𝓝 0) := by
  simp only [renormalizedSchwinger_singleton_translate_eq hZ _ c ℓ, sub_self]
  exact tendsto_const_nhds

/-- Key floor identity for Theorem B: when `ℓ.base` is a lattice vector at scale `a > 0`
(`IsLatticeVector a ℓ.base`), translating `ℓ` by ANY rational vector `c : Fin 4 → ℚ` (commensurate
or not, dyadic or non-dyadic) shifts `ℓ.latticeBase a` by the `ℓ`-independent integer vector
`fun i => ⌊(c i : ℝ) / a⌋`. -/
theorem latticeBase_translate_of_isLatticeVector_base {a : ℝ} (ha : 0 < a)
    (c : Fin 4 → ℚ) {ℓ : PhysicalRectangle} (hℓ : IsLatticeVector a ℓ.base) :
    (ℓ.translate c).latticeBase a = ℓ.latticeBase a + fun i => ⌊(c i : ℝ) / a⌋ := by
  choose k hk using hℓ
  funext i
  simp only [PhysicalRectangle.latticeBase, PhysicalRectangle.translate, Pi.add_apply,
    Rat.cast_add, hk i]
  rw [add_div, mul_div_assoc, div_self ha.ne', mul_one, Int.floor_intCast,
    add_comm (k i : ℝ), Int.floor_add_intCast, add_comm]

/-- Pointwise physical Wilson loop translation identity for ANY shift `c : Fin 4 → ℚ` when
`ℓ.base` is a lattice vector at spacing `a > 0`. -/
theorem physicalWilsonLoop_translate_of_isLatticeVector_base {L : ℕ} {a : ℝ} (ha : 0 < a)
    (c : Fin 4 → ℚ) {ℓ : PhysicalRectangle} (hℓ : IsLatticeVector a ℓ.base) (U : GaugeConfig L) :
    physicalWilsonLoop L a (ℓ.translate c) U =
      physicalWilsonLoop L a ℓ
        (YangMillsContinuumCompactness.latticeTranslate
          (latticeSite L (fun i => ⌊(c i : ℝ) / a⌋)) U) :=
  physicalWilsonLoop_translate_of_latticeBase_shift
    (latticeBase_translate_of_isLatticeVector_base ha c hℓ) U

/-- Pointwise multi-loop evaluation equivariance under ANY rational shift `c : Fin 4 → ℚ`
(including non-dyadic shifts) when every loop in `F` has a lattice base point at spacing
`P.spacing n`. -/
theorem DisjointLoopFamily.eval_translate_eq_of_isLatticeBase {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    (c : Fin 4 → ℚ) {F : DisjointLoopFamily}
    (hF : ∀ ℓ ∈ F.loops, IsLatticeVector (P.spacing n) ℓ.base)
    (U : GaugeConfig (P.side n)) :
    (F.translate c).eval Z n U =
      F.eval Z n
        (YangMillsContinuumCompactness.latticeTranslate
          (latticeSite (P.side n) (fun i => ⌊(c i : ℝ) / P.spacing n⌋)) U) :=
  DisjointLoopFamily.eval_translate_eq_of_latticeBase_shift hZ n F
    (fun ℓ hℓ => latticeBase_translate_of_isLatticeVector_base (P.spacing_pos n) c (hF ℓ hℓ)) U

/-- **Theorem B (`renormalizedSchwinger_translate_eq_of_isLatticeBase`):**
If every loop `ℓ ∈ F.loops` has a lattice base point at cutoff `n`
(`∀ ℓ ∈ F.loops, IsLatticeVector (P.spacing n) ℓ.base`), then for EVERY rational shift
`c : Fin 4 → ℚ` whatsoever (even non-dyadic `c ∉ ℤ[1/2]⁴`),
`renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F`. -/
theorem renormalizedSchwinger_translate_eq_of_isLatticeBase {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    (c : Fin 4 → ℚ) {F : DisjointLoopFamily}
    (hF : ∀ ℓ ∈ F.loops, IsLatticeVector (P.spacing n) ℓ.base) :
    renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F :=
  renormalizedSchwinger_translate_eq_of_latticeBase_shift hZ n F
    (fun ℓ hℓ => latticeBase_translate_of_isLatticeVector_base (P.spacing_pos n) c (hF ℓ hℓ))

/-- A rational number `q : ℚ` is a dyadic rational if `q = k / 2^m` for some integer `k : ℤ`
and exponent `m : ℕ`. -/
def IsDyadicRational (q : ℚ) : Prop :=
  ∃ (k : ℤ) (m : ℕ), q = (k : ℚ) / 2 ^ m

/-- Any rational vector `v : Fin 4 → ℚ` with dyadic rational coordinates is a lattice vector at
dyadic spacing `(1 / 2 : ℝ) ^ n` for all `n ≥ M` above a single coordinate-uniform threshold `M`. -/
theorem exists_nat_isLatticeVector_of_isDyadicRational {v : Fin 4 → ℚ}
    (hv : ∀ i : Fin 4, IsDyadicRational (v i)) :
    ∃ M : ℕ, ∀ n : ℕ, M ≤ n → IsLatticeVector ((1 / 2 : ℝ) ^ n) v := by
  choose k m hkm using hv
  refine ⟨Finset.univ.sup m, fun n hn i => ?_⟩
  have hmi : m i ≤ n := (Finset.le_sup (Finset.mem_univ i)).trans hn
  refine ⟨k i * (2 : ℤ) ^ (n - m i), ?_⟩
  have h2 : (2 : ℝ) ^ n = (2 : ℝ) ^ (n - m i) * (2 : ℝ) ^ (m i) := by
    rw [← pow_add, Nat.sub_add_cancel hmi]
  rw [hkm i]
  simp only [Rat.cast_div, Rat.cast_intCast, Rat.cast_pow, Rat.cast_ofNat,
    Int.cast_mul, Int.cast_pow, Int.cast_ofNat, one_div, inv_pow, h2]
  field_simp

/-- For any finite list of physical rectangles `loops` with dyadic base points
(`∀ ℓ ∈ loops, ∀ i, IsDyadicRational (ℓ.base i)`), there exists a single cutoff threshold `N : ℕ`
such that for all `n ≥ N`, every `ℓ ∈ loops` has `IsLatticeVector ((1 / 2 : ℝ) ^ n) ℓ.base`. -/
theorem exists_nat_forall_isLatticeVector_base_of_isDyadicRational :
    ∀ (loops : List PhysicalRectangle),
      (∀ ℓ ∈ loops, ∀ i : Fin 4, IsDyadicRational (ℓ.base i)) →
      ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ ℓ ∈ loops, IsLatticeVector ((1 / 2 : ℝ) ^ n) ℓ.base
  | [], _ => ⟨0, fun _ _ _ hℓ => False.elim (List.not_mem_nil hℓ)⟩
  | ℓ :: ls, h => by
      obtain ⟨M₁, hM₁⟩ :=
        exists_nat_isLatticeVector_of_isDyadicRational (h ℓ List.mem_cons_self)
      obtain ⟨M₂, hM₂⟩ :=
        exists_nat_forall_isLatticeVector_base_of_isDyadicRational ls
          (fun ℓ' hℓ' => h ℓ' (List.mem_cons_of_mem ℓ hℓ'))
      refine ⟨max M₁ M₂, fun n hn ℓ' hℓ' => ?_⟩
      rcases List.mem_cons.mp hℓ' with rfl | hℓ'
      · exact hM₁ n ((le_max_left M₁ M₂).trans hn)
      · exact hM₂ n ((le_max_right M₁ M₂).trans hn) ℓ' hℓ'

/-- **Theorem B (Dyadic-Base Multi-Loop Families under Arbitrary Shifts `c ∈ ℚ⁴`):**
Along any cutoff path `P` with dyadic spacings `P.spacing n = (1 / 2 : ℝ) ^ n`, for any
translation-invariant renormalization scheme `Z` and any multi-loop family `F : DisjointLoopFamily`
with dyadic base points (`∀ ℓ ∈ F.loops, ∀ i, IsDyadicRational (ℓ.base i)`), there exists `N_F : ℕ`
(depending ONLY on `F` and completely independent of `c`) such that for all `n ≥ N_F` and
**ALL `c : Fin 4 → ℚ` whatsoever** (including non-dyadic shifts!),
`renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F`. -/
theorem exists_nat_renormalizedSchwinger_translate_eq_of_dyadic_base {P : CutoffPath}
    (hP : ∀ n, P.spacing n = (1 / 2 : ℝ) ^ n)
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant)
    (F : DisjointLoopFamily)
    (hF : ∀ ℓ ∈ F.loops, ∀ i : Fin 4, IsDyadicRational (ℓ.base i)) :
    ∃ N_F : ℕ, ∀ n : ℕ, N_F ≤ n → ∀ c : Fin 4 → ℚ,
      renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
  obtain ⟨N_F, hN_F⟩ := exists_nat_forall_isLatticeVector_base_of_isDyadicRational F.loops hF
  refine ⟨N_F, fun n hn c => ?_⟩
  apply renormalizedSchwinger_translate_eq_of_isLatticeBase hZ n c
  intro ℓ hℓ
  rw [hP n]
  exact hN_F n hn ℓ hℓ

/-- Along any `LandingTube P`, if every loop `ℓ ∈ F.loops` has a `T.ℓstar`-dyadic base point
(`∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base`), then eventually for large `n`,
`renormalizedSchwinger T.Z_tube n (F.translate c) = renormalizedSchwinger T.Z_tube n F` holds
simultaneously for **ALL `c : Fin 4 → ℚ` whatsoever** (including non-dyadic shifts!). -/
theorem LandingTube.eventually_forall_translate_eq_of_dyadic_base {P : ContinuumCutoffPath}
    (T : LandingTube P) (F : DisjointLoopFamily)
    (hF : ∀ ℓ ∈ F.loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base) :
    ∀ᶠ n in atTop, ∀ c : Fin 4 → ℚ,
      renormalizedSchwinger T.Z_tube n (F.translate c) = renormalizedSchwinger T.Z_tube n F := by
  classical
  have h_base : ∀ᶠ n in atTop,
      ∀ ℓ ∈ F.loops.toFinset, IsLatticeVector (P.spacing n) ℓ.base := by
    rw [Filter.eventually_all_finset]
    intro ℓ hℓ
    exact T.eventually_isLatticeVector_spacing_of_dyadic (hF ℓ (List.mem_toFinset.mp hℓ))
  filter_upwards [h_base] with n hn c
  exact renormalizedSchwinger_translate_eq_of_isLatticeBase T.z_tube_isTranslationInvariant n c
    (fun ℓ hℓ => hn ℓ (List.mem_toFinset.mpr hℓ))

/-- Unconditional dimension-6 $O(a_n^2)$ translation bound (`C_tr = 0`) along any `LandingTube P`
for **EVERY rational shift `c : Fin 4 → ℚ` whatsoever** (dyadic or non-dyadic) on any loop family
`F` with `T.ℓstar`-dyadic base points. -/
theorem LandingTube.exists_translate_dim6_of_dyadic_base {P : ContinuumCutoffPath}
    (T : LandingTube P) (c : Fin 4 → ℚ) (F : DisjointLoopFamily)
    (hF : ∀ ℓ ∈ F.loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base) :
    ∃ C_tr : ℝ, 0 ≤ C_tr ∧
      ∀ᶠ n in atTop,
        |renormalizedSchwinger T.Z_tube n (F.translate c) - renormalizedSchwinger T.Z_tube n F| ≤
          C_tr * (P.spacing n) ^ 2 := by
  refine ⟨0, le_rfl, ?_⟩
  filter_upwards [T.eventually_forall_translate_eq_of_dyadic_base F hF] with n hn
  rw [hn c, sub_self, abs_zero, zero_mul]

/-- Exact floor decomposition of a sum of two reals `x + y` in terms of `⌊x⌋ + ⌊y⌋` and whether
`Int.fract x` and `Int.fract y` sum to at least `1` (`1 - Int.fract y ≤ Int.fract x`). -/
theorem floor_add_eq_floor_add_floor_add_ite (x y : ℝ) :
    ⌊x + y⌋ = ⌊x⌋ + ⌊y⌋ + if 1 - Int.fract y ≤ Int.fract x then 1 else 0 := by
  rw [Int.floor_eq_iff]
  have hx := Int.floor_add_fract x
  have hy := Int.floor_add_fract y
  have hx0 := Int.fract_nonneg x
  have hx1 := Int.fract_lt_one x
  have hy0 := Int.fract_nonneg y
  have hy1 := Int.fract_lt_one y
  split_ifs with h <;> push_cast <;> constructor <;> linarith

/-- Exact coordinatewise formula for `(ℓ.translate c).latticeBase a i`: it equals
`ℓ.latticeBase a i + ⌊(c i : ℝ) / a⌋` plus the binary carry `1` iff
`1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ.base i : ℝ) / a)`. -/
theorem latticeBase_translate_apply_eq (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle)
    (a : ℝ) (i : Fin 4) :
    (ℓ.translate c).latticeBase a i =
      ℓ.latticeBase a i + ⌊(c i : ℝ) / a⌋ +
        if 1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ.base i : ℝ) / a) then 1 else 0 := by
  simp only [PhysicalRectangle.latticeBase, PhysicalRectangle.translate, Pi.add_apply,
    Rat.cast_add, add_div]
  exact floor_add_eq_floor_add_floor_add_ite ((ℓ.base i : ℝ) / a) ((c i : ℝ) / a)

/-- Under any shift `c : Fin 4 → ℚ`, the common integer part `⌊(c i : ℝ) / a⌋` cancels out of the
relative lattice displacement between any two loops `ℓ₁, ℓ₂`, leaving only the difference of their
binary fractional-part carries. -/
theorem relative_latticeBase_translate_sub (c : Fin 4 → ℚ) (ℓ₁ ℓ₂ : PhysicalRectangle)
    (a : ℝ) (i : Fin 4) :
    ((ℓ₁.translate c).latticeBase a i - (ℓ₂.translate c).latticeBase a i) -
      (ℓ₁.latticeBase a i - ℓ₂.latticeBase a i) =
      (if 1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₁.base i : ℝ) / a) then 1 else 0) -
        (if 1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₂.base i : ℝ) / a) then 1 else 0) := by
  rw [latticeBase_translate_apply_eq c ℓ₁ a i, latticeBase_translate_apply_eq c ℓ₂ a i]
  ring

/-- The relative integer lattice displacement between `ℓ₁` and `ℓ₂` in coordinate `i` is preserved
by `translate c` if and only if their fractional base coordinates lie on the same side of the
threshold `1 - Int.fract ((c i : ℝ) / a)`. -/
theorem relative_latticeBase_translate_eq_iff (c : Fin 4 → ℚ) (ℓ₁ ℓ₂ : PhysicalRectangle)
    (a : ℝ) (i : Fin 4) :
    (ℓ₁.translate c).latticeBase a i - (ℓ₂.translate c).latticeBase a i =
      ℓ₁.latticeBase a i - ℓ₂.latticeBase a i ↔
      (1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₁.base i : ℝ) / a) ↔
        1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₂.base i : ℝ) / a)) := by
  have hsub := relative_latticeBase_translate_sub c ℓ₁ ℓ₂ a i
  by_cases h1 : 1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₁.base i : ℝ) / a) <;>
    by_cases h2 : 1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₂.base i : ℝ) / a) <;>
    simp only [h1, h2, ↓reduceIte, iff_self, iff_true, iff_false,
      not_true_eq_false] at hsub ⊢ <;>
    omega

/-- **Theorem C (`relative_latticeBase_translate_ne_iff_straddle`):**
Translating by `c : Fin 4 → ℚ` changes the relative integer lattice displacement between `ℓ₁` and
`ℓ₂` in coordinate `i` if and only if their fractional base coordinates
`Int.fract ((ℓ₁.base i : ℝ) / a)` and `Int.fract ((ℓ₂.base i : ℝ) / a)` are **distinct** and
**straddle** `1 - Int.fract ((c i : ℝ) / a)`. -/
theorem relative_latticeBase_translate_ne_iff_straddle (c : Fin 4 → ℚ)
    (ℓ₁ ℓ₂ : PhysicalRectangle) (a : ℝ) (i : Fin 4) :
    (ℓ₁.translate c).latticeBase a i - (ℓ₂.translate c).latticeBase a i ≠
      ℓ₁.latticeBase a i - ℓ₂.latticeBase a i ↔
      Int.fract ((ℓ₁.base i : ℝ) / a) ≠ Int.fract ((ℓ₂.base i : ℝ) / a) ∧
        ((Int.fract ((ℓ₁.base i : ℝ) / a) < 1 - Int.fract ((c i : ℝ) / a) ∧
            1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₂.base i : ℝ) / a)) ∨
          (Int.fract ((ℓ₂.base i : ℝ) / a) < 1 - Int.fract ((c i : ℝ) / a) ∧
            1 - Int.fract ((c i : ℝ) / a) ≤ Int.fract ((ℓ₁.base i : ℝ) / a))) := by
  rw [ne_eq, relative_latticeBase_translate_eq_iff]
  set α₁ := Int.fract ((ℓ₁.base i : ℝ) / a)
  set α₂ := Int.fract ((ℓ₂.base i : ℝ) / a)
  set θ := 1 - Int.fract ((c i : ℝ) / a)
  constructor
  · intro hnot
    by_cases h1 : θ ≤ α₁
    · have h2 : ¬ (θ ≤ α₂) := fun h2 => hnot ⟨fun _ => h2, fun _ => h1⟩
      have h2' : α₂ < θ := lt_of_not_ge h2
      refine ⟨by linarith, Or.inr ⟨h2', h1⟩⟩
    · have h2 : θ ≤ α₂ := by
        by_contra h2
        exact hnot ⟨fun h => False.elim (h1 h), fun h => False.elim (h2 h)⟩
      have h1' : α₁ < θ := lt_of_not_ge h1
      refine ⟨by linarith, Or.inl ⟨h1', h2⟩⟩
  · rintro ⟨_, ⟨h1, h2⟩ | ⟨h2, h1⟩⟩ hiff
    · linarith [hiff.mpr h2]
    · linarith [hiff.mp h1]

/-- Corollary of Theorem C: if all loops in `F` have equal fractional base coordinates at spacing
`P.spacing n` (even if those fractional coordinates are non-zero / non-dyadic!), then for EVERY
rational shift `c : Fin 4 → ℚ` whatsoever,
`renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F`. -/
theorem renormalizedSchwinger_translate_eq_of_fract_base_eq {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    (c : Fin 4 → ℚ) {F : DisjointLoopFamily}
    (hfract : ∀ ℓ₁ ∈ F.loops, ∀ ℓ₂ ∈ F.loops, ∀ i : Fin 4,
      Int.fract ((ℓ₁.base i : ℝ) / P.spacing n) = Int.fract ((ℓ₂.base i : ℝ) / P.spacing n)) :
    renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
  rcases F with ⟨loops⟩
  rcases loops with _ | ⟨ℓ₀, tl⟩
  · rfl
  · refine renormalizedSchwinger_translate_eq_of_latticeBase_shift hZ n
      (Δk := (ℓ₀.translate c).latticeBase (P.spacing n) - ℓ₀.latticeBase (P.spacing n))
      ⟨ℓ₀ :: tl⟩ ?_
    intro ℓ hℓ
    funext i
    simp only [Pi.add_apply, Pi.sub_apply]
    have h_eq :
        (ℓ.translate c).latticeBase (P.spacing n) i -
          (ℓ₀.translate c).latticeBase (P.spacing n) i =
        ℓ.latticeBase (P.spacing n) i - ℓ₀.latticeBase (P.spacing n) i := by
      rw [relative_latticeBase_translate_eq_iff,
        hfract ℓ hℓ ℓ₀ List.mem_cons_self i]
    omega

/-- Corollary of Theorem C in terms of pairwise lattice-vector differences: if all pairwise base
differences `ℓ₁.base - ℓ₂.base` in `F` are lattice vectors at spacing `P.spacing n`, then for
EVERY rational shift `c : Fin 4 → ℚ` whatsoever,
`renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F`. -/
theorem renormalizedSchwinger_translate_eq_of_pairwise_isLatticeVector_sub {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsTranslationInvariant) (n : ℕ)
    (c : Fin 4 → ℚ) {F : DisjointLoopFamily}
    (hdiff : ∀ ℓ₁ ∈ F.loops, ∀ ℓ₂ ∈ F.loops,
      IsLatticeVector (P.spacing n) (ℓ₁.base - ℓ₂.base)) :
    renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
  apply renormalizedSchwinger_translate_eq_of_fract_base_eq hZ n c
  intro ℓ₁ hℓ₁ ℓ₂ hℓ₂ i
  obtain ⟨k, hk⟩ := hdiff ℓ₁ hℓ₁ ℓ₂ hℓ₂ i
  have ha : P.spacing n ≠ 0 := (P.spacing_pos n).ne'
  have h_eq : (ℓ₁.base i : ℝ) / P.spacing n = (ℓ₂.base i : ℝ) / P.spacing n + (k : ℝ) := by
    simp only [Pi.sub_apply, Rat.cast_sub] at hk
    have hdiv : ((ℓ₁.base i : ℝ) - (ℓ₂.base i : ℝ)) / P.spacing n = (k : ℝ) := by
      rw [hk, mul_div_assoc, div_self ha, mul_one]
    linarith [sub_div (ℓ₁.base i : ℝ) (ℓ₂.base i : ℝ) (P.spacing n)]
  rw [h_eq, Int.fract_add_intCast]

/-! ### Z-Dressing, Counterterm Cancellation Law, and UV Perimeter-Decay Bounds for `TwoCutoffComparison` -/

/-- Alias for the trivial (`Z = 1`) loop renormalization scheme `LoopRenormalization.unrenormalized P`. -/
abbrev trivialLoopRenormalization (P : CutoffPath) : LoopRenormalization P :=
  LoopRenormalization.unrenormalized P

/-- Unrenormalized UV multi-loop Wilson expectation at cutoff `n` under `P.configLaw n`,
defined as `renormalizedSchwinger (trivialLoopRenormalization P) n F`. -/
def rawSchwinger (P : CutoffPath) (n : ℕ) (F : DisjointLoopFamily) : ℝ :=
  renormalizedSchwinger (trivialLoopRenormalization P) n F

/-- Multiplicative renormalization factor `(F.loops.map (fun ℓ => Z.factor n ℓ)).prod`
assigned by `Z : LoopRenormalization P` to a multi-loop family `F : DisjointLoopFamily` at cutoff `n`. -/
def _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.LoopRenormalization.familyFactor
    {P : CutoffPath} (Z : LoopRenormalization P) (n : ℕ) (F : DisjointLoopFamily) : ℝ :=
  (F.loops.map (fun ℓ => Z.factor n ℓ)).prod

@[simp]
theorem LoopRenormalization.familyFactor_nil {P : CutoffPath} (Z : LoopRenormalization P) (n : ℕ) :
    Z.familyFactor n ⟨[]⟩ = 1 := rfl

@[simp]
theorem LoopRenormalization.familyFactor_singleton {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (ℓ : PhysicalRectangle) :
    Z.familyFactor n ⟨[ℓ]⟩ = Z.factor n ℓ := by
  simp [LoopRenormalization.familyFactor]

theorem list_prod_pos_of_forall_pos {α : Type*} (f : α → ℝ) :
    ∀ (ls : List α), (∀ x ∈ ls, 0 < f x) → 0 < (ls.map f).prod
  | [], _ => by simp
  | x :: xs, h => by
      simp only [List.map_cons, List.prod_cons]
      exact mul_pos (h x List.mem_cons_self)
        (list_prod_pos_of_forall_pos f xs (fun y hy => h y (List.mem_cons_of_mem x hy)))

theorem _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.LoopRenormalization.familyFactor_pos
    {P : CutoffPath} (Z : LoopRenormalization P) (n : ℕ) (F : DisjointLoopFamily) :
    0 < Z.familyFactor n F :=
  list_prod_pos_of_forall_pos (fun ℓ => Z.factor n ℓ) F.loops (fun ℓ _ => Z.factor_pos n ℓ)

theorem _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.LoopRenormalization.familyFactor_ne_zero
    {P : CutoffPath} (Z : LoopRenormalization P) (n : ℕ) (F : DisjointLoopFamily) :
    Z.familyFactor n F ≠ 0 :=
  (Z.familyFactor_pos n F).ne'

@[simp]
theorem _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.LoopRenormalization.abs_familyFactor
    {P : CutoffPath} (Z : LoopRenormalization P) (n : ℕ) (F : DisjointLoopFamily) :
    |Z.familyFactor n F| = Z.familyFactor n F :=
  abs_of_pos (Z.familyFactor_pos n F)

/-- Pointwise evaluation under `trivialLoopRenormalization P` equals the undressed multi-loop
product `irLoopFamilyObservable (P.side n) (P.spacing n) F U`. -/
theorem DisjointLoopFamily.eval_trivialLoopRenormalization_eq {P : CutoffPath}
    (n : ℕ) (F : DisjointLoopFamily) (U : GaugeConfig (P.side n)) :
    F.eval (trivialLoopRenormalization P) n U =
      irLoopFamilyObservable (P.side n) (P.spacing n) F U := by
  simp [DisjointLoopFamily.eval, trivialLoopRenormalization, LoopRenormalization.unrenormalized,
    irLoopFamilyObservable]

/-- Pointwise factorization of `DisjointLoopFamily.eval Z n F U` into the deterministic counterterm
factor `Z.familyFactor n F` times the unrenormalized multi-loop product
`F.eval (trivialLoopRenormalization P) n U`. -/
theorem DisjointLoopFamily.eval_eq_familyFactor_mul_trivial {P : CutoffPath}
    (Z : LoopRenormalization P) (n : ℕ) (F : DisjointLoopFamily) (U : GaugeConfig (P.side n)) :
    F.eval Z n U =
      Z.familyFactor n F * F.eval (trivialLoopRenormalization P) n U := by
  unfold DisjointLoopFamily.eval LoopRenormalization.familyFactor
  rw [list_prod_map_mul_eq_prod_mul_prod]
  simp [trivialLoopRenormalization, LoopRenormalization.unrenormalized]

/-- Exact multiplicative factorization of the renormalized UV Schwinger function:
for every `Z : LoopRenormalization P`, cutoff `n : ℕ`, and `F : DisjointLoopFamily`,
`renormalizedSchwinger Z n F = Z.familyFactor n F * renormalizedSchwinger (trivialLoopRenormalization P) n F`. -/
theorem renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger {P : CutoffPath}
    (Z : LoopRenormalization P) (n : ℕ) (F : DisjointLoopFamily) :
    renormalizedSchwinger Z n F =
      Z.familyFactor n F * renormalizedSchwinger (trivialLoopRenormalization P) n F := by
  unfold renormalizedSchwinger
  simp_rw [DisjointLoopFamily.eval_eq_familyFactor_mul_trivial Z n F]
  exact integral_const_mul (Z.familyFactor n F) _

/-- Single-loop specialization of `renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger`:
`renormalizedSchwinger Z n ⟨[ℓ]⟩ = Z.factor n ℓ * renormalizedSchwinger (trivialLoopRenormalization P) n ⟨[ℓ]⟩`. -/
theorem renormalizedSchwinger_eq_factor_mul_rawSchwinger {P : CutoffPath}
    (Z : LoopRenormalization P) (n : ℕ) (ℓ : PhysicalRectangle) :
    renormalizedSchwinger Z n ⟨[ℓ]⟩ =
      Z.factor n ℓ * renormalizedSchwinger (trivialLoopRenormalization P) n ⟨[ℓ]⟩ := by
  simpa using renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger Z n ⟨[ℓ]⟩

/-- Every unrenormalized UV multi-loop Wilson expectation `rawSchwinger P n F` is bounded by `1`
in absolute value at every cutoff `n`. -/
theorem abs_rawSchwinger_le_one (P : CutoffPath) (n : ℕ) (F : DisjointLoopFamily) :
    |rawSchwinger P n F| ≤ 1 := by
  unfold rawSchwinger renormalizedSchwinger
  have h_bdd : ∀ U : GaugeConfig (P.side n), |F.eval (trivialLoopRenormalization P) n U| ≤ 1 := by
    intro U
    rw [DisjointLoopFamily.eval_trivialLoopRenormalization_eq]
    exact abs_irLoopFamilyObservable_le_one (P.side n) (P.spacing n) F U
  have h_int : Integrable (fun U : GaugeConfig (P.side n) => |F.eval (trivialLoopRenormalization P) n U|)
      (P.configLaw n : Measure (GaugeConfig (P.side n))) :=
    (DisjointLoopFamily.integrable_eval (trivialLoopRenormalization P) n F).abs
  calc
    |∫ U, F.eval (trivialLoopRenormalization P) n U ∂(P.configLaw n : Measure (GaugeConfig (P.side n)))|
      ≤ ∫ U, |F.eval (trivialLoopRenormalization P) n U| ∂(P.configLaw n : Measure (GaugeConfig (P.side n))) :=
        abs_integral_le_integral_abs
    _ ≤ ∫ _U, (1 : ℝ) ∂(P.configLaw n : Measure (GaugeConfig (P.side n))) :=
        integral_mono h_int (integrable_const 1) h_bdd
    _ = 1 := by simp

/-- Unconditional expectation bound for `st.gibbsMeasure`: for any `st : InteractingEffectiveActionState L`,
any `M ≥ 0`, and any observable `f : GaugeConfig L → ℝ` satisfying `∀ V, |f V| ≤ M`,
`|∫ V, f V ∂st.gibbsMeasure| ≤ M` holds unconditionally (without requiring measurability or
boundedness hypotheses on `st.R_trunc` or `f`). -/
theorem InteractingEffectiveActionState.abs_integral_gibbsMeasure_le_of_abs_le
    {L : ℕ} [NeZero L] (st : InteractingEffectiveActionState L)
    {f : GaugeConfig L → ℝ} {M : ℝ} (hM : 0 ≤ M) (hf : ∀ V : GaugeConfig L, |f V| ≤ M) :
    |∫ V, f V ∂st.gibbsMeasure| ≤ M := by
  let ρ : GaugeConfig L → ℝ := fun V => st.boltzmannDensity V / st.partitionFunction
  by_cases hZ_pos : 0 < st.partitionFunction
  · by_cases h_int_w : Integrable st.boltzmannDensity (gaugeHaarMeasure L)
    · have hρ_nonneg (V : GaugeConfig L) : 0 ≤ ρ V :=
        div_nonneg (Real.exp_pos _).le hZ_pos.le
      have h_int_ρ : Integrable ρ (gaugeHaarMeasure L) :=
        h_int_w.div_const st.partitionFunction
      have h_aemeas : AEMeasurable (fun V => ENNReal.ofReal (ρ V)) (gaugeHaarMeasure L) :=
        ENNReal.measurable_ofReal.comp_aemeasurable h_int_ρ.aemeasurable
      have h_rew :
          (∫ V, f V ∂st.gibbsMeasure) = ∫ V, ρ V * f V ∂(gaugeHaarMeasure L) := by
        unfold InteractingEffectiveActionState.gibbsMeasure
        rw [integral_withDensity_eq_integral_toReal_smul₀ h_aemeas
          (Filter.Eventually.of_forall fun _ => ENNReal.ofReal_lt_top) f]
        simp only [ENNReal.toReal_ofReal (hρ_nonneg _), smul_eq_mul]
      rw [h_rew]
      by_cases h_int_ρf : Integrable (fun V => |ρ V * f V|) (gaugeHaarMeasure L)
      · have h_int_ρ_eq_one : (∫ V, ρ V ∂(gaugeHaarMeasure L)) = 1 := by
          dsimp [ρ]
          rw [integral_div]
          exact div_self hZ_pos.ne'
        have h_pt (V : GaugeConfig L) : |ρ V * f V| ≤ M * ρ V := by
          rw [abs_mul, abs_of_nonneg (hρ_nonneg V), mul_comm]
          exact mul_le_mul_of_nonneg_right (hf V) (hρ_nonneg V)
        calc
          |∫ V, ρ V * f V ∂(gaugeHaarMeasure L)|
            ≤ ∫ V, |ρ V * f V| ∂(gaugeHaarMeasure L) := abs_integral_le_integral_abs
          _ ≤ ∫ V, M * ρ V ∂(gaugeHaarMeasure L) :=
              integral_mono h_int_ρf (h_int_ρ.const_mul M) h_pt
          _ = M * (∫ V, ρ V ∂(gaugeHaarMeasure L)) := integral_const_mul M ρ
          _ = M := by rw [h_int_ρ_eq_one, mul_one]
      · calc
          |∫ V, ρ V * f V ∂(gaugeHaarMeasure L)|
            ≤ ∫ V, |ρ V * f V| ∂(gaugeHaarMeasure L) := abs_integral_le_integral_abs
          _ = 0 := integral_undef h_int_ρf
          _ ≤ M := hM
    · have hZ_zero : st.partitionFunction = 0 :=
        integral_undef h_int_w
      linarith
  · have hZ_nonpos : st.partitionFunction ≤ 0 := not_lt.mp hZ_pos
    have h_dens_zero : (fun V : GaugeConfig L => ENNReal.ofReal (ρ V)) = 0 := by
      funext V
      simp only [Pi.zero_apply, ENNReal.ofReal_eq_zero]
      exact div_nonpos_of_nonneg_of_nonpos (Real.exp_pos _).le hZ_nonpos
    have h_meas_zero : st.gibbsMeasure = 0 := by
      unfold InteractingEffectiveActionState.gibbsMeasure
      rw [h_dens_zero, withDensity_zero]
    rw [h_meas_zero, integral_zero_measure, abs_zero]
    exact hM

/-- Unconditional bound `|landedIrSchwinger T Z n F| ≤ 1` for every `P : ContinuumCutoffPath`,
`T : LandingTube P`, `Z : LoopRenormalization P.toCutoffPath`, `n : ℕ`, and `F : DisjointLoopFamily`. -/
theorem abs_landedIrSchwinger_le_one {P : ContinuumCutoffPath}
    (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) (F : DisjointLoopFamily) :
    |landedIrSchwinger T Z n F| ≤ 1 := by
  unfold landedIrSchwinger
  exact ((T.chain n).state 0).abs_integral_gibbsMeasure_le_of_abs_le zero_le_one
    (abs_irLoopFamilyObservable_le_one (T.irSide n) (T.ℓstar : ℝ) F)

/-- General counterterm cancellation and UV expectation bound from any dressing bound
`dist (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F) ≤ ε`:
1. `|Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F| ≤ ε`,
2. `|rawSchwinger P.toCutoffPath n F - (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤ ε / |Z.familyFactor n F|`,
3. `|Z.familyFactor n F * rawSchwinger P.toCutoffPath n F| ≤ 1 + ε`, and
4. `|rawSchwinger P.toCutoffPath n F| ≤ (1 + ε) / |Z.familyFactor n F|`. -/
theorem rawSchwinger_counterterm_cancellation_of_dist_le
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) (F : DisjointLoopFamily) {ε : ℝ}
    (h_dist : dist (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F) ≤ ε) :
    |Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F| ≤ ε ∧
    |rawSchwinger P.toCutoffPath n F -
        (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤
      ε / |Z.familyFactor n F| ∧
    |Z.familyFactor n F * rawSchwinger P.toCutoffPath n F| ≤ 1 + ε ∧
    |rawSchwinger P.toCutoffPath n F| ≤ (1 + ε) / |Z.familyFactor n F| := by
  have h_fac_pos : 0 < Z.familyFactor n F := Z.familyFactor_pos n F
  have h_fac_ne : Z.familyFactor n F ≠ 0 := Z.familyFactor_ne_zero n F
  have h_abs_fac : |Z.familyFactor n F| = Z.familyFactor n F := Z.abs_familyFactor n F
  have h1 : |Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F| ≤ ε := by
    have hd := h_dist
    rw [Real.dist_eq, renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger] at hd
    exact hd
  have h2 :
      |rawSchwinger P.toCutoffPath n F -
          (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤
        ε / |Z.familyFactor n F| := by
    have h_alg :
        rawSchwinger P.toCutoffPath n F - (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F =
          (Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F) /
            Z.familyFactor n F := by
      field_simp [h_fac_ne]
    rw [h_alg, abs_div]
    exact div_le_div_of_nonneg_right h1 (abs_nonneg _)
  have h_ir_le : |landedIrSchwinger T Z n F| ≤ 1 := abs_landedIrSchwinger_le_one T Z n F
  have h3 : |Z.familyFactor n F * rawSchwinger P.toCutoffPath n F| ≤ 1 + ε := by
    have h_split :
        Z.familyFactor n F * rawSchwinger P.toCutoffPath n F =
          landedIrSchwinger T Z n F +
            (Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F) := by
      ring
    rw [h_split]
    exact (abs_add_le _ _).trans (add_le_add h_ir_le h1)
  have h4 : |rawSchwinger P.toCutoffPath n F| ≤ (1 + ε) / |Z.familyFactor n F| := by
    rw [abs_mul] at h3
    rw [le_div_iff₀ (by rw [h_abs_fac]; exact h_fac_pos)]
    linarith
  exact ⟨h1, h2, h3, h4⟩

/-- Spacing-squared counterterm cancellation law: if
`dist (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F) ≤ C_2 F * (P.spacing n / a_ir) ^ 2`,
then the unrenormalized UV Wilson expectation `rawSchwinger P.toCutoffPath n F` satisfies:
1. `|Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F| ≤ C_2 F * (P.spacing n / a_ir) ^ 2`,
2. `|rawSchwinger P.toCutoffPath n F - (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤ (C_2 F / |Z.familyFactor n F|) * (P.spacing n / a_ir) ^ 2`, and
3. `|rawSchwinger P.toCutoffPath n F| ≤ (1 + C_2 F * (P.spacing n / a_ir) ^ 2) / |Z.familyFactor n F|`. -/
theorem rawSchwinger_counterterm_cancellation_of_spacing_sq_bound
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (C_2 : DisjointLoopFamily → ℝ) (a_ir : ℝ) (n : ℕ) (F : DisjointLoopFamily)
    (h_dist :
      dist (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F) ≤
        C_2 F * (P.spacing n / a_ir) ^ 2) :
    |Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F| ≤
      C_2 F * (P.spacing n / a_ir) ^ 2 ∧
    |rawSchwinger P.toCutoffPath n F -
        (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤
      (C_2 F / |Z.familyFactor n F|) * (P.spacing n / a_ir) ^ 2 ∧
    |rawSchwinger P.toCutoffPath n F| ≤
      (1 + C_2 F * (P.spacing n / a_ir) ^ 2) / |Z.familyFactor n F| := by
  obtain ⟨h1, h2, _, h4⟩ :=
    rawSchwinger_counterterm_cancellation_of_dist_le T Z n F h_dist
  refine ⟨h1, ?_, h4⟩
  simpa [div_mul_eq_mul_div] using h2

/-- What `TwoCutoffComparison T Z` mathematically forces on the unrenormalized UV Wilson expectation
`rawSchwinger P.toCutoffPath n F`:
there exists `C_tube ≥ 0` such that for every `F : DisjointLoopFamily` and every cutoff `n : ℕ`:
1. `|Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F| ≤ C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n`,
2. Exact counterterm cancellation law:
   `|rawSchwinger P.toCutoffPath n F - (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤ (C_tube ^ (F.loops.length + 1) / |Z.familyFactor n F|) * (landingTubeContraction T) ^ n`,
3. `|Z.familyFactor n F * rawSchwinger P.toCutoffPath n F| ≤ 1 + C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n`,
4. `|rawSchwinger P.toCutoffPath n F| ≤ (1 + C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n) / |Z.familyFactor n F|`, and
5. Uniform-in-`n` numerator bound:
   `|rawSchwinger P.toCutoffPath n F| ≤ (1 + C_tube ^ (F.loops.length + 1)) / Z.familyFactor n F`. -/
theorem TwoCutoffComparison.exists_counterterm_cancellation_and_rawSchwinger_bound
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) :
    ∃ C_tube : ℝ, 0 ≤ C_tube ∧
      ∀ (F : DisjointLoopFamily) (n : ℕ),
        |Z.familyFactor n F * rawSchwinger P.toCutoffPath n F - landedIrSchwinger T Z n F| ≤
          C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n ∧
        |rawSchwinger P.toCutoffPath n F -
            (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤
          (C_tube ^ (F.loops.length + 1) / |Z.familyFactor n F|) * (landingTubeContraction T) ^ n ∧
        |Z.familyFactor n F * rawSchwinger P.toCutoffPath n F| ≤
          1 + C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n ∧
        |rawSchwinger P.toCutoffPath n F| ≤
          (1 + C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n) /
            |Z.familyFactor n F| ∧
        |rawSchwinger P.toCutoffPath n F| ≤
          (1 + C_tube ^ (F.loops.length + 1)) / Z.familyFactor n F := by
  obtain ⟨C_tube, hC_tube, h_all⟩ := hC.h_landed_and_dressing
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  refine ⟨C_tube, hC_tube, fun F n => ?_⟩
  obtain ⟨h1, h2, h3, h4⟩ :=
    rawSchwinger_counterterm_cancellation_of_dist_le T Z n F ((h_all F).2 n)
  have h2' :
      |rawSchwinger P.toCutoffPath n F -
          (Z.familyFactor n F)⁻¹ * landedIrSchwinger T Z n F| ≤
        (C_tube ^ (F.loops.length + 1) / |Z.familyFactor n F|) * (landingTubeContraction T) ^ n := by
    simpa [div_mul_eq_mul_div] using h2
  have hqn_le_one : (landingTubeContraction T) ^ n ≤ 1 :=
    pow_le_one₀ hq0.le hq1.le
  have hC_pow_nonneg : 0 ≤ C_tube ^ (F.loops.length + 1) := pow_nonneg hC_tube _
  have h_num_le :
      1 + C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n ≤
        1 + C_tube ^ (F.loops.length + 1) := by
    nlinarith [mul_le_of_le_one_right hC_pow_nonneg hqn_le_one]
  have h5 :
      |rawSchwinger P.toCutoffPath n F| ≤
        (1 + C_tube ^ (F.loops.length + 1)) / Z.familyFactor n F := by
    have h4' :
        |rawSchwinger P.toCutoffPath n F| ≤
          (1 + C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n) /
            Z.familyFactor n F := by
      simpa [Z.abs_familyFactor n F] using h4
    exact h4'.trans (div_le_div_of_nonneg_right h_num_le (Z.familyFactor_pos n F).le)
  exact ⟨h1, h2', h3, h4, h5⟩

/-- Single-loop (`F = ⟨[ℓ]⟩`) specialization of `TwoCutoffComparison.exists_counterterm_cancellation_and_rawSchwinger_bound`
in terms of `Z.factor n ℓ`. -/
theorem TwoCutoffComparison.exists_singleton_counterterm_cancellation_and_rawSchwinger_bound
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) :
    ∃ C_tube : ℝ, 0 ≤ C_tube ∧
      ∀ (ℓ : PhysicalRectangle) (n : ℕ),
        |Z.factor n ℓ * rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩ - landedIrSchwinger T Z n ⟨[ℓ]⟩| ≤
          C_tube ^ 2 * (landingTubeContraction T) ^ n ∧
        |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩ -
            (Z.factor n ℓ)⁻¹ * landedIrSchwinger T Z n ⟨[ℓ]⟩| ≤
          (C_tube ^ 2 / |Z.factor n ℓ|) * (landingTubeContraction T) ^ n ∧
        |Z.factor n ℓ * rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩| ≤
          1 + C_tube ^ 2 * (landingTubeContraction T) ^ n ∧
        |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩| ≤
          (1 + C_tube ^ 2 * (landingTubeContraction T) ^ n) / |Z.factor n ℓ| ∧
        |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩| ≤
          (1 + C_tube ^ 2) / Z.factor n ℓ := by
  obtain ⟨C_tube, hC_tube, h_all⟩ := hC.exists_counterterm_cancellation_and_rawSchwinger_bound
  refine ⟨C_tube, hC_tube, fun ℓ n => ?_⟩
  simpa using h_all ⟨[ℓ]⟩ n

/-- Whenever `Z.familyFactor n F → +∞` as `n → ∞`, `TwoCutoffComparison T Z` unconditionally forces
the unrenormalized UV Wilson expectation `rawSchwinger P.toCutoffPath n F` to decay to `0`. -/
theorem TwoCutoffComparison.tendsto_rawSchwinger_zero_of_tendsto_familyFactor_atTop
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) (F : DisjointLoopFamily)
    (hZ_div : Tendsto (fun n => Z.familyFactor n F) atTop atTop) :
    Tendsto (fun n => rawSchwinger P.toCutoffPath n F) atTop (𝓝 0) := by
  obtain ⟨C_tube, _, h_all⟩ := hC.exists_counterterm_cancellation_and_rawSchwinger_bound
  set M_F : ℝ := 1 + C_tube ^ (F.loops.length + 1)
  have h_rhs_zero : Tendsto (fun n => M_F / Z.familyFactor n F) atTop (𝓝 0) := by
    have h_inv : Tendsto (fun n => (Z.familyFactor n F)⁻¹) atTop (𝓝 0) :=
      tendsto_inv_atTop_zero.comp hZ_div
    simpa [div_eq_mul_inv] using (tendsto_const_nhds (x := M_F)).mul h_inv
  refine squeeze_zero_norm' ?_ h_rhs_zero
  refine Filter.Eventually.of_forall fun n => ?_
  rw [Real.norm_eq_abs]
  exact (h_all F n).2.2.2.2

/-- Single-loop corollary: whenever `Z.factor n ℓ → +∞`, `TwoCutoffComparison T Z` forces
the unrenormalized UV Wilson loop expectation `rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩` to decay to `0`. -/
theorem TwoCutoffComparison.tendsto_rawSchwinger_singleton_zero_of_tendsto_factor_atTop
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) (ℓ : PhysicalRectangle)
    (hZ_div : Tendsto (fun n => Z.factor n ℓ) atTop atTop) :
    Tendsto (fun n => rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩) atTop (𝓝 0) := by
  apply hC.tendsto_rawSchwinger_zero_of_tendsto_familyFactor_atTop ⟨[ℓ]⟩
  simpa using hZ_div

/-- Under a perimeter-corner renormalization scheme `Z = perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0)`
with diverging UV perimeter counterterm `m_n → +∞`, `TwoCutoffComparison T Z` unconditionally forces
every single-loop unrenormalized UV Wilson expectation `rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩` to decay
to `0` with explicit exponential perimeter bound
`|rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩| ≤ (1 + C_tube ^ 2 * (landingTubeContraction T) ^ n) * exp(-m_n * 2(R_μ + R_ν))`. -/
theorem TwoCutoffComparison.tendsto_rawSchwinger_singleton_zero_of_perimeterCorner_atTop
    {P : ContinuumCutoffPath} {T : LandingTube P}
    (m : ℕ → ℝ) (hm : Tendsto m atTop atTop)
    (hC : TwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0)))
    (ℓ : PhysicalRectangle) :
    let Z := perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0)
    Tendsto (fun n => Z.factor n ℓ) atTop atTop ∧
    Tendsto (fun n => rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩) atTop (𝓝 0) ∧
    ∃ C_tube : ℝ, 0 ≤ C_tube ∧
      ∀ n : ℕ,
        |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩| ≤
          (1 + C_tube ^ 2 * (landingTubeContraction T) ^ n) *
            Real.exp (-(m n * (2 * ((ℓ.sideμ : ℝ) + (ℓ.sideν : ℝ))))) := by
  dsimp only
  let Z := perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0)
  have hZ_div : Tendsto (fun n => Z.factor n ℓ) atTop atTop :=
    (perimeterCornerRenormalization_admits_diverging_positive_perimeter_counterterm P m hm ℓ).2.2.2.2
  have h_raw_zero : Tendsto (fun n => rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩) atTop (𝓝 0) :=
    hC.tendsto_rawSchwinger_singleton_zero_of_tendsto_factor_atTop ℓ hZ_div
  obtain ⟨C_tube, hC_tube, h_all⟩ :=
    hC.exists_singleton_counterterm_cancellation_and_rawSchwinger_bound
  refine ⟨hZ_div, h_raw_zero, C_tube, hC_tube, fun n => ?_⟩
  have h4 := (h_all ℓ n).2.2.2.1
  have h_fac_eq :
      |Z.factor n ℓ| = Real.exp (m n * (2 * ((ℓ.sideμ : ℝ) + (ℓ.sideν : ℝ)))) := by
    rw [abs_of_pos (Z.factor_pos n ℓ)]
    simp [Z, perimeterCornerRenormalization]
  rw [h_fac_eq, div_eq_mul_inv, ← Real.exp_neg] at h4
  exact h4

/-- Converse obstruction: if `m_n → +∞` and for some loop `ℓ : PhysicalRectangle` and `c₀ > 0`
the unrenormalized UV Wilson loop fails to decay to zero (`∃ᶠ n in atTop, c₀ ≤ |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩|`),
then `TwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0))` cannot hold. -/
theorem TwoCutoffComparison.not_twoCutoffComparison_of_frequently_ge_rawSchwinger_and_perimeterCorner_atTop
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (m : ℕ → ℝ) (hm : Tendsto m atTop atTop)
    (ℓ : PhysicalRectangle) {c₀ : ℝ} (hc₀ : 0 < c₀)
    (h_freq : ∃ᶠ n in atTop, c₀ ≤ |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩|) :
    ¬ TwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0)) := by
  intro hC
  have h_zero : Tendsto (fun n => rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩) atTop (𝓝 0) :=
    (hC.tendsto_rawSchwinger_singleton_zero_of_perimeterCorner_atTop m hm ℓ).2.1
  have h_abs_zero : Tendsto (fun n => |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩|) atTop (𝓝 0) := by
    simpa using h_zero.abs
  have h_ev_lt : ∀ᶠ n in atTop, |rawSchwinger P.toCutoffPath n ⟨[ℓ]⟩| < c₀ :=
    h_abs_zero.eventually (Iio_mem_nhds hc₀)
  rcases (h_freq.and_eventually h_ev_lt).exists with ⟨n, hge, hlt⟩
  exact not_lt_of_ge hge hlt

/-- For the repeated two-loop family `⟨[ℓ, ℓ]⟩`, the multiplicative family renormalization factor is
`Z.familyFactor n ⟨[ℓ, ℓ]⟩ = (Z.factor n ℓ) ^ 2`. -/
@[simp]
theorem LoopRenormalization.familyFactor_duplicate {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (ℓ : PhysicalRectangle) :
    Z.familyFactor n ⟨[ℓ, ℓ]⟩ = (Z.factor n ℓ) ^ 2 := by
  simp [LoopRenormalization.familyFactor, sq]

/-- Unrenormalized UV two-loop expectation of the repeated family `⟨[ℓ, ℓ]⟩` equals the second
moment `∫ U, (physicalWilsonLoop (P.side n) (P.spacing n) ℓ U) ^ 2 ∂(P.configLaw n)`. -/
theorem rawSchwinger_duplicate_eq_integral_sq (P : CutoffPath) (n : ℕ) (ℓ : PhysicalRectangle) :
    rawSchwinger P n ⟨[ℓ, ℓ]⟩ =
      ∫ U, (physicalWilsonLoop (P.side n) (P.spacing n) ℓ U) ^ 2
        ∂(P.configLaw n : Measure (GaugeConfig (P.side n))) := by
  unfold rawSchwinger renormalizedSchwinger
  refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
  simp [DisjointLoopFamily.eval, trivialLoopRenormalization, LoopRenormalization.unrenormalized, sq]

/-- Along any `T : LandingTube P`, for every physical rectangle `ℓ` whose `μ`-side is a multiple
of `T.ℓstar` (`∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ)`), the lattice loop at UV spacing
`P.spacing n` eventually has an even number of steps `2 * t` along `ℓ.μ` with `t ≤ P.side n / 2`
on an even-side torus `P.side n = 2 * (P.side n / 2)`, so reflection positivity
(`wilsonProbability_wilsonLoop_sq_ge_quarter`) forces `1 / 4 ≤ rawSchwinger P.toCutoffPath n ⟨[ℓ, ℓ]⟩`
eventually in `n`. -/
theorem LandingTube.eventually_rawSchwinger_duplicate_ge_quarter
    {P : ContinuumCutoffPath} (T : LandingTube P) {ℓ : PhysicalRectangle}
    (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ)) :
    ∀ᶠ n in atTop, (1 / 4 : ℝ) ≤ rawSchwinger P.toCutoffPath n ⟨[ℓ, ℓ]⟩ := by
  obtain ⟨k, hsideμ⟩ := hℓ
  have hbig : ∀ᶠ n in atTop, 2 * (ℓ.sideμ : ℝ) ≤ (P.side n : ℝ) * P.spacing n :=
    P.physicalSide_tendsto_atTop.eventually (eventually_ge_atTop _)
  filter_upwards [T.eventually_K_pos_and_even_side, T.hK, hbig] with n ⟨hK1, hev⟩ hKn hbn
  have hL : P.side n = 2 * (P.side n / 2) := by
    obtain ⟨m, hm⟩ := hev
    omega
  set t : ℕ := k * 2 ^ (T.K n - 1)
  have hpow : (2 : ℝ) ^ (T.K n) = 2 * (2 : ℝ) ^ (T.K n - 1) := by
    have hK_eq : T.K n = (T.K n - 1) + 1 := (Nat.sub_add_cancel hK1).symm
    conv_lhs => rw [hK_eq, pow_succ, mul_comm]
  have ha : 0 < P.spacing n := P.spacing_pos n
  have hmul : ((2 * t : ℕ) : ℝ) * P.spacing n = (ℓ.sideμ : ℝ) := by
    rw [hsideμ, ← hKn, hpow]
    push_cast [t]
    ring
  have hdiv : (ℓ.sideμ : ℝ) / P.spacing n = ((2 * t : ℕ) : ℝ) := by
    rw [← hmul, mul_div_cancel_right₀ _ ha.ne']
  have hsteps : ℓ.stepsμ (P.spacing n) = 2 * t := by
    unfold PhysicalRectangle.stepsμ
    rw [hdiv, Nat.floor_natCast]
  have ht : t ≤ P.side n / 2 := by
    have h2 : ((2 * (2 * t) : ℕ) : ℝ) * P.spacing n ≤ (P.side n : ℝ) * P.spacing n := by
      have h2' : ((2 * (2 * t) : ℕ) : ℝ) * P.spacing n = 2 * (((2 * t : ℕ) : ℝ) * P.spacing n) := by
        push_cast
        ring
      rw [h2', hmul]
      exact hbn
    have h3 : ((2 * (2 * t) : ℕ) : ℝ) ≤ (P.side n : ℝ) :=
      le_of_mul_le_mul_right h2 ha
    have h4 : 2 * (2 * t) ≤ P.side n := by exact_mod_cast h3
    omega
  rw [rawSchwinger_duplicate_eq_integral_sq]
  have hloop : ∀ U : GaugeConfig (P.side n),
      (physicalWilsonLoop (P.side n) (P.spacing n) ℓ U) ^ 2 =
        wilsonLoop U (latticeSite (P.side n) (ℓ.latticeBase (P.spacing n)))
          (rectangleSteps ℓ.μ ℓ.ν (2 * t) (ℓ.stepsν (P.spacing n))) ^ 2 := by
    intro U
    simp only [physicalWilsonLoop, PhysicalRectangle.latticeLoop, hsteps]
  simp only [hloop]
  exact wilsonProbability_wilsonLoop_sq_ge_quarter hL (P.coupling n) (P.coupling_nonneg n)
    ℓ.plane.ne ht (ℓ.stepsν (P.spacing n)) _

/-- `TwoCutoffComparison T Z` forces the per-loop factor `Z.factor n ℓ` to be bounded uniformly in
`n` for every loop `ℓ` whose `μ`-side is a multiple of `T.ℓstar`:
evaluating Item 3 of `TwoCutoffComparison.exists_counterterm_cancellation_and_rawSchwinger_bound` on
the repeated two-loop family `F := ⟨[ℓ, ℓ]⟩` and combining it with
`LandingTube.eventually_rawSchwinger_duplicate_ge_quarter` gives
`(Z.factor n ℓ) ^ 2 ≤ 4 * (1 + C_tube ^ 3 * (landingTubeContraction T) ^ n)` eventually in `n` and
a uniform upper bound `∀ n : ℕ, Z.factor n ℓ ≤ B`. -/
theorem TwoCutoffComparison.exists_factor_bound_of_sideμ_mul_ellstar
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) {ℓ : PhysicalRectangle}
    (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ)) :
    (∃ C_tube : ℝ, 0 ≤ C_tube ∧
      ∀ᶠ n in atTop,
        (Z.factor n ℓ) ^ 2 ≤ 4 * (1 + C_tube ^ 3 * (landingTubeContraction T) ^ n)) ∧
    (∃ B : ℝ, 0 ≤ B ∧ ∀ n : ℕ, Z.factor n ℓ ≤ B) := by
  obtain ⟨C_tube, hC_tube, h_all⟩ := hC.exists_counterterm_cancellation_and_rawSchwinger_bound
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  have h_sq_ev :
      ∀ᶠ n in atTop,
        (Z.factor n ℓ) ^ 2 ≤ 4 * (1 + C_tube ^ 3 * (landingTubeContraction T) ^ n) := by
    filter_upwards [T.eventually_rawSchwinger_duplicate_ge_quarter hℓ] with n h_quar
    have h3 := (h_all ⟨[ℓ, ℓ]⟩ n).2.2.1
    have h_len : (⟨[ℓ, ℓ]⟩ : DisjointLoopFamily).loops.length + 1 = 3 := rfl
    rw [LoopRenormalization.familyFactor_duplicate, h_len] at h3
    have h_nonneg : 0 ≤ (Z.factor n ℓ) ^ 2 * rawSchwinger P.toCutoffPath n ⟨[ℓ, ℓ]⟩ :=
      mul_nonneg (sq_nonneg _) (by linarith)
    rw [abs_of_nonneg h_nonneg] at h3
    have h_mul : (Z.factor n ℓ) ^ 2 * (1 / 4 : ℝ) ≤
        (Z.factor n ℓ) ^ 2 * rawSchwinger P.toCutoffPath n ⟨[ℓ, ℓ]⟩ :=
      mul_le_mul_of_nonneg_left h_quar (sq_nonneg _)
    linarith
  refine ⟨⟨C_tube, hC_tube, h_sq_ev⟩, ?_⟩
  have h_lin_ev : ∀ᶠ n in atTop, Z.factor n ℓ ≤ 4 * (1 + C_tube ^ 3) + 1 := by
    filter_upwards [h_sq_ev] with n h_sq
    have hqn_le_one : (landingTubeContraction T) ^ n ≤ 1 := pow_le_one₀ hq0.le hq1.le
    have hC3_nonneg : 0 ≤ C_tube ^ 3 := pow_nonneg hC_tube 3
    have h_sq_const : (Z.factor n ℓ) ^ 2 ≤ 4 * (1 + C_tube ^ 3) := by
      nlinarith [mul_le_of_le_one_right hC3_nonneg hqn_le_one]
    have h_le_sq_add_one : Z.factor n ℓ ≤ (Z.factor n ℓ) ^ 2 + 1 := by
      nlinarith [sq_nonneg (Z.factor n ℓ - 1), Z.factor_pos n ℓ]
    linarith
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.mp h_lin_ev
  let B₁ : ℝ := 4 * (1 + C_tube ^ 3) + 1
  let B₀ : ℝ := ∑ m ∈ Finset.range N₀, Z.factor m ℓ
  have hB₀_nonneg : 0 ≤ B₀ := Finset.sum_nonneg (fun m _ => (Z.factor_pos m ℓ).le)
  refine ⟨max B₁ B₀, le_max_of_le_right hB₀_nonneg, fun n => ?_⟩
  by_cases hn : N₀ ≤ n
  · exact (hN₀ n hn).trans (le_max_left B₁ B₀)
  · exact (Finset.single_le_sum (fun m _ => (Z.factor_pos m ℓ).le)
      (Finset.mem_range.mpr (not_le.mp hn))).trans (le_max_right B₁ B₀)

/-- Refutation of `TwoCutoffComparison T Z` for any loop renormalization `Z` whose per-loop factor
`Z.factor n ℓ` is unbounded in `n` on a loop `ℓ` whose `μ`-side is a multiple of `T.ℓstar`. -/
theorem not_twoCutoffComparison_of_unbounded_factor
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    {ℓ : PhysicalRectangle} (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ))
    (hunb : ∀ B : ℝ, ∃ n : ℕ, B < Z.factor n ℓ) :
    ¬ TwoCutoffComparison T Z := by
  intro hC
  obtain ⟨_, B, _, hB⟩ := hC.exists_factor_bound_of_sideμ_mul_ellstar hℓ
  obtain ⟨n, hn⟩ := hunb B
  linarith [hB n]

/-- Refutation of `TwoCutoffComparison T Z` whenever `Z.factor n ℓ → +∞` on a loop `ℓ` whose
`μ`-side is a multiple of `T.ℓstar`. -/
theorem not_twoCutoffComparison_of_tendsto_factor_atTop
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    {ℓ : PhysicalRectangle} (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ))
    (hdiv : Tendsto (fun n => Z.factor n ℓ) atTop atTop) :
    ¬ TwoCutoffComparison T Z := by
  refine not_twoCutoffComparison_of_unbounded_factor T Z hℓ (fun B => ?_)
  exact (hdiv.eventually (eventually_gt_atTop B)).exists

/-- Refutation of `TwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m c)` whenever
the perimeter-corner exponent `m n * (2 * (ℓ.sideμ + ℓ.sideν)) + 4 * c n → +∞` for a loop `ℓ` whose
`μ`-side is a multiple of `T.ℓstar`. -/
theorem not_twoCutoffComparison_of_perimeterCorner_tendsto_atTop
    {P : ContinuumCutoffPath} (T : LandingTube P) (m c : ℕ → ℝ)
    {ℓ : PhysicalRectangle} (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ))
    (hdiv : Tendsto (fun n => m n * (2 * ((ℓ.sideμ : ℝ) + (ℓ.sideν : ℝ))) + 4 * c n) atTop atTop) :
    ¬ TwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m c) := by
  refine not_twoCutoffComparison_of_tendsto_factor_atTop T
    (perimeterCornerRenormalization P.toCutoffPath m c) hℓ ?_
  simpa [perimeterCornerRenormalization] using hdiv

/-- Refutation of `TwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m c)` for
every `T : LandingTube P` whenever `m n → +∞` and `c` is eventually bounded below. This refutes
the two-cutoff comparison hypothesis `hC` for every diverging perimeter counterterm `m n → +∞`
with bounded-below corner counterterm `c`. -/
theorem not_twoCutoffComparison_of_perimeter_tendsto_atTop_and_corner_bddBelow
    {P : ContinuumCutoffPath} (T : LandingTube P) (m c : ℕ → ℝ)
    (hm : Tendsto m atTop atTop)
    (hc : ∃ c_lo : ℝ, ∀ᶠ n in atTop, c_lo ≤ c n) :
    ¬ TwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m c) := by
  obtain ⟨c_lo, hc_lo⟩ := hc
  let ℓ₀ : PhysicalRectangle :=
    { base := fun _ => 1
      μ := 0
      ν := 1
      plane := by decide
      sideμ := T.ℓstar
      sideν := T.ℓstar
      sideμ_pos := T.hℓstar
      sideν_pos := T.hℓstar }
  have hℓ₀ : ∃ k : ℕ, (ℓ₀.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ) := ⟨1, by simp [ℓ₀]⟩
  have hL_pos : (0 : ℝ) < 2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ)) := by
    have hℓstar_pos : (0 : ℝ) < (T.ℓstar : ℝ) := Rat.cast_pos.mpr T.hℓstar
    dsimp [ℓ₀]
    linarith
  have hm_mul : Tendsto (fun n => m n * (2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ)))) atTop atTop :=
    Tendsto.atTop_mul_const hL_pos hm
  have hm_add :
      Tendsto (fun n => m n * (2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ))) + 4 * c_lo) atTop atTop :=
    tendsto_atTop_add_const_right atTop (4 * c_lo) hm_mul
  have hdiv :
      Tendsto (fun n => m n * (2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ))) + 4 * c n) atTop atTop := by
    refine tendsto_atTop_mono' atTop ?_ hm_add
    filter_upwards [hc_lo] with n hn
    linarith
  exact not_twoCutoffComparison_of_perimeterCorner_tendsto_atTop T m c hℓ₀ hdiv

/-- `interactingBlockedEffectiveAction dis β f` depends on `(β, f)` only through the total
non-vacuum fine action `U ↦ wilsonAction β U + f U` (equivalently `U ↦ β * wilsonAction 1 U + f U`):
if two pairs `(β, f)` and `(β', f')` have the same pointwise sum `wilsonAction β U + f U = wilsonAction β' U + f' U`
for all `U : GaugeConfig (2 * L)`, their blocked fiber weights and blocked effective actions are
identically equal at every coarse configuration `V : GaugeConfig L`. -/
theorem interactingBlockedEffectiveAction_eq_of_wilsonAction_add_eq
    {L : ℕ} [NeZero L] [NeZero (2 * L)]
    (dis : ConditionalBlockFiberDisintegration L)
    {β β' : ℝ} {f f' : GaugeConfig (2 * L) → ℝ}
    (h_tot : ∀ U : GaugeConfig (2 * L), wilsonAction β U + f U = wilsonAction β' U + f' U)
    (V : GaugeConfig L) :
    interactingBlockedEffectiveAction dis β f V =
      interactingBlockedEffectiveAction dis β' f' V := by
  unfold interactingBlockedEffectiveAction interactingBlockedFiberWeight
  have h_int_eq :
      (fun U : GaugeConfig (2 * L) => Real.exp (-wilsonAction β U - f U)) =
        (fun U : GaugeConfig (2 * L) => Real.exp (-wilsonAction β' U - f' U)) := by
    funext U
    have hU := h_tot U
    congr 1
    linarith
  rw [h_int_eq]

/-- Equivalent `β * wilsonAction 1 U + f U` formulation of
`interactingBlockedEffectiveAction_eq_of_wilsonAction_add_eq` on `haarBlockDisintegration L`. -/
theorem haarInteractingBlockedEffectiveAction_eq_of_beta_mul_wilsonAction_add_eq
    {L : ℕ} [NeZero L]
    {β β' : ℝ} {f f' : GaugeConfig (2 * L) → ℝ}
    (h_tot : ∀ U : GaugeConfig (2 * L),
      β * wilsonAction 1 U + f U = β' * wilsonAction 1 U + f' U)
    (V : GaugeConfig L) :
    interactingBlockedEffectiveAction (haarBlockDisintegration L) β f V =
      interactingBlockedEffectiveAction (haarBlockDisintegration L) β' f' V := by
  apply interactingBlockedEffectiveAction_eq_of_wilsonAction_add_eq
  intro U
  rw [wilsonAction_eq_beta_mul_wilsonAction_one β U,
    wilsonAction_eq_beta_mul_wilsonAction_one β' U]
  exact h_tot U

/-- Structural pinned-action theorem for `MultiStepHaarRGChain`: any two chains
`C, C' : MultiStepHaarRGChain L_ir K β_uv` have identically equal `totalAction` at every scale
`m ≤ K` (`(C.state m).totalAction V = (C'.state m).totalAction V`), proved by downward induction
from `h_uv` using `h_step_exact` and `step_fiber_integral_exp_neg_totalAction_eq`. -/
theorem MultiStepHaarRGChain.totalAction_eq
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ}
    (C C' : MultiStepHaarRGChain L_ir K β_uv) :
    ∀ m ≤ K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m),
      (C.state m).totalAction V = (C'.state m).totalAction V := by
  suffices h_ind : ∀ j ≤ K, ∀ m : ℕ, m + j = K →
      ∀ V : GaugeConfig (dyadicScaleSide L_ir m),
        (C.state m).totalAction V = (C'.state m).totalAction V by
    intro m hm V
    exact h_ind (K - m) (Nat.sub_le K m) m (Nat.add_sub_of_le hm) V
  intro j
  induction j with
  | zero =>
    intro _ m hm V
    have hmK : m = K := by omega
    subst hmK
    rw [C.h_uv, C'.h_uv]
  | succ j ih =>
    intro hj m hm V
    have hm_lt : m < K := by omega
    have hj_le : j ≤ K := by omega
    have hm1_eq : (m + 1) + j = K := by omega
    have hm1_le : m + 1 ≤ K := by omega
    obtain ⟨hR_meas, B_R, hR_bdd⟩ := C.measurable_and_bdd_R_trunc (m + 1) hm1_le
    obtain ⟨hR'_meas, B_R', hR'_bdd⟩ := C'.measurable_and_bdd_R_trunc (m + 1) hm1_le
    have h_exp_C :=
      C.step_fiber_integral_exp_neg_totalAction_eq hm_lt hR_meas hR_bdd V
    have h_exp_C' :=
      C'.step_fiber_integral_exp_neg_totalAction_eq hm_lt hR'_meas hR'_bdd V
    have h_fine_eq :
        (fun U : GaugeConfig (dyadicScaleSide L_ir (m + 1)) =>
          Real.exp (-(C.state (m + 1)).totalAction U)) =
        (fun U : GaugeConfig (dyadicScaleSide L_ir (m + 1)) =>
          Real.exp (-(C'.state (m + 1)).totalAction U)) := by
      funext U
      rw [ih hj_le (m + 1) hm1_eq U]
    have h_exp_eq :
        Real.exp (-(C.state m).totalAction V) = Real.exp (-(C'.state m).totalAction V) := by
      rw [← h_exp_C, ← h_exp_C', h_fine_eq]
    exact neg_injective (Real.exp_injective h_exp_eq)

/-- `MultiStepHaarRGChain` does not let you choose the RG flow: for any two chains
`C, C' : MultiStepHaarRGChain L_ir K β_uv`, their vacuum-subtracted total actions at every scale
`m ≤ K` are identically equal and determined by `L_ir`, `K`, and `β_uv` alone. -/
theorem MultiStepHaarRGChain.totalAction_sub_vacuum_eq
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ}
    (C C' : MultiStepHaarRGChain L_ir K β_uv) :
    ∀ m ≤ K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m),
      (C.state m).totalAction V -
          (C.state m).totalAction (vacuumConfig (dyadicScaleSide L_ir m)) =
        (C'.state m).totalAction V -
          (C'.state m).totalAction (vacuumConfig (dyadicScaleSide L_ir m)) := by
  intro m hm V
  rw [MultiStepHaarRGChain.totalAction_eq C C' m hm V,
    MultiStepHaarRGChain.totalAction_eq C C' m hm (vacuumConfig (dyadicScaleSide L_ir m))]

/-- Corollary of `MultiStepHaarRGChain.totalAction_eq`: for any two chains
`C, C' : MultiStepHaarRGChain L_ir K β_uv` and every scale `m ≤ K`,
`(C.state m).gibbsMeasure = (C'.state m).gibbsMeasure`, so `(C.state m).β`, `(C.state m).polymers`,
and `(C.state m).R_trunc` are only a relabeling of one fixed action. -/
theorem MultiStepHaarRGChain.gibbsMeasure_eq
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ}
    (C C' : MultiStepHaarRGChain L_ir K β_uv) :
    ∀ m ≤ K, (C.state m).gibbsMeasure = (C'.state m).gibbsMeasure := by
  intro m hm
  rw [(C.state m).gibbsMeasure_eq_groupGibbsMeasure,
    (C'.state m).gibbsMeasure_eq_groupGibbsMeasure]
  have h_act : (C.state m).totalAction = (C'.state m).totalAction :=
    funext (MultiStepHaarRGChain.totalAction_eq C C' m hm)
  rw [h_act]

/-! ### Shift-Argument Refutation of `TwoCutoffComparison` from `h_floor` and Exponential IR Covariance Decay -/

/-- Coarse-rounding invariance of `physicalWilsonLoop`: any two physical rectangles `ℓ₁, ℓ₂`
whose rounded integer base coordinates `latticeBase a` and step lists `latticeLoop a` agree at
spacing `a` induce the exact same lattice Wilson loop observable `physicalWilsonLoop L a`. -/
theorem physicalWilsonLoop_eq_of_latticeBase_and_latticeLoop_eq
    (L : ℕ) (a : ℝ) {ℓ₁ ℓ₂ : PhysicalRectangle}
    (hbase : ℓ₁.latticeBase a = ℓ₂.latticeBase a)
    (hloop : ℓ₁.latticeLoop a = ℓ₂.latticeLoop a) :
    physicalWilsonLoop L a ℓ₁ = physicalWilsonLoop L a ℓ₂ := by
  funext V
  unfold physicalWilsonLoop
  rw [hbase, hloop]

/-- Coarse-rounding invariance of `landedIrSchwinger` on singletons `⟨[ℓ]⟩`. -/
theorem landedIrSchwinger_singleton_eq_of_latticeBase_and_latticeLoop_eq
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) {ℓ₁ ℓ₂ : PhysicalRectangle}
    (hbase : ℓ₁.latticeBase (T.ℓstar : ℝ) = ℓ₂.latticeBase (T.ℓstar : ℝ))
    (hloop : ℓ₁.latticeLoop (T.ℓstar : ℝ) = ℓ₂.latticeLoop (T.ℓstar : ℝ)) :
    landedIrSchwinger T Z n ⟨[ℓ₁]⟩ = landedIrSchwinger T Z n ⟨[ℓ₂]⟩ := by
  unfold landedIrSchwinger irLoopFamilyObservable
  have hW := physicalWilsonLoop_eq_of_latticeBase_and_latticeLoop_eq (T.irSide n) (T.ℓstar : ℝ) hbase hloop
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, hW]

/-- Coarse-rounding invariance of `landedIrSchwinger` on two-loop pairs `⟨[ℓ₁, ℓ₂]⟩`. -/
theorem landedIrSchwinger_pair_eq_of_latticeBase_and_latticeLoop_eq
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) {ℓ₁ ℓ₁' ℓ₂ ℓ₂' : PhysicalRectangle}
    (hb1 : ℓ₁.latticeBase (T.ℓstar : ℝ) = ℓ₁'.latticeBase (T.ℓstar : ℝ))
    (hl1 : ℓ₁.latticeLoop (T.ℓstar : ℝ) = ℓ₁'.latticeLoop (T.ℓstar : ℝ))
    (hb2 : ℓ₂.latticeBase (T.ℓstar : ℝ) = ℓ₂'.latticeBase (T.ℓstar : ℝ))
    (hl2 : ℓ₂.latticeLoop (T.ℓstar : ℝ) = ℓ₂'.latticeLoop (T.ℓstar : ℝ)) :
    landedIrSchwinger T Z n ⟨[ℓ₁, ℓ₂]⟩ = landedIrSchwinger T Z n ⟨[ℓ₁', ℓ₂']⟩ := by
  unfold landedIrSchwinger irLoopFamilyObservable
  have hW1 := physicalWilsonLoop_eq_of_latticeBase_and_latticeLoop_eq (T.irSide n) (T.ℓstar : ℝ) hb1 hl1
  have hW2 := physicalWilsonLoop_eq_of_latticeBase_and_latticeLoop_eq (T.irSide n) (T.ℓstar : ℝ) hb2 hl2
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, hW1, hW2]

/-- Representative physical rectangle `rectWithTimeFract a θ ℓ` having the exact same plane `(μ, ν)`,
side lengths `(sideμ, sideν)`, and rounded coarse lattice base `latticeBase (a : ℝ)` as `ℓ`, while
setting the Euclidean time base coordinate to `((ℓ.latticeBase (a : ℝ) 0 : ℚ) + θ) * a` and the
spatial base coordinates `i ≠ 0` to `(ℓ.latticeBase (a : ℝ) i : ℚ) * a`. -/
noncomputable def rectWithTimeFract (a θ : ℚ) (ℓ : PhysicalRectangle) : PhysicalRectangle where
  base := fun i =>
    if i = 0 then
      ((ℓ.latticeBase (a : ℝ) 0 : ℚ) + θ) * a
    else
      (ℓ.latticeBase (a : ℝ) i : ℚ) * a
  μ := ℓ.μ
  ν := ℓ.ν
  plane := ℓ.plane
  sideμ := ℓ.sideμ
  sideν := ℓ.sideν
  sideμ_pos := ℓ.sideμ_pos
  sideν_pos := ℓ.sideν_pos

@[simp]
theorem rectWithTimeFract_latticeLoop (a θ : ℚ) (ℓ : PhysicalRectangle) (r : ℝ) :
    (rectWithTimeFract a θ ℓ).latticeLoop r = ℓ.latticeLoop r := rfl

@[simp]
theorem translate_latticeLoop (c : Fin 4 → ℚ) (ℓ : PhysicalRectangle) (r : ℝ) :
    (ℓ.translate c).latticeLoop r = ℓ.latticeLoop r := rfl

/-- For `0 < a` and `0 ≤ θ < 1`, `rectWithTimeFract a θ ℓ` has the exact same coarse `latticeBase (a : ℝ)`
as `ℓ` in all four coordinates `i : Fin 4`. -/
theorem rectWithTimeFract_latticeBase_eq {a θ : ℚ} (ha : 0 < a) (hθ0 : 0 ≤ θ) (hθ1 : θ < 1)
    (ℓ : PhysicalRectangle) :
    (rectWithTimeFract a θ ℓ).latticeBase (a : ℝ) = ℓ.latticeBase (a : ℝ) := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  have hθ0_real : (0 : ℝ) ≤ (θ : ℝ) := Rat.cast_nonneg.mpr hθ0
  have hθ1_real : (θ : ℝ) < 1 := by exact_mod_cast hθ1
  funext i
  unfold PhysicalRectangle.latticeBase rectWithTimeFract
  dsimp only
  by_cases hi : i = 0
  · subst hi
    simp only [↓reduceIte, Rat.cast_mul, Rat.cast_add, Rat.cast_intCast,
      mul_div_cancel_right₀ _ ha_real.ne']
    rw [Int.floor_intCast_add, Int.floor_eq_zero_iff.mpr ⟨hθ0_real, hθ1_real⟩, add_zero]
    rfl
  · simp only [hi, ↓reduceIte, Rat.cast_mul, Rat.cast_intCast,
      mul_div_cancel_right₀ _ ha_real.ne', Int.floor_intCast]
    rfl

/-- Shifting any rectangle `ℓ` by `timeShift ((s : ℚ) * a)` shifts `latticeBase (a : ℝ) 0` by `(s : ℤ)`
and leaves `latticeBase (a : ℝ) i` (`i ≠ 0`) unchanged. -/
theorem latticeBase_translate_timeShift_nat_mul {a : ℚ} (ha : 0 < a) (s : ℕ)
    (ℓ : PhysicalRectangle) (i : Fin 4) :
    (ℓ.translate (timeShift ((s : ℚ) * a))).latticeBase (a : ℝ) i =
      ℓ.latticeBase (a : ℝ) i + if i = 0 then (s : ℤ) else 0 := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  unfold PhysicalRectangle.latticeBase PhysicalRectangle.translate timeShift
  dsimp only [Pi.add_apply]
  by_cases hi : i = 0
  · subst hi
    simp only [↓reduceIte, Rat.cast_add, Rat.cast_mul, Rat.cast_natCast]
    have h_div :
        ((ℓ.base 0 : ℝ) + (s : ℝ) * (a : ℝ)) / (a : ℝ) =
          (ℓ.base 0 : ℝ) / (a : ℝ) + ((s : ℤ) : ℝ) := by
      rw [add_div, mul_div_cancel_right₀ _ ha_real.ne', Int.cast_natCast]
    rw [h_div, Int.floor_add_intCast]
  · simp only [hi, ↓reduceIte, add_zero]

/-- Shifting `rectWithTimeFract a (1 / 4) ℓ` by `timeShift (a / 2)` produces fractional time part
`1 / 4 + 1 / 2 = 3 / 4 < 1`, hence zero integer carry and the exact same coarse `latticeBase (a : ℝ)`. -/
theorem latticeBase_translate_half_rectWithTimeFract_quarter {a : ℚ} (ha : 0 < a)
    (ℓ : PhysicalRectangle) :
    ((rectWithTimeFract a (1 / 4) ℓ).translate (timeShift (a / 2))).latticeBase (a : ℝ) =
      (rectWithTimeFract a (1 / 4) ℓ).latticeBase (a : ℝ) := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  rw [rectWithTimeFract_latticeBase_eq ha (by norm_num) (by norm_num) ℓ]
  funext i
  unfold PhysicalRectangle.latticeBase PhysicalRectangle.translate rectWithTimeFract timeShift
  dsimp only [Pi.add_apply]
  by_cases hi : i = 0
  · subst hi
    simp only [↓reduceIte, Rat.cast_add, Rat.cast_mul, Rat.cast_intCast, Rat.cast_div,
      Rat.cast_one, Rat.cast_ofNat]
    have h_alg :
        ((((ℓ.latticeBase (a : ℝ) 0 : ℝ) + 1 / 4) * (a : ℝ) + (a : ℝ) / 2) / (a : ℝ)) =
          (ℓ.latticeBase (a : ℝ) 0 : ℝ) + (3 / 4 : ℝ) := by
      field_simp [ha_real.ne']
      ring
    rw [h_alg, Int.floor_intCast_add,
      Int.floor_eq_zero_iff.mpr ⟨by norm_num, by norm_num⟩, add_zero]
    rfl
  · simp only [hi, ↓reduceIte, add_zero, Rat.cast_mul, Rat.cast_intCast,
      mul_div_cancel_right₀ _ ha_real.ne', Int.floor_intCast]
    rfl

/-- Shifting `(rectWithTimeFract a (3 / 4) ℓ).translate (timeShift ((s : ℚ) * a))` by `timeShift (a / 2)`
produces fractional time part `3 / 4 + 1 / 2 = 1 + 1 / 4`, hence a unit integer carry matching
`(rectWithTimeFract a (3 / 4) ℓ).translate (timeShift (((s + 1 : ℕ) : ℚ) * a))` at coarse spacing `a`. -/
theorem latticeBase_translate_half_rectWithTimeFract_threeQuarter {a : ℚ} (ha : 0 < a)
    (ℓ : PhysicalRectangle) (s : ℕ) :
    (((rectWithTimeFract a (3 / 4) ℓ).translate (timeShift ((s : ℚ) * a))).translate
        (timeShift (a / 2))).latticeBase (a : ℝ) =
      ((rectWithTimeFract a (3 / 4) ℓ).translate
        (timeShift (((s + 1 : ℕ) : ℚ) * a))).latticeBase (a : ℝ) := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  funext i
  rw [latticeBase_translate_timeShift_nat_mul ha (s + 1) (rectWithTimeFract a (3 / 4) ℓ) i,
    rectWithTimeFract_latticeBase_eq ha (by norm_num) (by norm_num) ℓ]
  unfold PhysicalRectangle.latticeBase PhysicalRectangle.translate rectWithTimeFract timeShift
  dsimp only [Pi.add_apply]
  by_cases hi : i = 0
  · subst hi
    simp only [↓reduceIte, Rat.cast_add, Rat.cast_mul, Rat.cast_intCast, Rat.cast_natCast,
      Rat.cast_div, Rat.cast_ofNat]
    have h_alg :
        (((((ℓ.latticeBase (a : ℝ) 0 : ℝ) + 3 / 4) * (a : ℝ) + (s : ℝ) * (a : ℝ)) + (a : ℝ) / 2) /
          (a : ℝ)) =
          ((ℓ.latticeBase (a : ℝ) 0 + ((s + 1 : ℕ) : ℤ) : ℤ) : ℝ) + (1 / 4 : ℝ) := by
      push_cast
      field_simp [ha_real.ne']
      ring
    rw [h_alg, Int.floor_intCast_add,
      Int.floor_eq_zero_iff.mpr ⟨by norm_num, by norm_num⟩, add_zero]
    rfl
  · simp only [hi, ↓reduceIte, add_zero, Rat.cast_mul, Rat.cast_intCast,
      mul_div_cancel_right₀ _ ha_real.ne', Int.floor_intCast]
    rfl

/-- Two-loop family `quarterThreeQuarterPairFamily a ℓ_R ℓ_L s = ⟨[R, L_s]⟩` where
`R = rectWithTimeFract a (1 / 4) ℓ_R` has time fractional part `1 / 4` and
`L_s = (rectWithTimeFract a (3 / 4) ℓ_L).translate (timeShift ((s : ℚ) * a))` has time fractional
part `3 / 4` shifted by `s` coarse steps. -/
noncomputable def quarterThreeQuarterPairFamily (a : ℚ) (ℓ_R ℓ_L : PhysicalRectangle) (s : ℕ) :
    DisjointLoopFamily :=
  ⟨[rectWithTimeFract a (1 / 4) ℓ_R,
    (rectWithTimeFract a (3 / 4) ℓ_L).translate (timeShift ((s : ℚ) * a))]⟩

/-- **Stage 1 (Landed Shift Lemma):**
Along any `T : LandingTube P`, for the two-loop family
`G_s = quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L s = ⟨[R, L_s]⟩`:
1. Shifting `G_s` by `T.ℓstar / 2` in Euclidean time gives the exact same `landedIrSchwinger` as `G_{s+1}`,
2. Shifting `⟨[R]⟩` by `T.ℓstar / 2` gives the exact same `landedIrSchwinger` as `⟨[R]⟩`, and
3. Shifting `⟨[L_s]⟩` by `T.ℓstar / 2` gives the exact same `landedIrSchwinger` as `⟨[L_{s+1}]⟩`. -/
theorem landedIrSchwinger_translate_half_ellstar_quarterThreeQuarter_eq
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (ℓ_R ℓ_L : PhysicalRectangle) (s n : ℕ) :
    let R := rectWithTimeFract T.ℓstar (1 / 4) ℓ_R
    let L_step := fun k : ℕ =>
      (rectWithTimeFract T.ℓstar (3 / 4) ℓ_L).translate (timeShift ((k : ℚ) * T.ℓstar))
    landedIrSchwinger T Z n
        ((quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L s).translate (timeShift (T.ℓstar / 2))) =
      landedIrSchwinger T Z n (quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L (s + 1)) ∧
    landedIrSchwinger T Z n ((⟨[R]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
      landedIrSchwinger T Z n ⟨[R]⟩ ∧
    landedIrSchwinger T Z n
        ((⟨[L_step s]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
      landedIrSchwinger T Z n ⟨[L_step (s + 1)]⟩ := by
  dsimp only [quarterThreeQuarterPairFamily, DisjointLoopFamily.translate, List.map_cons,
    List.map_nil]
  refine ⟨?_, ?_, ?_⟩
  · exact landedIrSchwinger_pair_eq_of_latticeBase_and_latticeLoop_eq T Z n
      (latticeBase_translate_half_rectWithTimeFract_quarter T.hℓstar ℓ_R) rfl
      (latticeBase_translate_half_rectWithTimeFract_threeQuarter T.hℓstar ℓ_L s) rfl
  · exact landedIrSchwinger_singleton_eq_of_latticeBase_and_latticeLoop_eq T Z n
      (latticeBase_translate_half_rectWithTimeFract_quarter T.hℓstar ℓ_R) rfl
  · exact landedIrSchwinger_singleton_eq_of_latticeBase_and_latticeLoop_eq T Z n
      (latticeBase_translate_half_rectWithTimeFract_threeQuarter T.hℓstar ℓ_L s) rfl

/-- For any rational spacing `a : ℚ`, integer numerator `k : ℤ`, and rectangle `ℓ : PhysicalRectangle`,
`rectWithTimeFract a ((k : ℚ) / 4) ℓ` has a quarter-lattice (`m = 2` dyadic) base point
`IsLatticeVector ((a : ℝ) / (2 : ℝ) ^ 2) (rectWithTimeFract a ((k : ℚ) / 4) ℓ).base`. -/
theorem isLatticeVector_quarter_rectWithTimeFract (a : ℚ) (k : ℤ) (ℓ : PhysicalRectangle) :
    IsLatticeVector ((a : ℝ) / (2 : ℝ) ^ 2) (rectWithTimeFract a ((k : ℚ) / 4) ℓ).base := by
  intro i
  unfold rectWithTimeFract
  dsimp only
  by_cases hi : i = 0
  · subst hi
    refine ⟨4 * ℓ.latticeBase (a : ℝ) 0 + k, ?_⟩
    simp only [↓reduceIte, Rat.cast_mul, Rat.cast_add, Rat.cast_intCast, Rat.cast_div,
      Rat.cast_ofNat, Int.cast_add, Int.cast_mul, Int.cast_ofNat]
    ring
  · refine ⟨4 * ℓ.latticeBase (a : ℝ) i, ?_⟩
    simp only [hi, ↓reduceIte, Rat.cast_mul, Rat.cast_intCast, Int.cast_mul, Int.cast_ofNat]
    ring

/-- Shifting any quarter-lattice base rectangle `ℓ` by `timeShift ((s : ℚ) * a)` preserves
`IsLatticeVector ((a : ℝ) / (2 : ℝ) ^ 2)`. -/
theorem isLatticeVector_quarter_translate_timeShift_nat_mul (a : ℚ) (s : ℕ)
    {ℓ : PhysicalRectangle} (hℓ : IsLatticeVector ((a : ℝ) / (2 : ℝ) ^ 2) ℓ.base) :
    IsLatticeVector ((a : ℝ) / (2 : ℝ) ^ 2) (ℓ.translate (timeShift ((s : ℚ) * a))).base := by
  intro i
  obtain ⟨m, hm⟩ := hℓ i
  unfold PhysicalRectangle.translate timeShift
  dsimp only [Pi.add_apply]
  by_cases hi : i = 0
  · subst hi
    refine ⟨m + 4 * (s : ℤ), ?_⟩
    simp only [↓reduceIte, Rat.cast_add, Rat.cast_mul, Rat.cast_natCast,
      Int.cast_add, Int.cast_mul, Int.cast_ofNat, Int.cast_natCast, hm]
    ring
  · refine ⟨m, ?_⟩
    simp only [hi, ↓reduceIte, add_zero, hm]

/-- Under `TwoCutoffComparison T Z`, if `S` is the continuum limit of `renormalizedSchwinger Z n`,
then `S (F.translate c) = S F` for every `T.ℓstar`-dyadic-base loop family `F` and every shift
`c : Fin 4 → ℚ`. -/
theorem TwoCutoffComparison.continuumLimit_translate_eq_of_dyadic_base
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) {S : DisjointLoopFamily → ℝ}
    (hS : ∀ F : DisjointLoopFamily, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F)))
    (F : DisjointLoopFamily)
    (hF : ∀ ℓ ∈ F.loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base)
    (c : Fin 4 → ℚ) :
    S (F.translate c) = S F := by
  have h_ev : ∀ᶠ n in atTop,
      renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
    rw [hC.hZ_eq]
    exact (T.eventually_forall_translate_eq_of_dyadic_base F hF).mono fun _ hn => hn c
  exact tendsto_nhds_unique (hS (F.translate c)) ((hS F).congr' (h_ev.mono fun _ h => h.symm))

/-- Expressing `quarterThreeQuarterPairFamily` as `(⟨[R.timeReflect]⟩ : DisjointLoopFamily).reflect.append ⟨[L_s]⟩`
via `timeReflect_timeReflect`, turning `landedIrSchwinger` into `irCov` via
`landedIrSchwinger_reflect_append_sub_mul_eq_irCov`. -/
theorem landedIrSchwinger_quarterThreeQuarter_sub_mul_eq_irCov
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (ℓ_R ℓ_L : PhysicalRectangle) (s n : ℕ) :
    let R := rectWithTimeFract T.ℓstar (1 / 4) ℓ_R
    let L_s := (rectWithTimeFract T.ℓstar (3 / 4) ℓ_L).translate (timeShift ((s : ℚ) * T.ℓstar))
    landedIrSchwinger T Z n (quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L s) -
      landedIrSchwinger T Z n ⟨[R]⟩ * landedIrSchwinger T Z n ⟨[L_s]⟩ =
    irCov ((T.chain n).state 0).gibbsMeasure
      (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩)
      (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_s]⟩) := by
  dsimp only
  set R := rectWithTimeFract T.ℓstar (1 / 4) ℓ_R
  set L_s := (rectWithTimeFract T.ℓstar (3 / 4) ℓ_L).translate (timeShift ((s : ℚ) * T.ℓstar))
  have h_ref : (⟨[R.timeReflect]⟩ : DisjointLoopFamily).reflect = ⟨[R]⟩ := by
    simp [DisjointLoopFamily.reflect, timeReflect_timeReflect]
  have h_app :
      (⟨[R.timeReflect]⟩ : DisjointLoopFamily).reflect.append ⟨[L_s]⟩ =
        quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L s := by
    rw [h_ref]
    rfl
  have h_cov :=
    landedIrSchwinger_reflect_append_sub_mul_eq_irCov T Z n ⟨[R.timeReflect]⟩ ⟨[L_s]⟩
  rw [h_app, h_ref] at h_cov
  exact h_cov

/-- **Stage 2 (Limit Chain):**
Under `hC : TwoCutoffComparison T Z`, for any pair of rectangles `ℓ_R, ℓ_L : PhysicalRectangle`
and every integer shift count `t : ℕ`, the landed IR covariance difference between `s = 0` and
`s = t` along `quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L` tends to `0` as `n → ∞`. -/
theorem TwoCutoffComparison.tendsto_irCov_quarterThreeQuarter_sub_zero
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) (ℓ_R ℓ_L : PhysicalRectangle) (t : ℕ) :
    let R := rectWithTimeFract T.ℓstar (1 / 4) ℓ_R
    let L_step := fun k : ℕ =>
      (rectWithTimeFract T.ℓstar (3 / 4) ℓ_L).translate (timeShift ((k : ℚ) * T.ℓstar))
    Tendsto (fun n =>
      irCov ((T.chain n).state 0).gibbsMeasure
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩)
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step 0]⟩) -
      irCov ((T.chain n).state 0).gibbsMeasure
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩)
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step t]⟩))
      atTop (𝓝 0) := by
  dsimp only
  set R := rectWithTimeFract T.ℓstar (1 / 4) ℓ_R
  set L_step := fun k : ℕ =>
    (rectWithTimeFract T.ℓstar (3 / 4) ℓ_L).translate (timeShift ((k : ℚ) * T.ℓstar))
  set G_step := fun k : ℕ => quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L k
  obtain ⟨S, hS⟩ := schwingerConverges_of_twoCutoffComparison hC
  have hL : ∀ F : DisjointLoopFamily,
      Tendsto (fun n => landedIrSchwinger T Z n F) atTop (𝓝 (S F)) :=
    landedIrSchwinger_tendsto_of_twoCutoffComparison hC hS
  have hR_dyad : IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ 2) R.base := by
    simpa [R] using isLatticeVector_quarter_rectWithTimeFract T.ℓstar 1 ℓ_R
  have hL_dyad (k : ℕ) : IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ 2) (L_step k).base := by
    refine isLatticeVector_quarter_translate_timeShift_nat_mul T.ℓstar k ?_
    simpa using isLatticeVector_quarter_rectWithTimeFract T.ℓstar 3 ℓ_L
  have hG_dyad (k : ℕ) :
      ∀ ℓ ∈ (G_step k).loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base := by
    intro ℓ hℓ
    simp only [G_step, quarterThreeQuarterPairFamily, List.mem_cons, List.not_mem_nil,
      or_false] at hℓ
    rcases hℓ with rfl | rfl
    · exact ⟨2, hR_dyad⟩
    · exact ⟨2, hL_dyad k⟩
  have hL_fam_dyad (k : ℕ) :
      ∀ ℓ ∈ (⟨[L_step k]⟩ : DisjointLoopFamily).loops,
        ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base := by
    intro ℓ hℓ
    rcases List.mem_singleton.mp hℓ with rfl
    exact ⟨2, hL_dyad k⟩
  have hS_G_step (k : ℕ) : S (G_step (k + 1)) = S (G_step k) := by
    have h_tr_eq :
        S ((G_step k).translate (timeShift (T.ℓstar / 2))) = S (G_step k) :=
      hC.continuumLimit_translate_eq_of_dyadic_base hS (G_step k) (hG_dyad k)
        (timeShift (T.ℓstar / 2))
    have h_landed_eq (n : ℕ) :
        landedIrSchwinger T Z n ((G_step k).translate (timeShift (T.ℓstar / 2))) =
          landedIrSchwinger T Z n (G_step (k + 1)) :=
      (landedIrSchwinger_translate_half_ellstar_quarterThreeQuarter_eq T Z ℓ_R ℓ_L k n).1
    have h_lim_eq :
        S ((G_step k).translate (timeShift (T.ℓstar / 2))) = S (G_step (k + 1)) :=
      tendsto_nhds_unique (hL ((G_step k).translate (timeShift (T.ℓstar / 2))))
        ((hL (G_step (k + 1))).congr fun n => (h_landed_eq n).symm)
    exact h_lim_eq.symm.trans h_tr_eq
  have hS_L_step (k : ℕ) : S ⟨[L_step (k + 1)]⟩ = S ⟨[L_step k]⟩ := by
    have h_tr_eq :
        S ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
          S ⟨[L_step k]⟩ :=
      hC.continuumLimit_translate_eq_of_dyadic_base hS ⟨[L_step k]⟩ (hL_fam_dyad k)
        (timeShift (T.ℓstar / 2))
    have h_landed_eq (n : ℕ) :
        landedIrSchwinger T Z n
            ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
          landedIrSchwinger T Z n ⟨[L_step (k + 1)]⟩ :=
      (landedIrSchwinger_translate_half_ellstar_quarterThreeQuarter_eq T Z ℓ_R ℓ_L k n).2.2
    have h_lim_eq :
        S ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
          S ⟨[L_step (k + 1)]⟩ :=
      tendsto_nhds_unique
        (hL ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))))
        ((hL ⟨[L_step (k + 1)]⟩).congr fun n => (h_landed_eq n).symm)
    exact h_lim_eq.symm.trans h_tr_eq
  have hS_G_eq : ∀ k : ℕ, S (G_step k) = S (G_step 0) := by
    intro k
    induction k with
    | zero => rfl
    | succ j ih => exact (hS_G_step j).trans ih
  have hS_L_eq : ∀ k : ℕ, S ⟨[L_step k]⟩ = S ⟨[L_step 0]⟩ := by
    intro k
    induction k with
    | zero => rfl
    | succ j ih => exact (hS_L_step j).trans ih
  have h_cov_tend (k : ℕ) :
      Tendsto (fun n =>
        irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step k]⟩))
        atTop (𝓝 (S (G_step k) - S ⟨[R]⟩ * S ⟨[L_step k]⟩)) := by
    have h_sub := (hL (G_step k)).sub ((hL ⟨[R]⟩).mul (hL ⟨[L_step k]⟩))
    exact h_sub.congr fun n =>
      landedIrSchwinger_quarterThreeQuarter_sub_mul_eq_irCov T Z ℓ_R ℓ_L k n
  have h_cov_t :
      Tendsto (fun n =>
        irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step t]⟩))
        atTop (𝓝 (S (G_step 0) - S ⟨[R]⟩ * S ⟨[L_step 0]⟩)) := by
    have h_lim_eq :
        S (G_step t) - S ⟨[R]⟩ * S ⟨[L_step t]⟩ =
          S (G_step 0) - S ⟨[R]⟩ * S ⟨[L_step 0]⟩ := by
      rw [hS_G_eq t, hS_L_eq t]
    rw [← h_lim_eq]
    exact h_cov_tend t
  have h_diff := (h_cov_tend 0).sub h_cov_t
  rw [sub_self] at h_diff
  exact h_diff

/-- Exact coarse-rounding agreement at spacing `T.ℓstar` between the quarter/three-quarter
representatives `(R, L_step 0, L_step t)` built from `(T.ℓ_probe.timeReflect, T.ℓ_probe)` and the
`h_floor` / `ir_cov_decay` probe observables for `F_probe = ⟨[T.ℓ_probe]⟩`. -/
theorem irLoopFamilyObservable_quarterThreeQuarter_eq_probe
    {P : ContinuumCutoffPath} (T : LandingTube P) (n t : ℕ) :
    let R := rectWithTimeFract T.ℓstar (1 / 4) T.ℓ_probe.timeReflect
    let L_step := fun k : ℕ =>
      (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe).translate (timeShift ((k : ℚ) * T.ℓstar))
    let F_probe : DisjointLoopFamily := ⟨[T.ℓ_probe]⟩
    irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩ =
      physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect ∧
    irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩ =
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F_probe.reflect ∧
    irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step 0]⟩ =
      physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe ∧
    irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step t]⟩ =
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
        (F_probe.translate (timeShift (t * T.ℓstar))) := by
  dsimp only
  set R := rectWithTimeFract T.ℓstar (1 / 4) T.ℓ_probe.timeReflect
  set L_step := fun k : ℕ =>
    (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe).translate (timeShift ((k : ℚ) * T.ℓstar))
  have hR_obs :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩ =
        physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect := by
    have hW :=
      physicalWilsonLoop_eq_of_latticeBase_and_latticeLoop_eq (T.irSide n) (T.ℓstar : ℝ)
        (rectWithTimeFract_latticeBase_eq (θ := 1 / 4) T.hℓstar (by norm_num) (by norm_num)
          T.ℓ_probe.timeReflect) rfl
    funext V
    simp only [irLoopFamilyObservable, List.map_cons, List.map_nil, List.prod_cons,
      List.prod_nil, mul_one]
    exact congrFun hW V
  have hR_ref :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[R]⟩ =
        irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
          (⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).reflect := by
    rw [hR_obs]
    funext V
    simp [irLoopFamilyObservable, DisjointLoopFamily.reflect]
  have hL0_base :
      (L_step 0).latticeBase (T.ℓstar : ℝ) = T.ℓ_probe.latticeBase (T.ℓstar : ℝ) := by
    funext i
    rw [latticeBase_translate_timeShift_nat_mul T.hℓstar 0
      (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe) i,
      rectWithTimeFract_latticeBase_eq T.hℓstar (by norm_num) (by norm_num) T.ℓ_probe]
    simp
  have hL0_obs :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step 0]⟩ =
        physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe := by
    have hW :=
      physicalWilsonLoop_eq_of_latticeBase_and_latticeLoop_eq (T.irSide n) (T.ℓstar : ℝ)
        hL0_base rfl
    funext V
    simp [irLoopFamilyObservable, hW]
  have hLt_base :
      (L_step t).latticeBase (T.ℓstar : ℝ) =
        (T.ℓ_probe.translate (timeShift (t * T.ℓstar))).latticeBase (T.ℓstar : ℝ) := by
    funext i
    rw [latticeBase_translate_timeShift_nat_mul T.hℓstar t
      (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe) i,
      latticeBase_translate_timeShift_nat_mul T.hℓstar t T.ℓ_probe i,
      rectWithTimeFract_latticeBase_eq T.hℓstar (by norm_num) (by norm_num) T.ℓ_probe]
  have hLt_obs :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[L_step t]⟩ =
        irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
          ((⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).translate (timeShift (t * T.ℓstar))) := by
    have hW :=
      physicalWilsonLoop_eq_of_latticeBase_and_latticeLoop_eq (T.irSide n) (T.ℓstar : ℝ)
        hLt_base rfl
    funext V
    simp [irLoopFamilyObservable, DisjointLoopFamily.translate, hW]
  exact ⟨hR_obs, hR_ref, hL0_obs, hLt_obs⟩

/-- Under `hC : TwoCutoffComparison T Z`, for every integer shift `t : ℕ`, the difference between
the `h_floor` probe covariance at `t = 0` and the time-shifted probe covariance at `t * T.ℓstar`
tends to `0` as `n → ∞`. -/
theorem TwoCutoffComparison.tendsto_irCov_probe_sub_timeShift_zero
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) (t : ℕ) :
    let F_probe : DisjointLoopFamily := ⟨[T.ℓ_probe]⟩
    Tendsto (fun n =>
      irCov ((T.chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe) -
      irCov ((T.chain n).state 0).gibbsMeasure
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F_probe.reflect)
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
          (F_probe.translate (timeShift (t * T.ℓstar)))))
      atTop (𝓝 0) := by
  dsimp only
  have h_tend :=
    hC.tendsto_irCov_quarterThreeQuarter_sub_zero T.ℓ_probe.timeReflect T.ℓ_probe t
  refine h_tend.congr fun n => ?_
  obtain ⟨hR_obs, hR_ref, hL0_obs, hLt_obs⟩ :=
    irLoopFamilyObservable_quarterThreeQuarter_eq_probe T n t
  rw [← hR_ref, hR_obs, hL0_obs, hLt_obs]

/-- Under `hC : TwoCutoffComparison T Z`, `T.h_floor` and Stage 2 force the time-shifted landed IR
probe covariance at `t * T.ℓstar` to remain bounded below by `T.c_floor / 2 > 0` eventually in `n`
for **every** `t : ℕ` (preventing spatial/temporal decay). -/
theorem TwoCutoffComparison.eventually_ge_irCov_timeShift_probe
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) (t : ℕ) :
    let F_probe : DisjointLoopFamily := ⟨[T.ℓ_probe]⟩
    ∀ᶠ n in atTop,
      T.c_floor / 2 ≤
        |irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F_probe.reflect)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
            (F_probe.translate (timeShift (t * T.ℓstar))))| := by
  dsimp only
  have h_half_pos : 0 < T.c_floor / 2 := half_pos T.hc_floor
  have h_diff :=
    (Metric.tendsto_nhds.mp (hC.tendsto_irCov_probe_sub_timeShift_zero t))
      (T.c_floor / 2) h_half_pos
  filter_upwards [T.h_floor, h_diff] with n hfl hd
  rw [Real.dist_eq, sub_zero] at hd
  have h_tri :=
    abs_sub_abs_le_abs_sub
      (irCov ((T.chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe))
      (irCov ((T.chain n).state 0).gibbsMeasure
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
          (⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).reflect)
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
          ((⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).translate (timeShift (t * T.ℓstar)))))
  linarith

/-- Direct `LandingTube`-level exponential IR covariance decay from `h_dobrushin_spatial_decay`
alone (without requiring `h_translate_defect` from `ObservableTransferAndSymmetryBridge`). -/
theorem LandingTube.ir_cov_decay_of_dobrushin_spatial_decay
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (h_dobrushin_spatial_decay :
      ∃ C_spatial : ℝ, 0 ≤ C_spatial ∧
        ∀ (t : ℕ), ∀ᶠ n in atTop,
          ∀ (e : Link (T.irSide n)) (S : Finset (Link (T.irSide n))),
            (∀ e' ∈ S, t ≤ linkTemporalDist e e') →
            (∑ e' ∈ S,
              dobrushinComparisonSeries
                (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e') ≤
              C_spatial * (landingTubeContraction T) ^ t)
    (F : DisjointLoopFamily) (hFpos : F.PositiveTime) :
    ∃ C_decay : ℝ, 0 ≤ C_decay ∧
      ∀ (t : ℕ), ∀ᶠ n in atTop,
        |irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
            (F.translate (timeShift (t * T.ℓstar))))| ≤
          C_decay * (landingTubeContraction T) ^ t := by
  obtain ⟨C_spatial, hC_spatial_nonneg, h_spatial⟩ := h_dobrushin_spatial_decay
  obtain ⟨hq0, _, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  set q := landingTubeContraction T
  set M_f : ℝ :=
    2 * (((F.reflect.loops.map (fun ℓ => (ℓ.latticeLoop (T.ℓstar : ℝ)).length)).sum : ℕ) : ℝ)
  have hMf_nonneg : 0 ≤ M_f := mul_nonneg (by norm_num) (Nat.cast_nonneg _)
  refine ⟨M_f * 2 * C_spatial,
    mul_nonneg (mul_nonneg hMf_nonneg (by norm_num)) hC_spatial_nonneg, fun t => ?_⟩
  filter_upwards [T.landed_gibbsMeasure_abs_irCov_le_dobrushinObservableComparison,
    T.eventually_loop_support_timeShift_sep hFpos t,
    h_spatial t] with n h_cov h_sep h_sp
  let f_obs := irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect
  let g_obs :=
    irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) (F.translate (timeShift (t * T.ℓstar)))
  let supp_f := physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ) F.reflect.loops
  let supp_g :=
    physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ)
      (F.translate (timeShift (t * T.ℓstar))).loops
  have hf_meas : Measurable f_obs :=
    (continuous_irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect).measurable
  have hg_meas : Measurable g_obs :=
    (continuous_irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
      (F.translate (timeShift (t * T.ℓstar)))).measurable
  have hf_bdd : ∀ V : GaugeConfig (T.irSide n), |f_obs V| ≤ 1 :=
    abs_irLoopFamilyObservable_le_one (T.irSide n) (T.ℓstar : ℝ) F.reflect
  have hg_bdd : ∀ V : GaugeConfig (T.irSide n), |g_obs V| ≤ 1 :=
    abs_irLoopFamilyObservable_le_one (T.irSide n) (T.ℓstar : ℝ)
      (F.translate (timeShift (t * T.ℓstar)))
  have h_cov_fg := h_cov f_obs g_obs hf_meas hf_bdd hg_meas hg_bdd
  have h_dob :=
    dobrushinObservableComparison_le_of_series_bound
      SU2 (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      (M_g := 2) (B_series := C_spatial * q ^ t) (by norm_num)
      (dobrushinSupMatrix_nonneg SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      f_obs g_obs supp_f supp_g
      (fun e he =>
        linkOscillation_irLoopFamilyObservable_eq_zero_of_not_mem (T.ℓstar : ℝ) F.reflect he)
      (fun e' he' =>
        linkOscillation_irLoopFamilyObservable_eq_zero_of_not_mem (T.ℓstar : ℝ)
          (F.translate (timeShift (t * T.ℓstar))) he')
      (fun e' _ =>
        linkOscillation_irLoopFamilyObservable_le_two (T.irSide n) (T.ℓstar : ℝ)
          (F.translate (timeShift (t * T.ℓstar))) e')
      (fun e he => h_sp e supp_g fun e' he' => (h_sep e he e' he').1)
  have hf_sum :
      ∑ e ∈ supp_f, linkOscillation SU2 (T.irSide n) f_obs e ≤ M_f :=
    sum_linkOscillation_irLoopFamilyObservable_le (T.irSide n) (T.ℓstar : ℝ) F.reflect
  have hB_nonneg : 0 ≤ C_spatial * q ^ t :=
    mul_nonneg hC_spatial_nonneg (pow_nonneg hq0.le t)
  have h_prod_le :
      (∑ e ∈ supp_f, linkOscillation SU2 (T.irSide n) f_obs e) * 2 * (C_spatial * q ^ t) ≤
        (M_f * 2 * C_spatial) * q ^ t := by
    calc
      (∑ e ∈ supp_f, linkOscillation SU2 (T.irSide n) f_obs e) * 2 * (C_spatial * q ^ t)
        ≤ M_f * 2 * (C_spatial * q ^ t) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right hf_sum (by norm_num)) hB_nonneg
      _ = (M_f * 2 * C_spatial) * q ^ t := by ring
  linarith

/-- **Stage 3 (Refutation of `TwoCutoffComparison` from `h_floor` and Exponential IR Covariance Decay):**
No `T : LandingTube P` and `Z : LoopRenormalization P.toCutoffPath` can satisfy `TwoCutoffComparison T Z`
if the landed IR covariance on `F_probe = ⟨[T.ℓ_probe]⟩` decays exponentially in `t`. -/
theorem not_twoCutoffComparison_of_irCov_decay
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (h_decay :
      let F_probe : DisjointLoopFamily := ⟨[T.ℓ_probe]⟩
      ∃ C_decay : ℝ, 0 ≤ C_decay ∧
        ∀ (t : ℕ), ∀ᶠ n in atTop,
          |irCov ((T.chain n).state 0).gibbsMeasure
            (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F_probe.reflect)
            (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
              (F_probe.translate (timeShift (t * T.ℓstar))))| ≤
            C_decay * (landingTubeContraction T) ^ t) :
    ¬ TwoCutoffComparison T Z := by
  intro hC
  obtain ⟨C_decay, _, h_dec⟩ := h_decay
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  have h_half_pos : 0 < T.c_floor / 2 := half_pos T.hc_floor
  have h_geom : Tendsto (fun t : ℕ => C_decay * (landingTubeContraction T) ^ t) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds (x := C_decay)).mul
      (tendsto_pow_atTop_nhds_zero_of_lt_one hq0.le hq1)
  obtain ⟨t, ht⟩ := (h_geom.eventually (Iio_mem_nhds h_half_pos)).exists
  obtain ⟨n, h_lo, h_hi⟩ :=
    ((hC.eventually_ge_irCov_timeShift_probe t).and (h_dec t)).exists
  have ht' : C_decay * (landingTubeContraction T) ^ t < T.c_floor / 2 := ht
  linarith

/-- **Refutation of `TwoCutoffComparison` from `h_dobrushin_spatial_decay`:**
No `T : LandingTube P` satisfying the Dobrushin spatial decay bound along `linkTemporalDist` can
satisfy `TwoCutoffComparison T Z` for any `Z`. -/
theorem not_twoCutoffComparison_of_dobrushin_spatial_decay
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (h_dobrushin_spatial_decay :
      ∃ C_spatial : ℝ, 0 ≤ C_spatial ∧
        ∀ (t : ℕ), ∀ᶠ n in atTop,
          ∀ (e : Link (T.irSide n)) (S : Finset (Link (T.irSide n))),
            (∀ e' ∈ S, t ≤ linkTemporalDist e e') →
            (∑ e' ∈ S,
              dobrushinComparisonSeries
                (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e') ≤
              C_spatial * (landingTubeContraction T) ^ t) :
    ¬ TwoCutoffComparison T Z := by
  have h_probe_pos : (⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).PositiveTime := by
    intro ℓ hℓ
    rcases List.mem_singleton.mp hℓ with rfl
    exact T.hℓ_probe_pos
  exact not_twoCutoffComparison_of_irCov_decay T Z
    (T.ir_cov_decay_of_dobrushin_spatial_decay h_dobrushin_spatial_decay ⟨[T.ℓ_probe]⟩ h_probe_pos)

/-- **Refutation of `TwoCutoffComparison` under `ObservableTransferAndSymmetryBridge`:**
The hypotheses `(hC : TwoCutoffComparison T Z)` and `(hTrans : ObservableTransferAndSymmetryBridge T Z)`
of `qymSchwingerGap_of_landingTube` are mutually inconsistent (`¬ TwoCutoffComparison T Z`). -/
theorem not_twoCutoffComparison_of_observableTransferAndSymmetryBridge
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (hTrans : ObservableTransferAndSymmetryBridge T Z) :
    ¬ TwoCutoffComparison T Z :=
  not_twoCutoffComparison_of_dobrushin_spatial_decay T Z hTrans.h_dobrushin_spatial_decay

/-- **Refutation of `TwoCutoffComparison` under `ExponentialRemainderLocalityBound`:**
No `T : LandingTube P` carrying `ExponentialRemainderLocalityBound T` can satisfy
`TwoCutoffComparison T Z` for any `Z`. -/
theorem not_twoCutoffComparison_of_exponentialRemainderLocality
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (hLoc : ExponentialRemainderLocalityBound T) :
    ¬ TwoCutoffComparison T Z :=
  not_twoCutoffComparison_of_dobrushin_spatial_decay T Z
    (T.dobrushin_spatial_decay_of_exponentialRemainderLocality hLoc)

/-- **Refutation of `TwoCutoffComparison` for `BalabanMultiScaleUVToIRFlow`:**
Takes `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`). The refutation uses the
floor (`(M.toLandingTube hF).h_floor` comes from `hF`): for every `M : BalabanMultiScaleUVToIRFlow P`,
`hF : M.WilsonCharFloor`, and `Z : LoopRenormalization P.toCutoffPath`,
`¬ TwoCutoffComparison (M.toLandingTube hF) Z`, because `M.toExponentialRemainderLocalityBound hF` forces
exponential IR covariance decay while `(M.toLandingTube hF).h_floor` and `TwoCutoffComparison` force the
shifted IR covariance to remain bounded below by `(M.toLandingTube hF).c_floor / 2 > 0`. Thus the
hypotheses of `qymSchwingerGap_of_balabanMultiScaleFlow_and_five_gaps` and
`qymSchwingerGap_of_balabanMultiScaleFlow_and_commensurate_cutoff` are mutually inconsistent. -/
theorem not_twoCutoffComparison_of_balabanMultiScaleUVToIRFlow
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (hF : M.WilsonCharFloor)
    (Z : LoopRenormalization P.toCutoffPath) :
    ¬ TwoCutoffComparison (M.toLandingTube hF) Z :=
  not_twoCutoffComparison_of_exponentialRemainderLocality (M.toLandingTube hF) Z
    (M.toExponentialRemainderLocalityBound hF)

/-! ### Stage 0.1: Admissible Half-Offset Loop Families (`RectOnGrid`, `rectLinksZ4`, `IsAdmissible`) -/

/-- No quarter/three-quarter shift-refutation family `quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L s`
is admissible with respect to `halfOffset`, because the first loop has time fraction `1 / 4 ≠ 1 / 2 (mod 1)`. -/
theorem not_isAdmissible_quarterThreeQuarterPairFamily
    {P : ContinuumCutoffPath} (T : LandingTube P) (ℓ_R ℓ_L : PhysicalRectangle) (s : ℕ) :
    ¬ (quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L s).IsAdmissible T.ℓstar halfOffset := by
  rintro ⟨hgrid, _, _⟩
  have hR_mem :
      rectWithTimeFract T.ℓstar (1 / 4) ℓ_R ∈
        (quarterThreeQuarterPairFamily T.ℓstar ℓ_R ℓ_L s).loops := by
    simp [quarterThreeQuarterPairFamily]
  obtain ⟨k, hk⟩ := (hgrid _ hR_mem).1 0
  unfold rectWithTimeFract halfOffset at hk
  dsimp only [↓reduceIte] at hk
  have ha_ne : T.ℓstar ≠ 0 := T.hℓstar.ne'
  have h_eq : (ℓ_R.latticeBase (T.ℓstar : ℝ) 0 : ℚ) + 1 / 4 = (k : ℚ) + 1 / 2 :=
    mul_right_cancel₀ ha_ne hk
  have h_four :
      (4 * ℓ_R.latticeBase (T.ℓstar : ℝ) 0 + 1 : ℚ) = (4 * k + 2 : ℚ) := by
    linarith
  have h_int : 4 * ℓ_R.latticeBase (T.ℓstar : ℝ) 0 + 1 = 4 * k + 2 := by
    exact_mod_cast h_four
  omega

/-! ### Stage 1A (Option A): `AlignedTwoCutoffComparison`, Admissibility-Preserving Shifts (A2–A3), and Pure-Decimation Degeneracy (A4) -/

/-- Option A (`AlignedTwoCutoffComparison T Z`): restricts two-cutoff comparison to loop families
`F` that are admissible on the half-offset coarse grid `(T.ℓstar, halfOffset)`
(`F.IsAdmissible T.ℓstar halfOffset`), requiring summable adjacent-cutoff landed increments and
vanishing dressing defect `renormalizedSchwinger Z n F - landedIrSchwinger T Z n F → 0`.
See `AlignedTwoCutoffComparison.tendsto_familyFactor_sub_one_mul_raw` (A4) for the mandatory
pure-decimation degeneracy theorem showing that for every admissible `F`,
`landedIrSchwinger T Z n F = rawSchwinger P.toCutoffPath n F` eventually in `n`. -/
structure AlignedTwoCutoffComparison {P : ContinuumCutoffPath}
    (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath) : Prop where
  hZ_eq : Z = T.Z_tube
  h_landed_cauchy :
    ∀ F : DisjointLoopFamily, F.IsAdmissible T.ℓstar halfOffset →
      Summable (fun n => dist (landedIrSchwinger T Z n F) (landedIrSchwinger T Z (n + 1) F))
  h_dressing_defect_tendsto_zero :
    ∀ F : DisjointLoopFamily, F.IsAdmissible T.ℓstar halfOffset →
      Tendsto (fun n => renormalizedSchwinger Z n F - landedIrSchwinger T Z n F) atTop (𝓝 0)

/-- Under `AlignedTwoCutoffComparison T Z`, every admissible family `F` has a convergent landed
IR sequence `landedIrSchwinger T Z n F → S F` and a convergent renormalized UV sequence
`renormalizedSchwinger Z n F → S F` with the same limit `S F`. -/
theorem AlignedTwoCutoffComparison.exists_tendsto_of_isAdmissible
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hA : AlignedTwoCutoffComparison T Z) {F : DisjointLoopFamily}
    (hF : F.IsAdmissible T.ℓstar halfOffset) :
    ∃ s_lim : ℝ,
      Tendsto (fun n => landedIrSchwinger T Z n F) atTop (𝓝 s_lim) ∧
      Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 s_lim) := by
  have h_cauchy : CauchySeq (fun n => landedIrSchwinger T Z n F) :=
    cauchySeq_of_dist_le_of_summable _ (fun _ => le_rfl) (hA.h_landed_cauchy F hF)
  obtain ⟨s_lim, hs_lim⟩ := cauchySeq_tendsto_of_complete h_cauchy
  have h_ren : Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 s_lim) := by
    have h_add := (hA.h_dressing_defect_tendsto_zero F hF).add hs_lim
    rw [zero_add] at h_add
    exact h_add.congr (fun n => by ring)
  exact ⟨s_lim, hs_lim, h_ren⟩

/-- **A2 (Coordinate Shift Characterization):**
If both `ℓ` and `ℓ.translate c` lie on the `(a, θ)` grid (`RectOnGrid a θ`), then every coordinate
`c i` is an integer multiple of `a`. -/
theorem isLatticeVector_of_rectOnGrid_translate {a : ℚ} {θ c : Fin 4 → ℚ} {ℓ : PhysicalRectangle}
    (h1 : RectOnGrid a θ ℓ) (h2 : RectOnGrid a θ (ℓ.translate c)) :
    ∀ i : Fin 4, ∃ k : ℤ, c i = (k : ℚ) * a := by
  intro i
  obtain ⟨k₁, hk₁⟩ := h1.1 i
  obtain ⟨k₂, hk₂⟩ := h2.1 i
  change ℓ.base i + c i = ((k₂ : ℚ) + θ i) * a at hk₂
  refine ⟨k₂ - k₁, ?_⟩
  push_cast
  linarith

/-- **A2 (Family Shift Characterization):**
If a non-empty family `F` (`F.loops ≠ []`) and its translate `F.translate c` are both admissible
on `(a, θ)`, then `c` is an integer multiple of `a` in every coordinate (`∃ k : Fin 4 → ℤ, c = fun i => (k i : ℚ) * a`
and `IsLatticeVector (a : ℝ) c`). -/
theorem isLatticeVector_of_isAdmissible_translate {a : ℚ} {θ c : Fin 4 → ℚ}
    {F : DisjointLoopFamily} (hne : F.loops ≠ [])
    (h1 : F.IsAdmissible a θ) (h2 : (F.translate c).IsAdmissible a θ) :
    (∃ k : Fin 4 → ℤ, c = fun i => (k i : ℚ) * a) ∧ IsLatticeVector (a : ℝ) c := by
  cases hF : F.loops with
  | nil => exact False.elim (hne hF)
  | cons ℓ ℓs =>
    have hℓ_mem : ℓ ∈ F.loops := by simp [hF]
    have hℓ_tr_mem : ℓ.translate c ∈ (F.translate c).loops :=
      List.mem_map_of_mem hℓ_mem
    have h_coord := isLatticeVector_of_rectOnGrid_translate (h1.1 ℓ hℓ_mem) (h2.1 _ hℓ_tr_mem)
    choose k hk using h_coord
    refine ⟨⟨k, funext hk⟩, fun i => ⟨k i, ?_⟩⟩
    exact_mod_cast hk i

/-- **A2 (Uniform Coarse-Base Shift under `a · ℤ⁴`):**
Translating any physical rectangle `ℓ` by `fun i => (k i : ℚ) * a` (`k : Fin 4 → ℤ`, `0 < a`)
shifts `ℓ.latticeBase (a : ℝ)` by `+ k` independent of `ℓ`. -/
theorem latticeBase_translate_of_intMul {a : ℚ} (ha : 0 < a) (k : Fin 4 → ℤ)
    (ℓ : PhysicalRectangle) :
    (ℓ.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) = ℓ.latticeBase (a : ℝ) + k := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  funext i
  unfold PhysicalRectangle.latticeBase PhysicalRectangle.translate
  dsimp only [Pi.add_apply]
  have h_div : (((ℓ.base i + (k i : ℚ) * a : ℚ) : ℝ)) / (a : ℝ) =
      (ℓ.base i : ℝ) / (a : ℝ) + (k i : ℝ) := by
    push_cast
    field_simp [ha_real.ne']
  rw [h_div, Int.floor_add_intCast]

/-- **A2 (Relative Coarse-Offset Invariance):**
Under any `a · ℤ⁴` translation `fun i => (k i : ℚ) * a` (`0 < a`), the relative coarse lattice
base offset between any two rectangles `ℓ₁, ℓ₂` is unchanged. -/
theorem relative_latticeBase_translate_intMul_eq {a : ℚ} (ha : 0 < a) (k : Fin 4 → ℤ)
    (ℓ₁ ℓ₂ : PhysicalRectangle) :
    (ℓ₁.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) -
        (ℓ₂.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) =
      ℓ₁.latticeBase (a : ℝ) - ℓ₂.latticeBase (a : ℝ) := by
  rw [latticeBase_translate_of_intMul ha k ℓ₁, latticeBase_translate_of_intMul ha k ℓ₂]
  abel

theorem PhysicalRectangle.translate_injective (c : Fin 4 → ℚ) :
    Function.Injective (fun ℓ : PhysicalRectangle => ℓ.translate c) := by
  rintro ⟨b₁, μ₁, ν₁, h₁, R₁, T₁, hR₁, hT₁⟩ ⟨b₂, μ₂, ν₂, h₂, R₂, T₂, hR₂, hT₂⟩ hEq
  dsimp [PhysicalRectangle.translate] at hEq
  injection hEq with hb hμ hν hR hT
  subst hμ; subst hν; subst hR; subst hT
  have hb_eq : b₁ = b₂ := by
    funext i
    have hi := congrFun hb i
    dsimp at hi
    linarith
  subst hb_eq
  rfl

/-- `RectOnGrid a θ` is preserved by any `a · ℤ⁴` shift `fun i => (k i : ℚ) * a`. -/
theorem rectOnGrid_translate_intMul {a : ℚ} {θ : Fin 4 → ℚ} (k : Fin 4 → ℤ)
    {ℓ : PhysicalRectangle} (h : RectOnGrid a θ ℓ) :
    RectOnGrid a θ (ℓ.translate (fun i => (k i : ℚ) * a)) := by
  refine ⟨fun i => ?_, h.2.1, h.2.2⟩
  obtain ⟨m, hm⟩ := h.1 i
  refine ⟨m + k i, ?_⟩
  change ℓ.base i + (k i : ℚ) * a = (((m + k i : ℤ) : ℚ) + θ i) * a
  rw [hm]
  push_cast
  ring

/-- Under `fun i => (k i : ℚ) * a` (`0 < a`), the coarse link set `rectLinksZ4 a` shifts by `+ k`. -/
theorem mem_rectLinksZ4_translate_intMul {a : ℚ} (ha : 0 < a) (k : Fin 4 → ℤ)
    (ℓ : PhysicalRectangle) (e : (Fin 4 → ℤ) × Direction) :
    e ∈ rectLinksZ4 a (ℓ.translate (fun i => (k i : ℚ) * a)) ↔
      (e.1 - k, e.2) ∈ rectLinksZ4 a ℓ := by
  have h_base :
      (ℓ.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) =
        ℓ.latticeBase (a : ℝ) + k :=
    latticeBase_translate_of_intMul ha k ℓ
  change (∃ i < ℓ.stepsμ (a : ℝ),
      e = ((ℓ.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) + (i : ℤ) • z4UnitVec ℓ.μ, ℓ.μ)) ∨
    (∃ i < ℓ.stepsμ (a : ℝ),
      e = ((ℓ.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) +
        (ℓ.stepsν (a : ℝ) : ℤ) • z4UnitVec ℓ.ν + (i : ℤ) • z4UnitVec ℓ.μ, ℓ.μ)) ∨
    (∃ j < ℓ.stepsν (a : ℝ),
      e = ((ℓ.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) + (j : ℤ) • z4UnitVec ℓ.ν, ℓ.ν)) ∨
    (∃ j < ℓ.stepsν (a : ℝ),
      e = ((ℓ.translate (fun i => (k i : ℚ) * a)).latticeBase (a : ℝ) +
        (ℓ.stepsμ (a : ℝ) : ℤ) • z4UnitVec ℓ.μ + (j : ℤ) • z4UnitVec ℓ.ν, ℓ.ν)) ↔
    (∃ i < ℓ.stepsμ (a : ℝ),
      (e.1 - k, e.2) = (ℓ.latticeBase (a : ℝ) + (i : ℤ) • z4UnitVec ℓ.μ, ℓ.μ)) ∨
    (∃ i < ℓ.stepsμ (a : ℝ),
      (e.1 - k, e.2) = (ℓ.latticeBase (a : ℝ) +
        (ℓ.stepsν (a : ℝ) : ℤ) • z4UnitVec ℓ.ν + (i : ℤ) • z4UnitVec ℓ.μ, ℓ.μ)) ∨
    (∃ j < ℓ.stepsν (a : ℝ),
      (e.1 - k, e.2) = (ℓ.latticeBase (a : ℝ) + (j : ℤ) • z4UnitVec ℓ.ν, ℓ.ν)) ∨
    (∃ j < ℓ.stepsν (a : ℝ),
      (e.1 - k, e.2) = (ℓ.latticeBase (a : ℝ) +
        (ℓ.stepsμ (a : ℝ) : ℤ) • z4UnitVec ℓ.μ + (j : ℤ) • z4UnitVec ℓ.ν, ℓ.ν))
  rw [h_base]
  have h_eq (v : Fin 4 → ℤ) (μ : Direction) :
      e = (v + k, μ) ↔ (e.1 - k, e.2) = (v, μ) := by
    rcases e with ⟨x, d⟩
    simp only [Prod.mk.injEq, sub_eq_iff_eq_add]
  have h_assoc (u w : Fin 4 → ℤ) : u + k + w = (u + w) + k := by abel
  simp only [h_assoc, h_eq]

theorem disjoint_rectLinksZ4_translate_intMul {a : ℚ} (ha : 0 < a) (k : Fin 4 → ℤ)
    {ℓ₁ ℓ₂ : PhysicalRectangle} (h : Disjoint (rectLinksZ4 a ℓ₁) (rectLinksZ4 a ℓ₂)) :
    Disjoint (rectLinksZ4 a (ℓ₁.translate (fun i => (k i : ℚ) * a)))
      (rectLinksZ4 a (ℓ₂.translate (fun i => (k i : ℚ) * a))) := by
  rw [Set.disjoint_left] at h ⊢
  intro e he₁ he₂
  rw [mem_rectLinksZ4_translate_intMul ha k ℓ₁] at he₁
  rw [mem_rectLinksZ4_translate_intMul ha k ℓ₂] at he₂
  exact h he₁ he₂

/-- **A3 (Closure of Admissible Class under `a · ℤ⁴` Translations):**
If `F.IsAdmissible a θ` (`0 < a`), then `(F.translate (fun i => (k i : ℚ) * a)).IsAdmissible a θ`
for every integer lattice vector `k : Fin 4 → ℤ`. -/
theorem isAdmissible_translate_intMul {a : ℚ} (ha : 0 < a) (θ : Fin 4 → ℚ) (k : Fin 4 → ℤ)
    {F : DisjointLoopFamily} (hF : F.IsAdmissible a θ) :
    (F.translate (fun i => (k i : ℚ) * a)).IsAdmissible a θ := by
  refine ⟨?_, ?_, ?_⟩
  · intro ℓ' hℓ'
    simp only [DisjointLoopFamily.translate, List.mem_map] at hℓ'
    obtain ⟨ℓ, hℓ, rfl⟩ := hℓ'
    exact rectOnGrid_translate_intMul k (hF.1 ℓ hℓ)
  · exact hF.2.1.map (PhysicalRectangle.translate_injective _)
  · exact hF.2.2.map _ (fun ℓ₁ ℓ₂ hdisj => disjoint_rectLinksZ4_translate_intMul ha k hdisj)

/-- Doubling an integer mod `L` (`z = (m : ZMod L)`) via `((2 * z.val : ℕ) : ZMod (2 * L))`
equals `((2 * m : ℤ) : ZMod (2 * L))` in `ZMod (2 * L)`. -/
theorem zmod_two_mul_val_eq_intCast (L : ℕ) [NeZero L] (z : ZMod L) (m : ℤ)
    (hz : z = (m : ZMod L)) :
    ((2 * z.val : ℕ) : ZMod (2 * L)) = ((2 * m : ℤ) : ZMod (2 * L)) := by
  have h_val : (z.val : ℤ) = m % (L : ℤ) := by
    rw [hz, ZMod.val_intCast]
  have h_div : m % (L : ℤ) + (L : ℤ) * (m / (L : ℤ)) = m := Int.emod_add_mul_ediv m (L : ℤ)
  have h_2m : (2 * m : ℤ) = ((2 * z.val : ℕ) : ℤ) + ((2 * L : ℕ) : ℤ) * (m / (L : ℤ)) := by
    push_cast
    linarith
  have h_cast := congrArg (Int.cast : ℤ → ZMod (2 * L)) h_2m
  simp only [Int.cast_add, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, zero_mul,
    add_zero] at h_cast
  simpa using h_cast.symm

/-- Canonical site embedding `x ↦ 2x` from the coarse torus `Lattice4D L` into the fine torus
`Lattice4D (2 * L)` used by `dyadicLinkBlockMap L`. -/
def dyadicEmbedSite (L : ℕ) (x : Lattice4D L) : Lattice4D (2 * L) :=
  fun i => ((2 * (x i).val : ℕ) : ZMod (2 * L))

theorem dyadicEmbedSite_add (L : ℕ) [NeZero L] (x y : Lattice4D L) :
    dyadicEmbedSite L (x + y) = dyadicEmbedSite L x + dyadicEmbedSite L y := by
  funext i
  dsimp [dyadicEmbedSite]
  have hxy : x i + y i = (((x i).val + (y i).val : ℤ) : ZMod L) := by
    push_cast
    rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
  have h := zmod_two_mul_val_eq_intCast L (x i + y i) ((x i).val + (y i).val) hxy
  rw [h]
  push_cast
  ring

theorem dyadicEmbedSite_sub (L : ℕ) [NeZero L] (x y : Lattice4D L) :
    dyadicEmbedSite L (x - y) = dyadicEmbedSite L x - dyadicEmbedSite L y := by
  funext i
  dsimp [dyadicEmbedSite]
  have hxy : x i - y i = (((x i).val - (y i).val : ℤ) : ZMod L) := by
    push_cast
    rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
  have h := zmod_two_mul_val_eq_intCast L (x i - y i) ((x i).val - (y i).val) hxy
  rw [h]
  push_cast
  ring

theorem dyadicEmbedSite_unitVec (L : ℕ) [NeZero L] (μ : Direction) :
    dyadicEmbedSite L (unitVec L μ) = unitVec (2 * L) μ + unitVec (2 * L) μ := by
  funext i
  dsimp [dyadicEmbedSite, unitVec]
  by_cases h : i = μ
  · subst h
    simp only [↓reduceIte]
    have h1 := zmod_two_mul_val_eq_intCast L (1 : ZMod L) 1 (by simp)
    simpa [one_add_one_eq_two] using h1
  · simp [h]

theorem dyadicEmbedSite_latticeSite (L : ℕ) [NeZero L] (b : Fin 4 → ℤ) :
    dyadicEmbedSite L (latticeSite L b) = latticeSite (2 * L) ((2 : ℤ) • b) := by
  funext i
  dsimp [dyadicEmbedSite, latticeSite]
  exact zmod_two_mul_val_eq_intCast L (b i : ZMod L) (b i) rfl

/-- Doubling every oriented step in a lattice path (`s ↦ [s, s]`). -/
def doublePath : List LatticeStep → List LatticeStep
  | [] => []
  | s :: p => s :: s :: doublePath p

@[simp]
theorem doublePath_nil : doublePath [] = [] := rfl

@[simp]
theorem doublePath_cons (s : LatticeStep) (p : List LatticeStep) :
    doublePath (s :: p) = s :: s :: doublePath p := rfl

theorem doublePath_append (p q : List LatticeStep) :
    doublePath (p ++ q) = doublePath p ++ doublePath q := by
  induction p with
  | nil => rfl
  | cons s p ih => simp [ih]

theorem doublePath_replicate (r : ℕ) (s : LatticeStep) :
    doublePath (List.replicate r s) = List.replicate (2 * r) s := by
  induction r with
  | zero => rfl
  | succ r ih =>
    have h2 : 2 * (r + 1) = (2 * r) + 1 + 1 := by omega
    rw [List.replicate_succ, doublePath_cons, ih, h2, List.replicate_succ, List.replicate_succ]

theorem doublePath_rectangleSteps (μ ν : Direction) (r t : ℕ) :
    doublePath (rectangleSteps μ ν r t) = rectangleSteps μ ν (2 * r) (2 * t) := by
  unfold rectangleSteps
  simp only [doublePath_append, doublePath_replicate]

theorem dyadicEmbedSite_stepTarget (L : ℕ) [NeZero L] (x : Lattice4D L) (s : LatticeStep) :
    dyadicEmbedSite L (stepTarget x s) =
      stepTarget (stepTarget (dyadicEmbedSite L x) s) s := by
  rcases s with ⟨μ, _ | _⟩
  · change dyadicEmbedSite L (x + -unitVec L μ) =
      dyadicEmbedSite L x + -unitVec (2 * L) μ + -unitVec (2 * L) μ
    rw [← sub_eq_add_neg, dyadicEmbedSite_sub, dyadicEmbedSite_unitVec]
    abel
  · change dyadicEmbedSite L (x + unitVec L μ) =
      dyadicEmbedSite L x + unitVec (2 * L) μ + unitVec (2 * L) μ
    rw [dyadicEmbedSite_add, dyadicEmbedSite_unitVec, add_assoc]

theorem stepHolonomy_dyadicLinkBlockMap (L : ℕ) [NeZero L]
    (U : GaugeConfig (2 * L)) (x : Lattice4D L) (s : LatticeStep) :
    stepHolonomy (dyadicLinkBlockMap L U) x s =
      stepHolonomy U (dyadicEmbedSite L x) s *
        stepHolonomy U (stepTarget (dyadicEmbedSite L x) s) s := by
  rcases s with ⟨μ, _ | _⟩
  · dsimp only [stepHolonomy, stepTarget, LatticeStep.displacement_backward, dyadicLinkBlockMap]
    change (U ⟨dyadicEmbedSite L (x - unitVec L μ), μ⟩ *
      U ⟨shift (dyadicEmbedSite L (x - unitVec L μ)) μ, μ⟩)⁻¹ =
      (U ⟨dyadicEmbedSite L x - unitVec (2 * L) μ, μ⟩)⁻¹ *
        (U ⟨dyadicEmbedSite L x + -unitVec (2 * L) μ - unitVec (2 * L) μ, μ⟩)⁻¹
    rw [mul_inv_rev]
    have h1 : dyadicEmbedSite L (x - unitVec L μ) =
        dyadicEmbedSite L x + -unitVec (2 * L) μ - unitVec (2 * L) μ := by
      rw [dyadicEmbedSite_sub, dyadicEmbedSite_unitVec]
      abel
    have h2 : shift (dyadicEmbedSite L (x - unitVec L μ)) μ =
        dyadicEmbedSite L x - unitVec (2 * L) μ := by
      change dyadicEmbedSite L (x - unitVec L μ) + unitVec (2 * L) μ = _
      rw [h1]
      abel
    rw [h2, h1]
  · rfl

theorem pathHolonomy_dyadicLinkBlockMap (L : ℕ) [NeZero L]
    (U : GaugeConfig (2 * L)) (x : Lattice4D L) (p : List LatticeStep) :
    pathHolonomy (dyadicLinkBlockMap L U) x p =
      pathHolonomy U (dyadicEmbedSite L x) (doublePath p) := by
  induction p generalizing x with
  | nil => rfl
  | cons s p ih =>
    simp only [pathHolonomy_cons, doublePath_cons, stepHolonomy_dyadicLinkBlockMap,
      ih (stepTarget x s), dyadicEmbedSite_stepTarget, mul_assoc]

/-- **A4 (Single-Step Pure-Decimation Wilson Loop Identity):**
Under the 2-step link-product decimation map `dyadicLinkBlockMap L`, a coarse rectangular Wilson
loop at `x : Lattice4D L` with `(r, s)` steps is identically equal to the fine rectangular Wilson
loop at `dyadicEmbedSite L x` (`2 • x`) with `(2 * r, 2 * s)` steps. -/
theorem wilsonLoop_dyadicLinkBlockMap (L : ℕ) [NeZero L]
    (U : GaugeConfig (2 * L)) (x : Lattice4D L) (μ ν : Direction) (r s : ℕ) :
    wilsonLoop (dyadicLinkBlockMap L U) x (rectangleSteps μ ν r s) =
      wilsonLoop U (dyadicEmbedSite L x) (rectangleSteps μ ν (2 * r) (2 * s)) := by
  unfold wilsonLoop
  rw [pathHolonomy_dyadicLinkBlockMap, doublePath_rectangleSteps]

/-- Iterated `m`-step pure-decimation Wilson loop identity for `iteratedDyadicLinkBlockMapToIR`:
evaluating a coarse rectangular Wilson loop at `latticeSite L_ir b` with `(r, s)` steps on
`iteratedDyadicLinkBlockMapToIR L_ir m U` equals the fine rectangular Wilson loop at
`latticeSite (dyadicScaleSide L_ir m) ((2 ^ m : ℤ) • b)` with `(2 ^ m * r, 2 ^ m * s)` steps on `U`. -/
theorem wilsonLoop_iteratedDyadicLinkBlockMapToIR (L_ir : ℕ) [NeZero L_ir] :
    ∀ (m : ℕ) (U : GaugeConfig (dyadicScaleSide L_ir m))
      (b : Fin 4 → ℤ) (μ ν : Direction) (r s : ℕ),
      wilsonLoop (iteratedDyadicLinkBlockMapToIR L_ir m U) (latticeSite L_ir b)
          (rectangleSteps μ ν r s) =
        wilsonLoop U (latticeSite (dyadicScaleSide L_ir m) ((2 ^ m : ℤ) • b))
          (rectangleSteps μ ν (2 ^ m * r) (2 ^ m * s))
  | 0, U, b, μ, ν, r, s => by
      simp [iteratedDyadicLinkBlockMapToIR, dyadicScaleSide]
  | m + 1, U, b, μ, ν, r, s => by
      change wilsonLoop
          (iteratedDyadicLinkBlockMapToIR L_ir m (dyadicLinkBlockMap (dyadicScaleSide L_ir m) U))
          (latticeSite L_ir b) (rectangleSteps μ ν r s) = _
      rw [wilsonLoop_iteratedDyadicLinkBlockMapToIR L_ir m
        (dyadicLinkBlockMap (dyadicScaleSide L_ir m) U) b μ ν r s]
      rw [wilsonLoop_dyadicLinkBlockMap (dyadicScaleSide L_ir m) U
        (latticeSite (dyadicScaleSide L_ir m) ((2 ^ m : ℤ) • b)) μ ν (2 ^ m * r) (2 ^ m * s)]
      rw [dyadicEmbedSite_latticeSite (dyadicScaleSide L_ir m) ((2 ^ m : ℤ) • b)]
      have h_smul : (2 : ℤ) • ((2 ^ m : ℤ) • b) = (2 ^ (m + 1) : ℤ) • b := by
        rw [smul_smul, pow_succ', Int.mul_comm]
      have h_r : 2 * (2 ^ m * r) = 2 ^ (m + 1) * r := by
        rw [pow_succ', Nat.mul_assoc]
      have h_s : 2 * (2 ^ m * s) = 2 ^ (m + 1) * s := by
        rw [pow_succ', Nat.mul_assoc]
      rw [h_smul, h_r, h_s]

/-- Exact coarse and fine lattice discretization of a half-offset grid rectangle
`RectOnGrid a halfOffset ℓ` (`0 < a`) when `a_uv * 2 ^ K = a` (`0 < a_uv`):
shifting `ℓ` by `fun _ => -(a / 2)` places its base on `a · ℤ⁴` (hence on `a_uv · ℤ⁴`), scales its
fine integer base by `2 ^ K`, and scales its fine step counts `stepsμ a_uv` and `stepsν a_uv` by `2 ^ K`. -/
theorem rectOnGrid_halfOffset_fine_discretization
    {a : ℚ} (ha : 0 < a) {a_uv : ℝ} (ha_uv : 0 < a_uv) {K : ℕ}
    (hK : a_uv * (2 : ℝ) ^ K = (a : ℝ))
    {ℓ : PhysicalRectangle} (hℓ : RectOnGrid a halfOffset ℓ) :
    let ℓ_shift := ℓ.translate (fun _ => -(a / 2))
    IsLatticeVector a_uv ℓ_shift.base ∧
    ℓ_shift.latticeBase a_uv = (2 ^ K : ℤ) • ℓ.latticeBase (a : ℝ) ∧
    ℓ_shift.stepsμ a_uv = 2 ^ K * ℓ.stepsμ (a : ℝ) ∧
    ℓ_shift.stepsν a_uv = 2 ^ K * ℓ.stepsν (a : ℝ) := by
  dsimp only
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  set ℓ_shift := ℓ.translate (fun _ => -(a / 2))
  have h_base_coord : ∀ i : Fin 4,
      (ℓ_shift.base i : ℝ) = ((2 ^ K : ℤ) * ℓ.latticeBase (a : ℝ) i : ℤ) * a_uv ∧
      ℓ_shift.latticeBase a_uv i = (2 ^ K : ℤ) * ℓ.latticeBase (a : ℝ) i := by
    intro i
    obtain ⟨m, hm⟩ := hℓ.1 i
    have hm_real : (ℓ.base i : ℝ) / (a : ℝ) = (m : ℝ) + 1 / 2 := by
      have h1 : (ℓ.base i : ℝ) = ((m : ℝ) + 1 / 2) * (a : ℝ) := by
        simpa [halfOffset] using congrArg (Rat.cast : ℚ → ℝ) hm
      rw [h1, mul_div_cancel_right₀ _ ha_real.ne']
    have h_lb : ℓ.latticeBase (a : ℝ) i = m := by
      unfold PhysicalRectangle.latticeBase
      rw [hm_real, Int.floor_intCast_add]
      have h_half : (⌊(1 / 2 : ℝ)⌋ : ℤ) = 0 :=
        Int.floor_eq_zero_iff.mpr ⟨by norm_num, by norm_num⟩
      omega
    have h_sh_rat : ℓ_shift.base i = (m : ℚ) * a := by
      change ℓ.base i + -(a / 2) = (m : ℚ) * a
      rw [hm]
      dsimp [halfOffset]
      ring
    have h_sh_real : (ℓ_shift.base i : ℝ) = ((2 ^ K : ℤ) * m : ℤ) * a_uv := by
      have h1 : (ℓ_shift.base i : ℝ) = (m : ℝ) * (a : ℝ) := by exact_mod_cast h_sh_rat
      rw [h1, ← hK]
      push_cast
      ring
    rw [h_lb]
    refine ⟨h_sh_real, ?_⟩
    unfold PhysicalRectangle.latticeBase
    rw [h_sh_real, mul_div_cancel_right₀ _ ha_uv.ne', Int.floor_intCast]
  have h_stepsμ : ℓ_shift.stepsμ a_uv = 2 ^ K * ℓ.stepsμ (a : ℝ) := by
    obtain ⟨r, _, hr⟩ := hℓ.2.1
    have hr_coarse : (ℓ.sideμ : ℝ) / (a : ℝ) = (r : ℝ) := by
      have h1 : (ℓ.sideμ : ℝ) = (r : ℝ) * (a : ℝ) := by exact_mod_cast hr
      rw [h1, mul_div_cancel_right₀ _ ha_real.ne']
    have hr_fine : (ℓ_shift.sideμ : ℝ) / a_uv = ((2 ^ K * r : ℕ) : ℝ) := by
      have h1 : (ℓ_shift.sideμ : ℝ) = (r : ℝ) * (a : ℝ) := by exact_mod_cast hr
      have h2 : (r : ℝ) * (a : ℝ) = ((2 ^ K * r : ℕ) : ℝ) * a_uv := by
        rw [← hK]
        push_cast
        ring
      rw [h1, h2, mul_div_cancel_right₀ _ ha_uv.ne']
    unfold PhysicalRectangle.stepsμ
    rw [hr_fine, Nat.floor_natCast, hr_coarse, Nat.floor_natCast]
  have h_stepsν : ℓ_shift.stepsν a_uv = 2 ^ K * ℓ.stepsν (a : ℝ) := by
    obtain ⟨s, _, hs⟩ := hℓ.2.2
    have hs_coarse : (ℓ.sideν : ℝ) / (a : ℝ) = (s : ℝ) := by
      have h1 : (ℓ.sideν : ℝ) = (s : ℝ) * (a : ℝ) := by exact_mod_cast hs
      rw [h1, mul_div_cancel_right₀ _ ha_real.ne']
    have hs_fine : (ℓ_shift.sideν : ℝ) / a_uv = ((2 ^ K * s : ℕ) : ℝ) := by
      have h1 : (ℓ_shift.sideν : ℝ) = (s : ℝ) * (a : ℝ) := by exact_mod_cast hs
      have h2 : (s : ℝ) * (a : ℝ) = ((2 ^ K * s : ℕ) : ℝ) * a_uv := by
        rw [← hK]
        push_cast
        ring
      rw [h1, h2, mul_div_cancel_right₀ _ ha_uv.ne']
    unfold PhysicalRectangle.stepsν
    rw [hs_fine, Nat.floor_natCast, hs_coarse, Nat.floor_natCast]
  refine ⟨fun i => ⟨(2 ^ K : ℤ) * ℓ.latticeBase (a : ℝ) i, (h_base_coord i).1⟩,
    funext (fun i => (h_base_coord i).2), h_stepsμ, h_stepsν⟩

/-- Pointwise `K`-step pure-decimation identity for a single `RectOnGrid a halfOffset` rectangle `ℓ`:
evaluating the coarse loop `physicalWilsonLoop L_ir (a : ℝ) ℓ` on `iteratedDyadicLinkBlockMapToIR L_ir K U`
equals the fine loop `physicalWilsonLoop (dyadicScaleSide L_ir K) a_uv (ℓ.translate (fun _ => -(a / 2))) U`. -/
theorem physicalWilsonLoop_iteratedDyadicLinkBlockMapToIR_of_rectOnGrid
    (L_ir K : ℕ) [NeZero L_ir] {a : ℚ} (ha : 0 < a) {a_uv : ℝ} (ha_uv : 0 < a_uv)
    (hK : a_uv * (2 : ℝ) ^ K = (a : ℝ))
    {ℓ : PhysicalRectangle} (hℓ : RectOnGrid a halfOffset ℓ)
    (U : GaugeConfig (dyadicScaleSide L_ir K)) :
    physicalWilsonLoop L_ir (a : ℝ) ℓ (iteratedDyadicLinkBlockMapToIR L_ir K U) =
      physicalWilsonLoop (dyadicScaleSide L_ir K) a_uv (ℓ.translate (fun _ => -(a / 2))) U := by
  obtain ⟨_, h_base, h_sμ, h_sν⟩ := rectOnGrid_halfOffset_fine_discretization ha ha_uv hK hℓ
  unfold physicalWilsonLoop PhysicalRectangle.latticeLoop
  have h_μ : (ℓ.translate (fun _ => -(a / 2))).μ = ℓ.μ := rfl
  have h_ν : (ℓ.translate (fun _ => -(a / 2))).ν = ℓ.ν := rfl
  rw [h_base, h_sμ, h_sν, h_μ, h_ν]
  exact wilsonLoop_iteratedDyadicLinkBlockMapToIR L_ir K U
    (ℓ.latticeBase (a : ℝ)) ℓ.μ ℓ.ν (ℓ.stepsμ (a : ℝ)) (ℓ.stepsν (a : ℝ))

/-- Pointwise `K`-step pure-decimation identity for a multi-loop family `F` whose loops lie on
`RectOnGrid a halfOffset`:
`irLoopFamilyObservable L_ir (a : ℝ) F (iteratedDyadicLinkBlockMapToIR L_ir K U)` equals
`irLoopFamilyObservable (dyadicScaleSide L_ir K) a_uv (F.translate (fun _ => -(a / 2))) U`. -/
theorem irLoopFamilyObservable_iteratedDyadicLinkBlockMapToIR_of_rectOnGrid
    (L_ir K : ℕ) [NeZero L_ir] {a : ℚ} (ha : 0 < a) {a_uv : ℝ} (ha_uv : 0 < a_uv)
    (hK : a_uv * (2 : ℝ) ^ K = (a : ℝ))
    {F : DisjointLoopFamily} (hF : ∀ ℓ ∈ F.loops, RectOnGrid a halfOffset ℓ)
    (U : GaugeConfig (dyadicScaleSide L_ir K)) :
    irLoopFamilyObservable L_ir (a : ℝ) F (iteratedDyadicLinkBlockMapToIR L_ir K U) =
      irLoopFamilyObservable (dyadicScaleSide L_ir K) a_uv
        (F.translate (fun _ => -(a / 2))) U := by
  unfold irLoopFamilyObservable DisjointLoopFamily.translate
  rw [List.map_map]
  congr 1
  refine List.map_congr_left fun ℓ hℓ => ?_
  exact physicalWilsonLoop_iteratedDyadicLinkBlockMapToIR_of_rectOnGrid
    L_ir K ha ha_uv hK (hF ℓ hℓ) U

theorem integral_wilsonMeasure_irLoopFamilyObservable_congr_side
    {L₁ L₂ : ℕ} [NeZero L₁] [NeZero L₂] (hL : L₁ = L₂) (β a_uv : ℝ) (G : DisjointLoopFamily) :
    (∫ U, irLoopFamilyObservable L₁ a_uv G U ∂(wilsonMeasure (gaugeHaarMeasure L₁) β)) =
      ∫ U, irLoopFamilyObservable L₂ a_uv G U ∂(wilsonMeasure (gaugeHaarMeasure L₂) β) := by
  subst hL
  rfl

theorem DisjointLoopFamily.translate_neg_translate_cancel (c : Fin 4 → ℚ) (F : DisjointLoopFamily) :
    (F.translate (fun i => -c i)).translate c = F := by
  cases F with
  | mk loops =>
    simp only [DisjointLoopFamily.translate, List.map_map]
    congr 1
    have h_id : ((fun ℓ : PhysicalRectangle => ℓ.translate c) ∘
        (fun ℓ : PhysicalRectangle => ℓ.translate (fun i => -c i))) = id := by
      funext ℓ
      rcases ℓ with ⟨b, μ, ν, h, R, T, hR, hT⟩
      dsimp [PhysicalRectangle.translate]
      congr 1
      funext i
      dsimp
      ring
    rw [h_id, List.map_id]

/-- **A4 (Mandatory Pure-Decimation Degeneracy Theorem):**
For any `T : LandingTube P`, any `Z : LoopRenormalization P.toCutoffPath`, and any loop family
`F : DisjointLoopFamily` admissible on the half-offset coarse grid `F.IsAdmissible T.ℓstar halfOffset`,
eventually in `n`:
1. `landedIrSchwinger T Z n F = rawSchwinger P.toCutoffPath n (F.translate (fun _ => -(T.ℓstar / 2)))`,
2. `rawSchwinger P.toCutoffPath n (F.translate (fun _ => -(T.ℓstar / 2))) = rawSchwinger P.toCutoffPath n F`, and
3. `landedIrSchwinger T Z n F = rawSchwinger P.toCutoffPath n F`. -/
theorem landedIrSchwinger_eq_rawSchwinger_of_isAdmissible
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    {F : DisjointLoopFamily} (hF : F.IsAdmissible T.ℓstar halfOffset) :
    ∀ᶠ n in atTop,
      landedIrSchwinger T Z n F =
        rawSchwinger P.toCutoffPath n (F.translate (fun _ => -(T.ℓstar / 2))) ∧
      rawSchwinger P.toCutoffPath n (F.translate (fun _ => -(T.ℓstar / 2))) =
        rawSchwinger P.toCutoffPath n F ∧
      landedIrSchwinger T Z n F = rawSchwinger P.toCutoffPath n F := by
  filter_upwards [T.hK, T.hside] with n hK hside
  have h_gibbs_eq :
      ((T.chain n).state 0).gibbsMeasure =
        ((canonicalRGChain (T.irSide n) (T.K n) (P.coupling_nonneg n)).state 0).gibbsMeasure :=
    MultiStepHaarRGChain.gibbsMeasure_eq (T.chain n)
      (canonicalRGChain (T.irSide n) (T.K n) (P.coupling_nonneg n)) 0 (Nat.zero_le _)
  have h_land_uv :
      landedIrSchwinger T Z n F =
        ∫ U, irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F
            (iteratedDyadicLinkBlockMapToIR (T.irSide n) (T.K n) U)
          ∂(wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide (T.irSide n) (T.K n)))
            (P.coupling n)) := by
    unfold landedIrSchwinger
    rw [h_gibbs_eq,
      canonicalRGChain_irLoopFamilyObservable_integral_eq_uv_wilsonMeasure
        (T.irSide n) (T.K n) (P.coupling_nonneg n) (T.ℓstar : ℝ) F]
  have h_obs_eq :
      (fun U => irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F
          (iteratedDyadicLinkBlockMapToIR (T.irSide n) (T.K n) U)) =
        (fun U => irLoopFamilyObservable (dyadicScaleSide (T.irSide n) (T.K n)) (P.spacing n)
          (F.translate (fun _ => -(T.ℓstar / 2))) U) :=
    funext (irLoopFamilyObservable_iteratedDyadicLinkBlockMapToIR_of_rectOnGrid
      (T.irSide n) (T.K n) T.hℓstar (P.spacing_pos n) hK hF.1)
  have h_raw_def (G : DisjointLoopFamily) :
      rawSchwinger P.toCutoffPath n G =
        ∫ U, irLoopFamilyObservable (P.side n) (P.spacing n) G U
          ∂(wilsonMeasure (gaugeHaarMeasure (P.side n)) (P.coupling n)) := by
    unfold rawSchwinger renormalizedSchwinger
    change (∫ U, G.eval (trivialLoopRenormalization P.toCutoffPath) n U
        ∂(wilsonMeasure (gaugeHaarMeasure (P.side n)) (P.coupling n))) = _
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    exact DisjointLoopFamily.eval_trivialLoopRenormalization_eq n G U
  have h1 :
      landedIrSchwinger T Z n F =
        rawSchwinger P.toCutoffPath n (F.translate (fun _ => -(T.ℓstar / 2))) := by
    rw [h_land_uv, h_obs_eq, h_raw_def]
    exact integral_wilsonMeasure_irLoopFamilyObservable_congr_side hside.symm
      (P.coupling n) (P.spacing n) (F.translate (fun _ => -(T.ℓstar / 2)))
  have h_lat_base :
      ∀ ℓ' ∈ (F.translate (fun _ => -(T.ℓstar / 2))).loops,
        IsLatticeVector (P.spacing n) ℓ'.base := by
    intro ℓ' hℓ'
    simp only [DisjointLoopFamily.translate, List.mem_map] at hℓ'
    obtain ⟨ℓ, hℓ, rfl⟩ := hℓ'
    exact (rectOnGrid_halfOffset_fine_discretization T.hℓstar (P.spacing_pos n) hK (hF.1 ℓ hℓ)).1
  have h_tr_inv : (trivialLoopRenormalization P.toCutoffPath).IsTranslationInvariant :=
    fun _ _ _ => rfl
  have h2 :
      rawSchwinger P.toCutoffPath n (F.translate (fun _ => -(T.ℓstar / 2))) =
        rawSchwinger P.toCutoffPath n F := by
    unfold rawSchwinger
    have h_shift :=
      renormalizedSchwinger_translate_eq_of_isLatticeBase h_tr_inv n
        (fun _ => T.ℓstar / 2) h_lat_base
    rw [DisjointLoopFamily.translate_neg_translate_cancel (fun _ => T.ℓstar / 2) F] at h_shift
    exact h_shift.symm
  exact ⟨h1, h2, h1.trans h2⟩

/-- **A4 (Degeneracy Corollary for `AlignedTwoCutoffComparison`):**
Because pure decimation makes `landedIrSchwinger T Z n F = rawSchwinger P.toCutoffPath n F`
eventually in `n` for every admissible `F`, `AlignedTwoCutoffComparison T Z` forces
`Tendsto (fun n => (Z.familyFactor n F - 1) * rawSchwinger P.toCutoffPath n F) atTop (𝓝 0)`
for every `F` satisfying `F.IsAdmissible T.ℓstar halfOffset`. -/
theorem AlignedTwoCutoffComparison.tendsto_familyFactor_sub_one_mul_raw
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hA : AlignedTwoCutoffComparison T Z) {F : DisjointLoopFamily}
    (hF : F.IsAdmissible T.ℓstar halfOffset) :
    Tendsto (fun n => (Z.familyFactor n F - 1) * rawSchwinger P.toCutoffPath n F)
      atTop (𝓝 0) := by
  have h_def := hA.h_dressing_defect_tendsto_zero F hF
  refine h_def.congr' ?_
  filter_upwards [landedIrSchwinger_eq_rawSchwinger_of_isAdmissible T Z hF] with n ⟨_, _, h_eq⟩
  rw [h_eq, renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger]
  unfold rawSchwinger
  ring

/-! ### Stage p2.A7: Guarded Translation (`SymanzikTranslationGuarded`), Exact Dyadic/Admissible Translation & H(4) Reflection, and Negative Controls -/

/-- Physical extent of an axis-parallel rectangle `ℓ` along coordinate `i`. -/
def PhysicalRectangle.extent (ℓ : PhysicalRectangle) (i : Fin 4) : ℚ :=
  if i = ℓ.μ then ℓ.sideμ else if i = ℓ.ν then ℓ.sideν else 0

abbrev _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.PhysicalRectangle.extent :=
  PhysicalRectangle.extent

/-- Strictly separated bounding boxes (positive physical gap) in at least one coordinate `i`. -/
def PhysicalRectangle.Separated (ℓ₁ ℓ₂ : PhysicalRectangle) : Prop :=
  ∃ i : Fin 4, ℓ₁.base i + ℓ₁.extent i < ℓ₂.base i ∨ ℓ₂.base i + ℓ₂.extent i < ℓ₁.base i

abbrev _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.PhysicalRectangle.Separated :=
  PhysicalRectangle.Separated

/-- Pairwise strict physical separation of all loops in `F`. -/
def DisjointLoopFamily.IsSeparated (F : DisjointLoopFamily) : Prop :=
  F.loops.Pairwise PhysicalRectangle.Separated

abbrev _root_.JesseMath.Physics.YangMillsOsterwalderSchraderInheritance.DisjointLoopFamily.IsSeparated :=
  DisjointLoopFamily.IsSeparated

/-- `PhysicalRectangle.Separated` is irreflexive. -/
theorem PhysicalRectangle.not_separated_self (ℓ : PhysicalRectangle) : ¬ ℓ.Separated ℓ := by
  rintro ⟨i, h | h⟩
  · have hext : 0 ≤ ℓ.extent i := by
      change 0 ≤ if i = ℓ.μ then ℓ.sideμ else if i = ℓ.ν then ℓ.sideν else 0
      split_ifs
      · exact ℓ.sideμ_pos.le
      · exact ℓ.sideν_pos.le
      · exact le_rfl
    linarith
  · have hext : 0 ≤ ℓ.extent i := by
      change 0 ≤ if i = ℓ.μ then ℓ.sideμ else if i = ℓ.ν then ℓ.sideν else 0
      split_ifs
      · exact ℓ.sideμ_pos.le
      · exact ℓ.sideν_pos.le
      · exact le_rfl
    linarith

/-- No duplicate pair `⟨[ℓ, ℓ]⟩` is separated (`IsSeparated` excludes repeated loops). -/
theorem DisjointLoopFamily.not_isSeparated_duplicate (ℓ : PhysicalRectangle) :
    ¬ (⟨[ℓ, ℓ]⟩ : DisjointLoopFamily).IsSeparated := by
  intro h
  have h_pair : ([ℓ, ℓ] : List PhysicalRectangle).Pairwise PhysicalRectangle.Separated := h
  rw [List.pairwise_cons] at h_pair
  exact PhysicalRectangle.not_separated_self ℓ (h_pair.1 ℓ (List.mem_singleton.mpr rfl))

/-- `DisjointLoopFamily.IsSeparated` is invariant under arbitrary rational translations `c`. -/
theorem DisjointLoopFamily.isSeparated_translate {F : DisjointLoopFamily} (c : Fin 4 → ℚ) :
    (F.translate c).IsSeparated ↔ F.IsSeparated := by
  have h_ext_tr (ℓ : PhysicalRectangle) (i : Fin 4) : (ℓ.translate c).extent i = ℓ.extent i := rfl
  have h_base_tr (ℓ : PhysicalRectangle) (i : Fin 4) : (ℓ.translate c).base i = ℓ.base i + c i := rfl
  have h_sep_tr (ℓ₁ ℓ₂ : PhysicalRectangle) :
      (ℓ₁.translate c).Separated (ℓ₂.translate c) ↔ ℓ₁.Separated ℓ₂ := by
    change (∃ i : Fin 4,
        (ℓ₁.translate c).base i + (ℓ₁.translate c).extent i < (ℓ₂.translate c).base i ∨
        (ℓ₂.translate c).base i + (ℓ₂.translate c).extent i < (ℓ₁.translate c).base i) ↔
      (∃ i : Fin 4,
        ℓ₁.base i + ℓ₁.extent i < ℓ₂.base i ∨ ℓ₂.base i + ℓ₂.extent i < ℓ₁.base i)
    refine exists_congr fun i => ?_
    rw [h_ext_tr, h_ext_tr, h_base_tr, h_base_tr]
    constructor
    · rintro (h | h)
      · left; linarith
      · right; linarith
    · rintro (h | h)
      · left; linarith
      · right; linarith
  change (F.loops.map (fun ℓ => ℓ.translate c)).Pairwise PhysicalRectangle.Separated ↔
    F.loops.Pairwise PhysicalRectangle.Separated
  rw [List.pairwise_map]
  exact List.Pairwise.iff h_sep_tr

/-- Fixed guard probe family `⟨[canonicalSpatialProbe a₀ ha₀]⟩` at physical scale `a₀ > 0`. -/
def symanzikGuardProbe (a₀ : ℚ) (ha₀ : 0 < a₀) : DisjointLoopFamily :=
  ⟨[canonicalSpatialProbe a₀ ha₀]⟩

/-- `h_translate_limit` is OPEN (translation half of continuum Euclidean invariance); `h_guard` is OPEN.
This structure is a DEFINITION ONLY in Stage A; no theorem may take it as a hypothesis and claim progress.
Note (c2 / X2): `quarterThreeQuarterPairFamily` is separated (`IsSeparated`), so a rounded all-families
comparison plus the guard plus decay replays `not_twoCutoffComparison_of_irCov_decay`.
Note (c7): `Z = O(a)` is killed (`not_symanzikTranslationGuarded_of_factor_le_mul_spacing`,
`not_symanzikTranslationGuarded_symanzikDim6PerimeterCornerScheme`); `Z = 1` is NOT excluded by this
structure alone. -/
structure SymanzikTranslationGuarded {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) (a₀ : ℚ) (ha₀ : 0 < a₀) : Prop where
  hZ_scheme : IsPerimeterCornerScheme Z
  h_guard : ∃ κ : ℝ, 0 < κ ∧ ∀ᶠ n in atTop,
    κ ≤ |reflectedConnected Z n (symanzikGuardProbe a₀ ha₀) (symanzikGuardProbe a₀ ha₀)|
  h_translate_limit : ∀ (c : Fin 4 → ℚ) (F : DisjointLoopFamily), F.IsSeparated →
    Tendsto (fun n => renormalizedSchwinger Z n (F.translate c) - renormalizedSchwinger Z n F)
      atTop (𝓝 0)

/-- Exact translation invariance eventually in `n` for **all** rational shifts `c : Fin 4 → ℚ`
whenever `F` has `T.ℓstar`-dyadic relative base offsets (`∃ m : ℕ, IsLatticeVector (T.ℓstar / 2 ^ m) (ℓ₁.base - ℓ₂.base)`). -/
theorem LandingTube.eventually_forall_translate_eq_of_dyadic_relative {P : ContinuumCutoffPath}
    (T : LandingTube P) {Z : LoopRenormalization P.toCutoffPath} (hZ : Z.IsTranslationInvariant)
    (F : DisjointLoopFamily)
    (hF : ∀ ℓ₁ ∈ F.loops, ∀ ℓ₂ ∈ F.loops,
      ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) (ℓ₁.base - ℓ₂.base)) :
    ∀ᶠ n in atTop, ∀ c : Fin 4 → ℚ,
      renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
  classical
  have h : ∀ᶠ n in atTop, ∀ p ∈ F.loops.toFinset ×ˢ F.loops.toFinset,
      IsLatticeVector (P.spacing n) (p.1.base - p.2.base) := by
    rw [Filter.eventually_all_finset]
    rintro ⟨ℓ₁, ℓ₂⟩ hp
    simp only [Finset.mem_product, List.mem_toFinset] at hp
    exact T.eventually_isLatticeVector_spacing_of_dyadic (hF ℓ₁ hp.1 ℓ₂ hp.2)
  filter_upwards [h] with n hn c
  exact renormalizedSchwinger_translate_eq_of_pairwise_isLatticeVector_sub hZ n c
    (fun ℓ₁ h₁ ℓ₂ h₂ => hn (ℓ₁, ℓ₂) (by simp [h₁, h₂]))

/-- Any family `F` admissible on `(a, θ)` has pairwise `a`-lattice relative base offsets
`IsLatticeVector (a : ℝ) (ℓ₁.base - ℓ₂.base)`. -/
theorem DisjointLoopFamily.IsAdmissible.isLatticeVector_base_sub {a : ℚ} {θ : Fin 4 → ℚ}
    {F : DisjointLoopFamily} (hF : F.IsAdmissible a θ) :
    ∀ ℓ₁ ∈ F.loops, ∀ ℓ₂ ∈ F.loops, IsLatticeVector (a : ℝ) (ℓ₁.base - ℓ₂.base) := by
  intro ℓ₁ h₁ ℓ₂ h₂ i
  obtain ⟨k₁, hk₁⟩ := (hF.1 ℓ₁ h₁).1 i
  obtain ⟨k₂, hk₂⟩ := (hF.1 ℓ₂ h₂).1 i
  refine ⟨k₁ - k₂, ?_⟩
  simp only [Pi.sub_apply]
  have h_sub : ℓ₁.base i - ℓ₂.base i = ((k₁ - k₂ : ℤ) : ℚ) * a := by
    rw [hk₁, hk₂]
    push_cast
    ring
  exact_mod_cast h_sub

/-- Every family `F` admissible on `(T.ℓstar, θ)` is eventually exactly translation-invariant under
**every** rational shift `c : Fin 4 → ℚ`. -/
theorem LandingTube.eventually_forall_translate_eq_of_isAdmissible {P : ContinuumCutoffPath}
    (T : LandingTube P) {Z : LoopRenormalization P.toCutoffPath} (hZ : Z.IsTranslationInvariant)
    {θ : Fin 4 → ℚ} {F : DisjointLoopFamily} (hF : F.IsAdmissible T.ℓstar θ) :
    ∀ᶠ n in atTop, ∀ c : Fin 4 → ℚ,
      renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F :=
  T.eventually_forall_translate_eq_of_dyadic_relative hZ F
    (fun ℓ₁ h₁ ℓ₂ h₂ => ⟨0, by simpa using DisjointLoopFamily.IsAdmissible.isLatticeVector_base_sub hF ℓ₁ h₁ ℓ₂ h₂⟩)

/-- Coordinate-axis reflection `x_i ↦ -x_i` of `ℓ : PhysicalRectangle` defined by conjugating
Euclidean time reflection `timeReflect` with `Equiv.swap 0 i`. -/
def PhysicalRectangle.axisReflect (i : Fin 4) (ℓ : PhysicalRectangle) : PhysicalRectangle :=
  ((ℓ.permute (Equiv.swap 0 i)).timeReflect).permute (Equiv.swap 0 i)

abbrev _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.PhysicalRectangle.axisReflect :=
  PhysicalRectangle.axisReflect

/-- Coordinate-axis reflection `x_i ↦ -x_i` on a loop family `F : DisjointLoopFamily`. -/
def DisjointLoopFamily.axisReflect (i : Fin 4) (F : DisjointLoopFamily) : DisjointLoopFamily :=
  ⟨F.loops.map (·.axisReflect i)⟩

abbrev _root_.JesseMath.Physics.YangMillsOsterwalderSchraderInheritance.DisjointLoopFamily.axisReflect :=
  DisjointLoopFamily.axisReflect

/-- Full 4D lattice commensurability of `ℓ : PhysicalRectangle` at spacing `a`: base on `a · ℤ⁴`
and both sides in `a · ℕ`. -/
def PhysicalRectangle.IsLatticeCommensurate (a : ℝ) (ℓ : PhysicalRectangle) : Prop :=
  IsLatticeVector a ℓ.base ∧ (∃ r : ℕ, (ℓ.sideμ : ℝ) = r * a) ∧ (∃ s : ℕ, (ℓ.sideν : ℝ) = s * a)

abbrev _root_.JesseMath.Physics.YangMillsRenormalizedObservableLimits.PhysicalRectangle.IsLatticeCommensurate :=
  PhysicalRectangle.IsLatticeCommensurate

theorem PhysicalRectangle.IsLatticeCommensurate.permute {a : ℝ} {ℓ : PhysicalRectangle}
    (hℓ : ℓ.IsLatticeCommensurate a) (σ : Equiv.Perm (Fin 4)) :
    (ℓ.permute σ).IsLatticeCommensurate a := by
  refine ⟨fun j => ?_, ?_, ?_⟩
  · unfold PhysicalRectangle.permute
    split_ifs <;> exact hℓ.1 (σ.symm j)
  · unfold PhysicalRectangle.permute
    split_ifs
    · exact hℓ.2.1
    · exact hℓ.2.2
  · unfold PhysicalRectangle.permute
    split_ifs
    · exact hℓ.2.2
    · exact hℓ.2.1

theorem PhysicalRectangle.IsLatticeCommensurate.isTimeCommensurate {a : ℝ} {ℓ : PhysicalRectangle}
    (hℓ : ℓ.IsLatticeCommensurate a) :
    IsTimeCommensurate a ℓ :=
  ⟨hℓ.1 0, fun _ => hℓ.2.1⟩

/-- Exact coordinate-axis reflection invariance of `renormalizedSchwinger` in any axis `i : Fin 4`
for lattice-commensurate loop families. -/
theorem renormalizedSchwinger_axisReflect_eq {P : CutoffPath} {Z : LoopRenormalization P}
    (hP : Z.IsPermutationInvariant) (hR : HasReflectionInvariantFactors Z) (n : ℕ) (i : Fin 4)
    {F : DisjointLoopFamily} (hF : ∀ ℓ ∈ F.loops, ℓ.IsLatticeCommensurate (P.spacing n)) :
    renormalizedSchwinger Z n (F.axisReflect i) = renormalizedSchwinger Z n F := by
  have h_eq_fam : F.axisReflect i = ((F.permute (Equiv.swap 0 i)).reflect).permute (Equiv.swap 0 i) := by
    cases F
    simp [DisjointLoopFamily.axisReflect, DisjointLoopFamily.permute, DisjointLoopFamily.reflect,
      PhysicalRectangle.axisReflect, List.map_map, Function.comp_def]
  rw [h_eq_fam, renormalizedSchwinger_permute_eq_of_isPermutationInvariant hP n (Equiv.swap 0 i),
    renormalizedSchwinger_reflect_eq_of_isTimeCommensurate hR n,
    renormalizedSchwinger_permute_eq_of_isPermutationInvariant hP n (Equiv.swap 0 i)]
  intro ℓ' hℓ'
  simp only [DisjointLoopFamily.permute, List.mem_map] at hℓ'
  obtain ⟨ℓ, hℓ, rfl⟩ := hℓ'
  exact ((hF ℓ hℓ).permute (Equiv.swap 0 i)).isTimeCommensurate

/-- Exact factorization of `reflectedConnected Z n ⟨[ℓ]⟩ ⟨[ℓ]⟩` into
`(Z.factor n ℓ.timeReflect * Z.factor n ℓ)` times the raw UV reflected connected covariance. -/
theorem reflectedConnected_singleton_eq_factor_mul_raw {P : CutoffPath}
    (Z : LoopRenormalization P) (n : ℕ) (ℓ : PhysicalRectangle) :
    reflectedConnected Z n ⟨[ℓ]⟩ ⟨[ℓ]⟩ =
      (Z.factor n ℓ.timeReflect * Z.factor n ℓ) *
        (rawSchwinger P n ⟨[ℓ.timeReflect, ℓ]⟩ -
          rawSchwinger P n ⟨[ℓ.timeReflect]⟩ * rawSchwinger P n ⟨[ℓ]⟩) := by
  rw [reflectedConnected_eq_schwinger_sub]
  have h_app : (⟨[ℓ]⟩ : DisjointLoopFamily).reflect.append ⟨[ℓ]⟩ = ⟨[ℓ.timeReflect, ℓ]⟩ := rfl
  have h_ref : (⟨[ℓ]⟩ : DisjointLoopFamily).reflect = ⟨[ℓ.timeReflect]⟩ := rfl
  rw [h_app, h_ref,
    renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger Z n ⟨[ℓ.timeReflect, ℓ]⟩,
    renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger Z n ⟨[ℓ.timeReflect]⟩,
    renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger Z n ⟨[ℓ]⟩]
  simp only [LoopRenormalization.familyFactor, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil, mul_one, rawSchwinger]
  ring

/-- Universal upper bound `|reflectedConnected Z n ⟨[ℓ]⟩ ⟨[ℓ]⟩| ≤ 2 * (|Z.factor n ℓ.timeReflect| * |Z.factor n ℓ|)`
for any singleton loop family `⟨[ℓ]⟩`. -/
theorem abs_reflectedConnected_singleton_le {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (ℓ : PhysicalRectangle) :
    |reflectedConnected Z n ⟨[ℓ]⟩ ⟨[ℓ]⟩| ≤ 2 * (|Z.factor n ℓ.timeReflect| * |Z.factor n ℓ|) := by
  rw [reflectedConnected_singleton_eq_factor_mul_raw, abs_mul, abs_mul]
  have h_pair := abs_rawSchwinger_le_one P n ⟨[ℓ.timeReflect, ℓ]⟩
  have h_ref := abs_rawSchwinger_le_one P n ⟨[ℓ.timeReflect]⟩
  have h_self := abs_rawSchwinger_le_one P n ⟨[ℓ]⟩
  have h_prod :
      |rawSchwinger P n ⟨[ℓ.timeReflect]⟩ * rawSchwinger P n ⟨[ℓ]⟩| ≤ 1 := by
    rw [abs_mul]
    nlinarith [abs_nonneg (rawSchwinger P n ⟨[ℓ.timeReflect]⟩),
      abs_nonneg (rawSchwinger P n ⟨[ℓ]⟩)]
  have h_tri := abs_sub (rawSchwinger P n ⟨[ℓ.timeReflect, ℓ]⟩)
    (rawSchwinger P n ⟨[ℓ.timeReflect]⟩ * rawSchwinger P n ⟨[ℓ]⟩)
  have h_raw_le :
      |rawSchwinger P n ⟨[ℓ.timeReflect, ℓ]⟩ -
        rawSchwinger P n ⟨[ℓ.timeReflect]⟩ * rawSchwinger P n ⟨[ℓ]⟩| ≤ 2 := by
    linarith
  have h_fac_nonneg : 0 ≤ |Z.factor n ℓ.timeReflect| * |Z.factor n ℓ| := by positivity
  nlinarith

/-- Any renormalization scheme `Z` whose factors are `O(P.spacing n)` violates the guard in
`SymanzikTranslationGuarded Z a₀ ha₀`. -/
theorem not_symanzikTranslationGuarded_of_factor_le_mul_spacing {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} {a₀ : ℚ} {ha₀ : 0 < a₀} {C : ℝ}
    (hZ : ∀ᶠ n in atTop, ∀ ℓ, |Z.factor n ℓ| ≤ C * P.spacing n) :
    ¬ SymanzikTranslationGuarded Z a₀ ha₀ := by
  intro hG
  obtain ⟨κ, hκ_pos, hκ_ev⟩ := hG.h_guard
  set p := canonicalSpatialProbe a₀ ha₀
  have h_tendsto : Tendsto (fun n => 2 * ((C * P.spacing n) * (C * P.spacing n))) atTop (𝓝 0) := by
    have h0 : Tendsto (fun n => C * P.spacing n) atTop (𝓝 (C * 0)) :=
      tendsto_const_nhds.mul P.spacing_tendsto_zero
    rw [mul_zero] at h0
    have h_prod := h0.mul h0
    rw [mul_zero] at h_prod
    have h_two := (tendsto_const_nhds (x := (2 : ℝ))).mul h_prod
    simpa using h_two
  have h_lt_κ : ∀ᶠ n in atTop, 2 * ((C * P.spacing n) * (C * P.spacing n)) < κ :=
    h_tendsto.eventually (gt_mem_nhds hκ_pos)
  obtain ⟨n, hn_Z, hn_κ, hn_lt⟩ := (hZ.and (hκ_ev.and h_lt_κ)).exists
  have h_le := abs_reflectedConnected_singleton_le Z n p
  have h1 : |Z.factor n p.timeReflect| ≤ C * P.spacing n := hn_Z p.timeReflect
  have h2 : |Z.factor n p| ≤ C * P.spacing n := hn_Z p
  have hC_nonneg : 0 ≤ C * P.spacing n := le_trans (abs_nonneg _) h2
  have h_prod_le :
      |Z.factor n p.timeReflect| * |Z.factor n p| ≤ (C * P.spacing n) * (C * P.spacing n) :=
    mul_le_mul h1 h2 (abs_nonneg _) hC_nonneg
  dsimp [symanzikGuardProbe, p] at hn_κ
  linarith

/-- The degenerate $a_n^2$ scheme `symanzikDim6PerimeterCornerScheme P` satisfies both
`IsPerimeterCornerScheme` and `h_translate_limit`, isolating `h_guard` as the non-triviality gate. -/
theorem symanzikDim6PerimeterCornerScheme_scheme_and_limit (P : ContinuumCutoffPath) :
    IsPerimeterCornerScheme (symanzikDim6PerimeterCornerScheme P) ∧
      ∀ c F,
        Tendsto (fun n =>
          renormalizedSchwinger (symanzikDim6PerimeterCornerScheme P) n (F.translate c) -
            renormalizedSchwinger (symanzikDim6PerimeterCornerScheme P) n F) atTop (𝓝 0) := by
  obtain ⟨h_scheme, h_sym⟩ := symanzikDimensionSixRotationalSuppression_perimeterCorner_inhabited P
  exact ⟨h_scheme, fun c F => h_sym.tendsto_translate_defect_zero c F⟩

/-- Concrete non-vacuous negative control: `symanzikDim6PerimeterCornerScheme P` (`factor = a_n^2`)
is excluded by `SymanzikTranslationGuarded`. -/
theorem not_symanzikTranslationGuarded_symanzikDim6PerimeterCornerScheme
    (P : ContinuumCutoffPath) (a₀ : ℚ) (ha₀ : 0 < a₀) :
    ¬ SymanzikTranslationGuarded (symanzikDim6PerimeterCornerScheme P) a₀ ha₀ := by
  apply not_symanzikTranslationGuarded_of_factor_le_mul_spacing (C := 1)
  have h_lt : ∀ᶠ n in atTop, P.spacing n < 1 :=
    Tendsto.eventually_lt_const (by norm_num : (0 : ℝ) < 1) P.spacing_tendsto_zero
  filter_upwards [h_lt] with n hn ℓ
  rw [symanzikDim6PerimeterCornerScheme_factor_eq, abs_of_nonneg (sq_nonneg _)]
  have ha_pos : 0 < P.spacing n := P.spacing_pos n
  nlinarith

/-- A persistent translation defect on any separated loop family `F₀` refutes
`SymanzikTranslationGuarded`. -/
theorem not_symanzikTranslationGuarded_of_persistent_defect {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} {a₀ : ℚ} {ha₀ : 0 < a₀}
    {c₀ : Fin 4 → ℚ} {F₀ : DisjointLoopFamily} {c_aniso : ℝ}
    (hF₀ : F₀.IsSeparated)
    (h_aniso : ∀ᶠ n in atTop,
      c_aniso ≤ |renormalizedSchwinger Z n (F₀.translate c₀) - renormalizedSchwinger Z n F₀|)
    (hc : 0 < c_aniso) :
    ¬ SymanzikTranslationGuarded Z a₀ ha₀ := by
  intro hG
  have h_tendsto := (hG.h_translate_limit c₀ F₀ hF₀).abs
  rw [abs_zero] at h_tendsto
  have h_lt : ∀ᶠ n in atTop,
      |renormalizedSchwinger Z n (F₀.translate c₀) - renormalizedSchwinger Z n F₀| < c_aniso :=
    h_tendsto.eventually (gt_mem_nhds hc)
  obtain ⟨n, hn_ge, hn_lt⟩ := (h_aniso.and h_lt).exists
  linarith

/-! ### Stage p2.A8: `h_floor` as Raw UV Covariance (`rawProbeCov`, `LandingTube.h_floor_raw`), D1 (`tendsto_probeFactor_one_of_floor`), and X1 (`rawProbeCov_floor_and_probeFactor_one_of_guard`) -/

/-- Raw UV connected covariance of the canonical spatial probe pair at scale `ℓstar > 0` along `P`. -/
noncomputable def rawProbeCov (P : ContinuumCutoffPath) (ℓstar : ℚ) (h : 0 < ℓstar) (n : ℕ) : ℝ :=
  rawSchwinger P.toCutoffPath n ⟨[(canonicalSpatialProbe ℓstar h).timeReflect, canonicalSpatialProbe ℓstar h]⟩ -
  rawSchwinger P.toCutoffPath n ⟨[(canonicalSpatialProbe ℓstar h).timeReflect]⟩ *
  rawSchwinger P.toCutoffPath n ⟨[canonicalSpatialProbe ℓstar h]⟩

/-- Under pure decimation, the landed IR covariance on `T.ℓ_probe` eventually equals the raw UV
covariance `rawProbeCov P T.ℓstar T.hℓstar n`. -/
theorem LandingTube.eventually_probe_irCov_eq_rawProbeCov {P : ContinuumCutoffPath}
    (T : LandingTube P) :
    ∀ᶠ n in atTop,
      irCov ((T.chain n).state 0).gibbsMeasure
          (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
          (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe) =
        rawProbeCov P T.ℓstar T.hℓstar n := by
  have h_pair :=
    landedIrSchwinger_eq_rawSchwinger_of_isAdmissible T T.Z_tube
      (isAdmissible_canonicalSpatialProbe_reflect_pair T.hℓstar)
  have h_ref :=
    landedIrSchwinger_eq_rawSchwinger_of_isAdmissible T T.Z_tube
      (isAdmissible_singleton_timeReflect_canonicalSpatialProbe T.hℓstar)
  have h_self :=
    landedIrSchwinger_eq_rawSchwinger_of_isAdmissible T T.Z_tube
      (isAdmissible_singleton_canonicalSpatialProbe T.hℓstar)
  filter_upwards [h_pair, h_ref, h_self] with n ⟨_, _, h1⟩ ⟨_, _, h2⟩ ⟨_, _, h3⟩
  have h_cov :=
    landedIrSchwinger_reflect_append_sub_mul_eq_irCov T T.Z_tube n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩
  have h_obs_ref :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) (⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).reflect =
        physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect := by
    funext V
    simp [irLoopFamilyObservable, DisjointLoopFamily.reflect]
  have h_obs_self :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[T.ℓ_probe]⟩ =
        physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe := by
    funext V
    simp [irLoopFamilyObservable]
  have h_app :
      (⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).reflect.append ⟨[T.ℓ_probe]⟩ =
        ⟨[T.ℓ_probe.timeReflect, T.ℓ_probe]⟩ := rfl
  have h_ref_fam :
      (⟨[T.ℓ_probe]⟩ : DisjointLoopFamily).reflect = ⟨[T.ℓ_probe.timeReflect]⟩ := rfl
  rw [h_obs_ref, h_obs_self, h_app, h_ref_fam] at h_cov
  rw [← h_cov]
  dsimp [LandingTube.ℓ_probe, rawProbeCov] at h1 h2 h3 ⊢
  rw [h1, h2, h3]

/-- Along any `T : LandingTube P`, `T.h_floor` implies the raw UV covariance floor
`T.c_floor ≤ |rawProbeCov P T.ℓstar T.hℓstar n|` eventually in `n`. The two-sided statement
at every level is `LandingTube.eventually_irCov_floor_iff_rawProbeCov_floor`. -/
theorem LandingTube.h_floor_raw {P : ContinuumCutoffPath} (T : LandingTube P) :
    ∀ᶠ n in atTop, T.c_floor ≤ |rawProbeCov P T.ℓstar T.hℓstar n| := by
  filter_upwards [T.h_floor, T.eventually_probe_irCov_eq_rawProbeCov] with n hfl heq
  rwa [← heq]

/-- Under pure decimation, for every level `c`, the landed probe-covariance floor at level `c` holds
eventually iff the raw UV floor `c ≤ |rawProbeCov P T.ℓstar T.hℓstar n|` holds eventually. Both
directions use only `LandingTube.eventually_probe_irCov_eq_rawProbeCov`. -/
theorem LandingTube.eventually_irCov_floor_iff_rawProbeCov_floor {P : ContinuumCutoffPath}
    (T : LandingTube P) (c : ℝ) :
    (∀ᶠ n in atTop, c ≤ |irCov ((T.chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe)|) ↔
      (∀ᶠ n in atTop, c ≤ |rawProbeCov P T.ℓstar T.hℓstar n|) := by
  constructor
  · intro h
    filter_upwards [h, T.eventually_probe_irCov_eq_rawProbeCov] with n hn heq
    rwa [← heq]
  · intro h
    filter_upwards [h, T.eventually_probe_irCov_eq_rawProbeCov] with n hn heq
    rwa [heq]

/-- Under `AlignedTwoCutoffComparison T Z`, `((Z.factor n T.ℓ_probe) ^ 2 - 1) * rawProbeCov P T.ℓstar T.hℓstar n`
tends to `0` as `n → ∞`. -/
theorem AlignedTwoCutoffComparison.tendsto_sq_probeFactor_sub_one_mul_rawProbeCov
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hA : AlignedTwoCutoffComparison T Z) :
    Tendsto (fun n => ((Z.factor n T.ℓ_probe) ^ 2 - 1) * rawProbeCov P T.ℓstar T.hℓstar n)
      atTop (𝓝 0) := by
  set p := T.ℓ_probe
  have hZ_refl : HasReflectionInvariantFactors Z :=
    hA.hZ_eq ▸ T.z_tube_hasReflectionInvariantFactors
  have h_pair_adm := isAdmissible_canonicalSpatialProbe_reflect_pair T.hℓstar
  have h_ref_adm := isAdmissible_singleton_timeReflect_canonicalSpatialProbe T.hℓstar
  have h_self_adm := isAdmissible_singleton_canonicalSpatialProbe T.hℓstar
  have h_pair_lim :
      Tendsto (fun n => ((Z.factor n p) ^ 2 - 1) * rawSchwinger P.toCutoffPath n ⟨[p.timeReflect, p]⟩)
        atTop (𝓝 0) := by
    refine (hA.tendsto_familyFactor_sub_one_mul_raw h_pair_adm).congr fun n => ?_
    simp only [p, LandingTube.ℓ_probe, LoopRenormalization.familyFactor,
      List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
    rw [hZ_refl n (canonicalSpatialProbe T.ℓstar T.hℓstar)]
    ring
  have h_ref_lim :
      Tendsto (fun n => (Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩)
        atTop (𝓝 0) := by
    refine (hA.tendsto_familyFactor_sub_one_mul_raw h_ref_adm).congr fun n => ?_
    simp only [p, LandingTube.ℓ_probe, LoopRenormalization.familyFactor,
      List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
    rw [hZ_refl n (canonicalSpatialProbe T.ℓstar T.hℓstar)]
  have h_self_lim :
      Tendsto (fun n => (Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p]⟩)
        atTop (𝓝 0) := by
    refine (hA.tendsto_familyFactor_sub_one_mul_raw h_self_adm).congr fun n => ?_
    simp only [p, LandingTube.ℓ_probe, LoopRenormalization.familyFactor,
      List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
  have h_term1 :
      Tendsto (fun n =>
        ((Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩) *
          rawSchwinger P.toCutoffPath n ⟨[p]⟩) atTop (𝓝 0) := by
    refine squeeze_zero_norm' (Filter.Eventually.of_forall fun n => ?_)
      (by rw [← norm_zero (E := ℝ)]; exact h_ref_lim.norm)
    rw [norm_mul, Real.norm_eq_abs (rawSchwinger _ _ _)]
    calc
      ‖(Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩‖ *
          |rawSchwinger P.toCutoffPath n ⟨[p]⟩|
        ≤ ‖(Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩‖ * 1 :=
          mul_le_mul_of_nonneg_left (abs_rawSchwinger_le_one P.toCutoffPath n ⟨[p]⟩) (norm_nonneg _)
      _ = ‖(Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩‖ := mul_one _
  have h_term2 :
      Tendsto (fun n =>
        rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩ *
          ((Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p]⟩)) atTop (𝓝 0) := by
    refine squeeze_zero_norm' (Filter.Eventually.of_forall fun n => ?_)
      (by rw [← norm_zero (E := ℝ)]; exact h_self_lim.norm)
    rw [norm_mul, Real.norm_eq_abs (rawSchwinger _ _ _)]
    calc
      |rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩| *
          ‖(Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p]⟩‖
        ≤ 1 * ‖(Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p]⟩‖ :=
          mul_le_mul_of_nonneg_right (abs_rawSchwinger_le_one P.toCutoffPath n ⟨[p.timeReflect]⟩)
            (norm_nonneg _)
      _ = ‖(Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p]⟩‖ := one_mul _
  have h_term3 :
      Tendsto (fun n =>
        ((Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩) *
          ((Z.factor n p - 1) * rawSchwinger P.toCutoffPath n ⟨[p]⟩)) atTop (𝓝 0) := by
    simpa using h_ref_lim.mul h_self_lim
  have h_prod_lim :
      Tendsto (fun n =>
        ((Z.factor n p) ^ 2 - 1) *
          (rawSchwinger P.toCutoffPath n ⟨[p.timeReflect]⟩ *
            rawSchwinger P.toCutoffPath n ⟨[p]⟩)) atTop (𝓝 0) := by
    have h_sum := (h_term1.add h_term2).add h_term3
    rw [add_zero, add_zero] at h_sum
    exact h_sum.congr fun n => by ring
  have h_sub := h_pair_lim.sub h_prod_lim
  rw [sub_zero] at h_sub
  refine h_sub.congr fun n => ?_
  dsimp [p, LandingTube.ℓ_probe, rawProbeCov]
  ring

/-- DEGENERACY: core lemma. -/
theorem AlignedTwoCutoffComparison.tendsto_probeFactor_one_of_rawFloor
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hA : AlignedTwoCutoffComparison T Z) {c : ℝ} (hc : 0 < c)
    (hfl : ∀ᶠ n in atTop, c ≤ |rawProbeCov P T.ℓstar T.hℓstar n|) :
    Tendsto (fun n => Z.factor n T.ℓ_probe) atTop (𝓝 1) := by
  set p := T.ℓ_probe
  have h_prod := hA.tendsto_sq_probeFactor_sub_one_mul_rawProbeCov
  have h_div :
      Tendsto (fun n =>
        ‖((Z.factor n p) ^ 2 - 1) * rawProbeCov P T.ℓstar T.hℓstar n‖ / c) atTop (𝓝 0) := by
    simpa using h_prod.norm.div_const c
  have h_le : ∀ᶠ n in atTop,
      ‖(Z.factor n p) ^ 2 - 1‖ ≤
        ‖((Z.factor n p) ^ 2 - 1) * rawProbeCov P T.ℓstar T.hℓstar n‖ / c := by
    filter_upwards [hfl] with n hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, le_div_iff₀ hc]
    exact mul_le_mul_of_nonneg_left hn (abs_nonneg _)
  have h_sq_sub : Tendsto (fun n => (Z.factor n p) ^ 2 - 1) atTop (𝓝 0) :=
    squeeze_zero_norm' h_le h_div
  have h_sq_one : Tendsto (fun n => (Z.factor n p) ^ 2) atTop (𝓝 1) := by
    have h_add := h_sq_sub.add (tendsto_const_nhds (x := (1 : ℝ)))
    rw [zero_add] at h_add
    exact h_add.congr fun n => by ring
  have h_sqrt := (Real.continuous_sqrt.tendsto 1).comp h_sq_one
  rw [Real.sqrt_one] at h_sqrt
  exact h_sqrt.congr fun n => Real.sqrt_sq (Z.factor_pos n p).le

/-- DEGENERACY: (D1) Aligned + LandingTube floor ⇒ probe counterterm → 1. -/
theorem AlignedTwoCutoffComparison.tendsto_probeFactor_one_of_floor
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hA : AlignedTwoCutoffComparison T Z) :
    Tendsto (fun n => Z.factor n T.ℓ_probe) atTop (𝓝 1) :=
  hA.tendsto_probeFactor_one_of_rawFloor T.hc_floor T.h_floor_raw

/-- DEGENERACY: under `AlignedTwoCutoffComparison`, any perimeter-corner counterterm scheme must
have its perimeter and corner counterterms cancel asymptotically on `T.ℓ_probe` (`m n * (4 * T.ℓstar) + 4 * c n → 0`). -/
theorem AlignedTwoCutoffComparison.perimeterCorner_probe_cancellation
    {P : ContinuumCutoffPath} {T : LandingTube P} {m c : ℕ → ℝ}
    (hA : AlignedTwoCutoffComparison T (perimeterCornerRenormalization P.toCutoffPath m c)) :
    Tendsto (fun n => m n * (4 * (T.ℓstar : ℝ)) + 4 * c n) atTop (𝓝 0) := by
  have h_fac := hA.tendsto_probeFactor_one_of_floor
  have h_log := (Real.continuousAt_log one_ne_zero).tendsto.comp h_fac
  rw [Real.log_one] at h_log
  refine h_log.congr fun n => ?_
  dsimp [Function.comp, perimeterCornerRenormalization, LandingTube.ℓ_probe, canonicalSpatialProbe]
  rw [Real.log_exp]
  ring

/-- DEGENERACY (X1): the lane-3 guard together with Aligned forces a raw UV floor and Z(p) → 1. -/
theorem AlignedTwoCutoffComparison.rawProbeCov_floor_and_probeFactor_one_of_guard
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hA : AlignedTwoCutoffComparison T Z) (hG : SymanzikTranslationGuarded Z T.ℓstar T.hℓstar) :
    (∃ c > 0, ∀ᶠ n in atTop, c ≤ |rawProbeCov P T.ℓstar T.hℓstar n|) ∧
      Tendsto (fun n => Z.factor n T.ℓ_probe) atTop (𝓝 1) := by
  obtain ⟨κ, hκ_pos, hκ_ev⟩ := hG.h_guard
  have hZ_refl : HasReflectionInvariantFactors Z :=
    hA.hZ_eq ▸ T.z_tube_hasReflectionInvariantFactors
  have h_diff :
      Tendsto (fun n =>
        reflectedConnected Z n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩ - rawProbeCov P T.ℓstar T.hℓstar n)
        atTop (𝓝 0) := by
    refine hA.tendsto_sq_probeFactor_sub_one_mul_rawProbeCov.congr fun n => ?_
    rw [reflectedConnected_singleton_eq_factor_mul_raw Z n T.ℓ_probe, hZ_refl n T.ℓ_probe]
    dsimp [LandingTube.ℓ_probe, rawProbeCov]
    ring
  have h_abs_diff := h_diff.abs
  rw [abs_zero] at h_abs_diff
  have h_lt : ∀ᶠ n in atTop,
      |reflectedConnected Z n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩ - rawProbeCov P T.ℓstar T.hℓstar n| <
        κ / 2 :=
    h_abs_diff.eventually (gt_mem_nhds (half_pos hκ_pos))
  have h_raw_fl : ∀ᶠ n in atTop, κ / 2 ≤ |rawProbeCov P T.ℓstar T.hℓstar n| := by
    filter_upwards [hκ_ev, h_lt] with n hn_κ hn_lt
    dsimp [symanzikGuardProbe, LandingTube.ℓ_probe] at hn_κ hn_lt
    have h_tri := abs_sub_abs_le_abs_sub
      (reflectedConnected Z n ⟨[canonicalSpatialProbe T.ℓstar T.hℓstar]⟩
        ⟨[canonicalSpatialProbe T.ℓstar T.hℓstar]⟩)
      (rawProbeCov P T.ℓstar T.hℓstar n)
    linarith
  refine ⟨⟨κ / 2, half_pos hκ_pos, h_raw_fl⟩,
    hA.tendsto_probeFactor_one_of_rawFloor (half_pos hκ_pos) h_raw_fl⟩

/-- Per-step counterterm factorization along the RG chain `0 ≤ m < T.K n` whose product over the
`T.K n` steps recovers `T.Z_tube.factor n ℓ`. -/
structure TrackedRenormalization (P : ContinuumCutoffPath) (T : LandingTube P) where
  Zstep : (n : ℕ) → Fin (T.K n) → PhysicalRectangle → ℝ
  pos : ∀ (n : ℕ) (m : Fin (T.K n)) (ℓ : PhysicalRectangle), 0 < Zstep n m ℓ
  total : ∀ (n : ℕ) (ℓ : PhysicalRectangle),
    (∏ m : Fin (T.K n), Zstep n m ℓ) = T.Z_tube.factor n ℓ

/-- Landed IR expectation of a coarse observable family `O_loc n F` under
`((T.chain n).state 0).gibbsMeasure`. -/
noncomputable def dressedLandedSchwinger {P : ContinuumCutoffPath} (T : LandingTube P)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ)
    (n : ℕ) (F : DisjointLoopFamily) : ℝ :=
  ∫ V, O_loc n F V ∂(((T.chain n).state 0).gibbsMeasure)

/-- Unrounded rational proximity predicate between a coarse link `e : Link L` and the unrounded
rational box of `ℓ : PhysicalRectangle` at coarse spacing `a : ℚ` within radius `R : ℚ` (in coarse
lattice units): there exists an integer torus lift `k : Fin 4 → ℤ` of `e.1` (`latticeSite L k = e.1`)
such that every coordinate `k i * a` lies within `R * a` of the interval `[ℓ.base i, ℓ.base i + side_i]`.
Unlike `physicalLoopListSupport`, this predicate uses the exact unrounded rational coordinates
`ℓ.base i` without `Int.floor`. -/
def InUnroundedLoopNeighborhood (L : ℕ) (a R : ℚ) (ℓ : PhysicalRectangle) (e : Link L) : Prop :=
  ∃ k : Fin 4 → ℤ,
    latticeSite L k = e.1 ∧
    ∀ i : Fin 4,
      ℓ.base i - R * a ≤ (k i : ℚ) * a ∧
      (k i : ℚ) * a ≤
        ℓ.base i + (if i = ℓ.μ then ℓ.sideμ else if i = ℓ.ν then ℓ.sideν else 0) + R * a

/-- **Stage 1B (Option B — Dressed, `Z`-Tracked, Non-Rounding Landed Comparison):**
Replaces the bare rounded IR observable `irLoopFamilyObservable` in `landedIrSchwinger` by a
coarse local observable family `O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ`
equipped with a per-step counterterm tracking `Ztr : TrackedRenormalization P T`:
1. `hZ_eq`: `Z = T.Z_tube`,
2. `h_condexp`: for every cutoff `n`, loop family `F`, and constant coarse test multiplier `c : ℝ`,
   testing `O_loc n F` against `fun _ => c` under `((T.chain n).state 0).gibbsMeasure` equals
   testing the `Z`-dressed UV observable `F.eval Z n` against `fun _ => c` under `P.toCutoffPath.configLaw n`,
3. `h_local`: `O_loc n F` has zero single-link oscillation outside a fixed unrounded coarse radius
   `R_loc ≥ 0` around the unrounded rational support of `F.loops`,
4. `h_cauchy`: for every `F`, the consecutive-cutoff increments of `dressedLandedSchwinger T O_loc n F`
   are bounded by a summable sequence `ε : ℕ → ℝ`, and
5. `h_nondeg`: the landed coarse connected covariance `irCov` between `O_loc n ⟨[T.ℓ_probe.timeReflect]⟩`
   and `O_loc n ⟨[T.ℓ_probe]⟩` is eventually bounded below by `c_nondeg > 0`. -/
structure DressedLandedComparison {P : ContinuumCutoffPath} (T : LandingTube P)
    (Z : LoopRenormalization P.toCutoffPath) (_Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ) : Prop where
  hZ_eq : Z = T.Z_tube
  h_condexp :
    ∀ (n : ℕ) (F : DisjointLoopFamily) (c : ℝ),
      (∫ V, c * O_loc n F V ∂(((T.chain n).state 0).gibbsMeasure)) =
        ∫ U, c * F.eval Z n U ∂(P.toCutoffPath.configLaw n : Measure (GaugeConfig (P.side n)))
  h_local :
    ∃ R_loc : ℚ, 0 ≤ R_loc ∧
      ∀ (n : ℕ) (F : DisjointLoopFamily) (e : Link (T.irSide n)),
        (∀ ℓ ∈ F.loops, ¬ InUnroundedLoopNeighborhood (T.irSide n) T.ℓstar R_loc ℓ e) →
          linkOscillation SU2 (T.irSide n) (O_loc n F) e = 0
  h_cauchy :
    ∀ F : DisjointLoopFamily,
      ∃ ε : ℕ → ℝ, Summable ε ∧
        ∀ n : ℕ,
          dist (dressedLandedSchwinger T O_loc n F)
            (dressedLandedSchwinger T O_loc (n + 1) F) ≤ ε n
  h_nondeg :
    ∃ c_nondeg : ℝ, 0 < c_nondeg ∧
      ∀ᶠ n in atTop,
        c_nondeg ≤
          |irCov ((T.chain n).state 0).gibbsMeasure
            (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩)
            (O_loc n ⟨[T.ℓ_probe]⟩)|

/-- Unconditional probability-measure instance for the landed IR Gibbs measure
`((T.chain n).state 0).gibbsMeasure` of any `T : LandingTube P`, via the pinned-chain pushforward
identity `MultiStepHaarRGChain.gibbsMeasure_eq` +
`canonicalRGChain_ir_gibbsMeasure_eq_iterated_map_wilsonMeasure`. -/
theorem LandingTube.isProbabilityMeasure_ir_gibbsMeasure
    {P : ContinuumCutoffPath} (T : LandingTube P) (n : ℕ) :
    IsProbabilityMeasure (((T.chain n).state 0).gibbsMeasure) := by
  rw [MultiStepHaarRGChain.gibbsMeasure_eq (T.chain n)
      (canonicalRGChain (T.irSide n) (T.K n) (P.coupling_nonneg n)) 0 (Nat.zero_le _),
    canonicalRGChain_ir_gibbsMeasure_eq_iterated_map_wilsonMeasure
      (T.irSide n) (T.K n) (P.coupling_nonneg n)]
  have : IsProbabilityMeasure
      (wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide (T.irSide n) (T.K n))) (P.coupling n)) :=
    wilsonMeasure_isProbabilityMeasure _ (P.coupling_nonneg n)
      (measurable_wilsonAction (P.coupling n))
  refine ⟨?_⟩
  rw [Measure.map_apply (measurable_iteratedDyadicLinkBlockMapToIR (T.irSide n) (T.K n))
    MeasurableSet.univ, Set.preimage_univ, measure_univ]

/-- **Stage 1B.1 (Tower Property / Relabeling Check):**
Under `h_condexp`, testing against the constant coarse function `c = 1` (the tower property of
conditional expectation) gives `dressedLandedSchwinger T O_loc n F = renormalizedSchwinger Z n F`
identically at every cutoff `n` and for every `F`. -/
theorem DressedLandedComparison.dressedLandedSchwinger_eq_renormalizedSchwinger
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    {Ztr : TrackedRenormalization P T}
    {O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ}
    (hD : DressedLandedComparison T Z Ztr O_loc) (n : ℕ) (F : DisjointLoopFamily) :
    dressedLandedSchwinger T O_loc n F = renormalizedSchwinger Z n F := by
  have h1 := hD.h_condexp n F 1
  simp only [one_mul] at h1
  exact h1

/-- Because `dressedLandedSchwinger T O_loc n F = renormalizedSchwinger Z n F` identically by the
tower property, `DressedLandedComparison.h_cauchy` implies `RenormalizedLoopCauchy Z` and existence
of the continuum Schwinger limit `S : DisjointLoopFamily → ℝ`. Without `h_local` and `h_nondeg`,
`h_condexp` + `h_cauchy` is a relabeling of summable `renormalizedSchwinger` increments. -/
theorem DressedLandedComparison.renormalizedLoopCauchy
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    {Ztr : TrackedRenormalization P T}
    {O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ}
    (hD : DressedLandedComparison T Z Ztr O_loc) :
    RenormalizedLoopCauchy Z ∧
      ∃ S : DisjointLoopFamily → ℝ,
        ∀ F : DisjointLoopFamily, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F)) := by
  have hC : RenormalizedLoopCauchy Z := by
    intro F
    obtain ⟨ε, hsum, hle⟩ := hD.h_cauchy F
    refine cauchySeq_of_summable_dist (Summable.of_nonneg_of_le (fun _ => dist_nonneg) (fun n => ?_) hsum)
    simpa only [hD.dressedLandedSchwinger_eq_renormalizedSchwinger] using hle n
  exact ⟨hC, schwingerConverges_of_cauchy hC⟩

/-- `DressedLandedComparison T Z Ztr O_loc` forces the per-loop factor `Z.factor n ℓ` to be bounded
uniformly in `n` for every loop `ℓ` whose `μ`-side is a multiple of `T.ℓstar`:
evaluating `DressedLandedComparison.renormalizedLoopCauchy` on the repeated two-loop family `⟨[ℓ, ℓ]⟩`
and combining with `LandingTube.eventually_rawSchwinger_duplicate_ge_quarter` (`1 / 4 ≤ rawSchwinger`)
yields `(Z.factor n ℓ) ^ 2 ≤ 4 * (S ⟨[ℓ, ℓ]⟩ + 1)` eventually in `n` and a uniform upper bound
`∀ n : ℕ, Z.factor n ℓ ≤ B`. Only `h_condexp` and `h_cauchy` are used. -/
theorem DressedLandedComparison.exists_factor_bound_of_sideμ_mul_ellstar
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    {Ztr : TrackedRenormalization P T}
    {O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ}
    (hD : DressedLandedComparison T Z Ztr O_loc) {ℓ : PhysicalRectangle}
    (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ)) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ n : ℕ, Z.factor n ℓ ≤ B := by
  obtain ⟨_, S, hS⟩ := hD.renormalizedLoopCauchy
  have h_up : ∀ᶠ n in atTop,
      renormalizedSchwinger Z n ⟨[ℓ, ℓ]⟩ < S ⟨[ℓ, ℓ]⟩ + 1 :=
    (hS ⟨[ℓ, ℓ]⟩).eventually (Iio_mem_nhds (lt_add_one _))
  have h_sq : ∀ᶠ n in atTop, (Z.factor n ℓ) ^ 2 ≤ 4 * (S ⟨[ℓ, ℓ]⟩ + 1) := by
    filter_upwards [h_up, T.eventually_rawSchwinger_duplicate_ge_quarter hℓ] with n hup hq
    rw [renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger,
      LoopRenormalization.familyFactor_duplicate] at hup
    have hmul : (Z.factor n ℓ) ^ 2 * (1 / 4 : ℝ) ≤
        (Z.factor n ℓ) ^ 2 * rawSchwinger P.toCutoffPath n ⟨[ℓ, ℓ]⟩ :=
      mul_le_mul_of_nonneg_left hq (sq_nonneg _)
    unfold rawSchwinger at hmul
    linarith
  have h_lin_ev : ∀ᶠ n in atTop, Z.factor n ℓ ≤ 4 * (S ⟨[ℓ, ℓ]⟩ + 1) + 1 := by
    filter_upwards [h_sq] with n hn
    have h_le_sq_add_one : Z.factor n ℓ ≤ (Z.factor n ℓ) ^ 2 + 1 := by
      nlinarith [sq_nonneg (Z.factor n ℓ - 1), Z.factor_pos n ℓ]
    linarith
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.mp h_lin_ev
  let B₁ : ℝ := 4 * (S ⟨[ℓ, ℓ]⟩ + 1) + 1
  let B₀ : ℝ := ∑ m ∈ Finset.range N₀, Z.factor m ℓ
  have hB₀_nonneg : 0 ≤ B₀ := Finset.sum_nonneg (fun m _ => (Z.factor_pos m ℓ).le)
  refine ⟨max B₁ B₀, le_max_of_le_right hB₀_nonneg, fun n => ?_⟩
  by_cases hn : N₀ ≤ n
  · exact (hN₀ n hn).trans (le_max_left B₁ B₀)
  · exact (Finset.single_le_sum (fun m _ => (Z.factor_pos m ℓ).le)
      (Finset.mem_range.mpr (not_le.mp hn))).trans (le_max_right B₁ B₀)

/-- Repeated-loop refutation of `DressedLandedComparison T Z Ztr O_loc` for any loop renormalization
`Z` whose per-loop factor `Z.factor n ℓ` is unbounded in `n` on a loop `ℓ` whose `μ`-side is a
multiple of `T.ℓstar`. The unboundedness hypothesis is satisfiable (for instance by
`perimeterCornerRenormalization` with `m n = n` and `c = 0`). -/
theorem not_dressedLandedComparison_of_unbounded_factor
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ)
    {ℓ : PhysicalRectangle} (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ))
    (hunb : ∀ B : ℝ, ∃ n : ℕ, B < Z.factor n ℓ) :
    ¬ DressedLandedComparison T Z Ztr O_loc := by
  intro hD
  obtain ⟨B, _, hB⟩ := hD.exists_factor_bound_of_sideμ_mul_ellstar hℓ
  obtain ⟨n, hn⟩ := hunb B
  linarith [hB n]

/-- Repeated-loop refutation of `DressedLandedComparison T Z Ztr O_loc` whenever
`Z.factor n ℓ → +∞` on a loop `ℓ` whose `μ`-side is a multiple of `T.ℓstar`. -/
theorem not_dressedLandedComparison_of_tendsto_factor_atTop
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ)
    {ℓ : PhysicalRectangle} (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ))
    (hdiv : Tendsto (fun n => Z.factor n ℓ) atTop atTop) :
    ¬ DressedLandedComparison T Z Ztr O_loc :=
  not_dressedLandedComparison_of_unbounded_factor T Z Ztr O_loc hℓ
    (fun B => (hdiv.eventually (eventually_gt_atTop B)).exists)

/-- Repeated-loop refutation of
`DressedLandedComparison T (perimeterCornerRenormalization P.toCutoffPath m c) Ztr O_loc`
whenever the perimeter-corner exponent `m n * (2 * (ℓ.sideμ + ℓ.sideν)) + 4 * c n → +∞` for a loop
`ℓ` whose `μ`-side is a multiple of `T.ℓstar`. -/
theorem not_dressedLandedComparison_of_perimeterCorner_tendsto_atTop
    {P : ContinuumCutoffPath} (T : LandingTube P) (m c : ℕ → ℝ) (Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ)
    {ℓ : PhysicalRectangle} (hℓ : ∃ k : ℕ, (ℓ.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ))
    (hdiv : Tendsto (fun n => m n * (2 * ((ℓ.sideμ : ℝ) + (ℓ.sideν : ℝ))) + 4 * c n) atTop atTop) :
    ¬ DressedLandedComparison T (perimeterCornerRenormalization P.toCutoffPath m c) Ztr O_loc := by
  refine not_dressedLandedComparison_of_tendsto_factor_atTop T _ Ztr O_loc hℓ ?_
  simpa [perimeterCornerRenormalization] using hdiv

/-- Repeated-loop refutation of
`DressedLandedComparison T (perimeterCornerRenormalization P.toCutoffPath m c) Ztr O_loc`
whenever `m n → +∞` and `c` is eventually bounded below. The hypotheses are satisfiable
(e.g. `m n = n`, `c = 0` gives a divergent perimeter). -/
theorem not_dressedLandedComparison_of_perimeter_tendsto_atTop_and_corner_bddBelow
    {P : ContinuumCutoffPath} (T : LandingTube P) (m c : ℕ → ℝ)
    (Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ)
    (hm : Tendsto m atTop atTop)
    (hc : ∃ c_lo : ℝ, ∀ᶠ n in atTop, c_lo ≤ c n) :
    ¬ DressedLandedComparison T (perimeterCornerRenormalization P.toCutoffPath m c) Ztr O_loc := by
  obtain ⟨c_lo, hc_lo⟩ := hc
  let ℓ₀ : PhysicalRectangle :=
    { base := fun _ => 1
      μ := 0
      ν := 1
      plane := by decide
      sideμ := T.ℓstar
      sideν := T.ℓstar
      sideμ_pos := T.hℓstar
      sideν_pos := T.hℓstar }
  have hℓ₀ : ∃ k : ℕ, (ℓ₀.sideμ : ℝ) = (k : ℝ) * (T.ℓstar : ℝ) := ⟨1, by simp [ℓ₀]⟩
  have hL_pos : (0 : ℝ) < 2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ)) := by
    have hℓstar_pos : (0 : ℝ) < (T.ℓstar : ℝ) := Rat.cast_pos.mpr T.hℓstar
    dsimp [ℓ₀]
    linarith
  have hm_mul : Tendsto (fun n => m n * (2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ)))) atTop atTop :=
    Tendsto.atTop_mul_const hL_pos hm
  have hm_add :
      Tendsto (fun n => m n * (2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ))) + 4 * c_lo) atTop atTop :=
    tendsto_atTop_add_const_right atTop (4 * c_lo) hm_mul
  have hdiv :
      Tendsto (fun n => m n * (2 * ((ℓ₀.sideμ : ℝ) + (ℓ₀.sideν : ℝ))) + 4 * c n) atTop atTop := by
    refine tendsto_atTop_mono' atTop ?_ hm_add
    filter_upwards [hc_lo] with n hn
    linarith
  exact not_dressedLandedComparison_of_perimeterCorner_tendsto_atTop T m c Ztr O_loc hℓ₀ hdiv

/-- Tube-level repeated-loop refutation of `DressedLandedComparison T Z Ztr O_loc` via `hD.hZ_eq`:
whenever `T.Z_tube = perimeterCornerRenormalization P.toCutoffPath m c` with `m n → +∞` and `c`
eventually bounded below (satisfiable, e.g. `m n = n`, `c = 0`), no `Z`, `Ztr`, or `O_loc` can
satisfy `DressedLandedComparison T Z Ztr O_loc`. -/
theorem not_dressedLandedComparison_of_tube_perimeter_tendsto_atTop
    {P : ContinuumCutoffPath} (T : LandingTube P) (m c : ℕ → ℝ)
    (hT : T.Z_tube = perimeterCornerRenormalization P.toCutoffPath m c)
    (hm : Tendsto m atTop atTop) (hc : ∃ c_lo : ℝ, ∀ᶠ n in atTop, c_lo ≤ c n)
    (Z : LoopRenormalization P.toCutoffPath) (Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ) :
    ¬ DressedLandedComparison T Z Ztr O_loc := by
  intro hD
  have hZ : Z = perimeterCornerRenormalization P.toCutoffPath m c := hD.hZ_eq.trans hT
  subst hZ
  exact not_dressedLandedComparison_of_perimeter_tendsto_atTop_and_corner_bddBelow
    T m c Ztr O_loc hm hc hD

/-- Explicit relabeling witness: the constant coarse observable
`O_const n F _ := renormalizedSchwinger Z n F` satisfies the conditional-expectation identity
`h_condexp` unconditionally, satisfies the summable-increment Cauchy field if and only if
`∀ F, ∃ ε, Summable ε ∧ ∀ n, dist (renormalizedSchwinger Z n F) (renormalizedSchwinger Z (n + 1) F) ≤ ε n`,
and has vanishing coarse covariance `irCov = 0` (so `h_nondeg` is the field that excludes it).
That exclusion applies only to this purely constant witness; adding the mean-zero coarse fluctuation
(`cheapDressedObservable`, see `constantPlusFluctuation_inhabits_except_cauchy`) restores `h_nondeg`
from `T.h_floor`. -/
theorem constantCoarseObservable_relabeling_and_zero_irCov
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath) :
    let O_const : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ :=
      fun n F _ => renormalizedSchwinger Z n F
    (∀ (n : ℕ) (F : DisjointLoopFamily) (c : ℝ),
      (∫ V, c * O_const n F V ∂(((T.chain n).state 0).gibbsMeasure)) =
        ∫ U, c * F.eval Z n U ∂(P.toCutoffPath.configLaw n : Measure (GaugeConfig (P.side n)))) ∧
    (∀ (n : ℕ) (F : DisjointLoopFamily),
      dressedLandedSchwinger T O_const n F = renormalizedSchwinger Z n F) ∧
    ((∀ F : DisjointLoopFamily,
      ∃ ε : ℕ → ℝ, Summable ε ∧
        ∀ n : ℕ,
          dist (dressedLandedSchwinger T O_const n F)
            (dressedLandedSchwinger T O_const (n + 1) F) ≤ ε n) ↔
      (∀ F : DisjointLoopFamily,
        ∃ ε : ℕ → ℝ, Summable ε ∧
          ∀ n : ℕ,
            dist (renormalizedSchwinger Z n F)
              (renormalizedSchwinger Z (n + 1) F) ≤ ε n)) ∧
    (∀ (n : ℕ) (F G : DisjointLoopFamily),
      irCov ((T.chain n).state 0).gibbsMeasure (O_const n F) (O_const n G) = 0) := by
  dsimp only
  have h_eval (n : ℕ) (F : DisjointLoopFamily) :
      dressedLandedSchwinger T (fun m G _ => renormalizedSchwinger Z m G) n F =
        renormalizedSchwinger Z n F := by
    have := T.isProbabilityMeasure_ir_gibbsMeasure n
    unfold dressedLandedSchwinger
    rw [integral_const, probReal_univ, one_smul]
  refine ⟨fun n F c => ?_, h_eval, ?_, fun n F G => ?_⟩
  · have := T.isProbabilityMeasure_ir_gibbsMeasure n
    rw [integral_const, probReal_univ, one_smul, integral_const_mul]
    rfl
  · simp only [h_eval]
  · have := T.isProbabilityMeasure_ir_gibbsMeasure n
    unfold irCov
    rw [integral_const, probReal_univ, one_smul, integral_const, probReal_univ, one_smul,
      integral_const, probReal_univ, one_smul, sub_self]

theorem mem_latticePathSupport_replicate_forward_site {L : ℕ} (d : Direction) :
    ∀ (r : ℕ) (x : Lattice4D L) (m₀ : Fin 4 → ℤ),
      x = latticeSite L m₀ →
      ∀ {e : Link L}, e ∈ latticePathSupport L x (List.replicate r ⟨d, true⟩) →
      ∃ j ≤ r, e.x = latticeSite L (m₀ + (j : ℤ) • z4UnitVec d)
  | 0, _, _, _, _, he => by simp [latticePathSupport] at he
  | k + 1, x, m₀, hx, e, he => by
      rw [List.replicate_succ] at he
      dsimp [latticePathSupport] at he
      rcases Finset.mem_insert.mp he with rfl | he_tail
      · refine ⟨0, Nat.zero_le _, ?_⟩
        simpa [latticeStepLink] using hx
      · have hx_next : stepTarget x ⟨d, true⟩ = latticeSite L (m₀ + z4UnitVec d) := by
          funext i
          change x i + unitVec L d i = ((m₀ i + z4UnitVec d i : ℤ) : ZMod L)
          rw [hx]
          by_cases h : i = d <;> simp [latticeSite, unitVec, z4UnitVec, h]
        rcases mem_latticePathSupport_replicate_forward_site d k
            (stepTarget x ⟨d, true⟩) (m₀ + z4UnitVec d) hx_next he_tail with ⟨j, hj, hj_eq⟩
        refine ⟨j + 1, Nat.succ_le_succ hj, ?_⟩
        rw [hj_eq]
        congr 1
        push_cast
        rw [add_smul, one_smul]
        abel

theorem mem_latticePathSupport_replicate_backward_site {L : ℕ} (d : Direction) :
    ∀ (r : ℕ) (x : Lattice4D L) (m₀ : Fin 4 → ℤ),
      x = latticeSite L (m₀ + (r : ℤ) • z4UnitVec d) →
      ∀ {e : Link L}, e ∈ latticePathSupport L x (List.replicate r ⟨d, false⟩) →
      ∃ j ≤ r, e.x = latticeSite L (m₀ + (j : ℤ) • z4UnitVec d)
  | 0, _, _, _, _, he => by simp [latticePathSupport] at he
  | k + 1, x, m₀, hx, e, he => by
      rw [List.replicate_succ] at he
      dsimp [latticePathSupport] at he
      have hx_sub : x - unitVec L d = latticeSite L (m₀ + (k : ℤ) • z4UnitVec d) := by
        funext i
        change x i - unitVec L d i = ((m₀ i + (k : ℤ) * z4UnitVec d i : ℤ) : ZMod L)
        rw [hx]
        by_cases h : i = d
        · subst h
          simp [latticeSite, unitVec, z4UnitVec]
          ring
        · simp [latticeSite, unitVec, z4UnitVec, h]
      rcases Finset.mem_insert.mp he with rfl | he_tail
      · exact ⟨k, Nat.le_succ k, by simpa [latticeStepLink] using hx_sub⟩
      · have hx_next : stepTarget x ⟨d, false⟩ = latticeSite L (m₀ + (k : ℤ) • z4UnitVec d) := by
          change x + -unitVec L d = _
          rw [← sub_eq_add_neg]
          exact hx_sub
        rcases mem_latticePathSupport_replicate_backward_site d k
            (stepTarget x ⟨d, false⟩) m₀ hx_next he_tail with ⟨j, hj, hj_eq⟩
        exact ⟨j, Nat.le_succ_of_le hj, hj_eq⟩

theorem pathTarget_latticeSite_replicate_forward {L : ℕ} (m₀ : Fin 4 → ℤ) (d : Direction) (r : ℕ) :
    pathTarget (latticeSite L m₀) (List.replicate r ⟨d, true⟩) =
      latticeSite L (m₀ + (r : ℤ) • z4UnitVec d) := by
  rw [pathTarget_replicate]
  funext i
  by_cases h : i = d <;> simp [latticeSite, LatticeStep.displacement, unitVec, z4UnitVec, h]

theorem mem_physicalRectangleSupport_site_lift
    (L : ℕ) (a : ℝ) (ℓ : PhysicalRectangle) {e : Link L}
    (he : e ∈ physicalRectangleSupport L a ℓ) :
    ∃ (jμ jν : ℕ),
      jμ ≤ ℓ.stepsμ a ∧ jν ≤ ℓ.stepsν a ∧
      e.x = latticeSite L
        (ℓ.latticeBase a + (jμ : ℤ) • z4UnitVec ℓ.μ + (jν : ℤ) • z4UnitVec ℓ.ν) := by
  set m₀ := ℓ.latticeBase a
  set r := ℓ.stepsμ a
  set s := ℓ.stepsν a
  have hloop :
      ℓ.latticeLoop a =
        List.replicate r ⟨ℓ.μ, true⟩ ++ List.replicate s ⟨ℓ.ν, true⟩ ++
          List.replicate r ⟨ℓ.μ, false⟩ ++ List.replicate s ⟨ℓ.ν, false⟩ := rfl
  unfold physicalRectangleSupport at he
  rw [hloop, latticePathSupport_append, latticePathSupport_append,
    latticePathSupport_append] at he
  have hx1 :
      pathTarget (latticeSite L m₀) (List.replicate r ⟨ℓ.μ, true⟩) =
        latticeSite L (m₀ + (r : ℤ) • z4UnitVec ℓ.μ) :=
    pathTarget_latticeSite_replicate_forward m₀ ℓ.μ r
  have hx2 :
      pathTarget (latticeSite L m₀)
        (List.replicate r ⟨ℓ.μ, true⟩ ++ List.replicate s ⟨ℓ.ν, true⟩) =
        latticeSite L ((m₀ + (s : ℤ) • z4UnitVec ℓ.ν) + (r : ℤ) • z4UnitVec ℓ.μ) := by
    rw [pathTarget_append, hx1,
      pathTarget_latticeSite_replicate_forward (m₀ + (r : ℤ) • z4UnitVec ℓ.μ) ℓ.ν s]
    congr 1
    abel
  have hx3 :
      pathTarget (latticeSite L m₀)
        (List.replicate r ⟨ℓ.μ, true⟩ ++ List.replicate s ⟨ℓ.ν, true⟩ ++
          List.replicate r ⟨ℓ.μ, false⟩) =
        latticeSite L (m₀ + (s : ℤ) • z4UnitVec ℓ.ν) := by
    rw [pathTarget_append, hx2, pathTarget_replicate]
    funext i
    by_cases h : i = ℓ.μ <;> simp [latticeSite, LatticeStep.displacement, unitVec, z4UnitVec, h]
  rcases Finset.mem_union.mp he with he123 | he4
  · rcases Finset.mem_union.mp he123 with he12 | he3
    · rcases Finset.mem_union.mp he12 with he1 | he2
      · obtain ⟨jμ, hjμ, h_eq⟩ :=
          mem_latticePathSupport_replicate_forward_site ℓ.μ r (latticeSite L m₀) m₀ rfl he1
        exact ⟨jμ, 0, hjμ, Nat.zero_le _, by simpa using h_eq⟩
      · obtain ⟨jν, hjν, h_eq⟩ :=
          mem_latticePathSupport_replicate_forward_site ℓ.ν s _
            (m₀ + (r : ℤ) • z4UnitVec ℓ.μ) hx1 he2
        exact ⟨r, jν, le_rfl, hjν, h_eq⟩
    · obtain ⟨jμ, hjμ, h_eq⟩ :=
        mem_latticePathSupport_replicate_backward_site ℓ.μ r _
          (m₀ + (s : ℤ) • z4UnitVec ℓ.ν) hx2 he3
      refine ⟨jμ, s, hjμ, le_rfl, h_eq.trans ?_⟩
      congr 1
      abel
  · obtain ⟨jν, hjν, h_eq⟩ :=
      mem_latticePathSupport_replicate_backward_site ℓ.ν s _ m₀ hx3 he4
    exact ⟨0, jν, Nat.zero_le _, hjν, by simpa using h_eq⟩

/-- Every link `e ∈ physicalRectangleSupport L (a : ℝ) ℓ` (`0 < a`) lies in the unrounded coarse
neighborhood `InUnroundedLoopNeighborhood L a 1 ℓ e` of radius `R_loc = 1`. -/
theorem inUnroundedLoopNeighborhood_one_of_mem_physicalRectangleSupport
    (L : ℕ) {a : ℚ} (ha : 0 < a) (ℓ : PhysicalRectangle) {e : Link L}
    (he : e ∈ physicalRectangleSupport L (a : ℝ) ℓ) :
    InUnroundedLoopNeighborhood L a 1 ℓ e := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  obtain ⟨jμ, jν, hjμ, hjν, hex⟩ := mem_physicalRectangleSupport_site_lift L (a : ℝ) ℓ he
  refine ⟨ℓ.latticeBase (a : ℝ) + (jμ : ℤ) • z4UnitVec ℓ.μ + (jν : ℤ) • z4UnitVec ℓ.ν,
    hex.symm, fun i => ?_⟩
  set k := ℓ.latticeBase (a : ℝ) + (jμ : ℤ) • z4UnitVec ℓ.μ + (jν : ℤ) • z4UnitVec ℓ.ν
  set S : ℚ := if i = ℓ.μ then ℓ.sideμ else if i = ℓ.ν then ℓ.sideν else 0
  have h_base := physical_base_discretization (ℓ.base i : ℝ) ha_real
  change (a : ℝ) * (ℓ.latticeBase (a : ℝ) i : ℝ) ≤ (ℓ.base i : ℝ) ∧
    (ℓ.base i : ℝ) < (a : ℝ) * (ℓ.latticeBase (a : ℝ) i : ℝ) + (a : ℝ) at h_base
  have h_sμ := (physical_side_discretization (Rat.cast_nonneg.mpr ℓ.sideμ_pos.le) ha_real).1
  change (a : ℝ) * (ℓ.stepsμ (a : ℝ) : ℝ) ≤ (ℓ.sideμ : ℝ) at h_sμ
  have h_sν := (physical_side_discretization (Rat.cast_nonneg.mpr ℓ.sideν_pos.le) ha_real).1
  change (a : ℝ) * (ℓ.stepsν (a : ℝ) : ℝ) ≤ (ℓ.sideν : ℝ) at h_sν
  have hμν : ℓ.μ ≠ ℓ.ν := ℓ.plane.ne
  have hk_lo : (ℓ.latticeBase (a : ℝ) i : ℝ) ≤ (k i : ℝ) := by
    have h_uμ : 0 ≤ z4UnitVec ℓ.μ i := by unfold z4UnitVec; split_ifs <;> omega
    have h_uν : 0 ≤ z4UnitVec ℓ.ν i := by unfold z4UnitVec; split_ifs <;> omega
    have hk_int : ℓ.latticeBase (a : ℝ) i ≤ k i := by
      change ℓ.latticeBase (a : ℝ) i ≤
        ℓ.latticeBase (a : ℝ) i + (jμ : ℤ) * z4UnitVec ℓ.μ i + (jν : ℤ) * z4UnitVec ℓ.ν i
      nlinarith
    exact Int.cast_le.mpr hk_int
  have hk_hi : (a : ℝ) * (k i : ℝ) ≤ (a : ℝ) * (ℓ.latticeBase (a : ℝ) i : ℝ) + (S : ℝ) := by
    by_cases h1 : i = ℓ.μ
    · have hk_eq : (k i : ℝ) = (ℓ.latticeBase (a : ℝ) i : ℝ) + (jμ : ℝ) := by
        change ((ℓ.latticeBase (a : ℝ) i + (jμ : ℤ) * (if i = ℓ.μ then 1 else 0) +
          (jν : ℤ) * (if i = ℓ.ν then 1 else 0) : ℤ) : ℝ) = _
        simp only [h1, hμν, ↓reduceIte]
        push_cast
        ring
      have hS_eq : (S : ℝ) = (ℓ.sideμ : ℝ) := by
        dsimp [S]
        simp only [h1, ↓reduceIte]
      have hjμ_real : (jμ : ℝ) ≤ (ℓ.stepsμ (a : ℝ) : ℝ) := Nat.cast_le.mpr hjμ
      rw [hk_eq, hS_eq]
      nlinarith
    · by_cases h2 : i = ℓ.ν
      · have hk_eq : (k i : ℝ) = (ℓ.latticeBase (a : ℝ) i : ℝ) + (jν : ℝ) := by
          change ((ℓ.latticeBase (a : ℝ) i + (jμ : ℤ) * (if i = ℓ.μ then 1 else 0) +
            (jν : ℤ) * (if i = ℓ.ν then 1 else 0) : ℤ) : ℝ) = _
          simp only [h1, ↓reduceIte]
          simp only [h2, ↓reduceIte]
          push_cast
          ring
        have hS_eq : (S : ℝ) = (ℓ.sideν : ℝ) := by
          dsimp [S]
          simp only [h1, ↓reduceIte]
          simp only [h2, ↓reduceIte]
        have hjν_real : (jν : ℝ) ≤ (ℓ.stepsν (a : ℝ) : ℝ) := Nat.cast_le.mpr hjν
        rw [hk_eq, hS_eq]
        nlinarith
      · have hk_eq : (k i : ℝ) = (ℓ.latticeBase (a : ℝ) i : ℝ) := by
          change ((ℓ.latticeBase (a : ℝ) i + (jμ : ℤ) * (if i = ℓ.μ then 1 else 0) +
            (jν : ℤ) * (if i = ℓ.ν then 1 else 0) : ℤ) : ℝ) = _
          simp only [h1, h2, ↓reduceIte]
          push_cast
          ring
        have hS_eq : (S : ℝ) = 0 := by
          dsimp [S]
          simp only [h1, h2, ↓reduceIte, Rat.cast_zero]
        rw [hk_eq, hS_eq, add_zero]
  constructor
  · exact_mod_cast (by nlinarith : (ℓ.base i : ℝ) - 1 * (a : ℝ) ≤ (k i : ℝ) * (a : ℝ))
  · exact_mod_cast (by nlinarith : (k i : ℝ) * (a : ℝ) ≤ (ℓ.base i : ℝ) + (S : ℝ) + 1 * (a : ℝ))

/-- Constant-plus-fluctuation relabeling witness
`O_cheap n F V := renormalizedSchwinger Z n F + (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F V - landedIrSchwinger T Z n F)`. -/
noncomputable def cheapDressedObservable {P : ContinuumCutoffPath}
    (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath) :
    (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ :=
  fun n F V => renormalizedSchwinger Z n F +
    (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F V - landedIrSchwinger T Z n F)

/-- VACUOUS-CONTROL: `cheapDressedObservable` meets `h_condexp`, `h_local` and (given `T.h_floor`) `h_nondeg`
of `DressedLandedComparison`; its `h_cauchy` is exactly summable increments of `renormalizedSchwinger Z · F`.
So the structure is "Cauchy + T.h_floor" renamed (inhabited iff those hold, given Ztr). -/
theorem constantPlusFluctuation_inhabits_except_cauchy
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (Ztr : TrackedRenormalization P T) (hZ : Z = T.Z_tube) :
    (DressedLandedComparison T Z Ztr (cheapDressedObservable T Z) ↔
      ∀ F : DisjointLoopFamily,
        ∃ ε : ℕ → ℝ, Summable ε ∧
          ∀ n : ℕ,
            dist (renormalizedSchwinger Z n F) (renormalizedSchwinger Z (n + 1) F) ≤ ε n) := by
  have h_int (n : ℕ) (F : DisjointLoopFamily) :
      Integrable (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F)
        (((T.chain n).state 0).gibbsMeasure) := by
    have := T.isProbabilityMeasure_ir_gibbsMeasure n
    refine Integrable.of_bound
      (continuous_irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F).aestronglyMeasurable 1
      (Eventually.of_forall fun V => ?_)
    rw [Real.norm_eq_abs]
    exact abs_irLoopFamilyObservable_le_one (T.irSide n) (T.ℓstar : ℝ) F V
  have h_eval (n : ℕ) (F : DisjointLoopFamily) :
      dressedLandedSchwinger T (cheapDressedObservable T Z) n F = renormalizedSchwinger Z n F := by
    have := T.isProbabilityMeasure_ir_gibbsMeasure n
    unfold dressedLandedSchwinger cheapDressedObservable
    have h_fluct :
        Integrable
          (fun V => irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F V - landedIrSchwinger T Z n F)
          (((T.chain n).state 0).gibbsMeasure) :=
      (h_int n F).sub (integrable_const _)
    rw [integral_add (integrable_const _) h_fluct,
      integral_sub (h_int n F) (integrable_const _),
      integral_const, integral_const, probReal_univ, one_smul, one_smul]
    unfold landedIrSchwinger
    ring
  constructor
  · intro hD F
    obtain ⟨ε, hsum, hle⟩ := hD.h_cauchy F
    refine ⟨ε, hsum, fun n => ?_⟩
    simpa only [h_eval] using hle n
  · intro h_cauchy
    refine
      { hZ_eq := hZ
        h_condexp := fun n F c => ?_
        h_local := ⟨1, by norm_num, fun n F e h_not_nbhd => ?_⟩
        h_cauchy := fun F => ?_
        h_nondeg := ⟨T.c_floor, T.hc_floor, ?_⟩ }
    · rw [integral_const_mul, integral_const_mul]
      exact congrArg (c * ·) (h_eval n F)
    · have h_not_mem : e ∉ physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ) F.loops := by
        intro he
        rw [mem_physicalLoopListSupport_iff] at he
        obtain ⟨ℓ, hℓ, heℓ⟩ := he
        exact h_not_nbhd ℓ hℓ
          (inUnroundedLoopNeighborhood_one_of_mem_physicalRectangleSupport
            (T.irSide n) T.hℓstar ℓ heℓ)
      refine linkOscillation_eq_zero_of_independent SU2 (cheapDressedObservable T Z n F) e ?_
      intro V g1 g2
      unfold cheapDressedObservable irLoopFamilyObservable
      rw [list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem
          (T.ℓstar : ℝ) V g1 F.loops h_not_mem,
        list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem
          (T.ℓstar : ℝ) V g2 F.loops h_not_mem]
    · obtain ⟨ε, hsum, hle⟩ := h_cauchy F
      refine ⟨ε, hsum, fun n => ?_⟩
      simpa only [h_eval] using hle n
    · filter_upwards [T.h_floor] with n hn
      have := T.isProbabilityMeasure_ir_gibbsMeasure n
      let f := physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect
      let g := physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe
      have hf_eq : irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[T.ℓ_probe.timeReflect]⟩ = f := by
        funext V
        simp [irLoopFamilyObservable, f]
      have hg_eq : irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[T.ℓ_probe]⟩ = g := by
        funext V
        simp [irLoopFamilyObservable, g]
      have h_prod_eq :
          (fun V => f V * g V) =
            irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) ⟨[T.ℓ_probe.timeReflect, T.ℓ_probe]⟩ := by
        funext V
        simp [irLoopFamilyObservable, f, g]
      have hf_int : Integrable f (((T.chain n).state 0).gibbsMeasure) :=
        hf_eq ▸ h_int n ⟨[T.ℓ_probe.timeReflect]⟩
      have hg_int : Integrable g (((T.chain n).state 0).gibbsMeasure) :=
        hg_eq ▸ h_int n ⟨[T.ℓ_probe]⟩
      have hfg_int : Integrable (fun V => f V * g V) (((T.chain n).state 0).gibbsMeasure) :=
        h_prod_eq.symm ▸ h_int n ⟨[T.ℓ_probe.timeReflect, T.ℓ_probe]⟩
      have h_cheap_f :
          cheapDressedObservable T Z n ⟨[T.ℓ_probe.timeReflect]⟩ =
            fun V => f V + (renormalizedSchwinger Z n ⟨[T.ℓ_probe.timeReflect]⟩ -
              landedIrSchwinger T Z n ⟨[T.ℓ_probe.timeReflect]⟩) := by
        funext V
        unfold cheapDressedObservable
        rw [hf_eq]
        ring
      have h_cheap_g :
          cheapDressedObservable T Z n ⟨[T.ℓ_probe]⟩ =
            fun V => g V + (renormalizedSchwinger Z n ⟨[T.ℓ_probe]⟩ -
              landedIrSchwinger T Z n ⟨[T.ℓ_probe]⟩) := by
        funext V
        unfold cheapDressedObservable
        rw [hg_eq]
        ring
      rw [h_cheap_f, h_cheap_g, irCov_add_const _ hf_int hg_int hfg_int]
      exact hn

/-- **Stage 1B.2 (Mandatory Negative Control — Rounded `O_loc` Refutation):**
If `O_loc` depends on loop families only through their `T.ℓstar`-rounded coarse data
`(ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ))` (`h_rounded`) and factors
multiplicatively on two-loop pairs (`h_pair`), then the Stage 1–3 quarter/three-quarter shift
argument transfers verbatim to `dressedLandedSchwinger T O_loc` and refutes
`DressedLandedComparison T Z Ztr O_loc` under landed covariance decay (`h_decay`). -/
theorem not_dressedLandedComparison_of_rounded_O_loc_and_decay
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ)
    (h_rounded :
      ∀ (n : ℕ) (F G : DisjointLoopFamily),
        F.loops.map (fun ℓ => (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ))) =
          G.loops.map (fun ℓ => (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ))) →
          O_loc n F = O_loc n G)
    (h_pair :
      ∀ (n : ℕ) (ℓ₁ ℓ₂ : PhysicalRectangle) (V : GaugeConfig (T.irSide n)),
        O_loc n ⟨[ℓ₁, ℓ₂]⟩ V = O_loc n ⟨[ℓ₁]⟩ V * O_loc n ⟨[ℓ₂]⟩ V)
    (h_decay :
      ∃ C_decay : ℝ, 0 ≤ C_decay ∧
        ∀ (t : ℕ), ∀ᶠ n in atTop,
          |irCov ((T.chain n).state 0).gibbsMeasure
            (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩)
            (O_loc n ⟨[T.ℓ_probe.translate (timeShift (t * T.ℓstar))]⟩)| ≤
            C_decay * (landingTubeContraction T) ^ t) :
    ¬ DressedLandedComparison T Z Ztr O_loc := by
  intro hD
  obtain ⟨_, S, hS⟩ := hD.renormalizedLoopCauchy
  have hL (F : DisjointLoopFamily) :
      Tendsto (fun n => dressedLandedSchwinger T O_loc n F) atTop (𝓝 (S F)) :=
    (hS F).congr fun n => (hD.dressedLandedSchwinger_eq_renormalizedSchwinger n F).symm
  have hS_tr (F : DisjointLoopFamily)
      (hF : ∀ ℓ ∈ F.loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base)
      (c : Fin 4 → ℚ) :
      S (F.translate c) = S F := by
    have h_ev : ∀ᶠ n in atTop,
        renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
      rw [hD.hZ_eq]
      exact (T.eventually_forall_translate_eq_of_dyadic_base F hF).mono fun _ hn => hn c
    exact tendsto_nhds_unique (hS (F.translate c)) ((hS F).congr' (h_ev.mono fun _ h => h.symm))
  set R := rectWithTimeFract T.ℓstar (1 / 4) T.ℓ_probe.timeReflect
  set L_step := fun k : ℕ =>
    (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe).translate (timeShift ((k : ℚ) * T.ℓstar))
  set G_step := fun k : ℕ => quarterThreeQuarterPairFamily T.ℓstar T.ℓ_probe.timeReflect T.ℓ_probe k
  have hR_dyad : IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ 2) R.base := by
    simpa [R] using isLatticeVector_quarter_rectWithTimeFract T.ℓstar 1 T.ℓ_probe.timeReflect
  have hL_dyad (k : ℕ) : IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ 2) (L_step k).base := by
    refine isLatticeVector_quarter_translate_timeShift_nat_mul T.ℓstar k ?_
    simpa using isLatticeVector_quarter_rectWithTimeFract T.ℓstar 3 T.ℓ_probe
  have hG_dyad (k : ℕ) :
      ∀ ℓ ∈ (G_step k).loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base := by
    intro ℓ hℓ
    simp only [G_step, quarterThreeQuarterPairFamily, List.mem_cons, List.not_mem_nil,
      or_false] at hℓ
    rcases hℓ with rfl | rfl
    · exact ⟨2, hR_dyad⟩
    · exact ⟨2, hL_dyad k⟩
  have hL_fam_dyad (k : ℕ) :
      ∀ ℓ ∈ (⟨[L_step k]⟩ : DisjointLoopFamily).loops,
        ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base := by
    intro ℓ hℓ
    rcases List.mem_singleton.mp hℓ with rfl
    exact ⟨2, hL_dyad k⟩
  have h_round_G (k n : ℕ) :
      O_loc n ((G_step k).translate (timeShift (T.ℓstar / 2))) = O_loc n (G_step (k + 1)) := by
    apply h_rounded
    simp only [G_step, quarterThreeQuarterPairFamily, DisjointLoopFamily.translate,
      List.map_cons, List.map_nil]
    rw [latticeBase_translate_half_rectWithTimeFract_quarter T.hℓstar T.ℓ_probe.timeReflect,
      latticeBase_translate_half_rectWithTimeFract_threeQuarter T.hℓstar T.ℓ_probe k]
    rfl
  have h_round_L (k n : ℕ) :
      O_loc n ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
        O_loc n ⟨[L_step (k + 1)]⟩ := by
    apply h_rounded
    simp only [L_step, DisjointLoopFamily.translate, List.map_cons, List.map_nil]
    rw [latticeBase_translate_half_rectWithTimeFract_threeQuarter T.hℓstar T.ℓ_probe k]
    rfl
  have hS_G_step (k : ℕ) : S (G_step (k + 1)) = S (G_step k) := by
    have h_tr_eq := hS_tr (G_step k) (hG_dyad k) (timeShift (T.ℓstar / 2))
    have h_lim_eq :
        S ((G_step k).translate (timeShift (T.ℓstar / 2))) = S (G_step (k + 1)) :=
      tendsto_nhds_unique (hL ((G_step k).translate (timeShift (T.ℓstar / 2))))
        ((hL (G_step (k + 1))).congr fun n => by
          unfold dressedLandedSchwinger
          rw [h_round_G k n])
    exact h_lim_eq.symm.trans h_tr_eq
  have hS_L_step (k : ℕ) : S ⟨[L_step (k + 1)]⟩ = S ⟨[L_step k]⟩ := by
    have h_tr_eq := hS_tr ⟨[L_step k]⟩ (hL_fam_dyad k) (timeShift (T.ℓstar / 2))
    have h_lim_eq :
        S ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
          S ⟨[L_step (k + 1)]⟩ :=
      tendsto_nhds_unique
        (hL ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))))
        ((hL ⟨[L_step (k + 1)]⟩).congr fun n => by
          unfold dressedLandedSchwinger
          rw [h_round_L k n])
    exact h_lim_eq.symm.trans h_tr_eq
  have hS_G_eq (k : ℕ) : S (G_step k) = S (G_step 0) := by
    induction k with
    | zero => rfl
    | succ j ih => exact (hS_G_step j).trans ih
  have hS_L_eq (k : ℕ) : S ⟨[L_step k]⟩ = S ⟨[L_step 0]⟩ := by
    induction k with
    | zero => rfl
    | succ j ih => exact (hS_L_step j).trans ih
  have h_cov_eq (k n : ℕ) :
      dressedLandedSchwinger T O_loc n (G_step k) -
        dressedLandedSchwinger T O_loc n ⟨[R]⟩ * dressedLandedSchwinger T O_loc n ⟨[L_step k]⟩ =
      irCov ((T.chain n).state 0).gibbsMeasure (O_loc n ⟨[R]⟩) (O_loc n ⟨[L_step k]⟩) := by
    unfold dressedLandedSchwinger irCov
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun V => ?_)
    exact h_pair n R (L_step k) V
  have hR_probe (n : ℕ) : O_loc n ⟨[R]⟩ = O_loc n ⟨[T.ℓ_probe.timeReflect]⟩ := by
    apply h_rounded
    simp only [R, List.map_cons, List.map_nil]
    rw [rectWithTimeFract_latticeBase_eq (θ := 1 / 4) T.hℓstar (by norm_num) (by norm_num)
      T.ℓ_probe.timeReflect]
    rfl
  have hLt_probe (k n : ℕ) :
      O_loc n ⟨[L_step k]⟩ =
        O_loc n ⟨[T.ℓ_probe.translate (timeShift (k * T.ℓstar))]⟩ := by
    apply h_rounded
    have h_base :
        (L_step k).latticeBase (T.ℓstar : ℝ) =
          (T.ℓ_probe.translate (timeShift (k * T.ℓstar))).latticeBase (T.ℓstar : ℝ) := by
      funext i
      rw [latticeBase_translate_timeShift_nat_mul T.hℓstar k
        (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe) i,
        latticeBase_translate_timeShift_nat_mul T.hℓstar k T.ℓ_probe i,
        rectWithTimeFract_latticeBase_eq T.hℓstar (by norm_num) (by norm_num) T.ℓ_probe]
    simp only [List.map_cons, List.map_nil, h_base]
    rfl
  have hL0_probe (n : ℕ) : O_loc n ⟨[L_step 0]⟩ = O_loc n ⟨[T.ℓ_probe]⟩ := by
    apply h_rounded
    have h_base :
        (L_step 0).latticeBase (T.ℓstar : ℝ) = T.ℓ_probe.latticeBase (T.ℓstar : ℝ) := by
      funext i
      rw [latticeBase_translate_timeShift_nat_mul T.hℓstar 0
        (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe) i,
        rectWithTimeFract_latticeBase_eq T.hℓstar (by norm_num) (by norm_num) T.ℓ_probe]
      simp
    simp only [List.map_cons, List.map_nil, h_base]
    rfl
  have h_cov_tend (k : ℕ) :
      Tendsto (fun n =>
        irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[R]⟩) (O_loc n ⟨[L_step k]⟩))
        atTop (𝓝 (S (G_step 0) - S ⟨[R]⟩ * S ⟨[L_step 0]⟩)) := by
    have h_lim :
        S (G_step k) - S ⟨[R]⟩ * S ⟨[L_step k]⟩ =
          S (G_step 0) - S ⟨[R]⟩ * S ⟨[L_step 0]⟩ := by
      rw [hS_G_eq k, hS_L_eq k]
    rw [← h_lim]
    exact ((hL (G_step k)).sub ((hL ⟨[R]⟩).mul (hL ⟨[L_step k]⟩))).congr fun n => h_cov_eq k n
  have h_diff_zero (t : ℕ) :
      Tendsto (fun n =>
        irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩) (O_loc n ⟨[T.ℓ_probe]⟩) -
        irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩)
          (O_loc n ⟨[T.ℓ_probe.translate (timeShift (t * T.ℓstar))]⟩))
        atTop (𝓝 0) := by
    have h_sub := (h_cov_tend 0).sub (h_cov_tend t)
    rw [sub_self] at h_sub
    refine h_sub.congr fun n => ?_
    rw [hR_probe n, hL0_probe n, hLt_probe t n]
  obtain ⟨C_decay, _, h_dec⟩ := h_decay
  obtain ⟨c_nondeg, hc_nondeg, h_nondeg⟩ := hD.h_nondeg
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  have h_half_pos : 0 < c_nondeg / 2 := half_pos hc_nondeg
  have h_geom : Tendsto (fun t : ℕ => C_decay * (landingTubeContraction T) ^ t) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds (x := C_decay)).mul
      (tendsto_pow_atTop_nhds_zero_of_lt_one hq0.le hq1)
  obtain ⟨t, ht⟩ := (h_geom.eventually (Iio_mem_nhds h_half_pos)).exists
  have ht' : C_decay * (landingTubeContraction T) ^ t < c_nondeg / 2 := ht
  have h_diff_t :=
    (Metric.tendsto_nhds.mp (h_diff_zero t)) (c_nondeg / 2) h_half_pos
  have h_comb : ∀ᶠ (n : ℕ) in atTop, False := by
    filter_upwards [h_nondeg, h_diff_t, h_dec t] with n hfl hd h_up
    rw [Real.dist_eq, sub_zero] at hd
    have h_tri :=
      abs_sub_abs_le_abs_sub
        (irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩) (O_loc n ⟨[T.ℓ_probe]⟩))
        (irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩)
          (O_loc n ⟨[T.ℓ_probe.translate (timeShift (t * T.ℓstar))]⟩))
    linarith
  exact h_comb.exists.choose_spec

/-- Sides-aware variant of `not_dressedLandedComparison_of_rounded_O_loc_and_decay`:
when `O_loc` depends on loop families through `(ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ), ℓ.sideμ, ℓ.sideν)`
(`h_rounded_sides`, which holds for `irDressedLoopFamilyObservable (perimeterCornerRenormalization _ m c)`
whereas the literal `h_rounded` of `not_dressedLandedComparison_of_rounded_O_loc_and_decay` fails when
`m n ≠ 0`, e.g. `sideμ = T.ℓstar` vs `(3 / 2) * T.ℓstar`) and factors multiplicatively on two-loop pairs
(`h_pair`), the quarter/three-quarter shift argument refutes `DressedLandedComparison T Z Ztr O_loc`
under landed covariance decay (`h_decay`). -/
theorem not_dressedLandedComparison_of_rounded_sides_O_loc_and_decay
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (Ztr : TrackedRenormalization P T)
    (O_loc : (n : ℕ) → DisjointLoopFamily → GaugeConfig (T.irSide n) → ℝ)
    (h_rounded_sides :
      ∀ (n : ℕ) (F G : DisjointLoopFamily),
        F.loops.map (fun ℓ => (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ), ℓ.sideμ, ℓ.sideν)) =
          G.loops.map (fun ℓ => (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ), ℓ.sideμ, ℓ.sideν)) →
          O_loc n F = O_loc n G)
    (h_pair :
      ∀ (n : ℕ) (ℓ₁ ℓ₂ : PhysicalRectangle) (V : GaugeConfig (T.irSide n)),
        O_loc n ⟨[ℓ₁, ℓ₂]⟩ V = O_loc n ⟨[ℓ₁]⟩ V * O_loc n ⟨[ℓ₂]⟩ V)
    (h_decay :
      ∃ C_decay : ℝ, 0 ≤ C_decay ∧
        ∀ (t : ℕ), ∀ᶠ n in atTop,
          |irCov ((T.chain n).state 0).gibbsMeasure
            (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩)
            (O_loc n ⟨[T.ℓ_probe.translate (timeShift (t * T.ℓstar))]⟩)| ≤
            C_decay * (landingTubeContraction T) ^ t) :
    ¬ DressedLandedComparison T Z Ztr O_loc := by
  intro hD
  obtain ⟨_, S, hS⟩ := hD.renormalizedLoopCauchy
  have hL (F : DisjointLoopFamily) :
      Tendsto (fun n => dressedLandedSchwinger T O_loc n F) atTop (𝓝 (S F)) :=
    (hS F).congr fun n => (hD.dressedLandedSchwinger_eq_renormalizedSchwinger n F).symm
  have hS_tr (F : DisjointLoopFamily)
      (hF : ∀ ℓ ∈ F.loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base)
      (c : Fin 4 → ℚ) :
      S (F.translate c) = S F := by
    have h_ev : ∀ᶠ n in atTop,
        renormalizedSchwinger Z n (F.translate c) = renormalizedSchwinger Z n F := by
      rw [hD.hZ_eq]
      exact (T.eventually_forall_translate_eq_of_dyadic_base F hF).mono fun _ hn => hn c
    exact tendsto_nhds_unique (hS (F.translate c)) ((hS F).congr' (h_ev.mono fun _ h => h.symm))
  set R := rectWithTimeFract T.ℓstar (1 / 4) T.ℓ_probe.timeReflect
  set L_step := fun k : ℕ =>
    (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe).translate (timeShift ((k : ℚ) * T.ℓstar))
  set G_step := fun k : ℕ => quarterThreeQuarterPairFamily T.ℓstar T.ℓ_probe.timeReflect T.ℓ_probe k
  have hR_dyad : IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ 2) R.base := by
    simpa [R] using isLatticeVector_quarter_rectWithTimeFract T.ℓstar 1 T.ℓ_probe.timeReflect
  have hL_dyad (k : ℕ) : IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ 2) (L_step k).base := by
    refine isLatticeVector_quarter_translate_timeShift_nat_mul T.ℓstar k ?_
    simpa using isLatticeVector_quarter_rectWithTimeFract T.ℓstar 3 T.ℓ_probe
  have hG_dyad (k : ℕ) :
      ∀ ℓ ∈ (G_step k).loops, ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base := by
    intro ℓ hℓ
    simp only [G_step, quarterThreeQuarterPairFamily, List.mem_cons, List.not_mem_nil,
      or_false] at hℓ
    rcases hℓ with rfl | rfl
    · exact ⟨2, hR_dyad⟩
    · exact ⟨2, hL_dyad k⟩
  have hL_fam_dyad (k : ℕ) :
      ∀ ℓ ∈ (⟨[L_step k]⟩ : DisjointLoopFamily).loops,
        ∃ m : ℕ, IsLatticeVector ((T.ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ.base := by
    intro ℓ hℓ
    rcases List.mem_singleton.mp hℓ with rfl
    exact ⟨2, hL_dyad k⟩
  have h_round_G (k n : ℕ) :
      O_loc n ((G_step k).translate (timeShift (T.ℓstar / 2))) = O_loc n (G_step (k + 1)) := by
    apply h_rounded_sides
    simp only [G_step, quarterThreeQuarterPairFamily, DisjointLoopFamily.translate,
      List.map_cons, List.map_nil]
    rw [latticeBase_translate_half_rectWithTimeFract_quarter T.hℓstar T.ℓ_probe.timeReflect,
      latticeBase_translate_half_rectWithTimeFract_threeQuarter T.hℓstar T.ℓ_probe k]
    rfl
  have h_round_L (k n : ℕ) :
      O_loc n ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
        O_loc n ⟨[L_step (k + 1)]⟩ := by
    apply h_rounded_sides
    simp only [L_step, DisjointLoopFamily.translate, List.map_cons, List.map_nil]
    rw [latticeBase_translate_half_rectWithTimeFract_threeQuarter T.hℓstar T.ℓ_probe k]
    rfl
  have hS_G_step (k : ℕ) : S (G_step (k + 1)) = S (G_step k) := by
    have h_tr_eq := hS_tr (G_step k) (hG_dyad k) (timeShift (T.ℓstar / 2))
    have h_lim_eq :
        S ((G_step k).translate (timeShift (T.ℓstar / 2))) = S (G_step (k + 1)) :=
      tendsto_nhds_unique (hL ((G_step k).translate (timeShift (T.ℓstar / 2))))
        ((hL (G_step (k + 1))).congr fun n => by
          unfold dressedLandedSchwinger
          rw [h_round_G k n])
    exact h_lim_eq.symm.trans h_tr_eq
  have hS_L_step (k : ℕ) : S ⟨[L_step (k + 1)]⟩ = S ⟨[L_step k]⟩ := by
    have h_tr_eq := hS_tr ⟨[L_step k]⟩ (hL_fam_dyad k) (timeShift (T.ℓstar / 2))
    have h_lim_eq :
        S ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))) =
          S ⟨[L_step (k + 1)]⟩ :=
      tendsto_nhds_unique
        (hL ((⟨[L_step k]⟩ : DisjointLoopFamily).translate (timeShift (T.ℓstar / 2))))
        ((hL ⟨[L_step (k + 1)]⟩).congr fun n => by
          unfold dressedLandedSchwinger
          rw [h_round_L k n])
    exact h_lim_eq.symm.trans h_tr_eq
  have hS_G_eq (k : ℕ) : S (G_step k) = S (G_step 0) := by
    induction k with
    | zero => rfl
    | succ j ih => exact (hS_G_step j).trans ih
  have hS_L_eq (k : ℕ) : S ⟨[L_step k]⟩ = S ⟨[L_step 0]⟩ := by
    induction k with
    | zero => rfl
    | succ j ih => exact (hS_L_step j).trans ih
  have h_cov_eq (k n : ℕ) :
      dressedLandedSchwinger T O_loc n (G_step k) -
        dressedLandedSchwinger T O_loc n ⟨[R]⟩ * dressedLandedSchwinger T O_loc n ⟨[L_step k]⟩ =
      irCov ((T.chain n).state 0).gibbsMeasure (O_loc n ⟨[R]⟩) (O_loc n ⟨[L_step k]⟩) := by
    unfold dressedLandedSchwinger irCov
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun V => ?_)
    exact h_pair n R (L_step k) V
  have hR_probe (n : ℕ) : O_loc n ⟨[R]⟩ = O_loc n ⟨[T.ℓ_probe.timeReflect]⟩ := by
    apply h_rounded_sides
    simp only [R, List.map_cons, List.map_nil]
    rw [rectWithTimeFract_latticeBase_eq (θ := 1 / 4) T.hℓstar (by norm_num) (by norm_num)
      T.ℓ_probe.timeReflect]
    rfl
  have hLt_probe (k n : ℕ) :
      O_loc n ⟨[L_step k]⟩ =
        O_loc n ⟨[T.ℓ_probe.translate (timeShift (k * T.ℓstar))]⟩ := by
    apply h_rounded_sides
    have h_base :
        (L_step k).latticeBase (T.ℓstar : ℝ) =
          (T.ℓ_probe.translate (timeShift (k * T.ℓstar))).latticeBase (T.ℓstar : ℝ) := by
      funext i
      rw [latticeBase_translate_timeShift_nat_mul T.hℓstar k
        (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe) i,
        latticeBase_translate_timeShift_nat_mul T.hℓstar k T.ℓ_probe i,
        rectWithTimeFract_latticeBase_eq T.hℓstar (by norm_num) (by norm_num) T.ℓ_probe]
    simp only [List.map_cons, List.map_nil, h_base]
    rfl
  have hL0_probe (n : ℕ) : O_loc n ⟨[L_step 0]⟩ = O_loc n ⟨[T.ℓ_probe]⟩ := by
    apply h_rounded_sides
    have h_base :
        (L_step 0).latticeBase (T.ℓstar : ℝ) = T.ℓ_probe.latticeBase (T.ℓstar : ℝ) := by
      funext i
      rw [latticeBase_translate_timeShift_nat_mul T.hℓstar 0
        (rectWithTimeFract T.ℓstar (3 / 4) T.ℓ_probe) i,
        rectWithTimeFract_latticeBase_eq T.hℓstar (by norm_num) (by norm_num) T.ℓ_probe]
      simp
    simp only [List.map_cons, List.map_nil, h_base]
    rfl
  have h_cov_tend (k : ℕ) :
      Tendsto (fun n =>
        irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[R]⟩) (O_loc n ⟨[L_step k]⟩))
        atTop (𝓝 (S (G_step 0) - S ⟨[R]⟩ * S ⟨[L_step 0]⟩)) := by
    have h_lim :
        S (G_step k) - S ⟨[R]⟩ * S ⟨[L_step k]⟩ =
          S (G_step 0) - S ⟨[R]⟩ * S ⟨[L_step 0]⟩ := by
      rw [hS_G_eq k, hS_L_eq k]
    rw [← h_lim]
    exact ((hL (G_step k)).sub ((hL ⟨[R]⟩).mul (hL ⟨[L_step k]⟩))).congr fun n => h_cov_eq k n
  have h_diff_zero (t : ℕ) :
      Tendsto (fun n =>
        irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩) (O_loc n ⟨[T.ℓ_probe]⟩) -
        irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩)
          (O_loc n ⟨[T.ℓ_probe.translate (timeShift (t * T.ℓstar))]⟩))
        atTop (𝓝 0) := by
    have h_sub := (h_cov_tend 0).sub (h_cov_tend t)
    rw [sub_self] at h_sub
    refine h_sub.congr fun n => ?_
    rw [hR_probe n, hL0_probe n, hLt_probe t n]
  obtain ⟨C_decay, _, h_dec⟩ := h_decay
  obtain ⟨c_nondeg, hc_nondeg, h_nondeg⟩ := hD.h_nondeg
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  have h_half_pos : 0 < c_nondeg / 2 := half_pos hc_nondeg
  have h_geom : Tendsto (fun t : ℕ => C_decay * (landingTubeContraction T) ^ t) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds (x := C_decay)).mul
      (tendsto_pow_atTop_nhds_zero_of_lt_one hq0.le hq1)
  obtain ⟨t, ht⟩ := (h_geom.eventually (Iio_mem_nhds h_half_pos)).exists
  have ht' : C_decay * (landingTubeContraction T) ^ t < c_nondeg / 2 := ht
  have h_diff_t :=
    (Metric.tendsto_nhds.mp (h_diff_zero t)) (c_nondeg / 2) h_half_pos
  have h_comb : ∀ᶠ (n : ℕ) in atTop, False := by
    filter_upwards [h_nondeg, h_diff_t, h_dec t] with n hfl hd h_up
    rw [Real.dist_eq, sub_zero] at hd
    have h_tri :=
      abs_sub_abs_le_abs_sub
        (irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩) (O_loc n ⟨[T.ℓ_probe]⟩))
        (irCov ((T.chain n).state 0).gibbsMeasure
          (O_loc n ⟨[T.ℓ_probe.timeReflect]⟩)
          (O_loc n ⟨[T.ℓ_probe.translate (timeShift (t * T.ℓstar))]⟩))
    linarith
  exact h_comb.exists.choose_spec

/-- Two-loop pair factorization for `irDressedLoopFamilyObservable`:
`irDressedLoopFamilyObservable Z (T.irSide n) n (T.ℓstar : ℝ) ⟨[ℓ₁, ℓ₂]⟩ V` equals the product of
its single-loop evaluations on `⟨[ℓ₁]⟩` and `⟨[ℓ₂]⟩`. -/
theorem irDressed_h_pair {P : ContinuumCutoffPath} (T : LandingTube P)
    (Z : LoopRenormalization P.toCutoffPath) (n : ℕ)
    (ℓ₁ ℓ₂ : PhysicalRectangle) (V : GaugeConfig (T.irSide n)) :
    irDressedLoopFamilyObservable Z (T.irSide n) n (T.ℓstar : ℝ) ⟨[ℓ₁, ℓ₂]⟩ V =
      irDressedLoopFamilyObservable Z (T.irSide n) n (T.ℓstar : ℝ) ⟨[ℓ₁]⟩ V *
      irDressedLoopFamilyObservable Z (T.irSide n) n (T.ℓstar : ℝ) ⟨[ℓ₂]⟩ V := by
  simp [irDressedLoopFamilyObservable, mul_assoc]

/-- For any perimeter-corner renormalization `perimeterCornerRenormalization P.toCutoffPath m c`,
`irDressedLoopFamilyObservable (perimeterCornerRenormalization P.toCutoffPath m c) (T.irSide n) n (T.ℓstar : ℝ)`
satisfies the `h_rounded_sides` hypothesis of `not_dressedLandedComparison_of_rounded_sides_O_loc_and_decay`. -/
theorem irDressed_h_rounded_sides {P : ContinuumCutoffPath} (T : LandingTube P) {m c : ℕ → ℝ} :
    ∀ (n : ℕ) (F G : DisjointLoopFamily),
      F.loops.map (fun ℓ => (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ), ℓ.sideμ, ℓ.sideν)) =
        G.loops.map (fun ℓ => (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ), ℓ.sideμ, ℓ.sideν)) →
        irDressedLoopFamilyObservable (perimeterCornerRenormalization P.toCutoffPath m c)
            (T.irSide n) n (T.ℓstar : ℝ) F =
          irDressedLoopFamilyObservable (perimeterCornerRenormalization P.toCutoffPath m c)
            (T.irSide n) n (T.ℓstar : ℝ) G := by
  intro n F G h_eq
  funext V
  let g : (Fin 4 → ℤ) × List LatticeStep × ℚ × ℚ → ℝ :=
    fun t =>
      Real.exp (m n * (2 * ((t.2.2.1 : ℝ) + (t.2.2.2 : ℝ))) + 4 * c n) *
        wilsonLoop V (latticeSite (T.irSide n) t.1) t.2.1
  have hF :
      F.loops.map (fun ℓ =>
          (perimeterCornerRenormalization P.toCutoffPath m c).factor n ℓ *
            physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) ℓ V) =
        (F.loops.map (fun ℓ =>
          (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ), ℓ.sideμ, ℓ.sideν))).map g := by
    rw [List.map_map]
    rfl
  have hG :
      G.loops.map (fun ℓ =>
          (perimeterCornerRenormalization P.toCutoffPath m c).factor n ℓ *
            physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) ℓ V) =
        (G.loops.map (fun ℓ =>
          (ℓ.latticeBase (T.ℓstar : ℝ), ℓ.latticeLoop (T.ℓstar : ℝ), ℓ.sideμ, ℓ.sideν))).map g := by
    rw [List.map_map]
    rfl
  unfold irDressedLoopFamilyObservable
  rw [hF, hG, h_eq]

/-- **Stage 1B.3 (Decimation Measurability / Degeneracy Check):**
Under pure decimation (`iteratedDyadicLinkBlockMapToIR`), for any loop family `F` admissible on the
half-offset coarse grid (`F.IsAdmissible T.ℓstar halfOffset`), the `Z`-dressed fine UV loop
observable on the shifted family `F.translate (fun _ => -(T.ℓstar / 2))` is already coarse-measurable:
it equals `irDressedLoopFamilyObservable Z (T.irSide n) n (T.ℓstar : ℝ) F` composed with
`iteratedDyadicLinkBlockMapToIR (T.irSide n) (T.K n)`, and its coarse expectation under
`((T.chain n).state 0).gibbsMeasure` equals `Z.familyFactor n F * landedIrSchwinger T Z n F = renormalizedSchwinger Z n F`
eventually in `n`, reducing Option B under pure decimation to Stage 1A's A4 situation. -/
theorem dressedCoarseObservable_pure_decimation_reduction
    {P : ContinuumCutoffPath} (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    {F : DisjointLoopFamily} (hF : F.IsAdmissible T.ℓstar halfOffset) :
    ∀ᶠ n in atTop,
      (∀ U : GaugeConfig (dyadicScaleSide (T.irSide n) (T.K n)),
        irDressedLoopFamilyObservable Z (T.irSide n) n (T.ℓstar : ℝ) F
            (iteratedDyadicLinkBlockMapToIR (T.irSide n) (T.K n) U) =
          Z.familyFactor n F *
            irLoopFamilyObservable (dyadicScaleSide (T.irSide n) (T.K n)) (P.spacing n)
              (F.translate (fun _ => -(T.ℓstar / 2))) U) ∧
      dressedLandedSchwinger T
          (fun m G V => irDressedLoopFamilyObservable Z (T.irSide m) m (T.ℓstar : ℝ) G V) n F =
        Z.familyFactor n F * landedIrSchwinger T Z n F ∧
      dressedLandedSchwinger T
          (fun m G V => irDressedLoopFamilyObservable Z (T.irSide m) m (T.ℓstar : ℝ) G V) n F =
        renormalizedSchwinger Z n F := by
  filter_upwards [T.hK, landedIrSchwinger_eq_rawSchwinger_of_isAdmissible T Z hF] with
    n hK ⟨_, _, h_land_raw⟩
  have h_pt (U : GaugeConfig (dyadicScaleSide (T.irSide n) (T.K n))) :
      irDressedLoopFamilyObservable Z (T.irSide n) n (T.ℓstar : ℝ) F
          (iteratedDyadicLinkBlockMapToIR (T.irSide n) (T.K n) U) =
        Z.familyFactor n F *
          irLoopFamilyObservable (dyadicScaleSide (T.irSide n) (T.K n)) (P.spacing n)
            (F.translate (fun _ => -(T.ℓstar / 2))) U := by
    rw [irDressedLoopFamilyObservable_eq_prod_mul,
      irLoopFamilyObservable_iteratedDyadicLinkBlockMapToIR_of_rectOnGrid
        (T.irSide n) (T.K n) T.hℓstar (P.spacing_pos n) hK hF.1 U]
    rfl
  have h_int :
      dressedLandedSchwinger T
          (fun m G V => irDressedLoopFamilyObservable Z (T.irSide m) m (T.ℓstar : ℝ) G V) n F =
        Z.familyFactor n F * landedIrSchwinger T Z n F := by
    unfold dressedLandedSchwinger landedIrSchwinger
    simp_rw [irDressedLoopFamilyObservable_eq_prod_mul]
    exact integral_const_mul (Z.familyFactor n F) _
  have h_ren :
      dressedLandedSchwinger T
          (fun m G V => irDressedLoopFamilyObservable Z (T.irSide m) m (T.ℓstar : ℝ) G V) n F =
        renormalizedSchwinger Z n F := by
    rw [h_int, h_land_raw, renormalizedSchwinger_eq_familyFactor_mul_rawSchwinger]
    rfl
  exact ⟨h_pt, h_int, h_ren⟩

/-- Refutation of `DressedLandedComparison` for the natural coarse dressed observable
`O_nat n F V := irDressedLoopFamilyObservable Z ((M.toLandingTube hF).irSide n) n (M.ℓstar : ℝ) F V`
(which under pure decimation reduces to the `Z`-dressed UV observable on admissible families by
`dressedCoarseObservable_pure_decimation_reduction`) on every `M : BalabanMultiScaleUVToIRFlow P`;
takes `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`),
`Z : LoopRenormalization P.toCutoffPath`, and `Ztr : TrackedRenormalization P (M.toLandingTube hF)`:
if `Z.factor n M.ℓ_probe` is bounded in `n`, `not_dressedLandedComparison_of_rounded_sides_O_loc_and_decay`
refutes `DressedLandedComparison` via `M.toExponentialRemainderLocalityBound hF`; if it is unbounded,
`not_dressedLandedComparison_of_unbounded_factor` refutes it via `M.ℓ_probe.sideμ = M.ℓstar`.
VACUOUS if `BalabanMultiScaleUVToIRFlow P` is empty (consistency unknown; see `not_balabanMultiScaleUVToIRFlow_of_bounded_coupling`). -/
theorem not_dressedLandedComparison_natural_O_loc_of_balabanMultiScaleUVToIRFlow
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (hF : M.WilsonCharFloor)
    (Z : LoopRenormalization P.toCutoffPath) (Ztr : TrackedRenormalization P (M.toLandingTube hF)) :
    ¬ DressedLandedComparison (M.toLandingTube hF) Z Ztr
        (fun n F V => irDressedLoopFamilyObservable Z ((M.toLandingTube hF).irSide n) n (M.ℓstar : ℝ) F V) := by
  intro hD
  by_cases hb : ∃ B : ℝ, ∀ n : ℕ, Z.factor n M.ℓ_probe ≤ B
  · obtain ⟨B₀, hB₀⟩ := hb
    let B : ℝ := max B₀ 0
    have hB_nonneg : 0 ≤ B := le_max_right B₀ 0
    have hB (n : ℕ) : Z.factor n M.ℓ_probe ≤ B := (hB₀ n).trans (le_max_left B₀ 0)
    obtain ⟨m, c, hZc⟩ := (M.toLandingTube hF).hZ_tube_scheme
    have hZ_eq : Z = perimeterCornerRenormalization P.toCutoffPath m c := hD.hZ_eq.trans hZc
    subst hZ_eq
    have h_probe_pos : (⟨[(M.toLandingTube hF).ℓ_probe]⟩ : DisjointLoopFamily).PositiveTime := by
      intro ℓ hℓ
      rcases List.mem_singleton.mp hℓ with rfl
      exact (M.toLandingTube hF).hℓ_probe_pos
    obtain ⟨C_und, hC_und_nonneg, h_und⟩ :=
      (M.toLandingTube hF).ir_cov_decay_of_dobrushin_spatial_decay
        ((M.toLandingTube hF).dobrushin_spatial_decay_of_exponentialRemainderLocality
          (M.toExponentialRemainderLocalityBound hF))
        ⟨[(M.toLandingTube hF).ℓ_probe]⟩ h_probe_pos
    have h_decay :
        ∃ C_decay : ℝ, 0 ≤ C_decay ∧
          ∀ (t : ℕ), ∀ᶠ n in atTop,
            |irCov (((M.toLandingTube hF).chain n).state 0).gibbsMeasure
              (irDressedLoopFamilyObservable (perimeterCornerRenormalization P.toCutoffPath m c)
                ((M.toLandingTube hF).irSide n) n (M.ℓstar : ℝ) ⟨[(M.toLandingTube hF).ℓ_probe.timeReflect]⟩)
              (irDressedLoopFamilyObservable (perimeterCornerRenormalization P.toCutoffPath m c)
                ((M.toLandingTube hF).irSide n) n (M.ℓstar : ℝ)
                ⟨[(M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))]⟩)| ≤
              C_decay * (landingTubeContraction (M.toLandingTube hF)) ^ t := by
      refine ⟨B ^ 2 * C_und, mul_nonneg (sq_nonneg B) hC_und_nonneg, fun t => ?_⟩
      filter_upwards [h_und t] with n hn
      let Z_pc := perimeterCornerRenormalization P.toCutoffPath m c
      have h_cov :=
        irCov_irDressedLoopFamilyObservable_eq Z_pc
          (((M.toLandingTube hF).chain n).state 0).gibbsMeasure n (M.ℓstar : ℝ)
          ⟨[(M.toLandingTube hF).ℓ_probe.timeReflect]⟩
          ⟨[(M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))]⟩
      have h_fac_ref :
          Z_pc.factor n (M.toLandingTube hF).ℓ_probe.timeReflect = Z_pc.factor n M.ℓ_probe := rfl
      have h_fac_tr :
          Z_pc.factor n ((M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))) =
            Z_pc.factor n M.ℓ_probe := rfl
      have h_prod_ref :
          ((⟨[(M.toLandingTube hF).ℓ_probe.timeReflect]⟩ : DisjointLoopFamily).loops.map
            (fun ℓ => Z_pc.factor n ℓ)).prod = Z_pc.factor n M.ℓ_probe := by
        simp [h_fac_ref]
      have h_prod_tr :
          ((⟨[(M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))]⟩ :
            DisjointLoopFamily).loops.map (fun ℓ => Z_pc.factor n ℓ)).prod =
            Z_pc.factor n M.ℓ_probe := by
        simp [h_fac_tr]
      rw [h_cov, h_prod_ref, h_prod_tr, abs_mul, abs_mul]
      have hz_pos : 0 < Z_pc.factor n M.ℓ_probe := Z_pc.factor_pos n M.ℓ_probe
      rw [abs_of_pos hz_pos]
      have hz_sq_le : Z_pc.factor n M.ℓ_probe * Z_pc.factor n M.ℓ_probe ≤ B ^ 2 := by
        have hbn := hB n
        nlinarith
      have h_abs_nonneg :
          0 ≤ |irCov (((M.toLandingTube hF).chain n).state 0).gibbsMeasure
            (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
              ⟨[(M.toLandingTube hF).ℓ_probe.timeReflect]⟩)
            (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
              ⟨[(M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))]⟩)| :=
        abs_nonneg _
      have h_step1 :
          Z_pc.factor n M.ℓ_probe * Z_pc.factor n M.ℓ_probe *
            |irCov (((M.toLandingTube hF).chain n).state 0).gibbsMeasure
              (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
                ⟨[(M.toLandingTube hF).ℓ_probe.timeReflect]⟩)
              (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
                ⟨[(M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))]⟩)| ≤
          B ^ 2 *
            |irCov (((M.toLandingTube hF).chain n).state 0).gibbsMeasure
              (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
                ⟨[(M.toLandingTube hF).ℓ_probe.timeReflect]⟩)
              (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
                ⟨[(M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))]⟩)| :=
        mul_le_mul_of_nonneg_right hz_sq_le h_abs_nonneg
      have h_step2 :
          B ^ 2 *
            |irCov (((M.toLandingTube hF).chain n).state 0).gibbsMeasure
              (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
                ⟨[(M.toLandingTube hF).ℓ_probe.timeReflect]⟩)
              (irLoopFamilyObservable ((M.toLandingTube hF).irSide n) (M.ℓstar : ℝ)
                ⟨[(M.toLandingTube hF).ℓ_probe.translate (timeShift (t * (M.toLandingTube hF).ℓstar))]⟩)| ≤
          B ^ 2 * (C_und * (landingTubeContraction (M.toLandingTube hF)) ^ t) :=
        mul_le_mul_of_nonneg_left hn (sq_nonneg B)
      linarith
    exact not_dressedLandedComparison_of_rounded_sides_O_loc_and_decay
      (M.toLandingTube hF) (perimeterCornerRenormalization P.toCutoffPath m c) Ztr _
      (irDressed_h_rounded_sides (M.toLandingTube hF))
      (irDressed_h_pair (M.toLandingTube hF) (perimeterCornerRenormalization P.toCutoffPath m c))
      h_decay hD
  · simp only [not_exists, not_forall, not_le] at hb
    have hℓ : ∃ k : ℕ, (M.ℓ_probe.sideμ : ℝ) = (k : ℝ) * ((M.toLandingTube hF).ℓstar : ℝ) :=
      ⟨1, by show (M.ℓstar : ℝ) = ((1 : ℕ) : ℝ) * (M.ℓstar : ℝ); ring⟩
    exact not_dressedLandedComparison_of_unbounded_factor (M.toLandingTube hF) Z Ztr _ hℓ hb hD

/-- Unconditional Haar-blocked multi-scale polymer Dobrushin norm, single-link remainder oscillation,
off-neighbor Wilson mixed-difference vanishing, and step-by-step Haar fiber Boltzmann identity for
`localPolymerRGChain L_ir K hβ w_poly` and `localPolymerRGStateAux L_ir β_uv w_poly`
(`haarBlockKernel_localPolymerRGChain_unconditional_boltzmann_and_dobrushin_bounds`):
for every infrared lattice side `L_ir : ℕ [NeZero L_ir]`, blocking depth `K : ℕ`, bare coupling
`0 ≤ β_uv`, and non-negative plaquette polymer weight sequence `w_poly : ℕ → ℝ` (`∀ j, 0 ≤ w_poly j`):
1. At every blocking step `m < K` and coarse configuration `V : GaugeConfig (dyadicScaleSide L_ir m)`,
   the Haar blocking kernel `haarBlockKernel (dyadicScaleSide L_ir m) V` is supported a.e. on the
   coarse pullback fiber `dyadicLinkBlockMap (dyadicScaleSide L_ir m) U = V` and reproduces the exact
   coarse Boltzmann weight identically:
   `∫ U, Real.exp (-((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).totalAction U)
      ∂(haarBlockKernel (dyadicScaleSide L_ir m) V) =
    Real.exp (-((localPolymerRGChain L_ir K hβ w_poly).state m).totalAction V)`;
2. At every RG step `j + 1` and scale `m`, `(localPolymerRGStateAux L_ir β_uv w_poly (j + 1) m).polymers`
   is non-empty (`0 < Fintype.card idx`), satisfies the volume-independent
   `PolymerDobrushinNormBound` with norm `18 * (2 * (24 * w_poly (j + 1)))`, has downward-contracting
   running coupling `(1 / 2 : ℝ) ^ (j + 1) * β_uv`, and has single-link truncation remainder
   oscillation bounded by `12 * (2 * β_uv + w_poly (j + 1))` uniformly in `j` and `L_ir`;
3. For every non-neighboring link pair `e, e' : Link L_ir` (`e' ≠ e`, `e' ∉ dobrushinNeighbors e`),
   `groupTwoLinkMixedDifference L_ir (groupWilsonAction su2CompactGaugeClassTrace β_uv) V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0`. -/
theorem haarBlockKernel_localPolymerRGChain_unconditional_boltzmann_and_dobrushin_bounds
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j) :
    (∀ (m : ℕ) (_hm : m < K) (V : GaugeConfig (dyadicScaleSide L_ir m)),
      (∀ᵐ U ∂haarBlockKernel (dyadicScaleSide L_ir m) V,
        dyadicLinkBlockMap (dyadicScaleSide L_ir m) U = V) ∧
      (∫ U, Real.exp (-((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).totalAction U)
          ∂(haarBlockKernel (dyadicScaleSide L_ir m) V)) =
        Real.exp (-((localPolymerRGChain L_ir K hβ w_poly).state m).totalAction V)) ∧
    (∀ (j m : ℕ),
      let L_m := dyadicScaleSide L_ir m
      let st := localPolymerRGStateAux L_ir β_uv w_poly (j + 1) m
      st.β = (1 / 2 : ℝ) ^ (j + 1) * β_uv ∧
      0 < Fintype.card st.polymers.idx ∧
      PolymerDobrushinNormBound st.polymers (18 * (2 * (24 * w_poly (j + 1)))) ∧
      ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
        |st.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
          st.R_trunc (updateGaugeLink L_m V e.x e.μ g2)| ≤
          12 * (2 * β_uv + w_poly (j + 1))) ∧
    (∀ (V : GaugeConfig L_ir) (e e' : Link L_ir) (g1 g2 h1 h2 : SU2),
      e' ≠ e → e' ∉ dobrushinNeighbors e →
      groupTwoLinkMixedDifference L_ir
        (groupWilsonAction su2CompactGaugeClassTrace β_uv)
        V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0) := by
  refine ⟨?_, ?_, ?_⟩
  · intro m hm V
    refine ⟨haarBlockKernel_supported (dyadicScaleSide L_ir m) V, ?_⟩
    have hm1_le : m + 1 ≤ K := hm
    have h_eq : (localPolymerRGChain L_ir K hβ w_poly).state (m + 1) =
        localPolymerRGStateAux L_ir β_uv w_poly (K - (m + 1)) (m + 1) := by
      simp [localPolymerRGChain, localPolymerRGState, hm1_le]
    have h_uncond := localPolymerRGStateAux_unconditional_bounds L_ir hβ w_poly hw (K - (m + 1)) (m + 1)
    have hR_meas : Measurable ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc := by
      rw [h_eq]
      exact h_uncond.2.2.2.1
    have hR_vac : ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc
        (vacuumConfig (dyadicScaleSide L_ir (m + 1))) = 0 := by
      rw [h_eq]
      exact localPolymerRGStateAux_R_trunc_vacuum_eq_zero L_ir β_uv w_poly (K - (m + 1)) (m + 1)
    let M_osc : ℝ := 12 * (2 * β_uv + w_poly (K - (m + 1)))
    have hR_osc : ∀ (U : GaugeConfig (dyadicScaleSide L_ir (m + 1)))
        (e : Link (dyadicScaleSide L_ir (m + 1))) (g1 g2 : SU2),
        |((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc
            (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g1) -
          ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc
            (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U e.x e.μ g2)| ≤ M_osc := by
      rw [h_eq]
      by_cases hj : 0 < K - (m + 1)
      · exact (h_uncond.2.2.2.2.2.2.2 hj).2.2
      · have hj0 : K - (m + 1) = 0 := Nat.eq_zero_of_not_pos hj
        intro U e g1 g2
        rw [hj0]
        dsimp [localPolymerRGStateAux, InteractingEffectiveActionState.pureWilson, M_osc]
        rw [sub_self, abs_zero]
        have hw0 := hw (K - (m + 1))
        linarith
    let B_R := (Fintype.card (Link (dyadicScaleSide L_ir (m + 1))) : ℝ) * M_osc
    have hR_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
        |((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc U| ≤ B_R := fun U => by
      have h_sub := abs_sub_le_card_mul_singleLink_osc
        ((localPolymerRGChain L_ir K hβ w_poly).state (m + 1)).R_trunc hR_osc U
        (vacuumConfig (dyadicScaleSide L_ir (m + 1)))
      rw [hR_vac, sub_zero] at h_sub
      exact h_sub
    exact (localPolymerRGChain L_ir K hβ w_poly).step_fiber_integral_exp_neg_totalAction_eq
      hm hR_meas hR_bdd V
  · intro j m
    have h_b := localPolymerRGStateAux_unconditional_bounds L_ir hβ w_poly hw (j + 1) m
    have h_pos := h_b.2.2.2.2.2.2.2 (Nat.succ_pos j)
    exact ⟨h_b.1, h_pos.1, h_pos.2.1, h_pos.2.2⟩
  · intro V e e' g1 g2 h1 h2 hne hn
    exact groupTwoLinkMixedDifference_groupWilsonAction_eq_zero_of_not_mem_dobrushinNeighbors
      su2CompactGaugeClassTrace β_uv V e e' hne hn g1 g2 h1 h2

/-- Unconditional `K`-step iterated connected-covariance transport theorem across
`iteratedDyadicLinkBlockMapToIR L_ir K` for `canonicalRGChain` and `localPolymerRGChain`
(`canonicalRGChain_and_localPolymerRGChain_iterated_irCov_eq_uv_wilsonCov`):
for every infrared lattice side `L_ir : ℕ [NeZero L_ir]`, blocking depth `K : ℕ`, bare coupling
`0 ≤ β_uv`, non-negative plaquette polymer weights `w_poly : ℕ → ℝ` (`∀ j, 0 ≤ w_poly j`), physical
spacing `a : ℝ`, and disjoint loop families `F₁, F₂ : DisjointLoopFamily`:
1. At every intermediate scale `m ≤ K`, the connected covariance `groupGibbsCov` under
   `((canonicalRGChain L_ir K hβ).state m).gibbsMeasure` of the `m`-step pulled-back observables
   `fun U => irLoopFamilyObservable L_ir a Fᵢ (iteratedDyadicLinkBlockMapToIR L_ir m U)` equals the
   landed IR connected covariance at `m = 0` identically (with zero fiber-covariance defect);
2. At `m = K`, the landed IR connected covariance under both
   `((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure` and
   `((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure` equals the exact UV Wilson
   connected covariance under `wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv`
   pulled back along `iteratedDyadicLinkBlockMapToIR L_ir K`, without `TwoCutoffComparison` or
   `DressedLandedComparison`. -/
theorem canonicalRGChain_and_localPolymerRGChain_iterated_irCov_eq_uv_wilsonCov
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j)
    (a : ℝ) (F₁ F₂ : DisjointLoopFamily) :
    (∀ (m : ℕ), m ≤ K →
      groupGibbsCov (((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)
          (irLoopFamilyObservable L_ir a F₁) (irLoopFamilyObservable L_ir a F₂) =
        groupGibbsCov (((canonicalRGChain L_ir K hβ).state m).gibbsMeasure)
          (fun U => irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir m U))
          (fun U => irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir m U))) ∧
    groupGibbsCov (((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)
        (irLoopFamilyObservable L_ir a F₁) (irLoopFamilyObservable L_ir a F₂) =
      groupGibbsCov (wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv)
        (fun U => irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir K U))
        (fun U => irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir K U)) ∧
    groupGibbsCov (((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure)
        (irLoopFamilyObservable L_ir a F₁) (irLoopFamilyObservable L_ir a F₂) =
      groupGibbsCov (wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv)
        (fun U => irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir K U))
        (fun U => irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir K U)) := by
  have hF₁_cont := continuous_irLoopFamilyObservable L_ir a F₁
  have hF₂_cont := continuous_irLoopFamilyObservable L_ir a F₂
  have h_step_cov : ∀ (m : ℕ), m ≤ K →
      groupGibbsCov (((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)
          (irLoopFamilyObservable L_ir a F₁) (irLoopFamilyObservable L_ir a F₂) =
        groupGibbsCov (((canonicalRGChain L_ir K hβ).state m).gibbsMeasure)
          (fun U => irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir m U))
          (fun U => irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir m U)) := by
    intro m hm
    have h_int_1 :
        (∫ (V : GaugeConfig L_ir), irLoopFamilyObservable L_ir a F₁ V
            ∂(((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)) =
          ∫ U, irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir m U)
            ∂(((canonicalRGChain L_ir K hβ).state m).gibbsMeasure) := by
      rw [← canonicalRGChain_iterated_gibbsMeasure_map_eq L_ir K hβ m hm,
        integral_map (measurable_iteratedDyadicLinkBlockMapToIR L_ir m).aemeasurable
          hF₁_cont.measurable.aestronglyMeasurable]
    have h_int_2 :
        (∫ (V : GaugeConfig L_ir), irLoopFamilyObservable L_ir a F₂ V
            ∂(((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)) =
          ∫ U, irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir m U)
            ∂(((canonicalRGChain L_ir K hβ).state m).gibbsMeasure) := by
      rw [← canonicalRGChain_iterated_gibbsMeasure_map_eq L_ir K hβ m hm,
        integral_map (measurable_iteratedDyadicLinkBlockMapToIR L_ir m).aemeasurable
          hF₂_cont.measurable.aestronglyMeasurable]
    have h_int_prod :
        (∫ (V : GaugeConfig L_ir),
            (irLoopFamilyObservable L_ir a F₁ V * irLoopFamilyObservable L_ir a F₂ V)
            ∂(((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)) =
          ∫ U,
            (irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir m U) *
              irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir m U))
            ∂(((canonicalRGChain L_ir K hβ).state m).gibbsMeasure) := by
      rw [← canonicalRGChain_iterated_gibbsMeasure_map_eq L_ir K hβ m hm]
      exact integral_map (measurable_iteratedDyadicLinkBlockMapToIR L_ir m).aemeasurable
        (hF₁_cont.mul hF₂_cont).measurable.aestronglyMeasurable
    change
      (∫ (V : GaugeConfig L_ir),
          (irLoopFamilyObservable L_ir a F₁ V * irLoopFamilyObservable L_ir a F₂ V)
          ∂(((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)) -
        (∫ (V : GaugeConfig L_ir), irLoopFamilyObservable L_ir a F₁ V
            ∂(((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)) *
          (∫ (V : GaugeConfig L_ir), irLoopFamilyObservable L_ir a F₂ V
              ∂(((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)) =
      groupGibbsCov (((canonicalRGChain L_ir K hβ).state m).gibbsMeasure)
        (fun U => irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir m U))
        (fun U => irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir m U))
    rw [h_int_prod, h_int_1, h_int_2]
    rfl
  have h_uv_cov :
      groupGibbsCov (((canonicalRGChain L_ir K hβ).state 0).gibbsMeasure)
          (irLoopFamilyObservable L_ir a F₁) (irLoopFamilyObservable L_ir a F₂) =
        groupGibbsCov (wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv)
          (fun U => irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir K U))
          (fun U => irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir K U)) := by
    rw [h_step_cov K le_rfl, (canonicalRGChain L_ir K hβ).uv_gibbsMeasure_eq_wilsonMeasure]
  refine ⟨h_step_cov, h_uv_cov, ?_⟩
  rw [← canonicalRGChain_and_localPolymerRGChain_ir_gibbsMeasure_eq L_ir K hβ w_poly hw, h_uv_cov]

/-- Unconditional Osterwalder–Schrader quotient-completion (`OSHilbert L`), Cauchy–Schwarz
two-point `osForm` correlation-continuity bound, self-adjoint transfer-operator positivity /
contractivity / vacuum normalization, and spectral-gap semigroup rate theorem
(`osHilbert_reconstructedTransfer_selfAdjoint_gap_and_osForm_cauchySchwarz_continuity`):
for every `L : ReflectionPositiveLaw`, `F G : OSVector L`, `s : ℚ` (`hs : 0 ≤ s`), and half-step
time-translation invariance `hτ2 : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) = L.law`:
1. `SeparationQuotient.mk F = SeparationQuotient.mk G ↔ osForm (L.law : Measure WilsonLoopSpace) (F - G).toBCF (F - G).toBCF = 0`;
2. The Euclidean two-point OS correlation difference at physical time `s` satisfies the exact
   Cauchy–Schwarz bound on `OSHilbert L`:
   `|(osForm (L.law : Measure WilsonLoopSpace) F.toBCF (F.toBCF.compContinuous (translateCM s))).re -
     (osForm (L.law : Measure WilsonLoopSpace) F.toBCF F.toBCF).re| ≤
    ‖(F : OSHilbert L)‖ *
      ‖reconstructedTransfer L hs (OSVector.map_translate_of_half hτ2) (F : OSHilbert L) - (F : OSHilbert L)‖`;
3. `(reconstructedTransferOperator L hs hτ2).op` on `OSHilbert L` is self-adjoint, positive (`0 ≤ op`),
   contractive (`‖op‖ ≤ 1`), fixes `osVacuum L`, and has unit vacuum norm `‖osVacuum L‖ = 1`;
4. For every `0 < s`, `0 < ρ < 1`, and `t : ℝ`, the physical spectral-gap rate satisfies
   `0 < transferGapRate s ρ` and the exact exponential semigroup law
   `ρ ^ (t / (s : ℝ)) = Real.exp (-transferGapRate s ρ * t)`. -/
theorem osHilbert_reconstructedTransfer_selfAdjoint_gap_and_osForm_cauchySchwarz_continuity
    (L : ReflectionPositiveLaw) (F G : OSVector L) {s : ℚ} (hs : 0 ≤ s)
    (hτ2 : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) = L.law) :
    (SeparationQuotient.mk F = SeparationQuotient.mk G ↔
      osForm (L.law : Measure WilsonLoopSpace) (F - G).toBCF (F - G).toBCF = 0) ∧
    |(osForm (L.law : Measure WilsonLoopSpace) F.toBCF (F.toBCF.compContinuous (translateCM s))).re -
      (osForm (L.law : Measure WilsonLoopSpace) F.toBCF F.toBCF).re| ≤
      ‖(F : OSHilbert L)‖ *
        ‖reconstructedTransfer L hs (OSVector.map_translate_of_half hτ2) (F : OSHilbert L) -
          (F : OSHilbert L)‖ ∧
    IsSelfAdjoint (reconstructedTransferOperator L hs hτ2).op ∧
    0 ≤ (reconstructedTransferOperator L hs hτ2).op ∧
    ‖(reconstructedTransferOperator L hs hτ2).op‖ ≤ 1 ∧
    (reconstructedTransferOperator L hs hτ2).op (osVacuum L) = osVacuum L ∧
    ‖osVacuum L‖ = 1 ∧
    (∀ {ρ : ℝ} (t : ℝ), 0 < s → 0 < ρ → ρ < 1 →
      0 < transferGapRate s ρ ∧
      ρ ^ (t / (s : ℝ)) = Real.exp (-transferGapRate s ρ * t)) := by
  have hτ := OSVector.map_translate_of_half hτ2
  have h_cs :
      |(osForm (L.law : Measure WilsonLoopSpace) F.toBCF (F.toBCF.compContinuous (translateCM s))).re -
        (osForm (L.law : Measure WilsonLoopSpace) F.toBCF F.toBCF).re| ≤
        ‖(F : OSHilbert L)‖ *
          ‖reconstructedTransfer L hs hτ (F : OSHilbert L) - (F : OSHilbert L)‖ := by
    have h_inner_diff :
        (osForm (L.law : Measure WilsonLoopSpace) F.toBCF (F.toBCF.compContinuous (translateCM s))).re -
          (osForm (L.law : Measure WilsonLoopSpace) F.toBCF F.toBCF).re =
        (⟪F, OSVector.translate L hs F - F⟫_ℂ).re := by
      rw [← OSVector.toBCF_translate hs F, ← OSVector.inner_def F (OSVector.translate L hs F),
        ← OSVector.inner_def F F, ← Complex.sub_re, ← inner_sub_right]
    have h_coe_norm :
        ‖reconstructedTransfer L hs hτ (F : OSHilbert L) - (F : OSHilbert L)‖ =
          ‖OSVector.translate L hs F - F‖ := by
      rw [reconstructedTransfer_coe, ← UniformSpace.Completion.coe_sub,
        UniformSpace.Completion.norm_coe]
    rw [h_inner_diff, UniformSpace.Completion.norm_coe, h_coe_norm]
    exact (RCLike.abs_re_le_norm (⟪F, OSVector.translate L hs F - F⟫_ℂ)).trans
      (norm_inner_le_norm F (OSVector.translate L hs F - F))
  let T_op := reconstructedTransferOperator L hs hτ2
  refine ⟨OSVector.mk_eq_mk_iff F G, h_cs, T_op.isSelfAdjoint, T_op.nonneg, T_op.norm_le_one,
    T_op.vacuum_fixed, T_op.vacuum_norm, ?_⟩
  intro ρ t hs_pos hρ0 hρ1
  exact ⟨transferGapRate_pos (Rat.cast_pos.mpr hs_pos) hρ0 hρ1,
    rpow_div_eq_exp_transferGapRate hρ0 t⟩

/-- Unconditional multi-scale Balaban RG fixed-point ceiling (`((1 / 24) * (1 / 32)) / (1 - 1 / 2)` and `1 / 16`),
direct `haarBlockKernel` derivation of `h_polymer_local`, `h_R_mixed`, and `TruncationDobrushinNormBound`
for `localPolymerRGStateAux` and `canonicalRGStateAux`, and saddle-point $O(\beta)$ fluctuation-slope
cancellation (`balabanMultiScaleRG_h_R_mixed_h_polymer_local_influenceCeiling_and_runningCoupling_drift`):
without any `BalabanMultiScaleUVToIRFlow` hypothesis:
1. For every step `j : ℕ`, `canonicalBalabanEtaStep j ≤ canonicalCrossoverEtaHi` (`1 / 16`) and
   `canonicalBalabanDeltaNbStep j ≤ ((1 / 24) * (1 / 32)) / (1 - 1 / 2)`;
2. For every `w_poly : ℕ → ℝ` with `0 ≤ w_poly k ≤ (6 * (4 * ((4 / 3 : ℝ) ^ 4 * 4)))⁻¹ * canonicalBalabanEtaStep k`,
   `P_m := (localPolymerRGStateAux L_ir β_uv w_poly j m).polymers` unconditionally satisfies
   `h_polymer_local`: its `(4 / 3)^length`-weighted incident-loop sum at every link `e` is bounded by
   `canonicalBalabanEtaStep j ≤ canonicalCrossoverEtaHi`;
3. At every RG step `j + 1` and scale `m`, `st := localPolymerRGStateAux L_ir β_uv w_poly (j + 1) m`
   (defined directly from `interactingBlockedEffectiveAction (haarBlockDisintegration L_m)`)
   unconditionally satisfies `|twoLinkMixedDifference L_m st.R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 2 * (12 * (2 * β_uv + w_poly (j + 1)))`
   and `TruncationDobrushinNormBound st.R_trunc ((Fintype.card (Link L_m) : ℝ) * (2 * (12 * (2 * β_uv + w_poly (j + 1)))))`,
   while `st₁ := canonicalRGStateAux L_ir β_uv 1 m` satisfies the neighbor-refined mixed-difference bound
   `|twoLinkMixedDifference L_m st₁.R_trunc V e.x e.μ g1 1 e'.x e'.μ h1 h2| ≤ 24 * β_uv + (if e' ∈ dobrushinNeighbors e then 24 * 24 * β_uv else 0)`
   for all `e' ≠ e`;
4. Subtracting the classical saddle-point fiber minimum from the `haarBlockKernel` effective action
   (`haarFullLeadingFluctuationRemainder L_ir β`) cancels the linear $O(\beta)$ slope in every
   single-link oscillation and two-link mixed difference (`div_beta_tendsto_zero`) as `β → ∞`. -/
theorem balabanMultiScaleRG_h_R_mixed_h_polymer_local_influenceCeiling_and_runningCoupling_drift
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw_nonneg : ∀ k : ℕ, 0 ≤ w_poly k)
    (hw_le : ∀ k : ℕ, w_poly k ≤ (6 * (4 * ((4 / 3 : ℝ) ^ 4 * 4)))⁻¹ * canonicalBalabanEtaStep k)
    (j m : ℕ) :
    canonicalBalabanEtaStep j ≤ (canonicalCrossoverEtaHi : ℝ) ∧
    canonicalBalabanDeltaNbStep j ≤ ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ)) ∧
    (∀ e : Link (dyadicScaleSide L_ir m),
      let L_m := dyadicScaleSide L_ir m
      let P_m := (localPolymerRGStateAux L_ir β_uv w_poly j m).polymers
      (∑ i : P_m.idx,
        if e ∈ latticePathSupport L_m (P_m.bases i) (P_m.loops i) then
          ((P_m.loops i).length : ℝ) *
            ((4 / 3 : ℝ) ^ (P_m.loops i).length * (4 * |P_m.weights i|))
        else 0) ≤ canonicalBalabanEtaStep j) ∧
    (let L_m := dyadicScaleSide L_ir m
      let st := localPolymerRGStateAux L_ir β_uv w_poly (j + 1) m
      (∀ (V : GaugeConfig L_m) (e e' : Link L_m) (g1 g2 h1 h2 : SU2),
        |twoLinkMixedDifference L_m st.R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
          2 * (12 * (2 * β_uv + w_poly (j + 1)))) ∧
      TruncationDobrushinNormBound st.R_trunc
        ((Fintype.card (Link L_m) : ℝ) * (2 * (12 * (2 * β_uv + w_poly (j + 1)))))) ∧
    (let L_m := dyadicScaleSide L_ir m
      let st₁ := canonicalRGStateAux L_ir β_uv 1 m
      ∀ (V : GaugeConfig L_m) (e e' : Link L_m) (g1 h1 h2 : SU2), e' ≠ e →
        |twoLinkMixedDifference L_m st₁.R_trunc V e.x e.μ g1 1 e'.x e'.μ h1 h2| ≤
          24 * β_uv + (if e' ∈ dobrushinNeighbors e then 24 * 24 * β_uv else 0)) ∧
    (∀ (V : GaugeConfig L_ir) (e e' : Link L_ir) (g1 g2 h1 h2 : SU2),
      Tendsto
        (fun β : ℝ =>
          (haarFullLeadingFluctuationRemainder L_ir β (updateGaugeLink L_ir V e.x e.μ g1) -
            haarFullLeadingFluctuationRemainder L_ir β (updateGaugeLink L_ir V e.x e.μ g2)) / β)
        atTop (𝓝 0) ∧
      Tendsto
        (fun β : ℝ =>
          twoLinkMixedDifference L_ir (haarFullLeadingFluctuationRemainder L_ir β)
            V e.x e.μ g1 g2 e'.x e'.μ h1 h2 / β)
        atTop (𝓝 0)) := by
  have h_uncond := localPolymerRGStateAux_unconditional_bounds L_ir hβ w_poly hw_nonneg (j + 1) m
  have h_osc := (h_uncond.2.2.2.2.2.2.2 (Nat.succ_pos j)).2.2
  have hM_nonneg : 0 ≤ 12 * (2 * β_uv + w_poly (j + 1)) := by
    have hw1 := hw_nonneg (j + 1)
    linarith
  have h_norm :=
    truncationDobrushinNormBound_of_singleLink_osc
      (localPolymerRGStateAux L_ir β_uv w_poly (j + 1) m).R_trunc
      hM_nonneg
      (localPolymerRGStateAux_R_trunc_vacuum_eq_zero L_ir β_uv w_poly (j + 1) m)
      h_uncond.2.2.2.1
      h_osc
  exact ⟨canonicalBalabanEtaStep_le_canonicalCrossoverEtaHi j,
    (canonicalBalabanDeltaNbStep_le j).1,
    localPolymerRGStateAux_weighted_incident_sum_le_canonicalBalabanEtaStep
      L_ir β_uv w_poly hw_nonneg hw_le j m,
    ⟨h_norm.2.1, h_norm.2.2⟩,
    (canonicalRGStateAux_one_step_R_trunc_bounds L_ir hβ m).2.2.2.2.2.2.2,
    fun V e e' g1 g2 h1 h2 =>
      haarFullLeadingFluctuationRemainder_singleLink_osc_and_mixedDiff_div_beta_tendsto_zero
        L_ir V e e' g1 g2 h1 h2⟩

/-- Exact-pushforward `K`-step zero fiber-covariance identity for `localPolymerRGChain` and
`canonicalRGChain`, finite geometric series bound, and coarse decimation reduction conditional on a
supplied `LandingTube P` (`iteratedMultiScaleTransport_exactPushforward_and_coarseDecimation_conditional_on_LandingTube`,
which is conditional on `T : LandingTube P` in conjunct 3 and does NOT close `R3`):
1. Across all `K` dyadic blocking steps, the connected covariance difference between the landed IR
   measure `((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure` and the pulled-back UV
   Wilson measure `wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv` vanishes
   identically (`= 0`);
2. For any `K : ℕ` and geometric parameters `0 ≤ δ₀`, `0 ≤ q < 1`, the `K`-step series is
   bounded by `(∑ k ∈ Finset.range K, δ₀ * q ^ k) ≤ δ₀ / (1 - q)`;
3. Conditional on a supplied `T : LandingTube P` and `Z : LoopRenormalization P.toCutoffPath`, for every
   half-offset admissible loop family `F : DisjointLoopFamily`, `irDressedLoopFamilyObservable`
   pulled back along `iteratedDyadicLinkBlockMapToIR` reduces eventually in `n` to
   `Z.familyFactor n F * irLoopFamilyObservable ...` and its `dressedLandedSchwinger` equals
   `renormalizedSchwinger Z n F`. -/
theorem iteratedMultiScaleTransport_exactPushforward_and_coarseDecimation_conditional_on_LandingTube
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j)
    (a : ℝ) (F₁ F₂ : DisjointLoopFamily)
    (δ₀ q : ℝ) (hδ0 : 0 ≤ δ₀) (hq0 : 0 ≤ q) (hq1 : q < 1)
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (Z : LoopRenormalization P.toCutoffPath)
    {F : DisjointLoopFamily}
    (hF_adm : F.IsAdmissible T.ℓstar halfOffset) :
    groupGibbsCov (((localPolymerRGChain L_ir K hβ w_poly).state 0).gibbsMeasure)
        (irLoopFamilyObservable L_ir a F₁) (irLoopFamilyObservable L_ir a F₂) -
      groupGibbsCov (wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv)
        (fun U => irLoopFamilyObservable L_ir a F₁ (iteratedDyadicLinkBlockMapToIR L_ir K U))
        (fun U => irLoopFamilyObservable L_ir a F₂ (iteratedDyadicLinkBlockMapToIR L_ir K U)) = 0 ∧
    (∑ k ∈ Finset.range K, δ₀ * q ^ k) ≤ δ₀ / (1 - q) ∧
    (∀ᶠ n in atTop,
      (∀ U : GaugeConfig (dyadicScaleSide (T.irSide n) (T.K n)),
        irDressedLoopFamilyObservable Z (T.irSide n) n
            (T.ℓstar : ℝ) F
            (iteratedDyadicLinkBlockMapToIR (T.irSide n) (T.K n) U) =
          Z.familyFactor n F *
            irLoopFamilyObservable
              (dyadicScaleSide (T.irSide n) (T.K n))
              (P.spacing n)
              (F.translate (fun _ => -(T.ℓstar / 2))) U) ∧
      dressedLandedSchwinger T
          (fun m G V => irDressedLoopFamilyObservable Z (T.irSide m) m (T.ℓstar : ℝ) G V) n F =
        Z.familyFactor n F * landedIrSchwinger T Z n F ∧
      dressedLandedSchwinger T
          (fun m G V => irDressedLoopFamilyObservable Z (T.irSide m) m (T.ℓstar : ℝ) G V) n F =
        renormalizedSchwinger Z n F) := by
  have h_cov :=
    (canonicalRGChain_and_localPolymerRGChain_iterated_irCov_eq_uv_wilsonCov
      L_ir K hβ w_poly hw a F₁ F₂).2.2
  exact ⟨sub_eq_zero.mpr h_cov,
    YangMillsRenormalizedObservableLimits.geometric_transport_defect_sum_le δ₀ q K hδ0 hq0 hq1,
    dressedCoarseObservable_pure_decimation_reduction T Z hF_adm⟩

/-- Continuum Wilson-limit OS Hilbert space (`WilsonLimitHilbert`), half-step time-translation
invariance, self-adjoint positive contractive transfer operator (`wilsonLimitTransfer`), scalar
gap-rate identity, and weak-convergence `osForm` continuity conditional on a supplied
`R : WilsonLimitRegularity P Z` and `hν : Z.IsLimitLaw ν`
(`wilsonLimit_osHilbert_transfer_and_correlator_continuity_conditional_on_WilsonLimitRegularity`,
which is conditional on `R : WilsonLimitRegularity P Z` and `hν : Z.IsLimitLaw ν` in conjuncts 1–2
and does NOT close `R2/R4`):
1. Conditional on `R : WilsonLimitRegularity P Z` and `hν : Z.IsLimitLaw ν`, `wilsonLimitLaw P Z hP hZ R ν hν`
   has underlying law `ν` and satisfies half-step time-translation invariance for every `s : ℚ`;
2. Conditional on `R : WilsonLimitRegularity P Z` and `hν : Z.IsLimitLaw ν`, on
   `WilsonLimitHilbert P Z hP hZ R ν hν`, for every `0 < s`, `(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op`
   is self-adjoint, positive (`0 ≤ op`), contractive (`‖op‖ ≤ 1`), fixes its vacuum
   (`op vacuum = vacuum`), and has unit vacuum norm (`‖vacuum‖ = 1`);
3. For every `0 < s` and `0 < ρ < 1`, `0 < transferGapRate s ρ` and
   `∀ t : ℝ, ρ ^ (t / (s : ℝ)) = Real.exp (-transferGapRate s ρ * t)`;
4. For every sequence `νs : ℕ → ProbabilityMeasure WilsonLoopSpace` converging weakly to `ν`
   (`Tendsto νs atTop (𝓝 ν)`) and bounded continuous loop functionals `F, G : WilsonLoopSpace →ᵇ ℂ`,
   `Tendsto (fun n => osForm (νs n : Measure WilsonLoopSpace) F G) atTop (𝓝 (osForm (ν : Measure WilsonLoopSpace) F G))`. -/
theorem wilsonLimit_osHilbert_transfer_and_correlator_continuity_conditional_on_WilsonLimitRegularity
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z)
    (R : WilsonLimitRegularity P Z)
    {s : ℚ} (hs : 0 < s) {ρ : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    (νs : ℕ → ProbabilityMeasure WilsonLoopSpace) (hνs : Tendsto νs atTop (𝓝 ν))
    (F G : WilsonLoopSpace →ᵇ ℂ) :
    ((wilsonLimitLaw P Z hP hZ R ν hν).law = ν ∧
      ((wilsonLimitLaw P Z hP hZ R ν hν).law : Measure WilsonLoopSpace).map
        (translateObservables (timeShift (s / 2))) =
        (wilsonLimitLaw P Z hP hZ R ν hν).law) ∧
    IsSelfAdjoint (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op ∧
    0 ≤ (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op ∧
    ‖(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op‖ ≤ 1 ∧
    (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op
      (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).vacuum =
      (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).vacuum ∧
    ‖(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).vacuum‖ = 1 ∧
    0 < transferGapRate s ρ ∧
    (∀ t : ℝ, ρ ^ (t / (s : ℝ)) = Real.exp (-transferGapRate s ρ * t)) ∧
    Tendsto (fun n => osForm (νs n : Measure WilsonLoopSpace) F G)
      atTop (𝓝 (osForm (ν : Measure WilsonLoopSpace) F G)) := by
  have h_prop := wilsonLimitTransfer_properties P Z hP hZ R ν hν hs.le
  exact ⟨⟨rfl, wilsonLimitLaw_halfStep P Z hP hZ R ν hν s⟩,
    h_prop.1, h_prop.2.1, h_prop.2.2.1, h_prop.2.2.2.1, h_prop.2.2.2.2,
    transferGapRate_pos (Rat.cast_pos.mpr hs) hρ0 hρ1,
    fun t => rpow_div_eq_exp_transferGapRate hρ0 t,
    tendsto_osForm_of_tendsto hνs F G⟩

/-- Bounded sub-claim for `SU(N)` class-trace properties, scalar dual-Coxeter / 6-face leading
coefficients, finite-lattice general-group reflection positivity, tree-level scalar `O_rot`
anisotropy decay (`(1/4)^m → 0`), and subsequential Prokhorov tightness of unrenormalized loop laws
(`specialUnitaryTrace_treeLevelOrotScaling_and_subsequentialTightness_bounds`, which proves only
tree-level scalar `O_rot` scaling and `SU(2)`-concrete character constants, not non-perturbative
`SO(4)` restoration or general-`G` weak-coupling 3-cube character dominance):
1. For every `N : ℕ [NeZero N]`, `specialUnitaryCompactGaugeClassTrace N` on
   `Matrix.specialUnitaryGroup (Fin N) ℂ` satisfies `normReTrace 1 = 1`, `|normReTrace U| ≤ 1`, and
   conjugation invariance `normReTrace (H_g * U * H_g⁻¹) = normReTrace U`;
2. For every dual Coxeter number `1 ≤ h_dual` and fundamental dimension `1 ≤ d_fund`,
   `0 < compactSimpleOneLoopBeta0 h_dual` (`8 * compactSimpleOneLoopBeta0 2 = su2OneLoopBeta0`) and
   `0 < compactSimpleSixFaceCubeLeadingCoeff d_fund` (`compactSimpleSixFaceCubeLeadingCoeff 2 = 1 / 1024`);
3. For every compact Hausdorff second-countable topological gauge group `G`, class trace
   `tr : CompactGaugeClassTrace G`, even lattice side `L = 2 * M`, and coupling `0 ≤ β`,
   `groupWilsonMeasure G L tr β` is a local-gauge-invariant probability measure whose expectation
   `groupWilsonExpectation G L tr β` is Osterwalder–Seiler reflection-positive on positive-time
   observables;
4. For every `O_rot : DimensionSixRotationBreakingOperator`, the tree-level scalar coupling
   `O_rot.couplingAfterSteps m` converges to `0` as `m → ∞`, and along any `P : CutoffPath`,
   `LoopRenormalization.unrenormalized P` satisfies `IsTranslationInvariant`,
   `IsPermutationInvariant`, `TailObligation`, and Prokhorov subsequential weak convergence. -/
theorem specialUnitaryTrace_treeLevelOrotScaling_and_subsequentialTightness_bounds
    (N : ℕ) [NeZero N] {h_dual d_fund : ℕ} (hh : 1 ≤ h_dual) (hd : 1 ≤ d_fund)
    (G : Type*) [Group G] [TopologicalSpace G] [SecondCountableTopology G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    {L M : ℕ} [NeZero L] (hL : L = 2 * M) (tr : CompactGaugeClassTrace G)
    {β : ℝ} (hβ : 0 ≤ β)
    (H : GroupGaugeConfig G L → ℝ) (hH : Continuous H)
    (hloc : ∀ U U' : GroupGaugeConfig G L,
      (∀ e, YangMillsOsterwalderSchraderInheritance.IsPositiveLink M e → U e = U' e) → H U = H U')
    (O_rot : YangMillsOsterwalderSchraderInheritance.DimensionSixRotationBreakingOperator)
    (P : CutoffPath) :
    ((specialUnitaryCompactGaugeClassTrace N).normReTrace 1 = 1 ∧
      (∀ U : Matrix.specialUnitaryGroup (Fin N) ℂ,
        |(specialUnitaryCompactGaugeClassTrace N).normReTrace U| ≤ 1) ∧
      (∀ H_g U : Matrix.specialUnitaryGroup (Fin N) ℂ,
        (specialUnitaryCompactGaugeClassTrace N).normReTrace (H_g * U * H_g⁻¹) =
          (specialUnitaryCompactGaugeClassTrace N).normReTrace U)) ∧
    (0 < YangMillsOsterwalderSchraderInheritance.compactSimpleOneLoopBeta0 h_dual ∧
      8 * YangMillsOsterwalderSchraderInheritance.compactSimpleOneLoopBeta0 2 =
        YangMillsRenormalizedObservableLimits.su2OneLoopBeta0 ∧
      0 < YangMillsOsterwalderSchraderInheritance.compactSimpleSixFaceCubeLeadingCoeff d_fund ∧
      YangMillsOsterwalderSchraderInheritance.compactSimpleSixFaceCubeLeadingCoeff 2 = 1 / 1024) ∧
    (IsProbabilityMeasure (groupWilsonMeasure G L tr β) ∧
      (∀ g : GroupGaugeTransformation G L,
        MeasurePreserving (groupGaugeTransform g)
          (groupWilsonMeasure G L tr β) (groupWilsonMeasure G L tr β)) ∧
      0 ≤ groupWilsonExpectation G L tr β
        (fun U => H (YangMillsOsterwalderSchraderInheritance.groupReflectConfig U) * H U)) ∧
    (Tendsto O_rot.couplingAfterSteps atTop (𝓝 0) ∧
      (LoopRenormalization.unrenormalized P).IsTranslationInvariant ∧
      (LoopRenormalization.unrenormalized P).IsPermutationInvariant ∧
      (LoopRenormalization.unrenormalized P).TailObligation ∧
      ∃ (φ : ℕ → ℕ) (ν : ProbabilityMeasure WilsonLoopSpace),
        StrictMono φ ∧ Tendsto (fun n => (LoopRenormalization.unrenormalized P).law (φ n)) atTop (𝓝 ν)) := by
  have h_prob := groupWilsonMeasure_prob_bounds_and_localGauge_invariance G L tr hβ
  have h_unren := LoopRenormalization.unrenormalized_invariant_and_tails P
  refine ⟨⟨(specialUnitaryCompactGaugeClassTrace N).h_one,
      (specialUnitaryCompactGaugeClassTrace N).h_abs_le_one,
      (specialUnitaryCompactGaugeClassTrace N).h_conj⟩,
    ⟨YangMillsOsterwalderSchraderInheritance.compactSimpleOneLoopBeta0_pos hh,
      YangMillsOsterwalderSchraderInheritance.compactSimpleOneLoopBeta0_two_relation,
      YangMillsOsterwalderSchraderInheritance.compactSimpleSixFaceCubeLeadingCoeff_pos hd,
      YangMillsOsterwalderSchraderInheritance.compactSimpleSixFaceCubeLeadingCoeff_two_eq_inv_1024⟩,
    ⟨h_prob.2.2.1, h_prob.2.2.2.1,
      YangMillsOsterwalderSchraderInheritance.groupWilsonExpectation_reflection_positive
        G hL tr hβ H hH hloc⟩,
    ⟨O_rot.couplingAfterSteps_tendsto_zero,
      h_unren.1, h_unren.2.1, h_unren.2.2,
      LoopRenormalization.exists_subsequential_limit_of_tailObligation
        (LoopRenormalization.unrenormalized P) h_unren.2.2⟩⟩

/-- Bounded sub-claim 1 (`dyadicOneLoopPath` single-step 1-loop coupling increment, static
`CanonicalProbeClusterRemainder` at `canonicalCrossoverBetaHi`, canonical spatial probe geometry,
and `localPolymerRGChain` base-scale `m = K` vanishing, which does NOT prove $\beta_{\mathrm{uv}}(K) \to \infty$,
$K \to \infty$ contraction, or inhabit `BalabanMultiScaleUVToIRFlow` / `WilsonCharFloor`):
1. On `dyadicOneLoopPath`, `dyadicOneLoopPath.IsDyadic` holds, `dyadicOneLoopPath.spacing n * (2 : ℝ) ^ n = 1`,
   and the single-step coupling increment is `(11 / (3 * Real.pi ^ 2)) * Real.log 2 > 0`;
2. `CanonicalProbeClusterRemainder (canonicalCrossoverBetaHi : ℝ)` holds at the static crossover
   constant `canonicalCrossoverBetaHi`, and `canonicalSpatialProbe ℓstar hℓstar` lies in positive
   Euclidean time with unit lattice steps `stepsμ (ℓstar : ℝ) = 1` and `stepsν (ℓstar : ℝ) = 1`;
3. For every `L_ir K : ℕ` (`[NeZero L_ir]`), `0 ≤ β_uv`, and `w_poly : ℕ → ℝ`, `localPolymerRGChain L_ir K hβ w_poly`
   has measurable bounded `R_trunc` for `m ≤ K`, and at the base scale `m = K` both the incident
   polymer sum and `twoLinkMixedDifference ... R_trunc` vanish identically (`= 0`). -/
theorem dyadicOneLoopPath_singleStepIncrement_staticCrossover_and_baseScaleVanishing
    (L_ir K n : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) (w_poly : ℕ → ℝ)
    {ℓstar : ℚ} (hℓstar : 0 < ℓstar)
    (e_uv : Link (dyadicScaleSide L_ir K))
    (V_uv : GaugeConfig (dyadicScaleSide L_ir K))
    (e₁ e₂ : Link (dyadicScaleSide L_ir K)) (g1 g2 h1 h2 : SU2) :
    (dyadicOneLoopPath.IsDyadic ∧
      dyadicOneLoopPath.spacing n * (2 : ℝ) ^ n = 1 ∧
      dyadicOneLoopPath.coupling (n + 1) - dyadicOneLoopPath.coupling n =
        (11 / (3 * Real.pi ^ 2)) * Real.log 2 ∧
      0 < (11 / (3 * Real.pi ^ 2)) * Real.log 2) ∧
    (CanonicalProbeClusterRemainder (canonicalCrossoverBetaHi : ℝ) ∧
      (canonicalSpatialProbe ℓstar hℓstar).IsPositiveTime ∧
      (canonicalSpatialProbe ℓstar hℓstar).stepsμ (ℓstar : ℝ) = 1 ∧
      (canonicalSpatialProbe ℓstar hℓstar).stepsν (ℓstar : ℝ) = 1) ∧
    ((∀ m ≤ K,
        Measurable ((localPolymerRGChain L_ir K hβ w_poly).state m).R_trunc ∧
        ∃ B_R : ℝ, ∀ U : GaugeConfig (dyadicScaleSide L_ir m),
          |((localPolymerRGChain L_ir K hβ w_poly).state m).R_trunc U| ≤ B_R) ∧
      (let L_K := dyadicScaleSide L_ir K
       let P_K := ((localPolymerRGChain L_ir K hβ w_poly).state K).polymers
       (∑ i : P_K.idx,
         if e_uv ∈ latticePathSupport L_K (P_K.bases i) (P_K.loops i) then
           ((P_K.loops i).length : ℝ) *
             ((4 / 3 : ℝ) ^ (P_K.loops i).length * (4 * |P_K.weights i|))
         else 0) = 0) ∧
      twoLinkMixedDifference (dyadicScaleSide L_ir K)
        ((localPolymerRGChain L_ir K hβ w_poly).state K).R_trunc
        V_uv e₁.x e₁.μ g1 g2 e₂.x e₂.μ h1 h2 = 0) := by
  have h_sp : dyadicOneLoopPath.spacing n * (2 : ℝ) ^ n = 1 := by
    change (1 / 2 : ℝ) ^ n * (2 : ℝ) ^ n = 1
    rw [← mul_pow]
    norm_num
  have h_inc :
      dyadicOneLoopPath.coupling (n + 1) - dyadicOneLoopPath.coupling n =
        (11 / (3 * Real.pi ^ 2)) * Real.log 2 := by
    change 11 / (3 * Real.pi ^ 2) * (((n + 1 : ℕ) : ℝ) * Real.log 2) -
        11 / (3 * Real.pi ^ 2) * ((n : ℝ) * Real.log 2) =
      (11 / (3 * Real.pi ^ 2)) * Real.log 2
    push_cast
    ring
  have h_inc_pos : 0 < (11 / (3 * Real.pi ^ 2)) * Real.log 2 := by
    have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
    positivity
  obtain ⟨hμ, hν⟩ := canonicalSpatialProbe_steps hℓstar
  refine ⟨⟨dyadicOneLoopPath_isDyadic, h_sp, h_inc, h_inc_pos⟩,
    ⟨canonicalProbeClusterRemainder_canonicalCrossoverBetaHi,
      canonicalSpatialProbe_isPositiveTime hℓstar, hμ, hν⟩,
    ⟨(localPolymerRGChain L_ir K hβ w_poly).measurable_and_bdd_R_trunc,
      (localPolymerRGChain L_ir K hβ w_poly).uv_polymer_weighted_incident_sum_eq_zero e_uv,
      (localPolymerRGChain L_ir K hβ w_poly).uv_R_trunc_twoLinkMixedDifference_eq_zero
        V_uv e₁ e₂ g1 g2 h1 h2⟩⟩

/-- Bounded sub-claim 2 (Single-scale two-state Georgii 8.23 expectation/covariance perturbation
bounds and finite-`K` bare `irLoopFamilyObservable` grid decimation, which does NOT control
$K \to \infty$ accumulated multi-scale defect at weak coupling or close `R3`):
1. For any two effective-action states `st₁, st₂ : InteractingEffectiveActionState L_ir` with
   single-link action difference oscillation `≤ Δ_link` and global action difference `≤ δ` when `st₂`
   lies in the canonical Dobrushin regime, the IR multi-loop expectation difference is bounded by
   `4 * (Real.exp (2 * Δ_link) - 1) * (2 * ∑ ℓ ∈ F.loops, (ℓ.latticeLoop a).length)`, the connected
   covariance difference is bounded by `3 * (Real.exp (2 * δ) - 1)`, and the partition functions
   satisfy `Real.exp (-δ) * st₂.partitionFunction ≤ st₁.partitionFunction ≤ Real.exp δ * st₂.partitionFunction`;
2. For any rational coarse grid spacing `0 < a_grid`, UV spacing `0 < a_uv` with `a_uv * 2 ^ K = a_grid`,
   and loop family `F_adm` admissible on `(a_grid, halfOffset)`, `F_adm` satisfies the finite-`K` bare
   decimation identity `irLoopFamilyObservable L_ir (a_grid : ℝ) F_adm (iteratedDyadicLinkBlockMapToIR L_ir K U_uv) = irLoopFamilyObservable (dyadicScaleSide L_ir K) a_uv (F_adm.translate (fun _ => -(a_grid / 2))) U_uv`. -/
theorem perturbedEffectiveAction_singleScaleOscillation_and_bareLoopGridDecimation
    {L_ir K : ℕ} [NeZero L_ir]
    (st₁ st₂ : InteractingEffectiveActionState L_ir) {B₁ Δ_link δ : ℝ}
    (hΔ : 0 ≤ Δ_link) (hδ : 0 ≤ δ)
    (hβ1 : 0 ≤ st₁.β) (hR1_meas : Measurable st₁.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig L_ir, |st₁.R_trunc V| ≤ B₁)
    (hβ2_0 : 0 ≤ st₂.β) (hβ2_hi : st₂.β ≤ (canonicalCrossoverBetaHi : ℝ))
    (h_poly2 : PolymerDobrushinNormBound st₂.polymers (canonicalCrossoverEtaHi : ℝ))
    (h_trunc2 : TruncationDobrushinNormBound st₂.R_trunc (canonicalCrossoverEpsHi : ℝ))
    (h_act_osc : ∀ (V : GaugeConfig L_ir) (e : Link L_ir) (g1 g2 : SU2),
      |((wilsonAction st₁.β (updateGaugeLink L_ir V e.x e.μ g1) +
            st₁.polymers.eval (updateGaugeLink L_ir V e.x e.μ g1) +
            st₁.R_trunc (updateGaugeLink L_ir V e.x e.μ g1)) -
          (wilsonAction st₂.β (updateGaugeLink L_ir V e.x e.μ g1) +
            st₂.polymers.eval (updateGaugeLink L_ir V e.x e.μ g1) +
            st₂.R_trunc (updateGaugeLink L_ir V e.x e.μ g1))) -
        ((wilsonAction st₁.β (updateGaugeLink L_ir V e.x e.μ g2) +
            st₁.polymers.eval (updateGaugeLink L_ir V e.x e.μ g2) +
            st₁.R_trunc (updateGaugeLink L_ir V e.x e.μ g2)) -
          (wilsonAction st₂.β (updateGaugeLink L_ir V e.x e.μ g2) +
            st₂.polymers.eval (updateGaugeLink L_ir V e.x e.μ g2) +
            st₂.R_trunc (updateGaugeLink L_ir V e.x e.μ g2)))| ≤ Δ_link)
    (h_diff : ∀ V : GaugeConfig L_ir,
      |(wilsonAction st₁.β V + st₁.polymers.eval V + st₁.R_trunc V) -
        (wilsonAction st₂.β V + st₂.polymers.eval V + st₂.R_trunc V)| ≤ δ)
    (a : ℝ) (F : DisjointLoopFamily)
    {f g : GaugeConfig L_ir → ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GaugeConfig L_ir, |f V| ≤ 1)
    (hg_meas : Measurable g) (hg_bdd : ∀ V : GaugeConfig L_ir, |g V| ≤ 1)
    {a_grid : ℚ} (ha_grid : 0 < a_grid) {a_uv : ℝ} (ha_uv : 0 < a_uv)
    (hK : a_uv * (2 : ℝ) ^ K = (a_grid : ℝ))
    {F_adm : DisjointLoopFamily} (hF_adm : F_adm.IsAdmissible a_grid halfOffset)
    (U_uv : GaugeConfig (dyadicScaleSide L_ir K)) :
    (|(∫ V, irLoopFamilyObservable L_ir a F V ∂st₁.gibbsMeasure) -
        (∫ V, irLoopFamilyObservable L_ir a F V ∂st₂.gibbsMeasure)| ≤
      4 * (Real.exp (2 * Δ_link) - 1) *
        (2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ)) ∧
      |irCov st₁.gibbsMeasure f g - irCov st₂.gibbsMeasure f g| ≤
        3 * (Real.exp (2 * δ) - 1) ∧
      Real.exp (-δ) * st₂.partitionFunction ≤ st₁.partitionFunction ∧
      st₁.partitionFunction ≤ Real.exp δ * st₂.partitionFunction) ∧
    (F_adm.IsDyadicTime a_grid ∧
      (∀ ℓ₁ ∈ F_adm.loops, ∀ ℓ₂ ∈ F_adm.loops,
        IsLatticeVector (a_grid : ℝ) (ℓ₁.base - ℓ₂.base)) ∧
      irLoopFamilyObservable L_ir (a_grid : ℝ) F_adm
          (iteratedDyadicLinkBlockMapToIR L_ir K U_uv) =
        irLoopFamilyObservable (dyadicScaleSide L_ir K) a_uv
          (F_adm.translate (fun _ => -(a_grid / 2))) U_uv) := by
  have ⟨⟨B₂, hR2_bdd⟩, hR2_meas, _⟩ := h_trunc2
  have h_sand :=
    st₁.partitionFunction_sandwich_of_action_diff st₂ hβ1 hR1_meas hR1_bdd hβ2_0 hR2_meas hR2_bdd h_diff
  refine ⟨⟨st₁.irLoopFamilyObservable_expectation_diff_le_of_singleLink_osc
      st₂ hΔ hβ1 hR1_meas hR1_bdd hβ2_0 hβ2_hi h_poly2 h_trunc2 h_act_osc a F,
    st₁.gibbsMeasure_irCov_diff_le_of_action_diff
      st₂ hδ hβ1 hR1_meas hR1_bdd hβ2_0 hR2_meas hR2_bdd h_diff hf_meas hf_bdd hg_meas hg_bdd,
    h_sand.1, h_sand.2⟩,
    ⟨DisjointLoopFamily.isDyadicTime_of_isAdmissible_halfOffset ha_grid hF_adm,
      DisjointLoopFamily.IsAdmissible.isLatticeVector_base_sub hF_adm,
      irLoopFamilyObservable_iteratedDyadicLinkBlockMapToIR_of_rectOnGrid
        L_ir K ha_grid ha_uv hK hF_adm.1 U_uv⟩⟩

/-- Bounded sub-claim 3 (Negative non-existence of a bounded self-adjoint generator when `0 ∈ spectrum ℝ T_op`,
bounded functional-calculus resolvent/evolution on a supplied `ReflectionPositiveLaw L`, and
`dyadicOneLoopPath` half-step lattice commensurability, which does NOT construct the unbounded
self-adjoint continuum Hamiltonian `H ≥ 0` or close `R2/R4`):
1. On `OSHilbert L`, when `(0 : ℝ) ∈ spectrum ℝ T_op`, no bounded self-adjoint generator `G`
   satisfies `cfc (fun y => Real.exp (-a * y)) G = T_op` (a negative non-existence result);
2. On a supplied `ReflectionPositiveLaw L`, for `S := reconstructedTransferOperator L hs.le hτ2` (`0 < s`),
   the bounded functional-calculus operator `S.resolventMinusOne (s : ℝ) = cfc (resolventKernel s) S.op`
   is self-adjoint and positive (`0 ≤ S.resolventMinusOne (s : ℝ)`), with `resolventKernel (s : ℝ) 0 = 0`
   and `resolventKernel (s : ℝ) 1 = 1`;
3. `S.evolution (s : ℝ) 0 = 1` and `S.evolution (s : ℝ) t S.vacuum = S.vacuum` for `t ≥ 0`, and on
   `dyadicOneLoopPath`, `IsLatticeVector (dyadicOneLoopPath.spacing n) (timeShift ((2 : ℚ) / 2))` and
   `HasReflectionInvariantFactors (LoopRenormalization.unrenormalized dyadicOneLoopPath.toCutoffPath)` hold. -/
theorem noBoundedGeneratorAtZeroSpectrum_and_suppliedLawBoundedResolvent
    (L : ReflectionPositiveLaw) {s : ℚ} (hs : 0 < s)
    (hτ2 : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) = L.law)
    {t : ℝ} (ht : 0 ≤ t)
    (T_op : OSHilbert L →L[ℂ] OSHilbert L) (h0 : (0 : ℝ) ∈ spectrum ℝ T_op) (a : ℝ)
    (n : ℕ) :
    (¬ ∃ G : OSHilbert L →L[ℂ] OSHilbert L,
      IsSelfAdjoint G ∧ cfc (fun y : ℝ => Real.exp (-a * y)) G = T_op) ∧
    (IsSelfAdjoint ((reconstructedTransferOperator L hs.le hτ2).resolventMinusOne (s : ℝ)) ∧
      0 ≤ (reconstructedTransferOperator L hs.le hτ2).resolventMinusOne (s : ℝ) ∧
      PositiveTransferOperator.resolventKernel (s : ℝ) 0 = 0 ∧
      PositiveTransferOperator.resolventKernel (s : ℝ) 1 = 1) ∧
    ((reconstructedTransferOperator L hs.le hτ2).evolution (s : ℝ) 0 = 1 ∧
      (reconstructedTransferOperator L hs.le hτ2).evolution (s : ℝ) t
        (reconstructedTransferOperator L hs.le hτ2).vacuum =
          (reconstructedTransferOperator L hs.le hτ2).vacuum) ∧
    (IsLatticeVector (dyadicOneLoopPath.spacing n) (timeShift ((2 : ℚ) / 2)) ∧
      YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors
        (LoopRenormalization.unrenormalized dyadicOneLoopPath.toCutoffPath)) :=
  let S := reconstructedTransferOperator L hs.le hτ2
  have hs_real : (0 : ℝ) < (s : ℝ) := Rat.cast_pos.mpr hs
  ⟨PositiveTransferOperator.not_exists_bounded_generator_of_zero_mem_spectrum h0 a,
    ⟨S.resolventMinusOne_selfAdjoint (s : ℝ),
      S.resolventMinusOne_nonneg hs_real,
      PositiveTransferOperator.resolventKernel_zero (s : ℝ),
      PositiveTransferOperator.resolventKernel_one (s : ℝ)⟩,
    ⟨S.evolution_zero (s : ℝ),
      S.evolution_vacuum hs_real ht⟩,
    ⟨dyadicOneLoopPath_halfStep n,
      YangMillsOsterwalderSchraderInheritance.hasReflectionInvariantFactors_unrenormalized
        dyadicOneLoopPath.toCutoffPath⟩⟩

/-- Bounded sub-claim 4 (Logical `↔` equivalence between `WilsonLoopConvergenceObligation` and
`LimitLawsAgree`, scalar `symanzikDim6PerimeterCornerScheme` properties, and strong-coupling
`4 * (18 * (24 * β)) < 1` general-`G` Dobrushin bounds, which does NOT prove `LimitLawsAgree` itself
or close `Continuum/G`):
1. For every `P : ContinuumCutoffPath`, `WilsonLoopConvergenceObligation P.toCutoffPath ↔ (LoopRenormalization.unrenormalized P.toCutoffPath).LimitLawsAgree`,
   and `(∃ ν : ProbabilityMeasure WilsonLoopSpace, Tendsto (LoopRenormalization.unrenormalized P.toCutoffPath).law atTop (𝓝 ν)) ↔ (LoopRenormalization.unrenormalized P.toCutoffPath).LimitLawsAgree`;
2. For every `P : ContinuumCutoffPath`, `symanzikDim6PerimeterCornerScheme P` has per-loop factor
   `(P.spacing n) ^ 2`, is a `perimeterCornerRenormalization` scheme, and inhabits
   `SymanzikDimensionSixRotationalSuppression (symanzikDim6PerimeterCornerScheme P)`;
3. For every compact Hausdorff second-countable gauge group `G` with class trace `tr : CompactGaugeClassTrace G`
   in the strong-coupling Dobrushin regime `4 * (18 * (24 * β)) < 1` (`0 ≤ β`), the Dobrushin matrix
   `dobrushinSupMatrix G L (groupWilsonAction tr β)` has row sums bounded by `4 * (18 * (24 * β)) < 1`
   and bounds connected covariances via `dobrushinObservableComparison`. -/
theorem wilsonLoopConvergence_limitLawsAgree_iff_equivalence_and_strongCouplingDobrushin
    (P : ContinuumCutoffPath)
    (n : ℕ) (ℓ : PhysicalRectangle)
    (G : Type*) [Group G] [TopologicalSpace G] [SecondCountableTopology G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    (L : ℕ) [NeZero L] (tr : CompactGaugeClassTrace G)
    {β : ℝ} (hβ : 0 ≤ β) (hdob : 4 * (18 * (24 * β)) < 1)
    {f g : GroupGaugeConfig G L → ℝ} {M_f M_g : ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ U : GroupGaugeConfig G L, |f U| ≤ M_f)
    (hg_meas : Measurable g) (hg_bdd : ∀ U : GroupGaugeConfig G L, |g U| ≤ M_g) :
    ((WilsonLoopConvergenceObligation P.toCutoffPath ↔
        (LoopRenormalization.unrenormalized P.toCutoffPath).LimitLawsAgree) ∧
      ((∃ ν : ProbabilityMeasure WilsonLoopSpace,
          Tendsto (LoopRenormalization.unrenormalized P.toCutoffPath).law atTop (𝓝 ν)) ↔
        (LoopRenormalization.unrenormalized P.toCutoffPath).LimitLawsAgree)) ∧
    ((symanzikDim6PerimeterCornerScheme P).factor n ℓ = (P.spacing n) ^ 2 ∧
      (∃ m c : ℕ → ℝ,
        symanzikDim6PerimeterCornerScheme P = perimeterCornerRenormalization P.toCutoffPath m c) ∧
      SymanzikDimensionSixRotationalSuppression (symanzikDim6PerimeterCornerScheme P)) ∧
    ((∀ e : Link L,
        ∑ e' : Link L, dobrushinSupMatrix G L (groupWilsonAction tr β) e e' ≤
          4 * (18 * (24 * β))) ∧
      |groupGibbsCov (groupGibbsMeasure G L (groupWilsonAction tr β)) f g| ≤
        dobrushinObservableComparison G
          (dobrushinSupMatrix G L (groupWilsonAction tr β)) f g) := by
  have h_unren := LoopRenormalization.unrenormalized_invariant_and_tails P.toCutoffPath
  have h_sym := symanzikDimensionSixRotationalSuppression_perimeterCorner_inhabited P
  have h_dob :=
    generalCompactGroup_wilsonGibbsMeasure_dobrushin_rowSum_and_covariance_comparison
      G tr (L := L) hβ hdob
  exact ⟨⟨wilsonLoopConvergenceObligation_iff_limitLawsAgree P.toCutoffPath,
      ((LoopRenormalization.unrenormalized P.toCutoffPath).converges_iff_limitLaw_unique
        h_unren.2.2).symm⟩,
    ⟨symanzikDim6PerimeterCornerScheme_factor_eq P n ℓ, h_sym.1, h_sym.2⟩,
    ⟨fun e => (h_dob.2.2.1 e).2.2.1, h_dob.2.2.2 f g hf_meas hf_bdd hg_meas hg_bdd⟩⟩


/-!
# Set 4 (Argon / Antigravity) — Constructive Lean 4 Reduction Constructors & Bridge Theorems
Across All 4 Clay Millennium Yang–Mills Obligations (`R5`, `R3`, `R2/R4`, `Continuum/G`)
