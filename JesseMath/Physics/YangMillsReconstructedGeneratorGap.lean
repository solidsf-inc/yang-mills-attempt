theorem abs_integral_mul_le_of_nonneg {L : ℕ} [NeZero L]
    {w F : GaugeConfig L → ℝ} {B : ℝ}
    (hw : Continuous w) (hF : Continuous F)
    (hw_nonneg : ∀ U : GaugeConfig L, 0 ≤ w U)
    (hF_le : ∀ U : GaugeConfig L, |F U| ≤ B) :
    |∫ U : GaugeConfig L, w U * F U ∂(gaugeHaarMeasure L)| ≤
      B * ∫ U : GaugeConfig L, w U ∂(gaugeHaarMeasure L) := by
  have h1 : Integrable (fun U => |w U * F U|) (gaugeHaarMeasure L) :=
    (hw.mul hF).abs.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h2 : Integrable (fun U => B * w U) (gaugeHaarMeasure L) :=
    (continuous_const.mul hw).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  calc
    |∫ U, w U * F U ∂(gaugeHaarMeasure L)|
      ≤ ∫ U, |w U * F U| ∂(gaugeHaarMeasure L) := abs_integral_le_integral_abs
    _ ≤ ∫ U, B * w U ∂(gaugeHaarMeasure L) := by
        refine integral_mono h1 h2 (fun U => ?_)
        rw [abs_mul, abs_of_nonneg (hw_nonneg U), mul_comm]
        exact mul_le_mul_of_nonneg_right (hF_le U) (hw_nonneg U)
    _ = B * ∫ U, w U ∂(gaugeHaarMeasure L) := integral_const_mul B w

theorem probeExteriorPartition_div_characterPartition_le_and_abs_sub_one_le
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912) :
    let _ : Unit := ()
    probeExteriorPartition L β / characterPartition L β ≤ 144 / 143 ∧
    |probeExteriorPartition L β / characterPartition L β - 1| ≤ 50 * β := by
  have hZ_pos : 0 < characterPartition L β := characterPartition_pos hL β
  have h_char_int : Integrable (characterBoltzmannWeight (L := L) β) (gaugeHaarMeasure L) :=
    (continuous_characterBoltzmannWeight β).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_ext_int : Integrable (probeExteriorBoltzmannWeight (L := L) β) (gaugeHaarMeasure L) :=
    (continuous_probeExteriorBoltzmannWeight β).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_ext_nonneg : 0 ≤ probeExteriorPartition L β :=
    integral_nonneg (fun _ => (Real.exp_pos _).le)
  have h_lo_pt (U : GaugeConfig L) :
      (143 / 144 : ℝ) * probeExteriorBoltzmannWeight β U ≤ characterBoltzmannWeight β U := by
    rw [characterBoltzmannWeight_eq_exp_probeTouch_mul_probeExteriorBoltzmannWeight]
    refine mul_le_mul_of_nonneg_right ?_ (Real.exp_pos _).le
    have h_abs := (abs_le.mp (abs_probeTouchCharacterSum_le_forty_eight U)).1
    have h_add := Real.add_one_le_exp (β * probeTouchCharacterSum U)
    have h_mul : -(48 * β) ≤ β * probeTouchCharacterSum U := by nlinarith
    linarith
  have h_lo_int : (143 / 144 : ℝ) * probeExteriorPartition L β ≤ characterPartition L β := by
    unfold probeExteriorPartition characterPartition
    rw [← integral_const_mul]
    exact integral_mono (h_ext_int.const_mul _) h_char_int h_lo_pt
  have h_ratio_le : probeExteriorPartition L β / characterPartition L β ≤ 144 / 143 := by
    rw [div_le_iff₀ hZ_pos]
    linarith
  have h_diff_pt (U : GaugeConfig L) :
      |characterBoltzmannWeight β U - probeExteriorBoltzmannWeight β U| ≤
        49 * β * probeExteriorBoltzmannWeight β U := by
    rw [characterBoltzmannWeight_eq_exp_probeTouch_mul_probeExteriorBoltzmannWeight]
    have h_pos : 0 < probeExteriorBoltzmannWeight β U := Real.exp_pos _
    have h_fac :
        Real.exp (β * probeTouchCharacterSum U) * probeExteriorBoltzmannWeight β U -
          probeExteriorBoltzmannWeight β U =
        (Real.exp (β * probeTouchCharacterSum U) - 1) * probeExteriorBoltzmannWeight β U := by ring
    rw [h_fac, abs_mul, abs_of_pos h_pos]
    refine mul_le_mul_of_nonneg_right ?_ h_pos.le
    have hu : |β * probeTouchCharacterSum U| ≤ 48 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]
      nlinarith [abs_probeTouchCharacterSum_le_forty_eight U]
    have hu1 : |β * probeTouchCharacterSum U| ≤ 1 := by linarith
    have h_eb := abs_exp_sub_one_le_of_abs_le_one hu1
    have h_sq : (β * probeTouchCharacterSum U) ^ 2 ≤ (48 * β) ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    nlinarith
  have h_diff_int :
      |characterPartition L β - probeExteriorPartition L β| ≤
        49 * β * probeExteriorPartition L β := by
    unfold characterPartition probeExteriorPartition
    rw [← integral_sub h_char_int h_ext_int]
    calc
      |∫ U, (characterBoltzmannWeight β U - probeExteriorBoltzmannWeight β U) ∂(gaugeHaarMeasure L)|
        ≤ ∫ U, |characterBoltzmannWeight β U - probeExteriorBoltzmannWeight β U| ∂(gaugeHaarMeasure L) :=
          abs_integral_le_integral_abs
      _ ≤ ∫ U, 49 * β * probeExteriorBoltzmannWeight β U ∂(gaugeHaarMeasure L) :=
          integral_mono (h_char_int.sub h_ext_int).abs (h_ext_int.const_mul _) h_diff_pt
      _ = 49 * β * ∫ U, probeExteriorBoltzmannWeight β U ∂(gaugeHaarMeasure L) :=
          integral_const_mul _ _
  refine ⟨h_ratio_le, ?_⟩
  have h_sub_eq :
      probeExteriorPartition L β / characterPartition L β - 1 =
        (probeExteriorPartition L β - characterPartition L β) / characterPartition L β :=
    div_sub_one (ne_of_gt hZ_pos)
  rw [h_sub_eq, abs_div, abs_of_pos hZ_pos, abs_sub_comm, div_le_iff₀ hZ_pos]
  have h1 : 49 * β * probeExteriorPartition L β ≤ 50 * β * characterPartition L β := by
    nlinarith
  exact h_diff_int.trans h1

/-! #### Chunk 2: Side-by-Side Wing Plaquette Partition of `probeTouchPlaquettes L` -/

theorem mem_plaquetteLinks_iff_exists_plaquetteLinkAt {L : ℕ} (p : Plaquette L) (e : Link L) :
    e ∈ plaquetteLinks p ↔ ∃ k : Fin 4, plaquetteLinkAt p k = e := by
  constructor
  · intro he
    simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
    · exact ⟨2, rfl⟩
    · exact ⟨3, rfl⟩
  · rintro ⟨k, rfl⟩
    exact plaquetteLinkAt_mem_plaquetteLinks p k

theorem cubeLateralAt_ne_cubeBottomPlaquette (L : ℕ) (k : Fin 4) :
    cubeLateralAt L k ≠ cubeBottomPlaquette L := by
  intro h
  have hμ := congrArg Plaquette.μ h
  fin_cases k <;>
    simp [cubeLateralAt, cubeBottomPlaquette, cubeLateralPlaquette1, cubeLateralPlaquette2,
      cubeLateralPlaquette3, cubeLateralPlaquette4] at hμ

theorem plaquetteLinkAt_cubeBottomPlaquette_mem_cubeLateralAt (L : ℕ) (k : Fin 4) :
    plaquetteLinkAt (cubeBottomPlaquette L) k ∈ plaquetteLinks (cubeLateralAt L k) := by
  fin_cases k <;>
    simp [plaquetteLinkAt, cubeBottomPlaquette, cubeLateralAt, cubeLateralPlaquette1,
      cubeLateralPlaquette2, cubeLateralPlaquette3, cubeLateralPlaquette4, plaquetteLinks]

theorem not_mem_plaquetteLinks_cubeLateralAt_cubeBottom_of_ne
    {L : ℕ} (hL : 3 ≤ L) {k' k : Fin 4} (hne : k' ≠ k) :
    plaquetteLinkAt (cubeBottomPlaquette L) k' ∉ plaquetteLinks (cubeLateralAt L k) := by
  intro h
  exact hne (plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL
    (cubeLateralAt_ne_cubeBottomPlaquette L k) h
    (plaquetteLinkAt_cubeBottomPlaquette_mem_cubeLateralAt L k))

/-- Non-probe, non-lateral plaquettes touching `plaquetteLinkAt (cubeBottomPlaquette L) k`. -/
def botWingPlaquettes (L : ℕ) [NeZero L] (k : Fin 4) : Finset (Plaquette L) :=
  (restPlaquettes L \ cubeLateralSet L).filter
    (fun q => plaquetteLinkAt (cubeBottomPlaquette L) k ∈ plaquetteLinks q)

/-- Non-probe, non-lateral plaquettes touching `plaquetteLinkAt (cubeTopPlaquette L) k`. -/
def topWingPlaquettes (L : ℕ) [NeZero L] (k : Fin 4) : Finset (Plaquette L) :=
  (restPlaquettes L \ cubeLateralSet L).filter
    (fun q => plaquetteLinkAt (cubeTopPlaquette L) k ∈ plaquetteLinks q)

theorem mem_botWingPlaquettes_properties {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    {k : Fin 4} {q : Plaquette L} (hq : q ∈ botWingPlaquettes L k) :
    plaquetteLinkAt (cubeBottomPlaquette L) k ∈ plaquetteLinks q ∧
    (∀ k' : Fin 4, k' ≠ k → plaquetteLinkAt (cubeBottomPlaquette L) k' ∉ plaquetteLinks q) ∧
    (∀ k' : Fin 4, plaquetteLinkAt (cubeTopPlaquette L) k' ∉ plaquetteLinks q) := by
  simp only [botWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff, restPlaquettes,
    Finset.mem_univ, true_and] at hq
  rcases hq with ⟨⟨⟨hq_ne_bot, hq_ne_top⟩, hq_not_lat⟩, hq_mem⟩
  refine ⟨hq_mem, fun k' hk' h_other => ?_, fun k' h_top => ?_⟩
  · exact hk' (plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL hq_ne_bot h_other hq_mem)
  · have h_lat := eq_cubeLateralAt_of_mem_plaquetteLinks_bottom_and_top hL hq_mem h_top
    exact hq_not_lat (h_lat ▸ cubeLateralAt_mem_cubeLateralSet L k)

theorem mem_topWingPlaquettes_properties {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    {k : Fin 4} {q : Plaquette L} (hq : q ∈ topWingPlaquettes L k) :
    plaquetteLinkAt (cubeTopPlaquette L) k ∈ plaquetteLinks q ∧
    (∀ k' : Fin 4, k' ≠ k → plaquetteLinkAt (cubeTopPlaquette L) k' ∉ plaquetteLinks q) ∧
    (∀ k' : Fin 4, plaquetteLinkAt (cubeBottomPlaquette L) k' ∉ plaquetteLinks q) := by
  simp only [topWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff, restPlaquettes,
    Finset.mem_univ, true_and] at hq
  rcases hq with ⟨⟨⟨hq_ne_bot, hq_ne_top⟩, hq_not_lat⟩, hq_mem⟩
  refine ⟨hq_mem, fun k' hk' h_other => ?_, fun k' h_bot => ?_⟩
  · exact hk' (plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL hq_ne_top h_other hq_mem)
  · have h_lat := eq_cubeLateralAt_of_mem_plaquetteLinks_bottom_and_top hL h_bot hq_mem
    exact hq_not_lat (h_lat ▸ cubeLateralAt_mem_cubeLateralSet L k')

theorem card_botWingPlaquettes_le_four (L : ℕ) [NeZero L] (k : Fin 4) :
    (botWingPlaquettes L k).card ≤ 4 := by
  let e := plaquetteLinkAt (cubeBottomPlaquette L) k
  have h_sub :
      insert (cubeBottomPlaquette L) (insert (cubeLateralAt L k) (botWingPlaquettes L k)) ⊆
        incidentPlaquettes e := by
    intro q hq
    simp only [Finset.mem_insert] at hq
    rcases hq with rfl | rfl | hq_wing
    · exact mem_incidentPlaquettes_of_mem_plaquetteLinks _ e
        (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)
    · exact mem_incidentPlaquettes_of_mem_plaquetteLinks _ e
        (plaquetteLinkAt_cubeBottomPlaquette_mem_cubeLateralAt L k)
    · simp only [botWingPlaquettes, Finset.mem_filter] at hq_wing
      exact mem_incidentPlaquettes_of_mem_plaquetteLinks q e hq_wing.2
  have h_not_mem2 : cubeLateralAt L k ∉ botWingPlaquettes L k := by
    intro h
    simp only [botWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff] at h
    exact h.1.2 (cubeLateralAt_mem_cubeLateralSet L k)
  have h_not_mem1 : cubeBottomPlaquette L ∉ insert (cubeLateralAt L k) (botWingPlaquettes L k) := by
    simp only [Finset.mem_insert, not_or]
    refine ⟨(cubeLateralAt_ne_cubeBottomPlaquette L k).symm, fun h => ?_⟩
    simp only [botWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff, restPlaquettes,
      Finset.mem_univ, true_and] at h
    exact h.1.1.1 rfl
  have hc := Finset.card_le_card h_sub
  rw [Finset.card_insert_of_notMem h_not_mem1, Finset.card_insert_of_notMem h_not_mem2] at hc
  have h6 := incidentPlaquettes_card_le_six e
  omega

theorem card_topWingPlaquettes_le_four (L : ℕ) [NeZero L] (k : Fin 4) :
    (topWingPlaquettes L k).card ≤ 4 := by
  let e := plaquetteLinkAt (cubeTopPlaquette L) k
  have h_sub :
      insert (cubeTopPlaquette L) (insert (cubeLateralAt L k) (topWingPlaquettes L k)) ⊆
        incidentPlaquettes e := by
    intro q hq
    simp only [Finset.mem_insert] at hq
    rcases hq with rfl | rfl | hq_wing
    · exact mem_incidentPlaquettes_of_mem_plaquetteLinks _ e
        (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)
    · exact mem_incidentPlaquettes_of_mem_plaquetteLinks _ e
        (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLateralAt L k)
    · simp only [topWingPlaquettes, Finset.mem_filter] at hq_wing
      exact mem_incidentPlaquettes_of_mem_plaquetteLinks q e hq_wing.2
  have h_not_mem2 : cubeLateralAt L k ∉ topWingPlaquettes L k := by
    intro h
    simp only [topWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff] at h
    exact h.1.2 (cubeLateralAt_mem_cubeLateralSet L k)
  have h_not_mem1 : cubeTopPlaquette L ∉ insert (cubeLateralAt L k) (topWingPlaquettes L k) := by
    simp only [Finset.mem_insert, not_or]
    refine ⟨(cubeLateralAt_ne_cubeTopPlaquette L k).symm, fun h => ?_⟩
    simp only [topWingPlaquettes, Finset.mem_filter, Finset.mem_sdiff, restPlaquettes,
      Finset.mem_univ, true_and] at h
    exact h.1.1.2 rfl
  have hc := Finset.card_le_card h_sub
  rw [Finset.card_insert_of_notMem h_not_mem1, Finset.card_insert_of_notMem h_not_mem2] at hc
  have h6 := incidentPlaquettes_card_le_six e
  omega

noncomputable def latChar (L : ℕ) (k : Fin 4) (U : GaugeConfig L) : ℝ :=
  halfTraceRe (plaquetteHolonomy U (cubeLateralAt L k))

noncomputable def botWingCharSum (L : ℕ) [NeZero L] (k : Fin 4) (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ botWingPlaquettes L k, halfTraceRe (plaquetteHolonomy U q)

noncomputable def topWingCharSum (L : ℕ) [NeZero L] (k : Fin 4) (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ topWingPlaquettes L k, halfTraceRe (plaquetteHolonomy U q)

@[continuity, fun_prop]
theorem continuous_latChar {L : ℕ} [NeZero L] (k : Fin 4) :
    Continuous (latChar L k) := by
  unfold latChar; fun_prop

@[continuity, fun_prop]
theorem continuous_botWingCharSum {L : ℕ} [NeZero L] (k : Fin 4) :
    Continuous (botWingCharSum L k) := by
  unfold botWingCharSum; fun_prop

@[continuity, fun_prop]
theorem continuous_topWingCharSum {L : ℕ} [NeZero L] (k : Fin 4) :
    Continuous (topWingCharSum L k) := by
  unfold topWingCharSum; fun_prop

theorem abs_latChar_le_one {L : ℕ} (k : Fin 4) (U : GaugeConfig L) :
    |latChar L k U| ≤ 1 :=
  abs_halfTraceRe_le_one _

theorem abs_botWingCharSum_le_four {L : ℕ} [NeZero L] (k : Fin 4) (U : GaugeConfig L) :
    |botWingCharSum L k U| ≤ 4 := by
  unfold botWingCharSum
  have h_card : ((botWingPlaquettes L k).card : ℝ) ≤ 4 := by
    exact_mod_cast card_botWingPlaquettes_le_four L k
  calc
    |∑ q ∈ botWingPlaquettes L k, halfTraceRe (plaquetteHolonomy U q)|
      ≤ ∑ q ∈ botWingPlaquettes L k, |halfTraceRe (plaquetteHolonomy U q)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _q ∈ botWingPlaquettes L k, (1 : ℝ) :=
        Finset.sum_le_sum fun q _ => abs_halfTraceRe_le_one (plaquetteHolonomy U q)
    _ = ((botWingPlaquettes L k).card : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
    _ ≤ 4 := h_card

theorem abs_topWingCharSum_le_four {L : ℕ} [NeZero L] (k : Fin 4) (U : GaugeConfig L) :
    |topWingCharSum L k U| ≤ 4 := by
  unfold topWingCharSum
  have h_card : ((topWingPlaquettes L k).card : ℝ) ≤ 4 := by
    exact_mod_cast card_topWingPlaquettes_le_four L k
  calc
    |∑ q ∈ topWingPlaquettes L k, halfTraceRe (plaquetteHolonomy U q)|
      ≤ ∑ q ∈ topWingPlaquettes L k, |halfTraceRe (plaquetteHolonomy U q)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _q ∈ topWingPlaquettes L k, (1 : ℝ) :=
        Finset.sum_le_sum fun q _ => abs_halfTraceRe_le_one (plaquetteHolonomy U q)
    _ = ((topWingPlaquettes L k).card : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
    _ ≤ 4 := h_card

theorem probeTouchCharacterSum_eq_probes_add_sum_four
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (U : GaugeConfig L) :
    probeTouchCharacterSum U =
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) +
      ∑ k : Fin 4, (latChar L k U + botWingCharSum L k U + topWingCharSum L k U) := by
  have hL2 : 2 ≤ L := by omega
  let f (q : Plaquette L) : ℝ := halfTraceRe (plaquetteHolonomy U q)
  have h_bot_mem : cubeBottomPlaquette L ∈ probeTouchPlaquettes L := by
    simp only [probeTouchPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.not_disjoint_iff]
    exact ⟨plaquetteLinkAt (cubeBottomPlaquette L) 0,
      plaquetteLinkAt_mem_plaquetteLinks _ 0,
      plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 0⟩
  have h_top_mem : cubeTopPlaquette L ∈ probeTouchPlaquettes L := by
    simp only [probeTouchPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.not_disjoint_iff]
    exact ⟨plaquetteLinkAt (cubeTopPlaquette L) 0,
      plaquetteLinkAt_mem_plaquetteLinks _ 0,
      plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 0⟩
  have h_lat_sub : cubeLateralSet L ⊆ probeTouchPlaquettes L := by
    intro q hq
    simp only [cubeLateralSet, Finset.mem_insert, Finset.mem_singleton] at hq
    simp only [probeTouchPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.not_disjoint_iff]
    rcases hq with rfl | rfl | rfl | rfl
    · exact ⟨plaquetteLinkAt (cubeTopPlaquette L) 0,
        plaquetteLinkAt_cubeTopPlaquette_mem_cubeLateralAt L 0,
        plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 0⟩
    · exact ⟨plaquetteLinkAt (cubeTopPlaquette L) 1,
        plaquetteLinkAt_cubeTopPlaquette_mem_cubeLateralAt L 1,
        plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 1⟩
    · exact ⟨plaquetteLinkAt (cubeTopPlaquette L) 2,
        plaquetteLinkAt_cubeTopPlaquette_mem_cubeLateralAt L 2,
        plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 2⟩
    · exact ⟨plaquetteLinkAt (cubeTopPlaquette L) 3,
        plaquetteLinkAt_cubeTopPlaquette_mem_cubeLateralAt L 3,
        plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 3⟩
  let S_restTouch := (probeTouchPlaquettes L).filter
    (fun q => q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)
  have h_split1 :
      probeTouchCharacterSum U =
        (f (cubeBottomPlaquette L) + f (cubeTopPlaquette L)) + ∑ q ∈ S_restTouch, f q := by
    unfold probeTouchCharacterSum
    have h_s := (Finset.sum_filter_add_sum_filter_not (s := probeTouchPlaquettes L)
      (p := fun q : Plaquette L => q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)
      (f := f)).symm
    have h_compl :
        (probeTouchPlaquettes L).filter
          (fun q : Plaquette L => ¬(q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)) =
          {cubeBottomPlaquette L, cubeTopPlaquette L} := by
      ext q
      simp only [Finset.mem_filter, not_and_or, not_ne_iff, Finset.mem_insert, Finset.mem_singleton]
      exact ⟨fun h => h.2, fun h => by rcases h with rfl | rfl <;> [exact ⟨h_bot_mem, Or.inl rfl⟩; exact ⟨h_top_mem, Or.inr rfl⟩]⟩
    rw [h_s, h_compl, Finset.sum_pair (cubeBottomPlaquette_ne_cubeTopPlaquette hL2), add_comm]
  have h_lat_sub_restTouch : cubeLateralSet L ⊆ S_restTouch := by
    intro q hq
    simp only [S_restTouch, Finset.mem_filter]
    have hr := cubeLateralSet_subset_restPlaquettes L hq
    simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hr
    exact ⟨h_lat_sub hq, hr⟩
  let S_wing := S_restTouch \ cubeLateralSet L
  have h_split2 :
      (∑ q ∈ S_restTouch, f q) = lateralCharacterSum U + ∑ q ∈ S_wing, f q := by
    have hs := Finset.sum_sdiff h_lat_sub_restTouch (f := f)
    unfold lateralCharacterSum
    linarith
  have h_wing_biUnion :
      S_wing =
        (Finset.univ : Finset (Fin 4)).biUnion (botWingPlaquettes L) ∪
          (Finset.univ : Finset (Fin 4)).biUnion (topWingPlaquettes L) := by
    ext q
    simp only [S_wing, S_restTouch, probeTouchPlaquettes, probeLinks, restPlaquettes,
      botWingPlaquettes, topWingPlaquettes, Finset.mem_sdiff, Finset.mem_filter, Finset.mem_univ,
      true_and, Finset.not_disjoint_iff, Finset.mem_union, Finset.mem_biUnion]
    constructor
    · rintro ⟨⟨⟨e, he_q, he_bot | he_top⟩, hq_ne⟩, hq_not_lat⟩
      · obtain ⟨k, rfl⟩ := (mem_plaquetteLinks_iff_exists_plaquetteLinkAt _ e).mp he_bot
        exact Or.inl ⟨k, ⟨hq_ne, hq_not_lat⟩, he_q⟩
      · obtain ⟨k, rfl⟩ := (mem_plaquetteLinks_iff_exists_plaquetteLinkAt _ e).mp he_top
        exact Or.inr ⟨k, ⟨hq_ne, hq_not_lat⟩, he_q⟩
    · rintro (⟨k, ⟨hq_ne, hq_not_lat⟩, he_q⟩ | ⟨k, ⟨hq_ne, hq_not_lat⟩, he_q⟩)
      · exact ⟨⟨⟨_, he_q, Or.inl (plaquetteLinkAt_mem_plaquetteLinks _ k)⟩, hq_ne⟩, hq_not_lat⟩
      · exact ⟨⟨⟨_, he_q, Or.inr (plaquetteLinkAt_mem_plaquetteLinks _ k)⟩, hq_ne⟩, hq_not_lat⟩
  have h_disj_bot_top :
      Disjoint ((Finset.univ : Finset (Fin 4)).biUnion (botWingPlaquettes L))
        ((Finset.univ : Finset (Fin 4)).biUnion (topWingPlaquettes L)) := by
    rw [Finset.disjoint_left]
    intro q hq_bot hq_top
    simp only [Finset.mem_biUnion, Finset.mem_univ, true_and] at hq_bot hq_top
    rcases hq_bot with ⟨k₁, hk₁⟩
    rcases hq_top with ⟨k₂, hk₂⟩
    exact (mem_botWingPlaquettes_properties hL hk₁).2.2 k₂ (mem_topWingPlaquettes_properties hL hk₂).1
  have h_disj_bot :
      ((Finset.univ : Finset (Fin 4)) : Set (Fin 4)).PairwiseDisjoint (botWingPlaquettes L) := by
    intro k₁ _ k₂ _ hne
    change Disjoint (botWingPlaquettes L k₁) (botWingPlaquettes L k₂)
    rw [Finset.disjoint_left]
    intro q hq₁ hq₂
    exact (mem_botWingPlaquettes_properties hL hq₁).2.1 k₂ hne.symm
      (mem_botWingPlaquettes_properties hL hq₂).1
  have h_disj_top :
      ((Finset.univ : Finset (Fin 4)) : Set (Fin 4)).PairwiseDisjoint (topWingPlaquettes L) := by
    intro k₁ _ k₂ _ hne
    change Disjoint (topWingPlaquettes L k₁) (topWingPlaquettes L k₂)
    rw [Finset.disjoint_left]
    intro q hq₁ hq₂
    exact (mem_topWingPlaquettes_properties hL hq₁).2.1 k₂ hne.symm
      (mem_topWingPlaquettes_properties hL hq₂).1
  have h_wing_sum :
      (∑ q ∈ S_wing, f q) =
        (∑ k : Fin 4, botWingCharSum L k U) + (∑ k : Fin 4, topWingCharSum L k U) := by
    rw [h_wing_biUnion, Finset.sum_union h_disj_bot_top,
        Finset.sum_biUnion h_disj_bot, Finset.sum_biUnion h_disj_top]
    rfl
  have h_lat_sum : lateralCharacterSum U = ∑ k : Fin 4, latChar L k U := by
    rw [lateralCharacterSum_eq_sum_four hL2 U, Fin.sum_univ_four]
    rfl
  rw [h_split1, h_split2, h_wing_sum, h_lat_sum, Finset.sum_add_distrib, Finset.sum_add_distrib]
  ring

/-! #### Chunk 3: Link-by-Link Invariance, Centered Plaquette Haar Mean, and Disconnected Bound -/

theorem latChar_update_bottom_of_ne {L : ℕ} (hL : 3 ≤ L) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) (g : SU2) :
    latChar L k (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k').x
      (plaquetteLinkAt (cubeBottomPlaquette L) k').μ g) = latChar L k U := by
  unfold latChar
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L k)
      (not_mem_plaquetteLinks_cubeLateralAt_cubeBottom_of_ne hL hne) g]

theorem latChar_update_top_of_ne {L : ℕ} (hL : 3 ≤ L) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) (g : SU2) :
    latChar L k (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k').x
      (plaquetteLinkAt (cubeTopPlaquette L) k').μ g) = latChar L k U := by
  unfold latChar
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L k)
      (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL hne) g]

theorem botWingCharSum_update_bottom_of_ne {L : ℕ} [NeZero L] (hL : 3 ≤ L) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) (g : SU2) :
    botWingCharSum L k (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k').x
      (plaquetteLinkAt (cubeBottomPlaquette L) k').μ g) = botWingCharSum L k U := by
  unfold botWingCharSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q
      ((mem_botWingPlaquettes_properties hL hq).2.1 k' hne) g]

theorem botWingCharSum_update_top {L : ℕ} [NeZero L] (hL : 3 ≤ L) (k' k : Fin 4)
    (U : GaugeConfig L) (g : SU2) :
    botWingCharSum L k (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k').x
      (plaquetteLinkAt (cubeTopPlaquette L) k').μ g) = botWingCharSum L k U := by
  unfold botWingCharSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q
