    ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * β ^ 4 ≤ |wilsonProbeCov L β| :=
  (wilsonProbeCov_sandwich_of_clusterRemainder hR hL hβ hβ₀).1.trans (le_abs_self _)

/-! ### Stage p3.B3 (Part 2): Explicit Torus-to-Cube Haar Reduction and Normalized Covariance Decomposition -/

/-- Base site `(-1, 0, 0, 0)` of the reflected canonical spatial probe on `Lattice4D L`. -/
def cubeBottomBase (L : ℕ) : Lattice4D L :=
  -unitVec L 0

/-- Bottom spatial plaquette of the canonical unit 3-cube at `t = -1` in the `(1, 2)` plane. -/
def cubeBottomPlaquette (L : ℕ) : Plaquette L :=
  ⟨cubeBottomBase L, 1, 2, by decide⟩

/-- Top spatial plaquette of the canonical unit 3-cube at `t = 0` in the `(1, 2)` plane. -/
def cubeTopPlaquette (L : ℕ) : Plaquette L :=
  ⟨0, 1, 2, by decide⟩

/-- First lateral temporal plaquette of the canonical unit 3-cube at `(-1, 0, 0, 0)` in the `(0, 1)` plane. -/
def cubeLateralPlaquette1 (L : ℕ) : Plaquette L :=
  ⟨cubeBottomBase L, 0, 1, by decide⟩

/-- Second lateral temporal plaquette of the canonical unit 3-cube at `(-1, 1, 0, 0)` in the `(0, 2)` plane. -/
def cubeLateralPlaquette2 (L : ℕ) : Plaquette L :=
  ⟨shift (cubeBottomBase L) 1, 0, 2, by decide⟩

/-- Third lateral temporal plaquette of the canonical unit 3-cube at `(-1, 0, 1, 0)` in the `(0, 1)` plane. -/
def cubeLateralPlaquette3 (L : ℕ) : Plaquette L :=
  ⟨shift (cubeBottomBase L) 2, 0, 1, by decide⟩

/-- Fourth lateral temporal plaquette of the canonical unit 3-cube at `(-1, 0, 0, 0)` in the `(0, 2)` plane. -/
def cubeLateralPlaquette4 (L : ℕ) : Plaquette L :=
  ⟨cubeBottomBase L, 0, 2, by decide⟩

@[simp]
theorem shift_cubeBottomBase_zero (L : ℕ) :
    shift (cubeBottomBase L) 0 = 0 := by
  unfold shift cubeBottomBase
  exact neg_add_cancel (unitVec L 0)

@[simp]
theorem shift_shift_cubeBottomBase_one_zero (L : ℕ) :
    shift (shift (cubeBottomBase L) 1) 0 = shift 0 1 := by
  rw [shift_comm (cubeBottomBase L) 1 0, shift_cubeBottomBase_zero]

@[simp]
theorem shift_shift_cubeBottomBase_two_zero (L : ℕ) :
    shift (shift (cubeBottomBase L) 2) 0 = shift 0 2 := by
  rw [shift_comm (cubeBottomBase L) 2 0, shift_cubeBottomBase_zero]

/-- On `Lattice4D L`, the canonical positive-time spatial probe `canonicalSpatialProbe a ha`
evaluates to the normalized real trace `halfTraceRe` of `cubeTopPlaquette L`. -/
theorem physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette
    (L : ℕ) {a : ℚ} (ha : 0 < a) (U : GaugeConfig L) :
    physicalWilsonLoop L (a : ℝ) (canonicalSpatialProbe a ha) U =
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
  rw [(physicalWilsonLoop_canonicalSpatialProbe_spacing_indep L ha).1]
  unfold physicalWilsonLoop
  rw [latticeBase_canonicalSpatialProbe_eq_zero (one_pos : (0 : ℚ) < 1)]
  have hsite : latticeSite L 0 = (0 : Lattice4D L) := by
    funext i
    simp [latticeSite]
  have hloop :
      (canonicalSpatialProbe 1 one_pos).latticeLoop ((1 : ℚ) : ℝ) =
        rectangleSteps 1 2 1 1 := by
    unfold PhysicalRectangle.latticeLoop
    obtain ⟨h1, h2⟩ := canonicalSpatialProbe_steps (one_pos : (0 : ℚ) < 1)
    rw [h1, h2]
    rfl
  rw [hsite, hloop, wilsonLoop]
  exact congrArg halfTraceRe (pathHolonomy_rectangleSteps_one_one U (cubeTopPlaquette L))

/-- On `Lattice4D L`, the reflected canonical spatial probe `(canonicalSpatialProbe a ha).timeReflect`
evaluates to the normalized real trace `halfTraceRe` of `cubeBottomPlaquette L`. -/
theorem physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette
    (L : ℕ) {a : ℚ} (ha : 0 < a) (U : GaugeConfig L) :
    physicalWilsonLoop L (a : ℝ) (canonicalSpatialProbe a ha).timeReflect U =
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
  rw [(physicalWilsonLoop_canonicalSpatialProbe_spacing_indep L ha).2]
  unfold physicalWilsonLoop
  rw [latticeBase_timeReflect_canonicalSpatialProbe (one_pos : (0 : ℚ) < 1)]
  have hsite :
      latticeSite L (fun i : Fin 4 => if i = 0 then (-1 : ℤ) else 0) =
        cubeBottomBase L := by
    funext i
    unfold latticeSite cubeBottomBase unitVec
    by_cases hi : i = 0 <;> simp [hi]
  have hloop :
      (canonicalSpatialProbe 1 one_pos).timeReflect.latticeLoop ((1 : ℚ) : ℝ) =
        rectangleSteps 1 2 1 1 := by
    unfold PhysicalRectangle.latticeLoop PhysicalRectangle.timeReflect
    obtain ⟨h1, h2⟩ := canonicalSpatialProbe_steps (one_pos : (0 : ℚ) < 1)
    exact congrArg₂ (rectangleSteps 1 2) h1 h2
  rw [hsite, hloop, wilsonLoop]
  exact congrArg halfTraceRe (pathHolonomy_rectangleSteps_one_one U (cubeBottomPlaquette L))

theorem one_ne_zero_of_two_le {L : ℕ} (hL : 2 ≤ L) : (1 : ZMod L) ≠ 0 := by
  intro h
  have hdvd : L ∣ 1 := (ZMod.natCast_eq_zero_iff 1 L).mp (by simpa using h)
  have h1 : L ≤ 1 := Nat.le_of_dvd Nat.one_pos hdvd
  omega

theorem neg_one_ne_zero_of_two_le {L : ℕ} (hL : 2 ≤ L) : (-1 : ZMod L) ≠ 0 :=
  neg_ne_zero.mpr (one_ne_zero_of_two_le hL)

theorem halfTraceRe_mul_comm (A B : SU2) :
    halfTraceRe (A * B) = halfTraceRe (B * A) := by
  have h := halfTraceRe_conj A⁻¹ (A * B)
  have h_eq : A⁻¹ * (A * B) * A⁻¹⁻¹ = B * A := by group
  rw [h_eq] at h
  exact h.symm

/-- Two-character left-translated Schur contraction on `SU2.haarProbability`:
for any `α, β : ℝ` and `C₁, C₂ : SU2`, integrating `(α + β * halfTraceRe (C₁ * g)) * halfTraceRe (C₂ * g)`
over `g : SU2` kills the `α` term by `integral_halfTraceRe_mul_left_eq_zero` and contracts the `β` term
to `(β / 4) * halfTraceRe (C₂ * C₁⁻¹)`. -/
theorem integral_add_mul_halfTraceRe_mul_left_eq (α β : ℝ) (C₁ C₂ : SU2) :
    (∫ g : SU2, (α + β * halfTraceRe (C₁ * g)) * halfTraceRe (C₂ * g) ∂SU2.haarProbability) =
      (β / 4) * halfTraceRe (C₂ * C₁⁻¹) := by
  let F : SU2 → ℝ := fun h => (α + β * halfTraceRe h) * halfTraceRe ((C₂ * C₁⁻¹) * h)
  have hF_cont : Continuous F := by
    refine (continuous_const.add (continuous_const.mul continuous_halfTraceRe)).mul
      (continuous_halfTraceRe.comp (continuous_const.mul continuous_id))
  have hmp : MeasurePreserving (fun g : SU2 => C₁ * g)
      (SU2.haarProbability : Measure SU2) (SU2.haarProbability : Measure SU2) :=
    measurePreserving_mul_left (SU2.haarProbability : Measure SU2) C₁
  have h_shift :
      (∫ g : SU2, F (C₁ * g) ∂SU2.haarProbability) =
        ∫ h : SU2, F h ∂SU2.haarProbability := by
    symm
    conv_lhs => rw [← hmp.map_eq]
    exact integral_map (continuous_const.mul continuous_id).aemeasurable hF_cont.aestronglyMeasurable
  have h_pt :
      (fun g : SU2 => (α + β * halfTraceRe (C₁ * g)) * halfTraceRe (C₂ * g)) =
        fun g : SU2 => F (C₁ * g) := by
    funext g
    dsimp [F]
    have hmul : (C₂ * C₁⁻¹) * (C₁ * g) = C₂ * g := by group
    rw [hmul]
  rw [h_pt, h_shift]
  have h_int1 : Integrable (fun h : SU2 => α * halfTraceRe ((C₂ * C₁⁻¹) * h)) SU2.haarProbability :=
    (continuous_const.mul (continuous_halfTraceRe.comp (continuous_const.mul continuous_id))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_int2 : Integrable (fun h : SU2 => β * (halfTraceRe h * halfTraceRe ((C₂ * C₁⁻¹) * h))) SU2.haarProbability :=
    (continuous_const.mul (continuous_halfTraceRe.mul
      (continuous_halfTraceRe.comp (continuous_const.mul continuous_id)))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_expand :
      F = fun h : SU2 =>
        α * halfTraceRe ((C₂ * C₁⁻¹) * h) +
          β * (halfTraceRe h * halfTraceRe ((C₂ * C₁⁻¹) * h)) := by
    funext h
    dsimp [F]
    ring
  rw [h_expand, integral_add h_int1 h_int2, integral_const_mul,
    integral_halfTraceRe_mul_left_eq_zero (C₂ * C₁⁻¹), mul_zero, zero_add,
    integral_const_mul, integral_halfTraceRe_mul_halfTraceRe_left_eq_quarter (C₂ * C₁⁻¹)]
  ring

/-- Single-link Haar conditioning identity on `gaugeHaarMeasure L` for any continuous observable
`H : GaugeConfig L → ℝ` and any link `e₀ : Link L`. -/
theorem integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
    {L : ℕ} [NeZero L] (e₀ : Link L) (H : GaugeConfig L → ℝ) (hH : Continuous H) :
    (∫ V : GaugeConfig L, H V ∂(gaugeHaarMeasure L)) =
      ∫ V : GaugeConfig L,
        (∫ g : SU2, H (updateGaugeLink L V e₀.x e₀.μ g) ∂SU2.haarProbability)
        ∂(gaugeHaarMeasure L) := by
  obtain ⟨M, hM⟩ := isCompact_univ.exists_bound_of_continuousOn hH.continuousOn
  exact integral_groupGaugeHaarMeasure_eq_integral_updateGroupGaugeLink SU2 e₀ H
    hH.measurable (fun V => by simpa [Real.norm_eq_abs] using hM V (Set.mem_univ V))

theorem updateGaugeLink_apply_of_dir_ne {L : ℕ} (U : GaugeConfig L)
    (x y : Lattice4D L) {μ ν : Direction} (hμν : ν ≠ μ) (g : SU2) :
    updateGaugeLink L U x μ g ⟨y, ν⟩ = U ⟨y, ν⟩ :=
  (updateGaugeLink_same_and_other L U x μ g).2 ⟨y, ν⟩ (fun h => hμν (congrArg Link.μ h))

theorem updateGaugeLink_apply_of_coord_ne {L : ℕ} (U : GaugeConfig L)
    (x y : Lattice4D L) (μ : Direction) (i : Fin 4) (hi : y i ≠ x i) (g : SU2) :
    updateGaugeLink L U x μ g ⟨y, μ⟩ = U ⟨y, μ⟩ :=
  (updateGaugeLink_same_and_other L U x μ g).2 ⟨y, μ⟩
    (fun h => hi (congrFun (congrArg Link.x h) i))

/-- For any `L ≥ 2` and any plaquette `p : Plaquette L`, updating the first boundary link
`⟨p.x, p.μ⟩` to `g : SU2` leaves the other 3 boundary links of `p` unchanged and writes
`halfTraceRe (plaquetteHolonomy ... p)` in the left-multiplied form `halfTraceRe (C * g)`. -/
theorem halfTraceRe_plaquetteHolonomy_update_first {L : ℕ} (hL : 2 ≤ L)
    (U : GaugeConfig L) (p : Plaquette L) (g : SU2) :
    halfTraceRe (plaquetteHolonomy (updateGaugeLink L U p.x p.μ g) p) =
      halfTraceRe ((U ⟨shift p.x p.μ, p.ν⟩ * (U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹) * g) := by
  have h1 : updateGaugeLink L U p.x p.μ g ⟨p.x, p.μ⟩ = g :=
    (updateGaugeLink_same_and_other L U p.x p.μ g).1
  have h2 : updateGaugeLink L U p.x p.μ g ⟨shift p.x p.μ, p.ν⟩ = U ⟨shift p.x p.μ, p.ν⟩ :=
    updateGaugeLink_apply_of_dir_ne U p.x (shift p.x p.μ) p.h.ne' g
  have h3 : updateGaugeLink L U p.x p.μ g ⟨shift p.x p.ν, p.μ⟩ = U ⟨shift p.x p.ν, p.μ⟩ := by
    refine updateGaugeLink_apply_of_coord_ne U p.x (shift p.x p.ν) p.μ p.ν ?_ g
    intro h_eq
    have h_one : (1 : ZMod L) = 0 := by
      simpa [shift, unitVec] using sub_eq_zero.mpr h_eq
    exact one_ne_zero_of_two_le hL h_one
  have h4 : updateGaugeLink L U p.x p.μ g ⟨p.x, p.ν⟩ = U ⟨p.x, p.ν⟩ :=
    updateGaugeLink_apply_of_dir_ne U p.x p.x p.h.ne' g
  unfold plaquetteHolonomy
  rw [h1, h2, h3, h4]
  have h_assoc :
      g * U ⟨shift p.x p.μ, p.ν⟩ * (U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹ =
        g * (U ⟨shift p.x p.μ, p.ν⟩ * (U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹) := by
    group
  rw [h_assoc, halfTraceRe_mul_comm g]

/-- For every `L ≥ 2` and every plaquette `p : Plaquette L`, the free Haar expectation of
`halfTraceRe (plaquetteHolonomy U p)` vanishes on `gaugeHaarMeasure L`. -/
theorem integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (p : Plaquette L) :
    (∫ U : GaugeConfig L, halfTraceRe (plaquetteHolonomy U p) ∂(gaugeHaarMeasure L)) = 0 := by
  have h_cont : Continuous (fun U : GaugeConfig L => halfTraceRe (plaquetteHolonomy U p)) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p)
  rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨p.x, p.μ⟩ _ h_cont]
  have h_inner (U : GaugeConfig L) :
      (∫ g : SU2, halfTraceRe (plaquetteHolonomy (updateGaugeLink L U p.x p.μ g) p)
        ∂SU2.haarProbability) = 0 := by
    simp_rw [halfTraceRe_plaquetteHolonomy_update_first hL U p]
    exact integral_halfTraceRe_mul_left_eq_zero _
  simp_rw [h_inner, integral_zero]

/-- For any `L ≥ 2` and any plaquette `p : Plaquette L`, updating the second boundary link
`⟨shift p.x p.μ, p.ν⟩` to `g : SU2` leaves the other 3 boundary links of `p` unchanged and writes
`halfTraceRe (plaquetteHolonomy ... p)` in the left-multiplied form `halfTraceRe (C * g)`. -/
theorem halfTraceRe_plaquetteHolonomy_update_second {L : ℕ} (hL : 2 ≤ L)
    (U : GaugeConfig L) (p : Plaquette L) (g : SU2) :
    halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift p.x p.μ) p.ν g) p) =
      halfTraceRe (((U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹ * U ⟨p.x, p.μ⟩) * g) := by
  have h1 : updateGaugeLink L U (shift p.x p.μ) p.ν g ⟨p.x, p.μ⟩ = U ⟨p.x, p.μ⟩ :=
    updateGaugeLink_apply_of_dir_ne U (shift p.x p.μ) p.x p.h.ne g
  have h2 : updateGaugeLink L U (shift p.x p.μ) p.ν g ⟨shift p.x p.μ, p.ν⟩ = g :=
    (updateGaugeLink_same_and_other L U (shift p.x p.μ) p.ν g).1
  have h3 : updateGaugeLink L U (shift p.x p.μ) p.ν g ⟨shift p.x p.ν, p.μ⟩ = U ⟨shift p.x p.ν, p.μ⟩ :=
    updateGaugeLink_apply_of_dir_ne U (shift p.x p.μ) (shift p.x p.ν) p.h.ne g
  have h4 : updateGaugeLink L U (shift p.x p.μ) p.ν g ⟨p.x, p.ν⟩ = U ⟨p.x, p.ν⟩ := by
    refine updateGaugeLink_apply_of_coord_ne U (shift p.x p.μ) p.x p.ν p.μ ?_ g
    intro h_eq
    have h_one : (1 : ZMod L) = 0 := by
      simpa [shift, unitVec] using sub_eq_zero.mpr h_eq.symm
    exact one_ne_zero_of_two_le hL h_one
  unfold plaquetteHolonomy
  rw [h1, h2, h3, h4]
  have h_assoc :
      U ⟨p.x, p.μ⟩ * g * (U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹ =
        (U ⟨p.x, p.μ⟩ * g) * ((U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹) := by
    group
  rw [h_assoc, halfTraceRe_mul_comm (U ⟨p.x, p.μ⟩ * g)]
  have h_assoc2 :
      ((U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹) * (U ⟨p.x, p.μ⟩ * g) =
        ((U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹ * U ⟨p.x, p.μ⟩) * g := by
    group
  rw [h_assoc2]

/-- For any `L ≥ 2` and any plaquette `p : Plaquette L`, updating the fourth boundary link
`⟨p.x, p.ν⟩` to `g : SU2` leaves the other 3 boundary links of `p` unchanged and writes
`halfTraceRe (plaquetteHolonomy ... p)` in the left-multiplied form `halfTraceRe (C * g)`. -/
theorem halfTraceRe_plaquetteHolonomy_update_fourth {L : ℕ} (hL : 2 ≤ L)
    (U : GaugeConfig L) (p : Plaquette L) (g : SU2) :
    halfTraceRe (plaquetteHolonomy (updateGaugeLink L U p.x p.ν g) p) =
      halfTraceRe ((U ⟨shift p.x p.ν, p.μ⟩ * (U ⟨shift p.x p.μ, p.ν⟩)⁻¹ * (U ⟨p.x, p.μ⟩)⁻¹) * g) := by
  have h1 : updateGaugeLink L U p.x p.ν g ⟨p.x, p.μ⟩ = U ⟨p.x, p.μ⟩ :=
    updateGaugeLink_apply_of_dir_ne U p.x p.x p.h.ne g
  have h2 : updateGaugeLink L U p.x p.ν g ⟨shift p.x p.μ, p.ν⟩ = U ⟨shift p.x p.μ, p.ν⟩ := by
    refine updateGaugeLink_apply_of_coord_ne U p.x (shift p.x p.μ) p.ν p.μ ?_ g
    intro h_eq
    have h_one : (1 : ZMod L) = 0 := by
      simpa [shift, unitVec] using sub_eq_zero.mpr h_eq
    exact one_ne_zero_of_two_le hL h_one
  have h3 : updateGaugeLink L U p.x p.ν g ⟨shift p.x p.ν, p.μ⟩ = U ⟨shift p.x p.ν, p.μ⟩ :=
    updateGaugeLink_apply_of_dir_ne U p.x (shift p.x p.ν) p.h.ne g
  have h4 : updateGaugeLink L U p.x p.ν g ⟨p.x, p.ν⟩ = g :=
    (updateGaugeLink_same_and_other L U p.x p.ν g).1
  unfold plaquetteHolonomy
  rw [h1, h2, h3, h4, ← halfTraceRe_inv]
  have h_inv :
      (U ⟨p.x, p.μ⟩ * U ⟨shift p.x p.μ, p.ν⟩ * (U ⟨shift p.x p.ν, p.μ⟩)⁻¹ * g⁻¹)⁻¹ =
        g * (U ⟨shift p.x p.ν, p.μ⟩ * (U ⟨shift p.x p.μ, p.ν⟩)⁻¹ * (U ⟨p.x, p.μ⟩)⁻¹) := by
    group
  rw [h_inv, halfTraceRe_mul_comm g]

theorem plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero {L : ℕ} (hL : 2 ≤ L)
    (U : GaugeConfig L) (x : Lattice4D L) (hx : x 0 = 0) (μ : Direction) (g : SU2) :
    plaquetteHolonomy (updateGaugeLink L U x μ g) (cubeBottomPlaquette L) =
      plaquetteHolonomy U (cubeBottomPlaquette L) := by
  have h_bot0 : cubeBottomBase L 0 ≠ x 0 := by
    rw [hx]
    simpa [cubeBottomBase, unitVec] using neg_one_ne_zero_of_two_le hL
  have h_s10 : shift (cubeBottomBase L) 1 0 ≠ x 0 := by
    rw [hx]
    simpa [shift, cubeBottomBase, unitVec] using neg_one_ne_zero_of_two_le hL
  have h_s20 : shift (cubeBottomBase L) 2 0 ≠ x 0 := by
    rw [hx]
    simpa [shift, cubeBottomBase, unitVec] using neg_one_ne_zero_of_two_le hL
  unfold plaquetteHolonomy cubeBottomPlaquette
  dsimp only
  rw [(updateGaugeLink_same_and_other L U x μ g).2 _ (fun h => h_bot0 (congrFun (congrArg Link.x h) 0)),
      (updateGaugeLink_same_and_other L U x μ g).2 _ (fun h => h_s10 (congrFun (congrArg Link.x h) 0)),
      (updateGaugeLink_same_and_other L U x μ g).2 _ (fun h => h_s20 (congrFun (congrArg Link.x h) 0)),
      (updateGaugeLink_same_and_other L U x μ g).2 _ (fun h => h_bot0 (congrFun (congrArg Link.x h) 0))]

theorem plaquetteHolonomy_of_plane01_update_dir2 {L : ℕ}
    (U : GaugeConfig L) (p : Plaquette L) (hμ : p.μ = 0) (hν : p.ν = 1)
    (x : Lattice4D L) (g : SU2) :
    plaquetteHolonomy (updateGaugeLink L U x 2 g) p = plaquetteHolonomy U p := by
  have h02 : p.μ ≠ (2 : Direction) := by rw [hμ]; decide
  have h12 : p.ν ≠ (2 : Direction) := by rw [hν]; decide
  unfold plaquetteHolonomy
  rw [updateGaugeLink_apply_of_dir_ne U x p.x h02 g,
      updateGaugeLink_apply_of_dir_ne U x (shift p.x p.μ) h12 g,
      updateGaugeLink_apply_of_dir_ne U x (shift p.x p.ν) h02 g,
      updateGaugeLink_apply_of_dir_ne U x p.x h12 g]

theorem plaquetteHolonomy_of_plane02_update_dir1 {L : ℕ}
    (U : GaugeConfig L) (p : Plaquette L) (hμ : p.μ = 0) (hν : p.ν = 2)
    (x : Lattice4D L) (g : SU2) :
    plaquetteHolonomy (updateGaugeLink L U x 1 g) p = plaquetteHolonomy U p := by
  have h01 : p.μ ≠ (1 : Direction) := by rw [hμ]; decide
  have h21 : p.ν ≠ (1 : Direction) := by rw [hν]; decide
  unfold plaquetteHolonomy
  rw [updateGaugeLink_apply_of_dir_ne U x p.x h01 g,
      updateGaugeLink_apply_of_dir_ne U x (shift p.x p.μ) h21 g,
      updateGaugeLink_apply_of_dir_ne U x (shift p.x p.ν) h01 g,
      updateGaugeLink_apply_of_dir_ne U x p.x h21 g]

theorem plaquetteHolonomy_cubeLateralPlaquette2_update_topLink4 {L : ℕ} (hL : 2 ≤ L)
    (U : GaugeConfig L) (g : SU2) :
    plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeLateralPlaquette2 L) =
      plaquetteHolonomy U (cubeLateralPlaquette2 L) := by
  have h1 : shift (cubeBottomBase L) 1 1 ≠ (0 : Lattice4D L) 1 := by
    simpa [shift, cubeBottomBase, unitVec] using one_ne_zero_of_two_le hL
  have h2 : shift (shift (cubeBottomBase L) 1) 0 1 ≠ (0 : Lattice4D L) 1 := by
    simpa [shift, cubeBottomBase, unitVec] using one_ne_zero_of_two_le hL
  have h3 : shift (shift (cubeBottomBase L) 1) 2 1 ≠ (0 : Lattice4D L) 1 := by
    simpa [shift, cubeBottomBase, unitVec] using one_ne_zero_of_two_le hL
  unfold plaquetteHolonomy cubeLateralPlaquette2
  dsimp only
  rw [(updateGaugeLink_same_and_other L U 0 2 g).2 _ (fun h => h1 (congrFun (congrArg Link.x h) 1)),
      (updateGaugeLink_same_and_other L U 0 2 g).2 _ (fun h => h2 (congrFun (congrArg Link.x h) 1)),
      (updateGaugeLink_same_and_other L U 0 2 g).2 _ (fun h => h3 (congrFun (congrArg Link.x h) 1)),
      (updateGaugeLink_same_and_other L U 0 2 g).2 _ (fun h => h1 (congrFun (congrArg Link.x h) 1))]

theorem plaquetteHolonomy_cubeLateralPlaquette1_update_topLink3 {L : ℕ} (hL : 2 ≤ L)
    (U : GaugeConfig L) (g : SU2) :
    plaquetteHolonomy (updateGaugeLink L U (shift 0 2) 1 g) (cubeLateralPlaquette1 L) =
      plaquetteHolonomy U (cubeLateralPlaquette1 L) := by
  have h1 : cubeBottomBase L 2 ≠ shift (0 : Lattice4D L) 2 2 := by
    simpa [shift, cubeBottomBase, unitVec] using (one_ne_zero_of_two_le hL).symm
  have h2 : shift (cubeBottomBase L) 0 2 ≠ shift (0 : Lattice4D L) 2 2 := by
    simpa [shift, cubeBottomBase, unitVec] using (one_ne_zero_of_two_le hL).symm
  have h3 : shift (cubeBottomBase L) 1 2 ≠ shift (0 : Lattice4D L) 2 2 := by
    simpa [shift, cubeBottomBase, unitVec] using (one_ne_zero_of_two_le hL).symm
  unfold plaquetteHolonomy cubeLateralPlaquette1
  dsimp only
  rw [(updateGaugeLink_same_and_other L U (shift 0 2) 1 g).2 _ (fun h => h1 (congrFun (congrArg Link.x h) 2)),
      (updateGaugeLink_same_and_other L U (shift 0 2) 1 g).2 _ (fun h => h2 (congrFun (congrArg Link.x h) 2)),
      (updateGaugeLink_same_and_other L U (shift 0 2) 1 g).2 _ (fun h => h3 (congrFun (congrArg Link.x h) 2)),
      (updateGaugeLink_same_and_other L U (shift 0 2) 1 g).2 _ (fun h => h1 (congrFun (congrArg Link.x h) 2))]

theorem integral_topLink4_cubeLateral4_mul_cubeTop {L : ℕ} (hL : 2 ≤ L)
    (α₄ β₄ : ℝ) (U : GaugeConfig L) :
    (∫ g : SU2,
      (α₄ + β₄ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeLateralPlaquette4 L))) *
        halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeTopPlaquette L))
      ∂SU2.haarProbability) =
    (β₄ / 4) *
      halfTraceRe
        (U ⟨shift 0 2, 1⟩ * (U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ *
          (U ⟨cubeBottomBase L, 0⟩)⁻¹ * U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 0⟩) := by
  have h_lat4 (g : SU2) :
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeLateralPlaquette4 L)) =
        halfTraceRe
          (((U ⟨shift (cubeBottomBase L) 2, 0⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
            U ⟨cubeBottomBase L, 0⟩) * g) := by
    have h := halfTraceRe_plaquetteHolonomy_update_second hL U (cubeLateralPlaquette4 L) g
    simpa [cubeLateralPlaquette4, shift_cubeBottomBase_zero] using h
  have h_top (g : SU2) :
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeTopPlaquette L)) =
        halfTraceRe ((U ⟨shift 0 2, 1⟩ * (U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹) * g) :=
    halfTraceRe_plaquetteHolonomy_update_fourth hL U (cubeTopPlaquette L) g
  simp_rw [h_lat4, h_top]
  rw [integral_add_mul_halfTraceRe_mul_left_eq]
  congr 2
  group

theorem integral_topLink3_cubeLateral3_mul_step1 {L : ℕ} (hL : 2 ≤ L)
    (α₃ β₃ : ℝ) (U : GaugeConfig L) :
    (∫ g : SU2,
      (α₃ + β₃ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 2) 1 g) (cubeLateralPlaquette3 L))) *
        halfTraceRe
          (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 2, 1⟩ *
            (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 1, 2⟩)⁻¹ *
            (updateGaugeLink L U (shift 0 2) 1 g ⟨0, 1⟩)⁻¹ *
            (updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
            updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 2⟩ *
            updateGaugeLink L U (shift 0 2) 1 g ⟨shift (cubeBottomBase L) 2, 0⟩)
      ∂SU2.haarProbability) =
    (β₃ / 4) *
      halfTraceRe
        ((U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 0⟩)⁻¹ *
          U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 1⟩ *
          U ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩) := by
  have h_lat3 (g : SU2) :
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 2) 1 g) (cubeLateralPlaquette3 L)) =
        halfTraceRe
          (((U ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)⁻¹ *
            (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
            U ⟨shift (cubeBottomBase L) 2, 0⟩) * g) := by
    have h := halfTraceRe_plaquetteHolonomy_update_second hL U (cubeLateralPlaquette3 L) g
    simpa [cubeLateralPlaquette3, shift_shift_cubeBottomBase_two_zero,
      shift_comm (cubeBottomBase L) 2 1] using h
  have h_t1_ne : (0 : Lattice4D L) 2 ≠ shift (0 : Lattice4D L) 2 2 := by
    simpa [shift, unitVec] using (one_ne_zero_of_two_le hL).symm
  have h_rhs (g : SU2) :
      halfTraceRe
        (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 2, 1⟩ *
          (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 1, 2⟩)⁻¹ *
          (updateGaugeLink L U (shift 0 2) 1 g ⟨0, 1⟩)⁻¹ *
          (updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
          updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 2⟩ *
          updateGaugeLink L U (shift 0 2) 1 g ⟨shift (cubeBottomBase L) 2, 0⟩) =
      halfTraceRe
        (((U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 0⟩)⁻¹ *
          U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 0⟩) * g) := by
    rw [(updateGaugeLink_same_and_other L U (shift 0 2) 1 g).1,
        updateGaugeLink_apply_of_dir_ne U (shift 0 2) (shift 0 1) (by decide) g,
        updateGaugeLink_apply_of_coord_ne U (shift 0 2) 0 1 2 h_t1_ne g,
        updateGaugeLink_apply_of_dir_ne U (shift 0 2) (cubeBottomBase L) (by decide) g,
        updateGaugeLink_apply_of_dir_ne U (shift 0 2) (cubeBottomBase L) (by decide) g,
        updateGaugeLink_apply_of_dir_ne U (shift 0 2) (shift (cubeBottomBase L) 2) (by decide) g]
    have h_assoc :
        g * (U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 0⟩)⁻¹ *
          U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 0⟩ =
        g * ((U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 0⟩)⁻¹ *
          U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 0⟩) := by
      group
    rw [h_assoc, halfTraceRe_mul_comm g]
  simp_rw [h_lat3, h_rhs]
  rw [integral_add_mul_halfTraceRe_mul_left_eq]
  congr 2
  group

private theorem su2_inv_six_mul_eq (g t1 z00 b4 b3 z11 : SU2) :
    (g⁻¹ * t1⁻¹ * z00⁻¹ * b4 * b3 * z11)⁻¹ =
      (z11⁻¹ * b3⁻¹ * b4⁻¹ * z00 * t1) * g := by
  group

private theorem halfTraceRe_step2_cancel (z11 b3 b4 z00 t1 b2 z10 : SU2) :
    halfTraceRe
      ((z11⁻¹ * b3⁻¹ * b4⁻¹ * z00 * t1) * (z11⁻¹ * b2⁻¹ * z10)⁻¹) =
    halfTraceRe (t1 * z10⁻¹ * b2 * b3⁻¹ * b4⁻¹ * z00) := by
  have h1 :
      (z11⁻¹ * b3⁻¹ * b4⁻¹ * z00 * t1) * (z11⁻¹ * b2⁻¹ * z10)⁻¹ =
        z11⁻¹ * (b3⁻¹ * b4⁻¹ * z00 * t1 * z10⁻¹ * b2) * z11 := by
    group
  rw [h1, ← halfTraceRe_conj z11]
  have h2 :
      z11 * (z11⁻¹ * (b3⁻¹ * b4⁻¹ * z00 * t1 * z10⁻¹ * b2) * z11) * z11⁻¹ =
        (b3⁻¹ * b4⁻¹ * z00) * (t1 * z10⁻¹ * b2) := by
    group
  rw [h2, halfTraceRe_mul_comm (b3⁻¹ * b4⁻¹ * z00)]
  congr 1
  group

private theorem halfTraceRe_step3_cancel (z10 b2 b3 b4 z00 b1 : SU2) :
    halfTraceRe
      ((z10⁻¹ * b2 * b3⁻¹ * b4⁻¹ * z00) * (z10⁻¹ * b1⁻¹ * z00)⁻¹) =
    halfTraceRe (b1 * b2 * b3⁻¹ * b4⁻¹) := by
  have h1 :
      (z10⁻¹ * b2 * b3⁻¹ * b4⁻¹ * z00) * (z10⁻¹ * b1⁻¹ * z00)⁻¹ =
        z10⁻¹ * (b2 * b3⁻¹ * b4⁻¹ * b1) * z10 := by
    group
  rw [h1, ← halfTraceRe_conj z10]
  have h2 :
      z10 * (z10⁻¹ * (b2 * b3⁻¹ * b4⁻¹ * b1) * z10) * z10⁻¹ =
        (b2 * b3⁻¹ * b4⁻¹) * b1 := by
    group
  rw [h2, halfTraceRe_mul_comm _ b1]
  congr 1
  group

theorem integral_topLink2_cubeLateral2_mul_step2 {L : ℕ} (hL : 2 ≤ L)
    (α₂ β₂ : ℝ) (U : GaugeConfig L) :
    (∫ g : SU2,
      (α₂ + β₂ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 1) 2 g) (cubeLateralPlaquette2 L))) *
        halfTraceRe
          ((updateGaugeLink L U (shift 0 1) 2 g ⟨shift 0 1, 2⟩)⁻¹ *
            (updateGaugeLink L U (shift 0 1) 2 g ⟨0, 1⟩)⁻¹ *
            (updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
            updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 2⟩ *
            updateGaugeLink L U (shift 0 1) 2 g ⟨shift (cubeBottomBase L) 2, 1⟩ *
            updateGaugeLink L U (shift 0 1) 2 g ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)
      ∂SU2.haarProbability) =
    (β₂ / 4) *
      halfTraceRe
        (U ⟨0, 1⟩ * (U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * U ⟨shift (cubeBottomBase L) 1, 2⟩ *
          (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
          U ⟨cubeBottomBase L, 0⟩) := by
  have h_lat2 (g : SU2) :
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 1) 2 g) (cubeLateralPlaquette2 L)) =
        halfTraceRe
          (((U ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)⁻¹ *
            (U ⟨shift (cubeBottomBase L) 1, 2⟩)⁻¹ *
            U ⟨shift (cubeBottomBase L) 1, 0⟩) * g) := by
    have h := halfTraceRe_plaquetteHolonomy_update_second hL U (cubeLateralPlaquette2 L) g
    simpa [cubeLateralPlaquette2, shift_shift_cubeBottomBase_one_zero] using h
  have h_b4_ne : cubeBottomBase L 0 ≠ shift (0 : Lattice4D L) 1 0 := by
    simpa [shift, cubeBottomBase, unitVec] using neg_one_ne_zero_of_two_le hL
  have h_rhs (g : SU2) :
      halfTraceRe
        ((updateGaugeLink L U (shift 0 1) 2 g ⟨shift 0 1, 2⟩)⁻¹ *
          (updateGaugeLink L U (shift 0 1) 2 g ⟨0, 1⟩)⁻¹ *
          (updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
          updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 2⟩ *
          updateGaugeLink L U (shift 0 1) 2 g ⟨shift (cubeBottomBase L) 2, 1⟩ *
          updateGaugeLink L U (shift 0 1) 2 g ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩) =
      halfTraceRe
        (((U ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)⁻¹ *
          (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
          U ⟨cubeBottomBase L, 0⟩ * U ⟨0, 1⟩) * g) := by
    rw [(updateGaugeLink_same_and_other L U (shift 0 1) 2 g).1,
        updateGaugeLink_apply_of_dir_ne U (shift 0 1) 0 (by decide) g,
        updateGaugeLink_apply_of_dir_ne U (shift 0 1) (cubeBottomBase L) (by decide) g,
        updateGaugeLink_apply_of_coord_ne U (shift 0 1) (cubeBottomBase L) 2 0 h_b4_ne g,
        updateGaugeLink_apply_of_dir_ne U (shift 0 1) (shift (cubeBottomBase L) 2) (by decide) g,
        updateGaugeLink_apply_of_dir_ne U (shift 0 1) (shift (shift (cubeBottomBase L) 1) 2) (by decide) g,
        ← halfTraceRe_inv, su2_inv_six_mul_eq]
  simp_rw [h_lat2, h_rhs]
  rw [integral_add_mul_halfTraceRe_mul_left_eq]
  exact congrArg ((β₂ / 4) * ·) (halfTraceRe_step2_cancel _ _ _ _ _ _ _)

theorem integral_topLink1_cubeLateral1_mul_step3 {L : ℕ} (hL : 2 ≤ L)
    (α₁ β₁ : ℝ) (U : GaugeConfig L) :
    (∫ g : SU2,
      (α₁ + β₁ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 1 g) (cubeLateralPlaquette1 L))) *
        halfTraceRe
          (updateGaugeLink L U 0 1 g ⟨0, 1⟩ *
            (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ *
            updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 2⟩ *
            (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
            (updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 2⟩)⁻¹ *
            updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 0⟩)
      ∂SU2.haarProbability) =
    (β₁ / 4) * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
  have h_lat1 (g : SU2) :
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 1 g) (cubeLateralPlaquette1 L)) =
        halfTraceRe
          (((U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * (U ⟨cubeBottomBase L, 1⟩)⁻¹ *
            U ⟨cubeBottomBase L, 0⟩) * g) := by
    have h := halfTraceRe_plaquetteHolonomy_update_second hL U (cubeLateralPlaquette1 L) g
    simpa [cubeLateralPlaquette1, shift_cubeBottomBase_zero] using h
  have h_b3_ne : shift (cubeBottomBase L) 2 0 ≠ (0 : Lattice4D L) 0 := by
    simpa [shift, cubeBottomBase, unitVec] using neg_one_ne_zero_of_two_le hL
  have h_rhs (g : SU2) :
      halfTraceRe
        (updateGaugeLink L U 0 1 g ⟨0, 1⟩ *
          (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ *
          updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 2⟩ *
          (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
          (updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 2⟩)⁻¹ *
          updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 0⟩) =
      halfTraceRe
        (((U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * U ⟨shift (cubeBottomBase L) 1, 2⟩ *
          (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
          U ⟨cubeBottomBase L, 0⟩) * g) := by
    rw [(updateGaugeLink_same_and_other L U 0 1 g).1,
        updateGaugeLink_apply_of_dir_ne U 0 (shift (cubeBottomBase L) 1) (by decide) g,
        updateGaugeLink_apply_of_dir_ne U 0 (shift (cubeBottomBase L) 1) (by decide) g,
        updateGaugeLink_apply_of_coord_ne U 0 (shift (cubeBottomBase L) 2) 1 0 h_b3_ne g,
        updateGaugeLink_apply_of_dir_ne U 0 (cubeBottomBase L) (by decide) g,
        updateGaugeLink_apply_of_dir_ne U 0 (cubeBottomBase L) (by decide) g]
    have h_assoc :
        g * (U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * U ⟨shift (cubeBottomBase L) 1, 2⟩ *
          (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
          U ⟨cubeBottomBase L, 0⟩ =
        g * ((U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * U ⟨shift (cubeBottomBase L) 1, 2⟩ *
          (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
          U ⟨cubeBottomBase L, 0⟩) := by
      group
    rw [h_assoc, halfTraceRe_mul_comm g]
  simp_rw [h_lat1, h_rhs]
  rw [integral_add_mul_halfTraceRe_mul_left_eq]
  unfold plaquetteHolonomy cubeBottomPlaquette
  dsimp only
  exact congrArg ((β₁ / 4) * ·) (halfTraceRe_step3_cancel _ _ _ _ _ _)

theorem integral_bottomLink1_cubeBottom_sq {L : ℕ} (hL : 2 ≤ L) (U : GaugeConfig L) :
    (∫ g : SU2,
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (cubeBottomBase L) 1 g) (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (cubeBottomBase L) 1 g) (cubeBottomPlaquette L))
      ∂SU2.haarProbability) = 1 / 4 := by
  have h_bot (g : SU2) :
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (cubeBottomBase L) 1 g) (cubeBottomPlaquette L)) =
        halfTraceRe
          ((U ⟨shift (cubeBottomBase L) 1, 2⟩ * (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
            (U ⟨cubeBottomBase L, 2⟩)⁻¹) * g) :=
    halfTraceRe_plaquetteHolonomy_update_first hL U (cubeBottomPlaquette L) g
  have h_eq (g : SU2) :
      halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (cubeBottomBase L) 1 g) (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (cubeBottomBase L) 1 g) (cubeBottomPlaquette L)) =
      (0 + 1 * halfTraceRe
        ((U ⟨shift (cubeBottomBase L) 1, 2⟩ * (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
          (U ⟨cubeBottomBase L, 2⟩)⁻¹) * g)) *
        halfTraceRe
          ((U ⟨shift (cubeBottomBase L) 1, 2⟩ * (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
            (U ⟨cubeBottomBase L, 2⟩)⁻¹) * g) := by
    rw [h_bot, zero_add, one_mul]
  simp_rw [h_eq]
  rw [integral_add_mul_halfTraceRe_mul_left_eq, mul_inv_cancel]
  have h1 : halfTraceRe 1 = 1 := su2CompactGaugeClassTrace.h_one
  rw [h1, mul_one]

/-- Master full-torus 6-face unit 3-cube Haar reduction on `gaugeHaarMeasure L`:
for every torus side `L ≥ 2` and arbitrary real coefficients `α₁, α₂, α₃, α₄, β₁, β₂, β₃, β₄ : ℝ`,
the full-torus `gaugeHaarMeasure L` integral of the bottom and top probe holonomies against the
4 lateral temporal plaquette factors `∏_{i=1}^4 (α_i + β_i * halfTraceRe (U_{p_i}))` reduces via five
measure-preserving single-link Haar integrations (`⟨0, 2⟩`, `⟨shift 0 2, 1⟩`, `⟨shift 0 1, 2⟩`,
`⟨0, 1⟩`, `⟨cubeBottomBase L, 1⟩`) to `cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄)`. -/
theorem integral_gaugeHaarMeasure_cubeSixFace_general_eq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (α₁ α₂ α₃ α₄ β₁ β₂ β₃ β₄ : ℝ) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
        (α₄ + β₄ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L))) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
      ∂(gaugeHaarMeasure L)) =
    cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄) := by
  let F₄ : GaugeConfig L → ℝ := fun U =>
    halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
      (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
      (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
      (α₄ + β₄ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L))) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
  let F₃ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
        halfTraceRe
          (U ⟨shift 0 2, 1⟩ * (U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ *
            (U ⟨cubeBottomBase L, 0⟩)⁻¹ * U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 0⟩))
  let F₂ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) * (β₃ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        halfTraceRe
          ((U ⟨shift 0 1, 2⟩)⁻¹ * (U ⟨0, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 0⟩)⁻¹ *
            U ⟨cubeBottomBase L, 2⟩ * U ⟨shift (cubeBottomBase L) 2, 1⟩ *
            U ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩))
  let F₁ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) * (β₃ / 4) * (β₂ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        halfTraceRe
          (U ⟨0, 1⟩ * (U ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ * U ⟨shift (cubeBottomBase L) 1, 2⟩ *
            (U ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ * (U ⟨cubeBottomBase L, 2⟩)⁻¹ *
            U ⟨cubeBottomBase L, 0⟩))
  let F₀ : GaugeConfig L → ℝ := fun U =>
    (β₄ / 4) * (β₃ / 4) * (β₂ / 4) * (β₁ / 4) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
  have hF₄_cont : Continuous F₄ := by dsimp [F₄]; fun_prop
  have hF₃_cont : Continuous F₃ := by dsimp [F₃]; fun_prop
  have hF₂_cont : Continuous F₂ := by dsimp [F₂]; fun_prop
  have hF₁_cont : Continuous F₁ := by dsimp [F₁]; fun_prop
  have hF₀_cont : Continuous F₀ := by dsimp [F₀]; fun_prop
  have h_step4 : (∫ U, F₄ U ∂(gaugeHaarMeasure L)) = ∫ U, F₃ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨0, 2⟩ F₄ hF₄_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have h_eq (g : SU2) :
        F₄ (updateGaugeLink L U 0 2 g) =
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
            (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
            (α₃ + β₃ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L)))) *
          ((α₄ + β₄ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeLateralPlaquette4 L))) *
            halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 2 g) (cubeTopPlaquette L))) := by
      dsimp [F₄]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U 0 rfl 2 g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette1 L) rfl rfl 0 g,
          plaquetteHolonomy_cubeLateralPlaquette2_update_topLink4 hL U g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette3 L) rfl rfl 0 g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink4_cubeLateral4_mul_cubeTop hL α₄ β₄ U]
    dsimp [F₃]
    ring
  have h_step3 : (∫ U, F₃ U ∂(gaugeHaarMeasure L)) = ∫ U, F₂ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨shift 0 2, 1⟩ F₃ hF₃_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have h_eq (g : SU2) :
        F₃ (updateGaugeLink L U (shift 0 2) 1 g) =
          ((β₄ / 4) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
              (α₂ + β₂ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))))) *
          ((α₃ + β₃ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 2) 1 g) (cubeLateralPlaquette3 L))) *
            halfTraceRe
              (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 2, 1⟩ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨shift 0 1, 2⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨0, 1⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
                updateGaugeLink L U (shift 0 2) 1 g ⟨cubeBottomBase L, 2⟩ *
                updateGaugeLink L U (shift 0 2) 1 g ⟨shift (cubeBottomBase L) 2, 0⟩)) := by
      dsimp [F₃]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U (shift 0 2) (by simp [shift, unitVec]) 1 g,
          plaquetteHolonomy_cubeLateralPlaquette1_update_topLink3 hL U g,
          plaquetteHolonomy_of_plane02_update_dir1 U (cubeLateralPlaquette2 L) rfl rfl (shift 0 2) g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink3_cubeLateral3_mul_step1 hL α₃ β₃ U]
    dsimp [F₂]
    ring
  have h_step2 : (∫ U, F₂ U ∂(gaugeHaarMeasure L)) = ∫ U, F₁ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨shift 0 1, 2⟩ F₂ hF₂_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have h_eq (g : SU2) :
        F₂ (updateGaugeLink L U (shift 0 1) 2 g) =
          ((β₄ / 4) * (β₃ / 4) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              (α₁ + β₁ * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))))) *
          ((α₂ + β₂ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift 0 1) 2 g) (cubeLateralPlaquette2 L))) *
            halfTraceRe
              ((updateGaugeLink L U (shift 0 1) 2 g ⟨shift 0 1, 2⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 1) 2 g ⟨0, 1⟩)⁻¹ *
                (updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 0⟩)⁻¹ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨cubeBottomBase L, 2⟩ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨shift (cubeBottomBase L) 2, 1⟩ *
                updateGaugeLink L U (shift 0 1) 2 g ⟨shift (shift (cubeBottomBase L) 1) 2, 0⟩)) := by
      dsimp [F₂]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U (shift 0 1) (by simp [shift, unitVec]) 2 g,
          plaquetteHolonomy_of_plane01_update_dir2 U (cubeLateralPlaquette1 L) rfl rfl (shift 0 1) g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink2_cubeLateral2_mul_step2 hL α₂ β₂ U]
    dsimp [F₁]
    ring
  have h_step1 : (∫ U, F₁ U ∂(gaugeHaarMeasure L)) = ∫ U, F₀ U ∂(gaugeHaarMeasure L) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨0, 1⟩ F₁ hF₁_cont]
    refine integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
    have h_eq (g : SU2) :
        F₁ (updateGaugeLink L U 0 1 g) =
          ((β₄ / 4) * (β₃ / 4) * (β₂ / 4) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
          ((α₁ + β₁ * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U 0 1 g) (cubeLateralPlaquette1 L))) *
            halfTraceRe
              (updateGaugeLink L U 0 1 g ⟨0, 1⟩ *
                (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 0⟩)⁻¹ *
                updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 1, 2⟩ *
                (updateGaugeLink L U 0 1 g ⟨shift (cubeBottomBase L) 2, 1⟩)⁻¹ *
                (updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 2⟩)⁻¹ *
                updateGaugeLink L U 0 1 g ⟨cubeBottomBase L, 0⟩)) := by
      dsimp [F₁]
      rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero hL U 0 rfl 1 g]
      ring
    simp_rw [h_eq, integral_const_mul, integral_topLink1_cubeLateral1_mul_step3 hL α₁ β₁ U]
    dsimp [F₀]
    ring
  have h_step0 :
      (∫ U, F₀ U ∂(gaugeHaarMeasure L)) = cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄) := by
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨cubeBottomBase L, 1⟩ F₀ hF₀_cont]
    have h_inner (U : GaugeConfig L) :
        (∫ g : SU2, F₀ (updateGaugeLink L U (cubeBottomBase L) 1 g) ∂SU2.haarProbability) =
          cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄) := by
      dsimp [F₀]
      rw [integral_const_mul, integral_bottomLink1_cubeBottom_sq hL U,
          cubeSixFaceHaarIntegral_eq_one_fourth_pow_five]
      ring
    simp_rw [h_inner, integral_const, probReal_univ, one_smul]
  change (∫ U, F₄ U ∂(gaugeHaarMeasure L)) = cubeSixFaceHaarIntegral * (β₁ * β₂ * β₃ * β₄)
  rw [h_step4, h_step3, h_step2, h_step1, h_step0]

/-- Full-torus 6-face character product evaluation on `gaugeHaarMeasure L` (`L ≥ 2`):
the product of the 6 unit-cube plaquette characters integrates on `gaugeHaarMeasure L` to
`cubeSixFaceHaarIntegral = (1 / 4) ^ 5 = 1 / 1024`. -/
theorem integral_gaugeHaarMeasure_cubeSixFace_eq_cubeSixFaceHaarIntegral
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L)) *
        halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L)) *
        halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L)) *
        halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
      ∂(gaugeHaarMeasure L)) =
    cubeSixFaceHaarIntegral := by
  have h := integral_gaugeHaarMeasure_cubeSixFace_general_eq hL 0 0 0 0 1 1 1 1
  simpa using h

/-- Linearized Boltzmann weight on the 4 lateral temporal plaquettes of the canonical unit 3-cube
in `GaugeConfig L`. -/
noncomputable def cubeLateralLinearizedBoltzmann {L : ℕ} (β : ℝ) (U : GaugeConfig L) : ℝ :=
  (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
    (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
    (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
    (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L)))

/-- Full-torus linearized-Boltzmann unit 3-cube evaluation on `gaugeHaarMeasure L` (`L ≥ 2`):
integrating the canonical spatial probe and its time reflection against `cubeLateralLinearizedBoltzmann β`
over the full torus `GaugeConfig L` yields `cubeSixFaceHaarIntegral * β ^ 4 = (1 / 4) ^ 5 * β ^ 4`. -/
theorem integral_gaugeHaarMeasure_cubeLinearizedBoltzmann_eq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    (∫ U : GaugeConfig L,
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U *
        cubeLateralLinearizedBoltzmann β U *
        physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U
      ∂(gaugeHaarMeasure L)) =
    cubeSixFaceHaarIntegral * β ^ 4 := by
  have h_pt (U : GaugeConfig L) :
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U *
        cubeLateralLinearizedBoltzmann β U *
        physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U =
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L))) *
        (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L))) *
        (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L))) *
        (1 + β * halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L))) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
    rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
        physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    unfold cubeLateralLinearizedBoltzmann
    ring
  simp_rw [h_pt]
  rw [integral_gaugeHaarMeasure_cubeSixFace_general_eq hL 1 1 1 1 β β β β]
  ring

/-- Vacuum-subtracted character Boltzmann weight
`exp (β * ∑_{p : Plaquette L} halfTraceRe (plaquetteHolonomy U p))` on `GaugeConfig L`, factoring out
the constant torus volume prefactor `exp (-β * card (Plaquette L))` from `boltzmannWeight β U`. -/
noncomputable def characterBoltzmannWeight {L : ℕ} [NeZero L] (β : ℝ) (U : GaugeConfig L) : ℝ :=
  Real.exp (β * ∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p))

/-- Vacuum-subtracted character partition function
`∫ U, characterBoltzmannWeight β U ∂(gaugeHaarMeasure L)` on `GaugeConfig L`. -/
noncomputable def characterPartition (L : ℕ) [NeZero L] (β : ℝ) : ℝ :=
  ∫ U : GaugeConfig L, characterBoltzmannWeight β U ∂(gaugeHaarMeasure L)

@[continuity, fun_prop]
theorem continuous_characterBoltzmannWeight {L : ℕ} [NeZero L] (β : ℝ) :
    Continuous (characterBoltzmannWeight (L := L) β) := by
  unfold characterBoltzmannWeight
  fun_prop

theorem boltzmannWeight_eq_exp_neg_card_mul_characterBoltzmannWeight
    {L : ℕ} [NeZero L] (β : ℝ) (U : GaugeConfig L) :
    boltzmannWeight β U =
      Real.exp (-(β * (Fintype.card (Plaquette L) : ℝ))) * characterBoltzmannWeight β U := by
  unfold boltzmannWeight characterBoltzmannWeight wilsonAction plaquetteAction halfTraceRe
  rw [← Real.exp_add]
  congr 1
  rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
  ring

theorem wilsonPartition_eq_exp_neg_card_mul_characterPartition
    (L : ℕ) [NeZero L] (β : ℝ) :
    wilsonPartition (gaugeHaarMeasure L) β =
      Real.exp (-(β * (Fintype.card (Plaquette L) : ℝ))) * characterPartition L β := by
  unfold wilsonPartition characterPartition
  simp_rw [boltzmannWeight_eq_exp_neg_card_mul_characterBoltzmannWeight, integral_const_mul]

/-- Uniform-in-volume lower bound `1 ≤ characterPartition L β` for every `L ≥ 2` and `β : ℝ`:
by `1 + x ≤ exp x` (`Real.add_one_le_exp`) and `integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero`,
the linear term `β * ∑_p halfTraceRe (U_p)` integrates to `0` on `gaugeHaarMeasure L`. -/
theorem one_le_characterPartition {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    1 ≤ characterPartition L β := by
  have h_lin_int :
      Integrable (fun U : GaugeConfig L =>
        1 + β * ∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p)) (gaugeHaarMeasure L) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_exp_int :
      Integrable (characterBoltzmannWeight (L := L) β) (gaugeHaarMeasure L) :=
    (continuous_characterBoltzmannWeight β).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_mono :
      (∫ U : GaugeConfig L,
        (1 + β * ∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p)) ∂(gaugeHaarMeasure L)) ≤
      characterPartition L β :=
    integral_mono h_lin_int h_exp_int (fun U => by
      have h := Real.add_one_le_exp (β * ∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p))
      unfold characterBoltzmannWeight
      linarith)
  have h_sum_zero :
      (∫ U : GaugeConfig L,
        (∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p)) ∂(gaugeHaarMeasure L)) = 0 := by
    rw [integral_finsetSum Finset.univ
      (f := fun (p : Plaquette L) (U : GaugeConfig L) => halfTraceRe (plaquetteHolonomy U p))
      (fun p _ =>
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p)).integrable_of_hasCompactSupport
          (HasCompactSupport.of_compactSpace _))]
    simp [integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL]
  have h_lhs :
      (∫ U : GaugeConfig L,
        (1 + β * ∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p)) ∂(gaugeHaarMeasure L)) = 1 := by
    have h_int_sum :
        Integrable (fun U : GaugeConfig L =>
          β * ∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p)) (gaugeHaarMeasure L) := by
      refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
      fun_prop
    rw [integral_add (integrable_const 1) h_int_sum, integral_const, probReal_univ, one_smul,
        integral_const_mul, h_sum_zero, mul_zero, add_zero]
  linarith

theorem characterPartition_pos {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    0 < characterPartition L β :=
  lt_of_lt_of_le zero_lt_one (one_le_characterPartition hL β)

/-- Volume-uniform bound on the partition-function normalization ratio (`L ≥ 2`):
because `1 ≤ characterPartition L β`, the ratio `(1 - characterPartition L β) / characterPartition L β`
satisfies `|(1 - Z_char) / Z_char| = 1 - 1 / Z_char ≤ 1` uniformly in `L`. This uniform bound `≤ 1`
only bounds `|(1 - Z_char) / Z_char| * (4⁻⁵ * β⁴)` by `4⁻⁵ * β⁴`, which exceeds R1's quarter-sized
allowance `(1 / 4) * 4⁻⁵ * β⁴`; closing R1 requires sufficiently small uniform control via
cancellation against the numerator rather than this standalone `≤ 1` bound. -/
theorem abs_one_sub_characterPartition_div_le_one
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    |(1 - characterPartition L β) / characterPartition L β| =
      1 - 1 / characterPartition L β ∧
    |(1 - characterPartition L β) / characterPartition L β| ≤ 1 := by
  have hZ1 : 1 ≤ characterPartition L β := one_le_characterPartition hL β
  have hZ_pos : 0 < characterPartition L β := characterPartition_pos hL β
  have h_div_le : (1 - characterPartition L β) / characterPartition L β ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (by linarith) hZ_pos.le
  have h_eq :
      |(1 - characterPartition L β) / characterPartition L β| =
        1 - 1 / characterPartition L β := by
    rw [abs_of_nonpos h_div_le, sub_div, div_self hZ_pos.ne']
    ring
  have h_inv_nonneg : 0 ≤ 1 / characterPartition L β := div_nonneg zero_le_one hZ_pos.le
  exact ⟨h_eq, by linarith⟩

/-- Exact cancellation of the extensive vacuum prefactor `exp (-β * card (Plaquette L))` in
`wilsonExpectation (gaugeHaarMeasure L) β F`. -/
theorem wilsonExpectation_eq_characterBoltzmannWeight_div_characterPartition
    {L : ℕ} [NeZero L] (β : ℝ) (F : GaugeConfig L → ℝ) :
    wilsonExpectation (gaugeHaarMeasure L) β F =
      (∫ U : GaugeConfig L, characterBoltzmannWeight β U * F U ∂(gaugeHaarMeasure L)) /
        characterPartition L β := by
  unfold wilsonExpectation
  rw [wilsonPartition_eq_exp_neg_card_mul_characterPartition]
  have h_num :
      (fun U : GaugeConfig L => boltzmannWeight β U * F U) =
        fun U : GaugeConfig L =>
          Real.exp (-(β * (Fintype.card (Plaquette L) : ℝ))) * (characterBoltzmannWeight β U * F U) := by
    funext U
    rw [boltzmannWeight_eq_exp_neg_card_mul_characterBoltzmannWeight, mul_assoc]
  rw [h_num, integral_const_mul, mul_div_mul_left _ _ (Real.exp_pos _).ne']

/-- Algebraic remainder term `wilsonProbeCov L β - cubeSixFaceHaarIntegral * β ^ 4` in the
decomposition of `wilsonProbeCov L β`, expressed via:
1. the unnormalized character-Boltzmann vs. 4-face linearized-cube integral difference,
2. the partition-function normalization correction `(1 - characterPartition L β) * cubeSixFaceHaarIntegral * β ^ 4`,
   all divided by `characterPartition L β`, minus
3. the disconnected single-probe product expectation under `wilsonMeasure (gaugeHaarMeasure L) β`.
Note: without an estimate showing `wilsonProbeClusterRemainderDecomp L β` is smaller than
`cubeSixFaceHaarIntegral * β ^ 4`, this defines the remainder in an exact algebraic decomposition
rather than establishing an asymptotic expansion. -/
noncomputable def wilsonProbeClusterRemainderDecomp (L : ℕ) [NeZero L] (β : ℝ) : ℝ :=
  let fΘ : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  let fp : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  ((∫ U : GaugeConfig L,
      (characterBoltzmannWeight β U - cubeLateralLinearizedBoltzmann β U) * (fΘ U * fp U)
      ∂(gaugeHaarMeasure L)) +
    (1 - characterPartition L β) * (cubeSixFaceHaarIntegral * β ^ 4)) /
      characterPartition L β -
    wilsonExpectation (gaugeHaarMeasure L) β fΘ *
      wilsonExpectation (gaugeHaarMeasure L) β fp

/-- Exact algebraic decomposition of `wilsonProbeCov L β` (`L ≥ 2`, `β ≥ 0`) isolating the
linearized 3-cube Haar integral (`integral_gaugeHaarMeasure_cubeLinearizedBoltzmann_eq`) inside the
normalized connected covariance `wilsonProbeCov L β`.
This is an exact decomposition (`wilsonProbeCov L β = cubeSixFaceHaarIntegral * β ^ 4 + wilsonProbeClusterRemainderDecomp L β`),
not by itself an asymptotic expansion or a proof that `cubeSixFaceHaarIntegral * β ^ 4` is the full
leading coefficient of `wilsonProbeCov L β` (cancellation of lower-degree terms and exclusion of
additional degree-four contributions inside `wilsonProbeClusterRemainderDecomp L β` remain open). -/
theorem wilsonProbeCov_eq_cubeSixFaceHaarIntegral_add_decomp
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ : 0 ≤ β) :
    wilsonProbeCov L β =
      cubeSixFaceHaarIntegral * β ^ 4 + wilsonProbeClusterRemainderDecomp L β ∧
    wilsonProbeClusterRemainderDecomp L β =
      wilsonProbeCov L β - cubeSixFaceHaarIntegral * β ^ 4 := by
  let fΘ : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  let fp : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  have hS : Measurable (wilsonAction β : GaugeConfig L → ℝ) := measurable_wilsonAction β
  have hZ : (characterPartition L β) ≠ 0 := (characterPartition_pos hL β).ne'
  have h_cov :
      wilsonProbeCov L β =
        (∫ U : GaugeConfig L, characterBoltzmannWeight β U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) /
          characterPartition L β -
        wilsonExpectation (gaugeHaarMeasure L) β fΘ *
          wilsonExpectation (gaugeHaarMeasure L) β fp := by
    unfold wilsonProbeCov irCov
    rw [integral_wilsonMeasure (gaugeHaarMeasure L) hβ hS (fun U => fΘ U * fp U),
        integral_wilsonMeasure (gaugeHaarMeasure L) hβ hS fΘ,
        integral_wilsonMeasure (gaugeHaarMeasure L) hβ hS fp,
        wilsonExpectation_eq_characterBoltzmannWeight_div_characterPartition β (fun U => fΘ U * fp U)]
  have hfΘ_cont : Continuous fΘ :=
    continuous_physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  have hfp_cont : Continuous fp :=
    continuous_physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  have h_int_char :
      Integrable (fun U : GaugeConfig L => characterBoltzmannWeight β U * (fΘ U * fp U))
        (gaugeHaarMeasure L) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    exact (continuous_characterBoltzmannWeight β).mul (hfΘ_cont.mul hfp_cont)
  have h_int_lin :
      Integrable (fun U : GaugeConfig L => cubeLateralLinearizedBoltzmann β U * (fΘ U * fp U))
        (gaugeHaarMeasure L) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    have h_lin_cont : Continuous (cubeLateralLinearizedBoltzmann (L := L) β) := by
      unfold cubeLateralLinearizedBoltzmann
      fun_prop
    exact h_lin_cont.mul (hfΘ_cont.mul hfp_cont)
  have h_lin_eq :
      (∫ U : GaugeConfig L, cubeLateralLinearizedBoltzmann β U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) =
        cubeSixFaceHaarIntegral * β ^ 4 := by
    have h_comm :
        (fun U : GaugeConfig L => cubeLateralLinearizedBoltzmann β U * (fΘ U * fp U)) =
          fun U : GaugeConfig L => fΘ U * cubeLateralLinearizedBoltzmann β U * fp U := by
      funext U; ring
    rw [h_comm]
    exact integral_gaugeHaarMeasure_cubeLinearizedBoltzmann_eq hL β
  have h_sub :
      (∫ U : GaugeConfig L,
        (characterBoltzmannWeight β U - cubeLateralLinearizedBoltzmann β U) * (fΘ U * fp U)
        ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, characterBoltzmannWeight β U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) -
        cubeSixFaceHaarIntegral * β ^ 4 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          (characterBoltzmannWeight β U - cubeLateralLinearizedBoltzmann β U) * (fΘ U * fp U)) =
        fun U : GaugeConfig L =>
          characterBoltzmannWeight β U * (fΘ U * fp U) -
            cubeLateralLinearizedBoltzmann β U * (fΘ U * fp U) := by
      funext U; ring
    rw [h_pt, integral_sub h_int_char h_int_lin, h_lin_eq]
  have h_main :
      wilsonProbeCov L β =
        cubeSixFaceHaarIntegral * β ^ 4 + wilsonProbeClusterRemainderDecomp L β := by
    unfold wilsonProbeClusterRemainderDecomp
    dsimp only
    rw [h_cov, h_sub]
    field_simp [hZ]
    ring
  exact ⟨h_main, by linarith⟩

/-- Single-plaquette self-linearized Boltzmann integral on `gaugeHaarMeasure L` (`L ≥ 2`):
for every plaquette `p : Plaquette L`, integrating the specified linearized integrand
`(1 + β * halfTraceRe (U_p)) * halfTraceRe (U_p)` against `gaugeHaarMeasure L` evaluates to `β / 4`. -/
theorem integral_gaugeHaarMeasure_singlePlaquette_linearizedBoltzmann_eq_beta_div_four
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) (p : Plaquette L) :
    (∫ U : GaugeConfig L,
      (1 + β * halfTraceRe (plaquetteHolonomy U p)) * halfTraceRe (plaquetteHolonomy U p)
      ∂(gaugeHaarMeasure L)) = β / 4 := by
  have h_cont :
      Continuous (fun U : GaugeConfig L =>
        (1 + β * halfTraceRe (plaquetteHolonomy U p)) * halfTraceRe (plaquetteHolonomy U p)) := by
    fun_prop
  rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨p.x, p.μ⟩ _ h_cont]
  have h_inner (U : GaugeConfig L) :
      (∫ g : SU2,
        (1 + β * halfTraceRe (plaquetteHolonomy (updateGaugeLink L U p.x p.μ g) p)) *
          halfTraceRe (plaquetteHolonomy (updateGaugeLink L U p.x p.μ g) p)
        ∂SU2.haarProbability) = β / 4 := by
    simp_rw [halfTraceRe_plaquetteHolonomy_update_first hL U p]
    rw [integral_add_mul_halfTraceRe_mul_left_eq, mul_inv_cancel]
    have h1 : halfTraceRe 1 = 1 := su2CompactGaugeClassTrace.h_one
    rw [h1, mul_one]
  simp_rw [h_inner, integral_const, probReal_univ, one_smul]

/-- Two-probe self-linearized Boltzmann integral on `gaugeHaarMeasure L` (`L ≥ 2`):
integrating the specified linearized integrand `(1 + β * fΘ U) * (1 + β * fp U) * (fΘ U * fp U)`
over `gaugeHaarMeasure L` evaluates to `(β / 4) ^ 2 = β ^ 2 / 16` (and at `β = 0`,
`∫ fΘ * fp ∂(gaugeHaarMeasure L) = 0`). Note that this evaluates the specified two-plaquette
linearized integrand and does not by itself establish the Taylor expansion of the full exponential
Gibbs numerator or disconnected product. -/
theorem integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_eq_beta_sq_div_sixteen
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    (∫ U : GaugeConfig L,
      (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) *
        (physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U *
          physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U)
      ∂(gaugeHaarMeasure L)) = β ^ 2 / 16 := by
  let H : GaugeConfig L → ℝ := fun U =>
    ((1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
    ((1 + β * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  have h_pt (U : GaugeConfig L) :
      (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) *
        (physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U *
          physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) = H U := by
    dsimp [H]
    rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
        physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    ring
  simp_rw [h_pt]
  have hH_cont : Continuous H := by dsimp [H]; fun_prop
  rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
    ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ H hH_cont]
  have h_top_step (U : GaugeConfig L) :
      (∫ g : SU2,
        H (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
        ∂SU2.haarProbability) =
        ((1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) * (β / 4) := by
    dsimp [H]
    simp_rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero
        hL U (cubeTopPlaquette L).x rfl (cubeTopPlaquette L).μ,
      halfTraceRe_plaquetteHolonomy_update_first hL U (cubeTopPlaquette L),
      integral_const_mul]
    rw [integral_add_mul_halfTraceRe_mul_left_eq, mul_inv_cancel]
    have h1 : halfTraceRe 1 = 1 := su2CompactGaugeClassTrace.h_one
    rw [h1, mul_one]
  simp_rw [h_top_step, integral_mul_const,
    integral_gaugeHaarMeasure_singlePlaquette_linearizedBoltzmann_eq_beta_div_four hL β (cubeBottomPlaquette L)]
  ring

/-- Normalization integral of the two-probe self-linearized weight
`(1 + β * fΘ U) * (1 + β * fp U)` on `gaugeHaarMeasure L` (`L ≥ 2`): evaluates to `1`. -/
theorem integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_eq_one
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    (∫ U : GaugeConfig L,
      (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U)
      ∂(gaugeHaarMeasure L)) = 1 := by
  let H : GaugeConfig L → ℝ := fun U =>
    (1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
      (1 + β * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  have h_pt (U : GaugeConfig L) :
      (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) = H U := by
    dsimp [H]
    rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
        physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
  simp_rw [h_pt]
  have hH_cont : Continuous H := by dsimp [H]; fun_prop
  rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
    ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ H hH_cont]
  have h_top_step (U : GaugeConfig L) :
      (∫ g : SU2,
        H (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
        ∂SU2.haarProbability) =
        1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
    dsimp [H]
    simp_rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero
        hL U (cubeTopPlaquette L).x rfl (cubeTopPlaquette L).μ,
      halfTraceRe_plaquetteHolonomy_update_first hL U (cubeTopPlaquette L),
      integral_const_mul]
    have h_int_lin :
        Integrable (fun g : SU2 =>
          β * halfTraceRe
            (U ⟨shift (cubeTopPlaquette L).x (cubeTopPlaquette L).μ, (cubeTopPlaquette L).ν⟩ *
              (U ⟨shift (cubeTopPlaquette L).x (cubeTopPlaquette L).ν, (cubeTopPlaquette L).μ⟩)⁻¹ *
              (U ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).ν⟩)⁻¹ * g))
          SU2.haarProbability := by
      refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
      fun_prop
    rw [integral_add (integrable_const 1) h_int_lin, integral_const, probReal_univ, one_smul,
        integral_const_mul, integral_halfTraceRe_mul_left_eq_zero, mul_zero, add_zero, mul_one]
  simp_rw [h_top_step]
  have h_bot_int :
      Integrable (fun U : GaugeConfig L =>
        β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
        (gaugeHaarMeasure L) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  rw [integral_add (integrable_const 1) h_bot_int, integral_const, probReal_univ, one_smul,
      integral_const_mul, integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL (cubeBottomPlaquette L),
      mul_zero, add_zero]

/-- Single-probe (`fΘ` and `fp`) expectations under the two-probe self-linearized weight
`(1 + β * fΘ U) * (1 + β * fp U)` on `gaugeHaarMeasure L` (`L ≥ 2`): each evaluates to `β / 4`. -/
theorem integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_single_probes_eq_beta_div_four
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    (∫ U : GaugeConfig L,
      (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) *
        physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U
      ∂(gaugeHaarMeasure L)) = β / 4 ∧
    (∫ U : GaugeConfig L,
      (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) *
        physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U
      ∂(gaugeHaarMeasure L)) = β / 4 := by
  constructor
  · let H₁ : GaugeConfig L → ℝ := fun U =>
      ((1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
      (1 + β * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
    have h_pt₁ (U : GaugeConfig L) :
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
          (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) *
          physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U = H₁ U := by
      dsimp [H₁]
      rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
      ring
    simp_rw [h_pt₁]
    have hH₁_cont : Continuous H₁ := by dsimp [H₁]; fun_prop
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
      ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ H₁ hH₁_cont]
    have h_top_step₁ (U : GaugeConfig L) :
        (∫ g : SU2,
          H₁ (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
          ∂SU2.haarProbability) =
          (1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      dsimp [H₁]
      simp_rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero
          hL U (cubeTopPlaquette L).x rfl (cubeTopPlaquette L).μ,
        halfTraceRe_plaquetteHolonomy_update_first hL U (cubeTopPlaquette L),
        integral_const_mul]
      have h_int_lin :
          Integrable (fun g : SU2 =>
            β * halfTraceRe
              (U ⟨shift (cubeTopPlaquette L).x (cubeTopPlaquette L).μ, (cubeTopPlaquette L).ν⟩ *
                (U ⟨shift (cubeTopPlaquette L).x (cubeTopPlaquette L).ν, (cubeTopPlaquette L).μ⟩)⁻¹ *
                (U ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).ν⟩)⁻¹ * g))
            SU2.haarProbability := by
        refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
        fun_prop
      rw [integral_add (integrable_const 1) h_int_lin, integral_const, probReal_univ, one_smul,
          integral_const_mul, integral_halfTraceRe_mul_left_eq_zero, mul_zero, add_zero, mul_one]
    simp_rw [h_top_step₁]
    exact integral_gaugeHaarMeasure_singlePlaquette_linearizedBoltzmann_eq_beta_div_four
      hL β (cubeBottomPlaquette L)
  · let H₂ : GaugeConfig L → ℝ := fun U =>
      (1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
      ((1 + β * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
    have h_pt₂ (U : GaugeConfig L) :
        (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) *
          (1 + β * physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) *
          physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U = H₂ U := by
      dsimp [H₂]
      rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
      ring
    simp_rw [h_pt₂]
    have hH₂_cont : Continuous H₂ := by dsimp [H₂]; fun_prop
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
      ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ H₂ hH₂_cont]
    have h_top_step₂ (U : GaugeConfig L) :
        (∫ g : SU2,
          H₂ (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
          ∂SU2.haarProbability) =
          (1 + β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) * (β / 4) := by
      dsimp [H₂]
      simp_rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero
          hL U (cubeTopPlaquette L).x rfl (cubeTopPlaquette L).μ,
        halfTraceRe_plaquetteHolonomy_update_first hL U (cubeTopPlaquette L),
        integral_const_mul]
      rw [integral_add_mul_halfTraceRe_mul_left_eq, mul_inv_cancel]
      have h1 : halfTraceRe 1 = 1 := su2CompactGaugeClassTrace.h_one
      rw [h1, mul_one]
    simp_rw [h_top_step₂, integral_mul_const]
    have h_bot_int :
        Integrable (fun U : GaugeConfig L =>
          β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
          (gaugeHaarMeasure L) := by
      refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
      fun_prop
    rw [integral_add (integrable_const 1) h_bot_int, integral_const, probReal_univ, one_smul,
        integral_const_mul, integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL (cubeBottomPlaquette L),
        mul_zero, add_zero, one_mul]

/-- Exact connected cancellation of the two-probe self-linearized weight
`w_self(β, U) = (1 + β * fΘ U) * (1 + β * fp U)` (`L ≥ 2`):
while the unnormalized 2-point integral of `w_self` is `β ^ 2 / 16` and each 1-point integral is `β / 4`,
its connected combination `(∫ w_self * fΘ * fp) * (∫ w_self) - (∫ w_self * fΘ) * (∫ w_self * fp)`
vanishes identically (`= 0`) for every `β : ℝ`.
Note: this proves connected cancellation for the specified two-plaquette linearized weight `w_self`;
eliminating all degrees `< 4` and bounding the degree-`≥ 5` tail for the full exponential weight
`characterBoltzmannWeight β` remain open obligations toward R1. -/
theorem integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_connected_eq_zero
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    let w_self : GaugeConfig L → ℝ := fun U => (1 + β * fΘ U) * (1 + β * fp U)
    (∫ U : GaugeConfig L, w_self U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) *
        (∫ U' : GaugeConfig L, w_self U' ∂(gaugeHaarMeasure L)) -
      (∫ U : GaugeConfig L, w_self U * fΘ U ∂(gaugeHaarMeasure L)) *
        (∫ U' : GaugeConfig L, w_self U' * fp U' ∂(gaugeHaarMeasure L)) = 0 := by
  dsimp only
  rw [integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_eq_beta_sq_div_sixteen hL β,
      integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_eq_one hL β,
      (integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_single_probes_eq_beta_div_four hL β).1,
      (integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_single_probes_eq_beta_div_four hL β).2]
  ring

/-- Common-denominator two-replica representation of the normalized full-torus covariance
`wilsonProbeCov L β` (`L ≥ 2`, `β ≥ 0`):
expresses `wilsonProbeCov L β` over `characterPartition L β ^ 2` both as the determinant-like
combination `(∫ w * fΘ * fp) * Z_char - (∫ w * fΘ) * (∫ w * fp)` and as the iterated replica integral
`∫ U, (∫ U', w(U) * w(U') * fΘ(U) * (fp(U) - fp(U')) ∂μ₀(U')) ∂μ₀(U)` divided by `Z_char ^ 2`.
This identity puts the 2-point numerator and disconnected subtraction over a single denominator to
support connected cancellation analysis; it is a representation identity and not itself the
remainder bound required by R1. -/
theorem wilsonProbeCov_eq_iterated_replica_div_characterPartition_sq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ : 0 ≤ β) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    wilsonProbeCov L β =
      ((∫ U : GaugeConfig L, characterBoltzmannWeight β U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) *
          characterPartition L β -
        (∫ U : GaugeConfig L, characterBoltzmannWeight β U * fΘ U ∂(gaugeHaarMeasure L)) *
          (∫ U' : GaugeConfig L, characterBoltzmannWeight β U' * fp U' ∂(gaugeHaarMeasure L))) /
        (characterPartition L β ^ 2) ∧
    wilsonProbeCov L β =
      (∫ U : GaugeConfig L,
        (∫ U' : GaugeConfig L,
          characterBoltzmannWeight β U * characterBoltzmannWeight β U' *
            fΘ U * (fp U - fp U') ∂(gaugeHaarMeasure L))
        ∂(gaugeHaarMeasure L)) /
        (characterPartition L β ^ 2) := by
  let fΘ : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  let fp : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  have hS : Measurable (wilsonAction β : GaugeConfig L → ℝ) := measurable_wilsonAction β
  have hZ : characterPartition L β ≠ 0 := (characterPartition_pos hL β).ne'
  have h_cov :
      wilsonProbeCov L β =
        (∫ U : GaugeConfig L, characterBoltzmannWeight β U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) /
          characterPartition L β -
        ((∫ U : GaugeConfig L, characterBoltzmannWeight β U * fΘ U ∂(gaugeHaarMeasure L)) /
          characterPartition L β) *
        ((∫ U' : GaugeConfig L, characterBoltzmannWeight β U' * fp U' ∂(gaugeHaarMeasure L)) /
          characterPartition L β) := by
    unfold wilsonProbeCov irCov
    rw [integral_wilsonMeasure (gaugeHaarMeasure L) hβ hS (fun U => fΘ U * fp U),
        integral_wilsonMeasure (gaugeHaarMeasure L) hβ hS fΘ,
        integral_wilsonMeasure (gaugeHaarMeasure L) hβ hS fp,
        wilsonExpectation_eq_characterBoltzmannWeight_div_characterPartition β (fun U => fΘ U * fp U),
        wilsonExpectation_eq_characterBoltzmannWeight_div_characterPartition β fΘ,
        wilsonExpectation_eq_characterBoltzmannWeight_div_characterPartition β fp]
  have h_first :
      wilsonProbeCov L β =
        ((∫ U : GaugeConfig L, characterBoltzmannWeight β U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) *
            characterPartition L β -
          (∫ U : GaugeConfig L, characterBoltzmannWeight β U * fΘ U ∂(gaugeHaarMeasure L)) *
            (∫ U' : GaugeConfig L, characterBoltzmannWeight β U' * fp U' ∂(gaugeHaarMeasure L))) /
          (characterPartition L β ^ 2) := by
    rw [h_cov]
    field_simp [hZ]
  have hw_cont : Continuous (characterBoltzmannWeight (L := L) β) :=
    continuous_characterBoltzmannWeight β
  have hfΘ_cont : Continuous fΘ :=
    continuous_physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  have hfp_cont : Continuous fp :=
    continuous_physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  have hw_int : Integrable (characterBoltzmannWeight (L := L) β) (gaugeHaarMeasure L) :=
    hw_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hw_fp_int :
      Integrable (fun U' : GaugeConfig L => characterBoltzmannWeight β U' * fp U')
        (gaugeHaarMeasure L) :=
    (hw_cont.mul hfp_cont).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_inner (U : GaugeConfig L) :
      (∫ U' : GaugeConfig L,
        characterBoltzmannWeight β U * characterBoltzmannWeight β U' *
          fΘ U * (fp U - fp U') ∂(gaugeHaarMeasure L)) =
        (characterBoltzmannWeight β U * (fΘ U * fp U)) * characterPartition L β -
          (characterBoltzmannWeight β U * fΘ U) *
            (∫ U' : GaugeConfig L, characterBoltzmannWeight β U' * fp U' ∂(gaugeHaarMeasure L)) := by
    have h_pt :
        (fun U' : GaugeConfig L =>
          characterBoltzmannWeight β U * characterBoltzmannWeight β U' *
            fΘ U * (fp U - fp U')) =
        fun U' : GaugeConfig L =>
          (characterBoltzmannWeight β U * (fΘ U * fp U)) * characterBoltzmannWeight β U' -
            (characterBoltzmannWeight β U * fΘ U) * (characterBoltzmannWeight β U' * fp U') := by
      funext U'; ring
    rw [h_pt, integral_sub (hw_int.const_mul _) (hw_fp_int.const_mul _),
        integral_const_mul, integral_const_mul]
    rfl
  have h_int_1 :
      Integrable (fun U : GaugeConfig L =>
        (characterBoltzmannWeight β U * (fΘ U * fp U)) * characterPartition L β)
        (gaugeHaarMeasure L) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    exact (hw_cont.mul (hfΘ_cont.mul hfp_cont)).mul continuous_const
  have h_int_2 :
      Integrable (fun U : GaugeConfig L =>
        (characterBoltzmannWeight β U * fΘ U) *
          (∫ U' : GaugeConfig L, characterBoltzmannWeight β U' * fp U' ∂(gaugeHaarMeasure L)))
        (gaugeHaarMeasure L) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    exact (hw_cont.mul hfΘ_cont).mul continuous_const
  have h_outer :
      (∫ U : GaugeConfig L,
        (∫ U' : GaugeConfig L,
          characterBoltzmannWeight β U * characterBoltzmannWeight β U' *
            fΘ U * (fp U - fp U') ∂(gaugeHaarMeasure L))
        ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, characterBoltzmannWeight β U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) *
          characterPartition L β -
        (∫ U : GaugeConfig L, characterBoltzmannWeight β U * fΘ U ∂(gaugeHaarMeasure L)) *
          (∫ U' : GaugeConfig L, characterBoltzmannWeight β U' * fp U' ∂(gaugeHaarMeasure L)) := by
    simp_rw [h_inner]
    rw [integral_sub h_int_1 h_int_2, integral_mul_const, integral_mul_const]
  exact ⟨h_first, by rw [h_outer, ← h_first]⟩

/-- At zero coupling `β = 0`, the canonical probe covariance `wilsonProbeCov L 0` vanishes identically
for every torus side `L ≥ 2`. -/
theorem wilsonProbeCov_zero_eq_zero {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    wilsonProbeCov L 0 = 0 := by
  let fΘ : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  let fp : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  have hS : Measurable (wilsonAction 0 : GaugeConfig L → ℝ) := measurable_wilsonAction 0
  have h_cov :
      wilsonProbeCov L 0 =
        (∫ U : GaugeConfig L, characterBoltzmannWeight 0 U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) /
          characterPartition L 0 -
        wilsonExpectation (gaugeHaarMeasure L) 0 fΘ *
          ((∫ U : GaugeConfig L, characterBoltzmannWeight 0 U * fp U ∂(gaugeHaarMeasure L)) /
            characterPartition L 0) := by
    unfold wilsonProbeCov irCov
    rw [integral_wilsonMeasure (gaugeHaarMeasure L) le_rfl hS (fun U => fΘ U * fp U),
        integral_wilsonMeasure (gaugeHaarMeasure L) le_rfl hS fΘ,
        integral_wilsonMeasure (gaugeHaarMeasure L) le_rfl hS fp,
        wilsonExpectation_eq_characterBoltzmannWeight_div_characterPartition 0 (fun U => fΘ U * fp U),
        wilsonExpectation_eq_characterBoltzmannWeight_div_characterPartition 0 fp]
  have h_char0 (U : GaugeConfig L) : characterBoltzmannWeight 0 U = 1 := by
    unfold characterBoltzmannWeight
    simp
  have h_prod0 :
      (∫ U : GaugeConfig L, characterBoltzmannWeight 0 U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) = 0 := by
    have h0 := integral_gaugeHaarMeasure_probePair_selfLinearizedBoltzmann_eq_beta_sq_div_sixteen hL 0
    have h_eq :
        (fun U : GaugeConfig L => characterBoltzmannWeight 0 U * (fΘ U * fp U)) =
        fun U : GaugeConfig L =>
          (1 + 0 * fΘ U) * (1 + 0 * fp U) * (fΘ U * fp U) := by
      funext U
      rw [h_char0 U]
      ring
    rw [h_eq, h0]
    norm_num
  have h_fp0 :
      (∫ U : GaugeConfig L, characterBoltzmannWeight 0 U * fp U ∂(gaugeHaarMeasure L)) = 0 := by
    have h_eq :
        (fun U : GaugeConfig L => characterBoltzmannWeight 0 U * fp U) =
        fun U : GaugeConfig L => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      rw [h_char0 U, one_mul]
      exact physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U
    rw [h_eq, integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL (cubeTopPlaquette L)]
  rw [h_cov, h_prod0, h_fp0, zero_div, mul_zero, sub_zero]

/-! ### Stage p3.B3 (Part 3): Full-Torus Plaquette Orthogonality, Center-Twist Parity & Degree `< 4` Connected Cancellation -/

theorem two_ne_zero_of_three_le {L : ℕ} (hL : 3 ≤ L) : (2 : ZMod L) ≠ 0 := by
  intro h
  have hdvd : L ∣ 2 := (ZMod.natCast_eq_zero_iff 2 L).mp (by simpa using h)
  have h2 : L ≤ 2 := Nat.le_of_dvd (by decide) hdvd
  omega

/-- For any `L ≥ 2` and any plaquette `p : Plaquette L`, updating the third boundary link
`⟨shift p.x p.ν, p.μ⟩` to `g : SU2` leaves the other 3 boundary links of `p` unchanged and writes
`halfTraceRe (plaquetteHolonomy ... p)` in the left-multiplied form `halfTraceRe (C * g)`. -/
theorem halfTraceRe_plaquetteHolonomy_update_third {L : ℕ} (hL : 2 ≤ L)
    (U : GaugeConfig L) (p : Plaquette L) (g : SU2) :
    halfTraceRe (plaquetteHolonomy (updateGaugeLink L U (shift p.x p.ν) p.μ g) p) =
      halfTraceRe (((U ⟨shift p.x p.μ, p.ν⟩)⁻¹ * (U ⟨p.x, p.μ⟩)⁻¹ * U ⟨p.x, p.ν⟩) * g) := by
  have h1 : updateGaugeLink L U (shift p.x p.ν) p.μ g ⟨p.x, p.μ⟩ = U ⟨p.x, p.μ⟩ := by
    refine updateGaugeLink_apply_of_coord_ne U (shift p.x p.ν) p.x p.μ p.ν ?_ g
    intro h_eq
    have h_one : (1 : ZMod L) = 0 := by
      simpa [shift, unitVec] using sub_eq_zero.mpr h_eq.symm
    exact one_ne_zero_of_two_le hL h_one
  have h2 : updateGaugeLink L U (shift p.x p.ν) p.μ g ⟨shift p.x p.μ, p.ν⟩ = U ⟨shift p.x p.μ, p.ν⟩ :=
    updateGaugeLink_apply_of_dir_ne U (shift p.x p.ν) (shift p.x p.μ) p.h.ne' g
  have h3 : updateGaugeLink L U (shift p.x p.ν) p.μ g ⟨shift p.x p.ν, p.μ⟩ = g :=
    (updateGaugeLink_same_and_other L U (shift p.x p.ν) p.μ g).1
  have h4 : updateGaugeLink L U (shift p.x p.ν) p.μ g ⟨p.x, p.ν⟩ = U ⟨p.x, p.ν⟩ :=
    updateGaugeLink_apply_of_dir_ne U (shift p.x p.ν) p.x p.h.ne' g
  unfold plaquetteHolonomy
  rw [h1, h2, h3, h4, ← halfTraceRe_inv]
  have h_inv :
      (U ⟨p.x, p.μ⟩ * U ⟨shift p.x p.μ, p.ν⟩ * g⁻¹ * (U ⟨p.x, p.ν⟩)⁻¹)⁻¹ =
        (U ⟨p.x, p.ν⟩ * g) * ((U ⟨shift p.x p.μ, p.ν⟩)⁻¹ * (U ⟨p.x, p.μ⟩)⁻¹) := by
    group
  rw [h_inv, halfTraceRe_mul_comm (U ⟨p.x, p.ν⟩ * g)]
  have h_assoc :
      ((U ⟨shift p.x p.μ, p.ν⟩)⁻¹ * (U ⟨p.x, p.μ⟩)⁻¹) * (U ⟨p.x, p.ν⟩ * g) =
        ((U ⟨shift p.x p.μ, p.ν⟩)⁻¹ * (U ⟨p.x, p.μ⟩)⁻¹ * U ⟨p.x, p.ν⟩) * g := by
    group
  rw [h_assoc]

/-- The 4-link boundary support of a plaquette `p : Plaquette L`. -/
def plaquetteLinks {L : ℕ} (p : Plaquette L) : Finset (Link L) :=
  {⟨p.x, p.μ⟩, ⟨shift p.x p.μ, p.ν⟩, ⟨shift p.x p.ν, p.μ⟩, ⟨p.x, p.ν⟩}

/-- Updating any link `e ∉ plaquetteLinks p` leaves `plaquetteHolonomy U p` unchanged. -/
theorem plaquetteHolonomy_update_of_not_mem_plaquetteLinks {L : ℕ}
    (U : GaugeConfig L) (p : Plaquette L) {e : Link L} (he : e ∉ plaquetteLinks p) (g : SU2) :
    plaquetteHolonomy (updateGaugeLink L U e.x e.μ g) p = plaquetteHolonomy U p := by
  have he1 : (⟨p.x, p.μ⟩ : Link L) ≠ e := fun h =>
    he (by simp [plaquetteLinks, ← h])
  have he2 : (⟨shift p.x p.μ, p.ν⟩ : Link L) ≠ e := fun h =>
    he (by simp [plaquetteLinks, ← h])
  have he3 : (⟨shift p.x p.ν, p.μ⟩ : Link L) ≠ e := fun h =>
    he (by simp [plaquetteLinks, ← h])
  have he4 : (⟨p.x, p.ν⟩ : Link L) ≠ e := fun h =>
    he (by simp [plaquetteLinks, ← h])
  unfold plaquetteHolonomy
  rw [(updateGaugeLink_same_and_other L U e.x e.μ g).2 _ he1,
      (updateGaugeLink_same_and_other L U e.x e.μ g).2 _ he2,
      (updateGaugeLink_same_and_other L U e.x e.μ g).2 _ he3,
      (updateGaugeLink_same_and_other L U e.x e.μ g).2 _ he4]

/-- Integrating `halfTraceRe (plaquetteHolonomy ... p)` over any single boundary link `e ∈ plaquetteLinks p`
yields `0` (`L ≥ 2`). -/
theorem integral_plaquetteHolonomy_update_eq_zero_of_mem_plaquetteLinks
    {L : ℕ} (hL : 2 ≤ L) (U : GaugeConfig L) (p : Plaquette L)
    {e : Link L} (he : e ∈ plaquetteLinks p) :
    (∫ g : SU2, halfTraceRe (plaquetteHolonomy (updateGaugeLink L U e.x e.μ g) p)
      ∂SU2.haarProbability) = 0 := by
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_first hL U p]
    exact integral_halfTraceRe_mul_left_eq_zero _
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_second hL U p]
    exact integral_halfTraceRe_mul_left_eq_zero _
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_third hL U p]
    exact integral_halfTraceRe_mul_left_eq_zero _
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_fourth hL U p]
    exact integral_halfTraceRe_mul_left_eq_zero _

/-- General single-link Haar vanishing criterion on `gaugeHaarMeasure L` (`L ≥ 2`):
if `H : GaugeConfig L → ℝ` is continuous and invariant under updating a boundary link
`e ∈ plaquetteLinks p`, then `∫ U, H U * halfTraceRe (plaquetteHolonomy U p) ∂(gaugeHaarMeasure L) = 0`. -/
theorem integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (p : Plaquette L)
    (e : Link L) (he : e ∈ plaquetteLinks p)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ (U : GaugeConfig L) (g : SU2), H (updateGaugeLink L U e.x e.μ g) = H U) :
    (∫ U : GaugeConfig L, H U * halfTraceRe (plaquetteHolonomy U p) ∂(gaugeHaarMeasure L)) = 0 := by
  have h_cont : Continuous (fun U : GaugeConfig L => H U * halfTraceRe (plaquetteHolonomy U p)) :=
    hH_cont.mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p))
  rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous e _ h_cont]
  have h_inner (U : GaugeConfig L) :
      (∫ g : SU2,
        H (updateGaugeLink L U e.x e.μ g) *
          halfTraceRe (plaquetteHolonomy (updateGaugeLink L U e.x e.μ g) p)
        ∂SU2.haarProbability) = 0 := by
    simp_rw [hH_inv U]
    rw [integral_const_mul,
        integral_plaquetteHolonomy_update_eq_zero_of_mem_plaquetteLinks hL U p he,
        mul_zero]
  simp_rw [h_inner, integral_zero]

/-- Integrating `(halfTraceRe (plaquetteHolonomy ... p)) ^ 2` over any single boundary link
`e ∈ plaquetteLinks p` yields `1 / 4` (`L ≥ 2`). -/
theorem integral_plaquetteHolonomy_sq_update_eq_quarter_of_mem_plaquetteLinks
    {L : ℕ} (hL : 2 ≤ L) (U : GaugeConfig L) (p : Plaquette L)
    {e : Link L} (he : e ∈ plaquetteLinks p) :
    (∫ g : SU2, (halfTraceRe (plaquetteHolonomy (updateGaugeLink L U e.x e.μ g) p)) ^ 2
      ∂SU2.haarProbability) = 1 / 4 := by
  have h_sq (C : SU2) :
      (∫ g : SU2, (halfTraceRe (C * g)) ^ 2 ∂SU2.haarProbability) = 1 / 4 := by
    have h := integral_add_mul_halfTraceRe_mul_left_eq 0 1 C C
    have h_pt :
        (fun g : SU2 => (halfTraceRe (C * g)) ^ 2) =
          fun g : SU2 => (0 + 1 * halfTraceRe (C * g)) * halfTraceRe (C * g) := by
      funext g; ring
    have h1 : halfTraceRe 1 = 1 := su2CompactGaugeClassTrace.h_one
    rw [h_pt, h, mul_inv_cancel, h1, mul_one]
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_first hL U p]
    exact h_sq _
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_second hL U p]
    exact h_sq _
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_third hL U p]
    exact h_sq _
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_fourth hL U p]
    exact h_sq _

/-- For any two distinct plaquettes `q ≠ p`, at least one of the two base links `⟨p.x, p.μ⟩` or
`⟨p.x, p.ν⟩` of `p` does not belong to `plaquetteLinks q`. -/
theorem not_mem_plaquetteLinks_first_or_fourth_of_ne {L : ℕ}
    {q p : Plaquette L} (hne : q ≠ p) :
    (⟨p.x, p.μ⟩ : Link L) ∉ plaquetteLinks q ∨ (⟨p.x, p.ν⟩ : Link L) ∉ plaquetteLinks q := by
  by_cases hm1 : (⟨p.x, p.μ⟩ : Link L) ∈ plaquetteLinks q
  · by_cases hm4 : (⟨p.x, p.ν⟩ : Link L) ∈ plaquetteLinks q
    · exfalso
      simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at hm1 hm4
      have hμ_or : p.μ = q.μ ∨ p.μ = q.ν := by
        rcases hm1 with h | h | h | h
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
      have hν_or : p.ν = q.μ ∨ p.ν = q.ν := by
        rcases hm4 with h | h | h | h
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
        · exact Or.inl (congrArg Link.μ h)
        · exact Or.inr (congrArg Link.μ h)
      have hp_lt : p.μ < p.ν := p.h
      have hq_lt : q.μ < q.ν := q.h
      have hμ_eq : p.μ = q.μ := by
        rcases hμ_or with h1 | h1 <;> rcases hν_or with h2 | h2
        · exact h1
        · exact h1
        · exfalso; exact lt_asymm (h1 ▸ h2 ▸ hp_lt) hq_lt
        · exfalso; exact hp_lt.ne (h1.trans h2.symm)
      have hν_eq : p.ν = q.ν := by
        rcases hν_or with h2 | h2
        · exfalso; exact hp_lt.ne (hμ_eq.trans h2.symm)
        · exact h2
      have hx1 : p.x = q.x ∨ p.x = shift q.x q.ν := by
        rcases hm1 with h | h | h | h
        · exact Or.inl (congrArg Link.x h)
        · exfalso; exact q.h.ne (hμ_eq.symm.trans (congrArg Link.μ h))
        · exact Or.inr (congrArg Link.x h)
        · exfalso; exact q.h.ne (hμ_eq.symm.trans (congrArg Link.μ h))
      have hx4 : p.x = q.x ∨ p.x = shift q.x q.μ := by
        rcases hm4 with h | h | h | h
        · exfalso; exact q.h.ne' (hν_eq.symm.trans (congrArg Link.μ h))
        · exact Or.inr (congrArg Link.x h)
        · exfalso; exact q.h.ne' (hν_eq.symm.trans (congrArg Link.μ h))
        · exact Or.inl (congrArg Link.x h)
      have hx_eq : p.x = q.x := by
        funext i
        by_cases hi : i = q.ν
        · subst hi
          rcases hx4 with h | h
          · exact congrFun h q.ν
          · rw [congrFun h q.ν]
            simp [shift, unitVec, q.h.ne']
        · rcases hx1 with h | h
          · exact congrFun h i
          · rw [congrFun h i]
            simp [shift, unitVec, hi]
      apply hne
      cases q with
      | mk qx qμ qν qh =>
        cases p with
        | mk px pμ pν ph =>
          dsimp at hx_eq hμ_eq hν_eq
          subst hx_eq hμ_eq hν_eq
          rfl
    · exact Or.inr hm4
  · exact Or.inl hm1

/-- Full-torus plaquette character orthogonality on `gaugeHaarMeasure L` (`L ≥ 2`):
for any two plaquettes `q, p : Plaquette L`, the free Haar inner product of their normalized traces
equals `1 / 4` when `q = p` and `0` when `q ≠ p`. -/
theorem integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (q p : Plaquette L) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U q) * halfTraceRe (plaquetteHolonomy U p)
      ∂(gaugeHaarMeasure L)) =
      if q = p then 1 / 4 else 0 := by
  split_ifs with hqp
  · subst hqp
    have h_sq (U : GaugeConfig L) :
        halfTraceRe (plaquetteHolonomy U q) * halfTraceRe (plaquetteHolonomy U q) =
          (halfTraceRe (plaquetteHolonomy U q)) ^ 2 := by
      ring
    simp_rw [h_sq]
    have h_cont : Continuous (fun U : GaugeConfig L => (halfTraceRe (plaquetteHolonomy U q)) ^ 2) :=
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q)).pow 2
    have he : (⟨q.x, q.μ⟩ : Link L) ∈ plaquetteLinks q := by
      simp [plaquetteLinks]
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous ⟨q.x, q.μ⟩ _ h_cont]
    simp_rw [integral_plaquetteHolonomy_sq_update_eq_quarter_of_mem_plaquetteLinks hL _ q he,
      integral_const, probReal_univ, one_smul]
  · have h_cont : Continuous (fun U : GaugeConfig L => halfTraceRe (plaquetteHolonomy U q)) :=
      continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q)
    rcases not_mem_plaquetteLinks_first_or_fourth_of_ne hqp with h_not1 | h_not4
    · refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
        hL p ⟨p.x, p.μ⟩ (by simp [plaquetteLinks]) _ h_cont (fun U g => ?_)
      exact congrArg halfTraceRe (plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q h_not1 g)
    · refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
        hL p ⟨p.x, p.ν⟩ (by simp [plaquetteLinks]) _ h_cont (fun U g => ?_)
      exact congrArg halfTraceRe (plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q h_not4 g)

/-- Total vacuum-subtracted character sum `∑_{p : Plaquette L} halfTraceRe (plaquetteHolonomy U p)`
appearing in `characterBoltzmannWeight β U = exp (β * totalCharacterSum U)`. -/
noncomputable def totalCharacterSum {L : ℕ} [NeZero L] (U : GaugeConfig L) : ℝ :=
  ∑ p : Plaquette L, halfTraceRe (plaquetteHolonomy U p)

@[continuity, fun_prop]
theorem continuous_totalCharacterSum {L : ℕ} [NeZero L] : Continuous (totalCharacterSum (L := L)) := by
  unfold totalCharacterSum
  fun_prop

/-- The degree-1 full-torus character sum `totalCharacterSum` has mean `0` under `gaugeHaarMeasure L` (`L ≥ 2`). -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_eq_zero
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L, totalCharacterSum U ∂(gaugeHaarMeasure L)) = 0 := by
  unfold totalCharacterSum
  rw [integral_finsetSum]
  · simp_rw [integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL, Finset.sum_const_zero]
  · intro p _
    exact (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p)).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)

/-- By full-torus plaquette orthogonality, integrating `totalCharacterSum U` against any single
plaquette character `halfTraceRe (plaquetteHolonomy U p)` selects the `q = p` term and yields `1 / 4` (`L ≥ 2`). -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_mul_plaquetteHolonomy_eq_quarter
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (p : Plaquette L) :
    (∫ U : GaugeConfig L,
      totalCharacterSum U * halfTraceRe (plaquetteHolonomy U p) ∂(gaugeHaarMeasure L)) = 1 / 4 := by
  have h_pt :
      (fun U : GaugeConfig L => totalCharacterSum U * halfTraceRe (plaquetteHolonomy U p)) =
        fun U : GaugeConfig L =>
          ∑ q : Plaquette L,
            halfTraceRe (plaquetteHolonomy U q) * halfTraceRe (plaquetteHolonomy U p) := by
    funext U
    unfold totalCharacterSum
    exact Finset.sum_mul _ _ _
  rw [h_pt, integral_finsetSum]
  · simp_rw [integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL _ p]
    simp
  · intro q _
    exact ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q)).mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)

/-- Full-torus degree-1 one-point probe expectations (`L ≥ 2`):
both `∫ U, totalCharacterSum U * fΘ U` and `∫ U, totalCharacterSum U * fp U` equal `1 / 4`. -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_single_probes_eq_quarter
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    (∫ U : GaugeConfig L, totalCharacterSum U * fΘ U ∂(gaugeHaarMeasure L)) = 1 / 4 ∧
    (∫ U : GaugeConfig L, totalCharacterSum U * fp U ∂(gaugeHaarMeasure L)) = 1 / 4 := by
  dsimp only
  constructor
  · have h_eq :
        (fun U : GaugeConfig L =>
          totalCharacterSum U *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) =
        fun U : GaugeConfig L =>
          totalCharacterSum U * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      funext U
      rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U]
    rw [h_eq]
    exact integral_gaugeHaarMeasure_totalCharacterSum_mul_plaquetteHolonomy_eq_quarter hL _
  · have h_eq :
        (fun U : GaugeConfig L =>
          totalCharacterSum U *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) =
        fun U : GaugeConfig L =>
          totalCharacterSum U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      rw [physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    rw [h_eq]
    exact integral_gaugeHaarMeasure_totalCharacterSum_mul_plaquetteHolonomy_eq_quarter hL _

/-- Full-torus degree-2 partition moment (`L ≥ 2`):
`∫ U, (totalCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L) = (Fintype.card (Plaquette L) : ℝ) / 4`. -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_sq_eq_card_div_four
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) =
      (Fintype.card (Plaquette L) : ℝ) / 4 := by
  have h_pt :
      (fun U : GaugeConfig L => (totalCharacterSum U) ^ 2) =
        fun U : GaugeConfig L =>
          ∑ p : Plaquette L,
            totalCharacterSum U * halfTraceRe (plaquetteHolonomy U p) := by
    funext U
    rw [sq]
    conv_lhs => rhs; unfold totalCharacterSum
    exact Finset.mul_sum _ _ _
  rw [h_pt, integral_finsetSum]
  · simp_rw [integral_gaugeHaarMeasure_totalCharacterSum_mul_plaquetteHolonomy_eq_quarter hL]
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    ring
  · intro p _
    exact (continuous_totalCharacterSum.mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)

theorem negOne_mul_comm (g : SU2) : negOne * g = g * negOne :=
  SU2.ext (by change (-1 : Matrix (Fin 2) (Fin 2) ℂ) * g.mat = g.mat * (-1); simp)

theorem negOne_mul_negOne : (negOne : SU2) * negOne = 1 :=
  SU2.ext (by change (-1 : Matrix (Fin 2) (Fin 2) ℂ) * (-1) = 1; simp)

theorem negOne_inv : (negOne : SU2)⁻¹ = negOne :=
  inv_eq_iff_mul_eq_one.mpr negOne_mul_negOne

/-- Center-element relation `B = A ∨ B = negOne * A` in `SU(2)`. -/
def IsCenterSignOf (B A : SU2) : Prop :=
  B = A ∨ B = negOne * A

theorem isCenterSignOf_twistLinkNegOne {L : ℕ} (e₀ e : Link L) (U : GaugeConfig L) :
    IsCenterSignOf (twistLinkNegOne e₀ U e) (U e) := by
  unfold twistLinkNegOne IsCenterSignOf
  split_ifs
  · exact Or.inr rfl
  · exact Or.inl (one_mul _)

theorem IsCenterSignOf.inv {B A : SU2} (h : IsCenterSignOf B A) :
    IsCenterSignOf B⁻¹ A⁻¹ := by
  rcases h with h | h
  · exact Or.inl (congrArg Inv.inv h)
  · right
    rw [h, mul_inv_rev, negOne_inv, ← negOne_mul_comm]

theorem IsCenterSignOf.mul {B₁ A₁ B₂ A₂ : SU2}
    (h₁ : IsCenterSignOf B₁ A₁) (h₂ : IsCenterSignOf B₂ A₂) :
    IsCenterSignOf (B₁ * B₂) (A₁ * A₂) := by
  rcases h₁ with h1 | h1 <;> rcases h₂ with h2 | h2
  · exact Or.inl (by rw [h1, h2])
  · right
    rw [h1, h2, ← mul_assoc, ← negOne_mul_comm A₁, mul_assoc]
  · right
    rw [h1, h2, mul_assoc]
  · left
    rw [h1, h2]
    calc
      (negOne * A₁) * (negOne * A₂) = negOne * (A₁ * negOne) * A₂ := by group
      _ = negOne * (negOne * A₁) * A₂ := by rw [negOne_mul_comm A₁]
      _ = (negOne * negOne) * (A₁ * A₂) := by group
      _ = A₁ * A₂ := by rw [negOne_mul_negOne, one_mul]

/-- Under any single-link center twist `twistLinkNegOne e₀`, the holonomy of every plaquette `q`
either remains unchanged or is multiplied by `negOne = -1 ∈ Z(SU(2))`. -/
theorem isCenterSignOf_plaquetteHolonomy_twistLinkNegOne {L : ℕ}
    (e₀ : Link L) (U : GaugeConfig L) (q : Plaquette L) :
    IsCenterSignOf (plaquetteHolonomy (twistLinkNegOne e₀ U) q) (plaquetteHolonomy U q) := by
  unfold plaquetteHolonomy
  exact (((isCenterSignOf_twistLinkNegOne e₀ _ U).mul
    (isCenterSignOf_twistLinkNegOne e₀ _ U)).mul
    (isCenterSignOf_twistLinkNegOne e₀ _ U).inv).mul
    (isCenterSignOf_twistLinkNegOne e₀ _ U).inv

/-- Squaring `halfTraceRe (plaquetteHolonomy U q)` kills the `±1` center sign, so
`(halfTraceRe (plaquetteHolonomy (twistLinkNegOne e₀ U) q)) ^ 2` is invariant under
`twistLinkNegOne e₀` for every link `e₀ : Link L` and every plaquette `q : Plaquette L`. -/
theorem halfTraceRe_plaquetteHolonomy_twistLinkNegOne_sq {L : ℕ}
    (e₀ : Link L) (U : GaugeConfig L) (q : Plaquette L) :
    (halfTraceRe (plaquetteHolonomy (twistLinkNegOne e₀ U) q)) ^ 2 =
      (halfTraceRe (plaquetteHolonomy U q)) ^ 2 := by
  rcases isCenterSignOf_plaquetteHolonomy_twistLinkNegOne e₀ U q with h | h
  · rw [h]
  · rw [h, YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul, neg_sq]

/-- Center-twist parity vanishing of any squared plaquette character times any single plaquette
character (`L ≥ 2`): for all `p, r : Plaquette L` (even when `r = p` or `r` shares links with `p`),
twisting `⟨r.x, r.μ⟩` by `twistLinkNegOne` preserves `(halfTraceRe (plaquetteHolonomy U p)) ^ 2`
and flips the sign of `halfTraceRe (plaquetteHolonomy U r)`, so the integral vanishes. -/
theorem integral_gaugeHaarMeasure_sq_mul_plaquetteHolonomy_eq_zero
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (p r : Plaquette L) :
    (∫ U : GaugeConfig L,
      (halfTraceRe (plaquetteHolonomy U p)) ^ 2 * halfTraceRe (plaquetteHolonomy U r)
      ∂(gaugeHaarMeasure L)) = 0 := by
  have h_cont :
      Continuous (fun U : GaugeConfig L =>
        (halfTraceRe (plaquetteHolonomy U p)) ^ 2 * halfTraceRe (plaquetteHolonomy U r)) :=
    ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p)).pow 2).mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy r))
  refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg ⟨r.x, r.μ⟩
    h_cont (fun U => ?_)
  rw [halfTraceRe_plaquetteHolonomy_twistLinkNegOne_sq ⟨r.x, r.μ⟩ U p,
      plaquetteHolonomy_twistLinkNegOne_base_μ hL r U,
      YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul,
      mul_neg]

/-- Center-twist parity vanishing of any product of two squared plaquette characters times any
single plaquette character (`L ≥ 2`): for all `p₁, p₂, r : Plaquette L`,
`∫ U, (halfTraceRe (U_{p₁})) ^ 2 * (halfTraceRe (U_{p₂})) ^ 2 * halfTraceRe (U_r) ∂(gaugeHaarMeasure L) = 0`. -/
theorem integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (p₁ p₂ r : Plaquette L) :
    (∫ U : GaugeConfig L,
      (halfTraceRe (plaquetteHolonomy U p₁)) ^ 2 *
        (halfTraceRe (plaquetteHolonomy U p₂)) ^ 2 *
        halfTraceRe (plaquetteHolonomy U r)
      ∂(gaugeHaarMeasure L)) = 0 := by
  have h_cont :
      Continuous (fun U : GaugeConfig L =>
        (halfTraceRe (plaquetteHolonomy U p₁)) ^ 2 *
          (halfTraceRe (plaquetteHolonomy U p₂)) ^ 2 *
          halfTraceRe (plaquetteHolonomy U r)) :=
    (((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p₁)).pow 2).mul
      ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p₂)).pow 2)).mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy r))
  refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg ⟨r.x, r.μ⟩
    h_cont (fun U => ?_)
  rw [halfTraceRe_plaquetteHolonomy_twistLinkNegOne_sq ⟨r.x, r.μ⟩ U p₁,
      halfTraceRe_plaquetteHolonomy_twistLinkNegOne_sq ⟨r.x, r.μ⟩ U p₂,
      plaquetteHolonomy_twistLinkNegOne_base_μ hL r U,
      YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul,
      mul_neg]

/-- Enumeration of the 4 boundary links of a plaquette `p : Plaquette L`. -/
def plaquetteLinkAt {L : ℕ} (p : Plaquette L) : Fin 4 → Link L
  | ⟨0, _⟩ => ⟨p.x, p.μ⟩
  | ⟨1, _⟩ => ⟨shift p.x p.μ, p.ν⟩
  | ⟨2, _⟩ => ⟨shift p.x p.ν, p.μ⟩
  | ⟨3, _⟩ => ⟨p.x, p.ν⟩

theorem plaquetteLinkAt_mem_plaquetteLinks {L : ℕ} (p : Plaquette L) (k : Fin 4) :
    plaquetteLinkAt p k ∈ plaquetteLinks p := by
  fin_cases k <;> simp [plaquetteLinkAt, plaquetteLinks]

theorem dir_eq_of_mem_plaquetteLinks {L : ℕ} {q : Plaquette L} {e : Link L}
    (he : e ∈ plaquetteLinks q) :
    e.μ = q.μ ∨ e.μ = q.ν := by
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem site_of_mem_plaquetteLinks_of_dir_eq_mu {L : ℕ} {q : Plaquette L} {e : Link L}
    (he : e ∈ plaquetteLinks q) (hμ : e.μ = q.μ) :
    e.x = q.x ∨ e.x = shift q.x q.ν := by
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact Or.inl rfl
  · exfalso; exact q.h.ne hμ.symm
  · exact Or.inr rfl
  · exfalso; exact q.h.ne hμ.symm

theorem site_of_mem_plaquetteLinks_of_dir_eq_nu {L : ℕ} {q : Plaquette L} {e : Link L}
    (he : e ∈ plaquetteLinks q) (hν : e.μ = q.ν) :
    e.x = q.x ∨ e.x = shift q.x q.μ := by
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl
  · exfalso; exact q.h.ne hν
  · exact Or.inr rfl
  · exfalso; exact q.h.ne hν
  · exact Or.inl rfl

theorem coord_eq_of_mem_plaquetteLinks_of_dir_eq_mu {L : ℕ} {q : Plaquette L} {e : Link L}
    (he : e ∈ plaquetteLinks q) (hμ : e.μ = q.μ) {i : Fin 4} (hi : i ≠ q.ν) :
    e.x i = q.x i := by
  rcases site_of_mem_plaquetteLinks_of_dir_eq_mu he hμ with hx | hx
  · exact congrFun hx i
  · rw [congrFun hx i]
    simp [shift, unitVec, hi]

theorem coord_eq_of_mem_plaquetteLinks_of_dir_eq_nu {L : ℕ} {q : Plaquette L} {e : Link L}
    (he : e ∈ plaquetteLinks q) (hν : e.μ = q.ν) {i : Fin 4} (hi : i ≠ q.μ) :
    e.x i = q.x i := by
  rcases site_of_mem_plaquetteLinks_of_dir_eq_nu he hν with hx | hx
  · exact congrFun hx i
  · rw [congrFun hx i]
    simp [shift, unitVec, hi]

theorem plaquette_eq_of_mem_plaquetteLinks_mu_and_nu {L : ℕ}
    {q p : Plaquette L} {a b : Link L}
    (ha_q : a ∈ plaquetteLinks q) (ha_p : a ∈ plaquetteLinks p) (ha_μ : a.μ = p.μ)
    (hb_q : b ∈ plaquetteLinks q) (hb_p : b ∈ plaquetteLinks p) (hb_ν : b.μ = p.ν) :
    q = p := by
  have hμ_or : p.μ = q.μ ∨ p.μ = q.ν := ha_μ ▸ dir_eq_of_mem_plaquetteLinks ha_q
  have hν_or : p.ν = q.μ ∨ p.ν = q.ν := hb_ν ▸ dir_eq_of_mem_plaquetteLinks hb_q
  have hp_lt : p.μ < p.ν := p.h
  have hq_lt : q.μ < q.ν := q.h
  have hμ_eq : p.μ = q.μ := by
    rcases hμ_or with h1 | h1 <;> rcases hν_or with h2 | h2
    · exact h1
    · exact h1
    · exfalso; exact lt_asymm (h1 ▸ h2 ▸ hp_lt) hq_lt
    · exfalso; exact hp_lt.ne (h1.trans h2.symm)
  have hν_eq : p.ν = q.ν := by
    rcases hν_or with h2 | h2
    · exfalso; exact hp_lt.ne (hμ_eq.trans h2.symm)
    · exact h2
  have hx_eq : q.x = p.x := by
    funext i
    by_cases hi : i = q.ν
    · have hi_p : i ≠ p.μ := by
        rw [hi, ← hν_eq]
        exact p.h.ne'
      have hi_q : i ≠ q.μ := by
        rw [hi]
        exact q.h.ne'
      exact (coord_eq_of_mem_plaquetteLinks_of_dir_eq_nu hb_q (hb_ν.trans hν_eq) hi_q).symm.trans
        (coord_eq_of_mem_plaquetteLinks_of_dir_eq_nu hb_p hb_ν hi_p)
    · have hi_p : i ≠ p.ν := by
        rwa [hν_eq]
      exact (coord_eq_of_mem_plaquetteLinks_of_dir_eq_mu ha_q (ha_μ.trans hμ_eq) hi).symm.trans
        (coord_eq_of_mem_plaquetteLinks_of_dir_eq_mu ha_p ha_μ hi_p)
  cases q with
  | mk qx qμ qν qh =>
    cases p with
    | mk px pμ pν ph =>
      dsimp at hx_eq hμ_eq hν_eq
      subst hx_eq hμ_eq hν_eq
      rfl

theorem plaquette_eq_of_mem_plaquetteLinks_zero_and_two {L : ℕ} (hL : 3 ≤ L)
    {q p : Plaquette L}
    (h0 : (⟨p.x, p.μ⟩ : Link L) ∈ plaquetteLinks q)
    (h2 : (⟨shift p.x p.ν, p.μ⟩ : Link L) ∈ plaquetteLinks q) :
    q = p := by
  have hL2 : 2 ≤ L := by omega
  have h_diff : (shift p.x p.ν) p.ν ≠ p.x p.ν := by
    intro h_eq
    have h_one : (1 : ZMod L) = 0 := by
      simpa [shift, unitVec] using sub_eq_zero.mpr h_eq
    exact one_ne_zero_of_two_le hL2 h_one
  have hμ_or : p.μ = q.μ ∨ p.μ = q.ν := dir_eq_of_mem_plaquetteLinks h0
  have hμ_eq : p.μ = q.μ := by
    rcases hμ_or with hμ | hμ
    · exact hμ
    · exfalso
      have hν_eq : p.ν = q.μ := by
        by_contra h_ne
        have hc0 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_nu h0 hμ h_ne
        have hc2 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_nu h2 hμ h_ne
        exact h_diff (hc2.trans hc0.symm)
      exact lt_asymm (hμ ▸ hν_eq ▸ p.h) q.h
  have hν_eq : p.ν = q.ν := by
    by_contra h_ne
    have hc0 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_mu h0 hμ_eq h_ne
    have hc2 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_mu h2 hμ_eq h_ne
    exact h_diff (hc2.trans hc0.symm)
  have hx0 := site_of_mem_plaquetteLinks_of_dir_eq_mu h0 hμ_eq
  have hx2 := site_of_mem_plaquetteLinks_of_dir_eq_mu h2 hμ_eq
  have hx_eq : q.x = p.x := by
    rcases hx0 with h_a | h_a
    · exact h_a.symm
    · rcases hx2 with h_b | h_b
      · exfalso
        dsimp only at h_a h_b
        have h_two_site : shift (shift q.x q.ν) p.ν = q.x := by
          rw [← h_a, h_b]
        have h_coord := congrFun h_two_site q.ν
        rw [hν_eq] at h_coord
        have h_two : (2 : ZMod L) = 0 := by
          have h_expand : (shift (shift q.x q.ν) q.ν) q.ν - q.x q.ν = (2 : ZMod L) := by
            simp [shift, unitVec]
            ring
          rw [h_coord, sub_self] at h_expand
          exact h_expand.symm
        exact two_ne_zero_of_three_le hL h_two
      · dsimp only at h_b
        rw [← hν_eq] at h_b
        funext i
        have hi := congrFun h_b i
        dsimp [shift] at hi
        exact (add_right_cancel hi).symm
  cases q with
  | mk qx qμ qν qh =>
    cases p with
    | mk px pμ pν ph =>
      dsimp at hx_eq hμ_eq hν_eq
      subst hx_eq hμ_eq hν_eq
      rfl

theorem plaquette_eq_of_mem_plaquetteLinks_one_and_three {L : ℕ} (hL : 3 ≤ L)
    {q p : Plaquette L}
    (h1 : (⟨shift p.x p.μ, p.ν⟩ : Link L) ∈ plaquetteLinks q)
    (h3 : (⟨p.x, p.ν⟩ : Link L) ∈ plaquetteLinks q) :
    q = p := by
  have hL2 : 2 ≤ L := by omega
  have h_diff : (shift p.x p.μ) p.μ ≠ p.x p.μ := by
    intro h_eq
    have h_one : (1 : ZMod L) = 0 := by
      simpa [shift, unitVec] using sub_eq_zero.mpr h_eq
    exact one_ne_zero_of_two_le hL2 h_one
  have hν_or : p.ν = q.μ ∨ p.ν = q.ν := dir_eq_of_mem_plaquetteLinks h3
  have hν_eq : p.ν = q.ν := by
    rcases hν_or with hν | hν
    · exfalso
      have hμ_eq : p.μ = q.ν := by
        by_contra h_ne
        have hc1 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_mu h1 hν h_ne
        have hc3 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_mu h3 hν h_ne
        exact h_diff (hc1.trans hc3.symm)
      exact lt_asymm (hμ_eq ▸ hν ▸ p.h) q.h
    · exact hν
  have hμ_eq : p.μ = q.μ := by
    by_contra h_ne
    have hc1 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_nu h1 hν_eq h_ne
    have hc3 := coord_eq_of_mem_plaquetteLinks_of_dir_eq_nu h3 hν_eq h_ne
    exact h_diff (hc1.trans hc3.symm)
  have hx1 := site_of_mem_plaquetteLinks_of_dir_eq_nu h1 hν_eq
  have hx3 := site_of_mem_plaquetteLinks_of_dir_eq_nu h3 hν_eq
  have hx_eq : q.x = p.x := by
    rcases hx3 with h_a | h_a
    · exact h_a.symm
    · rcases hx1 with h_b | h_b
      · exfalso
        dsimp only at h_a h_b
        have h_two_site : shift (shift q.x q.μ) p.μ = q.x := by
          rw [← h_a, h_b]
        have h_coord := congrFun h_two_site q.μ
        rw [hμ_eq] at h_coord
        have h_two : (2 : ZMod L) = 0 := by
          have h_expand : (shift (shift q.x q.μ) q.μ) q.μ - q.x q.μ = (2 : ZMod L) := by
            simp [shift, unitVec]
            ring
          rw [h_coord, sub_self] at h_expand
          exact h_expand.symm
        exact two_ne_zero_of_three_le hL h_two
      · dsimp only at h_b
        rw [← hμ_eq] at h_b
        funext i
        have hi := congrFun h_b i
        dsimp [shift] at hi
        exact (add_right_cancel hi).symm
  cases q with
  | mk qx qμ qν qh =>
    cases p with
    | mk px pμ pν ph =>
      dsimp at hx_eq hμ_eq hν_eq
      subst hx_eq hμ_eq hν_eq
      rfl

/-- Pairwise boundary-link sharing bound (`L ≥ 3`):
any two distinct plaquettes `q ≠ p` on `Lattice4D L` share at most one boundary link. -/
theorem plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne {L : ℕ} (hL : 3 ≤ L)
    {q p : Plaquette L} (hne : q ≠ p) {k₁ k₂ : Fin 4}
    (h₁ : plaquetteLinkAt p k₁ ∈ plaquetteLinks q)
    (h₂ : plaquetteLinkAt p k₂ ∈ plaquetteLinks q) :
    k₁ = k₂ := by
  have hm0 : plaquetteLinkAt p 0 ∈ plaquetteLinks p := plaquetteLinkAt_mem_plaquetteLinks p 0
  have hm1 : plaquetteLinkAt p 1 ∈ plaquetteLinks p := plaquetteLinkAt_mem_plaquetteLinks p 1
  have hm2 : plaquetteLinkAt p 2 ∈ plaquetteLinks p := plaquetteLinkAt_mem_plaquetteLinks p 2
  have hm3 : plaquetteLinkAt p 3 ∈ plaquetteLinks p := plaquetteLinkAt_mem_plaquetteLinks p 3
  fin_cases k₁ <;> fin_cases k₂
  · rfl
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₁ hm0 rfl h₂ hm1 rfl)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_zero_and_two hL h₁ h₂)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₁ hm0 rfl h₂ hm3 rfl)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₂ hm0 rfl h₁ hm1 rfl)
  · rfl
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₂ hm2 rfl h₁ hm1 rfl)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_one_and_three hL h₁ h₂)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_zero_and_two hL h₂ h₁)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₁ hm2 rfl h₂ hm1 rfl)
  · rfl
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₁ hm2 rfl h₂ hm3 rfl)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₂ hm0 rfl h₁ hm3 rfl)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_one_and_three hL h₂ h₁)
  · exfalso; exact hne (plaquette_eq_of_mem_plaquetteLinks_mu_and_nu h₂ hm2 rfl h₁ hm3 rfl)
  · rfl

/-- Boundary-link coverage bound (`L ≥ 3`):
given `m ≤ 3` plaquettes `Q : Fin m → Plaquette L` all distinct from `p` (`∀ j, Q j ≠ p`),
at least one of the 4 boundary links `plaquetteLinkAt p k` of `p` belongs to none of
`plaquetteLinks (Q j)`. -/
theorem exists_plaquetteLinkAt_not_mem_of_ne {L : ℕ} (hL : 3 ≤ L)
    (p : Plaquette L) {m : ℕ} (hm : m ≤ 3) (Q : Fin m → Plaquette L)
    (hQ : ∀ j : Fin m, Q j ≠ p) :
    ∃ k : Fin 4, ∀ j : Fin m, plaquetteLinkAt p k ∉ plaquetteLinks (Q j) := by
  by_contra h_all
  have h_ex : ∀ k : Fin 4, ∃ j : Fin m, plaquetteLinkAt p k ∈ plaquetteLinks (Q j) := by
    intro k
    by_contra hk
    exact h_all ⟨k, fun j hj => hk ⟨j, hj⟩⟩
  choose f hf using h_ex
  have hf_inj : Function.Injective f := by
    intro k₁ k₂ hfk
    have h₂ : plaquetteLinkAt p k₂ ∈ plaquetteLinks (Q (f k₁)) := hfk ▸ hf k₂
    exact plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL (hQ (f k₁)) (hf k₁) h₂
  have h_card : Fintype.card (Fin 4) ≤ Fintype.card (Fin m) :=
    Fintype.card_le_of_injective f hf_inj
  simp only [Fintype.card_fin] at h_card
  omega

/-- For any two plaquettes `q₁, q₂ ≠ p` (`L ≥ 3`), the product of their characters with
`halfTraceRe (plaquetteHolonomy U p)` integrates to `0` on `gaugeHaarMeasure L`. -/
theorem integral_gaugeHaarMeasure_plaquetteHolonomy_mul_mul_eq_zero_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) {q₁ q₂ p : Plaquette L}
    (hq₁ : q₁ ≠ p) (hq₂ : q₂ ≠ p) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U q₁) *
        halfTraceRe (plaquetteHolonomy U q₂) *
        halfTraceRe (plaquetteHolonomy U p)
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  let Q : Fin 2 → Plaquette L := ![q₁, q₂]
  have hQ : ∀ j : Fin 2, Q j ≠ p := by
    intro j; fin_cases j <;> [exact hq₁; exact hq₂]
  obtain ⟨k, hk⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL p (by decide) Q hQ
  have hk1 : plaquetteLinkAt p k ∉ plaquetteLinks q₁ := hk 0
  have hk2 : plaquetteLinkAt p k ∉ plaquetteLinks q₂ := hk 1
  have h_cont :
      Continuous (fun U : GaugeConfig L =>
        halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂)) :=
    (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))
  refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
    hL2 p (plaquetteLinkAt p k) (plaquetteLinkAt_mem_plaquetteLinks p k) _ h_cont (fun U g => ?_)
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ hk1 g,
      plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ hk2 g]

/-- Full-torus 3-plaquette character vanishing (`L ≥ 3`):
for ALL triples of plaquettes `q₁, q₂, p : Plaquette L` (whether distinct or coinciding),
`∫ U, halfTraceRe (U_{q₁}) * halfTraceRe (U_{q₂}) * halfTraceRe (U_p) ∂(gaugeHaarMeasure L) = 0`.
When `q₁ ≠ p` and `q₂ ≠ p`, this follows from the 2-plaquette boundary-link coverage bound;
when `q₁ = p` or `q₂ = p`, it follows from single-link center-twist parity (`twistLinkNegOne`). -/
theorem integral_gaugeHaarMeasure_plaquetteHolonomy_triple_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (q₁ q₂ p : Plaquette L) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U q₁) *
        halfTraceRe (plaquetteHolonomy U q₂) *
        halfTraceRe (plaquetteHolonomy U p)
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  by_cases h1 : q₁ = p
  · subst h1
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₁)) =
        fun U : GaugeConfig L =>
          (halfTraceRe (plaquetteHolonomy U q₁)) ^ 2 * halfTraceRe (plaquetteHolonomy U q₂) := by
      funext U; ring
    rw [h_pt]
    exact integral_gaugeHaarMeasure_sq_mul_plaquetteHolonomy_eq_zero hL2 q₁ q₂
  · by_cases h2 : q₂ = p
    · subst h2
      have h_pt :
          (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₂)) =
          fun U : GaugeConfig L =>
            (halfTraceRe (plaquetteHolonomy U q₂)) ^ 2 * halfTraceRe (plaquetteHolonomy U q₁) := by
        funext U; ring
      rw [h_pt]
      exact integral_gaugeHaarMeasure_sq_mul_plaquetteHolonomy_eq_zero hL2 q₂ q₁
    · exact integral_gaugeHaarMeasure_plaquetteHolonomy_mul_mul_eq_zero_of_ne hL h1 h2

/-- Full-torus degree-1 two-probe vanishing (`L ≥ 3`):
for every plaquette `q : Plaquette L`,
`∫ U, halfTraceRe (plaquetteHolonomy U q) * (fΘ U * fp U) ∂(gaugeHaarMeasure L) = 0`,
and summing over `q : Plaquette L` gives `∫ U, totalCharacterSum U * (fΘ U * fp U) ∂(gaugeHaarMeasure L) = 0`. -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_mul_probes_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    (∀ q : Plaquette L,
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q) * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) = 0) ∧
    (∫ U : GaugeConfig L, totalCharacterSum U * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) = 0 := by
  let fΘ : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  let fp : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  have h_each (q : Plaquette L) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q) * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L => halfTraceRe (plaquetteHolonomy U q) * (fΘ U * fp U)) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      dsimp [fΘ, fp]
      rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U,
          mul_assoc]
    rw [h_pt]
    exact integral_gaugeHaarMeasure_plaquetteHolonomy_triple_eq_zero hL q
      (cubeBottomPlaquette L) (cubeTopPlaquette L)
  refine ⟨h_each, ?_⟩
  have h_sum :
      (fun U : GaugeConfig L => totalCharacterSum U * (fΘ U * fp U)) =
      fun U : GaugeConfig L =>
        ∑ q : Plaquette L, halfTraceRe (plaquetteHolonomy U q) * (fΘ U * fp U) := by
    funext U
    unfold totalCharacterSum
    exact Finset.sum_mul _ _ _
  rw [h_sum, integral_finsetSum]
  · simp_rw [h_each, Finset.sum_const_zero]
  · intro q _
    have h_cont :
        Continuous (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q) * (fΘ U * fp U)) :=
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q)).mul
        ((continuous_physicalWilsonLoop L ((1 : ℚ) : ℝ)
          (canonicalSpatialProbe 1 one_pos).timeReflect).mul
          (continuous_physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)))
    exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

/-- Full-torus degree-2 one-plaquette expectation vanishing (`L ≥ 3`):
for every plaquette `p : Plaquette L`, `∫ U, (totalCharacterSum U) ^ 2 * halfTraceRe (U_p) = 0`. -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_sq_mul_plaquetteHolonomy_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (p : Plaquette L) :
    (∫ U : GaugeConfig L,
      (totalCharacterSum U) ^ 2 * halfTraceRe (plaquetteHolonomy U p)
      ∂(gaugeHaarMeasure L)) = 0 := by
  have h_inner (q₁ : Plaquette L) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q₁) *
          totalCharacterSum U *
          halfTraceRe (plaquetteHolonomy U p)
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            totalCharacterSum U *
            halfTraceRe (plaquetteHolonomy U p)) =
        fun U : GaugeConfig L =>
          ∑ q₂ : Plaquette L,
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U p) := by
      funext U
      unfold totalCharacterSum
      rw [Finset.mul_sum, Finset.sum_mul]
    rw [h_pt, integral_finsetSum]
    · simp_rw [integral_gaugeHaarMeasure_plaquetteHolonomy_triple_eq_zero hL q₁ _ p,
        Finset.sum_const_zero]
    · intro q₂ _
      have h_cont :
          Continuous (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U p)) :=
        ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p))
      exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_outer :
      (fun U : GaugeConfig L =>
        (totalCharacterSum U) ^ 2 * halfTraceRe (plaquetteHolonomy U p)) =
      fun U : GaugeConfig L =>
        ∑ q₁ : Plaquette L,
          halfTraceRe (plaquetteHolonomy U q₁) *
            totalCharacterSum U *
            halfTraceRe (plaquetteHolonomy U p) := by
    funext U
    rw [sq]
    conv_lhs => lhs; lhs; unfold totalCharacterSum
    rw [Finset.sum_mul, Finset.sum_mul]
  rw [h_outer, integral_finsetSum]
  · simp_rw [h_inner, Finset.sum_const_zero]
  · intro q₁ _
    have h_cont :
        Continuous (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            totalCharacterSum U *
            halfTraceRe (plaquetteHolonomy U p)) :=
      ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        continuous_totalCharacterSum).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p))
    exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

/-- Full-torus degree-2 one-point probe vanishing and degree-3 partition moment vanishing (`L ≥ 3`):
`∫ U, (totalCharacterSum U) ^ 2 * fΘ U = 0`, `∫ U, (totalCharacterSum U) ^ 2 * fp U = 0`,
and `∫ U, (totalCharacterSum U) ^ 3 = 0`. -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_sq_single_probes_and_cube_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 2 * fΘ U ∂(gaugeHaarMeasure L)) = 0 ∧
    (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 2 * fp U ∂(gaugeHaarMeasure L)) = 0 ∧
    (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 3 ∂(gaugeHaarMeasure L)) = 0 := by
  dsimp only
  refine ⟨?_, ?_, ?_⟩
  · have h_eq :
        (fun U : GaugeConfig L =>
          (totalCharacterSum U) ^ 2 *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) =
        fun U : GaugeConfig L =>
          (totalCharacterSum U) ^ 2 * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      funext U
      rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U]
    rw [h_eq]
    exact integral_gaugeHaarMeasure_totalCharacterSum_sq_mul_plaquetteHolonomy_eq_zero hL _
  · have h_eq :
        (fun U : GaugeConfig L =>
          (totalCharacterSum U) ^ 2 *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) =
        fun U : GaugeConfig L =>
          (totalCharacterSum U) ^ 2 * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      rw [physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    rw [h_eq]
    exact integral_gaugeHaarMeasure_totalCharacterSum_sq_mul_plaquetteHolonomy_eq_zero hL _
  · have h_pt :
        (fun U : GaugeConfig L => (totalCharacterSum U) ^ 3) =
        fun U : GaugeConfig L =>
          ∑ p : Plaquette L,
            (totalCharacterSum U) ^ 2 * halfTraceRe (plaquetteHolonomy U p) := by
      funext U
      have h_pow : (totalCharacterSum U) ^ 3 = (totalCharacterSum U) ^ 2 * totalCharacterSum U := by
        ring
      rw [h_pow]
      conv_lhs => rhs; unfold totalCharacterSum
      exact Finset.mul_sum _ _ _
    rw [h_pt, integral_finsetSum]
    · simp_rw [integral_gaugeHaarMeasure_totalCharacterSum_sq_mul_plaquetteHolonomy_eq_zero hL,
        Finset.sum_const_zero]
    · intro p _
      have h_cont :
          Continuous (fun U : GaugeConfig L =>
            (totalCharacterSum U) ^ 2 * halfTraceRe (plaquetteHolonomy U p)) :=
        (continuous_totalCharacterSum.pow 2).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p))
      exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

/-- For any three plaquettes `q₁, q₂, q₃ ≠ p` (`L ≥ 3`), the product of their characters with
`halfTraceRe (plaquetteHolonomy U p)` integrates to `0` on `gaugeHaarMeasure L`. -/
theorem integral_gaugeHaarMeasure_plaquetteHolonomy_mul_mul_mul_eq_zero_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) {q₁ q₂ q₃ p : Plaquette L}
    (hq₁ : q₁ ≠ p) (hq₂ : q₂ ≠ p) (hq₃ : q₃ ≠ p) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U q₁) *
        halfTraceRe (plaquetteHolonomy U q₂) *
        halfTraceRe (plaquetteHolonomy U q₃) *
        halfTraceRe (plaquetteHolonomy U p)
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  let Q : Fin 3 → Plaquette L := ![q₁, q₂, q₃]
  have hQ : ∀ j : Fin 3, Q j ≠ p := by
    intro j; fin_cases j <;> [exact hq₁; exact hq₂; exact hq₃]
  obtain ⟨k, hk⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL p le_rfl Q hQ
  have hk1 : plaquetteLinkAt p k ∉ plaquetteLinks q₁ := hk 0
  have hk2 : plaquetteLinkAt p k ∉ plaquetteLinks q₂ := hk 1
  have hk3 : plaquetteLinkAt p k ∉ plaquetteLinks q₃ := hk 2
  have h_cont :
      Continuous (fun U : GaugeConfig L =>
        halfTraceRe (plaquetteHolonomy U q₁) *
          halfTraceRe (plaquetteHolonomy U q₂) *
          halfTraceRe (plaquetteHolonomy U q₃)) :=
    ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃))
  refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
    hL2 p (plaquetteLinkAt p k) (plaquetteLinkAt_mem_plaquetteLinks p k) _ h_cont (fun U g => ?_)
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ hk1 g,
      plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ hk2 g,
      plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ hk3 g]

theorem cubeBottomPlaquette_ne_cubeTopPlaquette {L : ℕ} (hL : 2 ≤ L) :
    cubeBottomPlaquette L ≠ cubeTopPlaquette L := by
  intro h
  have hx0 : (cubeBottomPlaquette L).x 0 = (cubeTopPlaquette L).x 0 :=
    congrFun (congrArg Plaquette.x h) 0
  exact neg_one_ne_zero_of_two_le hL (by simpa [cubeBottomPlaquette, cubeTopPlaquette, cubeBottomBase, unitVec] using hx0)

theorem integral_gaugeHaarMeasure_probes_sq_eq_sixteenth
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L,
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
        (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2
      ∂(gaugeHaarMeasure L)) = 1 / 16 := by
  have h_cont :
      Continuous (fun U : GaugeConfig L =>
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
          (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2) :=
    ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))).pow 2).mul
      ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))).pow 2)
  have he : (⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ : Link L) ∈
      plaquetteLinks (cubeTopPlaquette L) := by
    simp [plaquetteLinks]
  rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
      ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ _ h_cont]
  have h_inner (U : GaugeConfig L) :
      (∫ g : SU2,
        (halfTraceRe (plaquetteHolonomy
          (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
          (cubeBottomPlaquette L))) ^ 2 *
        (halfTraceRe (plaquetteHolonomy
          (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
          (cubeTopPlaquette L))) ^ 2
        ∂SU2.haarProbability) =
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 * (1 / 4) := by
    simp_rw [plaquetteHolonomy_cubeBottomPlaquette_update_of_time_zero
      hL U (cubeTopPlaquette L).x rfl (cubeTopPlaquette L).μ]
    rw [integral_const_mul,
        integral_plaquetteHolonomy_sq_update_eq_quarter_of_mem_plaquetteLinks hL U (cubeTopPlaquette L) he]
  simp_rw [h_inner, integral_mul_const]
  have h_bot_sq :
      (∫ U : GaugeConfig L,
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2
        ∂(gaugeHaarMeasure L)) = 1 / 4 := by
    have h := integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL
      (cubeBottomPlaquette L) (cubeBottomPlaquette L)
    simp only [↓reduceIte] at h
    have h_pt :
        (fun U : GaugeConfig L =>
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      funext U; ring
    rw [h_pt, h]
  rw [h_bot_sq]
  norm_num

/-- Full-torus degree-2 two-probe localization (`L ≥ 3`):
for any pair of plaquettes `q₁, q₂ : Plaquette L`, the two-probe integral
`∫ U, halfTraceRe (U_{q₁}) * halfTraceRe (U_{q₂}) * (fΘ U * fp U) ∂(gaugeHaarMeasure L)`
equals `1 / 16` if `{q₁, q₂} = {cubeBottomPlaquette L, cubeTopPlaquette L}` and `0` otherwise. -/
theorem integral_gaugeHaarMeasure_plaquetteHolonomy_pair_mul_probes_eq_ite
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (q₁ q₂ : Plaquette L) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U q₁) *
        halfTraceRe (plaquetteHolonomy U q₂) *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
      ∂(gaugeHaarMeasure L)) =
      if (q₁ = cubeBottomPlaquette L ∧ q₂ = cubeTopPlaquette L) ∨
          (q₁ = cubeTopPlaquette L ∧ q₂ = cubeBottomPlaquette L) then
        1 / 16
      else
        0 := by
  have hL2 : 2 ≤ L := by omega
  have h_bot_ne_top : cubeBottomPlaquette L ≠ cubeTopPlaquette L :=
    cubeBottomPlaquette_ne_cubeTopPlaquette hL2
  split_ifs with h_pair
  · rcases h_pair with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · have h_pt :
          (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
          fun U : GaugeConfig L =>
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
              (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 := by
        funext U; ring
      rw [h_pt]
      exact integral_gaugeHaarMeasure_probes_sq_eq_sixteenth hL2
    · have h_pt :
          (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
          fun U : GaugeConfig L =>
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
              (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 := by
        funext U; ring
      rw [h_pt]
      exact integral_gaugeHaarMeasure_probes_sq_eq_sixteenth hL2
  · by_cases h1_top : q₁ = cubeTopPlaquette L
    · subst h1_top
      have h2_bot : q₂ ≠ cubeBottomPlaquette L := fun h2 =>
        h_pair (Or.inr ⟨rfl, h2⟩)
      have h_pt :
          (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
          fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
        funext U; ring
      rw [h_pt]
      exact integral_gaugeHaarMeasure_plaquetteHolonomy_mul_mul_mul_eq_zero_of_ne
        hL h_bot_ne_top.symm h2_bot h_bot_ne_top.symm
    · by_cases h2_top : q₂ = cubeTopPlaquette L
      · subst h2_top
        have h1_bot : q₁ ≠ cubeBottomPlaquette L := fun h1 =>
          h_pair (Or.inl ⟨h1, rfl⟩)
        have h_pt :
            (fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U q₁) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
            fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U q₁) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
          funext U; ring
        rw [h_pt]
        exact integral_gaugeHaarMeasure_plaquetteHolonomy_mul_mul_mul_eq_zero_of_ne
          hL h1_bot h_bot_ne_top.symm h_bot_ne_top.symm
      · exact integral_gaugeHaarMeasure_plaquetteHolonomy_mul_mul_mul_eq_zero_of_ne
          hL h1_top h2_top h_bot_ne_top

/-- Full-torus degree-2 two-probe expectation and exact connected cancellation (`L ≥ 3`):
on the full 4D torus `Plaquette L`, `∫ U, (totalCharacterSum U) ^ 2 * (fΘ U * fp U) ∂(gaugeHaarMeasure L) = 1 / 8`,
and the degree-2 Taylor coefficient `(1 / 2) * ∫ (totalCharacterSum ^ 2 * fΘ * fp) = 1 / 16`
cancels identically against the product `(∫ totalCharacterSum * fΘ) * (∫ totalCharacterSum * fp) = (1 / 4) * (1 / 4)`
in the connected Gibbs covariance numerator. -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_sq_mul_probes_and_connected_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 2 * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) = 1 / 8 ∧
    (1 / 2 : ℝ) *
        (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 2 * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) -
      (∫ U : GaugeConfig L, totalCharacterSum U * fΘ U ∂(gaugeHaarMeasure L)) *
        (∫ U' : GaugeConfig L, totalCharacterSum U' * fp U' ∂(gaugeHaarMeasure L)) = 0 := by
  let fΘ : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
  let fp : GaugeConfig L → ℝ :=
    physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
  have hL2 : 2 ≤ L := by omega
  have h_bot_ne_top : cubeBottomPlaquette L ≠ cubeTopPlaquette L :=
    cubeBottomPlaquette_ne_cubeTopPlaquette hL2
  have h_inner (q₁ : Plaquette L) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q₁) *
          totalCharacterSum U *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) =
        if q₁ = cubeBottomPlaquette L then 1 / 16
        else if q₁ = cubeTopPlaquette L then 1 / 16
        else 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            totalCharacterSum U *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
        fun U : GaugeConfig L =>
          ∑ q₂ : Plaquette L,
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      unfold totalCharacterSum
      rw [Finset.mul_sum, Finset.sum_mul, Finset.sum_mul]
    rw [h_pt, integral_finsetSum]
    · simp_rw [integral_gaugeHaarMeasure_plaquetteHolonomy_pair_mul_probes_eq_ite hL q₁]
      by_cases hq1_bot : q₁ = cubeBottomPlaquette L
      · subst hq1_bot
        have h_ite (q₂ : Plaquette L) :
            (if (cubeBottomPlaquette L = cubeBottomPlaquette L ∧ q₂ = cubeTopPlaquette L) ∨
                (cubeBottomPlaquette L = cubeTopPlaquette L ∧ q₂ = cubeBottomPlaquette L) then
              (1 / 16 : ℝ)
            else 0) = if q₂ = cubeTopPlaquette L then 1 / 16 else 0 := by
          by_cases hq2 : q₂ = cubeTopPlaquette L <;> simp [hq2, h_bot_ne_top]
        rw [Finset.sum_congr rfl (fun q₂ _ => h_ite q₂)]
        simp
      · by_cases hq1_top : q₁ = cubeTopPlaquette L
        · subst hq1_top
          have h_ite (q₂ : Plaquette L) :
              (if (cubeTopPlaquette L = cubeBottomPlaquette L ∧ q₂ = cubeTopPlaquette L) ∨
                  (cubeTopPlaquette L = cubeTopPlaquette L ∧ q₂ = cubeBottomPlaquette L) then
                (1 / 16 : ℝ)
              else 0) = if q₂ = cubeBottomPlaquette L then 1 / 16 else 0 := by
            by_cases hq2 : q₂ = cubeBottomPlaquette L <;> simp [hq2, h_bot_ne_top.symm]
          rw [Finset.sum_congr rfl (fun q₂ _ => h_ite q₂)]
          simp [h_bot_ne_top.symm]
        · have h_ite (q₂ : Plaquette L) :
              (if (q₁ = cubeBottomPlaquette L ∧ q₂ = cubeTopPlaquette L) ∨
                  (q₁ = cubeTopPlaquette L ∧ q₂ = cubeBottomPlaquette L) then
                (1 / 16 : ℝ)
              else 0) = 0 := by
            simp [hq1_bot, hq1_top]
          rw [Finset.sum_congr rfl (fun q₂ _ => h_ite q₂)]
          simp [hq1_bot, hq1_top]
    · intro q₂ _
      have h_cont :
          Continuous (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
        (((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L)))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L)))
      exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_sq_probes :
      (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 2 * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) = 1 / 8 := by
    have h_outer :
        (fun U : GaugeConfig L => (totalCharacterSum U) ^ 2 * (fΘ U * fp U)) =
        fun U : GaugeConfig L =>
          ∑ q₁ : Plaquette L,
            halfTraceRe (plaquetteHolonomy U q₁) *
              totalCharacterSum U *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      dsimp [fΘ, fp]
      rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U,
          sq, ← mul_assoc]
      conv_lhs => lhs; lhs; lhs; unfold totalCharacterSum
      rw [Finset.sum_mul, Finset.sum_mul, Finset.sum_mul]
    rw [h_outer, integral_finsetSum]
    · simp_rw [h_inner]
      have h_split :
          (∑ x : Plaquette L,
            if x = cubeBottomPlaquette L then (1 / 16 : ℝ)
            else if x = cubeTopPlaquette L then 1 / 16
            else 0) =
          (∑ x : Plaquette L, if x = cubeBottomPlaquette L then (1 / 16 : ℝ) else 0) +
            (∑ x : Plaquette L, if x = cubeTopPlaquette L then (1 / 16 : ℝ) else 0) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        by_cases hx_bot : x = cubeBottomPlaquette L
        · subst hx_bot
          simp [h_bot_ne_top]
        · simp [hx_bot]
      rw [h_split]
      simp
      norm_num
    · intro q₁ _
      have h_cont :
          Continuous (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U q₁) *
              totalCharacterSum U *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
        (((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
          continuous_totalCharacterSum).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L)))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L)))
      exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  refine ⟨h_sq_probes, ?_⟩
  rw [h_sq_probes,
      (integral_gaugeHaarMeasure_totalCharacterSum_single_probes_eq_quarter hL2).1,
      (integral_gaugeHaarMeasure_totalCharacterSum_single_probes_eq_quarter hL2).2]
  norm_num

theorem time_coord_of_mem_plaquetteLinks_cubeTopPlaquette {L : ℕ}
    {e : Link L} (he : e ∈ plaquetteLinks (cubeTopPlaquette L)) :
    e.x 0 = 0 := by
  simp only [plaquetteLinks, cubeTopPlaquette, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl <;> simp [shift, unitVec]

theorem time_coord_of_mem_plaquetteLinks_cubeBottomPlaquette {L : ℕ}
    {e : Link L} (he : e ∈ plaquetteLinks (cubeBottomPlaquette L)) :
    e.x 0 = -1 := by
  simp only [plaquetteLinks, cubeBottomPlaquette, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl <;> simp [shift, cubeBottomBase, unitVec]

theorem not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette
    {L : ℕ} (hL : 2 ≤ L) {e : Link L} (he : e ∈ plaquetteLinks (cubeTopPlaquette L)) :
    e ∉ plaquetteLinks (cubeBottomPlaquette L) := by
  intro h_bot
  have h0 := time_coord_of_mem_plaquetteLinks_cubeTopPlaquette he
  have h1 := time_coord_of_mem_plaquetteLinks_cubeBottomPlaquette h_bot
  exact neg_one_ne_zero_of_two_le hL (h1.symm.trans h0)

theorem not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette
    {L : ℕ} (hL : 2 ≤ L) {e : Link L} (he : e ∈ plaquetteLinks (cubeBottomPlaquette L)) :
    e ∉ plaquetteLinks (cubeTopPlaquette L) := fun h_top =>
  not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL h_top he

/-- Full-torus degree-3 two-probe vanishing (`L ≥ 3`):
for ALL triples of plaquettes `q₁, q₂, q₃ : Plaquette L`,
`∫ U, halfTraceRe (U_{q₁}) * halfTraceRe (U_{q₂}) * halfTraceRe (U_{q₃}) * (fΘ U * fp U) ∂(gaugeHaarMeasure L) = 0`.
Proof:
- If `cubeTopPlaquette L ∉ {q₁, q₂, q₃}`, then `{q₁, q₂, q₃}` cover at most 3 of the 4 boundary links
  of `cubeTopPlaquette L`, and `cubeBottomPlaquette L` shares 0 links with `cubeTopPlaquette L`.
- Symmetrically if `cubeBottomPlaquette L ∉ {q₁, q₂, q₃}`.
- If both `cubeBottomPlaquette L` and `cubeTopPlaquette L` lie in `{q₁, q₂, q₃}`, the integrand has
  the form `fΘ(U) ^ 2 * fp(U) ^ 2 * halfTraceRe (U_r)`, which vanishes by single-link center-twist
  parity (`integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero`). -/
theorem integral_gaugeHaarMeasure_plaquetteHolonomy_triple_mul_probes_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (q₁ q₂ q₃ : Plaquette L) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U q₁) *
        halfTraceRe (plaquetteHolonomy U q₂) *
        halfTraceRe (plaquetteHolonomy U q₃) *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  have h_bot_ne_top : cubeBottomPlaquette L ≠ cubeTopPlaquette L :=
    cubeBottomPlaquette_ne_cubeTopPlaquette hL2
  by_cases h_top : q₁ = cubeTopPlaquette L ∨ q₂ = cubeTopPlaquette L ∨ q₃ = cubeTopPlaquette L
  · by_cases h_bot :
        q₁ = cubeBottomPlaquette L ∨ q₂ = cubeBottomPlaquette L ∨ q₃ = cubeBottomPlaquette L
    · rcases h_top with rfl | rfl | rfl <;> rcases h_bot with h_b | h_b | h_b
      · exfalso; exact h_bot_ne_top h_b.symm
      · subst h_b
        have h_pt :
            (fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U q₃) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
            fun U : GaugeConfig L =>
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
                (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
                halfTraceRe (plaquetteHolonomy U q₃) := by
          funext U; ring
        rw [h_pt]
        exact integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero hL2 _ _ _
      · subst h_b
        have h_pt :
            (fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U q₂) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
            fun U : GaugeConfig L =>
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
                (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
                halfTraceRe (plaquetteHolonomy U q₂) := by
          funext U; ring
        rw [h_pt]
        exact integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero hL2 _ _ _
      · subst h_b
        have h_pt :
            (fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U q₃) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
            fun U : GaugeConfig L =>
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
                (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
                halfTraceRe (plaquetteHolonomy U q₃) := by
          funext U; ring
        rw [h_pt]
        exact integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero hL2 _ _ _
      · exfalso; exact h_bot_ne_top h_b.symm
      · subst h_b
        have h_pt :
            (fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U q₁) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
            fun U : GaugeConfig L =>
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
                (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
                halfTraceRe (plaquetteHolonomy U q₁) := by
          funext U; ring
        rw [h_pt]
        exact integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero hL2 _ _ _
      · subst h_b
        have h_pt :
            (fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U q₂) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
            fun U : GaugeConfig L =>
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
                (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
                halfTraceRe (plaquetteHolonomy U q₂) := by
          funext U; ring
        rw [h_pt]
        exact integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero hL2 _ _ _
      · subst h_b
        have h_pt :
            (fun U : GaugeConfig L =>
              halfTraceRe (plaquetteHolonomy U q₁) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
            fun U : GaugeConfig L =>
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
                (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
                halfTraceRe (plaquetteHolonomy U q₁) := by
          funext U; ring
        rw [h_pt]
        exact integral_gaugeHaarMeasure_sq_mul_sq_mul_plaquetteHolonomy_eq_zero hL2 _ _ _
      · exfalso; exact h_bot_ne_top h_b.symm
    · have hq₁ : q₁ ≠ cubeBottomPlaquette L := fun h => h_bot (Or.inl h)
      have hq₂ : q₂ ≠ cubeBottomPlaquette L := fun h => h_bot (Or.inr (Or.inl h))
      have hq₃ : q₃ ≠ cubeBottomPlaquette L := fun h => h_bot (Or.inr (Or.inr h))
      let Q : Fin 3 → Plaquette L := ![q₁, q₂, q₃]
      have hQ : ∀ j : Fin 3, Q j ≠ cubeBottomPlaquette L := by
        intro j; fin_cases j <;> [exact hq₁; exact hq₂; exact hq₃]
      obtain ⟨k, hk⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL (cubeBottomPlaquette L) le_rfl Q hQ
      have hk1 : plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks q₁ := hk 0
      have hk2 : plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks q₂ := hk 1
      have hk3 : plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks q₃ := hk 2
      have hk_top : plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks (cubeTopPlaquette L) :=
        not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL2
          (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)
      have h_pt :
          (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U q₁) *
