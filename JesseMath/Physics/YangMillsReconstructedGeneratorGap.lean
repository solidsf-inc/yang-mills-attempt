    _ = ((probeTouchPlaquettes L).card : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
    _ ≤ 48 := h_card

noncomputable def probeExteriorBoltzmannWeight {L : ℕ} [NeZero L] (β : ℝ) (U : GaugeConfig L) : ℝ :=
  Real.exp (β * probeExteriorCharacterSum U)

noncomputable def probeExteriorPartition (L : ℕ) [NeZero L] (β : ℝ) : ℝ :=
  ∫ U : GaugeConfig L, probeExteriorBoltzmannWeight β U ∂(gaugeHaarMeasure L)

@[continuity, fun_prop]
theorem continuous_probeExteriorBoltzmannWeight {L : ℕ} [NeZero L] (β : ℝ) :
