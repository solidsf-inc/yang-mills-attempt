theorem abs_sideBridge_sub_beta_latChar_le
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) {β : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912)
    (k : Fin 4) (U : GaugeConfig L) :
    let _ : Unit := ()
    |sideBridge L β k U - β * latChar L k U| ≤ 85 * β ^ 2 ∧
    |sideBridge L β k U| ≤ (51 / 50 : ℝ) * β ∧
    |(sideBridge L β k U +
        sideBridge L β k (twistLinkNegOne (plaquetteLinkAt (cubeBottomPlaquette L) k) U)) / 2| ≤
      85 * β ^ 2 ∧
    |(sideBridge L β k U +
        sideBridge L β k (twistLinkNegOne (plaquetteLinkAt (cubeTopPlaquette L) k) U)) / 2| ≤
      85 * β ^ 2 := by
  have hL2 : 2 ≤ L := by omega
  have h_core (V : GaugeConfig L) : |sideBridge L β k V - β * latChar L k V| ≤ 85 * β ^ 2 := by
    let x := latChar L k V
    let yB := botWingCharSum L k V
    let yT := topWingCharSum L k V
    have hx := abs_le.mp (abs_latChar_le_one k V)
    have hyB := abs_le.mp (abs_botWingCharSum_le_four k V)
    have hyT := abs_le.mp (abs_topWingCharSum_le_four k V)
    have hu_all : |β * (x + yB + yT)| ≤ 9 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]
      have : |x + yB + yT| ≤ 9 := abs_le.mpr ⟨by linarith, by linarith⟩
      nlinarith
    have huB : |β * yB| ≤ 4 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]
      have : |yB| ≤ 4 := abs_botWingCharSum_le_four k V
      nlinarith
    have huT : |β * yT| ≤ 4 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]
      have : |yT| ≤ 4 := abs_topWingCharSum_le_four k V
      nlinarith
    have hr_all := abs_exp_sub_one_sub_self_le (by linarith : |β * (x + yB + yT)| ≤ 1)
    have hrB := abs_exp_sub_one_sub_self_le (by linarith : |β * yB| ≤ 1)
    have hrT := abs_exp_sub_one_sub_self_le (by linarith : |β * yT| ≤ 1)
    have hsq_all : (β * (x + yB + yT)) ^ 2 ≤ (9 * β) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu_all 2
    have hsqB : (β * yB) ^ 2 ≤ (4 * β) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) huB 2
    have hsqT : (β * yT) ^ 2 ≤ (4 * β) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) huT 2
    have h_id :
        sideBridge L β k V - β * x =
          (Real.exp (β * (x + yB + yT)) - (1 + β * (x + yB + yT))) -
            (Real.exp (β * yB) - (1 + β * yB)) -
            (Real.exp (β * yT) - (1 + β * yT)) := by
      unfold sideBridge sideWeight
      dsimp only [x, yB, yT]
      ring
    change |sideBridge L β k V - β * x| ≤ 85 * β ^ 2
    rw [h_id]
    have h1 := abs_le.mp hr_all
    have h2 := abs_le.mp hrB
    have h3 := abs_le.mp hrT
    exact abs_le.mpr ⟨by nlinarith, by nlinarith⟩
  have h1 := h_core U
  have h2 : |sideBridge L β k U| ≤ (51 / 50 : ℝ) * β := by
    have hx := abs_le.mp (abs_latChar_le_one k U)
    have h1' := abs_le.mp h1
    have hβ_sq : β ^ 2 ≤ (1 / 6912 : ℝ) * β := by nlinarith
    exact abs_le.mpr ⟨by nlinarith, by nlinarith⟩
  have h3 :
      |(sideBridge L β k U +
          sideBridge L β k (twistLinkNegOne (plaquetteLinkAt (cubeBottomPlaquette L) k) U)) / 2| ≤
        85 * β ^ 2 := by
    let U' := twistLinkNegOne (plaquetteLinkAt (cubeBottomPlaquette L) k) U
    have h_tw : latChar L k U' = - latChar L k U := latChar_twist_bottom_same hL2 k U
    have h_eq :
        (sideBridge L β k U + sideBridge L β k U') / 2 =
          ((sideBridge L β k U - β * latChar L k U) +
            (sideBridge L β k U' - β * latChar L k U')) / 2 := by
      rw [h_tw]; ring
    rw [h_eq]
    have ha := abs_le.mp (h_core U)
    have hb := abs_le.mp (h_core U')
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have h4 :
      |(sideBridge L β k U +
          sideBridge L β k (twistLinkNegOne (cubeTopPlaquette L |> fun p => plaquetteLinkAt p k) U)) / 2| ≤
        85 * β ^ 2 := by
    let U' := twistLinkNegOne (plaquetteLinkAt (cubeTopPlaquette L) k) U
    have h_tw : latChar L k U' = - latChar L k U := latChar_twist_top_same hL2 k U
    have h_eq :
        (sideBridge L β k U + sideBridge L β k U') / 2 =
          ((sideBridge L β k U - β * latChar L k U) +
            (sideBridge L β k U' - β * latChar L k U')) / 2 := by
      rw [h_tw]; ring
    rw [h_eq]
    have ha := abs_le.mp (h_core U)
    have hb := abs_le.mp (h_core U')
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  exact ⟨h1, h2, h3, h4⟩

theorem abs_centeredFactor_sub_self_le
    {β : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912) {s : ℝ} (hs : |s| ≤ 1) :
    let c := su2CharMean β
    |(s - c) * Real.exp (β * s) - s| ≤ 3 * β ∧
    |β * s ^ 2 - c| ≤ 3 * β ∧
    |(s - c) * Real.exp (β * s) - s - (β * s ^ 2 - c)| ≤ 3 * β ^ 2 := by
  intro c
  have hβ1 : β ≤ 1 := by linarith
  have hc_le : |c| ≤ (7 / 4 : ℝ) * β := (abs_su2CharExp1_and_su2CharMean_le hβ0 hβ1).2
  have hs' := abs_le.mp hs
  have hc' := abs_le.mp hc_le
  have hs_sq : s ^ 2 ≤ 1 := by nlinarith [hs'.1, hs'.2]
  have hs_sq_nonneg : 0 ≤ s ^ 2 := sq_nonneg s
  have hu : |β * s| ≤ β := by rw [abs_mul, abs_of_nonneg hβ0]; nlinarith
  have hu1 : |β * s| ≤ 1 := by linarith
  have heb1 := abs_exp_sub_one_le_of_abs_le_one hu1
  have heb2 := abs_exp_sub_one_sub_self_le hu1
  have hsq : (β * s) ^ 2 ≤ β ^ 2 := by rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
  have heb1_le : |Real.exp (β * s) - 1| ≤ (5 / 4 : ℝ) * β := by nlinarith
  have heb2_le : |Real.exp (β * s) - (1 + β * s)| ≤ (3 / 4 : ℝ) * β ^ 2 := by nlinarith
  have h_id :
      (s - c) * Real.exp (β * s) - s - (β * s ^ 2 - c) =
        s * (Real.exp (β * s) - (1 + β * s)) - c * (Real.exp (β * s) - 1) := by ring
  have h_rem : |(s - c) * Real.exp (β * s) - s - (β * s ^ 2 - c)| ≤ 3 * β ^ 2 := by
    rw [h_id]
    have h_s_mul : |s * (Real.exp (β * s) - (1 + β * s))| ≤ (3 / 4 : ℝ) * β ^ 2 := by
      rw [abs_mul]
      calc
        |s| * |Real.exp (β * s) - (1 + β * s)| ≤ 1 * ((3 / 4 : ℝ) * β ^ 2) :=
          mul_le_mul hs heb2_le (abs_nonneg _) zero_le_one
        _ = (3 / 4 : ℝ) * β ^ 2 := one_mul _
    have h_c_mul : |c * (Real.exp (β * s) - 1)| ≤ (35 / 16 : ℝ) * β ^ 2 := by
      rw [abs_mul]
      calc
        |c| * |Real.exp (β * s) - 1| ≤ ((7 / 4 : ℝ) * β) * ((5 / 4 : ℝ) * β) :=
          mul_le_mul hc_le heb1_le (abs_nonneg _) (by positivity)
        _ = (35 / 16 : ℝ) * β ^ 2 := by ring
    have ha := abs_le.mp h_s_mul
    have hb := abs_le.mp h_c_mul
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have h_quad : |β * s ^ 2 - c| ≤ (11 / 4 : ℝ) * β :=
    abs_le.mpr ⟨by nlinarith, by nlinarith⟩
  have h_quad3 : |β * s ^ 2 - c| ≤ 3 * β := by linarith
  have h_tot : |(s - c) * Real.exp (β * s) - s| ≤ 3 * β := by
    have ha := abs_le.mp h_rem
    have hb := abs_le.mp h_quad
    have hβ_sq : β ^ 2 ≤ (1 / 6912 : ℝ) * β := by nlinarith
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  exact ⟨h_tot, h_quad3, h_rem⟩

theorem integral_gaugeHaarMeasure_comp_twistLinkNegOne
    {L : ℕ} [NeZero L] (e₀ : Link L) (F : GaugeConfig L → ℝ) (hF : Continuous F) :
    (∫ U : GaugeConfig L, F (twistLinkNegOne e₀ U) ∂(gaugeHaarMeasure L)) =
      ∫ U : GaugeConfig L, F U ∂(gaugeHaarMeasure L) := by
  have h_meas : Measurable (twistLinkNegOne e₀) := (continuous_twistLinkNegOne e₀).measurable
  have h_aesm : AEStronglyMeasurable F (Measure.map (twistLinkNegOne e₀) (gaugeHaarMeasure L)) := by
    rw [(measurePreserving_twistLinkNegOne (L := L) e₀).map_eq]
    exact hF.aestronglyMeasurable
  rw [← integral_map h_meas.aemeasurable h_aesm,
      (measurePreserving_twistLinkNegOne (L := L) e₀).map_eq]

theorem integral_gaugeHaarMeasure_mul_eq_half_add_twistLinkNegOne
    {L : ℕ} [NeZero L] (e : Link L) {H F : GaugeConfig L → ℝ}
    (hH : Continuous H) (hF : Continuous F)
    (hH_inv : ∀ U : GaugeConfig L, H (twistLinkNegOne e U) = H U) :
    (∫ U : GaugeConfig L, H U * F U ∂(gaugeHaarMeasure L)) =
      ∫ U : GaugeConfig L, H U * ((F U + F (twistLinkNegOne e U)) / 2) ∂(gaugeHaarMeasure L) := by
  have hF_tw : Continuous (fun U => F (twistLinkNegOne e U)) :=
    hF.comp (continuous_twistLinkNegOne e)
  have h_tw :
      (∫ U : GaugeConfig L, H U * F (twistLinkNegOne e U) ∂(gaugeHaarMeasure L)) =
        ∫ U : GaugeConfig L, H U * F U ∂(gaugeHaarMeasure L) := by
    have h_comp := integral_gaugeHaarMeasure_comp_twistLinkNegOne e (fun U => H U * F U) (hH.mul hF)
    have h_pt : (fun U => H (twistLinkNegOne e U) * F (twistLinkNegOne e U)) =
        fun U => H U * F (twistLinkNegOne e U) := by
      funext U; rw [hH_inv U]
    rw [← h_pt, h_comp]
  have h_split :
      (fun U : GaugeConfig L => H U * ((F U + F (twistLinkNegOne e U)) / 2)) =
      fun U : GaugeConfig L => (1 / 2 : ℝ) * (H U * F U) + (1 / 2 : ℝ) * (H U * F (twistLinkNegOne e U)) := by
    funext U; ring
  rw [h_split,
