/-- Unconditional eventual nonnegativity of the probe reflected connected correlator
`∀ᶠ n in atTop, 0 ≤ reflectedConnected T.Z_tube n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩` whenever
`T.ℓ_probe` is time-commensurate with `T.ℓstar`. -/
theorem LandingTube.eventually_reflectedConnected_probe_nonneg_of_ellstar
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (h_probe_comm : IsTimeCommensurate (T.ℓstar : ℝ) T.ℓ_probe) :
    ∀ᶠ n in atTop, 0 ≤ reflectedConnected T.Z_tube n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩ := by
  apply T.eventually_reflectedConnected_self_nonneg_of_dyadic ⟨[T.ℓ_probe]⟩
  · intro ℓ hℓ
    simp only [List.mem_singleton] at hℓ
    subst hℓ
    exact T.hℓ_probe_pos
  · intro ℓ hℓ
    simp only [List.mem_singleton] at hℓ
    subst hℓ
    exact ⟨0, by simpa using h_probe_comm⟩

/-- Formal negative-control antiproof along any dyadic `LandingTube P`: it is **false** that
every positive-time physical rectangle `ℓ : PhysicalRectangle` (with arbitrary rational coordinates)
is eventually time-commensurate with the dyadic UV spacing `P.spacing n = T.ℓstar / 2 ^ (T.K n)`.
Specifically, `ℓ.base 0 = T.ℓstar / 3 > 0` would require `(2 : ℤ) ^ (T.K n) = 3 * k`, which is
impossible since `(2 ^ K) % 3 ≠ 0`. -/
theorem LandingTube.not_forall_positiveTime_eventually_isTimeCommensurate
    {P : ContinuumCutoffPath} (T : LandingTube P) :
    ¬ (∀ ℓ : PhysicalRectangle, ℓ.IsPositiveTime →
        ∀ᶠ n in atTop, IsTimeCommensurate (P.spacing n) ℓ) := by
  intro h_all
  let ℓ : PhysicalRectangle :=
    { base := fun _ => T.ℓstar / 3
      μ := 0
      ν := 1
      plane := by decide
      sideμ := 1
      sideν := 1
      sideμ_pos := by norm_num
      sideν_pos := by norm_num }
  have hpos : ℓ.IsPositiveTime := by
    unfold PhysicalRectangle.IsPositiveTime
    dsimp [ℓ]
    linarith [T.hℓstar]
  obtain ⟨n, hKn, ⟨⟨k, hk⟩, _⟩⟩ := (T.hK.and (h_all ℓ hpos)).exists
  dsimp [ℓ] at hk
  push_cast at hk
  have hℓ_pos : (0 : ℝ) < (T.ℓstar : ℝ) := Rat.cast_pos.mpr T.hℓstar
  have h_real : (2 : ℝ) ^ (T.K n) = 3 * (k : ℝ) := by
    have h_mul : (T.ℓstar : ℝ) * (2 : ℝ) ^ (T.K n) = 3 * (k : ℝ) * (T.ℓstar : ℝ) := by
      calc
        (T.ℓstar : ℝ) * (2 : ℝ) ^ (T.K n)
          = 3 * ((T.ℓstar : ℝ) / 3) * (2 : ℝ) ^ (T.K n) := by ring
        _ = 3 * ((k : ℝ) * P.spacing n) * (2 : ℝ) ^ (T.K n) := by rw [hk]
        _ = 3 * (k : ℝ) * (P.spacing n * (2 : ℝ) ^ (T.K n)) := by ring
        _ = 3 * (k : ℝ) * (T.ℓstar : ℝ) := by rw [hKn]
    exact mul_right_cancel₀ hℓ_pos.ne' (by linarith)
  have h_int : (2 : ℤ) ^ (T.K n) = 3 * k := by exact_mod_cast h_real
  have h_mod : ∀ m : ℕ, ((2 : ℤ) ^ m) % 3 = 1 ∨ ((2 : ℤ) ^ m) % 3 = 2 := by
    intro m
    induction m with
    | zero => decide
    | succ m ih =>
        rw [pow_succ, Int.mul_emod]
        rcases ih with h1 | h2
        · rw [h1]; decide
        · rw [h2]; decide
  have h_zero : ((2 : ℤ) ^ (T.K n)) % 3 = 0 := by
    rw [h_int, Int.mul_emod_right]
  rcases h_mod (T.K n) with h1 | h2 <;> omega

/-- Unconditional negative-control theorem on `dyadicOneLoopPath` (with zero `LandingTube` or
`BalabanMultiScaleUVToIRFlow` hypothesis): it is false that every positive-time physical rectangle
`ℓ : PhysicalRectangle` is eventually time-commensurate with `dyadicOneLoopPath.spacing n = (1 / 2) ^ n`. -/
theorem not_forall_positiveTime_eventually_isTimeCommensurate_dyadicOneLoopPath :
    ¬ (∀ ℓ : PhysicalRectangle, ℓ.IsPositiveTime →
        ∀ᶠ n in atTop, IsTimeCommensurate (dyadicOneLoopPath.spacing n) ℓ) := by
  intro h_all
  let ℓ : PhysicalRectangle :=
    { base := fun _ => 1 / 3
      μ := 0
      ν := 1
      plane := by decide
      sideμ := 1
      sideν := 1
      sideμ_pos := by norm_num
      sideν_pos := by norm_num }
  have hpos : ℓ.IsPositiveTime := by
    unfold PhysicalRectangle.IsPositiveTime
    dsimp [ℓ]
    norm_num
  obtain ⟨n, ⟨k, hk⟩, _⟩ := (h_all ℓ hpos).exists
  dsimp [ℓ, dyadicOneLoopPath] at hk
  push_cast at hk
  have h_sp_pow : (1 / 2 : ℝ) ^ n * (2 : ℝ) ^ n = 1 := by
    rw [← mul_pow]
    norm_num
  have h_real : (2 : ℝ) ^ n = 3 * (k : ℝ) := by
    calc
      (2 : ℝ) ^ n = 3 * (1 / 3 : ℝ) * (2 : ℝ) ^ n := by ring
      _ = 3 * ((k : ℝ) * (1 / 2 : ℝ) ^ n) * (2 : ℝ) ^ n := by rw [hk]
      _ = 3 * (k : ℝ) * ((1 / 2 : ℝ) ^ n * (2 : ℝ) ^ n) := by ring
      _ = 3 * (k : ℝ) * 1 := by rw [h_sp_pow]
      _ = 3 * (k : ℝ) := by ring
  have h_int : (2 : ℤ) ^ n = 3 * k := by exact_mod_cast h_real
  have h_mod : ∀ m : ℕ, ((2 : ℤ) ^ m) % 3 = 1 ∨ ((2 : ℤ) ^ m) % 3 = 2 := by
    intro m
    induction m with
    | zero => decide
    | succ m ih =>
        rw [pow_succ, Int.mul_emod]
        rcases ih with h1 | h2
        · rw [h1]; decide
        · rw [h2]; decide
  have h_zero : ((2 : ℤ) ^ n) % 3 = 0 := by
    rw [h_int, Int.mul_emod_right]
  rcases h_mod n with h1 | h2 <;> omega

/-- Gap 5 (`SymanzikDimensionSixRotationalSuppression`): tree-level + 1-loop Symanzik / Balaban
effective action artifacts break Euclidean symmetry to the hypercubic group `W(B_4)` only through
dimension-6 operators suppressed by $O((P.\mathrm{spacing}\;n)^2)$ (with `h_limit`, `rotSchwinger`,
and `h_permute_dim6` moved into `TwoCutoffComparison` (refuted: `not_twoCutoffComparison_of_irCov_decay`)
and exact hypercubic permutation invariance holding identically at every finite
cutoff via `renormalizedSchwinger_permute_eq_of_isPermutationInvariant`):
translation discretization defect bounded by `C_tr * (P.spacing n) ^ 2`.
VACUOUS for Z = O(a): inhabited by `symanzikDim6PerimeterCornerScheme` (`symanzikDimensionSixRotationalSuppression_perimeterCorner_inhabited`); see `SymanzikTranslationGuarded`. -/
structure SymanzikDimensionSixRotationalSuppression {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) : Prop where
  h_translate_dim6 :
    ∀ (c : Fin 4 → ℚ) (F : DisjointLoopFamily),
      ∃ C_tr : ℝ, 0 ≤ C_tr ∧
        ∀ᶠ n in atTop,
          |renormalizedSchwinger Z n (F.translate c) - renormalizedSchwinger Z n F| ≤
            C_tr * (P.spacing n) ^ 2

/-- Dimension-6 $O(a_n^2)$ translation suppression implies
`ObservableTransferAndSymmetryBridge.h_translate_defect`. -/
theorem SymanzikDimensionSixRotationalSuppression.tendsto_translate_defect_zero
    {P : ContinuumCutoffPath} {Z : LoopRenormalization P.toCutoffPath}
    (hSym : SymanzikDimensionSixRotationalSuppression Z)
    (c : Fin 4 → ℚ) (F : DisjointLoopFamily) :
    Tendsto (fun n => renormalizedSchwinger Z n (F.translate c) - renormalizedSchwinger Z n F)
      atTop (𝓝 0) := by
  obtain ⟨C_tr, _, h_bd⟩ := hSym.h_translate_dim6 c F
  exact tendsto_zero_of_abs_le_const_mul_spacing_sq P h_bd

/-- Exact coordinate-permutation invariance (`C_pm = 0`) for any permutation-invariant
renormalization scheme `Z` (such as `T.Z_tube`). -/
theorem SymanzikDimensionSixRotationalSuppression.h_permute_dim6
    {P : ContinuumCutoffPath} {Z : LoopRenormalization P.toCutoffPath}
    (_hSym : SymanzikDimensionSixRotationalSuppression Z)
    (hZ : Z.IsPermutationInvariant)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) :
    ∃ C_pm : ℝ, 0 ≤ C_pm ∧
      ∀ᶠ n in atTop,
        |renormalizedSchwinger Z n (F.permute σ) - renormalizedSchwinger Z n F| ≤
          C_pm * (P.spacing n) ^ 2 :=
  exists_permute_dim6_of_isPermutationInvariant hZ σ F

/-- Exact coordinate-permutation invariance implies
`ObservableTransferAndSymmetryBridge.h_permute_defect` for any permutation-invariant `Z`. -/
theorem SymanzikDimensionSixRotationalSuppression.tendsto_permute_defect_zero
    {P : ContinuumCutoffPath} {Z : LoopRenormalization P.toCutoffPath}
    (_hSym : SymanzikDimensionSixRotationalSuppression Z)
    (hZ : Z.IsPermutationInvariant)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) :
    Tendsto (fun n => renormalizedSchwinger Z n (F.permute σ) - renormalizedSchwinger Z n F)
      atTop (𝓝 0) :=
  tendsto_permute_defect_zero_of_isPermutationInvariant hZ σ F

/-- Gap 5 Theorem: for any continuum limit `S` of `renormalizedSchwinger Z` under a
permutation-invariant renormalization scheme `Z`, `SymanzikDimensionSixRotationalSuppression Z`
implies `RotatedLatticeContinuumUniqueness Z S` and `SchwingerEuclideanInvariant S`. -/
theorem SymanzikDimensionSixRotationalSuppression.toRotatedLatticeContinuumUniqueness
    {P : ContinuumCutoffPath} {Z : LoopRenormalization P.toCutoffPath}
    {S : DisjointLoopFamily → ℝ}
    (hSym : SymanzikDimensionSixRotationalSuppression Z)
    (hZ_perm : Z.IsPermutationInvariant)
    (h_limit : ∀ F : DisjointLoopFamily,
      Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F))) :
    RotatedLatticeContinuumUniqueness Z S ∧ SchwingerEuclideanInvariant S := by
  have hU : RotatedLatticeContinuumUniqueness Z S :=
    { h_limit := h_limit
      h_translate_agree := fun c F => by
        have h_add := (hSym.tendsto_translate_defect_zero c F).add (h_limit F)
        rw [zero_add] at h_add
        exact h_add.congr fun n => by ring
      h_permute_agree := fun σ F => by
        have h_add := (hSym.tendsto_permute_defect_zero hZ_perm σ F).add (h_limit F)
        rw [zero_add] at h_add
        exact h_add.congr fun n => by ring }
  exact ⟨hU, schwingerEuclideanInvariant_of_rotatedLatticeContinuumUniqueness hU⟩

/-- Derives the existence of a continuum Schwinger functional `S` satisfying
`RotatedLatticeContinuumUniqueness Z S` and `SchwingerEuclideanInvariant S` from
`TwoCutoffComparison T Z` and `SymanzikDimensionSixRotationalSuppression Z` without assuming
`h_limit` or `h_permute_dim6` (since `hC.hZ_eq` and `T.z_tube_isPermutationInvariant` establish
`Z.IsPermutationInvariant` automatically). -/
theorem SymanzikDimensionSixRotationalSuppression.exists_rotatedLatticeContinuumUniqueness_of_twoCutoffComparison
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z)
    (hSym : SymanzikDimensionSixRotationalSuppression Z) :
    ∃ S : DisjointLoopFamily → ℝ,
      RotatedLatticeContinuumUniqueness Z S ∧ SchwingerEuclideanInvariant S := by
  obtain ⟨S, h_limit⟩ := schwingerConverges_of_twoCutoffComparison hC
  have hZ_perm : Z.IsPermutationInvariant := hC.hZ_eq ▸ T.z_tube_isPermutationInvariant
  exact ⟨S, hSym.toRotatedLatticeContinuumUniqueness hZ_perm h_limit⟩

/-! ### Unconditional Real-Blocking-Step `R_trunc` Bounds (`h_R_meas`, `h_R_abs`, `h_R_mixed`) for `canonicalRGStateAux` -/

/-- Exact decomposition of `haarCanonicalNoncommutingProbe L` as two single-link updates from
`vacuumConfig L`: updating link `⟨0, 0⟩` to `su2PauliI` and link `⟨0, 1⟩` to `su2PauliJ`. -/
theorem haarCanonicalNoncommutingProbe_eq_two_updates (L : ℕ) :
    haarCanonicalNoncommutingProbe L =
      updateGaugeLink L (updateGaugeLink L (vacuumConfig L) 0 0 su2PauliI) 0 1 su2PauliJ := by
  funext e
  dsimp [haarCanonicalNoncommutingProbe]
  let V₁ := updateGaugeLink L (vacuumConfig L) 0 0 su2PauliI
  have h01 : (⟨0, 0⟩ : Link L) ≠ ⟨0, 1⟩ := by
    intro h
    have hμ : (0 : Direction) = 1 := congrArg Link.μ h
    revert hμ
    decide
  by_cases h0 : e = ⟨0, 0⟩
  · subst h0
    simp only [ite_true]
    have h_out := (updateGaugeLink_same_and_other L V₁ 0 1 su2PauliJ).2 ⟨0, 0⟩ h01
    have h_in := (updateGaugeLink_same_and_other L (vacuumConfig L) 0 0 su2PauliI).1
    exact (h_out.trans h_in).symm
  · simp only [h0, ite_false]
    by_cases h1 : e = ⟨0, 1⟩
    · subst h1
      simp only [ite_true]
      exact (updateGaugeLink_same_and_other L V₁ 0 1 su2PauliJ).1.symm
    · simp only [h1, ite_false]
      have h_out := (updateGaugeLink_same_and_other L V₁ 0 1 su2PauliJ).2 e h1
      have h_in := (updateGaugeLink_same_and_other L (vacuumConfig L) 0 0 su2PauliI).2 e h0
      exact (h_out.trans h_in).symm

/-- For any coarse functional `A : GaugeConfig L → ℝ` whose single-link oscillation is bounded by
`M_osc ≥ 0`, its difference at `haarCanonicalNoncommutingProbe L` relative to `vacuumConfig L` is
bounded by `2 * M_osc`, and its extracted coarse coupling under `canonicalHaarProbeExtractor L`
satisfies `max 0 (extractedCoarseCoupling (canonicalHaarProbeExtractor L) (fun V => A V - A (vacuumConfig L))) ≤ 2 * M_osc`. -/
theorem extractedCoarseCoupling_canonicalHaarProbeExtractor_le_two_mul_osc
    (L : ℕ) [NeZero L] (A : GaugeConfig L → ℝ) {M_osc : ℝ} (hM : 0 ≤ M_osc)
    (h_osc : ∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |A (updateGaugeLink L V e.x e.μ g1) - A (updateGaugeLink L V e.x e.μ g2)| ≤ M_osc) :
    |A (haarCanonicalNoncommutingProbe L) - A (vacuumConfig L)| ≤ 2 * M_osc ∧
    max 0 (extractedCoarseCoupling (canonicalHaarProbeExtractor L)
      (fun V => A V - A (vacuumConfig L))) ≤ 2 * M_osc := by
  let V₁ := updateGaugeLink L (vacuumConfig L) 0 0 su2PauliI
  have h_vac_eq : vacuumConfig L = updateGaugeLink L (vacuumConfig L) 0 0 1 :=
    (updateGroupGaugeLink_self_eq (vacuumConfig L) ⟨0, 0⟩).symm
  have h_V1_eq : V₁ = updateGaugeLink L V₁ 0 1 (V₁ ⟨0, 1⟩) :=
    (updateGroupGaugeLink_self_eq V₁ ⟨0, 1⟩).symm
  have h_step1 : |A V₁ - A (vacuumConfig L)| ≤ M_osc := by
    conv_lhs =>
      arg 1
      arg 2
      rw [h_vac_eq]
    exact h_osc (vacuumConfig L) ⟨0, 0⟩ su2PauliI 1
  have h_step2 : |A (haarCanonicalNoncommutingProbe L) - A V₁| ≤ M_osc := by
    rw [haarCanonicalNoncommutingProbe_eq_two_updates L]
    conv_lhs =>
      arg 1
      arg 2
      rw [h_V1_eq]
    exact h_osc V₁ ⟨0, 1⟩ su2PauliJ (V₁ ⟨0, 1⟩)
  have h_probe_diff : |A (haarCanonicalNoncommutingProbe L) - A (vacuumConfig L)| ≤ 2 * M_osc := by
    have h_tri := abs_add_le
      (A (haarCanonicalNoncommutingProbe L) - A V₁)
      (A V₁ - A (vacuumConfig L))
    have h_id :
        (A (haarCanonicalNoncommutingProbe L) - A V₁) + (A V₁ - A (vacuumConfig L)) =
          A (haarCanonicalNoncommutingProbe L) - A (vacuumConfig L) := by ring
    rw [h_id] at h_tri
    linarith
  refine ⟨h_probe_diff, max_le (by linarith) ?_⟩
  have hw := haarCanonicalNoncommutingProbe_wilsonAction_pos_and_ne_zero L
  have hw_ge1 : 1 ≤ wilsonAction 1 (haarCanonicalNoncommutingProbe L) := hw.1
  have hw_pos : 0 < wilsonAction 1 (haarCanonicalNoncommutingProbe L) := hw.2.1
  have h_num_le :
      A (haarCanonicalNoncommutingProbe L) - A (vacuumConfig L) ≤
        (2 * M_osc) * wilsonAction 1 (haarCanonicalNoncommutingProbe L) := by
    have h_upper : A (haarCanonicalNoncommutingProbe L) - A (vacuumConfig L) ≤ 2 * M_osc :=
      (le_abs_self _).trans h_probe_diff
    nlinarith
  dsimp [extractedCoarseCoupling, canonicalHaarProbeExtractor, canonicalPlaquetteProbeExtractor]
  rw [sub_self, sub_zero, div_le_iff₀ hw_pos]
  exact h_num_le

/-- Link-by-link patch telescoping bound from a uniform single-link oscillation bound `M_osc`. -/
theorem abs_sub_patchGroupGaugeConfig_le_sum_const_osc {L : ℕ}
    (h : GaugeConfig L → ℝ) {M_osc : ℝ}
    (h_osc : ∀ (W : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |h (updateGaugeLink L W e.x e.μ g1) - h (updateGaugeLink L W e.x e.μ g2)| ≤ M_osc)
    (U U₀ : GaugeConfig L) (s : Finset (Link L)) :
    |h (patchGroupGaugeConfig s U U₀) - h U₀| ≤ ∑ _e ∈ s, M_osc := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      rw [patchGroupGaugeConfig_empty U U₀]
      simp
  | @insert e s he ih =>
      rw [Finset.sum_insert he]
      have h_step :
          |h (patchGroupGaugeConfig (insert e s) U U₀) - h (patchGroupGaugeConfig s U U₀)| ≤
            M_osc := by
        rw [patchGroupGaugeConfig_insert e s U U₀]
        conv_lhs =>
          arg 1
          arg 2
          rw [patchGroupGaugeConfig_not_mem_eq_update he U U₀]
        exact h_osc (patchGroupGaugeConfig s U U₀) e (U e) (U₀ e)
      have h_tri := abs_add_le
        (h (patchGroupGaugeConfig (insert e s) U U₀) - h (patchGroupGaugeConfig s U U₀))
        (h (patchGroupGaugeConfig s U U₀) - h U₀)
      have h_id :
          (h (patchGroupGaugeConfig (insert e s) U U₀) - h (patchGroupGaugeConfig s U U₀)) +
            (h (patchGroupGaugeConfig s U U₀) - h U₀) =
          h (patchGroupGaugeConfig (insert e s) U U₀) - h U₀ := by ring
      rw [h_id] at h_tri
      linarith

/-- Any `h : GaugeConfig L → ℝ` with single-link oscillation bounded by `M_osc` satisfies
`|h U - h U₀| ≤ (Fintype.card (Link L) : ℝ) * M_osc` for all `U, U₀ : GaugeConfig L`. -/
theorem abs_sub_le_card_mul_singleLink_osc {L : ℕ} [NeZero L]
    (h : GaugeConfig L → ℝ) {M_osc : ℝ}
    (h_osc : ∀ (W : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |h (updateGaugeLink L W e.x e.μ g1) - h (updateGaugeLink L W e.x e.μ g2)| ≤ M_osc)
    (U U₀ : GaugeConfig L) :
    |h U - h U₀| ≤ (Fintype.card (Link L) : ℝ) * M_osc := by
  have h_univ := abs_sub_patchGroupGaugeConfig_le_sum_const_osc h h_osc U U₀ Finset.univ
  rw [patchGroupGaugeConfig_univ U U₀, Finset.sum_const, Finset.card_univ, nsmul_eq_mul] at h_univ
  exact h_univ

/-- Derives `h_R_abs`, `h_R_mixed`, and `TruncationDobrushinNormBound` directly from a single-link
oscillation bound `M_osc ≥ 0`, vacuum normalization `R_trunc (vacuumConfig L) = 0`, and
`Measurable R_trunc`. -/
theorem truncationDobrushinNormBound_of_singleLink_osc {L : ℕ} [NeZero L]
    (R_trunc : GaugeConfig L → ℝ) {M_osc : ℝ} (hM_nonneg : 0 ≤ M_osc)
    (hR_vac : R_trunc (vacuumConfig L) = 0)
    (hR_meas : Measurable R_trunc)
    (h_osc : ∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
      |R_trunc (updateGaugeLink L V e.x e.μ g1) -
        R_trunc (updateGaugeLink L V e.x e.μ g2)| ≤ M_osc) :
    (∀ V : GaugeConfig L, |R_trunc V| ≤ (Fintype.card (Link L) : ℝ) * M_osc) ∧
    (∀ (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 2 * M_osc) ∧
    TruncationDobrushinNormBound R_trunc ((Fintype.card (Link L) : ℝ) * (2 * M_osc)) := by
  have h_abs (V : GaugeConfig L) : |R_trunc V| ≤ (Fintype.card (Link L) : ℝ) * M_osc := by
    have h_sub := abs_sub_le_card_mul_singleLink_osc R_trunc h_osc V (vacuumConfig L)
    rwa [hR_vac, sub_zero] at h_sub
  have h_mix (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2) :
      |twoLinkMixedDifference L R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 2 * M_osc := by
    have h_re :
        twoLinkMixedDifference L R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2 =
          (R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h1) -
            R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h2)) -
          (R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h1) -
            R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h2)) := by
      dsimp [twoLinkMixedDifference, updateTwoGaugeLinks]
      ring
    have h_tri := abs_sub
      (R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h1) -
        R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h2))
      (R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h1) -
        R_trunc (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h2))
    rw [← h_re] at h_tri
    linarith [h_osc (updateGaugeLink L V e.x e.μ g1) e' h1 h2,
      h_osc (updateGaugeLink L V e.x e.μ g2) e' h1 h2]
  refine ⟨h_abs, h_mix, ⟨(Fintype.card (Link L) : ℝ) * M_osc, h_abs⟩,
    hR_meas, fun _ _ => 2 * M_osc, fun _ _ => by linarith, h_mix, fun e => ?_⟩
  calc
    (∑ _e' ∈ (Finset.univ : Finset (Link L)).erase e, (2 * M_osc))
      ≤ ∑ _e' : Link L, (2 * M_osc) :=
        Finset.sum_le_univ_sum_of_nonneg fun _ => by linarith
    _ = (Fintype.card (Link L) : ℝ) * (2 * M_osc) := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

/-- Joint configuration measurability of `interactingBlockedFiberWeight (haarBlockDisintegration L) β K`
whenever `Measurable K`. -/
theorem measurable_haarInteractingBlockedFiberWeight {L : ℕ} [NeZero L] [NeZero (2 * L)]
    (β : ℝ) (K : GaugeConfig (2 * L) → ℝ) (hK_meas : Measurable K) :
    Measurable (interactingBlockedFiberWeight (haarBlockDisintegration L) β K) := by
  exact (Real.continuous_exp.measurable.comp
    ((measurable_wilsonAction β).neg.sub hK_meas)).stronglyMeasurable.integral_kernel.measurable

/-- Joint configuration measurability of `interactingBlockedEffectiveAction (haarBlockDisintegration L) β K`
whenever `Measurable K`. -/
theorem measurable_haarInteractingBlockedEffectiveAction {L : ℕ} [NeZero L] [NeZero (2 * L)]
    (β : ℝ) (K : GaugeConfig (2 * L) → ℝ) (hK_meas : Measurable K) :
    Measurable (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K) :=
  (Real.measurable_log.comp (measurable_haarInteractingBlockedFiberWeight β K hK_meas)).neg

/-- Exact total-action cancellation identity for `interactingBlockedEffectiveAction`:
in any blocking step from state `st_prev : InteractingEffectiveActionState (2 * L)`, the exponent
`-wilsonAction st_prev.β U - (st_prev.polymers.eval U + st_prev.R_trunc U)` inside the fiber weight
equals `-wilsonAction 0 U - S_prev U`, where
`S_prev U := wilsonAction st_prev.β U + st_prev.polymers.eval U + st_prev.R_trunc U` is the total
non-vacuum action of `st_prev` (`= A_eff_prev U - A_eff_prev (vacuumConfig)`).
Consequently, the blocked effective action depends only on `S_prev` and **not** on how `st_prev`
splits `S_prev` into `wilsonAction st_prev.β + polymers + R_trunc`, completely eliminating the
$49^j$ multi-step blowup! -/
theorem interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction
    {L : ℕ} [NeZero L] [NeZero (2 * L)]
    (D : ConditionalBlockFiberDisintegration L)
    (st_prev : InteractingEffectiveActionState (2 * L)) :
    interactingBlockedEffectiveAction D st_prev.β
      (fun U => st_prev.polymers.eval U + st_prev.R_trunc U) =
    interactingBlockedEffectiveAction D 0
      (fun U => wilsonAction st_prev.β U + st_prev.polymers.eval U + st_prev.R_trunc U) := by
  funext V
  dsimp [interactingBlockedEffectiveAction, interactingBlockedFiberWeight]
  congr 2
  refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun U => ?_)
  dsimp only
  congr 1
  have h0 : wilsonAction 0 U = 0 := by
    dsimp [wilsonAction]
    ring
  rw [h0]
  ring

/-- Uniform, $49^j$-free coupling upper bound `canonicalRGStepBetaBound β_uv j` for
`canonicalRGStateAux L_ir β_uv j m`: equals `β_uv` at `j = 0` and `24 * β_uv` for every `j + 1 ≥ 1`
(completely independent of step count `j`). -/
def canonicalRGStepBetaBound (β_uv : ℝ) : ℕ → ℝ
  | 0 => β_uv
  | _ + 1 => 24 * β_uv

/-- Uniform, $49^j$-free single-link truncation-oscillation upper bound
`canonicalRGStepOscBound β_uv j` for `(canonicalRGStateAux L_ir β_uv j m).R_trunc`: equals `0` at
`j = 0` and `300 * β_uv` (`= 12 * β_uv + 12 * (24 * β_uv)`) for every step `j + 1 ≥ 1`
(completely independent of step count `j`). -/
def canonicalRGStepOscBound (β_uv : ℝ) : ℕ → ℝ
  | 0 => 0
  | _ + 1 => 300 * β_uv

theorem canonicalRGStepBetaBound_nonneg {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    ∀ j : ℕ, 0 ≤ canonicalRGStepBetaBound β_uv j
  | 0 => hβ
  | _ + 1 => mul_nonneg (by norm_num) hβ

theorem canonicalRGStepOscBound_nonneg {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    ∀ j : ℕ, 0 ≤ canonicalRGStepOscBound β_uv j
  | 0 => le_rfl
  | _ + 1 => mul_nonneg (by norm_num) hβ

/-- Unconditional, **$49^j$-free** multi-step bounds for `canonicalRGStateAux L_ir β_uv j m` proved
by induction on `j : ℕ`:
by using `interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction`, the total
non-vacuum action `S_m(V) := wilsonAction st.β V + st.polymers.eval V + st.R_trunc V` has
single-link oscillation bounded by `12 * β_uv` and two-link mixed difference bounded by `24 * β_uv`
at **every** step `j : ℕ` (with zero $49^j$ growth), while `st.β ≤ canonicalRGStepBetaBound β_uv j`
(`≤ 24 * β_uv`) and `st.R_trunc` has single-link oscillation bounded by `300 * β_uv` and two-link
mixed difference bounded by `24 * β_uv + (if e' ∈ dobrushinNeighbors e then 24 * 24 * β_uv else 0)`
uniformly for all `j : ℕ`. -/
theorem canonicalRGStateAux_unconditional_R_trunc_bounds
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    ∀ (j m : ℕ),
      let L_m := dyadicScaleSide L_ir m
      let st := canonicalRGStateAux L_ir β_uv j m
      let S_m : GaugeConfig L_m → ℝ :=
        fun V => wilsonAction st.β V + st.polymers.eval V + st.R_trunc V
      st.polymers = PolymerActivityFamily.empty L_m ∧
      Measurable st.R_trunc ∧
      Measurable S_m ∧
      S_m (vacuumConfig L_m) = 0 ∧
      (∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
        |S_m (updateGaugeLink L_m V e.x e.μ g1) -
          S_m (updateGaugeLink L_m V e.x e.μ g2)| ≤ 12 * β_uv) ∧
      st.β ≤ canonicalRGStepBetaBound β_uv j ∧
      (∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
        |st.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
          st.R_trunc (updateGaugeLink L_m V e.x e.μ g2)| ≤
          canonicalRGStepOscBound β_uv j) ∧
      (∀ (V : GaugeConfig L_m) (e e' : Link L_m) (g1 g2 h1 h2 : SU2),
        |twoLinkMixedDifference L_m st.R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
          2 * canonicalRGStepOscBound β_uv j)
  | 0, m => by
      dsimp [canonicalRGStateAux, InteractingEffectiveActionState.pureWilson,
        canonicalRGStepBetaBound, canonicalRGStepOscBound]
      let L_m := dyadicScaleSide L_ir m
      have hS_eq :
          (fun V : GaugeConfig L_m =>
            wilsonAction β_uv V + (PolymerActivityFamily.empty L_m).eval V + 0) =
          wilsonAction β_uv := by
        funext V
        rw [PolymerActivityFamily.eval_empty, add_zero, add_zero]
      refine ⟨rfl, measurable_const, ?_, ?_, ?_, le_rfl,
        fun _ _ _ _ => by simp, fun _ _ _ _ _ _ _ => by simp [twoLinkMixedDifference]⟩
      · rw [hS_eq]
        exact measurable_wilsonAction β_uv
      · simp [PolymerActivityFamily.eval_empty, wilsonAction_vacuum]
      · intro V e g1 g2
        simpa [PolymerActivityFamily.eval_empty] using
          wilsonAction_singleLink_oscillation_le L_m hβ V e.x e.μ g1 g2
  | j + 1, m => by
      dsimp only
      let L_m := dyadicScaleSide L_ir m
      let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
      let st_next := canonicalRGStateAux L_ir β_uv (j + 1) m
      let S_prev : GaugeConfig (dyadicScaleSide L_ir (m + 1)) → ℝ :=
        fun U => wilsonAction st_prev.β U + st_prev.polymers.eval U + st_prev.R_trunc U
      let S_next : GaugeConfig L_m → ℝ :=
        fun V => wilsonAction st_next.β V + st_next.polymers.eval V + st_next.R_trunc V
      have ih := canonicalRGStateAux_unconditional_R_trunc_bounds L_ir hβ j (m + 1)
      rcases ih with ⟨_, _, hS_meas_prev, hS_vac_prev, hS_osc_prev, _, _, _⟩
      change S_prev (vacuumConfig (dyadicScaleSide L_ir (m + 1))) = 0 at hS_vac_prev
      let B_S := (Fintype.card (Link (dyadicScaleSide L_ir (m + 1))) : ℝ) * (12 * β_uv)
      have hS_bounds : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
          -B_S ≤ S_prev U ∧ S_prev U ≤ B_S := fun U => by
        have h_sub := abs_sub_le_card_mul_singleLink_osc S_prev hS_osc_prev U
          (vacuumConfig (dyadicScaleSide L_ir (m + 1)))
        rw [hS_vac_prev, sub_zero] at h_sub
        exact abs_le.mp h_sub
      let A_eff : GaugeConfig L_m → ℝ :=
        interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β
          (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
      have hA_eq_zero :
          A_eff = interactingBlockedEffectiveAction (haarBlockDisintegration L_m) 0 S_prev :=
        interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction
          (haarBlockDisintegration L_m) st_prev
      have hA_meas : Measurable A_eff := by
        rw [hA_eq_zero]
        exact measurable_haarInteractingBlockedEffectiveAction 0 S_prev hS_meas_prev
      have hA_osc : ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
          |A_eff (updateGaugeLink L_m V e.x e.μ g1) -
            A_eff (updateGaugeLink L_m V e.x e.μ g2)| ≤ 12 * β_uv := by
        intro V e g1 g2
        rw [hA_eq_zero]
        have h_haar :=
          (haarInteractingBlockedEffectiveAction_singleLink_oscillation_and_twoLink_mixedDifference
            (le_rfl : (0 : ℝ) ≤ 0) S_prev hS_meas_prev hS_bounds hS_osc_prev V e e g1 g2 1 1).2.1
        linarith
      have h12_nonneg : 0 ≤ 12 * β_uv := mul_nonneg (by norm_num) hβ
      have h_ext :=
        extractedCoarseCoupling_canonicalHaarProbeExtractor_le_two_mul_osc
          L_m A_eff h12_nonneg hA_osc
      have hβ_next_le : st_next.β ≤ canonicalRGStepBetaBound β_uv (j + 1) := by
        change max 0 (extractedCoarseCoupling (canonicalHaarProbeExtractor L_m)
          (fun V => A_eff V - A_eff (vacuumConfig L_m))) ≤ 24 * β_uv
        linarith [h_ext.2]
      have hβ_next_nonneg : 0 ≤ st_next.β :=
        canonicalRGStateAux_β_nonneg L_ir hβ (j + 1) m
      have hR_next_meas : Measurable st_next.R_trunc := by
        change Measurable (fun V : GaugeConfig L_m =>
          (A_eff V - A_eff (vacuumConfig L_m)) - wilsonAction st_next.β V)
        exact (hA_meas.sub measurable_const).sub (measurable_wilsonAction st_next.β)
      have hS_next_eq : S_next = fun V => A_eff V - A_eff (vacuumConfig L_m) := by
        funext V
        change wilsonAction st_next.β V + (PolymerActivityFamily.empty L_m).eval V +
          ((A_eff V - A_eff (vacuumConfig L_m)) - wilsonAction st_next.β V) =
          A_eff V - A_eff (vacuumConfig L_m)
        rw [PolymerActivityFamily.eval_empty]
        ring
      have hS_next_meas : Measurable S_next := by
        rw [hS_next_eq]
        exact hA_meas.sub measurable_const
      have hS_next_vac : S_next (vacuumConfig L_m) = 0 := by
        rw [hS_next_eq]
        simp
      have hS_next_osc : ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
          |S_next (updateGaugeLink L_m V e.x e.μ g1) -
            S_next (updateGaugeLink L_m V e.x e.μ g2)| ≤ 12 * β_uv := by
        intro V e g1 g2
        rw [hS_next_eq]
        have h_sub :
            (A_eff (updateGaugeLink L_m V e.x e.μ g1) - A_eff (vacuumConfig L_m)) -
              (A_eff (updateGaugeLink L_m V e.x e.μ g2) - A_eff (vacuumConfig L_m)) =
            A_eff (updateGaugeLink L_m V e.x e.μ g1) -
              A_eff (updateGaugeLink L_m V e.x e.μ g2) := by ring
        rw [h_sub]
        exact hA_osc V e g1 g2
      have hR_next_osc : ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
          |st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
            st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g2)| ≤
            canonicalRGStepOscBound β_uv (j + 1) := by
        intro V e g1 g2
        have h_split :
            st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
              st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g2) =
            (A_eff (updateGaugeLink L_m V e.x e.μ g1) -
              A_eff (updateGaugeLink L_m V e.x e.μ g2)) -
            (wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g1) -
              wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g2)) := by
          change ((A_eff _ - A_eff _) - wilsonAction st_next.β _) -
            ((A_eff _ - A_eff _) - wilsonAction st_next.β _) = _
          ring
        rw [h_split]
        have h_tri := abs_sub
          (A_eff (updateGaugeLink L_m V e.x e.μ g1) -
            A_eff (updateGaugeLink L_m V e.x e.μ g2))
          (wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g1) -
            wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g2))
        have h_w := wilsonAction_singleLink_oscillation_le L_m hβ_next_nonneg V e.x e.μ g1 g2
        have h_a := hA_osc V e g1 g2
        change _ ≤ 300 * β_uv
        change _ ≤ 24 * β_uv at hβ_next_le
        linarith
      have h_norm :=
        truncationDobrushinNormBound_of_singleLink_osc
          st_next.R_trunc
          (canonicalRGStepOscBound_nonneg hβ (j + 1))
          (canonicalRGStateAux_R_trunc_vacuum_eq_zero L_ir β_uv (j + 1) m)
          hR_next_meas hR_next_osc
      exact ⟨rfl, hR_next_meas, hS_next_meas, hS_next_vac, hS_next_osc,
        hβ_next_le, hR_next_osc, h_norm.2.1⟩

/-- Explicit unconditional `R_trunc` bounds for one real Haar blocking step
`canonicalRGStateAux L_ir β_uv 1 m` starting from `pureWilson (dyadicScaleSide L_ir (m + 1)) β_uv`. -/
theorem canonicalRGStateAux_one_step_R_trunc_bounds
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) (m : ℕ) :
    let L_m := dyadicScaleSide L_ir m
    let st₁ := canonicalRGStateAux L_ir β_uv 1 m
    st₁.polymers = PolymerActivityFamily.empty L_m ∧
    PolymerDobrushinNormBound st₁.polymers 0 ∧
    Measurable st₁.R_trunc ∧
    0 ≤ st₁.β ∧ st₁.β ≤ 24 * β_uv ∧
    (∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
      |st₁.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
        st₁.R_trunc (updateGaugeLink L_m V e.x e.μ g2)| ≤ 300 * β_uv) ∧
    (∀ (V : GaugeConfig L_m) (e e' : Link L_m) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L_m st₁.R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 600 * β_uv) ∧
    (∀ (V : GaugeConfig L_m) (e e' : Link L_m) (g1 h1 h2 : SU2), e' ≠ e →
      |twoLinkMixedDifference L_m st₁.R_trunc V e.x e.μ g1 1 e'.x e'.μ h1 h2| ≤
        24 * β_uv + (if e' ∈ dobrushinNeighbors e then 24 * 24 * β_uv else 0)) := by
  dsimp only
  let L_m := dyadicScaleSide L_ir m
  let st₁ := canonicalRGStateAux L_ir β_uv 1 m
  have h_gen := canonicalRGStateAux_unconditional_R_trunc_bounds L_ir hβ 1 m
  dsimp [canonicalRGStepBetaBound, canonicalRGStepOscBound] at h_gen
  rcases h_gen with ⟨h_poly, h_meas, _, _, _, hβ_le, h_osc, h_mix⟩
  have h_poly_norm : PolymerDobrushinNormBound st₁.polymers 0 := by
    rw [h_poly]
    refine ⟨le_rfl, fun _ _ _ _ => by simp [PolymerActivityFamily.eval_empty],
      fun _ _ => 0, fun _ _ => le_rfl, fun _ _ _ _ _ _ _ => ?_, fun _ => by simp⟩
    simp [twoLinkMixedDifference, PolymerActivityFamily.eval_empty]
  have h_nb_mix : ∀ (V : GaugeConfig L_m) (e e' : Link L_m) (g1 h1 h2 : SU2), e' ≠ e →
      |twoLinkMixedDifference L_m st₁.R_trunc V e.x e.μ g1 1 e'.x e'.μ h1 h2| ≤
        24 * β_uv + (if e' ∈ dobrushinNeighbors e then 24 * 24 * β_uv else 0) := by
    intro V e e' g1 h1 h2 h_ne
    have hK_zero_pt (U : GaugeConfig (dyadicScaleSide L_ir (m + 1))) :
        (canonicalRGStateAux L_ir β_uv 0 (m + 1)).polymers.eval U +
          (canonicalRGStateAux L_ir β_uv 0 (m + 1)).R_trunc U = 0 := by
      simp [canonicalRGStateAux, InteractingEffectiveActionState.pureWilson,
        PolymerActivityFamily.eval_empty]
    have h_step :=
      (canonicalRGStateAux_step_R_trunc_oscillation_and_mixedDifference
        L_ir hβ (K_lo := 0) (K_hi := 0) (δ_prev := 0) 0 m
        (by simp only [hK_zero_pt]; exact measurable_const)
        (fun U => by rw [hK_zero_pt U]; exact ⟨le_rfl, le_rfl⟩)
        (fun U f u1 u2 => by rw [hK_zero_pt, hK_zero_pt]; simp)
        V e e' g1 1 h1 h2).2 h_ne
    have hβ0_eq : (canonicalRGStateAux L_ir β_uv 0 (m + 1)).β = β_uv := rfl
    rw [hβ0_eq] at h_step
    split_ifs at h_step ⊢ with h_mem
    · linarith [h_step, hβ_le]
    · linarith [h_step]
  have h600 : (2 : ℝ) * (300 * β_uv) = 600 * β_uv := by ring
  rw [h600] at h_mix
  exact ⟨h_poly, h_poly_norm, h_meas, canonicalRGStateAux_β_nonneg L_ir hβ 1 m,
    hβ_le, h_osc, h_mix, h_nb_mix⟩

/-- Multi-step Haar RG chain state `localPolymerRGStateAux L_ir β_uv w_poly j m` with:
- **Downward-contracting running coupling** `β = (1 / 2) ^ j * β_uv` (decreasing by `1 / 2` per
  blocking step toward the infrared, rather than growing by `24×`),
- **Concrete non-empty local plaquette polymer family**
  `polymers = PolymerActivityFamily.localPlaquette (dyadicScaleSide L_ir m) (w_poly j)` (`6 * L_m^4`
  plaquette loops of length `4`) with volume-independent Dobrushin norm `18 * (2 * (24 * w_poly j))`, and
- **Exact Haar-blocked effective action identity**
  `wilsonAction st.β V + st.polymers.eval V + st.R_trunc V = A_eff V - A_eff (vacuumConfig L_m)`
  at every blocking step `j + 1`. -/
noncomputable def localPolymerRGStateAux (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) (w_poly : ℕ → ℝ) :
    ∀ (_j m : ℕ), InteractingEffectiveActionState (dyadicScaleSide L_ir m)
  | 0, m => InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv
  | j + 1, m =>
      let L_m := dyadicScaleSide L_ir m
      let st_prev := localPolymerRGStateAux L_ir β_uv w_poly j (m + 1)
      let A_eff : GaugeConfig L_m → ℝ :=
        interactingBlockedEffectiveAction (haarBlockDisintegration L_m)
          st_prev.β (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
      let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
      let β_next : ℝ := (1 / 2 : ℝ) ^ (j + 1) * β_uv
      let P_next : PolymerActivityFamily L_m :=
        PolymerActivityFamily.localPlaquette L_m (w_poly (j + 1))
      { c_vac := st_prev.c_vac + A_eff (vacuumConfig L_m)
        β := β_next
        polymers := P_next
        R_trunc := fun V => A_norm V - wilsonAction β_next V - P_next.eval V }

/-- Unconditional, **$49^j$-free and volume-independent polymer** bounds for the contractive local
polymer RG chain `localPolymerRGStateAux L_ir β_uv w_poly j m`:
for every step `j + 1` and scale `m`:
1. The running coupling contracts geometrically: `st.β = (1 / 2) ^ (j + 1) * β_uv ≤ β_uv`,
2. The polymer family `st.polymers = PolymerActivityFamily.localPlaquette L_m (w_poly (j + 1))` is
   non-empty (`0 < Fintype.card st.polymers.idx`) and satisfies the volume-independent
   `PolymerDobrushinNormBound st.polymers (18 * (2 * (24 * w_poly (j + 1))))` (with zero factor of
   `Fintype.card (Link L_m)`),
3. The total non-vacuum action `S_m(V) = wilsonAction st.β V + st.polymers.eval V + st.R_trunc V`
   has single-link oscillation bounded by `12 * β_uv` uniformly in `j`, and
4. `st.R_trunc` has single-link oscillation bounded by `12 * (2 * β_uv + w_poly (j + 1))` uniformly
   in `j` (with zero $49^j$ growth). -/
theorem localPolymerRGStateAux_unconditional_bounds
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (w_poly : ℕ → ℝ) (hw : ∀ j : ℕ, 0 ≤ w_poly j) :
    ∀ (j m : ℕ),
      let L_m := dyadicScaleSide L_ir m
      let st := localPolymerRGStateAux L_ir β_uv w_poly j m
      let S_m : GaugeConfig L_m → ℝ :=
        fun V => wilsonAction st.β V + st.polymers.eval V + st.R_trunc V
      st.β = (1 / 2 : ℝ) ^ j * β_uv ∧
      0 ≤ st.β ∧
      st.β ≤ β_uv ∧
      Measurable st.R_trunc ∧
      Measurable S_m ∧
      S_m (vacuumConfig L_m) = 0 ∧
      (∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
        |S_m (updateGaugeLink L_m V e.x e.μ g1) -
          S_m (updateGaugeLink L_m V e.x e.μ g2)| ≤ 12 * β_uv) ∧
      (0 < j →
        0 < Fintype.card st.polymers.idx ∧
        PolymerDobrushinNormBound st.polymers (18 * (2 * (24 * w_poly j))) ∧
        ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
          |st.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
            st.R_trunc (updateGaugeLink L_m V e.x e.μ g2)| ≤
            12 * (2 * β_uv + w_poly j))
  | 0, m => by
      dsimp [localPolymerRGStateAux, InteractingEffectiveActionState.pureWilson]
      let L_m := dyadicScaleSide L_ir m
      have hS_eq :
          (fun V : GaugeConfig L_m =>
            wilsonAction β_uv V + (PolymerActivityFamily.empty L_m).eval V + 0) =
          wilsonAction β_uv := by
        funext V
        rw [PolymerActivityFamily.eval_empty, add_zero, add_zero]
      refine ⟨(one_mul β_uv).symm, hβ, le_rfl, measurable_const, ?_, ?_, ?_,
        fun h => False.elim (Nat.lt_irrefl 0 h)⟩
      · rw [hS_eq]
        exact measurable_wilsonAction β_uv
      · simp [PolymerActivityFamily.eval_empty, wilsonAction_vacuum]
      · intro V e g1 g2
        simpa [PolymerActivityFamily.eval_empty] using
          wilsonAction_singleLink_oscillation_le L_m hβ V e.x e.μ g1 g2
  | j + 1, m => by
      dsimp only
      let L_m := dyadicScaleSide L_ir m
      let st_prev := localPolymerRGStateAux L_ir β_uv w_poly j (m + 1)
      let st_next := localPolymerRGStateAux L_ir β_uv w_poly (j + 1) m
      let S_prev : GaugeConfig (dyadicScaleSide L_ir (m + 1)) → ℝ :=
        fun U => wilsonAction st_prev.β U + st_prev.polymers.eval U + st_prev.R_trunc U
      let S_next : GaugeConfig L_m → ℝ :=
        fun V => wilsonAction st_next.β V + st_next.polymers.eval V + st_next.R_trunc V
      have ih := localPolymerRGStateAux_unconditional_bounds L_ir hβ w_poly hw j (m + 1)
      rcases ih with ⟨_, _, _, _, hS_meas_prev, hS_vac_prev, hS_osc_prev, _⟩
      change S_prev (vacuumConfig (dyadicScaleSide L_ir (m + 1))) = 0 at hS_vac_prev
      let B_S := (Fintype.card (Link (dyadicScaleSide L_ir (m + 1))) : ℝ) * (12 * β_uv)
      have hS_bounds : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
          -B_S ≤ S_prev U ∧ S_prev U ≤ B_S := fun U => by
        have h_sub := abs_sub_le_card_mul_singleLink_osc S_prev hS_osc_prev U
          (vacuumConfig (dyadicScaleSide L_ir (m + 1)))
        rw [hS_vac_prev, sub_zero] at h_sub
        exact abs_le.mp h_sub
      let A_eff : GaugeConfig L_m → ℝ :=
        interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β
          (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
      have hA_eq_zero :
          A_eff = interactingBlockedEffectiveAction (haarBlockDisintegration L_m) 0 S_prev :=
        interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction
          (haarBlockDisintegration L_m) st_prev
      have hA_meas : Measurable A_eff := by
        rw [hA_eq_zero]
        exact measurable_haarInteractingBlockedEffectiveAction 0 S_prev hS_meas_prev
      have hA_osc : ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
          |A_eff (updateGaugeLink L_m V e.x e.μ g1) -
            A_eff (updateGaugeLink L_m V e.x e.μ g2)| ≤ 12 * β_uv := by
        intro V e g1 g2
        rw [hA_eq_zero]
        have h_haar :=
          (haarInteractingBlockedEffectiveAction_singleLink_oscillation_and_twoLink_mixedDifference
            (le_rfl : (0 : ℝ) ≤ 0) S_prev hS_meas_prev hS_bounds hS_osc_prev V e e g1 g2 1 1).2.1
        linarith
      have h_pow_le_one : (1 / 2 : ℝ) ^ (j + 1) ≤ 1 :=
        pow_le_one₀ (by norm_num) (by norm_num)
      have h_pow_nonneg : 0 ≤ (1 / 2 : ℝ) ^ (j + 1) :=
        pow_nonneg (by norm_num) (j + 1)
      have hβ_eq : st_next.β = (1 / 2 : ℝ) ^ (j + 1) * β_uv := rfl
      have hβ_nonneg : 0 ≤ st_next.β := mul_nonneg h_pow_nonneg hβ
      have hβ_le : st_next.β ≤ β_uv := by
        rw [hβ_eq]
        exact mul_le_of_le_one_left hβ h_pow_le_one
      have hP_eval : st_next.polymers.eval = wilsonAction (w_poly (j + 1)) := by
        funext V
        exact PolymerActivityFamily.eval_localPlaquette_eq_wilsonAction (w_poly (j + 1)) V
      have hR_next_meas : Measurable st_next.R_trunc := by
        change Measurable (fun V : GaugeConfig L_m =>
          (A_eff V - A_eff (vacuumConfig L_m)) - wilsonAction st_next.β V - st_next.polymers.eval V)
        rw [hP_eval]
        exact ((hA_meas.sub measurable_const).sub (measurable_wilsonAction st_next.β)).sub
          (measurable_wilsonAction (w_poly (j + 1)))
      have hS_next_eq : S_next = fun V => A_eff V - A_eff (vacuumConfig L_m) := by
        funext V
        change wilsonAction st_next.β V + st_next.polymers.eval V +
          ((A_eff V - A_eff (vacuumConfig L_m)) - wilsonAction st_next.β V - st_next.polymers.eval V) =
          A_eff V - A_eff (vacuumConfig L_m)
        ring
      have hS_next_meas : Measurable S_next := by
        rw [hS_next_eq]
        exact hA_meas.sub measurable_const
      have hS_next_vac : S_next (vacuumConfig L_m) = 0 := by
        rw [hS_next_eq]
        simp
      have hS_next_osc : ∀ (V : GaugeConfig L_m) (e : Link L_m) (g1 g2 : SU2),
          |S_next (updateGaugeLink L_m V e.x e.μ g1) -
            S_next (updateGaugeLink L_m V e.x e.μ g2)| ≤ 12 * β_uv := by
        intro V e g1 g2
        rw [hS_next_eq]
        have h_sub :
            (A_eff (updateGaugeLink L_m V e.x e.μ g1) - A_eff (vacuumConfig L_m)) -
              (A_eff (updateGaugeLink L_m V e.x e.μ g2) - A_eff (vacuumConfig L_m)) =
            A_eff (updateGaugeLink L_m V e.x e.μ g1) -
              A_eff (updateGaugeLink L_m V e.x e.μ g2) := by ring
        rw [h_sub]
        exact hA_osc V e g1 g2
      refine ⟨hβ_eq, hβ_nonneg, hβ_le, hR_next_meas, hS_next_meas, hS_next_vac, hS_next_osc,
        fun _ => ⟨PolymerActivityFamily.localPlaquette_card_idx_pos L_m (w_poly (j + 1)),
          PolymerActivityFamily.polymerDobrushinNormBound_localPlaquette L_m (hw (j + 1)),
          fun V e g1 g2 => ?_⟩⟩
      have h_split :
          st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
            st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g2) =
          (A_eff (updateGaugeLink L_m V e.x e.μ g1) -
            A_eff (updateGaugeLink L_m V e.x e.μ g2)) -
          ((wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g1) -
            wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g2)) +
           (wilsonAction (w_poly (j + 1)) (updateGaugeLink L_m V e.x e.μ g1) -
            wilsonAction (w_poly (j + 1)) (updateGaugeLink L_m V e.x e.μ g2))) := by
        change ((A_eff _ - A_eff _) - wilsonAction st_next.β _ - st_next.polymers.eval _) -
          ((A_eff _ - A_eff _) - wilsonAction st_next.β _ - st_next.polymers.eval _) = _
        rw [hP_eval]
        ring
      rw [h_split]
      have h_tri1 := abs_sub
        (A_eff (updateGaugeLink L_m V e.x e.μ g1) -
          A_eff (updateGaugeLink L_m V e.x e.μ g2))
        ((wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g1) -
          wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g2)) +
         (wilsonAction (w_poly (j + 1)) (updateGaugeLink L_m V e.x e.μ g1) -
          wilsonAction (w_poly (j + 1)) (updateGaugeLink L_m V e.x e.μ g2)))
      have h_tri2 := abs_add_le
        (wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g1) -
          wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g2))
        (wilsonAction (w_poly (j + 1)) (updateGaugeLink L_m V e.x e.μ g1) -
          wilsonAction (w_poly (j + 1)) (updateGaugeLink L_m V e.x e.μ g2))
      have h_w1 := wilsonAction_singleLink_oscillation_le L_m hβ_nonneg V e.x e.μ g1 g2
      have h_w2 := wilsonAction_singleLink_oscillation_le L_m (hw (j + 1)) V e.x e.μ g1 g2
      have h_a := hA_osc V e g1 g2
      linarith [h_tri1, h_tri2, h_w1, h_w2, h_a, hβ_le]

/-! ### Gap 1: Multi-Scale UV-to-IR Balaban RG Flow from Bare UV Wilson Action -/

/-- `K`-step running coupling drift telescope: if a downward RG coupling sequence `β_seq : ℕ → ℝ`
satisfies the 1-loop/2-loop running coupling drift inequality
`β_seq (k + 1) ≤ β_seq k - Δβ_1loop + δ_2loop k` for all `k < K`, then
`β_seq K ≤ β_seq 0 - (K : ℝ) * Δβ_1loop + ∑ k ∈ Finset.range K, δ_2loop k`. -/
theorem balaban_running_coupling_drift_telescope
    (β_seq : ℕ → ℝ) (Δβ_1loop : ℝ) (δ_2loop : ℕ → ℝ) :
    ∀ K : ℕ,
      (∀ k < K, β_seq (k + 1) ≤ β_seq k - Δβ_1loop + δ_2loop k) →
      β_seq K ≤ β_seq 0 - (K : ℝ) * Δβ_1loop + ∑ k ∈ Finset.range K, δ_2loop k
  | 0, _ => by simp
  | K + 1, h_step => by
      have ih := balaban_running_coupling_drift_telescope β_seq Δβ_1loop δ_2loop K
        (fun k hk => h_step k (Nat.lt_succ_of_lt hk))
      have hK := h_step K (Nat.lt_succ_self K)
      rw [Finset.sum_range_succ, Nat.cast_add, Nat.cast_one]
      linarith

/-- Corollary of `balaban_running_coupling_drift_telescope`: when the `K_n`-step 1-loop coupling
decrement `(K : ℝ) * Δβ_1loop` absorbs the bare UV coupling `β_seq 0 - β_target` plus the summed
2-loop/polymer drift `∑ k ∈ Finset.range K, δ_2loop k`, the landed IR coupling satisfies
`β_seq K ≤ β_target`. -/
theorem balaban_running_coupling_lands_below_target
    (β_seq : ℕ → ℝ) (Δβ_1loop β_target : ℝ) (δ_2loop : ℕ → ℝ) (K : ℕ)
    (h_step : ∀ k < K, β_seq (k + 1) ≤ β_seq k - Δβ_1loop + δ_2loop k)
    (h_absorb :
      β_seq 0 - β_target + (∑ k ∈ Finset.range K, δ_2loop k) ≤ (K : ℝ) * Δβ_1loop) :
    β_seq K ≤ β_target := by
  have h_tele := balaban_running_coupling_drift_telescope β_seq Δβ_1loop δ_2loop K h_step
  linarith

/-- Saddle-point cancellation of the $O(\beta_{\mathrm{uv}})$ slope in the Haar-blocked fluctuation
remainder `haarFullLeadingFluctuationRemainder L β`: subtracting the classical saddle-point fiber
minimum `β * haarFiberMinimumAction L V` from `wilsonBlockedNormalizedEffectiveAction (haarBlockDisintegration L) β V`
cancels the linear $O(\beta)$ slope not only pointwise in configuration space, but also in every
single-link oscillation and two-link mixed difference as `β → ∞`. -/
theorem haarFullLeadingFluctuationRemainder_singleLink_osc_and_mixedDiff_div_beta_tendsto_zero
    (L : ℕ) [NeZero L] (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2) :
    Tendsto
      (fun β : ℝ =>
        (haarFullLeadingFluctuationRemainder L β (updateGaugeLink L V e.x e.μ g1) -
          haarFullLeadingFluctuationRemainder L β (updateGaugeLink L V e.x e.μ g2)) / β)
      atTop (𝓝 0) ∧
    Tendsto
      (fun β : ℝ =>
        twoLinkMixedDifference L (haarFullLeadingFluctuationRemainder L β)
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2 / β)
      atTop (𝓝 0) := by
  have h_pt (W : GaugeConfig L) :
      Tendsto (fun β : ℝ => haarFullLeadingFluctuationRemainder L β W / β) atTop (𝓝 0) :=
    (haarFullLeadingFluctuationRemainder_vacuum_zero_and_div_beta_tendsto_zero L W).2.2
  refine ⟨?_, ?_⟩
  · have h_sub :=
      (h_pt (updateGaugeLink L V e.x e.μ g1)).sub (h_pt (updateGaugeLink L V e.x e.μ g2))
    rw [sub_zero] at h_sub
    exact h_sub.congr fun β => (sub_div _ _ β).symm
  · have h11 := h_pt (updateTwoGaugeLinks L V e.x e.μ g1 e'.x e'.μ h1)
    have h21 := h_pt (updateTwoGaugeLinks L V e.x e.μ g2 e'.x e'.μ h1)
    have h12 := h_pt (updateTwoGaugeLinks L V e.x e.μ g1 e'.x e'.μ h2)
    have h22 := h_pt (updateTwoGaugeLinks L V e.x e.μ g2 e'.x e'.μ h2)
    have h_mix := (h11.sub h21).sub (h12.sub h22)
    simp only [sub_zero] at h_mix
    refine h_mix.congr fun β => ?_
    dsimp [twoLinkMixedDifference]
    ring

/-- Concrete, non-constant multi-scale polymer Dobrushin norm step sequence defined by the
contractive Balaban recurrence `η (k + 1) = (1 / 2) * η k + 1 / 32` from the UV pure-Wilson base
case `η 0 = 0` (`PolymerActivityFamily.empty`). -/
noncomputable def canonicalBalabanEtaStep : ℕ → ℝ
  | 0 => 0
  | k + 1 => (1 / 2 : ℝ) * canonicalBalabanEtaStep k + (1 / 32 : ℝ)

@[simp]
theorem canonicalBalabanEtaStep_zero : canonicalBalabanEtaStep 0 = 0 := rfl

@[simp]
theorem canonicalBalabanEtaStep_succ (k : ℕ) :
    canonicalBalabanEtaStep (k + 1) = (1 / 2 : ℝ) * canonicalBalabanEtaStep k + (1 / 32 : ℝ) := rfl

theorem canonicalBalabanEtaStep_nonneg (k : ℕ) : 0 ≤ canonicalBalabanEtaStep k := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [canonicalBalabanEtaStep_succ]
      linarith

theorem canonicalBalabanEtaStep_init_le :
    canonicalBalabanEtaStep 0 ≤ (1 / 32 : ℝ) / (1 - (1 / 2 : ℝ)) := by
  norm_num [canonicalBalabanEtaStep]

theorem canonicalBalabanEtaStep_step_le (k : ℕ) :
    canonicalBalabanEtaStep (k + 1) ≤ (1 / 2 : ℝ) * canonicalBalabanEtaStep k + (1 / 32 : ℝ) :=
  le_of_eq (canonicalBalabanEtaStep_succ k)

theorem canonicalBalabanEtaStep_le_canonicalCrossoverEtaHi (k : ℕ) :
    canonicalBalabanEtaStep k ≤ (canonicalCrossoverEtaHi : ℝ) := by
  have h := inductive_balaban_polymer_contraction_uniform_in_K
    (θ := (1 / 2 : ℝ)) (ε_step := (1 / 32 : ℝ))
    (by norm_num) (by norm_num)
    canonicalBalabanEtaStep_init_le
    canonicalBalabanEtaStep_step_le k
  have h_eq : (1 / 32 : ℝ) / (1 - (1 / 2 : ℝ)) = (canonicalCrossoverEtaHi : ℝ) := by
    norm_num [canonicalCrossoverEtaHi]
  linarith

/-- Concrete, non-constant multi-scale truncation neighbor-oscillation step sequence defined by the
contractive Balaban recurrence `δ (k + 1) = (1 / 2) * δ k + (1 / 24) * (1 / 32)` from the UV
pure-Wilson base case `δ 0 = 0` (`R_trunc = 0`). -/
noncomputable def canonicalBalabanDeltaNbStep : ℕ → ℝ
  | 0 => 0
  | k + 1 => (1 / 2 : ℝ) * canonicalBalabanDeltaNbStep k + (1 / 24 : ℝ) * (1 / 32 : ℝ)

@[simp]
theorem canonicalBalabanDeltaNbStep_zero : canonicalBalabanDeltaNbStep 0 = 0 := rfl

@[simp]
theorem canonicalBalabanDeltaNbStep_succ (k : ℕ) :
    canonicalBalabanDeltaNbStep (k + 1) =
      (1 / 2 : ℝ) * canonicalBalabanDeltaNbStep k + (1 / 24 : ℝ) * (1 / 32 : ℝ) := rfl

theorem canonicalBalabanDeltaNbStep_nonneg (k : ℕ) : 0 ≤ canonicalBalabanDeltaNbStep k := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [canonicalBalabanDeltaNbStep_succ]
      linarith

theorem canonicalBalabanDeltaNbStep_init_le :
    canonicalBalabanDeltaNbStep 0 ≤ ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ)) := by
  norm_num [canonicalBalabanDeltaNbStep]

theorem canonicalBalabanDeltaNbStep_step_le (k : ℕ) :
    canonicalBalabanDeltaNbStep (k + 1) ≤
      (1 / 2 : ℝ) * canonicalBalabanDeltaNbStep k + (1 / 24 : ℝ) * (1 / 32 : ℝ) :=
  le_of_eq (canonicalBalabanDeltaNbStep_succ k)

theorem canonicalBalabanDeltaNbStep_le (k : ℕ) :
    canonicalBalabanDeltaNbStep k ≤ ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ)) ∧
    canonicalBalabanDeltaNbStep k ≤ (canonicalCrossoverEpsHi : ℝ) / 18 := by
  have h := inductive_balaban_polymer_contraction_uniform_in_K
    (θ := (1 / 2 : ℝ)) (ε_step := (1 / 24 : ℝ) * (1 / 32 : ℝ))
    (by norm_num) (by norm_num)
    canonicalBalabanDeltaNbStep_init_le
    canonicalBalabanDeltaNbStep_step_le k
  have h_le :
      ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ)) ≤
        (canonicalCrossoverEpsHi : ℝ) / 18 := by
    norm_num [canonicalCrossoverEpsHi]
  exact ⟨h, h.trans h_le⟩

/-- Unconditional `(4 / 3)^length`-weighted incident-loop sum bound for the contractive local
polymer RG chain `localPolymerRGStateAux L_ir β_uv w_poly j m`: whenever
`0 ≤ w_poly j ≤ (6 * (4 * ((4 / 3 : ℝ) ^ 4 * 4)))⁻¹ * canonicalBalabanEtaStep j` for all `j : ℕ`,
every RG step `j : ℕ` and scale `m : ℕ` satisfies the `(4 / 3)^length`-weighted incident-loop sum
bound `≤ canonicalBalabanEtaStep j` unconditionally. -/
theorem localPolymerRGStateAux_weighted_incident_sum_le_canonicalBalabanEtaStep
    (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ)
    (w_poly : ℕ → ℝ)
    (hw_nonneg : ∀ j : ℕ, 0 ≤ w_poly j)
    (hw_le : ∀ j : ℕ, w_poly j ≤ (6 * (4 * ((4 / 3 : ℝ) ^ 4 * 4)))⁻¹ * canonicalBalabanEtaStep j)
    (j m : ℕ) (e : Link (dyadicScaleSide L_ir m)) :
    let L_m := dyadicScaleSide L_ir m
    let P_m := (localPolymerRGStateAux L_ir β_uv w_poly j m).polymers
    (∑ i : P_m.idx,
      if e ∈ latticePathSupport L_m (P_m.bases i) (P_m.loops i) then
        ((P_m.loops i).length : ℝ) *
          ((4 / 3 : ℝ) ^ (P_m.loops i).length * (4 * |P_m.weights i|))
      else 0) ≤ canonicalBalabanEtaStep j := by
  cases j with
  | zero =>
      dsimp [localPolymerRGStateAux, InteractingEffectiveActionState.pureWilson,
        PolymerActivityFamily.empty, canonicalBalabanEtaStep]
      simp
  | succ j =>
      dsimp [localPolymerRGStateAux]
      have h_plaq :=
        PolymerActivityFamily.localPlaquette_weighted_incident_sum_le
          (dyadicScaleSide L_ir m) (hw_nonneg (j + 1)) e
      dsimp only at h_plaq
      have h_bound :
          6 * (4 * ((4 / 3 : ℝ) ^ 4 * (4 * w_poly (j + 1)))) ≤
            canonicalBalabanEtaStep (j + 1) := by
        calc
          6 * (4 * ((4 / 3 : ℝ) ^ 4 * (4 * w_poly (j + 1))))
            = (6 * (4 * ((4 / 3 : ℝ) ^ 4 * 4))) * w_poly (j + 1) := by ring
          _ ≤ (6 * (4 * ((4 / 3 : ℝ) ^ 4 * 4))) *
                ((6 * (4 * ((4 / 3 : ℝ) ^ 4 * 4)))⁻¹ * canonicalBalabanEtaStep (j + 1)) :=
              mul_le_mul_of_nonneg_left (hw_le (j + 1)) (by positivity)
          _ = canonicalBalabanEtaStep (j + 1) := by
              rw [← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]
      exact h_plaq.trans h_bound

theorem PolymerActivityFamily.empty_weighted_incident_sum_eq_zero
    (L : ℕ) [NeZero L] (e : Link L) :
    let P := PolymerActivityFamily.empty L
    (∑ i : P.idx,
      if e ∈ latticePathSupport L (P.bases i) (P.loops i) then
        ((P.loops i).length : ℝ) *
          ((4 / 3 : ℝ) ^ (P.loops i).length * (4 * |P.weights i|))
      else 0) = 0 := by
  dsimp [PolymerActivityFamily.empty]
  simp

/-- At the UV scale `m = K` (`K - m = 0`), every `C : MultiStepHaarRGChain L_ir K β_uv` has
`C.state K = pureWilson (dyadicScaleSide L_ir K) β_uv` with `polymers = PolymerActivityFamily.empty`,
so the `(4 / 3)^length`-weighted incident-loop sum vanishes identically (`= canonicalBalabanEtaStep 0`)
unconditionally. -/
theorem MultiStepHaarRGChain.uv_polymer_weighted_incident_sum_eq_zero
    {L_ir : ℕ} [NeZero L_ir] {K : ℕ} {β_uv : ℝ}
    (C : MultiStepHaarRGChain L_ir K β_uv)
    (e : Link (dyadicScaleSide L_ir K)) :
    let L_K := dyadicScaleSide L_ir K
    let P_K := (C.state K).polymers
    (∑ i : P_K.idx,
      if e ∈ latticePathSupport L_K (P_K.bases i) (P_K.loops i) then
        ((P_K.loops i).length : ℝ) *
          ((4 / 3 : ℝ) ^ (P_K.loops i).length * (4 * |P_K.weights i|))
      else 0) = canonicalBalabanEtaStep 0 := by
  have hP : (C.state K).polymers = PolymerActivityFamily.empty (dyadicScaleSide L_ir K) := by
    rw [C.h_uv]
    rfl
  dsimp only
  rw [hP, canonicalBalabanEtaStep_zero]
  exact PolymerActivityFamily.empty_weighted_incident_sum_eq_zero (dyadicScaleSide L_ir K) e

/-- At the UV scale `m = K` (`K - m = 0`), every `C : MultiStepHaarRGChain L_ir K β_uv` has
`(C.state K).R_trunc = 0`, so its two-link mixed difference vanishes identically unconditionally. -/
theorem MultiStepHaarRGChain.uv_R_trunc_twoLinkMixedDifference_eq_zero
    {L_ir : ℕ} [NeZero L_ir] {K : ℕ} {β_uv : ℝ}
    (C : MultiStepHaarRGChain L_ir K β_uv)
    (V : GaugeConfig (dyadicScaleSide L_ir K))
    (e e' : Link (dyadicScaleSide L_ir K)) (g1 g2 h1 h2 : SU2) :
    twoLinkMixedDifference (dyadicScaleSide L_ir K) (C.state K).R_trunc
      V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0 := by
  have hR : (C.state K).R_trunc = fun _ => 0 :=
    congrArg InteractingEffectiveActionState.R_trunc C.h_uv
  rw [hR]
  dsimp [twoLinkMixedDifference]
  ring

/-- Direct telescoping upper bound on the actual multi-step RG chain couplings `(C.state m).β`
from UV scale `m = K` (`(C.state K).β = β_uv` via `C.h_uv`) down to `m = K - j` (`j ≤ K`), without
any auxiliary `β_step` sequence. -/
theorem MultiStepHaarRGChain.beta_state_le_uv_sub_oneLoop_add_twoLoop
    {L_ir : ℕ} [NeZero L_ir] {K : ℕ} {β_uv : ℝ}
    (C : MultiStepHaarRGChain L_ir K β_uv)
    (Δβ_1loop : ℝ) (δ_2loop : ℕ → ℝ)
    (h_drift : ∀ m < K, (C.state m).β ≤ (C.state (m + 1)).β - Δβ_1loop + δ_2loop (K - 1 - m)) :
    (∀ j ≤ K,
      (C.state (K - j)).β ≤
        β_uv - (j : ℝ) * Δβ_1loop + ∑ k ∈ Finset.range j, δ_2loop k) ∧
    (C.state 0).β ≤
      β_uv - (K : ℝ) * Δβ_1loop + ∑ k ∈ Finset.range K, δ_2loop k := by
  have h_uv_beta : (C.state K).β = β_uv := by
    simpa [InteractingEffectiveActionState.pureWilson] using
      congrArg InteractingEffectiveActionState.β C.h_uv
  have h_all : ∀ j ≤ K,
      (C.state (K - j)).β ≤
        β_uv - (j : ℝ) * Δβ_1loop + ∑ k ∈ Finset.range j, δ_2loop k := by
    intro j
    induction j with
    | zero =>
        intro _
        simp [h_uv_beta]
    | succ j ih =>
        intro hj
        have hj_le : j ≤ K := Nat.le_of_succ_le hj
        have h_ih := ih hj_le
        have hm_lt : K - (j + 1) < K := by omega
        have h_step := h_drift (K - (j + 1)) hm_lt
        have h_idx1 : K - (j + 1) + 1 = K - j := by omega
        have h_idx2 : K - 1 - (K - (j + 1)) = j := by omega
        rw [h_idx1, h_idx2] at h_step
        rw [Finset.sum_range_succ, Nat.cast_add, Nat.cast_one]
        linarith
  refine ⟨h_all, ?_⟩
  have hK := h_all K le_rfl
  rw [Nat.sub_self] at hK
  exact hK

/-- Corollary of `MultiStepHaarRGChain.beta_state_le_uv_sub_oneLoop_add_twoLoop`: when the `K`-step
1-loop coupling decrement `(K : ℝ) * Δβ_1loop` absorbs `β_uv - β_target + ∑ k ∈ Finset.range K, δ_2loop k`,
the landed IR coupling `(C.state 0).β` satisfies `(C.state 0).β ≤ β_target`. -/
theorem MultiStepHaarRGChain.beta_state_zero_le_of_drift
    {L_ir : ℕ} [NeZero L_ir] {K : ℕ} {β_uv : ℝ}
    (C : MultiStepHaarRGChain L_ir K β_uv)
    (Δβ_1loop β_target : ℝ) (δ_2loop : ℕ → ℝ)
    (h_drift : ∀ m < K, (C.state m).β ≤ (C.state (m + 1)).β - Δβ_1loop + δ_2loop (K - 1 - m))
    (h_absorb :
      β_uv - β_target + (∑ k ∈ Finset.range K, δ_2loop k) ≤ (K : ℝ) * Δβ_1loop) :
    (C.state 0).β ≤ β_target := by
  have h_tele := (C.beta_state_le_uv_sub_oneLoop_add_twoLoop Δβ_1loop δ_2loop h_drift).2
  linarith

/-- Reversing a replicated step list reverses each step while preserving length `n`. -/
theorem reversePath_replicate (n : ℕ) (s : LatticeStep) :
    reversePath (List.replicate n s) = List.replicate n s.reverse := by
  simp [reversePath]

/-- Any lattice path followed by its `reversePath` has trivial `1 ∈ SU(2)` path holonomy. -/
theorem pathHolonomy_append_reversePath {L : ℕ} (U : GaugeConfig L) (x : Lattice4D L)
    (p : List LatticeStep) :
    pathHolonomy U x (p ++ reversePath p) = 1 := by
  rw [pathHolonomy_append, pathHolonomy_reversePath, mul_inv_cancel]

/-- Degenerate `0 × t` rectangle (`r = 0`) is a 1D backtracking path `p ++ reversePath p` and has
identically trivial `1 ∈ SU(2)` holonomy on every gauge configuration `U`. -/
theorem pathHolonomy_rectangleSteps_zero_left {L : ℕ} (U : GaugeConfig L) (x : Lattice4D L)
    (μ ν : Direction) (t : ℕ) :
    pathHolonomy U x (rectangleSteps μ ν 0 t) = 1 := by
  have h_eq :
      rectangleSteps μ ν 0 t =
        List.replicate t ⟨ν, true⟩ ++ reversePath (List.replicate t ⟨ν, true⟩) := by
    simp [rectangleSteps, reversePath_replicate, LatticeStep.reverse]
  rw [h_eq]
  exact pathHolonomy_append_reversePath U x (List.replicate t ⟨ν, true⟩)

/-- Degenerate `r × 0` rectangle (`t = 0`) is a 1D backtracking path `p ++ reversePath p` and has
identically trivial `1 ∈ SU(2)` holonomy on every gauge configuration `U`. -/
theorem pathHolonomy_rectangleSteps_zero_right {L : ℕ} (U : GaugeConfig L) (x : Lattice4D L)
    (μ ν : Direction) (r : ℕ) :
    pathHolonomy U x (rectangleSteps μ ν r 0) = 1 := by
  have h_eq :
      rectangleSteps μ ν r 0 =
        List.replicate r ⟨μ, true⟩ ++ reversePath (List.replicate r ⟨μ, true⟩) := by
    simp [rectangleSteps, reversePath_replicate, LatticeStep.reverse]
  rw [h_eq]
  exact pathHolonomy_append_reversePath U x (List.replicate r ⟨μ, true⟩)

/-- Step counts and side lengths of the fixed canonical spatial probe `T.ℓ_probe` at IR scale
`T.ℓstar` for any `T : LandingTube P`: both lattice step counts `T.ℓ_probe.stepsμ (T.ℓstar : ℝ)` and
`T.ℓ_probe.stepsν (T.ℓstar : ℝ)` equal `1` (hence `≥ 1`) by `canonicalSpatialProbe_steps`, and both
physical side lengths equal `T.ℓstar` (hence `T.ℓstar ≤ side`). -/
theorem LandingTube.steps_pos_and_ellstar_le_sides
    {P : ContinuumCutoffPath} (T : LandingTube P) :
    1 ≤ T.ℓ_probe.stepsμ (T.ℓstar : ℝ) ∧
    1 ≤ T.ℓ_probe.stepsν (T.ℓstar : ℝ) ∧
    T.ℓstar ≤ T.ℓ_probe.sideμ ∧
    T.ℓstar ≤ T.ℓ_probe.sideν := by
  obtain ⟨hμ, hν⟩ := canonicalSpatialProbe_steps T.hℓstar
  exact ⟨hμ.ge, hν.ge, le_rfl, le_rfl⟩

/-- Unconditional 4-step perimeter lower bound `4 ≤ (T.ℓ_probe.latticeLoop (T.ℓstar : ℝ)).length`
for any `T : LandingTube P`. -/
theorem LandingTube.four_le_latticeLoop_probe_length
    {P : ContinuumCutoffPath} (T : LandingTube P) :
    4 ≤ (T.ℓ_probe.latticeLoop (T.ℓstar : ℝ)).length := by
  obtain ⟨hμ1, hν1, _, _⟩ := T.steps_pos_and_ellstar_le_sides
  simp only [PhysicalRectangle.latticeLoop, rectangleSteps, List.length_append,
    List.length_replicate]
  omega

/-- Unconditional 16-link oscillation lower bound
`16 ≤ probeLoopOscillationBudget (T.ℓstar : ℝ) T.ℓ_probe` for any `T : LandingTube P`. -/
theorem LandingTube.sixteen_le_probeLoopOscillationBudget
    {P : ContinuumCutoffPath} (T : LandingTube P) :
    16 ≤ InteractingEffectiveActionState.probeLoopOscillationBudget (T.ℓstar : ℝ) T.ℓ_probe := by
  have h4 := T.four_le_latticeLoop_probe_length
  have h_ref_eq :
      (T.ℓ_probe.timeReflect.latticeLoop (T.ℓstar : ℝ)).length =
        (T.ℓ_probe.latticeLoop (T.ℓstar : ℝ)).length := rfl
  unfold InteractingEffectiveActionState.probeLoopOscillationBudget
  rw [h_ref_eq]
  have h4_real : (4 : ℝ) ≤ ((T.ℓ_probe.latticeLoop (T.ℓstar : ℝ)).length : ℝ) := by
    exact_mod_cast h4
  push_cast
  linarith

/-- For any `st : InteractingEffectiveActionState L` with `0 ≤ st.β`, if `st.totalAction` is
measurable and bounded, then `st.R_trunc` is measurable and bounded. -/
theorem InteractingEffectiveActionState.measurable_and_bdd_R_trunc_of_totalAction
    {L : ℕ} [NeZero L] (st : InteractingEffectiveActionState L)
    (hβ0 : 0 ≤ st.β)
    (hS_meas : Measurable st.totalAction)
    {B : ℝ} (hS_bdd : ∀ U : GaugeConfig L, |st.totalAction U| ≤ B) :
    Measurable st.R_trunc ∧
    ∃ B_R : ℝ, ∀ U : GaugeConfig L, |st.R_trunc U| ≤ B_R := by
  have h_eq : st.R_trunc = fun U => st.totalAction U - st.localPolymerAction U := by
    funext U
    dsimp [InteractingEffectiveActionState.totalAction,
      InteractingEffectiveActionState.localPolymerAction]
    ring
  have hR_meas : Measurable st.R_trunc := by
    rw [h_eq]
    exact hS_meas.sub st.continuous_localPolymerAction.measurable
  let B_loc : ℝ :=
    |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
      (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|)
  refine ⟨hR_meas, B + B_loc, fun U => ?_⟩
  have hW_nonneg : 0 ≤ wilsonAction st.β U := wilsonAction_nonneg hβ0 U
  have hW_le : wilsonAction st.β U ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
    unfold wilsonAction
    exact mul_le_mul_of_nonneg_left
      (Finset.sum_le_sum fun p _ => plaquetteAction_le_two U p) hβ0
  have hW_abs : |wilsonAction st.β U| ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
    rw [abs_of_nonneg hW_nonneg]
    exact hW_le
  have hP_abs := st.polymers.abs_eval_le U
  have hS_U := hS_bdd U
  have h_loc_le : |st.localPolymerAction U| ≤ B_loc := by
    unfold InteractingEffectiveActionState.localPolymerAction
    have h1 := abs_add_le (st.c_vac + wilsonAction st.β U) (st.polymers.eval U)
    have h2 := abs_add_le st.c_vac (wilsonAction st.β U)
    dsimp [B_loc]
    linarith
  have h_sub_eq : st.R_trunc U = st.totalAction U - st.localPolymerAction U := by
    rw [h_eq]
  rw [h_sub_eq]
  have h_tri := abs_sub (st.totalAction U) (st.localPolymerAction U)
  linarith

/-- Single-step measurability and boundedness of `(C.state m).totalAction` from
`(C.state (m + 1)).R_trunc` via `C.h_step_exact`. -/
theorem MultiStepHaarRGChain.step_totalAction_measurable_and_bdd
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m < K)
    (hR_meas : Measurable (C.state (m + 1)).R_trunc)
    {B_R : ℝ} (hR_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
      |(C.state (m + 1)).R_trunc U| ≤ B_R) :
    let L_m := dyadicScaleSide L_ir m
    Measurable (C.state m).totalAction ∧
    ∃ B_coarse : ℝ, ∀ V : GaugeConfig L_m, |(C.state m).totalAction V| ≤ B_coarse := by
  dsimp only
  let L_m := dyadicScaleSide L_ir m
  let st_fine := C.state (m + 1)
  let st_coarse := C.state m
  let K_fine : GaugeConfig (2 * L_m) → ℝ := fun U => st_fine.polymers.eval U + st_fine.R_trunc U
  have hβ_fine : 0 ≤ st_fine.β := C.h_β_nonneg (m + 1) hm
  have hK_meas : Measurable K_fine :=
    st_fine.polymers.continuous_eval.measurable.add hR_meas
  let B_K : ℝ := (∑ i : st_fine.polymers.idx, 2 * |st_fine.polymers.weights i|) + B_R
  have hK_bounds : ∀ U : GaugeConfig (2 * L_m), -B_K ≤ K_fine U ∧ K_fine U ≤ B_K := fun U => by
    have hP := st_fine.polymers.abs_eval_le U
    have hR := hR_bdd U
    have h_tri := abs_add_le (st_fine.polymers.eval U) (st_fine.R_trunc U)
    exact abs_le.mp (by dsimp [K_fine, B_K]; linarith)
  have h_act_eq : st_coarse.totalAction = fun V =>
      st_fine.c_vac + interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V :=
    funext (C.h_step_exact m hm)
  have hS_coarse_meas : Measurable st_coarse.totalAction := by
    rw [h_act_eq]
    exact measurable_const.add
      (measurable_haarInteractingBlockedEffectiveAction st_fine.β K_fine hK_meas)
  let B_W : ℝ := 2 * st_fine.β * (Fintype.card (Plaquette (2 * L_m)) : ℝ)
  let B_coarse : ℝ := |st_fine.c_vac| + |B_K| + |B_W|
  refine ⟨hS_coarse_meas, B_coarse, fun V => ?_⟩
  have h_sand := (interactingBlockedFiberWeight_zero_remainder_and_exponential_sandwich
    (haarBlockDisintegration L_m) hβ_fine (measurable_wilsonAction st_fine.β)
    K_fine hK_meas hK_bounds V).2.2
  have hW_sand := wilsonBlockedEffectiveAction_bounds_and_exp_neg_eq_weight
    (haarBlockDisintegration L_m) hβ_fine (measurable_wilsonAction st_fine.β) V
  have h_eff_lo : -B_K ≤
      interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V := by
    linarith [h_sand.1, hW_sand.1]
  have h_eff_hi :
      interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V ≤
        B_W + B_K := by
    have h1 : wilsonBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β V ≤ B_W :=
      hW_sand.2.1
    linarith [h_sand.2]
  have h_abs_eff :
      |interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V| ≤
        |B_K| + |B_W| := by
    rw [abs_le]
    refine ⟨?_, ?_⟩
    · have h_bk : B_K ≤ |B_K| := le_abs_self B_K
      have h_bw : 0 ≤ |B_W| := abs_nonneg B_W
      linarith
    · have h_bk : B_K ≤ |B_K| := le_abs_self B_K
      have h_bw : B_W ≤ |B_W| := le_abs_self B_W
      linarith
  rw [C.h_step_exact m hm V]
  have h_tri := abs_add_le st_fine.c_vac
    (interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_fine.β K_fine V)
  dsimp [B_coarse]
  linarith

/-- Every `C : MultiStepHaarRGChain L_ir K β_uv` has measurable and bounded `R_trunc`
at every scale `m ≤ K`, proved by downward induction from `h_uv` (`state K = pureWilson`)
via `h_step_exact` with zero external hypotheses. -/
theorem MultiStepHaarRGChain.measurable_and_bdd_R_trunc
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ}
    (C : MultiStepHaarRGChain L_ir K β_uv) :
    ∀ m ≤ K,
      Measurable (C.state m).R_trunc ∧
      ∃ B_R : ℝ, ∀ U : GaugeConfig (dyadicScaleSide L_ir m), |(C.state m).R_trunc U| ≤ B_R := by
  suffices h_ind : ∀ j ≤ K, ∀ m : ℕ, m + j = K →
      Measurable (C.state m).R_trunc ∧
      ∃ B_R : ℝ, ∀ U : GaugeConfig (dyadicScaleSide L_ir m), |(C.state m).R_trunc U| ≤ B_R by
    intro m hm
    exact h_ind (K - m) (Nat.sub_le K m) m (Nat.add_sub_of_le hm)
  intro j
  induction j with
  | zero =>
    intro _ m hm
    have hmK : m = K := by omega
    subst hmK
    have h_zero : (C.state m).R_trunc = fun _ => 0 := by
      rw [C.h_uv]
      rfl
    refine ⟨by rw [h_zero]; exact measurable_const, 0, fun U => ?_⟩
    rw [h_zero]
    simp
  | succ j ih =>
    intro hj m hm
    have hm_lt : m < K := by omega
    have hj_le : j ≤ K := by omega
    have hm1_eq : (m + 1) + j = K := by omega
    obtain ⟨hR_meas_fine, B_R_fine, hR_bdd_fine⟩ := ih hj_le (m + 1) hm1_eq
    obtain ⟨hS_coarse_meas, B_coarse, hS_coarse_bdd⟩ :=
      C.step_totalAction_measurable_and_bdd hm_lt hR_meas_fine hR_bdd_fine
    exact (C.state m).measurable_and_bdd_R_trunc_of_totalAction
      (C.h_β_nonneg m hm_lt.le) hS_coarse_meas hS_coarse_bdd

/-- Gap 1, Gap 2 & Gap 3 (`BalabanMultiScaleUVToIRFlow P`): multi-scale UV-to-IR Balaban
renormalization-group flow along `P : ContinuumCutoffPath` starting from the bare UV Wilson action
`P.coupling n` (inconsistent with `TwoCutoffComparison`
(`not_twoCutoffComparison_of_balabanMultiScaleUVToIRFlow`); chain pinned
(`MultiStepHaarRGChain.totalAction_eq`)):
1. Runs `K n` dyadic blocking steps from UV spacing `P.spacing n` to physical scale `ℓstar > 0`
   (`P.spacing n * 2 ^ K n = ℓstar`),
2. Tracks the downward running coupling directly on the real chain states
   `((chain n).state m).β ≤ ((chain n).state (m + 1)).β - Δβ_1loop + δ_2loop n (K n - 1 - m)`
   (`m < K n`) with positive cutoff-independent 1-loop decrement `0 < Δβ_1loop` and 2-loop step
   error `0 ≤ δ_2loop n k ≤ (1 / 2) * Δβ_1loop` from `((chain n).state (K n)).β = P.coupling n`
   (`h_uv`) so that `P.coupling n ≥ ((1 / 2) * Δβ_1loop) * K n → ∞` (`tendsto_coupling_atTop`) and
   at `m = 0` the landed IR coupling `((chain n).state 0).β` lands inside the two-sided crossover
   window `canonicalCrossoverBetaLo ≤ ((chain n).state 0).β ≤ canonicalCrossoverBetaHi`,
3. Controls the `(4 / 3)^length`-weighted local polymer incident-loop sum across `m < K n` by the
   concrete contractive step sequence `canonicalBalabanEtaStep (K n - m)` (with the UV base case
   `m = K n` proved unconditionally via `MultiStepHaarRGChain.uv_polymer_weighted_incident_sum_eq_zero`),
   deriving both the volume-independent `PolymerDobrushinNormBound` at every scale `m ≤ K n` and
   `ExponentialRemainderLocalityBound` at `m = 0` (`toExponentialRemainderLocalityBound`),
4. Controls the Peierls large-field truncation neighbor mixed-difference norm directly on the real
   chain states `((chain n).state m).R_trunc` for `m < K n` by `canonicalBalabanDeltaNbStep (K n - m)`
   (with the UV base case `m = K n` proved unconditionally via
   `MultiStepHaarRGChain.uv_R_trunc_twoLinkMixedDifference_eq_zero`), and
5. Derives `steps_pos_and_ellstar_le_sides`, `four_le_latticeLoop_probe_length`,
   `sixteen_le_probeLoopOscillationBudget`, `eventually_char_dom`, and `h_cov_enclosure` inside
   `toInductiveStepAndBlockBounds` from the 6-face unit 3-cube degree-4 pure-Wilson
   `((3 / 4) * (1 / 4) ^ 5) * β ^ 4` Haar character probe floor `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`) and local
   single-link remainder oscillation `h_rem_local_osc` (whereas `hZ_factor_le_one` was conditional
   on `hC.hZ_eq` and the perimeter-corner scheme). -/
structure BalabanMultiScaleUVToIRFlow (P : ContinuumCutoffPath) where
  ℓstar : ℚ
  hℓstar : 0 < ℓstar
  K : ℕ → ℕ
  hK : ∀ᶠ n in atTop, P.spacing n * (2 : ℝ) ^ K n = (ℓstar : ℝ)
  irSide : ℕ → ℕ
  [instNeZeroIrSide : ∀ n : ℕ, NeZero (irSide n)]
  hside : ∀ᶠ n in atTop, P.side n = dyadicScaleSide (irSide n) (K n)
  chain : ∀ n : ℕ, MultiStepHaarRGChain (irSide n) (K n) (P.coupling n)
  Δβ_1loop : ℝ
  hΔβ_1loop_pos : 0 < Δβ_1loop
  δ_2loop : ℕ → ℕ → ℝ
  hδ_2loop_bounds : ∀ (n k : ℕ), 0 ≤ δ_2loop n k ∧ δ_2loop n k ≤ (1 / 2 : ℝ) * Δβ_1loop
  h_β_drift : ∀ (n m : ℕ), m < K n →
    ((chain n).state m).β ≤ ((chain n).state (m + 1)).β - Δβ_1loop + δ_2loop n (K n - 1 - m)
  h_β_absorb : ∀ᶠ n in atTop,
    P.coupling n - (canonicalCrossoverBetaHi : ℝ) +
      (∑ k ∈ Finset.range (K n), δ_2loop n k) ≤ (K n : ℝ) * Δβ_1loop
  h_β_ir_lo : ∀ᶠ n in atTop,
    (canonicalCrossoverBetaLo : ℝ) ≤ ((chain n).state 0).β
  h_polymer_local : ∀ n : ℕ, 0 < K n →
    let L_m := dyadicScaleSide (irSide n) 0
    let P_m := ((chain n).state 0).polymers
    ∀ e : Link L_m,
      (∑ i : P_m.idx,
        if e ∈ latticePathSupport L_m (P_m.bases i) (P_m.loops i) then
          ((P_m.loops i).length : ℝ) *
            ((4 / 3 : ℝ) ^ (P_m.loops i).length * (4 * |P_m.weights i|))
        else 0) ≤ canonicalBalabanEtaStep (K n - 0)
  h_R_mixed : ∀ n : ℕ, 0 < K n →
    ∀ (V : GaugeConfig (dyadicScaleSide (irSide n) 0))
      (e e' : Link (dyadicScaleSide (irSide n) 0)) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference (dyadicScaleSide (irSide n) 0)
        ((chain n).state 0).R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
        if e' ∈ dobrushinNeighbors e then canonicalBalabanDeltaNbStep (K n - 0) else 0
  Z_tube : LoopRenormalization P.toCutoffPath
  hZ_tube_scheme :
    ∃ m c : ℕ → ℝ,
      Z_tube = YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m c
  h_rem_local_osc : ∀ (n : ℕ) (V : GaugeConfig (irSide n)) (e : Link (irSide n)) (g1 g2 : SU2),
    InteractingEffectiveActionState.probeLoopOscillationBudget (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar) *
      |(((chain n).state 0).polymers.eval (updateGaugeLink (irSide n) V e.x e.μ g1) +
          ((chain n).state 0).R_trunc (updateGaugeLink (irSide n) V e.x e.μ g1)) -
        (((chain n).state 0).polymers.eval (updateGaugeLink (irSide n) V e.x e.μ g2) +
          ((chain n).state 0).R_trunc (updateGaugeLink (irSide n) V e.x e.μ g2))| ≤
      (canonicalCrossoverCovLo : ℝ) / 24

attribute [instance] BalabanMultiScaleUVToIRFlow.instNeZeroIrSide

/-- Canonical spatial probe `canonicalSpatialProbe M.ℓstar M.hℓstar` fixed by definition for any
`M : BalabanMultiScaleUVToIRFlow P`. -/
abbrev BalabanMultiScaleUVToIRFlow.ℓ_probe {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P) : PhysicalRectangle :=
  canonicalSpatialProbe M.ℓstar M.hℓstar

/-- Positive Euclidean time of `M.ℓ_probe`. -/
theorem BalabanMultiScaleUVToIRFlow.hℓ_probe_pos {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P) :
    M.ℓ_probe.IsPositiveTime :=
  canonicalSpatialProbe_isPositiveTime M.hℓstar

/-- Step counts and side lengths of the fixed canonical spatial probe `M.ℓ_probe` at IR scale
`M.ℓstar`: both lattice step counts `M.ℓ_probe.stepsμ (M.ℓstar : ℝ)` and
`M.ℓ_probe.stepsν (M.ℓstar : ℝ)` equal `1` (hence `≥ 1`) by `canonicalSpatialProbe_steps`, and both
physical side lengths equal `M.ℓstar` (hence `M.ℓstar ≤ side`). -/
theorem BalabanMultiScaleUVToIRFlow.steps_pos_and_ellstar_le_sides
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    1 ≤ M.ℓ_probe.stepsμ (M.ℓstar : ℝ) ∧
    1 ≤ M.ℓ_probe.stepsν (M.ℓstar : ℝ) ∧
    M.ℓstar ≤ M.ℓ_probe.sideμ ∧
    M.ℓstar ≤ M.ℓ_probe.sideν := by
  obtain ⟨hμ, hν⟩ := canonicalSpatialProbe_steps M.hℓstar
  exact ⟨hμ.ge, hν.ge, le_rfl, le_rfl⟩

/-- Unconditional 4-step perimeter lower bound `4 ≤ (M.ℓ_probe.latticeLoop (M.ℓstar : ℝ)).length`. -/
theorem BalabanMultiScaleUVToIRFlow.four_le_latticeLoop_probe_length
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    4 ≤ (M.ℓ_probe.latticeLoop (M.ℓstar : ℝ)).length := by
  obtain ⟨hμ1, hν1, _, _⟩ := M.steps_pos_and_ellstar_le_sides
  simp only [PhysicalRectangle.latticeLoop, rectangleSteps, List.length_append,
    List.length_replicate]
  omega

/-- Non-emptiness `1 ≤ (M.ℓ_probe.latticeLoop (M.ℓstar : ℝ)).length` of the coarse lattice probe
loop. -/
theorem BalabanMultiScaleUVToIRFlow.one_le_latticeLoop_probe_length
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    1 ≤ (M.ℓ_probe.latticeLoop (M.ℓstar : ℝ)).length :=
  by linarith [M.four_le_latticeLoop_probe_length]

/-- Unconditional 16-link oscillation lower bound
`16 ≤ probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe` for any `M : BalabanMultiScaleUVToIRFlow P`. -/
theorem BalabanMultiScaleUVToIRFlow.sixteen_le_probeLoopOscillationBudget
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    16 ≤ InteractingEffectiveActionState.probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe := by
  have h4 := M.four_le_latticeLoop_probe_length
  have h_ref_eq :
      (M.ℓ_probe.timeReflect.latticeLoop (M.ℓstar : ℝ)).length =
        (M.ℓ_probe.latticeLoop (M.ℓstar : ℝ)).length := rfl
  unfold InteractingEffectiveActionState.probeLoopOscillationBudget
  rw [h_ref_eq]
  have h4_real : (4 : ℝ) ≤ ((M.ℓ_probe.latticeLoop (M.ℓstar : ℝ)).length : ℝ) := by
    exact_mod_cast h4
  push_cast
  linarith

/-- Unconditional lower bound `1 ≤ probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe` for any
`M : BalabanMultiScaleUVToIRFlow P`. -/
theorem BalabanMultiScaleUVToIRFlow.one_le_probeLoopOscillationBudget
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    1 ≤ InteractingEffectiveActionState.probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe :=
  by linarith [M.sixteen_le_probeLoopOscillationBudget]

/-- Canonical per-link remainder oscillation budget
`M.δ_rem_link n := ((canonicalCrossoverCovLo : ℝ) / 24) / probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe`
derived from `M` without requiring a separate structure field. -/
noncomputable def BalabanMultiScaleUVToIRFlow.δ_rem_link
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (_n : ℕ) : ℝ :=
  ((canonicalCrossoverCovLo : ℝ) / 24) /
    InteractingEffectiveActionState.probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe

/-- Non-negativity `0 ≤ M.δ_rem_link n`. -/
theorem BalabanMultiScaleUVToIRFlow.hδ_rem_link_nonneg
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (n : ℕ) :
    0 ≤ M.δ_rem_link n := by
  unfold BalabanMultiScaleUVToIRFlow.δ_rem_link
  have h_cov : (0 : ℝ) ≤ (canonicalCrossoverCovLo : ℝ) / 24 := by
    norm_num [canonicalCrossoverCovLo]
  have h_bud := InteractingEffectiveActionState.probeLoopOscillationBudget_nonneg
    (M.ℓstar : ℝ) M.ℓ_probe
  exact div_nonneg h_cov h_bud

/-- Derived single-link remainder oscillation bound `≤ M.δ_rem_link n` at scale `m = 0`. -/
theorem BalabanMultiScaleUVToIRFlow.rem_singleLink_osc_le_δ_rem_link
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (n : ℕ) (V : GaugeConfig (M.irSide n)) (e : Link (M.irSide n)) (g1 g2 : SU2) :
    |(((M.chain n).state 0).polymers.eval (updateGaugeLink (M.irSide n) V e.x e.μ g1) +
        ((M.chain n).state 0).R_trunc (updateGaugeLink (M.irSide n) V e.x e.μ g1)) -
      (((M.chain n).state 0).polymers.eval (updateGaugeLink (M.irSide n) V e.x e.μ g2) +
        ((M.chain n).state 0).R_trunc (updateGaugeLink (M.irSide n) V e.x e.μ g2))| ≤
      M.δ_rem_link n := by
  unfold BalabanMultiScaleUVToIRFlow.δ_rem_link
  have h_pos :
      0 < InteractingEffectiveActionState.probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe :=
    lt_of_lt_of_le zero_lt_one M.one_le_probeLoopOscillationBudget
  rw [le_div_iff₀' h_pos]
  exact M.h_rem_local_osc n V e g1 g2

/-- Derived budget product bound
`probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe * M.δ_rem_link n ≤ (canonicalCrossoverCovLo : ℝ) / 24`. -/
theorem BalabanMultiScaleUVToIRFlow.hδ_rem_link_le
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (n : ℕ) :
    InteractingEffectiveActionState.probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe *
      M.δ_rem_link n ≤ (canonicalCrossoverCovLo : ℝ) / 24 := by
  unfold BalabanMultiScaleUVToIRFlow.δ_rem_link
  have h_pos :
      0 < InteractingEffectiveActionState.probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe :=
    lt_of_lt_of_le zero_lt_one M.one_le_probeLoopOscillationBudget
  rw [mul_div_cancel₀ _ h_pos.ne']

/-- Landed scale `m = 0` (including `M.K n = 0` via `C.h_uv`) satisfies the
`(4 / 3)^length`-weighted incident-loop sum bound `≤ canonicalBalabanEtaStep (M.K n - 0)`. -/
theorem BalabanMultiScaleUVToIRFlow.polymer_weighted_incident_sum_le_state_zero
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (n : ℕ)
    (e : Link (dyadicScaleSide (M.irSide n) 0)) :
    let L_m := dyadicScaleSide (M.irSide n) 0
    let P_m := ((M.chain n).state 0).polymers
    (∑ i : P_m.idx,
      if e ∈ latticePathSupport L_m (P_m.bases i) (P_m.loops i) then
        ((P_m.loops i).length : ℝ) *
          ((4 / 3 : ℝ) ^ (P_m.loops i).length * (4 * |P_m.weights i|))
      else 0) ≤ canonicalBalabanEtaStep (M.K n - 0) := by
  suffices ∀ (m : ℕ), m = 0 → m ≤ M.K n →
      ∀ (e : Link (dyadicScaleSide (M.irSide n) m)),
        let L_m := dyadicScaleSide (M.irSide n) m
        let P_m := ((M.chain n).state m).polymers
        (∑ i : P_m.idx,
          if e ∈ latticePathSupport L_m (P_m.bases i) (P_m.loops i) then
            ((P_m.loops i).length : ℝ) *
              ((4 / 3 : ℝ) ^ (P_m.loops i).length * (4 * |P_m.weights i|))
          else 0) ≤ canonicalBalabanEtaStep (M.K n - m) from
    this 0 rfl (Nat.zero_le (M.K n)) e
  intro m hm0 hm e
  rcases lt_or_eq_of_le hm with hlt | rfl
  · subst hm0
    exact M.h_polymer_local n hlt e
  · simpa [Nat.sub_self] using
      (M.chain n).uv_polymer_weighted_incident_sum_eq_zero e |>.le

/-- Landed scale `m = 0` has `Measurable ((M.chain n).state 0).R_trunc` unconditionally via
`MultiStepHaarRGChain.measurable_and_bdd_R_trunc`. -/
theorem BalabanMultiScaleUVToIRFlow.measurable_R_trunc_state_zero
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (n : ℕ) :
    Measurable ((M.chain n).state 0).R_trunc :=
  ((M.chain n).measurable_and_bdd_R_trunc 0 (Nat.zero_le (M.K n))).1

/-- Landed scale `m = 0` of the real chain `(M.chain n).state 0` in `M : BalabanMultiScaleUVToIRFlow P`
satisfies the volume-independent step bound
`PolymerDobrushinNormBound ((M.chain n).state 0).polymers (canonicalBalabanEtaStep (M.K n - 0))`. -/
theorem BalabanMultiScaleUVToIRFlow.polymerDobrushinNormBound_step_zero
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (n : ℕ) :
    PolymerDobrushinNormBound ((M.chain n).state 0).polymers
      (canonicalBalabanEtaStep (M.K n - 0)) := by
  refine PolymerActivityFamily.polymerDobrushinNormBound_of_local_support
    ((M.chain n).state 0).polymers
    (canonicalBalabanEtaStep_nonneg (M.K n - 0))
    (fun e => ?_)
  refine (Finset.sum_le_sum fun i _ => ?_).trans
    (M.polymer_weighted_incident_sum_le_state_zero n e)
  split_ifs with he
  · have h_pow : (1 : ℝ) ≤ (4 / 3 : ℝ) ^ (((M.chain n).state 0).polymers.loops i).length :=
      one_le_pow₀ (by norm_num)
    have h_len : (0 : ℝ) ≤ ((((M.chain n).state 0).polymers.loops i).length : ℝ) :=
      Nat.cast_nonneg _
    have h_w : (0 : ℝ) ≤ 4 * |((M.chain n).state 0).polymers.weights i| := by positivity
    nlinarith [mul_le_mul_of_nonneg_right h_pow h_w]
  · exact le_rfl

/-- Landed scale `m = 0` of the real chain `(M.chain n).state 0` in `M : BalabanMultiScaleUVToIRFlow P`
satisfies the volume-independent `PolymerDobrushinNormBound ((M.chain n).state 0).polymers (canonicalCrossoverEtaHi : ℝ)`. -/
theorem BalabanMultiScaleUVToIRFlow.polymerDobrushinNormBound_state_zero
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (n : ℕ) :
    PolymerDobrushinNormBound ((M.chain n).state 0).polymers (canonicalCrossoverEtaHi : ℝ) :=
  (M.polymerDobrushinNormBound_step_zero n).mono
    (canonicalBalabanEtaStep_le_canonicalCrossoverEtaHi (M.K n - 0))

/-- Landed scale `m = 0` of the real chain `(M.chain n).state 0` in `M : BalabanMultiScaleUVToIRFlow P`
has plaquette-neighbor two-link mixed differences of `R_trunc` bounded by
`((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ))`. -/
theorem BalabanMultiScaleUVToIRFlow.R_trunc_mixedDifference_le_state_zero
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (n : ℕ)
    (V : GaugeConfig (dyadicScaleSide (M.irSide n) 0))
    (e e' : Link (dyadicScaleSide (M.irSide n) 0)) (g1 g2 h1 h2 : SU2) :
    |twoLinkMixedDifference (dyadicScaleSide (M.irSide n) 0)
      ((M.chain n).state 0).R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
      if e' ∈ dobrushinNeighbors e then
        ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ))
      else 0 := by
  suffices ∀ (m : ℕ), m = 0 → m ≤ M.K n →
      ∀ (V : GaugeConfig (dyadicScaleSide (M.irSide n) m))
        (e e' : Link (dyadicScaleSide (M.irSide n) m)) (g1 g2 h1 h2 : SU2),
        |twoLinkMixedDifference (dyadicScaleSide (M.irSide n) m)
          ((M.chain n).state m).R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
          if e' ∈ dobrushinNeighbors e then
            ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ))
          else 0 from
    this 0 rfl (Nat.zero_le (M.K n)) V e e' g1 g2 h1 h2
  intro m hm0 hm V e e' g1 g2 h1 h2
  have h_δ_le :
      canonicalBalabanDeltaNbStep (M.K n - m) ≤
        ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ)) :=
    (canonicalBalabanDeltaNbStep_le (M.K n - m)).1
  rcases lt_or_eq_of_le hm with hlt | rfl
  · subst hm0
    have h_mk := M.h_R_mixed n hlt V e e' g1 g2 h1 h2
    split_ifs at h_mk ⊢ with h_mem
    · exact h_mk.trans h_δ_le
    · exact h_mk
  · rw [(M.chain n).uv_R_trunc_twoLinkMixedDifference_eq_zero V e e' g1 g2 h1 h2, abs_zero]
    split_ifs <;> norm_num

/-- Off-neighbor vanishing of the two-link mixed difference of `((M.chain n).state 0).R_trunc`
required by `M.h_R_mixed`: whenever `e' ∉ dobrushinNeighbors e`,
`twoLinkMixedDifference (dyadicScaleSide (M.irSide n) 0) ((M.chain n).state 0).R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0`. -/
theorem BalabanMultiScaleUVToIRFlow.twoLinkMixedDifference_R_trunc_eq_zero_of_not_mem_dobrushinNeighbors
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (n : ℕ)
    (V : GaugeConfig (dyadicScaleSide (M.irSide n) 0))
    {e e' : Link (dyadicScaleSide (M.irSide n) 0)} (h_not_mem : e' ∉ dobrushinNeighbors e)
    (g1 g2 h1 h2 : SU2) :
    twoLinkMixedDifference (dyadicScaleSide (M.irSide n) 0)
      ((M.chain n).state 0).R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2 = 0 := by
  have h_le := M.R_trunc_mixedDifference_le_state_zero n V e e' g1 g2 h1 h2
  simp only [h_not_mem, ↓reduceIte] at h_le
  exact abs_nonpos_iff.mp h_le

/-- Landed infrared scale `m = 0` of `(M.chain n).state 0` satisfies
`TruncationDobrushinNormBound ((M.chain n).state 0).R_trunc (canonicalCrossoverEpsHi : ℝ)`
with finite-lattice Boltzmann integrability `∃ B, ∀ V, |R_trunc V| ≤ B` derived from the local
single-link oscillation bounds `h_rem_local_osc` and `polymerDobrushinNormBound_state_zero`. -/
theorem BalabanMultiScaleUVToIRFlow.truncationDobrushinNormBound_state_zero
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (n : ℕ) :
    TruncationDobrushinNormBound ((M.chain n).state 0).R_trunc (canonicalCrossoverEpsHi : ℝ) := by
  let L₀ := M.irSide n
  let st₀ := (M.chain n).state 0
  have h_poly0 : PolymerDobrushinNormBound st₀.polymers (canonicalCrossoverEtaHi : ℝ) :=
    M.polymerDobrushinNormBound_state_zero n
  have hR_osc (V : GaugeConfig L₀) (e : Link L₀) (g1 g2 : SU2) :
      |st₀.R_trunc (updateGaugeLink L₀ V e.x e.μ g1) -
        st₀.R_trunc (updateGaugeLink L₀ V e.x e.μ g2)| ≤
        M.δ_rem_link n + (canonicalCrossoverEtaHi : ℝ) := by
    have h_split :
        st₀.R_trunc (updateGaugeLink L₀ V e.x e.μ g1) -
          st₀.R_trunc (updateGaugeLink L₀ V e.x e.μ g2) =
        ((st₀.polymers.eval (updateGaugeLink L₀ V e.x e.μ g1) +
            st₀.R_trunc (updateGaugeLink L₀ V e.x e.μ g1)) -
          (st₀.polymers.eval (updateGaugeLink L₀ V e.x e.μ g2) +
            st₀.R_trunc (updateGaugeLink L₀ V e.x e.μ g2))) -
        (st₀.polymers.eval (updateGaugeLink L₀ V e.x e.μ g1) -
          st₀.polymers.eval (updateGaugeLink L₀ V e.x e.μ g2)) := by ring
    rw [h_split]
    exact (abs_sub _ _).trans
      (add_le_add (M.rem_singleLink_osc_le_δ_rem_link n V e g1 g2) (h_poly0.2.1 V e g1 g2))
  let B_R : ℝ :=
    (Fintype.card (Link L₀) : ℝ) * (M.δ_rem_link n + (canonicalCrossoverEtaHi : ℝ)) +
      |st₀.R_trunc (vacuumConfig L₀)|
  have hR_bdd (V : GaugeConfig L₀) : |st₀.R_trunc V| ≤ B_R := by
    have h_diff := abs_sub_le_card_mul_singleLink_osc st₀.R_trunc hR_osc V (vacuumConfig L₀)
    have h_tri : |st₀.R_trunc V| ≤
        |st₀.R_trunc V - st₀.R_trunc (vacuumConfig L₀)| + |st₀.R_trunc (vacuumConfig L₀)| := by
      simpa using abs_add_le
        (st₀.R_trunc V - st₀.R_trunc (vacuumConfig L₀)) (st₀.R_trunc (vacuumConfig L₀))
    dsimp [B_R]
    linarith
  have h_eps_eq :
      18 * (((1 / 18 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ))) =
        (canonicalCrossoverEpsHi : ℝ) := by
    norm_num [canonicalCrossoverEpsHi]
  rw [← h_eps_eq]
  refine truncationDobrushinNormBound_of_dobrushinNeighbors_bound
    st₀.R_trunc
    (by norm_num : (0 : ℝ) ≤ ((1 / 18 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ)))
    hR_bdd
    (M.measurable_R_trunc_state_zero n)
    fun V e e' g1 g2 h1 h2 => ?_
  have h_mk := M.R_trunc_mixedDifference_le_state_zero n V e e' g1 g2 h1 h2
  split_ifs at h_mk ⊢ with h_mem
  · exact h_mk.trans (by norm_num)
  · exact h_mk

/-- Crossover character-dominance inequality derived from the fields `h_β_ir_lo` and `h_rem_local_osc` of `M`:
derives the Georgii Theorem 8.23 dominance inequality
`(canonicalCrossoverCovLo : ℝ) + 3 * probeLoopOscillationBudget (ℓstar : ℝ) ℓ_probe * (Real.exp (2 * δ_rem_link n) - 1) ≤ ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * (((chain n).state 0).β) ^ 4`
eventually in `n` directly from `M.h_β_ir_lo` and `M.h_rem_local_osc`, with zero `c_char`,
`h_char_dom`, `δ_rem_link`, `hδ_rem_link_nonneg`, or `hδ_rem_link_le` fields in
`BalabanMultiScaleUVToIRFlow`. -/
theorem BalabanMultiScaleUVToIRFlow.eventually_char_dom
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    ∀ᶠ n in atTop,
      (canonicalCrossoverCovLo : ℝ) +
        3 * InteractingEffectiveActionState.probeLoopOscillationBudget (M.ℓstar : ℝ) M.ℓ_probe *
          (Real.exp (2 * M.δ_rem_link n) - 1) ≤
        ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * (((M.chain n).state 0).β) ^ 4 := by
  filter_upwards [M.h_β_ir_lo] with n hβ_lo
  exact InteractingEffectiveActionState.canonicalCrossover_char_dom_three_fourths_of_beta_lo_and_one_le_osc
    hβ_lo (M.hδ_rem_link_nonneg n) M.one_le_probeLoopOscillationBudget (M.hδ_rem_link_le n)

/-! ### Stage p3.B3 (Part 2): `BalabanMultiScaleUVToIRFlow.WilsonCharFloor` and Conditional Bridge from `CanonicalProbeClusterRemainder` -/

theorem BalabanMultiScaleUVToIRFlow.eventually_gt_irSide {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P) (B : ℕ) : ∀ᶠ n in atTop, B < M.irSide n := by
  have hℓ_pos : (0 : ℝ) < (M.ℓstar : ℝ) := Rat.cast_pos.mpr M.hℓstar
  have h_phys :
      ∀ᶠ n in atTop, ((B : ℝ) + 1) * (M.ℓstar : ℝ) ≤ (P.side n : ℝ) * P.spacing n :=
    (tendsto_atTop.mp P.physicalSide_tendsto_atTop) (((B : ℝ) + 1) * (M.ℓstar : ℝ))
  filter_upwards [h_phys, M.hK, M.hside] with n h_le hK hside
  have h_prod_eq : (P.side n : ℝ) * P.spacing n = (M.irSide n : ℝ) * (M.ℓstar : ℝ) := by
    rw [hside, dyadicScaleSide_eq_two_pow_mul, ← hK]
    push_cast
    ring
  rw [h_prod_eq] at h_le
  have h_le_ir : (B : ℝ) + 1 ≤ (M.irSide n : ℝ) := le_of_mul_le_mul_right h_le hℓ_pos
  have h_lt_real : (B : ℝ) < (M.irSide n : ℝ) := by linarith
  exact Nat.cast_lt.mp h_lt_real

theorem BalabanMultiScaleUVToIRFlow.eventually_le_K {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P) (m : ℕ) : ∀ᶠ n in atTop, m ≤ M.K n := by
  have hℓ_pos : (0 : ℝ) < (M.ℓstar : ℝ) / (2 : ℝ) ^ m := by
    have : (0 : ℝ) < (M.ℓstar : ℝ) := Rat.cast_pos.mpr M.hℓstar
    positivity
  have h_sp_lt : ∀ᶠ n in atTop, P.spacing n < (M.ℓstar : ℝ) / (2 : ℝ) ^ m :=
    P.spacing_tendsto_zero.eventually (Iio_mem_nhds hℓ_pos)
  filter_upwards [h_sp_lt, M.hK] with n hn hKn
  by_contra h_not
  have h_pow : (2 : ℝ) ^ (M.K n) ≤ (2 : ℝ) ^ m := pow_le_pow_right₀ (by norm_num) (by omega)
  have h1 : P.spacing n * (2 : ℝ) ^ m < (M.ℓstar : ℝ) := (lt_div_iff₀ (by positivity)).mp hn
  have h2 : P.spacing n * (2 : ℝ) ^ (M.K n) ≤ P.spacing n * (2 : ℝ) ^ m :=
    mul_le_mul_of_nonneg_left h_pow (P.spacing_pos n).le
  linarith

theorem BalabanMultiScaleUVToIRFlow.eventually_beta_state_zero_mem_window {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P) :
    ∀ᶠ n in atTop, (canonicalCrossoverBetaLo : ℝ) ≤ ((M.chain n).state 0).β ∧
      ((M.chain n).state 0).β ≤ (canonicalCrossoverBetaHi : ℝ) := by
  filter_upwards [M.h_β_ir_lo, M.h_β_absorb] with n hlo h_abs
  exact ⟨hlo, (M.chain n).beta_state_zero_le_of_drift
    M.Δβ_1loop (canonicalCrossoverBetaHi : ℝ) (M.δ_2loop n) (M.h_β_drift n) h_abs⟩

/-- The statement (formerly the field `h_wilson_char_floor`), as a Prop on `M` (character-for-character the
field text, with `ℓstar`, `hℓstar`, `chain`, `irSide` prefixed by `M.`). -/
def BalabanMultiScaleUVToIRFlow.WilsonCharFloor {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P) : Prop :=
  ∀ᶠ n in atTop,
    ((3 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * (((M.chain n).state 0).β) ^ 4 ≤
      |irCov (wilsonMeasure (gaugeHaarMeasure (M.irSide n)) ((M.chain n).state 0).β)
        (physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) (canonicalSpatialProbe M.ℓstar M.hℓstar).timeReflect)
        (physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) (canonicalSpatialProbe M.ℓstar M.hℓstar))|

/-- CONDITIONAL: (on `CanonicalProbeClusterRemainder canonicalCrossoverBetaHi`, R1). For every `M`, R1 implies
the statement `M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`). This reduces it to R1; it does not prove it. -/
theorem BalabanMultiScaleUVToIRFlow.wilsonCharFloor_of_clusterRemainder {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P)
    (hR : CanonicalProbeClusterRemainder (canonicalCrossoverBetaHi : ℝ)) : M.WilsonCharFloor := by
  filter_upwards [M.eventually_gt_irSide 3, M.eventually_beta_state_zero_mem_window] with
    n hL ⟨hlo, hhi⟩
  have hβ_pos : 0 < ((M.chain n).state 0).β := by
    have : (0 : ℝ) < (canonicalCrossoverBetaLo : ℝ) := by norm_num [canonicalCrossoverBetaLo]
    linarith
  rw [wilsonProbeCov_eq (M.irSide n) (((M.chain n).state 0).β) M.hℓstar]
  exact wilsonProbeCov_floor_of_clusterRemainder hR (by omega) hβ_pos hhi

/-- Unconditional pure-Wilson character covariance floor `M.WilsonCharFloor` along any
`M : BalabanMultiScaleUVToIRFlow P`, derived by discharging `CanonicalProbeClusterRemainder canonicalCrossoverBetaHi`
via `canonicalProbeClusterRemainder_canonicalCrossoverBetaHi`. -/
theorem BalabanMultiScaleUVToIRFlow.wilsonCharFloor {P : ContinuumCutoffPath}
    (M : BalabanMultiScaleUVToIRFlow P) : M.WilsonCharFloor :=
  M.wilsonCharFloor_of_clusterRemainder canonicalProbeClusterRemainder_canonicalCrossoverBetaHi

/-- Every `BalabanMultiScaleUVToIRFlow P` canonically constructs `InductiveStepAndBlockBounds P`;
takes `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`). -/
noncomputable def BalabanMultiScaleUVToIRFlow.toInductiveStepAndBlockBounds
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (hF : M.WilsonCharFloor) :
    InductiveStepAndBlockBounds P where
  ℓstar := M.ℓstar
  hℓstar := M.hℓstar
  K := M.K
  hK := M.hK
  irSide := M.irSide
  hside := M.hside
  chain := M.chain
  η_step := fun _ => canonicalBalabanEtaStep
  hη_init := fun _ => canonicalBalabanEtaStep_init_le
  hη_contraction := fun _ => canonicalBalabanEtaStep_step_le
  h_ir_polymer_le := fun n => by
    simpa [Nat.sub_zero] using M.polymerDobrushinNormBound_step_zero n
  h_ir_β_and_trunc := by
    filter_upwards [M.h_β_absorb] with n h_abs
    have h_β_land : ((M.chain n).state 0).β ≤ (canonicalCrossoverBetaHi : ℝ) :=
      (M.chain n).beta_state_zero_le_of_drift
        M.Δβ_1loop (canonicalCrossoverBetaHi : ℝ) (M.δ_2loop n)
        (M.h_β_drift n) h_abs
    exact ⟨h_β_land, M.truncationDobrushinNormBound_state_zero n⟩
  Z_tube := M.Z_tube
  hZ_tube_scheme := M.hZ_tube_scheme
  h_cov_enclosure := by
    filter_upwards [M.h_β_absorb, hF, M.eventually_char_dom] with
      n h_abs h_floor h_dom
    have h_β_land : ((M.chain n).state 0).β ≤ (canonicalCrossoverBetaHi : ℝ) :=
      (M.chain n).beta_state_zero_le_of_drift
        M.Δβ_1loop (canonicalCrossoverBetaHi : ℝ) (M.δ_2loop n)
        (M.h_β_drift n) h_abs
    have h_trunc0 :
        TruncationDobrushinNormBound ((M.chain n).state 0).R_trunc (canonicalCrossoverEpsHi : ℝ) :=
      M.truncationDobrushinNormBound_state_zero n
    obtain ⟨B_R, hR_bdd⟩ := h_trunc0.1
    have hβ0 : 0 ≤ ((M.chain n).state 0).β := (M.chain n).h_β_nonneg 0 (Nat.zero_le _)
    have hf_meas :
        Measurable (physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe.timeReflect) :=
      (continuous_physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe.timeReflect).measurable
    have hg_meas :
        Measurable (physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe) :=
      (continuous_physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe).measurable
    have hf_bdd (V : GaugeConfig (M.irSide n)) :
        |physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe.timeReflect V| ≤ 1 :=
      abs_physicalWilsonLoop_le_one (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe.timeReflect V
    have hg_bdd (V : GaugeConfig (M.irSide n)) :
        |physicalWilsonLoop (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe V| ≤ 1 :=
      abs_physicalWilsonLoop_le_one (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe V
    have h_osc_probe :=
      InteractingEffectiveActionState.sum_linkOscillation_undressed_physicalWilsonLoop_probe_le
        (M.irSide n) (M.ℓstar : ℝ) M.ℓ_probe
    exact ((M.chain n).state 0).irCov_lower_bound_of_wilson_character_floor_local
      (M.hδ_rem_link_nonneg n) hβ0 h_β_land h_trunc0.2.1 hR_bdd
      (M.rem_singleLink_osc_le_δ_rem_link n)
      hf_meas hf_bdd hg_meas hg_bdd h_osc_probe h_floor h_dom

/-- Every `BalabanMultiScaleUVToIRFlow P` canonically constructs a `LandingTube P`;
takes `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`). -/
noncomputable def BalabanMultiScaleUVToIRFlow.toLandingTube
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (hF : M.WilsonCharFloor) :
    LandingTube P :=
  (M.toInductiveStepAndBlockBounds hF).toIntervalArithmeticCrossoverCertificate.toLandingTube

/-- Along any `M : BalabanMultiScaleUVToIRFlow P`, the dyadic blocking depth `M.K n` diverges to
`atTop` as `n → ∞`. -/
theorem BalabanMultiScaleUVToIRFlow.tendsto_K_atTop
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    Tendsto M.K atTop atTop :=
  tendsto_atTop.mpr fun m => M.eventually_le_K m

/-- At every cutoff `n`, the UV bare coupling `P.coupling n` of `M : BalabanMultiScaleUVToIRFlow P`
is bounded below by `((1 / 2) * M.Δβ_1loop) * (M.K n : ℝ)`. -/
theorem BalabanMultiScaleUVToIRFlow.half_oneLoop_mul_K_le_coupling
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (n : ℕ) :
    ((1 / 2 : ℝ) * M.Δβ_1loop) * (M.K n : ℝ) ≤ P.coupling n := by
  have h_tele :=
    ((M.chain n).beta_state_le_uv_sub_oneLoop_add_twoLoop
      M.Δβ_1loop (M.δ_2loop n) (M.h_β_drift n)).2
  have h_β0 : 0 ≤ ((M.chain n).state 0).β := (M.chain n).h_β_nonneg 0 (Nat.zero_le _)
  have h_sum_le :
      (∑ k ∈ Finset.range (M.K n), M.δ_2loop n k) ≤
        (M.K n : ℝ) * ((1 / 2 : ℝ) * M.Δβ_1loop) := by
    calc
      (∑ k ∈ Finset.range (M.K n), M.δ_2loop n k)
        ≤ ∑ _k ∈ Finset.range (M.K n), ((1 / 2 : ℝ) * M.Δβ_1loop) :=
          Finset.sum_le_sum fun k _ => (M.hδ_2loop_bounds n k).2
      _ = (M.K n : ℝ) * ((1 / 2 : ℝ) * M.Δβ_1loop) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  linarith

/-- Bare-coupling divergence along any `M : BalabanMultiScaleUVToIRFlow P`, derived from the
assumed drift field `h_β_drift`: the UV bare coupling `P.coupling n` diverges to `+∞` (`Tendsto P.coupling atTop atTop`). -/
theorem BalabanMultiScaleUVToIRFlow.tendsto_coupling_atTop
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    Tendsto P.coupling atTop atTop := by
  have h_pos : 0 < (1 / 2 : ℝ) * M.Δβ_1loop := by linarith [M.hΔβ_1loop_pos]
  have h_K_real : Tendsto (fun n => (M.K n : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp M.tendsto_K_atTop
  have h_mul : Tendsto (fun n => ((1 / 2 : ℝ) * M.Δβ_1loop) * (M.K n : ℝ)) atTop atTop :=
    Filter.Tendsto.const_mul_atTop h_pos h_K_real
  exact tendsto_atTop_mono M.half_oneLoop_mul_K_le_coupling h_mul

/-- VACUOUS CONTROL: bounded coupling never holds along a `ContinuumCutoffPath`
(`ContinuumCutoffPath.coupling_tendsto_atTop`, `ROL:2008`).
No `BalabanMultiScaleUVToIRFlow P` can exist along any cutoff path `P` whose bare coupling
`P.coupling n` is bounded above eventually (`∀ᶠ n in atTop, P.coupling n ≤ B`). -/
theorem not_balabanMultiScaleUVToIRFlow_of_bounded_coupling
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (B : ℝ) (hB : ∀ᶠ n in atTop, P.coupling n ≤ B) : False := by
  have h_gt : ∀ᶠ n in atTop, B + 1 ≤ P.coupling n :=
    M.tendsto_coupling_atTop.eventually (eventually_ge_atTop (B + 1))
  obtain ⟨n, hle, hge⟩ := (hB.and h_gt).exists
  linarith

/-- Two-sided asymptotic-freedom corridor along any `M : BalabanMultiScaleUVToIRFlow P`:
eventually in `n`, the UV bare coupling `P.coupling n` is trapped between
`(canonicalCrossoverBetaLo : ℝ) + ((1 / 2) * M.Δβ_1loop) * (M.K n : ℝ)` and
`(canonicalCrossoverBetaHi : ℝ) + (M.K n : ℝ) * M.Δβ_1loop`. -/
theorem BalabanMultiScaleUVToIRFlow.eventually_coupling_in_asymptoticFreedom_corridor
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) :
    ∀ᶠ n in atTop,
      (canonicalCrossoverBetaLo : ℝ) + ((1 / 2 : ℝ) * M.Δβ_1loop) * (M.K n : ℝ) ≤ P.coupling n ∧
      P.coupling n ≤ (canonicalCrossoverBetaHi : ℝ) + (M.K n : ℝ) * M.Δβ_1loop := by
  filter_upwards [M.h_β_ir_lo, M.h_β_absorb] with n h_lo h_abs
  have h_tele :=
    ((M.chain n).beta_state_le_uv_sub_oneLoop_add_twoLoop
      M.Δβ_1loop (M.δ_2loop n) (M.h_β_drift n)).2
  have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.range (M.K n), M.δ_2loop n k :=
    Finset.sum_nonneg fun k _ => (M.hδ_2loop_bounds n k).1
  have h_sum_le :
      (∑ k ∈ Finset.range (M.K n), M.δ_2loop n k) ≤
        (M.K n : ℝ) * ((1 / 2 : ℝ) * M.Δβ_1loop) := by
    calc
      (∑ k ∈ Finset.range (M.K n), M.δ_2loop n k)
        ≤ ∑ _k ∈ Finset.range (M.K n), ((1 / 2 : ℝ) * M.Δβ_1loop) :=
          Finset.sum_le_sum fun k _ => (M.hδ_2loop_bounds n k).2
      _ = (M.K n : ℝ) * ((1 / 2 : ℝ) * M.Δβ_1loop) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  exact ⟨by linarith, by linarith⟩

/-- Negative control refuting super-logarithmic UV coupling growth: no
`BalabanMultiScaleUVToIRFlow P` can exist if `P.coupling n` eventually exceeds the 1-loop
asymptotic-freedom upper ceiling `(canonicalCrossoverBetaHi : ℝ) + (M.K n : ℝ) * M.Δβ_1loop`. -/
theorem not_balabanMultiScaleUVToIRFlow_of_superlogarithmic_coupling
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P)
    (h_super : ∀ᶠ n in atTop,
      (canonicalCrossoverBetaHi : ℝ) + (M.K n : ℝ) * M.Δβ_1loop < P.coupling n) : False := by
  obtain ⟨n, ⟨_, h_le⟩, h_gt⟩ :=
    (M.eventually_coupling_in_asymptoticFreedom_corridor.and h_super).exists
  linarith

/-- VACUOUS (`not_twoCutoffComparison_of_balabanMultiScaleUVToIRFlow`):
Takes `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`).
Under `TwoCutoffComparison (M.toLandingTube hF) Z`, the landed IR couplings `((M.chain n).state 0).β`
converge as `n → ∞` to a continuum landed IR coupling `β_ir_lim` inside the two-sided crossover
window `[canonicalCrossoverBetaLo, canonicalCrossoverBetaHi]`. -/
theorem BalabanMultiScaleUVToIRFlow.exists_tendsto_landed_beta_in_crossover_window
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (hF : M.WilsonCharFloor)
    {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison (M.toLandingTube hF) Z) :
    ∃ β_ir_lim : ℝ,
      (canonicalCrossoverBetaLo : ℝ) ≤ β_ir_lim ∧
      β_ir_lim ≤ (canonicalCrossoverBetaHi : ℝ) ∧
      Tendsto (fun n => ((M.chain n).state 0).β) atTop (𝓝 β_ir_lim) := by
  obtain ⟨β_ir_lim, h_tend⟩ :=
    cauchySeq_tendsto_of_complete (landedBeta_cauchy_of_twoCutoffComparison hC)
  have h_lo : (canonicalCrossoverBetaLo : ℝ) ≤ β_ir_lim :=
    ge_of_tendsto h_tend M.h_β_ir_lo
  have h_hi_ev : ∀ᶠ n in atTop, ((M.chain n).state 0).β ≤ (canonicalCrossoverBetaHi : ℝ) := by
    filter_upwards [M.eventually_beta_state_zero_mem_window] with n h
    exact h.2
  have h_hi : β_ir_lim ≤ (canonicalCrossoverBetaHi : ℝ) :=
    le_of_tendsto h_tend h_hi_ev
  exact ⟨β_ir_lim, h_lo, h_hi, h_tend⟩

/-- Every `BalabanMultiScaleUVToIRFlow P` canonically constructs
`ExponentialRemainderLocalityBound (M.toLandingTube hF)` with exponential decay rate `κ = Real.log (4 / 3)`;
takes `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`). -/
noncomputable def BalabanMultiScaleUVToIRFlow.toExponentialRemainderLocalityBound
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (hF : M.WilsonCharFloor) :
    ExponentialRemainderLocalityBound (M.toLandingTube hF) where
  κ := Real.log (4 / 3)
  h_tilt_le_exp := by
    have h_contr : landingTubeContraction (M.toLandingTube hF) = 3 / 4 := by
      unfold landingTubeContraction BalabanMultiScaleUVToIRFlow.toLandingTube
        InductiveStepAndBlockBounds.toIntervalArithmeticCrossoverCertificate
        IntervalArithmeticCrossoverCertificate.toLandingTube
      dsimp
      norm_num [canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]
    rw [h_contr, Real.exp_log (by norm_num : (0 : ℝ) < 4 / 3)]
    norm_num
  h_tilted_tube := by
    unfold landingTubeContraction BalabanMultiScaleUVToIRFlow.toLandingTube
      InductiveStepAndBlockBounds.toIntervalArithmeticCrossoverCertificate
      IntervalArithmeticCrossoverCertificate.toLandingTube
    dsimp
    norm_num [canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]
  h_exp_decay := Filter.Eventually.of_forall fun n => by
    let P_n : PolymerActivityFamily (M.irSide n) := ((M.chain n).state 0).polymers
    have h_η_le :
        canonicalBalabanEtaStep (M.K n - 0) ≤ (M.toLandingTube hF).η_star := by
      change canonicalBalabanEtaStep (M.K n - 0) ≤ (canonicalCrossoverEtaHi : ℝ)
      exact canonicalBalabanEtaStep_le_canonicalCrossoverEtaHi (M.K n - 0)
    let δ_fp : ℝ := ((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ))
    have hδ_fp_nonneg : 0 ≤ δ_fp := by norm_num [δ_fp]
    refine ⟨fun (e e' : Link (M.irSide n)) =>
        if e' ∈ dobrushinNeighbors e then (4 / 3 : ℝ) * δ_fp else 0,
      fun (e : Link (M.irSide n)) => ?_,
      fun (e e' : Link (M.irSide n)) => ?_,
      fun V (e e' : Link (M.irSide n)) g1 g2 h1 h2 => ?_,
      fun (e : Link (M.irSide n)) => ?_⟩
    · change (∑ i : P_n.idx,
        if e ∈ latticePathSupport (M.irSide n) (P_n.bases i) (P_n.loops i) then
          ((P_n.loops i).length : ℝ) *
            (Real.exp (Real.log (4 / 3) * ((P_n.loops i).length : ℝ)) * (4 * |P_n.weights i|))
        else 0) ≤ (M.toLandingTube hF).η_star
      refine (le_of_eq ?_).trans
        ((M.polymer_weighted_incident_sum_le_state_zero n e).trans h_η_le)
      refine Finset.sum_congr rfl fun i _ => ?_
      have h_pow :
          Real.exp (Real.log (4 / 3) * ((P_n.loops i).length : ℝ)) =
            (4 / 3 : ℝ) ^ (P_n.loops i).length := by
        rw [mul_comm, Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 4 / 3)]
      rw [h_pow]
    · dsimp only
      split_ifs
      · exact mul_nonneg (by norm_num) hδ_fp_nonneg
      · exact le_rfl
    · have h_mk :
          |twoLinkMixedDifference (M.irSide n) (((M.chain n).state 0).R_trunc)
            V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
            if e' ∈ dobrushinNeighbors e then δ_fp else 0 :=
        M.R_trunc_mixedDifference_le_state_zero n V e e' g1 g2 h1 h2
      change |twoLinkMixedDifference (M.irSide n) (((M.chain n).state 0).R_trunc)
        V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
        (if e' ∈ dobrushinNeighbors e then (4 / 3 : ℝ) * δ_fp else 0) *
          Real.exp (-Real.log (4 / 3) * (linkTemporalDist e e' : ℝ))
      by_cases h_mem : e' ∈ dobrushinNeighbors e
      · simp only [h_mem, ↓reduceIte] at h_mk ⊢
        have hd_le : (linkTemporalDist e e' : ℝ) ≤ 1 := by
          exact_mod_cast linkTemporalDist_le_one_of_mem_dobrushinNeighbors h_mem
        have h_log_nonneg : 0 ≤ Real.log (4 / 3) := Real.log_nonneg (by norm_num)
        have h_exp_ge :
            Real.exp (-Real.log (4 / 3)) ≤
              Real.exp (-Real.log (4 / 3) * (linkTemporalDist e e' : ℝ)) :=
          Real.exp_le_exp.mpr (by nlinarith)
        have h_prod_one : (4 / 3 : ℝ) * Real.exp (-Real.log (4 / 3)) = 1 := by
          rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 4 / 3)]
          norm_num
        have h_one_le :
            1 ≤ (4 / 3 : ℝ) * Real.exp (-Real.log (4 / 3) * (linkTemporalDist e e' : ℝ)) := by
          rw [← h_prod_one]
          exact mul_le_mul_of_nonneg_left h_exp_ge (by norm_num)
        calc
          |twoLinkMixedDifference (M.irSide n) (((M.chain n).state 0).R_trunc)
              V e.x e.μ g1 g2 e'.x e'.μ h1 h2|
            ≤ δ_fp * 1 := by rw [mul_one]; exact h_mk
          _ ≤ δ_fp *
                ((4 / 3 : ℝ) * Real.exp (-Real.log (4 / 3) * (linkTemporalDist e e' : ℝ))) :=
              mul_le_mul_of_nonneg_left h_one_le hδ_fp_nonneg
          _ = ((4 / 3 : ℝ) * δ_fp) *
                Real.exp (-Real.log (4 / 3) * (linkTemporalDist e e' : ℝ)) := by ring
      · simp only [h_mem, ↓reduceIte, zero_mul] at h_mk ⊢
        exact h_mk
    · have h_sub :
          (∑ e' ∈ Finset.univ.erase e,
            if e' ∈ dobrushinNeighbors e then (4 / 3 : ℝ) * δ_fp else 0) ≤
          ∑ _e' ∈ dobrushinNeighbors e, ((4 / 3 : ℝ) * δ_fp) := by
        rw [← Finset.sum_filter]
        refine Finset.sum_le_sum_of_subset_of_nonneg ?_
          (fun _ _ _ => mul_nonneg (by norm_num) hδ_fp_nonneg)
        intro e' he'
        exact (Finset.mem_filter.mp he').2
      rw [Finset.sum_const, nsmul_eq_mul] at h_sub
      have hcard : ((dobrushinNeighbors e).card : ℝ) ≤ 18 :=
        Nat.cast_le.mpr (dobrushinNeighbors_card_le_eighteen e)
      have h_eps_eq :
          18 * ((4 / 3 : ℝ) * δ_fp) = (M.toLandingTube hF).ε_star := by
        change 18 * ((4 / 3 : ℝ) * (((1 / 24 : ℝ) * (1 / 32 : ℝ)) / (1 - (1 / 2 : ℝ)))) =
          (canonicalCrossoverEpsHi : ℝ)
        norm_num [canonicalCrossoverEpsHi]
      rw [← h_eps_eq]
      exact h_sub.trans (mul_le_mul_of_nonneg_right hcard (mul_nonneg (by norm_num) hδ_fp_nonneg))

/-- Takes `hF : M.WilsonCharFloor` (formerly the field `h_wilson_char_floor`).
For any `M : BalabanMultiScaleUVToIRFlow P` at cutoff `n` with
`((M.chain n).state 0).β ≤ canonicalCrossoverBetaHi` and any comparison effective action state
`st₁ : InteractingEffectiveActionState (M.irSide n)` whose non-vacuum action difference from
`((M.chain n).state 0)` has single-link oscillation bounded by `Δ_link ≥ 0`, the dressed multi-loop
expectation under `st₁.gibbsMeasure` differs from `landedIrSchwinger (M.toLandingTube hF) M.Z_tube n F`
by at most
`4 * (Real.exp (2 * Δ_link) - 1) * (2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop (M.ℓstar : ℝ)).length)).sum : ℕ) : ℝ))`,
with all Dobrushin uniqueness bounds on `((M.chain n).state 0)` derived from `M`. -/
theorem BalabanMultiScaleUVToIRFlow.landedIrSchwinger_diff_le_of_singleLink_osc
    {P : ContinuumCutoffPath} (M : BalabanMultiScaleUVToIRFlow P) (hF : M.WilsonCharFloor) (n : ℕ)
    (hβ_hi : ((M.chain n).state 0).β ≤ (canonicalCrossoverBetaHi : ℝ))
    (st₁ : InteractingEffectiveActionState (M.irSide n)) {B₁ Δ_link : ℝ}
    (hΔ : 0 ≤ Δ_link)
    (hβ1 : 0 ≤ st₁.β) (hR1_meas : Measurable st₁.R_trunc)
    (hR1_bdd : ∀ V : GaugeConfig (M.irSide n), |st₁.R_trunc V| ≤ B₁)
    (h_act_osc : ∀ (V : GaugeConfig (M.irSide n)) (e : Link (M.irSide n)) (g1 g2 : SU2),
      |((wilsonAction st₁.β (updateGaugeLink (M.irSide n) V e.x e.μ g1) +
            st₁.polymers.eval (updateGaugeLink (M.irSide n) V e.x e.μ g1) +
            st₁.R_trunc (updateGaugeLink (M.irSide n) V e.x e.μ g1)) -
          (wilsonAction ((M.chain n).state 0).β (updateGaugeLink (M.irSide n) V e.x e.μ g1) +
            ((M.chain n).state 0).polymers.eval (updateGaugeLink (M.irSide n) V e.x e.μ g1) +
            ((M.chain n).state 0).R_trunc (updateGaugeLink (M.irSide n) V e.x e.μ g1))) -
        ((wilsonAction st₁.β (updateGaugeLink (M.irSide n) V e.x e.μ g2) +
            st₁.polymers.eval (updateGaugeLink (M.irSide n) V e.x e.μ g2) +
            st₁.R_trunc (updateGaugeLink (M.irSide n) V e.x e.μ g2)) -
          (wilsonAction ((M.chain n).state 0).β (updateGaugeLink (M.irSide n) V e.x e.μ g2) +
            ((M.chain n).state 0).polymers.eval (updateGaugeLink (M.irSide n) V e.x e.μ g2) +
            ((M.chain n).state 0).R_trunc (updateGaugeLink (M.irSide n) V e.x e.μ g2)))| ≤ Δ_link)
    (F : DisjointLoopFamily) :
    |(∫ V, irLoopFamilyObservable (M.irSide n) (M.ℓstar : ℝ) F V
        ∂st₁.gibbsMeasure) -
      landedIrSchwinger (M.toLandingTube hF) M.Z_tube n F| ≤
      4 * (Real.exp (2 * Δ_link) - 1) *
        (2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop (M.ℓstar : ℝ)).length)).sum : ℕ) : ℝ)) :=
  st₁.irLoopFamilyObservable_expectation_diff_le_of_singleLink_osc
    ((M.chain n).state 0) hΔ hβ1 hR1_meas hR1_bdd
    ((M.chain n).h_β_nonneg 0 (Nat.zero_le _)) hβ_hi
    (M.polymerDobrushinNormBound_state_zero n)
    (M.truncationDobrushinNormBound_state_zero n)
    h_act_osc (M.ℓstar : ℝ) F

