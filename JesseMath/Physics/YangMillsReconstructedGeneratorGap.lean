        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) hk_bot g]

/-- Full-torus degree-3 two-probe moment vanishing (`L ≥ 3`):
`∫ U, (totalCharacterSum U) ^ 3 * (fΘ U * fp U) ∂(gaugeHaarMeasure L) = 0`. -/
theorem integral_gaugeHaarMeasure_totalCharacterSum_cube_mul_probes_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 3 * (fΘ U * fp U) ∂(gaugeHaarMeasure L)) = 0 := by
  intro fΘ fp
  have h_pair (q₁ q₂ : Plaquette L) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q₁) *
          halfTraceRe (plaquetteHolonomy U q₂) *
          totalCharacterSum U *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            totalCharacterSum U *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
        fun U : GaugeConfig L =>
          ∑ q₃ : Plaquette L,
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      unfold totalCharacterSum
      rw [Finset.mul_sum, Finset.sum_mul, Finset.sum_mul]
    rw [h_pt, integral_finsetSum]
    · simp_rw [integral_gaugeHaarMeasure_plaquetteHolonomy_triple_mul_probes_eq_zero hL q₁ q₂,
        Finset.sum_const_zero]
    · intro q₃ _
      have h_cont :
          Continuous (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃) *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
        ((((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L)))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L)))
      exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_single (q₁ : Plaquette L) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q₁) *
          (totalCharacterSum U) ^ 2 *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            (totalCharacterSum U) ^ 2 *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
        fun U : GaugeConfig L =>
          ∑ q₂ : Plaquette L,
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              totalCharacterSum U *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      have h_eq :
          halfTraceRe (plaquetteHolonomy U q₁) *
            (totalCharacterSum U) ^ 2 *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) =
          (∑ q₂ : Plaquette L, halfTraceRe (plaquetteHolonomy U q₂)) *
            (halfTraceRe (plaquetteHolonomy U q₁) *
              totalCharacterSum U *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
        unfold totalCharacterSum
        ring
      rw [h_eq, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun q₂ _ => by ring)
    rw [h_pt, integral_finsetSum]
    · simp_rw [h_pair q₁, Finset.sum_const_zero]
    · intro q₂ _
      have h_cont :
          Continuous (fun U : GaugeConfig L =>
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              totalCharacterSum U *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
        ((((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
          continuous_totalCharacterSum).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L)))).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L)))
      exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_outer :
      (fun U : GaugeConfig L => (totalCharacterSum U) ^ 3 * (fΘ U * fp U)) =
      fun U : GaugeConfig L =>
        ∑ q₁ : Plaquette L,
          halfTraceRe (plaquetteHolonomy U q₁) *
            (totalCharacterSum U) ^ 2 *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
    funext U
    dsimp [fΘ, fp]
    rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
        physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    have h_pow : (totalCharacterSum U) ^ 3 = totalCharacterSum U * (totalCharacterSum U) ^ 2 := by
      ring
    rw [h_pow, ← mul_assoc]
    conv_lhs => lhs; lhs; lhs; unfold totalCharacterSum
    rw [Finset.sum_mul, Finset.sum_mul, Finset.sum_mul]
  rw [h_outer, integral_finsetSum]
  · simp_rw [h_single, Finset.sum_const_zero]
  · intro q₁ _
    have h_cont :
        Continuous (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            (totalCharacterSum U) ^ 2 *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
      ((((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_totalCharacterSum.pow 2)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L)))).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))))
    exact h_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

/-- Master Step 1 theorem — Full-torus connected Gibbs Taylor coefficient cancellation
for all degrees below four (`d = 0, 1, 2, 3`, `L ≥ 3`):
in the connected Gibbs covariance numerator
`(∫ U, exp (β * S U) * (fΘ U * fp U)) * (∫ U', exp (β * S U')) -
  (∫ U, exp (β * S U) * fΘ U) * (∫ U', exp (β * S U') * fp U')`
with full-torus action sum `S U = totalCharacterSum U = ∑_{q : Plaquette L} halfTraceRe (U_q)`,
all four Cauchy-product coefficients of `β ^ 0`, `β ^ 1`, `β ^ 2`, and `β ^ 3` vanish identically
on `gaugeHaarMeasure L` for every `L ≥ 3`.
Note: this proves the exact algebraic vanishing of the full-torus connected Taylor coefficients
for degrees `0, 1, 2, 3`; proving the complete degree-4 connected coefficient `= 4 ^ (-5)` and
bounding the full exponential remainder `|R_L(β)| ≤ (1 / 4) * 4 ^ (-5) * β ^ 4` remain open. -/
theorem fullTorus_connected_taylor_coeffs_zero_through_three_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    let S : GaugeConfig L → ℝ := totalCharacterSum
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    let M₂ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * (fΘ U * fp U) ∂(gaugeHaarMeasure L)
    let M₀ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k ∂(gaugeHaarMeasure L)
    let MΘ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * fΘ U ∂(gaugeHaarMeasure L)
    let Mp (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * fp U ∂(gaugeHaarMeasure L)
    -- Degree 0 Cauchy coefficient:
    (M₂ 0 * M₀ 0 - MΘ 0 * Mp 0 = 0) ∧
    -- Degree 1 Cauchy coefficient:
    (M₂ 1 * M₀ 0 + M₂ 0 * M₀ 1 - (MΘ 1 * Mp 0 + MΘ 0 * Mp 1) = 0) ∧
    -- Degree 2 Cauchy coefficient:
    ((1 / 2 : ℝ) * M₂ 2 * M₀ 0 + M₂ 1 * M₀ 1 + M₂ 0 * ((1 / 2 : ℝ) * M₀ 2) -
      ((1 / 2 : ℝ) * MΘ 2 * Mp 0 + MΘ 1 * Mp 1 + MΘ 0 * ((1 / 2 : ℝ) * Mp 2)) = 0) ∧
    -- Degree 3 Cauchy coefficient:
    ((1 / 6 : ℝ) * M₂ 3 * M₀ 0 + (1 / 2 : ℝ) * M₂ 2 * M₀ 1 +
        M₂ 1 * ((1 / 2 : ℝ) * M₀ 2) + M₂ 0 * ((1 / 6 : ℝ) * M₀ 3) -
      ((1 / 6 : ℝ) * MΘ 3 * Mp 0 + (1 / 2 : ℝ) * MΘ 2 * Mp 1 +
        MΘ 1 * ((1 / 2 : ℝ) * Mp 2) + MΘ 0 * ((1 / 6 : ℝ) * Mp 3)) = 0) := by
  intro S fΘ fp M₂ M₀ MΘ Mp
  have hL2 : 2 ≤ L := by omega
  have hM₂_0 : M₂ 0 = 0 := by
    dsimp [M₂, fΘ, fp]
    have h_pt :
        (fun U : GaugeConfig L =>
          (S U) ^ 0 *
            (physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U *
              physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U)) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      rw [pow_zero, one_mul,
          physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    rw [h_pt, integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL2]
    simp [cubeBottomPlaquette_ne_cubeTopPlaquette hL2]
  have hMΘ_0 : MΘ 0 = 0 := by
    dsimp [MΘ, fΘ]
    have h_pt :
        (fun U : GaugeConfig L =>
          (S U) ^ 0 *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      funext U
      rw [pow_zero, one_mul,
          physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U]
    rw [h_pt, integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL2]
  have hMp_0 : Mp 0 = 0 := by
    dsimp [Mp, fp]
    have h_pt :
        (fun U : GaugeConfig L =>
          (S U) ^ 0 *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      rw [pow_zero, one_mul,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    rw [h_pt, integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL2]
  have hM₀_0 : M₀ 0 = 1 := by
    dsimp [M₀]
    simp_rw [pow_zero, integral_const, probReal_univ, one_smul]
  have hM₀_1 : M₀ 1 = 0 := by
    dsimp [M₀, S]
    simp_rw [pow_one]
    exact integral_gaugeHaarMeasure_totalCharacterSum_eq_zero hL2
  have hM₂_1 : M₂ 1 = 0 := by
    dsimp [M₂, S, fΘ, fp]
    simp_rw [pow_one]
    exact (integral_gaugeHaarMeasure_totalCharacterSum_mul_probes_eq_zero hL).2
  have hMΘ_1 : MΘ 1 = 1 / 4 := by
    dsimp [MΘ, S, fΘ]
    simp_rw [pow_one]
    exact (integral_gaugeHaarMeasure_totalCharacterSum_single_probes_eq_quarter hL2).1
  have hMp_1 : Mp 1 = 1 / 4 := by
    dsimp [Mp, S, fp]
    simp_rw [pow_one]
    exact (integral_gaugeHaarMeasure_totalCharacterSum_single_probes_eq_quarter hL2).2
  have hM₂_2 : M₂ 2 = 1 / 8 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_mul_probes_and_connected_eq_zero hL).1
  have hMΘ_2 : MΘ 2 = 0 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_single_probes_and_cube_eq_zero hL).1
  have hMp_2 : Mp 2 = 0 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_single_probes_and_cube_eq_zero hL).2.1
  have hM₀_3 : M₀ 3 = 0 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_single_probes_and_cube_eq_zero hL).2.2
  have hM₂_3 : M₂ 3 = 0 :=
    integral_gaugeHaarMeasure_totalCharacterSum_cube_mul_probes_eq_zero hL
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hM₂_0, hMΘ_0]; ring
  · rw [hM₂_1, hM₂_0, hMΘ_0, hMp_0]; ring
  · rw [hM₂_2, hM₀_0, hM₂_1, hM₂_0, hMΘ_2, hMΘ_1, hMp_1, hMΘ_0]; ring
  · rw [hM₂_3, hM₀_1, hM₂_1, hM₂_0, hMp_0, hMΘ_2, hMp_2, hMΘ_0]; ring

/-! #### Stage p3.B3 (Part 4): Full-Torus Degree-4 Connected Cancellation & Complete Degree-`≤ 4` Taylor Jet (`L ≥ 3`)

We now prove Step 2 of the `R1` connected expansion on the full 4D torus `Plaquette L` (`L ≥ 3`):
in the degree-4 Cauchy-product coefficient of the connected Gibbs covariance numerator
`(∫ U, exp (β * S U) * (fΘ U * fp U)) * (∫ U', exp (β * S U')) -
  (∫ U, exp (β * S U) * fΘ U) * (∫ U', exp (β * S U') * fp U')`,
all volume-dependent `O(L^4)` disconnected vacuum contractions and all fourth-moment probe
self-contractions cancel identically, leaving only the 24 permutations of the 4 lateral plaquettes
of the canonical unit 3-cube:
`C₄ = (1 / 24) * (24 * cubeSixFaceHaarIntegral) = cubeSixFaceHaarIntegral = 4 ^ (-5)`. -/

theorem integral_gaugeHaarMeasure_probe_pow_four_mul_sq_eq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L,
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4 *
        (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2
      ∂(gaugeHaarMeasure L)) =
    (1 / 4) *
      (∫ U : GaugeConfig L,
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4
        ∂(gaugeHaarMeasure L)) ∧
    (∫ U : GaugeConfig L,
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
        (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4
      ∂(gaugeHaarMeasure L)) =
    (1 / 4) *
      (∫ U : GaugeConfig L,
        (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4
        ∂(gaugeHaarMeasure L)) := by
  refine ⟨?_, ?_⟩
  · have h_cont :
        Continuous (fun U : GaugeConfig L =>
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4 *
            (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2) :=
      ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))).pow 4).mul
        ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))).pow 2)
    have he_top : (⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ : Link L) ∈
        plaquetteLinks (cubeTopPlaquette L) := by
      simp [plaquetteLinks]
    have he_not_bot : (⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ : Link L) ∉
        plaquetteLinks (cubeBottomPlaquette L) :=
      not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL he_top
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
        ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ _ h_cont]
    have h_inner (U : GaugeConfig L) :
        (∫ g : SU2,
          (halfTraceRe (plaquetteHolonomy
            (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
            (cubeBottomPlaquette L))) ^ 4 *
          (halfTraceRe (plaquetteHolonomy
            (updateGaugeLink L U (cubeTopPlaquette L).x (cubeTopPlaquette L).μ g)
            (cubeTopPlaquette L))) ^ 2
          ∂SU2.haarProbability) =
        (1 / 4) * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4 := by
      simp_rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) he_not_bot]
      rw [integral_const_mul,
          integral_plaquetteHolonomy_sq_update_eq_quarter_of_mem_plaquetteLinks hL U (cubeTopPlaquette L) he_top,
          mul_comm]
    simp_rw [h_inner, integral_const_mul]
  · have h_cont :
        Continuous (fun U : GaugeConfig L =>
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
            (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4) :=
      ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))).pow 2).mul
        ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))).pow 4)
    have he_bot : (⟨(cubeBottomPlaquette L).x, (cubeBottomPlaquette L).μ⟩ : Link L) ∈
        plaquetteLinks (cubeBottomPlaquette L) := by
      simp [plaquetteLinks]
    have he_not_top : (⟨(cubeBottomPlaquette L).x, (cubeBottomPlaquette L).μ⟩ : Link L) ∉
        plaquetteLinks (cubeTopPlaquette L) :=
      not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL he_bot
    rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
        ⟨(cubeBottomPlaquette L).x, (cubeBottomPlaquette L).μ⟩ _ h_cont]
    have h_inner (U : GaugeConfig L) :
        (∫ g : SU2,
          (halfTraceRe (plaquetteHolonomy
            (updateGaugeLink L U (cubeBottomPlaquette L).x (cubeBottomPlaquette L).μ g)
            (cubeBottomPlaquette L))) ^ 2 *
          (halfTraceRe (plaquetteHolonomy
            (updateGaugeLink L U (cubeBottomPlaquette L).x (cubeBottomPlaquette L).μ g)
            (cubeTopPlaquette L))) ^ 4
          ∂SU2.haarProbability) =
        (1 / 4) * (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4 := by
      simp_rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) he_not_top]
      rw [integral_mul_const,
          integral_plaquetteHolonomy_sq_update_eq_quarter_of_mem_plaquetteLinks hL U (cubeBottomPlaquette L) he_bot]
    simp_rw [h_inner, integral_const_mul]

private theorem integral_add_apply {L : ℕ} [NeZero L]
    (f g : GaugeConfig L → ℝ) (hf : Continuous f) (hg : Continuous g) :
    (∫ U : GaugeConfig L, (f U + g U) ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, f U ∂(gaugeHaarMeasure L)) +
      (∫ U : GaugeConfig L, g U ∂(gaugeHaarMeasure L)) :=
  integral_add
    (hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
    (hg.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))

private theorem integral_sub_apply {L : ℕ} [NeZero L]
    (f g : GaugeConfig L → ℝ) (hf : Continuous f) (hg : Continuous g) :
    (∫ U : GaugeConfig L, (f U - g U) ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, f U ∂(gaugeHaarMeasure L)) -
      (∫ U : GaugeConfig L, g U ∂(gaugeHaarMeasure L)) :=
  integral_sub
    (hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
    (hg.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))

private theorem integral_add3_apply {L : ℕ} [NeZero L]
    (f₁ f₂ f₃ : GaugeConfig L → ℝ)
    (h₁ : Continuous f₁) (h₂ : Continuous f₂) (h₃ : Continuous f₃) :
    (∫ U : GaugeConfig L, ((f₁ U + f₂ U) + f₃ U) ∂(gaugeHaarMeasure L)) =
      ((∫ U : GaugeConfig L, f₁ U ∂(gaugeHaarMeasure L)) +
        (∫ U : GaugeConfig L, f₂ U ∂(gaugeHaarMeasure L))) +
      (∫ U : GaugeConfig L, f₃ U ∂(gaugeHaarMeasure L)) := by
  rw [integral_add_apply (fun U => f₁ U + f₂ U) f₃ (h₁.add h₂) h₃,
      integral_add_apply f₁ f₂ h₁ h₂]

private theorem integral_add4_apply {L : ℕ} [NeZero L]
    (f₁ f₂ f₃ f₄ : GaugeConfig L → ℝ)
    (h₁ : Continuous f₁) (h₂ : Continuous f₂) (h₃ : Continuous f₃) (h₄ : Continuous f₄) :
    (∫ U : GaugeConfig L, (((f₁ U + f₂ U) + f₃ U) + f₄ U) ∂(gaugeHaarMeasure L)) =
      (((∫ U : GaugeConfig L, f₁ U ∂(gaugeHaarMeasure L)) +
        (∫ U : GaugeConfig L, f₂ U ∂(gaugeHaarMeasure L))) +
        (∫ U : GaugeConfig L, f₃ U ∂(gaugeHaarMeasure L))) +
      (∫ U : GaugeConfig L, f₄ U ∂(gaugeHaarMeasure L)) := by
  rw [integral_add_apply (fun U => (f₁ U + f₂ U) + f₃ U) f₄ ((h₁.add h₂).add h₃) h₄,
      integral_add3_apply f₁ f₂ f₃ h₁ h₂ h₃]

private theorem integral_add5_apply {L : ℕ} [NeZero L]
    (f₁ f₂ f₃ f₄ f₅ : GaugeConfig L → ℝ)
    (h₁ : Continuous f₁) (h₂ : Continuous f₂) (h₃ : Continuous f₃)
    (h₄ : Continuous f₄) (h₅ : Continuous f₅) :
    (∫ U : GaugeConfig L, ((((f₁ U + f₂ U) + f₃ U) + f₄ U) + f₅ U) ∂(gaugeHaarMeasure L)) =
      ((((∫ U : GaugeConfig L, f₁ U ∂(gaugeHaarMeasure L)) +
        (∫ U : GaugeConfig L, f₂ U ∂(gaugeHaarMeasure L))) +
        (∫ U : GaugeConfig L, f₃ U ∂(gaugeHaarMeasure L))) +
        (∫ U : GaugeConfig L, f₄ U ∂(gaugeHaarMeasure L))) +
      (∫ U : GaugeConfig L, f₅ U ∂(gaugeHaarMeasure L)) := by
  rw [integral_add_apply (fun U => ((f₁ U + f₂ U) + f₃ U) + f₄ U) f₅
        (((h₁.add h₂).add h₃).add h₄) h₅,
      integral_add4_apply f₁ f₂ f₃ f₄ h₁ h₂ h₃ h₄]

theorem plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks {L : ℕ}
    (U : GaugeConfig L) (p : Plaquette L) {e : Link L} (he : e ∉ plaquetteLinks p) :
    plaquetteHolonomy (twistLinkNegOne e U) p = plaquetteHolonomy U p := by
  have he1 : (⟨p.x, p.μ⟩ : Link L) ≠ e := fun h => he (by simp [plaquetteLinks, ← h])
  have he2 : (⟨shift p.x p.μ, p.ν⟩ : Link L) ≠ e := fun h => he (by simp [plaquetteLinks, ← h])
  have he3 : (⟨shift p.x p.ν, p.μ⟩ : Link L) ≠ e := fun h => he (by simp [plaquetteLinks, ← h])
  have he4 : (⟨p.x, p.ν⟩ : Link L) ≠ e := fun h => he (by simp [plaquetteLinks, ← h])
  unfold plaquetteHolonomy twistLinkNegOne
  simp [he1, he2, he3, he4]

theorem integral_gaugeHaarMeasure_probeSum_sq_eq_half
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L,
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2
      ∂(gaugeHaarMeasure L)) = 1 / 2 := by
  have h_bot_cont : Continuous (fun U : GaugeConfig L =>
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have h_top_cont : Continuous (fun U : GaugeConfig L =>
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  have h_pt :
      (fun U : GaugeConfig L =>
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2) =
      fun U : GaugeConfig L =>
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
        2 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
    funext U; ring
  rw [h_pt,
      integral_add3_apply
        (fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
        (fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        (fun U => 2 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
        (h_bot_cont.mul h_bot_cont) (h_top_cont.mul h_top_cont)
        (continuous_const.mul (h_bot_cont.mul h_top_cont)),
      integral_const_mul,
      integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL (cubeBottomPlaquette L) (cubeBottomPlaquette L),
      integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL (cubeTopPlaquette L) (cubeTopPlaquette L),
      integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL (cubeBottomPlaquette L) (cubeTopPlaquette L)]
  simp [cubeBottomPlaquette_ne_cubeTopPlaquette hL]
  norm_num

theorem integral_gaugeHaarMeasure_probeSum_sq_mul_probes_eq_eighth
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L,
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
      ∂(gaugeHaarMeasure L)) = 1 / 8 := by
  have h_bot_cont : Continuous (fun U : GaugeConfig L =>
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have h_top_cont : Continuous (fun U : GaugeConfig L =>
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  have h_odd_cont : Continuous (fun U : GaugeConfig L =>
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 3 *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) +
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 3) :=
    ((h_bot_cont.pow 3).mul h_top_cont).add (h_bot_cont.mul (h_top_cont.pow 3))
  have h_even_cont : Continuous (fun U : GaugeConfig L =>
      2 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
        (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2)) :=
    continuous_const.mul ((h_bot_cont.pow 2).mul (h_top_cont.pow 2))
  have he_not_bot : (⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ : Link L) ∉
      plaquetteLinks (cubeBottomPlaquette L) :=
    not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL (by simp [plaquetteLinks])
  have h_odd_zero :
      (∫ U : GaugeConfig L,
        ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 3 *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 3)
        ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg
      ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ h_odd_cont (fun U => ?_)
    rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) he_not_bot,
        plaquetteHolonomy_twistLinkNegOne_base_μ hL (cubeTopPlaquette L) U,
        YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul]
    ring
  have h_pt :
      (fun U : GaugeConfig L =>
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) =
      fun U : GaugeConfig L =>
        ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 3 *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 3) +
        2 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
          (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2) := by
    funext U; ring
  rw [h_pt, integral_add_apply _ _ h_odd_cont h_even_cont,
      h_odd_zero, zero_add, integral_const_mul,
      integral_gaugeHaarMeasure_probes_sq_eq_sixteenth hL]
  norm_num

theorem integral_gaugeHaarMeasure_probeSum_pow_four_sub_eq_neg_three_eighths
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) :
    (∫ U : GaugeConfig L,
      ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4 *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4)
      ∂(gaugeHaarMeasure L)) = -3 / 8 := by
  have h_bot_cont : Continuous (fun U : GaugeConfig L =>
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have h_top_cont : Continuous (fun U : GaugeConfig L =>
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) :=
    continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  let P_odd : GaugeConfig L → ℝ := fun U =>
    (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 5 *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
    4 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 3 *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
    6 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 3 *
      (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 3) -
    4 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 3) +
    halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 5
  let P_even1 : GaugeConfig L → ℝ := fun U =>
    4 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4 *
      (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2) -
    (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4
  let P_even2 : GaugeConfig L → ℝ := fun U =>
    4 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
      (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4) -
    (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4
  let P_even3 : GaugeConfig L → ℝ := fun U =>
    -6 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
      (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2)
  have h_odd_cont : Continuous P_odd := by
    refine (((((h_bot_cont.pow 5).mul h_top_cont).sub
      (continuous_const.mul ((h_bot_cont.pow 3).mul h_top_cont))).add
      (continuous_const.mul ((h_bot_cont.pow 3).mul (h_top_cont.pow 3)))).sub
      (continuous_const.mul (h_bot_cont.mul (h_top_cont.pow 3)))).add
      (h_bot_cont.mul (h_top_cont.pow 5))
  have h_even1_cont : Continuous P_even1 :=
    (continuous_const.mul ((h_bot_cont.pow 4).mul (h_top_cont.pow 2))).sub (h_bot_cont.pow 4)
  have h_even2_cont : Continuous P_even2 :=
    (continuous_const.mul ((h_bot_cont.pow 2).mul (h_top_cont.pow 4))).sub (h_top_cont.pow 4)
  have h_even3_cont : Continuous P_even3 :=
    continuous_const.mul ((h_bot_cont.pow 2).mul (h_top_cont.pow 2))
  have he_not_bot : (⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ : Link L) ∉
      plaquetteLinks (cubeBottomPlaquette L) :=
    not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL (by simp [plaquetteLinks])
  have h_odd_zero : (∫ U : GaugeConfig L, P_odd U ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg
      ⟨(cubeTopPlaquette L).x, (cubeTopPlaquette L).μ⟩ h_odd_cont (fun U => ?_)
    dsimp only [P_odd]
    rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) he_not_bot,
        plaquetteHolonomy_twistLinkNegOne_base_μ hL (cubeTopPlaquette L) U,
        YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul]
    ring
  have h_even1_zero : (∫ U : GaugeConfig L, P_even1 U ∂(gaugeHaarMeasure L)) = 0 := by
    dsimp only [P_even1]
    rw [integral_sub_apply
          (fun U => 4 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4 *
            (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2))
          (fun U => (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 4)
          (continuous_const.mul ((h_bot_cont.pow 4).mul (h_top_cont.pow 2)))
          (h_bot_cont.pow 4),
        integral_const_mul,
        (integral_gaugeHaarMeasure_probe_pow_four_mul_sq_eq hL).1]
    ring
  have h_even2_zero : (∫ U : GaugeConfig L, P_even2 U ∂(gaugeHaarMeasure L)) = 0 := by
    dsimp only [P_even2]
    rw [integral_sub_apply
          (fun U => 4 * ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
            (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4))
          (fun U => (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4)
          (continuous_const.mul ((h_bot_cont.pow 2).mul (h_top_cont.pow 4)))
          (h_top_cont.pow 4),
        integral_const_mul,
        (integral_gaugeHaarMeasure_probe_pow_four_mul_sq_eq hL).2]
    ring
  have h_even3_eq : (∫ U : GaugeConfig L, P_even3 U ∂(gaugeHaarMeasure L)) = -3 / 8 := by
    dsimp only [P_even3]
    rw [integral_const_mul, integral_gaugeHaarMeasure_probes_sq_eq_sixteenth hL]
    norm_num
  have h_pt :
      (fun U : GaugeConfig L =>
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4 *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 4) =
      fun U : GaugeConfig L => ((P_odd U + P_even1 U) + P_even2 U) + P_even3 U := by
    funext U
    dsimp only [P_odd, P_even1, P_even2, P_even3]
    ring
  rw [h_pt,
      integral_add4_apply P_odd P_even1 P_even2 P_even3
        h_odd_cont h_even1_cont h_even2_cont h_even3_cont,
      h_odd_zero, h_even1_zero, h_even2_zero, h_even3_eq]
  ring

/-- The finset of all plaquettes on `Lattice4D L` other than the two canonical probe plaquettes
`cubeBottomPlaquette L` and `cubeTopPlaquette L`. -/
def restPlaquettes (L : ℕ) [NeZero L] : Finset (Plaquette L) :=
  Finset.univ.filter (fun q => q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)

/-- Sum of plaquette characters over `restPlaquettes L`. -/
def restCharacterSum {L : ℕ} [NeZero L] (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ restPlaquettes L, halfTraceRe (plaquetteHolonomy U q)

theorem continuous_restCharacterSum {L : ℕ} [NeZero L] :
    Continuous (restCharacterSum (L := L)) := by
  unfold restCharacterSum
  exact continuous_finsetSum _ (fun q _ => continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q))

theorem totalCharacterSum_eq_probeSum_add_restCharacterSum
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (U : GaugeConfig L) :
    totalCharacterSum U =
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
      restCharacterSum U := by
  unfold totalCharacterSum restCharacterSum restPlaquettes
  have h_split := (Finset.sum_filter_add_sum_filter_not (s := (Finset.univ : Finset (Plaquette L)))
    (p := fun q : Plaquette L => q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L)
    (f := fun q => halfTraceRe (plaquetteHolonomy U q))).symm
  have h_compl :
      (Finset.univ.filter (fun q : Plaquette L =>
        ¬ (q ≠ cubeBottomPlaquette L ∧ q ≠ cubeTopPlaquette L))) =
      {cubeBottomPlaquette L, cubeTopPlaquette L} := by
    ext q
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert,
      Finset.mem_singleton]
    tauto
  rw [h_split, h_compl, Finset.sum_pair (cubeBottomPlaquette_ne_cubeTopPlaquette hL), add_comm]

theorem integral_twoProbeObservable_mul_restCharacterSum_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ (U : GaugeConfig L) (e : Link L) (g : SU2),
      e ∉ plaquetteLinks (cubeBottomPlaquette L) →
      e ∉ plaquetteLinks (cubeTopPlaquette L) →
      H (updateGaugeLink L U e.x e.μ g) = H U) :
    (∀ q ∈ restPlaquettes L,
      (∫ U : GaugeConfig L,
        H U * halfTraceRe (plaquetteHolonomy U q) ∂(gaugeHaarMeasure L)) = 0) ∧
    (∫ U : GaugeConfig L, H U * restCharacterSum U ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  have h_each (q : Plaquette L) (hq : q ∈ restPlaquettes L) :
      (∫ U : GaugeConfig L,
        H U * halfTraceRe (plaquetteHolonomy U q) ∂(gaugeHaarMeasure L)) = 0 := by
    simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq
    let Q : Fin 2 → Plaquette L := ![cubeBottomPlaquette L, cubeTopPlaquette L]
    have hQ : ∀ j : Fin 2, Q j ≠ q := by
      intro j; fin_cases j <;> [exact hq.1.symm; exact hq.2.symm]
    obtain ⟨k, hk⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL q (by decide) Q hQ
    have hk_bot : plaquetteLinkAt q k ∉ plaquetteLinks (cubeBottomPlaquette L) := hk 0
    have hk_top : plaquetteLinkAt q k ∉ plaquetteLinks (cubeTopPlaquette L) := hk 1
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 q (plaquetteLinkAt q k) (plaquetteLinkAt_mem_plaquetteLinks q k) H hH_cont (fun U g => ?_)
    exact hH_inv U (plaquetteLinkAt q k) g hk_bot hk_top
  refine ⟨h_each, ?_⟩
  have h_pt :
      (fun U : GaugeConfig L => H U * restCharacterSum U) =
      fun U : GaugeConfig L =>
        ∑ q ∈ restPlaquettes L, H U * halfTraceRe (plaquetteHolonomy U q) := by
    funext U
    unfold restCharacterSum
    exact Finset.mul_sum _ _ _
  rw [h_pt, integral_finsetSum]
  · exact Finset.sum_eq_zero h_each
  · intro q _
    exact (hH_cont.mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q))).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)

theorem integral_twoProbeObservable_mul_restCharacterSum_sq_eq
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ (U : GaugeConfig L) (e : Link L) (g : SU2),
      e ∉ plaquetteLinks (cubeBottomPlaquette L) →
      e ∉ plaquetteLinks (cubeTopPlaquette L) →
      H (updateGaugeLink L U e.x e.μ g) = H U) :
    (∫ U : GaugeConfig L, H U * (restCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, H U ∂(gaugeHaarMeasure L)) *
        (∫ U' : GaugeConfig L, (restCharacterSum U') ^ 2 ∂(gaugeHaarMeasure L)) := by
  have hL2 : 2 ≤ L := by omega
  have h_pair (q₁ : Plaquette L) (hq₁ : q₁ ∈ restPlaquettes L)
      (q₂ : Plaquette L) (hq₂ : q₂ ∈ restPlaquettes L) :
      (∫ U : GaugeConfig L,
        H U * (halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂))
        ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, H U ∂(gaugeHaarMeasure L)) *
        (∫ U' : GaugeConfig L,
          halfTraceRe (plaquetteHolonomy U' q₁) * halfTraceRe (plaquetteHolonomy U' q₂)
          ∂(gaugeHaarMeasure L)) := by
    simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq₁ hq₂
    by_cases h12 : q₁ = q₂
    · subst h12
      let Q : Fin 2 → Plaquette L := ![cubeBottomPlaquette L, cubeTopPlaquette L]
      have hQ : ∀ j : Fin 2, Q j ≠ q₁ := by
        intro j; fin_cases j <;> [exact hq₁.1.symm; exact hq₁.2.symm]
      obtain ⟨k, hk⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL q₁ (by decide) Q hQ
      have hk_bot : plaquetteLinkAt q₁ k ∉ plaquetteLinks (cubeBottomPlaquette L) := hk 0
      have hk_top : plaquetteLinkAt q₁ k ∉ plaquetteLinks (cubeTopPlaquette L) := hk 1
      have h_cont : Continuous (fun U : GaugeConfig L =>
          H U * (halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₁))) :=
        hH_cont.mul ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
          (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)))
      rw [integral_gaugeHaarMeasure_eq_integral_updateGaugeLink_of_continuous
          (plaquetteLinkAt q₁ k) _ h_cont]
      have h_inner (U : GaugeConfig L) :
          (∫ g : SU2,
            H (updateGaugeLink L U (plaquetteLinkAt q₁ k).x (plaquetteLinkAt q₁ k).μ g) *
              (halfTraceRe (plaquetteHolonomy
                (updateGaugeLink L U (plaquetteLinkAt q₁ k).x (plaquetteLinkAt q₁ k).μ g) q₁) *
              halfTraceRe (plaquetteHolonomy
                (updateGaugeLink L U (plaquetteLinkAt q₁ k).x (plaquetteLinkAt q₁ k).μ g) q₁))
            ∂SU2.haarProbability) =
          H U * (1 / 4) := by
        have h_sq :
            (fun g : SU2 =>
              H (updateGaugeLink L U (plaquetteLinkAt q₁ k).x (plaquetteLinkAt q₁ k).μ g) *
                (halfTraceRe (plaquetteHolonomy
                  (updateGaugeLink L U (plaquetteLinkAt q₁ k).x (plaquetteLinkAt q₁ k).μ g) q₁) *
                halfTraceRe (plaquetteHolonomy
                  (updateGaugeLink L U (plaquetteLinkAt q₁ k).x (plaquetteLinkAt q₁ k).μ g) q₁))) =
            fun g : SU2 =>
              H U *
                (halfTraceRe (plaquetteHolonomy
                  (updateGaugeLink L U (plaquetteLinkAt q₁ k).x (plaquetteLinkAt q₁ k).μ g) q₁)) ^ 2 := by
          funext g
          rw [hH_inv U (plaquetteLinkAt q₁ k) g hk_bot hk_top, sq]
        rw [h_sq, integral_const_mul,
            integral_plaquetteHolonomy_sq_update_eq_quarter_of_mem_plaquetteLinks
              hL2 U q₁ (plaquetteLinkAt_mem_plaquetteLinks q₁ k)]
      simp_rw [h_inner, integral_mul_const]
      rw [integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL2 q₁ q₁]
      simp
    · let Q : Fin 3 → Plaquette L := ![cubeBottomPlaquette L, cubeTopPlaquette L, q₁]
      have hQ : ∀ j : Fin 3, Q j ≠ q₂ := by
        intro j; fin_cases j <;> [exact hq₂.1.symm; exact hq₂.2.symm; exact h12]
      obtain ⟨k, hk⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL q₂ le_rfl Q hQ
      have hk_bot : plaquetteLinkAt q₂ k ∉ plaquetteLinks (cubeBottomPlaquette L) := hk 0
      have hk_top : plaquetteLinkAt q₂ k ∉ plaquetteLinks (cubeTopPlaquette L) := hk 1
      have hk_q1 : plaquetteLinkAt q₂ k ∉ plaquetteLinks q₁ := hk 2
      have h_lhs :
          (∫ U : GaugeConfig L,
            H U * (halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂))
            ∂(gaugeHaarMeasure L)) = 0 := by
        have h_assoc :
            (fun U : GaugeConfig L =>
              H U * (halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂))) =
            fun U : GaugeConfig L =>
              (H U * halfTraceRe (plaquetteHolonomy U q₁)) * halfTraceRe (plaquetteHolonomy U q₂) := by
          funext U; ring
        rw [h_assoc]
        refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
          hL2 q₂ (plaquetteLinkAt q₂ k) (plaquetteLinkAt_mem_plaquetteLinks q₂ k) _
          (hH_cont.mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁))) (fun U g => ?_)
        rw [hH_inv U (plaquetteLinkAt q₂ k) g hk_bot hk_top,
            plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ hk_q1 g]
      rw [h_lhs, integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL2 q₁ q₂]
      simp [h12]
  have h_row (q₁ : Plaquette L) (hq₁ : q₁ ∈ restPlaquettes L) :
      (∫ U : GaugeConfig L,
        H U * (halfTraceRe (plaquetteHolonomy U q₁) * restCharacterSum U)
        ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, H U ∂(gaugeHaarMeasure L)) *
        (∫ U' : GaugeConfig L,
          halfTraceRe (plaquetteHolonomy U' q₁) * restCharacterSum U'
          ∂(gaugeHaarMeasure L)) := by
    have h_lhs_pt :
        (fun U : GaugeConfig L =>
          H U * (halfTraceRe (plaquetteHolonomy U q₁) * restCharacterSum U)) =
        fun U : GaugeConfig L =>
          ∑ q₂ ∈ restPlaquettes L,
            H U * (halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂)) := by
      funext U
      unfold restCharacterSum
      rw [Finset.mul_sum, Finset.mul_sum]
    have h_rhs_pt :
        (fun U' : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U' q₁) * restCharacterSum U') =
        fun U' : GaugeConfig L =>
          ∑ q₂ ∈ restPlaquettes L,
            halfTraceRe (plaquetteHolonomy U' q₁) * halfTraceRe (plaquetteHolonomy U' q₂) := by
      funext U'
      unfold restCharacterSum
      exact Finset.mul_sum _ _ _
    rw [h_lhs_pt, h_rhs_pt, integral_finsetSum, integral_finsetSum, Finset.mul_sum]
    · exact Finset.sum_congr rfl (fun q₂ hq₂ => h_pair q₁ hq₁ q₂ hq₂)
    · intro q₂ _
      exact ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    · intro q₂ _
      exact (hH_cont.mul ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂)))).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
  have h_lhs_outer :
      (fun U : GaugeConfig L => H U * (restCharacterSum U) ^ 2) =
      fun U : GaugeConfig L =>
        ∑ q₁ ∈ restPlaquettes L,
          H U * (halfTraceRe (plaquetteHolonomy U q₁) * restCharacterSum U) := by
    funext U
    rw [sq]
    conv_lhs => rhs; lhs; unfold restCharacterSum
    rw [Finset.sum_mul, Finset.mul_sum]
  have h_rhs_outer :
      (fun U' : GaugeConfig L => (restCharacterSum U') ^ 2) =
      fun U' : GaugeConfig L =>
        ∑ q₁ ∈ restPlaquettes L,
          halfTraceRe (plaquetteHolonomy U' q₁) * restCharacterSum U' := by
    funext U'
    rw [sq]
    conv_lhs => lhs; unfold restCharacterSum
    exact Finset.sum_mul _ _ _
  rw [h_lhs_outer, h_rhs_outer, integral_finsetSum, integral_finsetSum, Finset.mul_sum]
  · exact Finset.sum_congr rfl (fun q₁ hq₁ => h_row q₁ hq₁)
  · intro q₁ _
    exact ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
      continuous_restCharacterSum).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  · intro q₁ _
    exact (hH_cont.mul ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
      continuous_restCharacterSum)).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)

theorem integral_gaugeHaarMeasure_totalCharacterSum_sq_eq_half_add_restCharacterSum_sq
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    (∫ U : GaugeConfig L, (totalCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) =
      1 / 2 + (∫ U : GaugeConfig L, (restCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) := by
  have hL2 : 2 ≤ L := by omega
  let A : GaugeConfig L → ℝ := fun U =>
    halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
  have hA_cont : Continuous A :=
    (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))).add
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L)))
  have h_2A_rest :
      (∫ U : GaugeConfig L, (2 * A U) * restCharacterSum U ∂(gaugeHaarMeasure L)) = 0 := by
    refine (integral_twoProbeObservable_mul_restCharacterSum_eq_zero hL
      (fun U => 2 * A U) (continuous_const.mul hA_cont) (fun U e g hbot htop => ?_)).2
    dsimp only [A]
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) hbot g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) htop g]
  have h_pt :
      (fun U : GaugeConfig L => (totalCharacterSum U) ^ 2) =
      fun U : GaugeConfig L =>
        (A U ^ 2 + (2 * A U) * restCharacterSum U) + (restCharacterSum U) ^ 2 := by
    funext U
    rw [totalCharacterSum_eq_probeSum_add_restCharacterSum hL2 U]
    dsimp only [A]
    ring
  rw [h_pt,
      integral_add3_apply
        (fun U => A U ^ 2)
        (fun U => (2 * A U) * restCharacterSum U)
        (fun U => (restCharacterSum U) ^ 2)
        (hA_cont.pow 2)
        ((continuous_const.mul hA_cont).mul continuous_restCharacterSum)
        (continuous_restCharacterSum.pow 2),
      integral_gaugeHaarMeasure_probeSum_sq_eq_half hL2,
      h_2A_rest, add_zero]

theorem integral_probeCubic_mul_restCharacterSum_cube_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    (∫ U : GaugeConfig L,
      (4 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) *
        (restCharacterSum U) ^ 3
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  let H : GaugeConfig L → ℝ := fun U =>
    4 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  have hH_cont : Continuous H := by
    have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
    have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
    exact (((continuous_const.mul (hb.add ht)).mul hb).mul ht).sub (hb.add ht)
  have h_triple (q₁ : Plaquette L) (hq₁ : q₁ ∈ restPlaquettes L)
      (q₂ : Plaquette L) (hq₂ : q₂ ∈ restPlaquettes L)
      (q₃ : Plaquette L) (hq₃ : q₃ ∈ restPlaquettes L) :
      (∫ U : GaugeConfig L,
        H U *
          (halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃))
        ∂(gaugeHaarMeasure L)) = 0 := by
    simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq₁ hq₂ hq₃
    let Q : Fin 3 → Plaquette L := ![q₁, q₂, q₃]
    have hQ_bot : ∀ j : Fin 3, Q j ≠ cubeBottomPlaquette L := by
      intro j; fin_cases j <;> [exact hq₁.1; exact hq₂.1; exact hq₃.1]
    have hQ_top : ∀ j : Fin 3, Q j ≠ cubeTopPlaquette L := by
      intro j; fin_cases j <;> [exact hq₁.2; exact hq₂.2; exact hq₃.2]
    obtain ⟨k_bot, hk_bot⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL (cubeBottomPlaquette L) le_rfl Q hQ_bot
    obtain ⟨k_top, hk_top⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL (cubeTopPlaquette L) le_rfl Q hQ_top
    have hk_bot_top : plaquetteLinkAt (cubeBottomPlaquette L) k_bot ∉ plaquetteLinks (cubeTopPlaquette L) :=
      not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL2
        (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k_bot)
    have hk_top_bot : plaquetteLinkAt (cubeTopPlaquette L) k_top ∉ plaquetteLinks (cubeBottomPlaquette L) :=
      not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
        (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k_top)
    have h_term1 :
        (∫ U : GaugeConfig L,
          (4 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
            halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) -
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
          ∂(gaugeHaarMeasure L)) = 0 := by
      have h_cont : Continuous (fun U : GaugeConfig L =>
          4 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
            halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) -
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃)) := by
        have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
        have h1 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)
        have h2 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂)
        have h3 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)
        exact (((((continuous_const.mul (hb.pow 2)).mul h1).mul h2).mul h3).sub ((h1.mul h2).mul h3))
      refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
        hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) k_top)
        (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k_top) _ h_cont (fun U g => ?_)
      rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) hk_top_bot g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ (hk_top 0) g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ (hk_top 1) g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ (hk_top 2) g]
    have h_term2 :
        (∫ U : GaugeConfig L,
          (4 * (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
            halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) -
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃)) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
          ∂(gaugeHaarMeasure L)) = 0 := by
      have h_cont : Continuous (fun U : GaugeConfig L =>
          4 * (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
            halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) -
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃)) := by
        have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
        have h1 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)
        have h2 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂)
        have h3 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)
        exact (((((continuous_const.mul (ht.pow 2)).mul h1).mul h2).mul h3).sub ((h1.mul h2).mul h3))
      refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
        hL2 (cubeBottomPlaquette L) (plaquetteLinkAt (cubeBottomPlaquette L) k_bot)
        (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k_bot) _ h_cont (fun U g => ?_)
      rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) hk_bot_top g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ (hk_bot 0) g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ (hk_bot 1) g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ (hk_bot 2) g]
    have h_split :
        (fun U : GaugeConfig L =>
          H U *
            (halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃))) =
        fun U : GaugeConfig L =>
          (4 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
            halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) -
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) +
          (4 * (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
            halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) -
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃)) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      funext U
      dsimp only [H]
      ring
    have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
    have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
    have h1 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)
    have h2 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂)
    have h3 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)
    rw [h_split,
        integral_add_apply
          (fun U =>
            (4 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) ^ 2 *
              halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃) -
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
          (fun U =>
            (4 * (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) ^ 2 *
              halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃) -
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃)) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
          (((((((continuous_const.mul (hb.pow 2)).mul h1).mul h2).mul h3).sub ((h1.mul h2).mul h3)).mul ht))
          (((((((continuous_const.mul (ht.pow 2)).mul h1).mul h2).mul h3).sub ((h1.mul h2).mul h3)).mul hb)),
        h_term1, h_term2, add_zero]
  have h_pair (q₁ : Plaquette L) (hq₁ : q₁ ∈ restPlaquettes L)
      (q₂ : Plaquette L) (hq₂ : q₂ ∈ restPlaquettes L) :
      (∫ U : GaugeConfig L,
        H U *
          (halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            restCharacterSum U)
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          H U *
            (halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              restCharacterSum U)) =
        fun U : GaugeConfig L =>
          ∑ q₃ ∈ restPlaquettes L,
            H U *
              (halfTraceRe (plaquetteHolonomy U q₁) *
                halfTraceRe (plaquetteHolonomy U q₂) *
                halfTraceRe (plaquetteHolonomy U q₃)) := by
      funext U
      unfold restCharacterSum
      rw [Finset.mul_sum, Finset.mul_sum]
    rw [h_pt, integral_finsetSum]
    · exact Finset.sum_eq_zero (fun q₃ hq₃ => h_triple q₁ hq₁ q₂ hq₂ q₃ hq₃)
    · intro q₃ _
      exact (hH_cont.mul (((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)))).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
  have h_single (q₁ : Plaquette L) (hq₁ : q₁ ∈ restPlaquettes L) :
      (∫ U : GaugeConfig L,
        H U * (halfTraceRe (plaquetteHolonomy U q₁) * (restCharacterSum U) ^ 2)
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          H U * (halfTraceRe (plaquetteHolonomy U q₁) * (restCharacterSum U) ^ 2)) =
        fun U : GaugeConfig L =>
          ∑ q₂ ∈ restPlaquettes L,
            H U *
              (halfTraceRe (plaquetteHolonomy U q₁) *
                halfTraceRe (plaquetteHolonomy U q₂) *
                restCharacterSum U) := by
      funext U
      have h_eq :
          H U * (halfTraceRe (plaquetteHolonomy U q₁) * (restCharacterSum U) ^ 2) =
          (∑ q₂ ∈ restPlaquettes L, halfTraceRe (plaquetteHolonomy U q₂)) *
            (H U * (halfTraceRe (plaquetteHolonomy U q₁) * restCharacterSum U)) := by
        unfold restCharacterSum
        ring
      rw [h_eq, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun q₂ _ => by ring)
    rw [h_pt, integral_finsetSum]
    · exact Finset.sum_eq_zero (fun q₂ hq₂ => h_pair q₁ hq₁ q₂ hq₂)
    · intro q₂ _
      exact (hH_cont.mul (((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
        continuous_restCharacterSum)).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
  have h_outer :
      (fun U : GaugeConfig L => H U * (restCharacterSum U) ^ 3) =
      fun U : GaugeConfig L =>
        ∑ q₁ ∈ restPlaquettes L,
          H U * (halfTraceRe (plaquetteHolonomy U q₁) * (restCharacterSum U) ^ 2) := by
    funext U
    have h_eq :
        H U * (restCharacterSum U) ^ 3 =
        (∑ q₁ ∈ restPlaquettes L, halfTraceRe (plaquetteHolonomy U q₁)) *
          (H U * (restCharacterSum U) ^ 2) := by
      unfold restCharacterSum
      ring
    rw [h_eq, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun q₁ _ => by ring)
  rw [h_outer, integral_finsetSum]
  · exact Finset.sum_eq_zero (fun q₁ hq₁ => h_single q₁ hq₁)
  · intro q₁ _
    exact (hH_cont.mul ((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
