/-!
# The reconstructed generator and the spectral gap of a lattice transfer operator

**Lattice transfer operator.** `PositiveTransferOperator H` is a positive (hence self-adjoint)
contraction `T` of a complex Hilbert space with a unit vacuum `Ω`, `T Ω = Ω`. For fixed `T`, `Ω`
and `ρ ≥ 0` the following are equivalent (`excited_decay_tfae`): `‖Tⁿ u‖ ≤ ρⁿ ‖u‖` for every
`n` and every `u ⊥ Ω`; the same for `n = 1`; `‖T - |Ω⟩⟨Ω|‖ ≤ ρ`; the real spectrum of
`T - |Ω⟩⟨Ω|` (which is `T` on `Ω⊥` and `0` on the vacuum ray) lies in `[0, ρ]`. Then the
spectrum of `T` lies in `[0, ρ] ∪ {1}`; for `ρ < 1` the eigenvalue `1` is simple and `|Ω⟩⟨Ω|`
is a continuous function of `T`.

**Evolution and generator.** `T^{t/a}` is defined by the continuous functional calculus for every
`t ≥ 0`, whether or not `0` is in the spectrum, because `x ↦ x^{t/a}` is continuous on `[0, ∞)`.
It is a semigroup with `T^{(na)/a} = Tⁿ`, it fixes `Ω`, and it decays by `ρ^{t/a}` on `Ω⊥`. The
generator is the right derivative at `t = 0` on its domain. On `Ω⊥` it satisfies
`-(log ρ)/a · ‖u‖² ≤ Re ⟪u, H u⟫`, through `generator_coercivity_of_decay`.

**Zero in the spectrum.** If `0 ∉ spectrum T`, `G = -(log T)/a` is a bounded operator given by
the functional calculus, `exp(-a G) = T`, `G Ω = 0`, `G ≥ 0`, `G` has the same gap on `Ω⊥`, and
`G` is the generator of `T^{t/a}` on the whole space. If `0 ∈ spectrum T`, no bounded
self-adjoint `G` satisfies `exp(-a G) = T`; then only the evolution-based generator is used, and
`cfc` is never applied to `log` there.

**Bridges.** Uniform bounds `m ≤ -(log ρₙ)/aₙ` along a cutoff sequence supply the decay input of
`physical_generator_gap_and_excited_resolvent_exclusion_from_cutoff_decay`. The lattice mass gap
of a `TransferMatrixSystem` equals the generator gap of `T/λ₀`.

**Reconstruction from a reflection-positive law.** On the loop space of
`YangMillsRenormalizedObservableLimits`, positive-time bounded continuous functionals carry the
reflection form `∫ conj (F (θ w)) G w dν`. It is Hermitian under reflection invariance and
positive under reflection positivity (`ReflectionPositiveLaw`). The quotient by null vectors is
the separation quotient and the completion is a Hilbert space. Time translation is well defined
on it, symmetric under time-translation invariance, contractive by iterated Cauchy–Schwarz,
positive under half-step invariance, and fixes the vacuum: `reconstructedTransferOperator` is a
`PositiveTransferOperator`. Decay on the vacuum complement is equivalent to a correlation
inequality of the law (`CorrelationDecay`); that inequality, reflection positivity and
invariance all pass to weak limits.

**Wilson limits.** Reflection positivity is inherited from adapted half-lattice observables
before reconstruction. `WilsonLimitRegularity` records the three remaining regularity and
symmetry questions about the limit laws; the path conditions (`ContinuumCutoffPath.IsDyadic`)
and the symmetry of the constants (`HasReflectionInvariantFactors`) are explicit proved
arguments, not fields. Nothing assumes positive-time reflection positivity at finite periodic
cutoffs. `WilsonTransferLedger` records tightness, uniqueness (`LimitLawsAgree`) and an eventual
correlation bound for each fixed positive-time functional with one physical time and ratio.
`wilsonLimit_decay_and_generator_gap` passes that bound to each limit before reconstructing.
The obsolete `WilsonReflectionInputs` is retained only as a regression target: the negative
control refutes it on the explicit dyadic Wilson path. No physical mass gap is claimed.
-/

noncomputable section

namespace JesseMath.Physics.YangMillsReconstructedGeneratorGap

open Filter MeasureTheory
open scoped Topology InnerProductSpace BoundedContinuousFunction ComplexConjugate
open JesseMath.Physics.YangMillsPhysicalGap JesseMath.Physics.YangMillsRenormalizedObservableLimits

section Projection

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Orthogonal projection onto the vacuum ray, `u ↦ ⟪Ω, u⟫ Ω`. -/
def vacuumProjection (Ω : H) : H →L[ℂ] H := InnerProductSpace.rankOne ℂ Ω Ω

theorem vacuumProjection_apply (Ω u : H) : vacuumProjection Ω u = vacuumPart Ω u := by
  simp [vacuumProjection, vacuumPart, InnerProductSpace.rankOne_apply]

theorem norm_excitedPart_le {Ω : H} (hΩ : ‖Ω‖ = 1) (u : H) : ‖excitedPart Ω u‖ ≤ ‖u‖ := by
  have horth : ⟪vacuumPart Ω u, excitedPart Ω u⟫_ℂ = 0 := by
    simp [vacuumPart, excitedPart_orthogonal hΩ]
  have h := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth
  have hsum : vacuumPart Ω u + excitedPart Ω u = u := by simp [excitedPart]
  rw [hsum] at h
  nlinarith [norm_nonneg (vacuumPart Ω u), norm_nonneg (excitedPart Ω u), norm_nonneg u]

theorem excitedPart_of_orthogonal {Ω u : H} (hu : ⟪Ω, u⟫_ℂ = 0) : excitedPart Ω u = u := by
  simp [excitedPart, vacuumPart, hu]

end Projection

/-- Invertibility of `x - t` from invertibility of `x - (t - p)` when `p` is an idempotent
absorbed by `t` on both sides and `x ≠ 1`. -/
theorem isUnit_algebraMap_sub_of_projection {A : Type*} [Ring A] [Algebra ℝ A]
    {t p : A} {x : ℝ} (htp : t * p = p) (hpt : p * t = p) (hpp : p * p = p) (hx : x ≠ 1)
    (hunit : IsUnit (algebraMap ℝ A x - (t - p))) : IsUnit (algebraMap ℝ A x - t) := by
  obtain ⟨u, hu⟩ := hunit
  set c := algebraMap ℝ A x with hc
  set d := algebraMap ℝ A (x - 1)⁻¹ with hd
  have hx1 : x - 1 ≠ 0 := sub_ne_zero.mpr hx
  have hdc : d * (c - 1) = 1 := by
    rw [hd, hc, ← map_one (algebraMap ℝ A), ← map_sub, ← map_mul, inv_mul_cancel₀ hx1, map_one]
  have hdcomm : ∀ y : A, d * y = y * d := fun y => Algebra.commutes _ y
  have hccomm : ∀ y : A, c * y = y * c := fun y => Algebra.commutes _ y
  have hcomm : Commute (↑u : A) p := by
    show (↑u : A) * p = p * ↑u
    rw [hu]
    simp only [mul_sub, sub_mul, htp, hpt, hpp, hccomm p]
  have hcomm_inv : Commute (↑u⁻¹ : A) p := hcomm.units_inv_left
  have hcomm_inv' : (↑u⁻¹ : A) * (1 - p) = (1 - p) * ↑u⁻¹ := by
    rw [mul_sub, sub_mul, mul_one, one_mul, hcomm_inv.eq]
  have hcomm' : (↑u : A) * (1 - p) = (1 - p) * ↑u := by
    rw [mul_sub, sub_mul, mul_one, one_mul, hcomm.eq]
  have hap : (c - t) * p = (c - 1) * p := by
    simp only [sub_mul, htp, one_mul]
  have hpa : p * (c - t) = (c - 1) * p := by
    simp only [mul_sub, sub_mul, hpt, one_mul, hccomm p]
  have ha1p : (c - t) * (1 - p) = (↑u : A) * (1 - p) := by
    rw [hu]
    simp only [mul_sub, sub_mul, mul_one, htp, hpp]
    abel
  have h1pa : (1 - p) * (c - t) = (1 - p) * (↑u : A) := by
    rw [hu]
    simp only [mul_sub, sub_mul, one_mul, hpt, hpp]
    abel
  refine ⟨⟨c - t, d * p + ↑u⁻¹ * (1 - p), ?_, ?_⟩, rfl⟩
  · calc (c - t) * (d * p + ↑u⁻¹ * (1 - p))
          = d * ((c - t) * p) + (c - t) * (1 - p) * ↑u⁻¹ := by
            rw [mul_add, hcomm_inv', ← mul_assoc, ← mul_assoc, ← hdcomm (c - t), mul_assoc]
      _ = (d * (c - 1)) * p + (1 - p) * ((↑u : A) * ↑u⁻¹) := by
            rw [hap, ha1p, ← mul_assoc, ← mul_assoc, hcomm', mul_assoc (1 - p)]
      _ = 1 := by rw [hdc, one_mul, Units.mul_inv, mul_one]; abel
  · calc (d * p + ↑u⁻¹ * (1 - p)) * (c - t)
          = d * (p * (c - t)) + ↑u⁻¹ * ((1 - p) * (c - t)) := by
            rw [add_mul, mul_assoc, mul_assoc]
      _ = (d * (c - 1)) * p + (↑u⁻¹ * ↑u) * (1 - p) := by
            rw [hpa, h1pa, ← mul_assoc, ← mul_assoc, mul_assoc (↑u⁻¹ : A) (1 - p), ← hcomm',
              ← mul_assoc]
      _ = 1 := by rw [hdc, one_mul, Units.inv_mul, one_mul]; abel

section Transfer

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem vacuumProjection_isStarProjection {Ω : H} (hΩ : ‖Ω‖ = 1) :
    IsStarProjection (vacuumProjection Ω) :=
  InnerProductSpace.isStarProjection_rankOne_self hΩ

/-- A lattice transfer operator: a positive contraction (positivity in the Loewner order
includes self-adjointness) with a normalized vacuum vector that it fixes. -/
structure PositiveTransferOperator (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  /-- The one-step transfer operator. -/
  op : H →L[ℂ] H
  /-- The vacuum vector. -/
  vacuum : H
  /-- Positivity: `0 ≤ op` in the Loewner order. -/
  nonneg : 0 ≤ op
  /-- Normalization of the top of the spectrum. -/
  norm_le_one : ‖op‖ ≤ 1
  /-- The vacuum is a unit vector. -/
  vacuum_norm : ‖vacuum‖ = 1
  /-- The vacuum is fixed. -/
  vacuum_fixed : op vacuum = vacuum

namespace PositiveTransferOperator

variable (S : PositiveTransferOperator H)

theorem isSelfAdjoint : IsSelfAdjoint S.op := IsSelfAdjoint.of_nonneg S.nonneg

theorem isPositive : S.op.IsPositive := ContinuousLinearMap.nonneg_iff_isPositive.mp S.nonneg

theorem inner_op_left (u v : H) : ⟪S.op u, v⟫_ℂ = ⟪u, S.op v⟫_ℂ := by
  rw [← ContinuousLinearMap.adjoint_inner_right, S.isSelfAdjoint.adjoint_eq]

theorem inner_vacuum_op (u : H) : ⟪S.vacuum, S.op u⟫_ℂ = ⟪S.vacuum, u⟫_ℂ := by
  rw [← S.inner_op_left, S.vacuum_fixed]

theorem inner_vacuum_pow (n : ℕ) (u : H) : ⟪S.vacuum, (S.op ^ n) u⟫_ℂ = ⟪S.vacuum, u⟫_ℂ := by
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ', mul_apply_eq_comp, S.inner_vacuum_op, ih]

theorem op_mul_vacuumProjection :
    S.op * vacuumProjection S.vacuum = vacuumProjection S.vacuum := by
  ext u
  simp [vacuumProjection_apply, vacuumPart, S.vacuum_fixed]

theorem vacuumProjection_mul_op :
    vacuumProjection S.vacuum * S.op = vacuumProjection S.vacuum := by
  ext u
  simp [vacuumProjection_apply, vacuumPart, S.inner_vacuum_op]

/-- The transfer operator with the vacuum ray removed: it agrees with `op` on the vacuum
complement and vanishes on the vacuum. -/
def excitedOp : H →L[ℂ] H := S.op - vacuumProjection S.vacuum

theorem excitedOp_apply (u : H) : S.excitedOp u = S.op (excitedPart S.vacuum u) := by
  rw [map_excitedPart S.op S.vacuum_fixed u]
  simp [excitedOp, vacuumProjection_apply]

theorem excitedOp_apply_of_orthogonal {u : H} (hu : ⟪S.vacuum, u⟫_ℂ = 0) :
    S.excitedOp u = S.op u := by
  rw [S.excitedOp_apply, excitedPart_of_orthogonal hu]

theorem excitedOp_eq_conj :
    S.excitedOp =
      star (1 - vacuumProjection S.vacuum) * S.op * (1 - vacuumProjection S.vacuum) := by
  have hP := vacuumProjection_isStarProjection S.vacuum_norm
  rw [star_sub, star_one, hP.isSelfAdjoint.star_eq]
  simp only [sub_mul, mul_sub, one_mul, mul_one, S.op_mul_vacuumProjection,
    S.vacuumProjection_mul_op, hP.isIdempotentElem.eq, excitedOp]
  abel

theorem excitedOp_nonneg : 0 ≤ S.excitedOp := by
  rw [S.excitedOp_eq_conj]
  exact star_left_conjugate_nonneg S.nonneg _

theorem norm_excitedOp_le_iff {ρ : ℝ} (hρ : 0 ≤ ρ) :
    ‖S.excitedOp‖ ≤ ρ ↔ ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖ := by
  constructor
  · intro h u hu
    rw [← S.excitedOp_apply_of_orthogonal hu]
    exact (S.excitedOp.le_opNorm u).trans (mul_le_mul_of_nonneg_right h (norm_nonneg u))
  · intro h
    refine ContinuousLinearMap.opNorm_le_bound _ hρ fun u => ?_
    rw [S.excitedOp_apply]
    calc ‖S.op (excitedPart S.vacuum u)‖ ≤ ρ * ‖excitedPart S.vacuum u‖ :=
          h _ (excitedPart_orthogonal S.vacuum_norm u)
      _ ≤ ρ * ‖u‖ := mul_le_mul_of_nonneg_left (norm_excitedPart_le S.vacuum_norm u) hρ

theorem spectrum_excitedOp_subset_iff {ρ : ℝ} (hρ : 0 ≤ ρ) :
    spectrum ℝ S.excitedOp ⊆ Set.Icc 0 ρ ↔ ‖S.excitedOp‖ ≤ ρ := by
  rw [CStarAlgebra.norm_le_iff_le_algebraMap _ hρ S.excitedOp_nonneg,
    le_algebraMap_iff_spectrum_le (IsSelfAdjoint.of_nonneg S.excitedOp_nonneg)]
  constructor
  · intro h x hx
    exact (h hx).2
  · intro h x hx
    exact ⟨spectrum_nonneg_of_nonneg S.excitedOp_nonneg hx, h x hx⟩

/-- Exact identification at a fixed lattice operator. For fixed `T`, `Ω` and `ρ ≥ 0`, the
following are equivalent: (1) for every `n` and every vacuum-orthogonal `u`,
`‖Tⁿ u‖ ≤ ρⁿ ‖u‖`; (2) the same for `n = 1`; (3) `‖T - |Ω⟩⟨Ω|‖ ≤ ρ`; (4) the real spectrum
of `T - |Ω⟩⟨Ω|` lies in `[0, ρ]`. The operator `T - |Ω⟩⟨Ω|` acts as `T` on `Ω⊥`
(`excitedOp_apply_of_orthogonal`) and as `0` on the vacuum ray, so (4) is the statement about the
spectrum of `T` on the vacuum complement, with the point `0 ∈ [0, ρ]` adjoined. -/
theorem excited_decay_tfae {ρ : ℝ} (hρ : 0 ≤ ρ) :
    [∀ n : ℕ, ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖(S.op ^ n) u‖ ≤ ρ ^ n * ‖u‖,
     ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖,
     ‖S.excitedOp‖ ≤ ρ,
     spectrum ℝ S.excitedOp ⊆ Set.Icc 0 ρ].TFAE := by
  tfae_have 1 → 2 := fun h u hu => by simpa using h 1 u hu
  tfae_have 2 → 1 := by
    intro h n
    induction n with
    | zero => intro u _; simp
    | succ n ih =>
      intro u hu
      rw [pow_succ', mul_apply_eq_comp]
      calc ‖S.op ((S.op ^ n) u)‖ ≤ ρ * ‖(S.op ^ n) u‖ :=
            h _ (by rw [S.inner_vacuum_pow]; exact hu)
        _ ≤ ρ * (ρ ^ n * ‖u‖) := mul_le_mul_of_nonneg_left (ih u hu) hρ
        _ = ρ ^ (n + 1) * ‖u‖ := by ring
  tfae_have 2 ↔ 3 := (S.norm_excitedOp_le_iff hρ).symm
  tfae_have 3 ↔ 4 := (S.spectrum_excitedOp_subset_iff hρ).symm
  tfae_finish

theorem spectrum_op_subset_Icc : spectrum ℝ S.op ⊆ Set.Icc 0 1 := by
  intro x hx
  refine ⟨spectrum_nonneg_of_nonneg S.nonneg hx, ?_⟩
  calc x ≤ ‖x‖ := Real.le_norm_self x
    _ ≤ ‖S.op‖ := IsometricContinuousFunctionalCalculus.norm_spectrum_le S.op hx S.isSelfAdjoint
    _ ≤ 1 := S.norm_le_one

theorem one_mem_spectrum : (1 : ℝ) ∈ spectrum ℝ S.op := by
  rw [spectrum.mem_iff]
  rintro ⟨u, hu⟩
  have hkill : (↑u : H →L[ℂ] H) S.vacuum = 0 := by
    rw [hu]
    simp [S.vacuum_fixed]
  have hback := congrArg (fun A : H →L[ℂ] H => A S.vacuum) u.inv_mul
  simp only [mul_apply_eq_comp, hkill, map_zero, one_apply_eq_self] at hback
  have : ‖S.vacuum‖ = 0 := by rw [← hback, norm_zero]
  rw [S.vacuum_norm] at this
  exact one_ne_zero this

/-- With a one-step bound `ρ` on the vacuum complement, the whole real spectrum of `T` lies in
`[0, ρ] ∪ {1}`. -/
theorem spectrum_op_subset {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hdecay : ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖) :
    spectrum ℝ S.op ⊆ Set.Icc 0 ρ ∪ {1} := by
  intro x hx
  by_contra hcon
  simp only [Set.mem_union, Set.mem_singleton_iff, not_or] at hcon
  have hspec := (S.spectrum_excitedOp_subset_iff hρ).mpr ((S.norm_excitedOp_le_iff hρ).mpr hdecay)
  have hx' : x ∉ spectrum ℝ S.excitedOp := fun h => hcon.1 (hspec h)
  rw [spectrum.notMem_iff] at hx'
  rw [spectrum.mem_iff] at hx
  exact hx (isUnit_algebraMap_sub_of_projection S.op_mul_vacuumProjection
    S.vacuumProjection_mul_op (vacuumProjection_isStarProjection S.vacuum_norm).isIdempotentElem.eq
    hcon.2 hx')

/-- With `ρ < 1`, every fixed vector is a multiple of the vacuum: the eigenvalue `1` is simple. -/
theorem fixed_eq_vacuumPart {ρ : ℝ} (hρ1 : ρ < 1)
    (hdecay : ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖) {v : H} (hv : S.op v = v) :
    v = vacuumPart S.vacuum v := by
  have he : S.op (excitedPart S.vacuum v) = excitedPart S.vacuum v := by
    rw [map_excitedPart S.op S.vacuum_fixed, hv]
    rfl
  have hle := hdecay _ (excitedPart_orthogonal S.vacuum_norm v)
  rw [he] at hle
  have hzero : ‖excitedPart S.vacuum v‖ = 0 := by
    nlinarith [norm_nonneg (excitedPart S.vacuum v)]
  have : v - vacuumPart S.vacuum v = 0 := norm_eq_zero.mp hzero
  exact sub_eq_zero.mp this

theorem inner_op_pow_left (n : ℕ) (u v : H) : ⟪(S.op ^ n) u, v⟫_ℂ = ⟪u, (S.op ^ n) v⟫_ℂ := by
  induction n generalizing u v with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', mul_apply_eq_comp, S.inner_op_left, ih, ← mul_apply_eq_comp, ← pow_succ, pow_succ']

theorem norm_op_pow_sq_eq_re_inner (n : ℕ) (u : H) :
    ‖(S.op ^ n) u‖ ^ 2 = (⟪u, (S.op ^ (2 * n)) u⟫_ℂ).re := by
  rw [@norm_sq_eq_re_inner ℂ, S.inner_op_pow_left, ← mul_apply_eq_comp, ← pow_add, two_mul]
  rfl

theorem norm_op_pow_sq_le (n : ℕ) (u : H) :
    ‖(S.op ^ n) u‖ ^ 2 ≤ ‖u‖ * ‖(S.op ^ (2 * n)) u‖ := by
  rw [S.norm_op_pow_sq_eq_re_inner]
  exact (Complex.re_le_norm _).trans (norm_inner_le_norm u ((S.op ^ (2 * n)) u))

theorem norm_sq_mul_norm_op_pow_two_pow_le (k : ℕ) (u : H) :
    ‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 1)) ≤ ‖u‖ ^ (2 ^ (k + 1)) * ‖(S.op ^ (2 ^ k)) u‖ ^ 2 := by
  induction k with
  | zero => simp
  | succ k ih =>
    by_cases hu : ‖u‖ = 0
    · rw [hu]; simp
    · have hu_pos : 0 < ‖u‖ := lt_of_le_of_ne (norm_nonneg u) (Ne.symm hu)
      have hu2 : 0 < ‖u‖ ^ 2 := sq_pos_of_pos hu_pos
      have hsq : (‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 1))) ^ 2 ≤
          (‖u‖ ^ (2 ^ (k + 1)) * ‖(S.op ^ (2 ^ k)) u‖ ^ 2) ^ 2 :=
        pow_le_pow_left₀ (by positivity) ih 2
      have hcs : (‖(S.op ^ (2 ^ k)) u‖ ^ 2) ^ 2 ≤
          (‖u‖ * ‖(S.op ^ (2 * 2 ^ k)) u‖) ^ 2 :=
        pow_le_pow_left₀ (sq_nonneg _) (S.norm_op_pow_sq_le (2 ^ k) u) 2
      have hpow : 2 * 2 ^ k = 2 ^ (k + 1) := (pow_succ' 2 k).symm
      rw [hpow, mul_pow] at hcs
      have hcomb : (‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 1))) ^ 2 ≤
          ‖u‖ ^ 2 * (‖u‖ ^ (2 ^ (k + 2)) * ‖(S.op ^ (2 ^ (k + 1))) u‖ ^ 2) := by
        calc
          (‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 1))) ^ 2
            ≤ (‖u‖ ^ (2 ^ (k + 1)) * ‖(S.op ^ (2 ^ k)) u‖ ^ 2) ^ 2 := hsq
          _ = (‖u‖ ^ (2 ^ (k + 1))) ^ 2 * (‖(S.op ^ (2 ^ k)) u‖ ^ 2) ^ 2 := mul_pow _ _ 2
          _ ≤ (‖u‖ ^ (2 ^ (k + 1))) ^ 2 * (‖u‖ ^ 2 * ‖(S.op ^ (2 ^ (k + 1))) u‖ ^ 2) :=
              mul_le_mul_of_nonneg_left hcs (by positivity)
          _ = ‖u‖ ^ 2 * (‖u‖ ^ (2 ^ (k + 2)) * ‖(S.op ^ (2 ^ (k + 1))) u‖ ^ 2) := by
              have hexp : (‖u‖ ^ (2 ^ (k + 1))) ^ 2 = ‖u‖ ^ (2 ^ (k + 2)) := by
                rw [← pow_mul, show 2 ^ (k + 1) * 2 = 2 ^ (k + 2) from pow_succ 2 (k + 1)]
              rw [hexp]
              ring
      have h_lhs : (‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 1))) ^ 2 =
          ‖u‖ ^ 2 * (‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 2))) := by
        have hexp : (‖S.op u‖ ^ (2 ^ (k + 1))) ^ 2 = ‖S.op u‖ ^ (2 ^ (k + 2)) := by
          rw [← pow_mul, show 2 ^ (k + 1) * 2 = 2 ^ (k + 2) from pow_succ 2 (k + 1)]
        rw [mul_pow, ← hexp]
        ring
      rw [h_lhs] at hcomb
      exact le_of_mul_le_mul_left hcomb hu2

/-- Gap 4 (B1): A moment bound `Re ⟨u, T^{2n} u⟩ ≤ C · ρ^{2n}` (with `C` allowed to depend on `u`)
along even powers forces the constant-free one-step operator norm bound `‖T u‖ ≤ ρ ‖u‖`. -/
theorem decay_of_moment_bounds {ρ : ℝ} (hρ : 0 ≤ ρ) (u : H)
    (hmom : ∃ C : ℝ, ∀ n : ℕ, (⟪u, (S.op ^ (2 * n)) u⟫_ℂ).re ≤ C * ρ ^ (2 * n)) :
    ‖S.op u‖ ≤ ρ * ‖u‖ := by
  by_cases hu : ‖u‖ = 0
  · have hu0 : u = 0 := norm_eq_zero.mp hu
    simp [hu0]
  · have hu_pos : 0 < ‖u‖ := lt_of_le_of_ne (norm_nonneg u) (Ne.symm hu)
    have hu2 : 0 < ‖u‖ ^ 2 := sq_pos_of_pos hu_pos
    obtain ⟨C, hC⟩ := hmom
    have hstep : ∀ k : ℕ,
        ‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 1)) ≤ C * (ρ * ‖u‖) ^ (2 ^ (k + 1)) := by
      intro k
      have h1 := S.norm_sq_mul_norm_op_pow_two_pow_le k u
      have h2 : ‖(S.op ^ (2 ^ k)) u‖ ^ 2 ≤ C * ρ ^ (2 ^ (k + 1)) := by
        rw [S.norm_op_pow_sq_eq_re_inner (2 ^ k) u, pow_succ' 2 k]
        exact hC (2 ^ k)
      calc
        ‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (k + 1))
          ≤ ‖u‖ ^ (2 ^ (k + 1)) * ‖(S.op ^ (2 ^ k)) u‖ ^ 2 := h1
        _ ≤ ‖u‖ ^ (2 ^ (k + 1)) * (C * ρ ^ (2 ^ (k + 1))) :=
            mul_le_mul_of_nonneg_left h2 (by positivity)
        _ = C * (ρ * ‖u‖) ^ (2 ^ (k + 1)) := by rw [mul_pow]; ring
    by_contra hlt
    have hgt : ρ * ‖u‖ < ‖S.op u‖ := not_le.mp hlt
    by_cases hρu : ρ * ‖u‖ = 0
    · have hk0 := hstep 0
      rw [hρu] at hk0
      have hpos : 0 < ‖u‖ ^ 2 * ‖S.op u‖ ^ (2 ^ (0 + 1)) := by
        have hSu : 0 < ‖S.op u‖ := by linarith
        positivity
      norm_num at hk0 hpos
      linarith
    · have hρu_pos : 0 < ρ * ‖u‖ := lt_of_le_of_ne (mul_nonneg hρ hu_pos.le) (Ne.symm hρu)
      set r := ‖S.op u‖ / (ρ * ‖u‖)
      have hr : 1 < r := (one_lt_div hρu_pos).mpr hgt
      have hpow_le : ∀ k : ℕ, r ^ k ≤ C / ‖u‖ ^ 2 := by
        intro k
        have hle_exp : k ≤ 2 ^ (k + 1) :=
          (Nat.le_succ k).trans (Nat.le_of_lt (k + 1).lt_two_pow_self)
        have hrk : r ^ k ≤ r ^ (2 ^ (k + 1)) := pow_le_pow_right₀ hr.le hle_exp
        have hk := hstep k
        have hdiv : r ^ (2 ^ (k + 1)) ≤ C / ‖u‖ ^ 2 := by
          dsimp [r]
          rw [div_pow, div_le_iff₀ (pow_pos hρu_pos _), div_mul_eq_mul_div, le_div_iff₀' hu2]
          exact hk
        exact hrk.trans hdiv
      obtain ⟨k, hk⟩ := ((tendsto_pow_atTop_atTop_of_one_lt hr).eventually
        (eventually_gt_atTop (C / ‖u‖ ^ 2))).exists
      exact absurd (hpow_le k) (not_le.mpr hk)

/-- Vacuum-complement operator-norm contraction from vector-wise moment bounds. -/
theorem norm_excitedOp_le_of_moment_bounds {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hmom : ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 →
      ∃ C : ℝ, ∀ n : ℕ, (⟪u, (S.op ^ (2 * n)) u⟫_ℂ).re ≤ C * ρ ^ (2 * n)) :
    ‖S.excitedOp‖ ≤ ρ :=
  (S.norm_excitedOp_le_iff hρ).mpr fun u hu => S.decay_of_moment_bounds hρ u (hmom u hu)

end PositiveTransferOperator

/-- Functional calculus on an eigenvector: if `A v = μ v`, `f` is continuous on the spectrum
and differentiable at `μ`, then `f(A) v = f(μ) v`. The proof factors `f - f(μ)` through
`x - μ` with the continuous difference quotient `dslope f μ`. -/
theorem cfc_apply_of_eigenvector {A : H →L[ℂ] H} (hA : IsSelfAdjoint A) {v : H} {μ : ℝ}
    (hv : A v = μ • v) {f : ℝ → ℝ} (hf : ContinuousOn f (spectrum ℝ A))
    (hdf : DifferentiableAt ℝ f μ) : cfc f A v = f μ • v := by
  set k := dslope f μ with hk
  have hkcont : ContinuousOn k (spectrum ℝ A) := by
    intro y hy
    rcases eq_or_ne y μ with rfl | hne
    · exact (continuousAt_dslope_same.2 hdf).continuousWithinAt
    · exact (continuousWithinAt_dslope_of_ne hne).2 (hf y hy)
  have hdecomp : ∀ y, f y = f μ + k y * (y - μ) := by
    intro y
    have h := sub_smul_dslope f μ y
    rw [smul_eq_mul] at h
    rw [hk]
    linarith [h]
  have hlin : ContinuousOn (fun y : ℝ => y - μ) (spectrum ℝ A) :=
    continuousOn_id.sub continuousOn_const
  have hsub : cfc (fun y : ℝ => y - μ) A = A - algebraMap ℝ (H →L[ℂ] H) μ := by
    rw [cfc_sub (fun y : ℝ => y) (fun _ => μ) A, cfc_id' ℝ A hA, cfc_const μ A hA]
  have hcfc : cfc f A =
      algebraMap ℝ (H →L[ℂ] H) (f μ) + cfc k A * (A - algebraMap ℝ (H →L[ℂ] H) μ) := by
    rw [cfc_congr (fun y _ => hdecomp y),
      cfc_const_add (f μ) (fun y => k y * (y - μ)) A (hkcont.mul hlin),
      cfc_mul k (fun y : ℝ => y - μ) A hkcont hlin, hsub]
  have halg : ∀ c : ℝ, (algebraMap ℝ (H →L[ℂ] H) c) v = c • v := by
    intro c
    rw [Algebra.algebraMap_eq_smul_one, smul_apply, one_apply_eq_self]
  rw [hcfc, add_apply, mul_apply_eq_comp, sub_apply, hv,
    halg, halg, sub_self, map_zero, add_zero]

/-- A continuous function equal to `0` on `(-∞, ρ]` and to `1` at `1`. -/
def gapCutoff (ρ x : ℝ) : ℝ := max 0 ((x - ρ) / (1 - ρ))

theorem continuous_gapCutoff (ρ : ℝ) : Continuous (gapCutoff ρ) :=
  continuous_const.max ((continuous_id.sub continuous_const).div_const _)

theorem gapCutoff_of_le {ρ x : ℝ} (hρ1 : ρ < 1) (hx : x ≤ ρ) : gapCutoff ρ x = 0 :=
  max_eq_left (div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith))

theorem gapCutoff_one {ρ : ℝ} (hρ1 : ρ < 1) : gapCutoff ρ 1 = 1 := by
  unfold gapCutoff
  rw [div_self (by linarith : (1 : ℝ) - ρ ≠ 0)]
  norm_num

theorem differentiableAt_gapCutoff_one {ρ : ℝ} (hρ1 : ρ < 1) :
    DifferentiableAt ℝ (gapCutoff ρ) 1 := by
  have hc : Continuous (fun x : ℝ => (x - ρ) / (1 - ρ)) :=
    (continuous_id.sub continuous_const).div_const _
  have h1 : (0 : ℝ) < ((1 : ℝ) - ρ) / (1 - ρ) := by
    rw [div_self (by linarith : (1 : ℝ) - ρ ≠ 0)]
    norm_num
  have hpos : ∀ᶠ x in 𝓝 (1 : ℝ), 0 < (x - ρ) / (1 - ρ) :=
    (hc.tendsto 1).eventually_const_lt h1
  have hev : gapCutoff ρ =ᶠ[𝓝 1] fun x : ℝ => (x - ρ) / (1 - ρ) := by
    filter_upwards [hpos] with x hx
    exact max_eq_right hx.le
  exact ((differentiableAt_id.sub_const ρ).div_const _).congr_of_eventuallyEq hev

/-- Decay rate in physical time of a one-step bound `ρ` at lattice time step `a`:
`-(log ρ)/a`. It is a property of the pair `(a, ρ)`, not a physical gap by itself. -/
def transferGapRate (a ρ : ℝ) : ℝ := -Real.log ρ / a

theorem transferGapRate_pos {a ρ : ℝ} (ha : 0 < a) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) :
    0 < transferGapRate a ρ :=
  div_pos (neg_pos.mpr (Real.log_neg hρ0 hρ1)) ha

theorem rpow_div_eq_exp_transferGapRate {a ρ : ℝ} (hρ : 0 < ρ) (t : ℝ) :
    ρ ^ (t / a) = Real.exp (-transferGapRate a ρ * t) := by
  rw [Real.rpow_def_of_pos hρ, transferGapRate]
  congr 1
  ring

theorem transferGapRate_exp_neg {a : ℝ} (ha : a ≠ 0) (m : ℝ) :
    transferGapRate a (Real.exp (-m * a)) = m := by
  rw [transferGapRate, Real.log_exp]
  field_simp

namespace PositiveTransferOperator

variable (S : PositiveTransferOperator H)

/-- The vacuum projection is a continuous function of `T` once `T` has a one-step bound
`ρ < 1` on the vacuum complement: it is the spectral projection of the isolated eigenvalue
`1`. -/
theorem cfc_gapCutoff_eq_vacuumProjection {ρ : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hdecay : ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖) :
    cfc (gapCutoff ρ) S.op = vacuumProjection S.vacuum := by
  have hspec := S.spectrum_op_subset hρ hdecay
  set Q := cfc (gapCutoff ρ) S.op with hQ
  have hTQ : S.op * Q = Q := by
    have h1 : S.op * Q = cfc (fun x => x * gapCutoff ρ x) S.op := by
      rw [cfc_mul (fun x => x) (gapCutoff ρ) S.op continuousOn_id
        (continuous_gapCutoff ρ).continuousOn, cfc_id' ℝ S.op S.isSelfAdjoint]
    rw [h1]
    apply cfc_congr
    intro x hx
    rcases hspec hx with hx | hx
    · simp [gapCutoff_of_le hρ1 hx.2]
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      simp
  have hQsa : IsSelfAdjoint Q := IsSelfAdjoint.cfc
  have hQΩ : Q S.vacuum = S.vacuum := by
    have h := cfc_apply_of_eigenvector S.isSelfAdjoint (v := S.vacuum) (μ := 1)
      (by rw [one_smul, S.vacuum_fixed]) (continuous_gapCutoff ρ).continuousOn
      (differentiableAt_gapCutoff_one hρ1)
    rw [gapCutoff_one hρ1, one_smul] at h
    exact h
  ext u
  rw [vacuumProjection_apply]
  have hu : u = vacuumPart S.vacuum u + excitedPart S.vacuum u := by simp [excitedPart]
  have hQe : Q (excitedPart S.vacuum u) = 0 := by
    have hfix : S.op (Q (excitedPart S.vacuum u)) = Q (excitedPart S.vacuum u) := by
      rw [← mul_apply_eq_comp, hTQ]
    have hray := S.fixed_eq_vacuumPart hρ1 hdecay hfix
    have hinner : ⟪S.vacuum, Q (excitedPart S.vacuum u)⟫_ℂ = 0 := by
      rw [← ContinuousLinearMap.adjoint_inner_left, hQsa.adjoint_eq, hQΩ]
      exact excitedPart_orthogonal S.vacuum_norm u
    rw [hray, vacuumPart, hinner, zero_smul]
  conv_lhs => rw [hu]
  rw [map_add, hQe, add_zero]
  simp [vacuumPart, hQΩ]

/-- The evolution over physical time `t` at lattice time step `a`, defined by the continuous
functional calculus as `T^{t/a}`. The function `x ↦ x^{t/a}` is continuous on `[0, ∞)` for
`t/a ≥ 0`, so the definition needs no assumption about `0` in the spectrum. -/
def evolution (a t : ℝ) : H →L[ℂ] H := cfc (fun x : ℝ => x ^ (t / a)) S.op

theorem evolution_zero (a : ℝ) : S.evolution a 0 = 1 := by
  simp only [evolution, zero_div, Real.rpow_zero]
  exact cfc_const_one ℝ S.op S.isSelfAdjoint

theorem evolution_natCast_mul {a : ℝ} (ha : a ≠ 0) (n : ℕ) :
    S.evolution a (n * a) = S.op ^ n := by
  simp only [evolution, mul_div_cancel_right₀ _ ha, Real.rpow_natCast]
  exact cfc_pow_id S.op n S.isSelfAdjoint

theorem evolution_add {a t s : ℝ} (ha : 0 < a) (ht : 0 ≤ t) (hs : 0 ≤ s) :
    S.evolution a (t + s) = S.evolution a t * S.evolution a s := by
  rw [evolution, evolution, evolution, ← cfc_mul (fun x : ℝ => x ^ (t / a))
    (fun x : ℝ => x ^ (s / a)) S.op (Real.continuous_rpow_const (div_nonneg ht ha.le)).continuousOn
    (Real.continuous_rpow_const (div_nonneg hs ha.le)).continuousOn]
  apply cfc_congr
  intro x hx
  have hx0 : 0 ≤ x := (S.spectrum_op_subset_Icc hx).1
  dsimp only
  rw [add_div, Real.rpow_add_of_nonneg hx0 (div_nonneg ht ha.le) (div_nonneg hs ha.le)]

theorem evolution_nonneg (a t : ℝ) : 0 ≤ S.evolution a t :=
  cfc_nonneg fun _ hx => Real.rpow_nonneg (S.spectrum_op_subset_Icc hx).1 _

theorem norm_evolution_le_one {a t : ℝ} (ha : 0 < a) (ht : 0 ≤ t) : ‖S.evolution a t‖ ≤ 1 := by
  apply norm_cfc_le zero_le_one
  intro x hx
  have hx' := S.spectrum_op_subset_Icc hx
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg hx'.1 _)]
  exact Real.rpow_le_one hx'.1 hx'.2 (div_nonneg ht ha.le)

theorem evolution_vacuum {a t : ℝ} (ha : 0 < a) (ht : 0 ≤ t) :
    S.evolution a t S.vacuum = S.vacuum := by
  have hr : 0 ≤ t / a := div_nonneg ht ha.le
  have h := cfc_apply_of_eigenvector S.isSelfAdjoint (v := S.vacuum) (μ := 1)
    (by rw [one_smul, S.vacuum_fixed]) (Real.continuous_rpow_const hr).continuousOn
    (Real.hasDerivAt_rpow_const (Or.inl one_ne_zero)).differentiableAt
  rw [Real.one_rpow, one_smul] at h
  exact h

/-- Decay of the evolution on the vacuum complement at every nonnegative physical time. -/
theorem norm_evolution_le_of_orthogonal {a t ρ : ℝ} (ha : 0 < a) (ht : 0 ≤ t) (hρ : 0 ≤ ρ)
    (hρ1 : ρ < 1) (hdecay : ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖)
    {u : H} (hu : ⟪S.vacuum, u⟫_ℂ = 0) :
    ‖S.evolution a t u‖ ≤ ρ ^ (t / a) * ‖u‖ := by
  have hspec := S.spectrum_op_subset hρ hdecay
  have hr : 0 ≤ t / a := div_nonneg ht ha.le
  have hP := S.cfc_gapCutoff_eq_vacuumProjection hρ hρ1 hdecay
  have h1 : u = (1 - vacuumProjection S.vacuum) u := by
    simp [vacuumProjection_apply, vacuumPart, hu]
  have h2 : (1 : H →L[ℂ] H) - vacuumProjection S.vacuum =
      cfc (fun x : ℝ => 1 - gapCutoff ρ x) S.op := by
    rw [← hP, cfc_sub (fun _ => (1 : ℝ)) (gapCutoff ρ) S.op continuousOn_const
      (continuous_gapCutoff ρ).continuousOn, cfc_const_one ℝ S.op S.isSelfAdjoint]
  have hcomp : S.evolution a t u =
      cfc (fun x : ℝ => x ^ (t / a) * (1 - gapCutoff ρ x)) S.op u := by
    rw [cfc_mul (fun x : ℝ => x ^ (t / a)) (fun x => 1 - gapCutoff ρ x) S.op
      (Real.continuous_rpow_const hr).continuousOn
      (continuousOn_const.sub (continuous_gapCutoff ρ).continuousOn), mul_apply_eq_comp, ← h2,
      ← h1]
    rfl
  rw [hcomp]
  refine (ContinuousLinearMap.le_opNorm _ _).trans (mul_le_mul_of_nonneg_right ?_ (norm_nonneg u))
  apply norm_cfc_le (Real.rpow_nonneg hρ _)
  intro x hx
  rcases hspec hx with hx | hx
  · rw [gapCutoff_of_le hρ1 hx.2, sub_zero, mul_one, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg hx.1 _)]
    exact Real.rpow_le_rpow hx.1 hx.2 hr
  · rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [gapCutoff_one hρ1, sub_self, mul_zero, norm_zero]
    exact Real.rpow_nonneg hρ _

theorem evolution_self {a : ℝ} (ha : a ≠ 0) : S.evolution a a = S.op := by
  simpa using S.evolution_natCast_mul ha 1

/-- Exact identification in physical time: for `a, m > 0`, decay of the evolution at rate `m`
on the vacuum complement for every physical time `t ≥ 0` is equivalent to the one-step bound
`e^{-m a}` on the vacuum complement. -/
theorem evolution_decay_iff {a m : ℝ} (ha : 0 < a) (hm : 0 < m) :
    (∀ t : ℝ, 0 ≤ t → ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 →
      ‖S.evolution a t u‖ ≤ Real.exp (-m * t) * ‖u‖) ↔
    ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ Real.exp (-m * a) * ‖u‖ := by
  constructor
  · intro h u hu
    simpa [S.evolution_self ha.ne'] using h a ha.le u hu
  · intro h t ht u hu
    have hρ1 : Real.exp (-m * a) < 1 := Real.exp_lt_one_iff.mpr (by nlinarith)
    have hdec := S.norm_evolution_le_of_orthogonal ha ht (Real.exp_pos _).le hρ1 h hu
    rwa [← Real.exp_mul, show -m * a * (t / a) = -m * t by field_simp] at hdec

/-- Domain of the generator of `t ↦ T^{t/a}`: the vectors along which the evolution has a
right derivative at time `0`. -/
def generatorDomain (a : ℝ) : Submodule ℂ H where
  carrier := {u | DifferentiableWithinAt ℝ (fun t : ℝ => S.evolution a t u) (Set.Ioi 0) 0}
  zero_mem' := by
    simp only [Set.mem_ofPred_eq, map_zero]
    exact differentiableWithinAt_const 0
  add_mem' := by
    intro u v hu hv
    simp only [Set.mem_ofPred_eq, map_add] at hu hv ⊢
    exact hu.add hv
  smul_mem' := by
    intro c u hu
    simp only [Set.mem_ofPred_eq, map_smul] at hu ⊢
    exact hu.const_smul c

/-- The generator `H_a` of the evolution: `H_a u = -(d/dt) T^{t/a} u` at `t = 0⁺`. -/
def generator (a : ℝ) : S.generatorDomain a →ₗ[ℂ] H where
  toFun u := -derivWithin (fun t : ℝ => S.evolution a t u) (Set.Ioi 0) 0
  map_add' u v := by
    simp only [Submodule.coe_add, map_add]
    rw [derivWithin_fun_add u.2 v.2, neg_add]
  map_smul' c u := by
    simp only [Submodule.coe_smul, map_smul, RingHom.id_apply]
    rw [derivWithin_fun_const_smul c u.2, smul_neg]

theorem hasDerivWithinAt_generator (a : ℝ) (u : S.generatorDomain a) :
    HasDerivWithinAt (fun t : ℝ => S.evolution a t u) (-(S.generator a u)) (Set.Ioi 0) 0 := by
  have h : DifferentiableWithinAt ℝ (fun t : ℝ => S.evolution a t u) (Set.Ioi 0) 0 := u.2
  simpa [generator] using h.hasDerivWithinAt

theorem generator_eq_of_hasDerivWithinAt {a : ℝ} {u v : H}
    (h : HasDerivWithinAt (fun t : ℝ => S.evolution a t u) (-v) (Set.Ioi 0) 0) :
    ∃ hu : u ∈ S.generatorDomain a, S.generator a ⟨u, hu⟩ = v := by
  refine ⟨h.differentiableWithinAt, ?_⟩
  change -derivWithin (fun t : ℝ => S.evolution a t u) (Set.Ioi 0) 0 = v
  rw [h.derivWithin (uniqueDiffWithinAt_Ioi 0), neg_neg]

/-- The vacuum lies in the generator domain and has energy zero. -/
theorem generator_vacuum {a : ℝ} (ha : 0 < a) :
    ∃ h : S.vacuum ∈ S.generatorDomain a, S.generator a ⟨S.vacuum, h⟩ = 0 := by
  apply S.generator_eq_of_hasDerivWithinAt
  rw [neg_zero]
  exact (hasDerivWithinAt_const (0 : ℝ) (Set.Ioi 0) S.vacuum).congr
    (fun t ht => S.evolution_vacuum ha (le_of_lt ht)) (S.evolution_vacuum ha le_rfl)

/-- Generator gap: for every `u` in the generator domain orthogonal to the vacuum,
`transferGapRate a ρ ‖u‖² ≤ Re ⟪u, H_a u⟫`. The proof goes through the existing bridge
`generator_coercivity_of_decay`. -/
theorem generator_gap {a ρ : ℝ} (ha : 0 < a) (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hdecay : ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖)
    (u : S.generatorDomain a) (hu : ⟪S.vacuum, (u : H)⟫_ℂ = 0) :
    transferGapRate a ρ * ‖(u : H)‖ ^ 2 ≤ (⟪(u : H), S.generator a u⟫_ℂ).re :=
  generator_coercivity_of_decay (S.evolution a) u (S.generator a u) (transferGapRate a ρ)
    (by rw [S.evolution_zero]; rfl) (S.hasDerivWithinAt_generator a u)
    (fun t ht => by
      rw [← rpow_div_eq_exp_transferGapRate hρ0]
      exact S.norm_evolution_le_of_orthogonal ha ht.le hρ0.le hρ1 hdecay hu)

/-! ### Zero in the spectrum and the bounded logarithm -/

/-- The lattice Hamiltonian `-(log T)/a` through the continuous functional calculus. It is
meaningful only when `0 ∉ spectrum ℝ T`. When `0` is in the spectrum, either `-log` is not
continuous on the spectrum and `cfc` returns its default value `0`, or `0` is an isolated
eigenvalue and the value is computed with Mathlib's convention `Real.log 0 = 0`; in neither
case is it a generator of `T` (see the negative control
`exp_logGenerator_needs_zero_not_mem_spectrum`). -/
def logGenerator (a : ℝ) : H →L[ℂ] H := cfc (fun x : ℝ => -Real.log x / a) S.op

theorem continuousOn_neg_log_div_spectrum {a : ℝ} (h0 : (0 : ℝ) ∉ spectrum ℝ S.op) :
    ContinuousOn (fun x : ℝ => -Real.log x / a) (spectrum ℝ S.op) := by
  have hsub : spectrum ℝ S.op ⊆ {0}ᶜ := fun x hx hx0 =>
    h0 (by rwa [Set.mem_singleton_iff.mp hx0] at hx)
  exact (Real.continuousOn_log.mono hsub).neg.div_const a

theorem pos_of_mem_spectrum {x : ℝ} (h0 : (0 : ℝ) ∉ spectrum ℝ S.op) (hx : x ∈ spectrum ℝ S.op) :
    0 < x :=
  lt_of_le_of_ne (S.spectrum_op_subset_Icc hx).1 (fun h => h0 (h ▸ hx))

/-- When `0 ∉ spectrum ℝ T`, the bounded operator `G = -(log T)/a` generates `T` at time `a`:
`exp(-a G) = T`. -/
theorem cfc_exp_logGenerator {a : ℝ} (ha : a ≠ 0) (h0 : (0 : ℝ) ∉ spectrum ℝ S.op) :
    cfc (fun y : ℝ => Real.exp (-a * y)) (S.logGenerator a) = S.op := by
  rw [logGenerator, ← cfc_comp (fun y : ℝ => Real.exp (-a * y)) (fun x : ℝ => -Real.log x / a)
    S.op S.isSelfAdjoint (by fun_prop) (S.continuousOn_neg_log_div_spectrum h0)]
  conv_rhs => rw [← cfc_id' ℝ S.op S.isSelfAdjoint]
  apply cfc_congr
  intro x hx
  have hxpos := S.pos_of_mem_spectrum h0 hx
  simp only [Function.comp_apply]
  rw [show -a * (-Real.log x / a) = Real.log x by field_simp, Real.exp_log hxpos]

theorem logGenerator_nonneg {a : ℝ} (ha : 0 < a) : 0 ≤ S.logGenerator a := by
  apply cfc_nonneg
  intro x hx
  have hx' := S.spectrum_op_subset_Icc hx
  exact div_nonneg (neg_nonneg.mpr (Real.log_nonpos hx'.1 hx'.2)) ha.le

theorem logGenerator_vacuum {a : ℝ} (h0 : (0 : ℝ) ∉ spectrum ℝ S.op) :
    S.logGenerator a S.vacuum = 0 := by
  have h := cfc_apply_of_eigenvector S.isSelfAdjoint (v := S.vacuum) (μ := 1)
    (by rw [one_smul, S.vacuum_fixed]) (S.continuousOn_neg_log_div_spectrum (a := a) h0)
    ((Real.differentiableAt_log one_ne_zero).neg.div_const a)
  rw [Real.log_one, neg_zero, zero_div, zero_smul] at h
  exact h

/-- Gap of the bounded logarithmic Hamiltonian on the vacuum complement, when `0` is not in the
spectrum of `T`. -/
theorem logGenerator_gap {a ρ : ℝ} (ha : 0 < a) (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (h0 : (0 : ℝ) ∉ spectrum ℝ S.op)
    (hdecay : ∀ u : H, ⟪S.vacuum, u⟫_ℂ = 0 → ‖S.op u‖ ≤ ρ * ‖u‖)
    {u : H} (hu : ⟪S.vacuum, u⟫_ℂ = 0) :
    transferGapRate a ρ * ‖u‖ ^ 2 ≤ (⟪u, S.logGenerator a u⟫_ℂ).re := by
  have hspec := S.spectrum_op_subset hρ hdecay
  have hP := S.cfc_gapCutoff_eq_vacuumProjection hρ hρ1 hdecay
  set m := transferGapRate a ρ with hm
  have hle : cfc (fun x : ℝ => m * (1 - gapCutoff ρ x)) S.op ≤ S.logGenerator a := by
    apply cfc_mono (f := fun x : ℝ => m * (1 - gapCutoff ρ x))
      (hf := continuousOn_const.mul (continuousOn_const.sub
      (continuous_gapCutoff ρ).continuousOn)) (hg := S.continuousOn_neg_log_div_spectrum h0)
    intro x hx
    show m * (1 - gapCutoff ρ x) ≤ -Real.log x / a
    have hxpos := S.pos_of_mem_spectrum h0 hx
    rcases hspec hx with hx' | hx'
    · rw [gapCutoff_of_le hρ1 hx'.2, sub_zero, mul_one, hm, transferGapRate]
      apply div_le_div_of_nonneg_right _ ha.le
      exact neg_le_neg (Real.log_le_log hxpos hx'.2)
    · rw [Set.mem_singleton_iff] at hx'
      subst hx'
      rw [gapCutoff_one hρ1, sub_self, mul_zero, Real.log_one, neg_zero, zero_div]
  have hcfc : cfc (fun x : ℝ => m * (1 - gapCutoff ρ x)) S.op =
      m • ((1 : H →L[ℂ] H) - vacuumProjection S.vacuum) := by
    rw [cfc_const_mul m (fun x => 1 - gapCutoff ρ x) S.op
      (continuousOn_const.sub (continuous_gapCutoff ρ).continuousOn),
      cfc_sub (fun _ => (1 : ℝ)) (gapCutoff ρ) S.op continuousOn_const
      (continuous_gapCutoff ρ).continuousOn, cfc_const_one ℝ S.op S.isSelfAdjoint, hP]
  rw [hcfc, ContinuousLinearMap.le_def] at hle
  have hpos := hle.re_inner_nonneg_left u
  have h1u : ((1 : H →L[ℂ] H) - vacuumProjection S.vacuum) u = u := by
    simp [vacuumProjection_apply, vacuumPart, hu]
  rw [sub_apply, smul_apply, h1u, inner_sub_left, map_sub] at hpos
  simp only [RCLike.re_to_complex] at hpos
  have hre : (⟪m • u, u⟫_ℂ).re = m * ‖u‖ ^ 2 := by
    rw [RCLike.real_smul_eq_coe_smul (K := ℂ) m u, inner_smul_left, inner_self_eq_norm_sq_to_K]
    simp only [RCLike.conj_ofReal]
    norm_cast
  have hsymm : (⟪S.logGenerator a u, u⟫_ℂ).re = (⟪u, S.logGenerator a u⟫_ℂ).re := by
    rw [← inner_conj_symm, Complex.conj_re]
  linarith

/-- A positive lower bound for the spectrum when `0` is not in it. -/
theorem exists_spectrum_lower_bound (h0 : (0 : ℝ) ∉ spectrum ℝ S.op) :
    ∃ δ : ℝ, 0 < δ ∧ δ ≤ 1 ∧ ∀ x ∈ spectrum ℝ S.op, δ ≤ x := by
  obtain ⟨x₀, hx₀, hmin⟩ := (ContinuousFunctionalCalculus.isCompact_spectrum S.op).exists_isMinOn
    ⟨1, S.one_mem_spectrum⟩ continuousOn_id
  exact ⟨x₀, S.pos_of_mem_spectrum h0 hx₀, (S.spectrum_op_subset_Icc hx₀).2,
    fun x hx => hmin hx⟩

/-- Second-order remainder of the evolution around `1 - t G`, with `G = -(log T)/a`. -/
theorem norm_evolution_sub_one_add_smul_logGenerator_le {a t : ℝ} (ha : 0 < a) (ht : 0 ≤ t)
    (h0 : (0 : ℝ) ∉ spectrum ℝ S.op) {δ : ℝ} (hδ : 0 < δ)
    (hδx : ∀ x ∈ spectrum ℝ S.op, δ ≤ x) (hsmall : t / a * (-Real.log δ) ≤ 1) :
    ‖S.evolution a t - 1 + t • S.logGenerator a‖ ≤ (t / a * (-Real.log δ)) ^ 2 := by
  have hlogc := S.continuousOn_neg_log_div_spectrum (a := a) h0
  have hpow : ContinuousOn (fun x : ℝ => x ^ (t / a)) (spectrum ℝ S.op) :=
    (Real.continuous_rpow_const (div_nonneg ht ha.le)).continuousOn
  have heq : S.evolution a t - 1 + t • S.logGenerator a =
      cfc (fun x : ℝ => x ^ (t / a) - 1 + t * (-Real.log x / a)) S.op := by
    rw [cfc_add (a := S.op) (fun x : ℝ => x ^ (t / a) - 1) (fun x => t * (-Real.log x / a))
      (hpow.sub continuousOn_const) (continuousOn_const.mul hlogc),
      cfc_sub (fun x : ℝ => x ^ (t / a)) (fun _ => (1 : ℝ)) S.op hpow continuousOn_const,
      cfc_const_one ℝ S.op S.isSelfAdjoint, cfc_const_mul t (fun x => -Real.log x / a) S.op hlogc]
    rfl
  rw [heq]
  apply norm_cfc_le (sq_nonneg _)
  intro x hx
  have hxpos := S.pos_of_mem_spectrum h0 hx
  have hx1 := (S.spectrum_op_subset_Icc hx).2
  have hlogx : |t / a * Real.log x| ≤ t / a * (-Real.log δ) := by
    rw [abs_mul, abs_of_nonneg (div_nonneg ht ha.le), abs_of_nonpos (Real.log_nonpos hxpos.le hx1)]
    exact mul_le_mul_of_nonneg_left (neg_le_neg (Real.log_le_log hδ (hδx x hx)))
      (div_nonneg ht ha.le)
  have hz : |t / a * Real.log x| ≤ 1 := hlogx.trans hsmall
  have hval : x ^ (t / a) - 1 + t * (-Real.log x / a) =
      Real.exp (t / a * Real.log x) - 1 - t / a * Real.log x := by
    rw [Real.rpow_def_of_pos hxpos, mul_comm (Real.log x)]
    ring
  rw [hval, Real.norm_eq_abs]
  calc |Real.exp (t / a * Real.log x) - 1 - t / a * Real.log x| ≤ (t / a * Real.log x) ^ 2 :=
        Real.abs_exp_sub_one_sub_id_le hz
    _ = |t / a * Real.log x| ^ 2 := (sq_abs _).symm
    _ ≤ (t / a * (-Real.log δ)) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) hlogx 2

/-- When `0 ∉ spectrum ℝ T`, the evolution `t ↦ T^{t/a} u` has right derivative `-G u` at
`0`, with `G = -(log T)/a` from the functional calculus. -/
theorem hasDerivWithinAt_evolution_logGenerator {a : ℝ} (ha : 0 < a)
    (h0 : (0 : ℝ) ∉ spectrum ℝ S.op) (u : H) :
    HasDerivWithinAt (fun t : ℝ => S.evolution a t u) (-(S.logGenerator a u)) (Set.Ioi 0) 0 := by
  obtain ⟨δ, hδ, -, hδx⟩ := S.exists_spectrum_lower_bound h0
  set Λ := -Real.log δ with hΛ
  rw [hasDerivWithinAt_iff_tendsto_slope' (by simp), tendsto_iff_norm_sub_tendsto_zero]
  have hsmall : ∀ᶠ t in 𝓝[Set.Ioi 0] (0 : ℝ), t / a * Λ ≤ 1 := by
    have hc : Tendsto (fun t : ℝ => t / a * Λ) (𝓝[Set.Ioi 0] 0) (𝓝 0) := by
      have : Tendsto (fun t : ℝ => t / a * Λ) (𝓝 0) (𝓝 (0 / a * Λ)) :=
        ((continuous_id.div_const a).mul continuous_const).tendsto 0
      rw [zero_div, zero_mul] at this
      exact this.mono_left nhdsWithin_le_nhds
    exact hc.eventually (ge_mem_nhds zero_lt_one)
  have hbound : ∀ᶠ t in 𝓝[Set.Ioi 0] (0 : ℝ),
      ‖slope (fun t : ℝ => S.evolution a t u) 0 t - -(S.logGenerator a u)‖ ≤
        t * (Λ / a) ^ 2 * ‖u‖ := by
    filter_upwards [hsmall, self_mem_nhdsWithin] with t ht htpos
    have htpos' : 0 < t := htpos
    rw [slope_def_module, sub_zero, S.evolution_zero, one_apply_eq_self, sub_neg_eq_add]
    have hrw : t⁻¹ • (S.evolution a t u - u) + S.logGenerator a u =
        t⁻¹ • ((S.evolution a t - 1 + t • S.logGenerator a) u) := by
      rw [add_apply, sub_apply, one_apply_eq_self, smul_apply, smul_add, smul_smul,
        inv_mul_cancel₀ htpos'.ne', one_smul]
    rw [hrw, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr htpos')]
    have hop := S.norm_evolution_sub_one_add_smul_logGenerator_le ha htpos'.le h0 hδ hδx ht
    calc t⁻¹ * ‖(S.evolution a t - 1 + t • S.logGenerator a) u‖
        ≤ t⁻¹ * ((t / a * Λ) ^ 2 * ‖u‖) :=
          mul_le_mul_of_nonneg_left ((ContinuousLinearMap.le_opNorm _ _).trans
            (mul_le_mul_of_nonneg_right hop (norm_nonneg u))) (inv_nonneg.mpr htpos'.le)
      _ = t * (Λ / a) ^ 2 * ‖u‖ := by field_simp
  refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) hbound ?_
  have : Tendsto (fun t : ℝ => t * (Λ / a) ^ 2 * ‖u‖) (𝓝 0) (𝓝 (0 * (Λ / a) ^ 2 * ‖u‖)) :=
    ((continuous_id.mul continuous_const).mul continuous_const).tendsto 0
  rw [zero_mul, zero_mul] at this
  exact this.mono_left nhdsWithin_le_nhds

/-- Exact identification: when `0 ∉ spectrum ℝ T`, every vector lies in the generator domain and
the generator of `t ↦ T^{t/a}` is the functional-calculus logarithm `-(log T)/a`. -/
theorem generator_eq_logGenerator {a : ℝ} (ha : 0 < a) (h0 : (0 : ℝ) ∉ spectrum ℝ S.op)
    (u : H) : ∃ hu : u ∈ S.generatorDomain a, S.generator a ⟨u, hu⟩ = S.logGenerator a u :=
  S.generator_eq_of_hasDerivWithinAt (S.hasDerivWithinAt_evolution_logGenerator ha h0 u)

/-- If `0` is in the spectrum of `T`, then `T` is not `exp(-a G)` for any bounded self-adjoint
`G`, by the spectral mapping theorem. In that case only the evolution-based generator
`generator` is used. -/
theorem not_exists_bounded_generator_of_zero_mem_spectrum {T : H →L[ℂ] H}
    (h0 : (0 : ℝ) ∈ spectrum ℝ T) (a : ℝ) :
    ¬ ∃ G : H →L[ℂ] H, IsSelfAdjoint G ∧ cfc (fun y : ℝ => Real.exp (-a * y)) G = T := by
  rintro ⟨G, hG, hT⟩
  have hmap := cfc_map_spectrum (fun y : ℝ => Real.exp (-a * y)) G hG (by fun_prop)
  rw [hT] at hmap
  rw [hmap] at h0
  obtain ⟨y, _, hy⟩ := h0
  exact (Real.exp_pos _).ne' hy

/-- Bounded functional-calculus resolvent kernel `(1 - log x / a)⁻¹` on `(0, 1]` extended by `0`
on `(-∞, 0]`, well-defined on the full spectrum `[0, 1]` without assuming `0 ∉ spectrum ℝ T`. -/
def resolventKernel (a x : ℝ) : ℝ :=
  if x ≤ 0 then 0 else (1 - Real.log x / a)⁻¹

theorem resolventKernel_zero (a : ℝ) : resolventKernel a 0 = 0 := by
  simp [resolventKernel]

theorem resolventKernel_one (a : ℝ) : resolventKernel a 1 = 1 := by
  simp [resolventKernel]

theorem resolventKernel_nonneg {a x : ℝ} (ha : 0 < a) (hx1 : x ≤ 1) :
    0 ≤ resolventKernel a x := by
  unfold resolventKernel
  split_ifs with hx0
  · exact le_rfl
  · have hx_pos : 0 < x := not_le.mp hx0
    have hlog : Real.log x ≤ 0 := Real.log_nonpos hx_pos.le hx1
    have hdiv : Real.log x / a ≤ 0 := div_nonpos_of_nonpos_of_nonneg hlog ha.le
    exact inv_nonneg.mpr (by linarith)

theorem resolventKernel_le_one {a x : ℝ} (ha : 0 < a) (hx1 : x ≤ 1) :
    resolventKernel a x ≤ 1 := by
  unfold resolventKernel
  split_ifs with hx0
  · exact zero_le_one
  · have hx_pos : 0 < x := not_le.mp hx0
    have hlog : Real.log x ≤ 0 := Real.log_nonpos hx_pos.le hx1
    have hdiv : Real.log x / a ≤ 0 := div_nonpos_of_nonpos_of_nonneg hlog ha.le
    exact inv_le_one_of_one_le₀ (by linarith)

theorem resolventKernel_le_of_le {a x ρ : ℝ} (ha : 0 < a) (hx : x ≤ ρ)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) :
    resolventKernel a x ≤ (1 + transferGapRate a ρ)⁻¹ := by
  have hm_pos : 0 < transferGapRate a ρ := transferGapRate_pos ha hρ0 hρ1
  unfold resolventKernel
  split_ifs with hx0
  · exact inv_nonneg.mpr (by linarith)
  · have hx_pos : 0 < x := not_le.mp hx0
    have hlog : Real.log x ≤ Real.log ρ := Real.log_le_log hx_pos hx
    have hdiv : Real.log x / a ≤ Real.log ρ / a := div_le_div_of_nonneg_right hlog ha.le
    have hden_pos : 0 < 1 + transferGapRate a ρ := by linarith
    have hden_le : 1 + transferGapRate a ρ ≤ 1 - Real.log x / a := by
      unfold transferGapRate
      rw [neg_div]
      linarith
    exact inv_anti₀ hden_pos hden_le

/-- Bounded functional-calculus resolvent `(1 + H_a)⁻¹` at energy `-1`, defined via
`cfc (resolventKernel a) S.op` without requiring `0 ∉ spectrum ℝ S.op`. -/
def resolventMinusOne (a : ℝ) : H →L[ℂ] H :=
  cfc (resolventKernel a) S.op

theorem resolventMinusOne_selfAdjoint (a : ℝ) : IsSelfAdjoint (S.resolventMinusOne a) :=
  IsSelfAdjoint.cfc

theorem resolventMinusOne_nonneg {a : ℝ} (ha : 0 < a) : 0 ≤ S.resolventMinusOne a :=
  cfc_nonneg fun _ hx => resolventKernel_nonneg ha (S.spectrum_op_subset_Icc hx).2

end PositiveTransferOperator

/-! ### Connection with the cutoff bridge of `YangMillsPhysicalGap` -/

/-- A sequence of lattice transfer operators on a common Hilbert space, with physical spacings
`a n`, one-step bounds `ρ n < 1` on their own vacuum complements, and a lower bound
`m ≤ transferGapRate (a n) (ρ n)` holding for every `n` (uniformity in physical units), supplies
the vacuum-preservation and decay inputs `hfix`, `hdecay` of
`physical_generator_gap_and_excited_resolvent_exclusion_from_cutoff_decay`. -/
theorem cutoff_evolution_inputs {Sn : ℕ → PositiveTransferOperator H} {a ρ : ℕ → ℝ} {m : ℝ}
    (ha : ∀ n, 0 < a n) (hρ0 : ∀ n, 0 < ρ n) (hρ1 : ∀ n, ρ n < 1)
    (hdecay : ∀ n u, ⟪(Sn n).vacuum, u⟫_ℂ = 0 → ‖(Sn n).op u‖ ≤ ρ n * ‖u‖)
    (hm : ∀ n, m ≤ transferGapRate (a n) (ρ n)) :
    (∀ n t, 0 ≤ t → (Sn n).evolution (a n) t (Sn n).vacuum = (Sn n).vacuum) ∧
    ∀ n t, 0 ≤ t → ∀ u : H, ‖(Sn n).evolution (a n) t (excitedPart (Sn n).vacuum u)‖ ≤
      Real.exp (-m * t) * ‖excitedPart (Sn n).vacuum u‖ := by
  refine ⟨fun n t ht => (Sn n).evolution_vacuum (ha n) ht, fun n t ht u => ?_⟩
  have h := (Sn n).norm_evolution_le_of_orthogonal (ha n) ht (hρ0 n).le (hρ1 n) (hdecay n)
    (excitedPart_orthogonal (Sn n).vacuum_norm u)
  rw [rpow_div_eq_exp_transferGapRate (hρ0 n)] at h
  refine h.trans (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr ?_) (norm_nonneg _))
  nlinarith [hm n]

/-- Lattice-to-continuum gap transfer through the functional-calculus evolutions. The lattice
inputs are the one-step bounds `ρ n` and the uniform physical bound `m ≤ -(log ρ n)/(a n)`.
The remaining inputs identify the limit: convergent vacua `hΩ`, strong convergence `hstrong`
of `T_n^{t/a_n}` on a dense set, and a generator of the limit evolution (`hzero`,
`hgenerator`). None of these is derived here. -/
theorem physical_generator_gap_of_uniform_transfer_bounds (D : Set H) (hD : Dense D)
    {Sn : ℕ → PositiveTransferOperator H} {a ρ : ℕ → ℝ} (T : ℝ → H →L[ℂ] H) (Ω : H) {m : ℝ}
    (hm0 : 0 < m) (domain : Submodule ℂ H) (generator : domain →ₗ[ℂ] H)
    (ha : ∀ n, 0 < a n) (hρ0 : ∀ n, 0 < ρ n) (hρ1 : ∀ n, ρ n < 1)
    (hdecay : ∀ n u, ⟪(Sn n).vacuum, u⟫_ℂ = 0 → ‖(Sn n).op u‖ ≤ ρ n * ‖u‖)
    (hm : ∀ n, m ≤ transferGapRate (a n) (ρ n))
    (hΩ : Tendsto (fun n => (Sn n).vacuum) atTop (𝓝 Ω))
    (hstrong : ∀ t, 0 ≤ t → ∀ u ∈ D,
      Tendsto (fun n => (Sn n).evolution (a n) t u) atTop (𝓝 (T t u)))
    (hzero : ∀ u : domain, T 0 u = u)
    (hgenerator : ∀ u : domain,
      HasDerivWithinAt (fun t : ℝ => T t u) (-(generator u)) (Set.Ioi 0) 0) :
    (∀ t, 0 ≤ t → T t Ω = Ω) ∧
    (∀ u : domain, ⟪Ω, (u : H)⟫_ℂ = 0 →
      m * ‖(u : H)‖ ^ 2 ≤ (⟪(u : H), generator u⟫_ℂ).re ∧
      ∀ energy : ℝ, (m - energy) * ‖(u : H)‖ ≤ ‖generator u - (energy : ℂ) • (u : H)‖) ∧
    (∀ (u_seq : ℕ → domain) (energy : ℝ),
      (∀ n, ⟪Ω, (u_seq n : H)⟫_ℂ = 0) →
      (∀ n, ‖(u_seq n : H)‖ = 1) →
      Tendsto (fun n => generator (u_seq n) - (energy : ℂ) • (u_seq n : H)) atTop (𝓝 0) →
      m ≤ energy ∧ 0 < energy) := by
  obtain ⟨hfix, hdec⟩ := cutoff_evolution_inputs ha hρ0 hρ1 hdecay hm
  exact physical_generator_gap_and_excited_resolvent_exclusion_from_cutoff_decay D hD
    (fun n t => (Sn n).evolution (a n) t) T (fun n => (Sn n).vacuum) Ω hm0 domain generator hΩ
    (fun n => (Sn n).vacuum_norm) hfix hstrong (fun n t ht u _ => hdec n t ht u) hzero hgenerator

omit [CompleteSpace H] in
/-- An operator that fixes the unit vector `Ω`, preserves its orthogonal complement and does not
increase norms there is a contraction. -/
theorem norm_le_one_of_vacuum_decomposition {A : H →L[ℂ] H} {Ω : H} (hΩ : ‖Ω‖ = 1)
    (hfix : A Ω = Ω) (hinv : ∀ u, ⟪Ω, u⟫_ℂ = 0 → ⟪Ω, A u⟫_ℂ = 0)
    (hcontr : ∀ u, ⟪Ω, u⟫_ℂ = 0 → ‖A u‖ ≤ ‖u‖) : ‖A‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun u => ?_
  have he : ⟪Ω, excitedPart Ω u⟫_ℂ = 0 := excitedPart_orthogonal hΩ u
  have hAu : A u = vacuumPart Ω u + A (excitedPart Ω u) := by
    rw [map_excitedPart A hfix]
    abel
  have horth1 : ⟪vacuumPart Ω u, A (excitedPart Ω u)⟫_ℂ = 0 := by
    simp [vacuumPart, hinv _ he]
  have horth2 : ⟪vacuumPart Ω u, excitedPart Ω u⟫_ℂ = 0 := by
    simp [vacuumPart, he]
  have h1 := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth1
  have h2 := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth2
  have hsum : vacuumPart Ω u + excitedPart Ω u = u := by simp [excitedPart]
  rw [hsum] at h2
  rw [← hAu] at h1
  have hc := hcontr _ he
  have hsq : ‖A (excitedPart Ω u)‖ * ‖A (excitedPart Ω u)‖ ≤
      ‖excitedPart Ω u‖ * ‖excitedPart Ω u‖ :=
    mul_self_le_mul_self (norm_nonneg _) hc
  rw [one_mul, mul_self_le_mul_self_iff (norm_nonneg _) (norm_nonneg _)]
  linarith

end Transfer

/-! ### The repository's `TransferMatrixSystem` -/

section TransferMatrixSystemLink

variable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

omit [CompleteSpace H] in
theorem transferMatrixSystem_isPositive (sys : TransferMatrixSystem H) : sys.T.IsPositive := by
  refine ContinuousLinearMap.isPositive_def.mpr ⟨fun x y => (sys.T_symmetric x y).symm, fun x => ?_⟩
  rw [ContinuousLinearMap.reApplyInnerSelf_apply, ← sys.T_symmetric x x]
  exact sys.T_nonneg x

/-- A `TransferMatrixSystem` divided by its vacuum eigenvalue `λ₀`. Every property used here is
a field of `TransferMatrixSystem`; that structure is an abstract interface, and nothing in this
section constructs a Wilson transfer matrix. -/
def transferMatrixSystemToPositive (sys : TransferMatrixSystem H) : PositiveTransferOperator H where
  op := ((sys.lambda0⁻¹ : ℝ) : ℂ) • sys.T
  vacuum := sys.vacuum
  nonneg := ContinuousLinearMap.nonneg_iff_isPositive.mpr
    ((transferMatrixSystem_isPositive sys).smul_of_nonneg
      (by exact_mod_cast (inv_nonneg.mpr sys.lambda0_pos.le)))
  norm_le_one := by
    refine norm_le_one_of_vacuum_decomposition sys.vacuum_norm ?_ ?_ ?_
    · rw [smul_apply, sys.vacuum_eigenpair, smul_smul, ← Complex.ofReal_mul,
        inv_mul_cancel₀ sys.lambda0_pos.ne', Complex.ofReal_one, one_smul]
    · intro u hu
      rw [smul_apply, inner_smul_right, sys.T_symmetric, sys.vacuum_eigenpair, inner_smul_left,
        hu, mul_zero, mul_zero]
    · intro u hu
      rw [smul_apply, norm_smul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr sys.lambda0_pos)]
      have h := sys.vacuum_complement_contraction u hu
      have hle : sys.lambda1 * ‖u‖ ≤ sys.lambda0 * ‖u‖ :=
        mul_le_mul_of_nonneg_right sys.spectral_ordering.le (norm_nonneg u)
      rw [inv_mul_le_iff₀ sys.lambda0_pos]
      linarith
  vacuum_norm := sys.vacuum_norm
  vacuum_fixed := by
    rw [smul_apply, sys.vacuum_eigenpair, smul_smul, ← Complex.ofReal_mul,
      inv_mul_cancel₀ sys.lambda0_pos.ne', Complex.ofReal_one, one_smul]

theorem transferMatrixSystemToPositive_decay (sys : TransferMatrixSystem H) (u : H)
    (hu : ⟪(transferMatrixSystemToPositive sys).vacuum, u⟫_ℂ = 0) :
    ‖(transferMatrixSystemToPositive sys).op u‖ ≤ sys.lambda1 / sys.lambda0 * ‖u‖ := by
  change ‖(((sys.lambda0⁻¹ : ℝ) : ℂ) • sys.T) u‖ ≤ sys.lambda1 / sys.lambda0 * ‖u‖
  rw [smul_apply, norm_smul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (inv_pos.mpr sys.lambda0_pos), div_eq_inv_mul, mul_assoc]
  exact mul_le_mul_of_nonneg_left (sys.vacuum_complement_contraction u hu)
    (inv_nonneg.mpr sys.lambda0_pos.le)

omit [CompleteSpace H] in
/-- The lattice mass gap of a `TransferMatrixSystem` is the decay rate of its normalized one-step
bound: `E₁ - E₀ = -(log (λ₁/λ₀))/a`. -/
theorem transferMatrixSystem_massGap_eq (sys : TransferMatrixSystem H) :
    sys.massGap = transferGapRate sys.a (sys.lambda1 / sys.lambda0) := by
  rw [TransferMatrixSystem.massGap, TransferMatrixSystem.excitedEnergy,
    TransferMatrixSystem.groundEnergy, transferGapRate,
    Real.log_div sys.lambda1_pos.ne' sys.lambda0_pos.ne']
  field_simp
  ring

/-- For a `TransferMatrixSystem`, `massGap` bounds the generator of the functional-calculus
evolution of `T/λ₀` from below on the vacuum complement. The contraction bound on the
complement is the system's own field `vacuum_complement_contraction`; it is not derived. -/
theorem transferMatrixSystem_generator_gap (sys : TransferMatrixSystem H)
    (u : (transferMatrixSystemToPositive sys).generatorDomain sys.a)
    (hu : ⟪sys.vacuum, (u : H)⟫_ℂ = 0) :
    sys.massGap * ‖(u : H)‖ ^ 2 ≤
      (⟪(u : H), (transferMatrixSystemToPositive sys).generator sys.a u⟫_ℂ).re := by
  rw [transferMatrixSystem_massGap_eq]
  exact (transferMatrixSystemToPositive sys).generator_gap sys.a_pos
    (div_pos sys.lambda1_pos sys.lambda0_pos)
    ((div_lt_one sys.lambda0_pos).mpr sys.spectral_ordering)
    (transferMatrixSystemToPositive_decay sys) u hu

end TransferMatrixSystemLink

section Reconstruction

/-- Physical time translation by the rational time `s`. -/
def timeShift (s : ℚ) : Fin 4 → ℚ := fun i => if i = 0 then s else 0

theorem timeVector_eq_timeShift (t : ℕ) : timeVector t = timeShift t := rfl

theorem timeShift_add (s s' : ℚ) : timeShift s + timeShift s' = timeShift (s + s') := by
  funext i
  by_cases hi : i = 0 <;> simp [timeShift, hi]

theorem timeReflect_timeReflect (ℓ : PhysicalRectangle) : ℓ.timeReflect.timeReflect = ℓ := by
  cases ℓ
  simp only [PhysicalRectangle.timeReflect, PhysicalRectangle.mk.injEq, and_true]
  funext i
  by_cases hi : i = 0
  · subst hi
    simp
  · simp [Function.update_of_ne hi]

theorem translate_timeReflect (s : ℚ) (ℓ : PhysicalRectangle) :
    ℓ.timeReflect.translate (timeShift s) = (ℓ.translate (timeShift (-s))).timeReflect := by
  rcases ℓ with ⟨b, μ, ν, hp, sμ, sν, hsμ, hsν⟩
  simp only [PhysicalRectangle.timeReflect, PhysicalRectangle.translate, PhysicalRectangle.mk.injEq,
    and_true]
  funext i
  by_cases hi : i = 0
  · subst hi
    by_cases hμ : μ = 0 <;> simp [timeShift, hμ] <;> ring
  · simp [timeShift, hi]

theorem translate_translate (c c' : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    (ℓ.translate c).translate c' = ℓ.translate (c + c') := by
  cases ℓ
  simp only [PhysicalRectangle.translate, PhysicalRectangle.mk.injEq, and_true]
  exact add_assoc _ _ _

theorem continuous_reflectObservables : Continuous reflectObservables :=
  continuous_pi fun _ => continuous_apply _

theorem reflectObservables_involutive (w : WilsonLoopSpace) :
    reflectObservables (reflectObservables w) = w := by
  funext ℓ
  simp [reflectObservables, timeReflect_timeReflect]

theorem reflectObservables_translateObservables (s : ℚ) (w : WilsonLoopSpace) :
    reflectObservables (translateObservables (timeShift s) w) =
      translateObservables (timeShift (-s)) (reflectObservables w) := by
  funext ℓ
  simp only [reflectObservables, translateObservables]
  rw [translate_timeReflect]

theorem translateObservables_translateObservables (c c' : Fin 4 → ℚ) (w : WilsonLoopSpace) :
    translateObservables c (translateObservables c' w) = translateObservables (c + c') w := by
  funext ℓ
  simp only [translateObservables]
  rw [translate_translate]

theorem translateObservables_zero (w : WilsonLoopSpace) : translateObservables 0 w = w := by
  funext ℓ
  cases ℓ
  simp [translateObservables, PhysicalRectangle.translate]

/-- `F` depends only on loops lying in the open positive-time half-space; for real-valued `F`
this is `DependsOnPositiveTime`. -/
def PositiveTimeLocal {β : Type*} (F : WilsonLoopSpace → β) : Prop :=
  ∀ w w' : WilsonLoopSpace, (∀ ℓ : PhysicalRectangle, ℓ.IsPositiveTime → w ℓ = w' ℓ) → F w = F w'

theorem positiveTimeLocal_iff (F : WilsonLoopSpace → ℝ) :
    PositiveTimeLocal F ↔ DependsOnPositiveTime F := Iff.rfl

theorem PositiveTimeLocal.comp_translate {β : Type*} {F : WilsonLoopSpace → β}
    (hF : PositiveTimeLocal F) {s : ℚ} (hs : 0 ≤ s) :
    PositiveTimeLocal (fun w => F (translateObservables (timeShift s) w)) := by
  intro w w' h
  apply hF
  intro ℓ hℓ
  apply h
  change 0 < (ℓ.base + timeShift s) 0
  have hℓ' : 0 < ℓ.base 0 := hℓ
  have hval : (ℓ.base + timeShift s) 0 = ℓ.base 0 + s := by simp [timeShift]
  rw [hval]
  linarith

/-- Bounded continuous complex functionals of the loop variables that depend only on loops in
the open positive-time half-space. -/
def positiveTimeFunctionals : Submodule ℂ (WilsonLoopSpace →ᵇ ℂ) where
  carrier := {F | PositiveTimeLocal F}
  add_mem' := by
    intro F G hF hG w w' h
    simp only [BoundedContinuousFunction.coe_add, Pi.add_apply]
    rw [hF w w' h, hG w w' h]
  zero_mem' := fun _ _ _ => rfl
  smul_mem' := by
    intro c F hF w w' h
    simp only [BoundedContinuousFunction.coe_smul]
    rw [hF w w' h]

/-- The reflection as a continuous map. -/
def reflectCM : C(WilsonLoopSpace, WilsonLoopSpace) :=
  ⟨reflectObservables, continuous_reflectObservables⟩

/-- The time translation by `s` as a continuous map. -/
def translateCM (s : ℚ) : C(WilsonLoopSpace, WilsonLoopSpace) :=
  ⟨translateObservables (timeShift s), continuous_translateObservables _⟩

/-- The integrand `w ↦ conj (F (θ w)) * G w` of the reflection form. -/
def osIntegrand (F G : WilsonLoopSpace →ᵇ ℂ) : WilsonLoopSpace →ᵇ ℂ :=
  star (F.compContinuous reflectCM) * G

theorem osIntegrand_apply (F G : WilsonLoopSpace →ᵇ ℂ) (w : WilsonLoopSpace) :
    osIntegrand F G w = conj (F (reflectObservables w)) * G w := rfl

/-- The reflection form `⟪F, G⟫_ν = ∫ conj (F (θ w)) G w dν(w)`. -/
def osForm (ν : Measure WilsonLoopSpace) (F G : WilsonLoopSpace →ᵇ ℂ) : ℂ :=
  ∫ w, osIntegrand F G w ∂ν

variable {ν : Measure WilsonLoopSpace}

theorem osForm_add_left [IsFiniteMeasure ν] (F F' G : WilsonLoopSpace →ᵇ ℂ) :
    osForm ν (F + F') G = osForm ν F G + osForm ν F' G := by
  have h : ∀ w, osIntegrand (F + F') G w = osIntegrand F G w + osIntegrand F' G w := by
    intro w
    simp only [osIntegrand_apply, BoundedContinuousFunction.coe_add, Pi.add_apply, map_add, add_mul]
  simp only [osForm, h]
  exact integral_add ((osIntegrand F G).integrable ν) ((osIntegrand F' G).integrable ν)

theorem osForm_smul_left (c : ℂ) (F G : WilsonLoopSpace →ᵇ ℂ) :
    osForm ν (c • F) G = conj c * osForm ν F G := by
  have h : ∀ w, osIntegrand (c • F) G w = conj c * osIntegrand F G w := by
    intro w
    simp only [osIntegrand_apply, BoundedContinuousFunction.coe_smul, smul_eq_mul, map_mul]
    ring
  simp only [osForm, h]
  exact integral_const_mul _ _

/-- Reflection invariance of the law makes the reflection form Hermitian. -/
theorem osForm_conj_symm (hθ : ν.map reflectObservables = ν) (F G : WilsonLoopSpace →ᵇ ℂ) :
    conj (osForm ν G F) = osForm ν F G := by
  rw [osForm, ← integral_conj]
  have hφ : ∀ w, conj (osIntegrand G F w) = osIntegrand F G (reflectObservables w) := by
    intro w
    simp only [osIntegrand_apply, map_mul, RCLike.conj_conj, reflectObservables_involutive]
    ring
  simp only [hφ]
  have hmeas : AEMeasurable reflectObservables ν :=
    continuous_reflectObservables.measurable.aemeasurable
  rw [← integral_map hmeas (osIntegrand F G).continuous.aestronglyMeasurable, hθ]
  rfl

/-- The real-valued reflection positivity of `ContinuumIdentificationObligations` implies
positivity of the complex reflection form on positive-time functionals. -/
theorem osForm_re_nonneg [IsFiniteMeasure ν]
    (hRP : ∀ F : WilsonLoopSpace →ᵇ ℝ, DependsOnPositiveTime F →
      0 ≤ ∫ w, F (reflectObservables w) * F w ∂ν)
    {F : WilsonLoopSpace →ᵇ ℂ} (hF : F ∈ positiveTimeFunctionals) :
    0 ≤ (osForm ν F F).re := by
  set F₁ : WilsonLoopSpace →ᵇ ℝ := Complex.reCLM.compLeftContinuousBounded WilsonLoopSpace F
  set F₂ : WilsonLoopSpace →ᵇ ℝ := Complex.imCLM.compLeftContinuousBounded WilsonLoopSpace F
  have hF₁ : ∀ w, F₁ w = (F w).re := fun _ => rfl
  have hF₂ : ∀ w, F₂ w = (F w).im := fun _ => rfl
  have hloc₁ : DependsOnPositiveTime F₁ := by
    intro w w' h
    rw [hF₁, hF₁, hF w w' h]
  have hloc₂ : DependsOnPositiveTime F₂ := by
    intro w w' h
    rw [hF₂, hF₂, hF w w' h]
  have hint₁ : Integrable (fun w => F₁ (reflectObservables w) * F₁ w) ν :=
    ((F₁.compContinuous reflectCM) * F₁).integrable ν
  have hint₂ : Integrable (fun w => F₂ (reflectObservables w) * F₂ w) ν :=
    ((F₂.compContinuous reflectCM) * F₂).integrable ν
  have hre : (osForm ν F F).re =
      ∫ w, F₁ (reflectObservables w) * F₁ w ∂ν + ∫ w, F₂ (reflectObservables w) * F₂ w ∂ν := by
    rw [osForm, ← RCLike.re_to_complex, ← integral_re ((osIntegrand F F).integrable ν),
      ← integral_add hint₁ hint₂]
    congr 1
    funext w
    simp only [osIntegrand_apply, RCLike.re_to_complex, Complex.mul_re, Complex.conj_re,
      Complex.conj_im, hF₁, hF₂]
    ring
  rw [hre]
  exact add_nonneg (hRP F₁ hloc₁) (hRP F₂ hloc₂)

/-- Time-translation invariance of the law makes the time translation symmetric for the
reflection form: `⟪F, G ∘ τ_s⟫ = ⟪F ∘ τ_s, G⟫`. -/
theorem osForm_translate_symm {s : ℚ}
    (hτ : ν.map (translateObservables (timeShift s)) = ν) (F G : WilsonLoopSpace →ᵇ ℂ) :
    osForm ν F (G.compContinuous (translateCM s)) =
      osForm ν (F.compContinuous (translateCM s)) G := by
  have hpt : ∀ w, osIntegrand F (G.compContinuous (translateCM s)) w =
      osIntegrand (F.compContinuous (translateCM s)) G (translateObservables (timeShift s) w) := by
    intro w
    simp only [osIntegrand_apply, BoundedContinuousFunction.compContinuous_apply, translateCM,
      ContinuousMap.coe_mk, reflectObservables_translateObservables,
      translateObservables_translateObservables, timeShift_add]
    rw [add_neg_cancel, show timeShift 0 = 0 from by funext i; simp [timeShift],
      translateObservables_zero]
  have hmeas : AEMeasurable (translateObservables (timeShift s)) ν :=
    (continuous_translateObservables _).measurable.aemeasurable
  rw [osForm, osForm]
  simp only [hpt]
  rw [← integral_map hmeas (osIntegrand _ G).continuous.aestronglyMeasurable, hτ]

/-- A probability law on the common loop space with the two Osterwalder–Schrader inputs of the
reconstruction. Both fields are hypotheses: `reflection_positive` is verbatim the field of
`ContinuumIdentificationObligations`, and `reflection_invariant` is invariance under `x₀ ↦ -x₀`.
Neither is proved in this repository for any Wilson-loop law. -/
structure ReflectionPositiveLaw where
  /-- The law of the loop variables. -/
  law : ProbabilityMeasure WilsonLoopSpace
  /-- Reflection positivity on real positive-time bounded continuous functionals. -/
  reflection_positive : ∀ F : WilsonLoopSpace →ᵇ ℝ, DependsOnPositiveTime F →
    0 ≤ ∫ w, F (reflectObservables w) * F w ∂(law : Measure WilsonLoopSpace)
  /-- Invariance of the law under the time reflection. -/
  reflection_invariant : (law : Measure WilsonLoopSpace).map reflectObservables = law

/-- Positive-time functionals, carrying the reflection pre-inner product of `L`. -/
def OSVector (_L : ReflectionPositiveLaw) : Type := positiveTimeFunctionals

namespace OSVector

variable {L : ReflectionPositiveLaw}

instance : AddCommGroup (OSVector L) := inferInstanceAs (AddCommGroup positiveTimeFunctionals)

instance : Module ℂ (OSVector L) := inferInstanceAs (Module ℂ positiveTimeFunctionals)

/-- The underlying bounded continuous functional. -/
def toBCF (F : OSVector L) : WilsonLoopSpace →ᵇ ℂ :=
  (show positiveTimeFunctionals from F).1

theorem toBCF_mem (F : OSVector L) : F.toBCF ∈ positiveTimeFunctionals :=
  (show positiveTimeFunctionals from F).2

/-- A positive-time functional as a vector. -/
def mk (F : WilsonLoopSpace →ᵇ ℂ) (hF : F ∈ positiveTimeFunctionals) : OSVector L :=
  (⟨F, hF⟩ : positiveTimeFunctionals)

@[simp]
theorem toBCF_mk (F : WilsonLoopSpace →ᵇ ℂ) (hF : F ∈ positiveTimeFunctionals) :
    (mk (L := L) F hF).toBCF = F := rfl

@[simp]
theorem toBCF_add (F G : OSVector L) : (F + G).toBCF = F.toBCF + G.toBCF := rfl

@[simp]
theorem toBCF_smul (c : ℂ) (F : OSVector L) : (c • F).toBCF = c • F.toBCF := rfl

@[simp]
theorem toBCF_zero : (0 : OSVector L).toBCF = 0 := rfl

theorem ext {F G : OSVector L} (h : F.toBCF = G.toBCF) : F = G :=
  Subtype.ext (p := (· ∈ positiveTimeFunctionals)) h

/-- The reflection pre-inner product `⟪F, G⟫ = ∫ conj (F (θ w)) G w dν`. -/
instance osCore : PreInnerProductSpace.Core ℂ (OSVector L) where
  inner F G := osForm (L.law : Measure WilsonLoopSpace) F.toBCF G.toBCF
  conj_inner_symm F G := osForm_conj_symm L.reflection_invariant F.toBCF G.toBCF
  re_inner_nonneg F := osForm_re_nonneg L.reflection_positive F.toBCF_mem
  add_left F G H := osForm_add_left F.toBCF G.toBCF H.toBCF
  smul_left F G r := osForm_smul_left r F.toBCF G.toBCF

instance : SeminormedAddCommGroup (OSVector L) :=
  InnerProductSpace.Core.toSeminormedAddCommGroup (𝕜 := ℂ)

instance : InnerProductSpace ℂ (OSVector L) := InnerProductSpace.ofCore osCore

theorem inner_def (F G : OSVector L) :
    ⟪F, G⟫_ℂ = osForm (L.law : Measure WilsonLoopSpace) F.toBCF G.toBCF := rfl

/-- Null vectors: two positive-time functionals define the same vector of the separated
quotient exactly when their difference has reflection norm zero. -/
theorem mk_eq_mk_iff (F G : OSVector L) :
    SeparationQuotient.mk F = SeparationQuotient.mk G ↔
      osForm (L.law : Measure WilsonLoopSpace) (F - G).toBCF (F - G).toBCF = 0 := by
  rw [SeparationQuotient.mk_eq_mk, Metric.inseparable_iff, dist_eq_norm, ← inner_def,
    inner_self_eq_norm_sq_to_K]
  constructor
  · intro h
    simp [h]
  · intro h
    have h' : ((‖F - G‖ : ℝ) : ℂ) = 0 := (pow_eq_zero_iff two_ne_zero).mp h
    exact_mod_cast h'

/-- The reflection norm is bounded by the supremum norm, since the law is a probability. -/
theorem norm_le_toBCF_norm (F : OSVector L) : ‖F‖ ≤ ‖F.toBCF‖ := by
  have hsq : ‖F‖ ^ 2 ≤ ‖F.toBCF‖ ^ 2 := by
    rw [@norm_sq_eq_re_inner ℂ, inner_def]
    calc RCLike.re (osForm (L.law : Measure WilsonLoopSpace) F.toBCF F.toBCF)
        ≤ ‖osForm (L.law : Measure WilsonLoopSpace) F.toBCF F.toBCF‖ := RCLike.re_le_norm _
      _ ≤ (‖F.toBCF‖ * ‖F.toBCF‖) * (L.law : Measure WilsonLoopSpace).real Set.univ := by
          apply norm_integral_le_of_norm_le_const
          refine Eventually.of_forall fun w => ?_
          rw [osIntegrand_apply, norm_mul, RCLike.norm_conj]
          exact mul_le_mul (F.toBCF.norm_coe_le_norm _) (F.toBCF.norm_coe_le_norm _)
            (norm_nonneg _) (norm_nonneg _)
      _ = ‖F.toBCF‖ ^ 2 := by simp [sq]
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp hsq

/-- Time translation `(U_s F)(w) = F (τ_s w)` by a nonnegative physical time `s`; it maps
positive-time functionals to positive-time functionals. -/
def translate (L : ReflectionPositiveLaw) {s : ℚ} (hs : 0 ≤ s) : OSVector L →ₗ[ℂ] OSVector L where
  toFun F := mk (F.toBCF.compContinuous (translateCM s))
    (PositiveTimeLocal.comp_translate F.toBCF_mem hs)
  map_add' _ _ := ext rfl
  map_smul' _ _ := ext rfl

@[simp]
theorem toBCF_translate {s : ℚ} (hs : 0 ≤ s) (F : OSVector L) :
    (translate L hs F).toBCF = F.toBCF.compContinuous (translateCM s) := rfl

theorem translate_translate {s t : ℚ} (hs : 0 ≤ s) (ht : 0 ≤ t) (F : OSVector L) :
    translate L hs (translate L ht F) = translate L (add_nonneg ht hs) F := by
  apply ext
  ext w
  simp only [toBCF_translate, BoundedContinuousFunction.compContinuous_apply, translateCM,
    ContinuousMap.coe_mk, translateObservables_translateObservables, timeShift_add]

theorem translate_eq_of_eq {s t : ℚ} (hs : 0 ≤ s) (ht : 0 ≤ t) (hst : s = t) (F : OSVector L) :
    translate L hs F = translate L ht F := by
  subst hst
  rfl

theorem toBCF_norm_translate_le {s : ℚ} (hs : 0 ≤ s) (F : OSVector L) :
    ‖(translate L hs F).toBCF‖ ≤ ‖F.toBCF‖ :=
  BoundedContinuousFunction.norm_compContinuous_le _ _

/-- With a time-translation invariant law, the time translation is symmetric. -/
theorem inner_translate_symm {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law)
    (F G : OSVector L) : ⟪F, translate L hs G⟫_ℂ = ⟪translate L hs F, G⟫_ℂ :=
  osForm_translate_symm hτ F.toBCF G.toBCF

/-- Contraction of the time translation for the reflection norm, from reflection positivity,
reflection invariance and time-translation invariance: the iterated Cauchy–Schwarz argument
`‖U F‖^(2ⁿ) ‖F‖ ≤ ‖F‖^(2ⁿ) ‖U^(2ⁿ) F‖ ≤ ‖F‖^(2ⁿ) ‖F‖_∞`. -/
theorem norm_translate_le {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law)
    (F : OSVector L) : ‖translate L hs F‖ ≤ ‖F‖ := by
  set U := translate L hs with hU
  have hsymm : ∀ k : ℕ, ∀ G G' : OSVector L, ⟪G, (U ^ k) G'⟫_ℂ = ⟪(U ^ k) G, G'⟫_ℂ := by
    intro k
    induction k with
    | zero => intro G G'; simp
    | succ k ih =>
      intro G G'
      calc ⟪G, (U ^ (k + 1)) G'⟫_ℂ = ⟪G, U ((U ^ k) G')⟫_ℂ := by
            rw [pow_succ', Module.End.mul_apply]
        _ = ⟪U G, (U ^ k) G'⟫_ℂ := inner_translate_symm hs hτ _ _
        _ = ⟪(U ^ k) (U G), G'⟫_ℂ := ih _ _
        _ = ⟪(U ^ (k + 1)) G, G'⟫_ℂ := by rw [pow_succ, Module.End.mul_apply]
  have hsup : ∀ k : ℕ, ∀ G : OSVector L, ‖((U ^ k) G).toBCF‖ ≤ ‖G.toBCF‖ := by
    intro k
    induction k with
    | zero => intro G; simp
    | succ k ih =>
      intro G
      rw [pow_succ', Module.End.mul_apply]
      exact (toBCF_norm_translate_le hs _).trans (ih G)
  have hstep : ∀ n : ℕ, ‖(U ^ (2 ^ n)) F‖ ^ 2 ≤ ‖F‖ * ‖(U ^ (2 ^ (n + 1))) F‖ := by
    intro n
    have h2 : U ^ (2 ^ (n + 1)) = U ^ (2 ^ n) * U ^ (2 ^ n) := by
      rw [← pow_add, pow_succ, mul_two]
    rw [@norm_sq_eq_re_inner ℂ, ← hsymm, ← Module.End.mul_apply, ← h2]
    exact (RCLike.re_le_norm _).trans (norm_inner_le_norm _ _)
  rcases (norm_nonneg F).eq_or_lt with hc0 | hcpos
  · have h0 := hstep 0
    rw [← hc0, zero_mul, pow_zero, pow_one] at h0
    have hU0 : ‖U F‖ = 0 := by nlinarith [norm_nonneg (U F)]
    rw [hU0, ← hc0]
  · have hP : ∀ n : ℕ, ‖U F‖ ^ (2 ^ n) * ‖F‖ ≤ ‖F‖ ^ (2 ^ n) * ‖(U ^ (2 ^ n)) F‖ := by
      intro n
      induction n with
      | zero => simp [mul_comm]
      | succ n ih =>
        have hs' := hstep n
        have hA : 0 ≤ ‖U F‖ ^ (2 ^ n) * ‖F‖ := by positivity
        have h1 : (‖U F‖ ^ (2 ^ n) * ‖F‖) ^ 2 ≤ (‖F‖ ^ (2 ^ n) * ‖(U ^ (2 ^ n)) F‖) ^ 2 :=
          pow_le_pow_left₀ hA ih 2
        have hC : 0 ≤ (‖F‖ ^ (2 ^ n)) ^ 2 := by positivity
        have key : (‖U F‖ ^ (2 ^ (n + 1)) * ‖F‖) * ‖F‖ ≤
            (‖F‖ ^ (2 ^ (n + 1)) * ‖(U ^ (2 ^ (n + 1))) F‖) * ‖F‖ := by
          have e1 : ‖U F‖ ^ (2 ^ (n + 1)) = (‖U F‖ ^ (2 ^ n)) ^ 2 := by
            rw [← pow_mul, pow_succ]
          have e2 : ‖F‖ ^ (2 ^ (n + 1)) = (‖F‖ ^ (2 ^ n)) ^ 2 := by
            rw [← pow_mul, pow_succ]
          rw [e1, e2]
          calc (‖U F‖ ^ (2 ^ n)) ^ 2 * ‖F‖ * ‖F‖ = (‖U F‖ ^ (2 ^ n) * ‖F‖) ^ 2 := by ring
            _ ≤ (‖F‖ ^ (2 ^ n) * ‖(U ^ (2 ^ n)) F‖) ^ 2 := h1
            _ = (‖F‖ ^ (2 ^ n)) ^ 2 * ‖(U ^ (2 ^ n)) F‖ ^ 2 := by ring
            _ ≤ (‖F‖ ^ (2 ^ n)) ^ 2 * (‖F‖ * ‖(U ^ (2 ^ (n + 1))) F‖) :=
                mul_le_mul_of_nonneg_left hs' hC
            _ = (‖F‖ ^ (2 ^ n)) ^ 2 * ‖(U ^ (2 ^ (n + 1))) F‖ * ‖F‖ := by ring
        exact le_of_mul_le_mul_right key hcpos
    by_contra hcon'
    have hcon := not_le.mp hcon'
    set r := ‖U F‖ / ‖F‖ with hr_def
    have hr : 1 < r := (one_lt_div hcpos).mpr hcon
    have hbound : ∀ n : ℕ, r ^ (2 ^ n) ≤ ‖F.toBCF‖ / ‖F‖ := by
      intro n
      have hx : ‖(U ^ (2 ^ n)) F‖ ≤ ‖F.toBCF‖ :=
        (norm_le_toBCF_norm _).trans (hsup _ F)
      rw [hr_def, div_pow, div_le_div_iff₀ (pow_pos hcpos _) hcpos]
      calc ‖U F‖ ^ (2 ^ n) * ‖F‖ ≤ ‖F‖ ^ (2 ^ n) * ‖(U ^ (2 ^ n)) F‖ := hP n
        _ ≤ ‖F‖ ^ (2 ^ n) * ‖F.toBCF‖ :=
            mul_le_mul_of_nonneg_left hx (pow_nonneg (norm_nonneg _) _)
        _ = ‖F.toBCF‖ * ‖F‖ ^ (2 ^ n) := by ring
    obtain ⟨n, hn⟩ := ((tendsto_pow_atTop_atTop_of_one_lt hr).eventually_gt_atTop
      (‖F.toBCF‖ / ‖F‖)).exists
    have hmono : r ^ n ≤ r ^ (2 ^ n) := pow_le_pow_right₀ hr.le Nat.lt_two_pow_self.le
    linarith [hbound n]

/-- The vacuum: the constant functional `1`. -/
def vacuum (L : ReflectionPositiveLaw) : OSVector L :=
  mk (BoundedContinuousFunction.const WilsonLoopSpace (1 : ℂ)) (fun _ _ _ => rfl)

theorem toBCF_vacuum : (vacuum L).toBCF = BoundedContinuousFunction.const WilsonLoopSpace 1 := rfl

theorem inner_vacuum_self : ⟪vacuum L, vacuum L⟫_ℂ = 1 := by
  rw [inner_def, toBCF_vacuum]
  simp [osForm, osIntegrand_apply]

theorem norm_vacuum : ‖vacuum L‖ = 1 := by
  have h := @norm_sq_eq_re_inner ℂ _ _ _ _ (vacuum L)
  rw [inner_vacuum_self, RCLike.one_re] at h
  nlinarith [norm_nonneg (vacuum L)]

theorem translate_vacuum {s : ℚ} (hs : 0 ≤ s) : translate L hs (vacuum L) = vacuum L :=
  ext rfl

/-- Positivity of the time translation by `s`, from invariance under the half step `s/2`:
`⟪F, U_s F⟫ = ‖U_{s/2} F‖²`. -/
theorem re_inner_translate_nonneg {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) =
      L.law)
    (F : OSVector L) : 0 ≤ (⟪F, translate L hs F⟫_ℂ).re := by
  have hs2 : (0 : ℚ) ≤ s / 2 := by linarith
  have hsplit : translate L hs F = translate L hs2 (translate L hs2 F) := by
    rw [translate_translate]
    exact translate_eq_of_eq hs _ (by ring) F
  rw [hsplit, inner_translate_symm hs2 hτ]
  exact inner_self_nonneg (𝕜 := ℂ)

/-- Invariance under the half step gives invariance under the full step. -/
theorem map_translate_of_half {s : ℚ}
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) =
      L.law) :
    (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law := by
  have hm : Measurable (translateObservables (timeShift (s / 2))) :=
    (continuous_translateObservables _).measurable
  have hcomp : translateObservables (timeShift (s / 2)) ∘ translateObservables (timeShift (s / 2)) =
      translateObservables (timeShift s) := by
    funext w
    simp only [Function.comp_apply, translateObservables_translateObservables, timeShift_add]
    congr 2
    ring
  rw [← hcomp, ← Measure.map_map hm hm, hτ, hτ]

/-- The time translation as a continuous linear contraction of the pre-Hilbert space. -/
def translateCLM (L : ReflectionPositiveLaw) {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law) :
    OSVector L →L[ℂ] OSVector L :=
  (translate L hs).mkContinuous 1 fun F => by rw [one_mul]; exact norm_translate_le hs hτ F

/-- Null vectors are mapped to null vectors: the time translation is well defined on the
quotient by null vectors. -/
theorem translate_mk_eq_mk {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law)
    {F G : OSVector L} (h : SeparationQuotient.mk F = SeparationQuotient.mk G) :
    SeparationQuotient.mk (translate L hs F) = SeparationQuotient.mk (translate L hs G) := by
  rw [SeparationQuotient.mk_eq_mk, Metric.inseparable_iff, dist_eq_norm] at h ⊢
  rw [← map_sub]
  exact le_antisymm (h ▸ norm_translate_le hs hτ (F - G)) (norm_nonneg _)

end OSVector

/-- The reconstructed Hilbert space: the completion of the reflection pre-inner-product space.
Completion identifies null vectors, so it is also the completion of the quotient by them. -/
abbrev OSHilbert (L : ReflectionPositiveLaw) : Type := UniformSpace.Completion (OSVector L)

/-- The reconstructed vacuum. -/
def osVacuum (L : ReflectionPositiveLaw) : OSHilbert L := (OSVector.vacuum L : OSVector L)

/-- The reconstructed transfer operator for physical time `s`: the continuous extension of the
time translation to the completion. -/
def reconstructedTransfer (L : ReflectionPositiveLaw) {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law) :
    OSHilbert L →L[ℂ] OSHilbert L :=
  (OSVector.translateCLM L hs hτ).completion

theorem reconstructedTransfer_coe {L : ReflectionPositiveLaw} {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law)
    (F : OSVector L) :
    reconstructedTransfer L hs hτ (F : OSHilbert L) =
      ((OSVector.translate L hs F : OSVector L) : OSHilbert L) := by
  rw [reconstructedTransfer, ContinuousLinearMap.completion_apply_coe]
  rfl

/-- The reconstructed transfer operator is a positive contraction fixing the normalized
vacuum. The inputs are the named hypotheses of `ReflectionPositiveLaw` and invariance of the law
under the half step `s/2`. -/
def reconstructedTransferOperator (L : ReflectionPositiveLaw) {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) =
      L.law) :
    PositiveTransferOperator (OSHilbert L) where
  op := reconstructedTransfer L hs (OSVector.map_translate_of_half hτ)
  vacuum := osVacuum L
  nonneg := by
    have hτ' := OSVector.map_translate_of_half hτ
    rw [ContinuousLinearMap.nonneg_iff_isPositive, ContinuousLinearMap.isPositive_def]
    refine ⟨fun x y => ?_, fun x => ?_⟩
    · change ⟪reconstructedTransfer L hs hτ' x, y⟫_ℂ = ⟪x, reconstructedTransfer L hs hτ' y⟫_ℂ
      refine UniformSpace.Completion.induction_on₂ x y ?_ fun F G => ?_
      · exact isClosed_eq
          ((reconstructedTransfer L hs hτ').continuous.comp continuous_fst |>.inner continuous_snd)
          (continuous_fst.inner ((reconstructedTransfer L hs hτ').continuous.comp continuous_snd))
      · rw [reconstructedTransfer_coe, reconstructedTransfer_coe, UniformSpace.Completion.inner_coe,
          UniformSpace.Completion.inner_coe, OSVector.inner_translate_symm hs hτ' F G]
    · rw [ContinuousLinearMap.reApplyInnerSelf_apply]
      refine UniformSpace.Completion.induction_on x ?_ fun F => ?_
      · exact isClosed_le continuous_const
          (RCLike.continuous_re.comp
            (((reconstructedTransfer L hs hτ').continuous).inner continuous_id))
      · rw [reconstructedTransfer_coe, UniformSpace.Completion.inner_coe, ← inner_conj_symm,
          RCLike.conj_re]
        exact OSVector.re_inner_translate_nonneg hs hτ F
  norm_le_one := by
    have hτ' := OSVector.map_translate_of_half hτ
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => ?_
    rw [one_mul]
    refine UniformSpace.Completion.induction_on x ?_ fun F => ?_
    · exact isClosed_le ((reconstructedTransfer L hs hτ').continuous.norm) continuous_norm
    · rw [reconstructedTransfer_coe, UniformSpace.Completion.norm_coe,
        UniformSpace.Completion.norm_coe]
      exact OSVector.norm_translate_le hs hτ' F
  vacuum_norm := by
    rw [osVacuum, UniformSpace.Completion.norm_coe, OSVector.norm_vacuum]
  vacuum_fixed := by
    rw [osVacuum, reconstructedTransfer_coe, OSVector.translate_vacuum]

/-! ### Decay on the vacuum complement: pre-Hilbert space, completion and law -/

namespace OSVector

variable {L : ReflectionPositiveLaw}

theorem inner_vacuum_eq_integral (F : OSVector L) :
    ⟪vacuum L, F⟫_ℂ = ∫ w, F.toBCF w ∂(L.law : Measure WilsonLoopSpace) := by
  rw [inner_def, toBCF_vacuum, osForm]
  congr 1
  funext w
  simp [osIntegrand_apply]

/-- The mean-subtracted functional `F - ⟪Ω, F⟫ Ω`. -/
def excited (F : OSVector L) : OSVector L := F - ⟪vacuum L, F⟫_ℂ • vacuum L

theorem inner_vacuum_excited (F : OSVector L) : ⟪vacuum L, excited F⟫_ℂ = 0 := by
  rw [excited, inner_sub_right, inner_smul_right, inner_vacuum_self, mul_one, sub_self]

theorem norm_sq_excited (F : OSVector L) :
    ‖excited F‖ ^ 2 = ‖F‖ ^ 2 - ‖⟪vacuum L, F⟫_ℂ‖ ^ 2 := by
  have h := @norm_sub_sq ℂ _ _ _ _ F (⟪vacuum L, F⟫_ℂ • vacuum L)
  rw [excited, h, norm_smul, norm_vacuum, mul_one, inner_smul_right, ← inner_conj_symm F,
    RCLike.mul_conj]
  simp only [RCLike.ofReal_re, ← RCLike.ofReal_pow]
  ring

theorem translate_excited {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law)
    (F : OSVector L) : translate L hs (excited F) = excited (translate L hs F) := by
  rw [excited, excited, map_sub, map_smul, translate_vacuum, inner_translate_symm hs hτ,
    translate_vacuum]

/-- Decay of the time translation by `s` on the vacuum complement of the pre-Hilbert space. -/
def VacuumComplementDecay (L : ReflectionPositiveLaw) {s : ℚ} (hs : 0 ≤ s) (ρ : ℝ) : Prop :=
  ∀ F : OSVector L, ⟪vacuum L, F⟫_ℂ = 0 → ‖translate L hs F‖ ≤ ρ * ‖F‖

end OSVector

/-- Exponential decay of time-translated correlations at physical time `s` with ratio `ρ`, as a
property of the law alone: for every positive-time bounded continuous functional `F`,
`‖F ∘ τ_s‖² - |E F|² ≤ ρ² (‖F‖² - |E F|²)` in the reflection seminorm. Every term is the
integral of a fixed bounded continuous function, so the condition passes to weak limits. -/
def CorrelationDecay (ν : Measure WilsonLoopSpace) (s : ℚ) (ρ : ℝ) : Prop :=
  ∀ F ∈ positiveTimeFunctionals,
    (osForm ν (F.compContinuous (translateCM s)) (F.compContinuous (translateCM s))).re -
        ‖∫ w, F w ∂ν‖ ^ 2 ≤
      ρ ^ 2 * ((osForm ν F F).re - ‖∫ w, F w ∂ν‖ ^ 2)

namespace OSVector

variable {L : ReflectionPositiveLaw}

theorem norm_sq_eq_osForm (F : OSVector L) :
    ‖F‖ ^ 2 = (osForm (L.law : Measure WilsonLoopSpace) F.toBCF F.toBCF).re := by
  rw [@norm_sq_eq_re_inner ℂ, inner_def, RCLike.re_to_complex]

/-- For a time-translation invariant law, correlation decay is exactly decay of the time
translation on the vacuum complement. -/
theorem correlationDecay_iff {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift s)) = L.law)
    {ρ : ℝ} (hρ : 0 ≤ ρ) :
    CorrelationDecay (L.law : Measure WilsonLoopSpace) s ρ ↔ VacuumComplementDecay L hs ρ := by
  have hmean : ∀ F : OSVector L, ∫ w, F.toBCF w ∂(L.law : Measure WilsonLoopSpace) =
      ⟪vacuum L, F⟫_ℂ := fun F => (inner_vacuum_eq_integral F).symm
  have hmeanU : ∀ F : OSVector L, ⟪vacuum L, translate L hs F⟫_ℂ = ⟪vacuum L, F⟫_ℂ := by
    intro F
    rw [inner_translate_symm hs hτ, translate_vacuum]
  constructor
  · intro h F hF
    have hc := h F.toBCF F.toBCF_mem
    rw [hmean, hF, norm_zero, sq, mul_zero, sub_zero, sub_zero, ← norm_sq_eq_osForm] at hc
    have hc' : ‖translate L hs F‖ ^ 2 ≤ (ρ * ‖F‖) ^ 2 := by
      rw [mul_pow]
      have := norm_sq_eq_osForm (translate L hs F)
      rw [toBCF_translate] at this
      rw [this]
      exact hc
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (mul_nonneg hρ (norm_nonneg _)) two_ne_zero).mp hc'
  · intro h F hF
    set G : OSVector L := mk F hF
    have hd := h (excited G) (inner_vacuum_excited G)
    rw [translate_excited hs hτ] at hd
    have hsq : ‖excited (translate L hs G)‖ ^ 2 ≤ ρ ^ 2 * ‖excited G‖ ^ 2 := by
      rw [← mul_pow]
      exact pow_le_pow_left₀ (norm_nonneg _) hd 2
    rw [norm_sq_excited, norm_sq_excited, hmeanU, norm_sq_eq_osForm, norm_sq_eq_osForm] at hsq
    rw [show F = G.toBCF from rfl, hmean]
    exact hsq

end OSVector

/-- Decay on the dense pre-Hilbert space gives decay of the reconstructed transfer operator on
the whole vacuum complement of the completion. -/
theorem reconstructedTransfer_decay {L : ReflectionPositiveLaw} {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) = L.law)
    {ρ : ℝ} (hdec : OSVector.VacuumComplementDecay L hs ρ) :
    ∀ x : OSHilbert L, ⟪(reconstructedTransferOperator L hs hτ).vacuum, x⟫_ℂ = 0 →
      ‖(reconstructedTransferOperator L hs hτ).op x‖ ≤ ρ * ‖x‖ := by
  set S := reconstructedTransferOperator L hs hτ with hS
  have hτ' := OSVector.map_translate_of_half hτ
  have hcl : ∀ x : OSHilbert L,
      ‖S.op (excitedPart S.vacuum x)‖ ≤ ρ * ‖excitedPart S.vacuum x‖ := by
    intro x
    refine UniformSpace.Completion.induction_on x ?_ fun F => ?_
    · exact isClosed_le (S.op.continuous.comp (continuous_excitedPart _)).norm
        (continuous_const.mul (continuous_excitedPart _).norm)
    · have hcoe : excitedPart S.vacuum (F : OSHilbert L) =
          ((OSVector.excited F : OSVector L) : OSHilbert L) := by
        change (F : OSHilbert L) - ⟪(OSVector.vacuum L : OSHilbert L), (F : OSHilbert L)⟫_ℂ •
            (OSVector.vacuum L : OSHilbert L) = _
        rw [UniformSpace.Completion.inner_coe, OSVector.excited, UniformSpace.Completion.coe_sub,
          UniformSpace.Completion.coe_smul]
      rw [hcoe]
      change ‖reconstructedTransfer L hs hτ' _‖ ≤ _
      rw [reconstructedTransfer_coe, UniformSpace.Completion.norm_coe,
        UniformSpace.Completion.norm_coe]
      exact hdec _ (OSVector.inner_vacuum_excited F)
  intro x hx
  have h := hcl x
  rwa [excitedPart_of_orthogonal hx] at h

/-- Conversely, decay of the reconstructed transfer operator on the vacuum complement restricts
to decay on the dense pre-Hilbert space. -/
theorem vacuumComplementDecay_of_reconstructed {L : ReflectionPositiveLaw} {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) = L.law)
    {ρ : ℝ} (hdec : ∀ x : OSHilbert L, ⟪(reconstructedTransferOperator L hs hτ).vacuum, x⟫_ℂ = 0 →
      ‖(reconstructedTransferOperator L hs hτ).op x‖ ≤ ρ * ‖x‖) :
    OSVector.VacuumComplementDecay L hs ρ := by
  intro F hF
  have h := hdec (F : OSHilbert L) (by
    change ⟪(OSVector.vacuum L : OSHilbert L), (F : OSHilbert L)⟫_ℂ = 0
    rw [UniformSpace.Completion.inner_coe, hF])
  change ‖reconstructedTransfer L hs (OSVector.map_translate_of_half hτ) F‖ ≤
    ρ * ‖(F : OSHilbert L)‖ at h
  rwa [reconstructedTransfer_coe, UniformSpace.Completion.norm_coe,
    UniformSpace.Completion.norm_coe] at h

/-! ### The inputs pass to weak limits -/

section WeakLimits

variable {νs : ℕ → ProbabilityMeasure WilsonLoopSpace} {ν : ProbabilityMeasure WilsonLoopSpace}

theorem tendsto_integral_of_tendsto (hν : Tendsto νs atTop (𝓝 ν)) (f : WilsonLoopSpace →ᵇ ℂ) :
    Tendsto (fun k => ∫ w, f w ∂(νs k : Measure WilsonLoopSpace)) atTop
      (𝓝 (∫ w, f w ∂(ν : Measure WilsonLoopSpace))) :=
  (ProbabilityMeasure.tendsto_iff_forall_integral_rclike_tendsto ℂ).mp hν f

theorem tendsto_osForm_of_tendsto (hν : Tendsto νs atTop (𝓝 ν)) (F G : WilsonLoopSpace →ᵇ ℂ) :
    Tendsto (fun k => osForm (νs k : Measure WilsonLoopSpace) F G) atTop
      (𝓝 (osForm (ν : Measure WilsonLoopSpace) F G)) :=
  tendsto_integral_of_tendsto hν (osIntegrand F G)

/-- Reflection positivity passes to weak limits: the sequence form of
`YangMillsOsterwalderSchraderInheritance.isReflectionPositive_of_tendsto`. -/
theorem reflectionPositive_of_tendsto (hν : Tendsto νs atTop (𝓝 ν))
    (hRP : ∀ k, ∀ F : WilsonLoopSpace →ᵇ ℝ, DependsOnPositiveTime F →
      0 ≤ ∫ w, F (reflectObservables w) * F w ∂(νs k : Measure WilsonLoopSpace)) :
    ∀ F : WilsonLoopSpace →ᵇ ℝ, DependsOnPositiveTime F →
      0 ≤ ∫ w, F (reflectObservables w) * F w ∂(ν : Measure WilsonLoopSpace) :=
  YangMillsOsterwalderSchraderInheritance.isReflectionPositive_of_tendsto hν
    (Filter.Eventually.of_forall hRP)

/-- Invariance under a continuous map passes to weak limits. -/
theorem map_eq_of_tendsto {f : WilsonLoopSpace → WilsonLoopSpace} (hf : Continuous f)
    (hν : Tendsto νs atTop (𝓝 ν))
    (hinv : ∀ k, (νs k : Measure WilsonLoopSpace).map f = νs k) :
    (ν : Measure WilsonLoopSpace).map f = ν := by
  have hm := ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous _ _ hν hf
  have hk : (fun k => (νs k).map f) = νs :=
    funext fun k => ProbabilityMeasure.toMeasure_injective (hinv k)
  rw [hk] at hm
  exact congrArg (fun μ : ProbabilityMeasure WilsonLoopSpace => (μ : Measure WilsonLoopSpace))
    (tendsto_nhds_unique hm hν)

/-- One physical time and ratio, with a cutoff threshold allowed to depend on the fixed
functional. This is a correlation estimate on the laws, not reflection positivity at cutoffs. -/
def EventualCorrelationDecay (νs : ℕ → ProbabilityMeasure WilsonLoopSpace) (s : ℚ) (ρ : ℝ) : Prop :=
  ∀ F ∈ positiveTimeFunctionals, ∀ᶠ k in atTop,
    (osForm (νs k : Measure WilsonLoopSpace) (F.compContinuous (translateCM s))
        (F.compContinuous (translateCM s))).re -
        ‖∫ w, F w ∂(νs k : Measure WilsonLoopSpace)‖ ^ 2 ≤
      ρ ^ 2 * ((osForm (νs k : Measure WilsonLoopSpace) F F).re -
        ‖∫ w, F w ∂(νs k : Measure WilsonLoopSpace)‖ ^ 2)

/-- The observable may be fixed before its cutoff threshold is chosen. -/
theorem correlationDecay_of_tendsto_eventually (hν : Tendsto νs atTop (𝓝 ν)) {s : ℚ} {ρ : ℝ}
    (h : EventualCorrelationDecay νs s ρ) :
    CorrelationDecay (ν : Measure WilsonLoopSpace) s ρ := by
  intro F hF
  have h1 := tendsto_osForm_of_tendsto hν (F.compContinuous (translateCM s))
    (F.compContinuous (translateCM s))
  have h2 := tendsto_integral_of_tendsto hν F
  have h3 := tendsto_osForm_of_tendsto hν F F
  have hmean := (continuous_norm.tendsto _).comp h2 |>.pow 2
  exact le_of_tendsto_of_tendsto ((Complex.continuous_re.tendsto _ |>.comp h1).sub hmean)
    (tendsto_const_nhds.mul ((Complex.continuous_re.tendsto _ |>.comp h3).sub hmean)) (h F hF)

/-- Correlation decay with fixed `s` and `ρ` passes to weak limits. -/
theorem correlationDecay_of_tendsto (hν : Tendsto νs atTop (𝓝 ν)) {s : ℚ} {ρ : ℝ}
    (h : ∀ k, CorrelationDecay (νs k : Measure WilsonLoopSpace) s ρ) :
    CorrelationDecay (ν : Measure WilsonLoopSpace) s ρ :=
  correlationDecay_of_tendsto_eventually hν fun F hF =>
    Eventually.of_forall fun k => h k F hF

end WeakLimits

/-! ### Lane 2a's identification obligations as reconstruction inputs -/

/-- A limit law of renormalized Wilson loops satisfying lane 2a's identification obligations is
a reflection-positive law as soon as it is reflection invariant: the field `reflection_positive`
of `ContinuumIdentificationObligations` is used verbatim. Reflection invariance is not among
lane 2a's fields and is a separate input here. -/
def reflectionPositiveLawOfObligations {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} (h : ContinuumIdentificationObligations P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    (hθ : (ν : Measure WilsonLoopSpace).map reflectObservables = ν) : ReflectionPositiveLaw where
  law := ν
  reflection_positive := h.reflection_positive ν hν
  reflection_invariant := hθ

/-- Under lane 2a's identification obligations (whose `translation_invariant` field covers every
rational translation) and reflection invariance, every physical time `s ≥ 0` has a reconstructed
positive transfer operator. -/
def transferOperatorOfObligations {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} (h : ContinuumIdentificationObligations P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    (hθ : (ν : Measure WilsonLoopSpace).map reflectObservables = ν) {s : ℚ} (hs : 0 ≤ s) :
    PositiveTransferOperator (OSHilbert (reflectionPositiveLawOfObligations h ν hν hθ)) :=
  reconstructedTransferOperator _ hs
    (congrArg (fun μ : ProbabilityMeasure WilsonLoopSpace => (μ : Measure WilsonLoopSpace))
      (h.translation_invariant ν hν (timeShift (s / 2))))

/-! ## Reconstruction after the Wilson-loop limit -/

section WilsonLedger

/-- Obsolete finite-cutoff premise, retained to state its explicit refutation in
`tests/YangMillsReconstructedGeneratorGapNegativeControl.lean`. On the dyadic path, positive
physical times can project to both halves of the finite torus; an odd difference of two such
loops violates this premise. It is not an open target and is not used by the limit bridge. -/
structure WilsonReflectionInputs (P : CutoffPath) : Prop where
  reflection_positive : ∀ n, ∀ F : WilsonLoopSpace →ᵇ ℝ, DependsOnPositiveTime F →
    0 ≤ ∫ w, F (reflectObservables w) * F w ∂(P.wilsonLoopLaw n : Measure WilsonLoopSpace)
  reflection_invariant : ∀ n,
    (P.wilsonLoopLaw n : Measure WilsonLoopSpace).map reflectObservables = P.wilsonLoopLaw n

/-- The regularity and symmetry questions about the limit laws that remain after reflection
positivity has been inherited from adapted half-lattice observables. The path conditions
(`ContinuumCutoffPath.IsDyadic`) and the symmetry of the renormalization constants
(`HasReflectionInvariantFactors`) are explicit arguments of the constructions below, proved for
the explicit dyadic path and for factor one; they are not fields here. Each field is one named
open question: `dyadic_approximable` is regularity of the realized loop field along dyadic
approximations; `reflection_invariant` is proved on functionals of finitely many time-dyadic
loops (`limit_reflect_invariant_timeDyadic`) and its extension to every loop is the same
regularity question; `translation_invariant` is covariance under all rational shifts, of which
the lattice shifts are proved (`limit_translation_invariant`). -/
structure WilsonLimitRegularity (P : ContinuumCutoffPath)
    (Z : LoopRenormalization P.toCutoffPath) : Prop where
  dyadic_approximable : ∀ ν, Z.IsLimitLaw ν → YangMillsOsterwalderSchraderInheritance.DyadicTimeApproximable ν
  reflection_invariant : Z.LimitLawsReflectionInvariant
  translation_invariant : Z.LimitLawsTranslationInvariant

/-- Adapted finite-cutoff positivity is passed to the limit before the full positive-time
field is obtained from dyadic approximation. No `WilsonReflectionInputs` is required; the path and factor
conditions are proved facts passed explicitly. -/
def wilsonLimitLaw (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic) (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z)
    (R : WilsonLimitRegularity P Z) (ν : ProbabilityMeasure WilsonLoopSpace)
    (hν : Z.IsLimitLaw ν) : ReflectionPositiveLaw where
  law := ν
  reflection_positive :=
    YangMillsOsterwalderSchraderInheritance.reflection_positive_of_dyadicTimeApproximable
      P hP.spacing_eq hP.eventually_even Z hZ R.dyadic_approximable ν hν
  reflection_invariant := R.reflection_invariant ν hν

/-- Half-step symmetry is an input on the limiting law. -/
theorem wilsonLimitLaw_halfStep (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z) (ν : ProbabilityMeasure WilsonLoopSpace)
    (hν : Z.IsLimitLaw ν) (s : ℚ) :
    ((wilsonLimitLaw P Z hP hZ R ν hν).law : Measure WilsonLoopSpace).map
        (translateObservables (timeShift (s / 2))) = (wilsonLimitLaw P Z hP hZ R ν hν).law :=
  congrArg (fun μ : ProbabilityMeasure WilsonLoopSpace => (μ : Measure WilsonLoopSpace))
    (R.translation_invariant ν hν (timeShift (s / 2)))

/-- The OS Hilbert space is formed from a limit law, not an assumed positive finite torus. -/
abbrev WilsonLimitHilbert (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z) (ν : ProbabilityMeasure WilsonLoopSpace)
    (hν : Z.IsLimitLaw ν) : Type := OSHilbert (wilsonLimitLaw P Z hP hZ R ν hν)

/-- The transfer operator of a limiting renormalized Wilson-loop law. -/
def wilsonLimitTransfer (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z) (ν : ProbabilityMeasure WilsonLoopSpace)
    (hν : Z.IsLimitLaw ν) {s : ℚ} (hs : 0 ≤ s) :
    PositiveTransferOperator (WilsonLimitHilbert P Z hP hZ R ν hν) :=
  reconstructedTransferOperator _ hs (wilsonLimitLaw_halfStep P Z hP hZ R ν hν s)

/-- Self-adjointness, positivity and normalization follow after the limit has been reconstructed. -/
theorem wilsonLimitTransfer_properties (P : ContinuumCutoffPath)
    (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν) {s : ℚ} (hs : 0 ≤ s) :
    IsSelfAdjoint (wilsonLimitTransfer P Z hP hZ R ν hν hs).op ∧
    0 ≤ (wilsonLimitTransfer P Z hP hZ R ν hν hs).op ∧
    ‖(wilsonLimitTransfer P Z hP hZ R ν hν hs).op‖ ≤ 1 ∧
    (wilsonLimitTransfer P Z hP hZ R ν hν hs).op (wilsonLimitTransfer P Z hP hZ R ν hν hs).vacuum =
      (wilsonLimitTransfer P Z hP hZ R ν hν hs).vacuum ∧
    ‖(wilsonLimitTransfer P Z hP hZ R ν hν hs).vacuum‖ = 1 :=
  ⟨(wilsonLimitTransfer P Z hP hZ R ν hν hs).isSelfAdjoint,
    (wilsonLimitTransfer P Z hP hZ R ν hν hs).nonneg,
    (wilsonLimitTransfer P Z hP hZ R ν hν hs).norm_le_one,
    (wilsonLimitTransfer P Z hP hZ R ν hν hs).vacuum_fixed,
    (wilsonLimitTransfer P Z hP hZ R ν hν hs).vacuum_norm⟩

/-- An eventual estimate for each fixed functional passes to every subsequential limit. -/
theorem wilsonLimit_correlationDecay (P : ContinuumCutoffPath)
    (Z : LoopRenormalization P.toCutoffPath) {s : ℚ} {ρ : ℝ}
    (hdecay : EventualCorrelationDecay Z.law s ρ) (ν : ProbabilityMeasure WilsonLoopSpace)
    (hν : Z.IsLimitLaw ν) : CorrelationDecay (ν : Measure WilsonLoopSpace) s ρ := by
  obtain ⟨φ, hφ, hlim⟩ := hν
  exact correlationDecay_of_tendsto_eventually hlim fun F hF =>
    hφ.tendsto_atTop.eventually (hdecay F hF)

/-- Conditional physical-time decay and coercivity on the generator domain of each limit.
The same physical time and ratio are used before the limit. The correlation estimate,
regularity and limit symmetries remain hypotheses. This does not assert that the generator
has dense domain or is a self-adjoint physical Hamiltonian. -/
theorem wilsonLimit_decay_and_generator_gap (P : ContinuumCutoffPath)
    (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    {s : ℚ} (hs : 0 < s) {ρ : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hdecay : EventualCorrelationDecay Z.law s ρ) (ν : ProbabilityMeasure WilsonLoopSpace)
    (hν : Z.IsLimitLaw ν) :
    (∀ x : WilsonLimitHilbert P Z hP hZ R ν hν,
      ⟪(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).vacuum, x⟫_ℂ = 0 →
        ‖(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).op x‖ ≤ ρ * ‖x‖) ∧
    ∀ u : (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).generatorDomain s,
      ⟪(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).vacuum,
        (u : WilsonLimitHilbert P Z hP hZ R ν hν)⟫_ℂ = 0 →
      transferGapRate s ρ * ‖(u : WilsonLimitHilbert P Z hP hZ R ν hν)‖ ^ 2 ≤
        (⟪(u : WilsonLimitHilbert P Z hP hZ R ν hν),
          (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).generator s u⟫_ℂ).re := by
  have hlimit := wilsonLimit_correlationDecay P Z hdecay ν hν
  have hτ := wilsonLimitLaw_halfStep P Z hP hZ R ν hν s
  have hvc := (OSVector.correlationDecay_iff hs.le (OSVector.map_translate_of_half hτ)
    hρ0.le).mp hlimit
  have hop := reconstructedTransfer_decay hs.le hτ hvc
  refine ⟨hop, fun u hu => ?_⟩
  exact (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).generator_gap (Rat.cast_pos.mpr hs)
    hρ0 hρ1 hop u hu

/-- Remaining analytic requirements on the actual renormalized laws. Tightness ensures limit
laws exist; identification (`LimitLawsAgree`, the one name for that question) makes them unique. Uniform decay is still an unproved physical
estimate, expressed before the limit without finite-cutoff Hilbert spaces. -/
structure WilsonTransferLedger (P : ContinuumCutoffPath)
    (Z : LoopRenormalization P.toCutoffPath) (s : ℚ) (ρ : ℝ) : Prop where
  tails : Z.TailObligation
  uniform_decay : EventualCorrelationDecay Z.law s ρ
  identification : Z.LimitLawsAgree

/-- With limit regularity and symmetries, the ledger gives full weak convergence and a
conditional coercivity inequality on each reconstructed generator domain. -/
theorem WilsonTransferLedger.limit_generator_gap {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    {s : ℚ} (hs : 0 < s) {ρ : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hL : WilsonTransferLedger P Z s ρ) :
    (∃ ν, Tendsto Z.law atTop (𝓝 ν)) ∧
    ∀ (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
      (u : (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).generatorDomain s),
      ⟪(wilsonLimitTransfer P Z hP hZ R ν hν hs.le).vacuum,
        (u : WilsonLimitHilbert P Z hP hZ R ν hν)⟫_ℂ = 0 →
      transferGapRate s ρ * ‖(u : WilsonLimitHilbert P Z hP hZ R ν hν)‖ ^ 2 ≤
        (⟪(u : WilsonLimitHilbert P Z hP hZ R ν hν),
          (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).generator s u⟫_ℂ).re :=
  ⟨(Z.converges_iff_limitLaw_unique hL.tails).mp hL.identification, fun ν hν =>
    (wilsonLimit_decay_and_generator_gap P Z hP hZ R hs hρ0 hρ1 hL.uniform_decay ν hν).2⟩

/-- Positive control: on the explicit dyadic path with factor one the path and factor conditions
are theorems, so the only inputs left are the three regularity questions and the ledger. -/
example (R : WilsonLimitRegularity dyadicOneLoopPath
      (LoopRenormalization.unrenormalized dyadicOneLoopPath.toCutoffPath))
    {s : ℚ} (hs : 0 < s) {ρ : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hL : WilsonTransferLedger dyadicOneLoopPath
      (LoopRenormalization.unrenormalized dyadicOneLoopPath.toCutoffPath) s ρ) :
    ∃ ν, Tendsto (LoopRenormalization.unrenormalized dyadicOneLoopPath.toCutoffPath).law atTop
      (𝓝 ν) :=
  (WilsonTransferLedger.limit_generator_gap dyadicOneLoopPath_isDyadic
    (YangMillsOsterwalderSchraderInheritance.hasReflectionInvariantFactors_unrenormalized _)
    R hs hρ0 hρ1 hL).1

/-- A commensurability fact on the explicit dyadic path: physical time `s = 2`
has half step `1`, a lattice vector at every dyadic spacing. -/
theorem dyadicOneLoopPath_halfStep :
    ∀ n, IsLatticeVector (dyadicOneLoopPath.spacing n) (timeShift ((2 : ℚ) / 2)) := by
  intro n i
  by_cases hi : i = 0
  · refine ⟨2 ^ n, ?_⟩
    subst hi
    simp only [timeShift, ite_true]
    change ((2 / 2 : ℚ) : ℝ) = ((2 : ℤ) ^ n : ℤ) * (1 / 2 : ℝ) ^ n
    push_cast
    rw [← mul_pow]
    norm_num
  · refine ⟨0, ?_⟩
    simp [timeShift, hi]

/-! ### Unbounded Self-Adjoint Hamiltonian Semigroup Bridge on `OSHilbert` When `0 ∈ spectrum ℝ T` -/

/-- Conditional functional-analytic bridge on the reconstructed Osterwalder–Schrader Hilbert space
`OSHilbert L` connecting a continuous-time semigroup `T_semigroup : ℝ → OSHilbert L →L[ℂ] OSHilbert L`
to an unbounded, densely defined self-adjoint Hamiltonian `H_op : OSHilbert L →ₗ.[ℂ] OSHilbert L`
(`IsSelfAdjoint H_op`), without requiring `0 ∉ spectrum ℝ T` or a bounded functional-calculus
logarithm `logGenerator`. Scope note: `H_op` and its exponential decay rate `m` (`h_decay`) are
supplied as explicit hypotheses here rather than derived from the Wilson measure. -/
structure UnboundedSelfAdjointOSSemigroupBridge (L : ReflectionPositiveLaw) (m : ℝ) where
  H_op : OSHilbert L →ₗ.[ℂ] OSHilbert L
  T_semigroup : ℝ → OSHilbert L →L[ℂ] OSHilbert L
  h_selfAdjoint : IsSelfAdjoint H_op
  h_zero : ∀ u : H_op.domain, T_semigroup 0 u = u
  h_generator : ∀ u : H_op.domain,
    HasDerivWithinAt (fun t : ℝ => T_semigroup t u) (-(H_op u)) (Set.Ioi 0) 0
  h_decay : ∀ u : H_op.domain, ∀ t : ℝ, 0 < t →
    ‖T_semigroup t u‖ ≤ Real.exp (-m * t) * ‖(u : OSHilbert L)‖

/-- Even when a reconstructed lattice or continuum transfer operator `T : OSHilbert L →L[ℂ] OSHilbert L`
has `0 ∈ spectrum ℝ T` (so no bounded self-adjoint operator `G` satisfies `exp(-a G) = T` by
`PositiveTransferOperator.not_exists_bounded_generator_of_zero_mem_spectrum`), any supplied
`UnboundedSelfAdjointOSSemigroupBridge L m` on `OSHilbert L` satisfies:
1. Domain coercivity `m * ‖u‖^2 ≤ Re ⟪u, H_op u⟫_ℂ` for all `u : H_op.domain`,
2. Residual lower bound `(m - energy) * ‖u‖ ≤ ‖H_op u - energy • u‖` for all `u : H_op.domain` and
   all `energy : ℝ`, and
3. For every real energy `energy < m`, an everywhere-defined bounded resolvent
   `R : OSHilbert L →L[ℂ] OSHilbert L` inverting `H_op - energy` with operator norm
   `‖R‖ ≤ 1 / (m - energy)`.
Scope note: the densely defined self-adjoint generator `H_op` and its exponential decay rate `m` on
the relevant subspace are explicit hypotheses packaged in `UnboundedSelfAdjointOSSemigroupBridge`. -/
theorem unbounded_selfAdjoint_osSemigroup_coercive_and_resolvent_without_spectral_floor
    (L : ReflectionPositiveLaw) {m energy : ℝ} (henergy : energy < m)
    (bridge : UnboundedSelfAdjointOSSemigroupBridge L m)
    (T : OSHilbert L →L[ℂ] OSHilbert L) (h0 : (0 : ℝ) ∈ spectrum ℝ T) (a : ℝ) :
    (¬ ∃ G : OSHilbert L →L[ℂ] OSHilbert L,
      IsSelfAdjoint G ∧ cfc (fun y : ℝ => Real.exp (-a * y)) G = T) ∧
    (∀ u : bridge.H_op.domain,
      m * ‖(u : OSHilbert L)‖ ^ 2 ≤ (⟪(u : OSHilbert L), bridge.H_op u⟫_ℂ).re ∧
      (m - energy) * ‖(u : OSHilbert L)‖ ≤
        ‖bridge.H_op u - (energy : ℂ) • (u : OSHilbert L)‖) ∧
    (∃ R : OSHilbert L →L[ℂ] OSHilbert L,
      (∀ f : OSHilbert L, ∃ hf : R f ∈ bridge.H_op.domain,
        bridge.H_op ⟨R f, hf⟩ - (energy : ℂ) • R f = f) ∧
      (∀ u : bridge.H_op.domain,
        R (bridge.H_op u - (energy : ℂ) • (u : OSHilbert L)) = (u : OSHilbert L)) ∧
      ‖R‖ ≤ 1 / (m - energy)) := by
  refine ⟨PositiveTransferOperator.not_exists_bounded_generator_of_zero_mem_spectrum h0 a,
    fun u => ?_,
    selfAdjoint_resolvent_of_evolution_decay bridge.H_op bridge.h_selfAdjoint
      bridge.T_semigroup m energy henergy bridge.h_zero bridge.h_generator bridge.h_decay⟩
  have hcoerc : m * ‖(u : OSHilbert L)‖ ^ 2 ≤ (⟪(u : OSHilbert L), bridge.H_op u⟫_ℂ).re :=
    generator_coercivity_of_decay bridge.T_semigroup (u : OSHilbert L) (bridge.H_op u) m
      (bridge.h_zero u) (bridge.h_generator u) (bridge.h_decay u)
  exact ⟨hcoerc, generator_residual_lower_bound (u : OSHilbert L) (bridge.H_op u) m energy hcoerc⟩

/-- Conditional specialization of `unbounded_selfAdjoint_osSemigroup_coercive_and_resolvent_without_spectral_floor`
to the limiting Wilson-loop OS Hilbert space `WilsonLimitHilbert P Z hP hZ R ν hν = OSHilbert (wilsonLimitLaw P Z hP hZ R ν hν)`
at transfer rate `transferGapRate s ρ = -(Real.log ρ) / s > 0` for `0 < s` and `0 < ρ < 1`, under a
supplied `UnboundedSelfAdjointOSSemigroupBridge`. -/
theorem wilsonLimit_unbounded_selfAdjoint_resolvent_bridge
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic)
    (hZ : YangMillsOsterwalderSchraderInheritance.HasReflectionInvariantFactors Z)
    (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s : ℚ} (hs : 0 < s) {ρ energy : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (henergy : energy < transferGapRate s ρ)
    (bridge : UnboundedSelfAdjointOSSemigroupBridge
      (wilsonLimitLaw P Z hP hZ R ν hν) (transferGapRate s ρ)) :
    0 < transferGapRate s ρ ∧
    (∀ u : bridge.H_op.domain,
      transferGapRate s ρ * ‖(u : WilsonLimitHilbert P Z hP hZ R ν hν)‖ ^ 2 ≤
        (⟪(u : WilsonLimitHilbert P Z hP hZ R ν hν), bridge.H_op u⟫_ℂ).re) ∧
    (∃ Res : WilsonLimitHilbert P Z hP hZ R ν hν →L[ℂ] WilsonLimitHilbert P Z hP hZ R ν hν,
      (∀ f : WilsonLimitHilbert P Z hP hZ R ν hν, ∃ hf : Res f ∈ bridge.H_op.domain,
        bridge.H_op ⟨Res f, hf⟩ - (energy : ℂ) • Res f = f) ∧
      (∀ u : bridge.H_op.domain,
        Res (bridge.H_op u - (energy : ℂ) • (u : WilsonLimitHilbert P Z hP hZ R ν hν)) =
          (u : WilsonLimitHilbert P Z hP hZ R ν hν)) ∧
      ‖Res‖ ≤ 1 / (transferGapRate s ρ - energy)) :=
  ⟨transferGapRate_pos (Rat.cast_pos.mpr hs) hρ0 hρ1,
    fun u => generator_coercivity_of_decay bridge.T_semigroup
      (u : WilsonLimitHilbert P Z hP hZ R ν hν) (bridge.H_op u) (transferGapRate s ρ)
      (bridge.h_zero u) (bridge.h_generator u) (bridge.h_decay u),
    selfAdjoint_resolvent_of_evolution_decay bridge.H_op bridge.h_selfAdjoint
      bridge.T_semigroup (transferGapRate s ρ) energy henergy
      bridge.h_zero bridge.h_generator bridge.h_decay⟩

/-! ### Schwinger-level gap, landing tube, and non-circular conditional bridge -/

open YangMillsOsterwalderSchraderInheritance

/-- Moment form of physical-time correlation decay on multi-loop Schwinger functions: one ratio
`q`, a constant `C` allowed to depend on the positive-time family `F`, and a cutoff threshold
allowed to depend on the discrete time step `t`. -/
def SchwingerMomentDecay {P : CutoffPath} (Z : LoopRenormalization P) (s : ℚ) (q : ℝ) : Prop :=
  ∀ F : DisjointLoopFamily, F.PositiveTime → ∃ C : ℝ, ∀ t : ℕ, ∀ᶠ n in atTop,
    reflectedConnected Z n F (F.translate (timeShift (t * s))) ≤ C * q ^ t

/-- Non-triviality / finite-mass excitation floor (`m < ∞`) at the Schwinger level: at least one
positive-time family keeps its reflected connected self-correlation bounded below by `c > 0`
eventually in the cutoff. -/
def SchwingerExcitationFloor {P : CutoffPath} (Z : LoopRenormalization P) : Prop :=
  ∃ (F : DisjointLoopFamily) (c : ℝ), F.PositiveTime ∧ 0 < c ∧
    ∀ᶠ n in atTop, c ≤ reflectedConnected Z n F F

/-- Reflection positivity of a limiting Schwinger functional `S` on diagonal positive-time
reflected pairs, inherited from finite-cutoff reflected connected correlators. -/
def SchwingerReflectionPositive {P : CutoffPath} (Z : LoopRenormalization P) : Prop :=
  ∀ F : DisjointLoopFamily, F.PositiveTime → ∀ᶠ n in atTop, 0 ≤ reflectedConnected Z n F F

/-- Rational translation and hypercubic coordinate-permutation invariance of a limiting
Schwinger functional `S : DisjointLoopFamily → ℝ`. -/
def SchwingerEuclideanInvariant (S : DisjointLoopFamily → ℝ) : Prop :=
  ∀ (c : Fin 4 → ℚ) (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily),
    S (F.translate c) = S F ∧ S (F.permute σ) = S F

/-- Finite-mass non-degeneracy (`m < ∞`) of a renormalized Schwinger sequence `Z`: at least one
positive-time loop family retains a strictly positive reflected connected self-correlator floor
`0 < c` eventually in the cutoff. -/
def SchwingerMassFinite {P : CutoffPath} (Z : LoopRenormalization P) : Prop :=
  ∃ (F : DisjointLoopFamily) (c : ℝ), F.PositiveTime ∧ 0 < c ∧
    ∀ᶠ n in atTop, c ≤ reflectedConnected Z n F F

theorem schwingerMassFinite_iff_schwingerExcitationFloor {P : CutoffPath}
    (Z : LoopRenormalization P) :
    SchwingerMassFinite Z ↔ SchwingerExcitationFloor Z := Iff.rfl

/-- Continuity of a limiting Schwinger functional `S : DisjointLoopFamily → ℝ` under rational
spacetime loop translations `c : Fin 4 → ℚ`. -/
def SchwingerPositionContinuous (S : DisjointLoopFamily → ℝ) : Prop :=
  ∀ F : DisjointLoopFamily, Continuous (fun c : Fin 4 → ℚ => S (F.translate c))

theorem schwingerPositionContinuous_of_euclideanInvariant
    {S : DisjointLoopFamily → ℝ} (hInv : SchwingerEuclideanInvariant S) :
    SchwingerPositionContinuous S := by
  intro F
  have hconst : (fun c : Fin 4 → ℚ => S (F.translate c)) = fun _ => S F := by
    funext c
    exact (hInv c (Equiv.refl _) F).1
  rw [hconst]
  exact continuous_const

/-- Spectral gap package on the reconstructed Osterwalder–Schrader Hilbert space `OSHilbert L_rp`
for `reconstructedTransferOperator L_rp hs hτ`:
1. One-step operator-norm contraction `‖T u‖ ≤ ρ ‖u‖` on the vacuum orthogonal complement,
2. Excited-subspace operator norm bound `‖T.excitedOp‖ ≤ ρ`,
3. Excited-subspace spectral inclusion `spectrum ℝ T.excitedOp ⊆ Set.Icc 0 ρ`, and
4. Full real spectral decomposition `spectrum ℝ T.op ⊆ Set.Icc 0 ρ ∪ {1}`. -/
def SchwingerSpectralGap (L_rp : ReflectionPositiveLaw) {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L_rp.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) =
      L_rp.law)
    (ρ : ℝ) : Prop :=
  let T := reconstructedTransferOperator L_rp hs hτ
  (∀ u : OSHilbert L_rp, ⟪T.vacuum, u⟫_ℂ = 0 → ‖T.op u‖ ≤ ρ * ‖u‖) ∧
  ‖T.excitedOp‖ ≤ ρ ∧
  spectrum ℝ T.excitedOp ⊆ Set.Icc 0 ρ ∧
  spectrum ℝ T.op ⊆ Set.Icc 0 ρ ∪ {1}

/-- Even-power moment bounds `Re ⟨u, T^{2n} u⟩ ≤ C(u) · ρ^{2n}` on the vacuum complement of
`reconstructedTransferOperator L_rp hs hτ` imply the full constant-free spectral gap package
`SchwingerSpectralGap L_rp hs hτ ρ` via `PositiveTransferOperator.decay_of_moment_bounds`. -/
theorem schwingerSpectralGap_of_momentDecay (L_rp : ReflectionPositiveLaw) {s : ℚ} (hs : 0 ≤ s)
    (hτ : (L_rp.law : Measure WilsonLoopSpace).map (translateObservables (timeShift (s / 2))) =
      L_rp.law)
    {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hmom : ∀ u : OSHilbert L_rp,
      ⟪(reconstructedTransferOperator L_rp hs hτ).vacuum, u⟫_ℂ = 0 →
      ∃ C : ℝ, ∀ n : ℕ,
        (⟪u, ((reconstructedTransferOperator L_rp hs hτ).op ^ (2 * n)) u⟫_ℂ).re ≤
          C * ρ ^ (2 * n)) :
    SchwingerSpectralGap L_rp hs hτ ρ := by
  let T := reconstructedTransferOperator L_rp hs hτ
  have hdec : ∀ u : OSHilbert L_rp, ⟪T.vacuum, u⟫_ℂ = 0 → ‖T.op u‖ ≤ ρ * ‖u‖ :=
    fun u hu => T.decay_of_moment_bounds hρ u (hmom u hu)
  have hnorm : ‖T.excitedOp‖ ≤ ρ := (T.norm_excitedOp_le_iff hρ).mpr hdec
  have hspec_exc : spectrum ℝ T.excitedOp ⊆ Set.Icc 0 ρ :=
    (T.spectrum_excitedOp_subset_iff hρ).mpr hnorm
  have hspec_op : spectrum ℝ T.op ⊆ Set.Icc 0 ρ ∪ {1} :=
    T.spectrum_op_subset hρ hdec
  exact ⟨hdec, hnorm, hspec_exc, hspec_op⟩

/-- Stage 1 (Bauerschmidt–Brydges–Slade hierarchical `ϕ⁴` stable-manifold RG flow):
tracks a marginal coupling `g_marg : ℕ → ℝ` together with an irrelevant polymer remainder norm
`K_irrel : ℕ → ℝ` contracting by `q_bbs ∈ (0, 1)` at each renormalization-group step. -/
structure HierarchicalPhi4BBSRG where
  g_marg : ℕ → ℝ
  K_irrel : ℕ → ℝ
  q_bbs : ℝ
  hq_pos : 0 < q_bbs
  hq_lt_one : q_bbs < 1
  hK_nonneg : ∀ k : ℕ, 0 ≤ K_irrel k
  hK_step : ∀ k : ℕ, K_irrel (k + 1) ≤ q_bbs * K_irrel k

/-- Geometric decay `K_irrel k ≤ K_irrel 0 * q_bbs ^ k` of the irrelevant polymer norm across
`k` hierarchical BBS renormalization steps. -/
theorem HierarchicalPhi4BBSRG.irrelevant_geometric_decay
    (B : HierarchicalPhi4BBSRG) (k : ℕ) :
    B.K_irrel k ≤ B.K_irrel 0 * B.q_bbs ^ k := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hstep := B.hK_step k
    have hmul : B.q_bbs * B.K_irrel k ≤ B.q_bbs * (B.K_irrel 0 * B.q_bbs ^ k) :=
      mul_le_mul_of_nonneg_left ih B.hq_pos.le
    calc B.K_irrel (k + 1)
        ≤ B.q_bbs * B.K_irrel k := hstep
      _ ≤ B.q_bbs * (B.K_irrel 0 * B.q_bbs ^ k) := hmul
      _ = B.K_irrel 0 * B.q_bbs ^ (k + 1) := by rw [pow_succ]; ring

/-- Two-cutoff stability on the Bauerschmidt–Brydges–Slade stable manifold: when two cutoff flows
are matched on their marginal coupling and their irrelevant polymer difference `Δ : ℕ → ℝ`
contracts by `B.q_bbs` per step (`Δ (k + 1) ≤ B.q_bbs * Δ k`), `Δ k ≤ Δ 0 * B.q_bbs ^ k` and the
geometric envelope tends to `0` as `k → ∞`. -/
theorem HierarchicalPhi4BBSRG.two_cutoff_difference_geometric_contraction
    (B : HierarchicalPhi4BBSRG) (Δ : ℕ → ℝ)
    (h_step : ∀ k : ℕ, Δ (k + 1) ≤ B.q_bbs * Δ k) :
    (∀ k : ℕ, Δ k ≤ Δ 0 * B.q_bbs ^ k) ∧
    Tendsto (fun k : ℕ => Δ 0 * B.q_bbs ^ k) atTop (𝓝 0) := by
  have h_bound : ∀ k : ℕ, Δ k ≤ Δ 0 * B.q_bbs ^ k := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      have hmul : B.q_bbs * Δ k ≤ B.q_bbs * (Δ 0 * B.q_bbs ^ k) :=
        mul_le_mul_of_nonneg_left ih B.hq_pos.le
      calc Δ (k + 1)
          ≤ B.q_bbs * Δ k := h_step k
        _ ≤ B.q_bbs * (Δ 0 * B.q_bbs ^ k) := hmul
        _ = Δ 0 * B.q_bbs ^ (k + 1) := by rw [pow_succ]; ring
  have h_tendsto : Tendsto (fun k : ℕ => Δ 0 * B.q_bbs ^ k) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds (x := Δ 0)).mul
      (tendsto_pow_atTop_nhds_zero_of_lt_one B.hq_pos.le B.hq_lt_one)
  exact ⟨h_bound, h_tendsto⟩

/-- Stage 2 (three-dimensional super-renormalizable Yang–Mills UV scaling):
carries the blocking depth `K : ℕ` and infrared coupling `g0_sq ≥ 0` from which the dimensionless
running coupling decays geometrically by `1 / 2` per dyadic UV step without logarithmic running. -/
structure ThreeDimSuperRenormalizableYM where
  K : ℕ
  g0_sq : ℝ
  hg0_nonneg : 0 ≤ g0_sq

namespace ThreeDimSuperRenormalizableYM

/-- Dimensionless coupling `g3d_sq k = g0_sq * (1 / 2) ^ (K - k)` at scale `k` in three-dimensional
super-renormalizable Yang–Mills. -/
noncomputable def g3d_sq (M : ThreeDimSuperRenormalizableYM) (k : ℕ) : ℝ :=
  M.g0_sq * (1 / 2 : ℝ) ^ (M.K - k)

/-- Geometric summability of the three-dimensional Yang–Mills UV coupling sequence
`j ↦ g0_sq * (1 / 2) ^ j` across all UV scales, with exact sum `2 * g0_sq`. -/
theorem uv_coupling_geometric_summable (M : ThreeDimSuperRenormalizableYM) :
    Summable (fun j : ℕ => M.g0_sq * (1 / 2 : ℝ) ^ j) ∧
    (∑' j : ℕ, M.g0_sq * (1 / 2 : ℝ) ^ j) = 2 * M.g0_sq ∧
    ∀ k : ℕ, 0 ≤ M.g3d_sq k ∧ M.g3d_sq k ≤ M.g0_sq := by
  have hsum : Summable (fun j : ℕ => (1 / 2 : ℝ) ^ j) :=
    summable_geometric_of_lt_one (by norm_num) (by norm_num)
  refine ⟨hsum.mul_left M.g0_sq, ?_, fun k => ⟨?_, ?_⟩⟩
  · rw [tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    ring
  · unfold g3d_sq
    exact mul_nonneg M.hg0_nonneg (pow_nonneg (by norm_num) _)
  · unfold g3d_sq
    have hpow : (1 / 2 : ℝ) ^ (M.K - k) ≤ 1 :=
      pow_le_one₀ (by norm_num) (by norm_num)
    nlinarith [M.hg0_nonneg]

/-- Two-loop counterterm and quadratic polymer remainder summability in three-dimensional
super-renormalizable Yang–Mills: `(M.g3d_sq k) ^ 2 = M.g0_sq ^ 2 * (1 / 4) ^ (M.K - k)` is
geometrically summable across all UV scales with exact sum `(4 / 3) * M.g0_sq ^ 2`. -/
theorem two_loop_counterterm_and_polymer_summable (M : ThreeDimSuperRenormalizableYM) :
    (∀ k : ℕ, (M.g3d_sq k) ^ 2 = M.g0_sq ^ 2 * (1 / 4 : ℝ) ^ (M.K - k)) ∧
    Summable (fun j : ℕ => M.g0_sq ^ 2 * (1 / 4 : ℝ) ^ j) ∧
    (∑' j : ℕ, M.g0_sq ^ 2 * (1 / 4 : ℝ) ^ j) = (4 / 3 : ℝ) * M.g0_sq ^ 2 := by
  have hsum : Summable (fun j : ℕ => (1 / 4 : ℝ) ^ j) :=
    summable_geometric_of_lt_one (by norm_num) (by norm_num)
  refine ⟨fun k => ?_, hsum.mul_left (M.g0_sq ^ 2), ?_⟩
  · unfold g3d_sq
    rw [mul_pow, ← pow_mul, mul_comm (M.K - k) 2, pow_mul]
    norm_num
  · rw [tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    ring

end ThreeDimSuperRenormalizableYM

open YangMillsRGBridgeObstruction

/-- Explicit finite-volume gauge-invariant polymer / multi-loop activity family on `GaugeConfig L`
representing the carried non-single-plaquette remainder
`K(V) = ∑ᵢ wᵢ (1 - wilsonLoop V (bases i) (loops i))` generated along multi-step Haar
renormalization-group blocking. Every loop `loops i` is closed
(`pathTarget (bases i) (loops i) = bases i`), so `eval` is strictly invariant under all local
`SU(2)` gauge transformations. -/
structure PolymerActivityFamily (L : ℕ) [NeZero L] where
  idx : Type
  [fintypeIdx : Fintype idx]
  bases : idx → Lattice4D L
  loops : idx → List LatticeStep
  weights : idx → ℝ
  h_closed : ∀ i : idx, pathTarget (bases i) (loops i) = bases i

attribute [instance] PolymerActivityFamily.fintypeIdx

namespace PolymerActivityFamily

/-- Total multi-loop polymer remainder `K(V) = ∑ᵢ wᵢ (1 - wilsonLoop V (bases i) (loops i))`
evaluated on a gauge configuration `V : GaugeConfig L`. -/
noncomputable def eval {L : ℕ} [NeZero L] (P : PolymerActivityFamily L) (V : GaugeConfig L) : ℝ :=
  ∑ i : P.idx, P.weights i * (1 - wilsonLoop V (P.bases i) (P.loops i))

/-- Exact local `SU(2)` gauge invariance of the polymer remainder `P.eval`. -/
theorem eval_gaugeTransform {L : ℕ} [NeZero L] (P : PolymerActivityFamily L)
    (g : GaugeTransformation L) (V : GaugeConfig L) :
    P.eval (gaugeTransform g V) = P.eval V := by
  unfold eval
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [wilsonLoop_gaugeTransform g V (P.h_closed i)]

/-- The empty polymer activity family at the initial UV scale (pure Wilson action with zero
carried remainder). -/
def empty (L : ℕ) [NeZero L] : PolymerActivityFamily L where
  idx := Fin 0
  bases := Fin.elim0
  loops := Fin.elim0
  weights := Fin.elim0
  h_closed := fun i => Fin.elim0 i

@[simp]
theorem eval_empty {L : ℕ} [NeZero L] (V : GaugeConfig L) :
    (empty L).eval V = 0 :=
  Finset.sum_eq_zero fun i _ => Fin.elim0 i

/-- Non-trivial rectangular-loop polymer activity family on `GaugeConfig L` carrying a single closed
`r × t` rectangular loop in the `(μ, ν)` plane at base site `x` with activity weight `w : ℝ`. -/
def singleRectangle (L : ℕ) [NeZero L] (x : Lattice4D L) (μ ν : Direction) (r t : ℕ) (w : ℝ) :
    PolymerActivityFamily L where
  idx := Unit
  bases _ := x
  loops _ := rectangleSteps μ ν r t
  weights _ := w
  h_closed _ := pathTarget_rectangleSteps x μ ν r t

@[simp]
theorem eval_singleRectangle {L : ℕ} [NeZero L] (x : Lattice4D L) (μ ν : Direction) (r t : ℕ)
    (w : ℝ) (V : GaugeConfig L) :
    (singleRectangle L x μ ν r t w).eval V = w * (1 - wilsonLoop V x (rectangleSteps μ ν r t)) := by
  unfold singleRectangle eval
  simp [Finset.univ_unique]

/-- Single-plaquette polymer activity family at plaquette `p : Plaquette L` with weight `w : ℝ`. -/
def singlePlaquette (L : ℕ) [NeZero L] (p : Plaquette L) (w : ℝ) : PolymerActivityFamily L :=
  singleRectangle L p.x p.μ p.ν 1 1 w

theorem eval_singlePlaquette {L : ℕ} [NeZero L] (p : Plaquette L) (w : ℝ) (V : GaugeConfig L) :
    (singlePlaquette L p w).eval V = w * plaquetteAction V p := by
  unfold singlePlaquette
  rw [eval_singleRectangle, wilsonLoop_rectangleSteps_one_one]
  ring

/-- Single-link oscillation bound for `singleRectangle`: updating any single link `e` changes
`(singleRectangle L x μ ν r t w).eval` by at most `2 * |w|`. -/
theorem singleRectangle_oscillation_le {L : ℕ} [NeZero L] (x : Lattice4D L) (μ ν : Direction)
    (r t : ℕ) (w : ℝ) (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2) :
    |(singleRectangle L x μ ν r t w).eval (updateGaugeLink L V e.x e.μ g1) -
      (singleRectangle L x μ ν r t w).eval (updateGaugeLink L V e.x e.μ g2)| ≤ 2 * |w| := by
  rw [eval_singleRectangle, eval_singleRectangle]
  have h1 := halfTraceRe_mem_Icc
    (pathHolonomy (updateGaugeLink L V e.x e.μ g1) x (rectangleSteps μ ν r t))
  have h2 := halfTraceRe_mem_Icc
    (pathHolonomy (updateGaugeLink L V e.x e.μ g2) x (rectangleSteps μ ν r t))
  change _ ∈ Set.Icc (-1 : ℝ) 1 at h1 h2
  have hdiff :
      w * (1 - wilsonLoop (updateGaugeLink L V e.x e.μ g1) x (rectangleSteps μ ν r t)) -
        w * (1 - wilsonLoop (updateGaugeLink L V e.x e.μ g2) x (rectangleSteps μ ν r t)) =
      w * (wilsonLoop (updateGaugeLink L V e.x e.μ g2) x (rectangleSteps μ ν r t) -
        wilsonLoop (updateGaugeLink L V e.x e.μ g1) x (rectangleSteps μ ν r t)) := by
    ring
  rw [hdiff, abs_mul]
  have habs :
      |wilsonLoop (updateGaugeLink L V e.x e.μ g2) x (rectangleSteps μ ν r t) -
        wilsonLoop (updateGaugeLink L V e.x e.μ g1) x (rectangleSteps μ ν r t)| ≤ 2 := by
    rw [abs_le]
    unfold wilsonLoop
    exact ⟨by linarith [h1.2, h2.1], by linarith [h1.1, h2.2]⟩
  nlinarith [abs_nonneg w]

@[continuity, fun_prop]
theorem continuous_eval {L : ℕ} [NeZero L] (P : PolymerActivityFamily L) :
    Continuous P.eval := by
  unfold eval
  refine continuous_finsetSum Finset.univ fun i _ => ?_
  exact continuous_const.mul (continuous_const.sub (continuous_wilsonLoop (P.bases i) (P.loops i)))

theorem abs_eval_le {L : ℕ} [NeZero L] (P : PolymerActivityFamily L) (V : GaugeConfig L) :
    |P.eval V| ≤ ∑ i : P.idx, 2 * |P.weights i| := by
  unfold eval
  calc
    |∑ i : P.idx, P.weights i * (1 - wilsonLoop V (P.bases i) (P.loops i))|
      ≤ ∑ i : P.idx, |P.weights i * (1 - wilsonLoop V (P.bases i) (P.loops i))| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i : P.idx, 2 * |P.weights i| := by
        refine Finset.sum_le_sum fun i _ => ?_
        rw [abs_mul]
        have hw := halfTraceRe_mem_Icc (pathHolonomy V (P.bases i) (P.loops i))
        change _ ∈ Set.Icc (-1 : ℝ) 1 at hw
        have h1 : |1 - wilsonLoop V (P.bases i) (P.loops i)| ≤ 2 := by
          unfold wilsonLoop
          exact abs_le.mpr ⟨by linarith [hw.2], by linarith [hw.1]⟩
        nlinarith [abs_nonneg (P.weights i)]

end PolymerActivityFamily

@[continuity, fun_prop]
theorem continuous_updateGaugeLink_right {L : ℕ} (W : GaugeConfig L)
    (x : Lattice4D L) (μ : Fin 4) :
    Continuous (fun g : SU2 => updateGaugeLink L W x μ g) := by
  apply continuous_pi
  intro f
  by_cases hf : f = ⟨x, μ⟩
  · subst hf
    have h_id : (fun g : SU2 => updateGaugeLink L W x μ g ⟨x, μ⟩) = id := by
      funext g
      exact (updateGaugeLink_same_and_other L W x μ g).1
    rw [h_id]
    exact continuous_id
  · have h_const : (fun g : SU2 => updateGaugeLink L W x μ g f) = fun _ => W f := by
      funext g
      exact (updateGaugeLink_same_and_other L W x μ g).2 f hf
    rw [h_const]
    exact continuous_const

/-- Uniform single-link oscillation and torus-wide pairwise two-link mixed-difference Dobrushin
row-sum bound `≤ η` for a gauge-invariant polymer activity family `P : PolymerActivityFamily L`. -/
def PolymerDobrushinNormBound {L : ℕ} [NeZero L]
    (P : PolymerActivityFamily L) (η : ℝ) : Prop :=
  0 ≤ η ∧
  (∀ (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2),
    |P.eval (updateGaugeLink L V e.x e.μ g1) - P.eval (updateGaugeLink L V e.x e.μ g2)| ≤ η) ∧
  (∃ c_poly : Link L → Link L → ℝ,
    (∀ e e' : Link L, 0 ≤ c_poly e e') ∧
    (∀ (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L P.eval V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ c_poly e e') ∧
    (∀ e : Link L, (∑ e' ∈ (Finset.univ : Finset (Link L)).erase e, c_poly e e') ≤ η))

theorem PolymerDobrushinNormBound.mono {L : ℕ} [NeZero L]
    {P : PolymerActivityFamily L} {η₁ η₂ : ℝ}
    (h : PolymerDobrushinNormBound P η₁) (hle : η₁ ≤ η₂) :
    PolymerDobrushinNormBound P η₂ := by
  rcases h with ⟨h0, h_osc, c_poly, hc_nn, hc_mix, hc_sum⟩
  exact ⟨h0.trans hle, fun V e g1 g2 => (h_osc V e g1 g2).trans hle,
    c_poly, hc_nn, hc_mix, fun e => (hc_sum e).trans hle⟩

/-- Uniform configuration boundedness (ensuring finite-lattice Boltzmann integrability),
joint configuration measurability, and torus-wide pairwise two-link mixed-difference Dobrushin
row-sum bound `≤ ε` for a truncation remainder `R_trunc : GaugeConfig L → ℝ`. -/
def TruncationDobrushinNormBound {L : ℕ} [NeZero L]
    (R_trunc : GaugeConfig L → ℝ) (ε : ℝ) : Prop :=
  (∃ B : ℝ, ∀ V : GaugeConfig L, |R_trunc V| ≤ B) ∧
  Measurable R_trunc ∧
  (∃ c_trunc : Link L → Link L → ℝ,
    (∀ e e' : Link L, 0 ≤ c_trunc e e') ∧
    (∀ (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ c_trunc e e') ∧
    (∀ e : Link L, (∑ e' ∈ (Finset.univ : Finset (Link L)).erase e, c_trunc e e') ≤ ε))

/-- Every `TruncationDobrushinNormBound R_trunc ε` implies `0 ≤ ε`. -/
theorem TruncationDobrushinNormBound.nonneg {L : ℕ} [NeZero L]
    {R_trunc : GaugeConfig L → ℝ} {ε : ℝ}
    (h : TruncationDobrushinNormBound R_trunc ε) : 0 ≤ ε := by
  rcases h with ⟨_, _, c_trunc, hc_nn, _, hc_sum⟩
  let e₀ : Link L := ⟨fun _ => 0, 0⟩
  exact (Finset.sum_nonneg (fun e' _ => hc_nn e₀ e')).trans (hc_sum e₀)

/-- Interacting effective action state on `GaugeConfig L` after dyadic Haar blocking:
carries a vacuum additive normalization `c_vac : ℝ`, a renormalized single-plaquette coupling
`β : ℝ`, a gauge-invariant multi-loop polymer family `polymers : PolymerActivityFamily L`, and a
non-perturbative truncation remainder `R_trunc : GaugeConfig L → ℝ` capturing higher-character and
large-field fluctuation tails beyond the finite single-trace loop span. -/
structure InteractingEffectiveActionState (L : ℕ) [NeZero L] where
  c_vac : ℝ
  β : ℝ
  polymers : PolymerActivityFamily L
  R_trunc : GaugeConfig L → ℝ

namespace InteractingEffectiveActionState

/-- Local Wilson plus multi-loop polymer effective action
`localPolymerAction st V = st.c_vac + wilsonAction st.β V + st.polymers.eval V`
prior to adding the non-perturbative truncation remainder `st.R_trunc V`. -/
noncomputable def localPolymerAction {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) (V : GaugeConfig L) : ℝ :=
  st.c_vac + wilsonAction st.β V + st.polymers.eval V

/-- Full effective action `A(V) = c_vac + wilsonAction β V + polymers.eval V + R_trunc V` on
`GaugeConfig L`. -/
noncomputable def totalAction {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) (V : GaugeConfig L) : ℝ :=
  st.c_vac + wilsonAction st.β V + st.polymers.eval V + st.R_trunc V

theorem totalAction_eq_localPolymerAction_add_R_trunc {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) (V : GaugeConfig L) :
    st.totalAction V = st.localPolymerAction V + st.R_trunc V := rfl

/-- Volume-uniform Dobrushin conditional Gibbs expectation interdependence row-sum and `t`-step
iterated contraction bound for the full blocked effective action
`st.totalAction V = st.c_vac + wilsonAction st.β V + st.polymers.eval V + st.R_trunc V` on
`GaugeConfig L`: whenever `0 ≤ st.β ≤ β_star`, `PolymerDobrushinNormBound st.polymers η_star`,
`TruncationDobrushinNormBound st.R_trunc ε_star`, and
`4 * (18 * (24 * β_star) + η_star + ε_star) < 1`, the torus-wide interdependence row sum of
`groupSingleLinkCondExp SU2 L st.totalAction` is bounded by
`4 * (18 * (24 * β_star) + η_star + ε_star) < 1` at every link `e : Link L`, and its `t`-step
iterated row sum `dobrushinIteratedRowSum` contracts geometrically as
`(4 * (18 * (24 * β_star) + η_star + ε_star)) ^ t`. -/
theorem totalAction_singleLinkCondExp_interdependence_sum_le {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L)
    {β_star η_star ε_star : ℝ}
    (hβ0 : 0 ≤ st.β) (hβ_le : st.β ≤ β_star)
    (_hβ_star : 0 ≤ β_star) (hη_star : 0 ≤ η_star) (hε_star : 0 ≤ ε_star)
    (h_poly : PolymerDobrushinNormBound st.polymers η_star)
    (h_trunc : TruncationDobrushinNormBound st.R_trunc ε_star)
    (h_land : 4 * (18 * (24 * β_star) + η_star + ε_star) < 1)
    (V : GaugeConfig L) (h1 h2 : Link L → SU2) (φ : SU2 → ℝ)
    (hφ_meas : Measurable φ) (hφ_bounds : ∀ g : SU2, 0 ≤ φ g ∧ φ g ≤ 1) :
    (∀ e : Link L,
      (∑ e' : Link L,
        singleLinkCondExpInterdependenceMatrix SU2 L st.totalAction V h1 h2 φ e e') ≤
        4 * (18 * (24 * β_star) + η_star + ε_star) ∧
      (∑ e' : Link L,
        singleLinkCondExpInterdependenceMatrix SU2 L st.totalAction V h1 h2 φ e e') < 1) ∧
    (∀ (t : ℕ) (e : Link L),
      0 ≤ dobrushinIteratedRowSum
        (singleLinkCondExpInterdependenceMatrix SU2 L st.totalAction V h1 h2 φ) t e ∧
      dobrushinIteratedRowSum
        (singleLinkCondExpInterdependenceMatrix SU2 L st.totalAction V h1 h2 φ) t e ≤
        (4 * (18 * (24 * β_star) + η_star + ε_star)) ^ t) := by
  classical
  obtain ⟨c_poly, hc_poly_nonneg, hc_poly_mix, hc_poly_sum⟩ := h_poly.2.2
  obtain ⟨⟨B_R, hR_bdd⟩, hR_meas, c_trunc, hc_trunc_nonneg, hc_trunc_mix, hc_trunc_sum⟩ := h_trunc
  let B : ℝ :=
    |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
      (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|) + B_R
  have h_act_bdd (U : GaugeConfig L) : |st.totalAction U| ≤ B := by
    have hW_nonneg : 0 ≤ wilsonAction st.β U := wilsonAction_nonneg hβ0 U
    have hW_le : wilsonAction st.β U ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
      unfold wilsonAction
      exact mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun p _ => plaquetteAction_le_two U p) hβ0
    have hW_abs : |wilsonAction st.β U| ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
      rw [abs_of_nonneg hW_nonneg]
      exact hW_le
    have hP_abs := st.polymers.abs_eval_le U
    have hR_abs := hR_bdd U
    unfold totalAction
    have h1_tri := abs_add_le (st.c_vac + wilsonAction st.β U + st.polymers.eval U) (st.R_trunc U)
    have h2_tri := abs_add_le (st.c_vac + wilsonAction st.β U) (st.polymers.eval U)
    have h3_tri := abs_add_le st.c_vac (wilsonAction st.β U)
    dsimp [B]
    linarith
  have h_row (e : Link L) :
      (∑ e' : Link L,
        singleLinkCondExpInterdependenceMatrix SU2 L st.totalAction V h1 h2 φ e e') ≤
        4 * (18 * (24 * β_star) + η_star + ε_star) ∧
      (∑ e' : Link L,
        singleLinkCondExpInterdependenceMatrix SU2 L st.totalAction V h1 h2 φ e e') < 1 := by
    let Δ : Link L → ℝ := fun e' =>
      (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0) + c_poly e e' + c_trunc e e'
    have hS_meas (W : GaugeConfig L) :
        Measurable (fun g : SU2 => st.totalAction (updateGroupGaugeLink L W e.x e.μ g)) := by
      have h_loc_cont : Continuous st.localPolymerAction := by
        unfold localPolymerAction
        exact (continuous_const.add (continuous_wilsonAction st.β)).add st.polymers.continuous_eval
      have h_loc_meas :
