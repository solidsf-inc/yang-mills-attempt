  rw [h_a2]
  refine integral_mul_finsetSum_plaquette_eq_zero S₃ _
    ((((hH_cont.mul (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁))).mul
      (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
      (continuous_restTouchCharacterSum.sub continuous_lateralCharacterSum)).mul (hb.mul ht))
    (fun q₃ hq₃ => ?_)
  have h_a3 : (fun U => (H U * halfTraceRe (plaquetteHolonomy U q₁) * halfTraceRe (plaquetteHolonomy U q₂) *
        (restTouchCharacterSum U - lateralCharacterSum U) *
