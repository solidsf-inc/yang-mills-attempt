theorem balabanOneLoopDriftChain_state_uv_beta_eq (n : ℕ) :
    ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
      (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state n).β =
      (n : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) := by
  change (scheduledHaarRGState (2 ^ n) n (dyadicOneLoopPath.coupling n) (balabanOneLoopDriftSchedule n) n).β = _
  simp only [scheduledHaarRGState, le_rfl, ↓reduceIte, Nat.sub_self, scheduledHaarRGStateAux,
    dyadicOneLoopPath, InteractingEffectiveActionState.pureWilson]
