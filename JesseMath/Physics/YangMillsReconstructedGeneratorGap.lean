        ih (fun m hm => hstep m (Nat.lt_succ_of_lt hm))
      have hk : |C k - C (k + 1)| ≤ δ k := hstep k (Nat.lt_succ_self k)
      have htri : |C 0 - C (k + 1)| ≤ |C 0 - C k| + |C k - C (k + 1)| := by
        simpa [sub_add_sub_cancel] using abs_add_le (C 0 - C k) (C k - C (k + 1))
      rw [Finset.sum_range_succ]
      linarith
  refine ⟨htel, ?_⟩
  have hrev : |C K| - |C 0| ≤ |C 0 - C K| := by
