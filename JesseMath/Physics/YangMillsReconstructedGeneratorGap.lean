theorem totalCharacterSum_eq_probeTouch_add_probeExterior {L : ℕ} [NeZero L] (U : GaugeConfig L) :
    totalCharacterSum U = probeTouchCharacterSum U + probeExteriorCharacterSum U := by
  unfold totalCharacterSum probeTouchCharacterSum probeExteriorCharacterSum
  rw [← union_probeTouchPlaquettes_probeExteriorPlaquettes L,
      Finset.sum_union (disjoint_probeTouchPlaquettes_probeExteriorPlaquettes L)]

theorem probeExteriorCharacterSum_update_of_mem_probeLinks {L : ℕ} [NeZero L]
    (U : GaugeConfig L) {e : Link L} (he : e ∈ probeLinks L) (g : SU2) :
    probeExteriorCharacterSum (updateGaugeLink L U e.x e.μ g) = probeExteriorCharacterSum U := by
  unfold probeExteriorCharacterSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q
      (not_mem_plaquetteLinks_of_mem_probeExteriorPlaquettes hq he) g]

theorem probeExteriorCharacterSum_twistLinkNegOne_of_mem_probeLinks {L : ℕ} [NeZero L]
    (U : GaugeConfig L) {e : Link L} (he : e ∈ probeLinks L) :
    probeExteriorCharacterSum (twistLinkNegOne e U) = probeExteriorCharacterSum U := by
  unfold probeExteriorCharacterSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U q
      (not_mem_plaquetteLinks_of_mem_probeExteriorPlaquettes hq he)]

theorem abs_probeTouchCharacterSum_le_forty_eight {L : ℕ} [NeZero L] (U : GaugeConfig L) :
    |probeTouchCharacterSum U| ≤ 48 := by
  unfold probeTouchCharacterSum
  have h_card : ((probeTouchPlaquettes L).card : ℝ) ≤ 48 := by
    exact_mod_cast card_probeTouchPlaquettes_le_forty_eight L
  calc
    |∑ q ∈ probeTouchPlaquettes L, halfTraceRe (plaquetteHolonomy U q)|
