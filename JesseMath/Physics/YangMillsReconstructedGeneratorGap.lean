    wilsonProbeCov L β ≤ ((5 / 4 : ℝ) * (1 / 4 : ℝ) ^ 5) * β ^ 4 :=
  ⟨wilsonProbeCov_lower_bound_of_clusterRemainder L β (hR L hL β hβ hβ₀),
   wilsonProbeCov_upper_bound_of_clusterRemainder L β (hR L hL β hβ hβ₀)⟩

