theorem FABLE51_SET1_R2_R4_iter_step_decay {f : ℝ → ℝ} {s ρ : ℝ} (hρ : 0 ≤ ρ)
    (hstep : ∀ t, 0 ≤ t → f (t + s) ≤ ρ * f t) (hs : 0 ≤ s) :
    ∀ (k : ℕ) (t : ℝ), 0 ≤ t → f (t + k * s) ≤ ρ ^ k * f t := by
  intro k
  induction k with
  | zero => intro t _; simp
  | succ k ih =>
    intro t ht
    have hts : 0 ≤ t + k * s := add_nonneg ht (mul_nonneg (Nat.cast_nonneg k) hs)
    have harg : t + ((k : ℝ) + 1) * s = (t + k * s) + s := by ring
    push_cast
    rw [harg]
    calc f ((t + k * s) + s) ≤ ρ * f (t + k * s) := hstep _ hts
      _ ≤ ρ * (ρ ^ k * f t) := mul_le_mul_of_nonneg_left (ih t ht) hρ
      _ = ρ ^ (k + 1) * f t := by ring

