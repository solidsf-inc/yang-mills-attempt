      (m : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) + (canonicalCrossoverBetaLo : ℝ) := by
  obtain ⟨j, hj⟩ : ∃ j, n - m = j + 1 := Nat.exists_eq_succ_of_ne_zero (by omega)
  have hm_le : m ≤ n := Nat.le_of_lt hm
  have hsub : n - (j + 1) = m := by omega
  change (scheduledHaarRGState (2 ^ n) n (dyadicOneLoopPath.coupling n) (balabanOneLoopDriftSchedule n) m).β = _
  simp only [scheduledHaarRGState, hm_le, ↓reduceIte, hj, scheduledHaarRGStateAux,
