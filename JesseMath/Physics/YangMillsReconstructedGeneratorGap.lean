/-- Single-plaquette `SU(2)` Haar character partition `∫ g, exp (β * halfTraceRe g) ∂SU2.haarProbability`. -/
noncomputable def su2CharExp0 (β : ℝ) : ℝ :=
  ∫ g : SU2, Real.exp (β * halfTraceRe g) ∂SU2.haarProbability

/-- Single-plaquette `SU(2)` Haar first character moment `∫ g, halfTraceRe g * exp (β * halfTraceRe g) ∂SU2.haarProbability`. -/
noncomputable def su2CharExp1 (β : ℝ) : ℝ :=
  ∫ g : SU2, halfTraceRe g * Real.exp (β * halfTraceRe g) ∂SU2.haarProbability

/-- Single-plaquette centered character mean `su2CharExp1 β / su2CharExp0 β`. -/
noncomputable def su2CharMean (β : ℝ) : ℝ :=
  su2CharExp1 β / su2CharExp0 β

theorem one_le_su2CharExp0 (β : ℝ) : 1 ≤ su2CharExp0 β := by
  unfold su2CharExp0
  have h_int1 : Integrable (fun g : SU2 => 1 + β * halfTraceRe g) SU2.haarProbability := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_int2 : Integrable (fun g : SU2 => Real.exp (β * halfTraceRe g)) SU2.haarProbability := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_mono :
      (∫ g : SU2, (1 + β * halfTraceRe g) ∂SU2.haarProbability) ≤
        ∫ g : SU2, Real.exp (β * halfTraceRe g) ∂SU2.haarProbability := by
    refine integral_mono h_int1 h_int2 (fun g => ?_)
    have := Real.add_one_le_exp (β * halfTraceRe g)
    linarith
  have h_int_lin : Integrable (fun g : SU2 => β * halfTraceRe g) SU2.haarProbability := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_eval : (∫ g : SU2, (1 + β * halfTraceRe g) ∂SU2.haarProbability) = 1 := by
    rw [integral_add (integrable_const 1) h_int_lin, integral_const, probReal_univ, one_smul,
        integral_const_mul, integral_halfTraceRe_eq_zero, mul_zero, add_zero]
  linarith

theorem abs_su2CharExp1_and_su2CharMean_le
    {β : ℝ} (hβ0 : 0 ≤ β) (hβ1 : β ≤ 1) :
    |su2CharExp1 β| ≤ (7 / 4 : ℝ) * β ∧ |su2CharMean β| ≤ (7 / 4 : ℝ) * β := by
  have h0_ge := one_le_su2CharExp0 β
  have h0_pos : 0 < su2CharExp0 β := lt_of_lt_of_le one_pos h0_ge
  have h_int_a : Integrable (fun g : SU2 => halfTraceRe g * Real.exp (β * halfTraceRe g)) SU2.haarProbability := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_int_b : Integrable (fun g : SU2 => halfTraceRe g) SU2.haarProbability :=
    continuous_halfTraceRe.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_int_abs :
      Integrable (fun g : SU2 => |halfTraceRe g * (Real.exp (β * halfTraceRe g) - 1)|) SU2.haarProbability := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_eq :
      su2CharExp1 β =
        ∫ g : SU2, halfTraceRe g * (Real.exp (β * halfTraceRe g) - 1) ∂SU2.haarProbability := by
    unfold su2CharExp1
    have h_sub :
        (fun g : SU2 => halfTraceRe g * (Real.exp (β * halfTraceRe g) - 1)) =
          fun g : SU2 => halfTraceRe g * Real.exp (β * halfTraceRe g) - halfTraceRe g := by
      funext g; ring
    rw [h_sub, integral_sub h_int_a h_int_b, integral_halfTraceRe_eq_zero, sub_zero]
  have h_pt (g : SU2) :
      |halfTraceRe g * (Real.exp (β * halfTraceRe g) - 1)| ≤ (7 / 4 : ℝ) * β := by
    rw [abs_mul]
    have hg := abs_halfTraceRe_le_one g
    have hu : |β * halfTraceRe g| ≤ β := by
      rw [abs_mul, abs_of_nonneg hβ0]
      nlinarith
    have hu1 : |β * halfTraceRe g| ≤ 1 := hu.trans hβ1
    have heb := abs_exp_sub_one_le_of_abs_le_one hu1
    have hsq : (β * halfTraceRe g) ^ 2 ≤ β ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    have h_exp_le : |Real.exp (β * halfTraceRe g) - 1| ≤ (7 / 4 : ℝ) * β := by nlinarith
    calc
      |halfTraceRe g| * |Real.exp (β * halfTraceRe g) - 1|
        ≤ 1 * ((7 / 4 : ℝ) * β) := mul_le_mul hg h_exp_le (abs_nonneg _) zero_le_one
      _ = (7 / 4 : ℝ) * β := one_mul _
  have h1 : |su2CharExp1 β| ≤ (7 / 4 : ℝ) * β := by
    rw [h_eq]
    calc
      |∫ g : SU2, halfTraceRe g * (Real.exp (β * halfTraceRe g) - 1) ∂SU2.haarProbability|
        ≤ ∫ g : SU2, |halfTraceRe g * (Real.exp (β * halfTraceRe g) - 1)| ∂SU2.haarProbability :=
          abs_integral_le_integral_abs
      _ ≤ ∫ _g : SU2, ((7 / 4 : ℝ) * β) ∂SU2.haarProbability :=
          integral_mono h_int_abs (integrable_const _) h_pt
      _ = (7 / 4 : ℝ) * β := by rw [integral_const, probReal_univ, one_smul]
  refine ⟨h1, ?_⟩
  unfold su2CharMean
  rw [abs_div, abs_of_pos h0_pos, div_le_iff₀ h0_pos]
  nlinarith [abs_nonneg (su2CharExp1 β)]

theorem integral_comp_halfTraceRe_mul_left (A : SU2) (ψ : ℝ → ℝ) (hψ : Continuous ψ) :
    (∫ g : SU2, ψ (halfTraceRe (A * g)) ∂SU2.haarProbability) =
      ∫ g : SU2, ψ (halfTraceRe g) ∂SU2.haarProbability := by
  have hmp : MeasurePreserving (fun g : SU2 => A * g)
      (SU2.haarProbability : Measure SU2) (SU2.haarProbability : Measure SU2) :=
    measurePreserving_mul_left (SU2.haarProbability : Measure SU2) A
  symm
  conv_lhs => rw [← hmp.map_eq]
  exact integral_map (continuous_const.mul continuous_id).aemeasurable
    (hψ.comp continuous_halfTraceRe).aestronglyMeasurable

theorem integral_comp_plaquetteHolonomy_update_eq_of_mem_plaquetteLinks
    {L : ℕ} (hL : 2 ≤ L) (U : GaugeConfig L) (p : Plaquette L)
    {e : Link L} (he : e ∈ plaquetteLinks p) (ψ : ℝ → ℝ) (hψ : Continuous ψ) :
    (∫ g : SU2, ψ (halfTraceRe (plaquetteHolonomy (updateGaugeLink L U e.x e.μ g) p))
      ∂SU2.haarProbability) =
      ∫ g : SU2, ψ (halfTraceRe g) ∂SU2.haarProbability := by
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  rcases he with rfl | rfl | rfl | rfl
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_first hL U p]
    exact integral_comp_halfTraceRe_mul_left _ ψ hψ
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_second hL U p]
    exact integral_comp_halfTraceRe_mul_left _ ψ hψ
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_third hL U p]
    exact integral_comp_halfTraceRe_mul_left _ ψ hψ
  · simp_rw [halfTraceRe_plaquetteHolonomy_update_fourth hL U p]
    exact integral_comp_halfTraceRe_mul_left _ ψ hψ

theorem integral_centeredPlaquetteFactor_haarProbability (β : ℝ) :
    (∫ g : SU2, (halfTraceRe g - su2CharMean β) * Real.exp (β * halfTraceRe g)
      ∂SU2.haarProbability) = 0 := by
  have h0_pos : 0 < su2CharExp0 β := lt_of_lt_of_le one_pos (one_le_su2CharExp0 β)
  have h_int1 : Integrable (fun g : SU2 => halfTraceRe g * Real.exp (β * halfTraceRe g)) SU2.haarProbability := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_int0 : Integrable (fun g : SU2 => su2CharMean β * Real.exp (β * halfTraceRe g)) SU2.haarProbability := by
    refine Continuous.integrable_of_hasCompactSupport ?_ (HasCompactSupport.of_compactSpace _)
    fun_prop
  have h_sub :
      (fun g : SU2 => (halfTraceRe g - su2CharMean β) * Real.exp (β * halfTraceRe g)) =
        fun g : SU2 => halfTraceRe g * Real.exp (β * halfTraceRe g) -
          su2CharMean β * Real.exp (β * halfTraceRe g) := by
    funext g; ring
  rw [h_sub, integral_sub h_int1 h_int0, integral_const_mul]
  change su2CharExp1 β - su2CharMean β * su2CharExp0 β = 0
  unfold su2CharMean
  rw [div_mul_cancel₀ _ (ne_of_gt h0_pos), sub_self]

theorem integral_gaugeHaarMeasure_mul_centeredPlaquetteFactor_eq_zero_of_mem_plaquetteLinks
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) (p : Plaquette L)
    (e : Link L) (he : e ∈ plaquetteLinks p)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_inv : ∀ (U : GaugeConfig L) (g : SU2), H (updateGaugeLink L U e.x e.μ g) = H U) :
    (∫ U : GaugeConfig L,
      H U * ((halfTraceRe (plaquetteHolonomy U p) - su2CharMean β) *
        Real.exp (β * halfTraceRe (plaquetteHolonomy U p)))
      ∂(gaugeHaarMeasure L)) = 0 := by
  let ψ (s : ℝ) : ℝ := (s - su2CharMean β) * Real.exp (β * s)
  have hψ : Continuous ψ := by dsimp [ψ]; fun_prop
  have hp : Continuous (fun U : GaugeConfig L => ψ (halfTraceRe (plaquetteHolonomy U p))) :=
    hψ.comp (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy p))
  rw [integral_gaugeHaarMeasure_mul_eq_of_updateGaugeLink_eq e
        (F := fun U => ψ (halfTraceRe (plaquetteHolonomy U p)))
        (G := fun _ => 0) hH_cont hp hH_inv]
  · simp
  · intro U
    rw [integral_comp_plaquetteHolonomy_update_eq_of_mem_plaquetteLinks hL U p he ψ hψ]
    exact integral_centeredPlaquetteFactor_haarProbability β

theorem integral_gaugeHaarMeasure_add_of_continuous
    {L : ℕ} [NeZero L] (f g : GaugeConfig L → ℝ) (hf : Continuous f) (hg : Continuous g) :
    (∫ U : GaugeConfig L, (f U + g U) ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, f U ∂(gaugeHaarMeasure L)) +
        ∫ U : GaugeConfig L, g U ∂(gaugeHaarMeasure L) :=
  integral_add
    (hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
    (hg.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))

theorem integral_gaugeHaarMeasure_sub_of_continuous
    {L : ℕ} [NeZero L] (f g : GaugeConfig L → ℝ) (hf : Continuous f) (hg : Continuous g) :
    (∫ U : GaugeConfig L, (f U - g U) ∂(gaugeHaarMeasure L)) =
      (∫ U : GaugeConfig L, f U ∂(gaugeHaarMeasure L)) -
        ∫ U : GaugeConfig L, g U ∂(gaugeHaarMeasure L) :=
  integral_sub
    (hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
    (hg.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))

theorem wilsonProbeCov_eq_centered_probe_cov
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ : 0 ≤ β) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    let c : ℝ := su2CharMean β
    wilsonProbeCov L β =
      (∫ U : GaugeConfig L, characterBoltzmannWeight β U * ((b U - c) * (t U - c)) ∂(gaugeHaarMeasure L)) /
        characterPartition L β -
      ((∫ U : GaugeConfig L, characterBoltzmannWeight β U * (b U - c) ∂(gaugeHaarMeasure L)) /
        characterPartition L β) *
      ((∫ U : GaugeConfig L, characterBoltzmannWeight β U * (t U - c) ∂(gaugeHaarMeasure L)) /
        characterPartition L β) := by
  intro b t c
  have hZ_pos : 0 < characterPartition L β := characterPartition_pos hL β
  have hZ_ne : characterPartition L β ≠ 0 := ne_of_gt hZ_pos
  have hb_cont : Continuous b := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht_cont : Continuous t := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  have hw_cont : Continuous (characterBoltzmannWeight (L := L) β) := continuous_characterBoltzmannWeight β
  have h_cov := (wilsonProbeCov_eq_iterated_replica_div_characterPartition_sq hL hβ).1
  have hfΘ_eq (U : GaugeConfig L) :
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U = b U :=
    physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U
  have hfp_eq (U : GaugeConfig L) :
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U = t U :=
    physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U
  simp_rw [hfΘ_eq, hfp_eq] at h_cov
  rw [h_cov]
  have h_b :
      (∫ U, characterBoltzmannWeight β U * (b U - c) ∂(gaugeHaarMeasure L)) =
        (∫ U, characterBoltzmannWeight β U * b U ∂(gaugeHaarMeasure L)) -
          c * characterPartition L β := by
    have h_pt : (fun U => characterBoltzmannWeight β U * (b U - c)) =
        fun U => characterBoltzmannWeight β U * b U - c * characterBoltzmannWeight β U := by
      funext U; ring
    rw [h_pt,
        integral_gaugeHaarMeasure_sub_of_continuous (fun U => characterBoltzmannWeight β U * b U)
          (fun U => c * characterBoltzmannWeight β U)
          (hw_cont.mul hb_cont) (continuous_const.mul hw_cont),
        integral_const_mul]
    rfl
  have h_t :
      (∫ U, characterBoltzmannWeight β U * (t U - c) ∂(gaugeHaarMeasure L)) =
        (∫ U, characterBoltzmannWeight β U * t U ∂(gaugeHaarMeasure L)) -
          c * characterPartition L β := by
    have h_pt : (fun U => characterBoltzmannWeight β U * (t U - c)) =
        fun U => characterBoltzmannWeight β U * t U - c * characterBoltzmannWeight β U := by
      funext U; ring
    rw [h_pt,
        integral_gaugeHaarMeasure_sub_of_continuous (fun U => characterBoltzmannWeight β U * t U)
          (fun U => c * characterBoltzmannWeight β U)
          (hw_cont.mul ht_cont) (continuous_const.mul hw_cont),
        integral_const_mul]
    rfl
  have h_bt :
      (∫ U, characterBoltzmannWeight β U * ((b U - c) * (t U - c)) ∂(gaugeHaarMeasure L)) =
        (∫ U, characterBoltzmannWeight β U * (b U * t U) ∂(gaugeHaarMeasure L)) -
          c * (∫ U, characterBoltzmannWeight β U * b U ∂(gaugeHaarMeasure L)) -
          c * (∫ U, characterBoltzmannWeight β U * t U ∂(gaugeHaarMeasure L)) +
          c * c * characterPartition L β := by
    have h_pt : (fun U => characterBoltzmannWeight β U * ((b U - c) * (t U - c))) =
        fun U =>
          ((characterBoltzmannWeight β U * (b U * t U) -
              c * (characterBoltzmannWeight β U * b U)) -
            c * (characterBoltzmannWeight β U * t U)) +
          (c * c) * characterBoltzmannWeight β U := by
      funext U; ring
    rw [h_pt,
        integral_gaugeHaarMeasure_add_of_continuous
          (fun U => (characterBoltzmannWeight β U * (b U * t U) -
            c * (characterBoltzmannWeight β U * b U)) -
            c * (characterBoltzmannWeight β U * t U))
          (fun U => (c * c) * characterBoltzmannWeight β U)
          (((hw_cont.mul (hb_cont.mul ht_cont)).sub (continuous_const.mul (hw_cont.mul hb_cont))).sub
            (continuous_const.mul (hw_cont.mul ht_cont)))
          (continuous_const.mul hw_cont),
        integral_gaugeHaarMeasure_sub_of_continuous
          (fun U => characterBoltzmannWeight β U * (b U * t U) -
            c * (characterBoltzmannWeight β U * b U))
          (fun U => c * (characterBoltzmannWeight β U * t U))
          ((hw_cont.mul (hb_cont.mul ht_cont)).sub (continuous_const.mul (hw_cont.mul hb_cont)))
          (continuous_const.mul (hw_cont.mul ht_cont)),
        integral_gaugeHaarMeasure_sub_of_continuous
          (fun U => characterBoltzmannWeight β U * (b U * t U))
          (fun U => c * (characterBoltzmannWeight β U * b U))
          (hw_cont.mul (hb_cont.mul ht_cont))
          (continuous_const.mul (hw_cont.mul hb_cont)),
        integral_const_mul, integral_const_mul, integral_const_mul]
    rfl
  rw [h_bt, h_b, h_t]
  field_simp [hZ_ne]
  ring

/-! #### Chunk 4: Single-Probe Disconnected Bounds and Bridge Factor `sideBridge` Reduction -/

theorem integral_mul_centeredPlaquetteFactor_add_one_eq
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) (β : ℝ) (p : Plaquette L)
    (e : Link L) (he : e ∈ plaquetteLinks p)
    (H D : GaugeConfig L → ℝ) (hH_cont : Continuous H) (hD_cont : Continuous D)
    (hH_inv : ∀ (U : GaugeConfig L) (g : SU2), H (updateGaugeLink L U e.x e.μ g) = H U) :
    (∫ U : GaugeConfig L,
      H U * (D U + 1) * ((halfTraceRe (plaquetteHolonomy U p) - su2CharMean β) *
        Real.exp (β * halfTraceRe (plaquetteHolonomy U p)))
      ∂(gaugeHaarMeasure L)) =
    ∫ U : GaugeConfig L,
      H U * D U * ((halfTraceRe (plaquetteHolonomy U p) - su2CharMean β) *
        Real.exp (β * halfTraceRe (plaquetteHolonomy U p)))
      ∂(gaugeHaarMeasure L) := by
  let Φ (U : GaugeConfig L) : ℝ :=
    (halfTraceRe (plaquetteHolonomy U p) - su2CharMean β) *
      Real.exp (β * halfTraceRe (plaquetteHolonomy U p))
  have hΦ_cont : Continuous Φ := by dsimp [Φ]; fun_prop
  have h_pt : (fun U => H U * (D U + 1) * Φ U) = fun U => H U * D U * Φ U + H U * Φ U := by
    funext U; ring
  have h_zero : (∫ U, H U * Φ U ∂(gaugeHaarMeasure L)) = 0 :=
    integral_gaugeHaarMeasure_mul_centeredPlaquetteFactor_eq_zero_of_mem_plaquetteLinks
      hL β p e he H hH_cont hH_inv
  change (∫ U, H U * (D U + 1) * Φ U ∂(gaugeHaarMeasure L)) =
    ∫ U, H U * D U * Φ U ∂(gaugeHaarMeasure L)
  rw [h_pt, integral_gaugeHaarMeasure_add_of_continuous (fun U => H U * D U * Φ U) (fun U => H U * Φ U)
      ((hH_cont.mul hD_cont).mul hΦ_cont) (hH_cont.mul hΦ_cont),
      h_zero, add_zero]

lemma exp_probeTouch_split_top
    (β w b t x0 x1 x2 x3 yb0 yb1 yb2 yb3 yt0 yt1 yt2 yt3 φ : ℝ) :
    Real.exp (β * (b + t + ((x0 + yb0 + yt0) + (x1 + yb1 + yt1) + (x2 + yb2 + yt2) + (x3 + yb3 + yt3)))) * w * φ =
      (w * Real.exp (β * (b + (yb0 + yb1 + yb2 + yb3)))) *
        (Real.exp (β * (x0 + yt0)) - 1 + 1) * (Real.exp (β * (x1 + yt1)) - 1 + 1) *
        (Real.exp (β * (x2 + yt2)) - 1 + 1) * (Real.exp (β * (x3 + yt3)) - 1 + 1) *
        (φ * Real.exp (β * t)) := by
  simp only [sub_add_cancel]
  have h_arg :
      β * (b + t + ((x0 + yb0 + yt0) + (x1 + yb1 + yt1) + (x2 + yb2 + yt2) + (x3 + yb3 + yt3))) =
        β * (b + (yb0 + yb1 + yb2 + yb3)) + β * (x0 + yt0) + β * (x1 + yt1) +
          β * (x2 + yt2) + β * (x3 + yt3) + β * t := by ring
  rw [h_arg, Real.exp_add, Real.exp_add, Real.exp_add, Real.exp_add, Real.exp_add]
  ring

lemma exp_probeTouch_split_bot
    (β w b t x0 x1 x2 x3 yb0 yb1 yb2 yb3 yt0 yt1 yt2 yt3 φ : ℝ) :
    Real.exp (β * (b + t + ((x0 + yb0 + yt0) + (x1 + yb1 + yt1) + (x2 + yb2 + yt2) + (x3 + yb3 + yt3)))) * w * φ =
      (w * Real.exp (β * (t + (yt0 + yt1 + yt2 + yt3)))) *
        (Real.exp (β * (x0 + yb0)) - 1 + 1) * (Real.exp (β * (x1 + yb1)) - 1 + 1) *
        (Real.exp (β * (x2 + yb2)) - 1 + 1) * (Real.exp (β * (x3 + yb3)) - 1 + 1) *
        (φ * Real.exp (β * b)) := by
  simp only [sub_add_cancel]
  have h_arg :
      β * (b + t + ((x0 + yb0 + yt0) + (x1 + yb1 + yt1) + (x2 + yb2 + yt2) + (x3 + yb3 + yt3))) =
        β * (t + (yt0 + yt1 + yt2 + yt3)) + β * (x0 + yb0) + β * (x1 + yb1) +
          β * (x2 + yb2) + β * (x3 + yb3) + β * b := by ring
  rw [h_arg, Real.exp_add, Real.exp_add, Real.exp_add, Real.exp_add, Real.exp_add]
  ring

lemma exp_probeTouch_split_both
    (β w b t x0 x1 x2 x3 yb0 yb1 yb2 yb3 yt0 yt1 yt2 yt3 φB φT : ℝ) :
    Real.exp (β * (b + t + ((x0 + yb0 + yt0) + (x1 + yb1 + yt1) + (x2 + yb2 + yt2) + (x3 + yb3 + yt3)))) *
        w * (φB * φT) =
      w * Real.exp (β * (x0 + yb0 + yt0)) * Real.exp (β * (x1 + yb1 + yt1)) *
        Real.exp (β * (x2 + yb2 + yt2)) * Real.exp (β * (x3 + yb3 + yt3)) *
        (φB * Real.exp (β * b)) * (φT * Real.exp (β * t)) := by
  have h_arg :
      β * (b + t + ((x0 + yb0 + yt0) + (x1 + yb1 + yt1) + (x2 + yb2 + yt2) + (x3 + yb3 + yt3))) =
        β * (x0 + yb0 + yt0) + β * (x1 + yb1 + yt1) + β * (x2 + yb2 + yt2) +
          β * (x3 + yb3 + yt3) + β * b + β * t := by ring
  rw [h_arg, Real.exp_add, Real.exp_add, Real.exp_add, Real.exp_add, Real.exp_add]
  ring

theorem abs_centeredSingleProbe_expectations_le
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) {β : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    let c : ℝ := su2CharMean β
    |(∫ U, characterBoltzmannWeight β U * (t U - c) ∂(gaugeHaarMeasure L)) / characterPartition L β| ≤
      10368 * β ^ 4 ∧
    |(∫ U, characterBoltzmannWeight β U * (b U - c) ∂(gaugeHaarMeasure L)) / characterPartition L β| ≤
      10368 * β ^ 4 := by
  intro b t c
  have hL2 : 2 ≤ L := by omega
  have hβ1 : β ≤ 1 := by linarith
  have hc_le : |c| ≤ (7 / 4 : ℝ) * β := (abs_su2CharExp1_and_su2CharMean_le hβ0 hβ1).2
  have hZ_pos : 0 < characterPartition L β := characterPartition_pos hL2 β
  have h_ratio := (probeExteriorPartition_div_characterPartition_le_and_abs_sub_one_le hL2 hβ0 hβ_hi).1
  have h_ext_nonneg : 0 ≤ probeExteriorPartition L β :=
    integral_nonneg (fun _ => (Real.exp_pos _).le)
  -- Top probe bound
  let M_top (U : GaugeConfig L) : ℝ :=
    probeExteriorBoltzmannWeight β U *
      Real.exp (β * (b U + ∑ k : Fin 4, botWingCharSum L k U))
  let D_top (k : Fin 4) (U : GaugeConfig L) : ℝ :=
    Real.exp (β * (latChar L k U + topWingCharSum L k U)) - 1
  let Φ_T (U : GaugeConfig L) : ℝ := (t U - c) * Real.exp (β * t U)
  have hM_top_cont : Continuous M_top := by dsimp [M_top, b]; fun_prop
  have hD_top_cont (k : Fin 4) : Continuous (D_top k) := by dsimp [D_top]; fun_prop
  have hΦ_T_cont : Continuous Φ_T := by dsimp [Φ_T, t]; fun_prop
  have hM_top_inv (k : Fin 4) (U : GaugeConfig L) (g : SU2) :
      M_top (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k).x
        (plaquetteLinkAt (cubeTopPlaquette L) k).μ g) = M_top U := by
    have h_sum :
        (∑ j : Fin 4, botWingCharSum L j
          (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k).x
            (plaquetteLinkAt (cubeTopPlaquette L) k).μ g)) =
        ∑ j : Fin 4, botWingCharSum L j U :=
      Finset.sum_congr rfl fun j _ => botWingCharSum_update_top hL k j U g
    dsimp [M_top, b]
    rw [probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U
          (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L k) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)) g,
        h_sum]
  have hD_top_inv {k' k : Fin 4} (hne : k' ≠ k) (U : GaugeConfig L) (g : SU2) :
      D_top k (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k').x
        (plaquetteLinkAt (cubeTopPlaquette L) k').μ g) = D_top k U := by
    dsimp [D_top]
    rw [latChar_update_top_of_ne hL hne U g, topWingCharSum_update_top_of_ne hL hne U g]
  have h_top_fact (U : GaugeConfig L) :
      characterBoltzmannWeight β U * (t U - c) =
        M_top U * (D_top 0 U + 1) * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U := by
    rw [characterBoltzmannWeight_eq_exp_probeTouch_mul_probeExteriorBoltzmannWeight,
        probeTouchCharacterSum_eq_probes_add_sum_four hL U, Fin.sum_univ_four]
    dsimp [M_top, D_top, Φ_T]
    rw [Fin.sum_univ_four]
    exact exp_probeTouch_split_top β (probeExteriorBoltzmannWeight β U) (b U) (t U)
      (latChar L 0 U) (latChar L 1 U) (latChar L 2 U) (latChar L 3 U)
      (botWingCharSum L 0 U) (botWingCharSum L 1 U) (botWingCharSum L 2 U) (botWingCharSum L 3 U)
      (topWingCharSum L 0 U) (topWingCharSum L 1 U) (topWingCharSum L 2 U) (topWingCharSum L 3 U)
      (t U - c)
  have h_top_red :
      (∫ U, characterBoltzmannWeight β U * (t U - c) ∂(gaugeHaarMeasure L)) =
        ∫ U, M_top U * D_top 0 U * D_top 1 U * D_top 2 U * D_top 3 U * Φ_T U ∂(gaugeHaarMeasure L) := by
    simp_rw [h_top_fact]
    have h0 :
        (∫ U, M_top U * (D_top 0 U + 1) * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_top U * D_top 0 U * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U ∂(gaugeHaarMeasure L) := by
      have h_assoc1 :
          (fun U => M_top U * (D_top 0 U + 1) * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U) =
            fun U => (M_top U * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1)) * (D_top 0 U + 1) * Φ_T U := by
        funext U; ring
      have h_assoc2 :
          (fun U => M_top U * D_top 0 U * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U) =
            fun U => (M_top U * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1)) * D_top 0 U * Φ_T U := by
        funext U; ring
      rw [h_assoc1, h_assoc2]
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeTopPlaquette L)
        (plaquetteLinkAt (cubeTopPlaquette L) 0) (plaquetteLinkAt_mem_plaquetteLinks _ 0)
        _ (D_top 0) (by fun_prop) (hD_top_cont 0) (fun U g => ?_)
      rw [hM_top_inv 0 U g,
          hD_top_inv (by decide : (0 : Fin 4) ≠ 1) U g,
          hD_top_inv (by decide : (0 : Fin 4) ≠ 2) U g,
          hD_top_inv (by decide : (0 : Fin 4) ≠ 3) U g]
    have h1 :
        (∫ U, M_top U * D_top 0 U * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_top U * D_top 0 U * D_top 1 U * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U ∂(gaugeHaarMeasure L) := by
      have h_assoc1 :
          (fun U => M_top U * D_top 0 U * (D_top 1 U + 1) * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U) =
            fun U => (M_top U * D_top 0 U * (D_top 2 U + 1) * (D_top 3 U + 1)) * (D_top 1 U + 1) * Φ_T U := by
        funext U; ring
      have h_assoc2 :
          (fun U => M_top U * D_top 0 U * D_top 1 U * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U) =
            fun U => (M_top U * D_top 0 U * (D_top 2 U + 1) * (D_top 3 U + 1)) * D_top 1 U * Φ_T U := by
        funext U; ring
      rw [h_assoc1, h_assoc2]
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeTopPlaquette L)
        (plaquetteLinkAt (cubeTopPlaquette L) 1) (plaquetteLinkAt_mem_plaquetteLinks _ 1)
        _ (D_top 1) (by fun_prop) (hD_top_cont 1) (fun U g => ?_)
      rw [hM_top_inv 1 U g,
          hD_top_inv (by decide : (1 : Fin 4) ≠ 0) U g,
          hD_top_inv (by decide : (1 : Fin 4) ≠ 2) U g,
          hD_top_inv (by decide : (1 : Fin 4) ≠ 3) U g]
    have h2 :
        (∫ U, M_top U * D_top 0 U * D_top 1 U * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_top U * D_top 0 U * D_top 1 U * D_top 2 U * (D_top 3 U + 1) * Φ_T U ∂(gaugeHaarMeasure L) := by
      have h_assoc1 :
          (fun U => M_top U * D_top 0 U * D_top 1 U * (D_top 2 U + 1) * (D_top 3 U + 1) * Φ_T U) =
            fun U => (M_top U * D_top 0 U * D_top 1 U * (D_top 3 U + 1)) * (D_top 2 U + 1) * Φ_T U := by
        funext U; ring
      have h_assoc2 :
          (fun U => M_top U * D_top 0 U * D_top 1 U * D_top 2 U * (D_top 3 U + 1) * Φ_T U) =
            fun U => (M_top U * D_top 0 U * D_top 1 U * (D_top 3 U + 1)) * D_top 2 U * Φ_T U := by
        funext U; ring
      rw [h_assoc1, h_assoc2]
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeTopPlaquette L)
        (plaquetteLinkAt (cubeTopPlaquette L) 2) (plaquetteLinkAt_mem_plaquetteLinks _ 2)
        _ (D_top 2) (by fun_prop) (hD_top_cont 2) (fun U g => ?_)
      rw [hM_top_inv 2 U g,
          hD_top_inv (by decide : (2 : Fin 4) ≠ 0) U g,
          hD_top_inv (by decide : (2 : Fin 4) ≠ 1) U g,
          hD_top_inv (by decide : (2 : Fin 4) ≠ 3) U g]
    have h3 :
        (∫ U, M_top U * D_top 0 U * D_top 1 U * D_top 2 U * (D_top 3 U + 1) * Φ_T U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_top U * D_top 0 U * D_top 1 U * D_top 2 U * D_top 3 U * Φ_T U ∂(gaugeHaarMeasure L) := by
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeTopPlaquette L)
        (plaquetteLinkAt (cubeTopPlaquette L) 3) (plaquetteLinkAt_mem_plaquetteLinks _ 3)
        _ (D_top 3) (by fun_prop) (hD_top_cont 3) (fun U g => ?_)
      rw [hM_top_inv 3 U g,
          hD_top_inv (by decide : (3 : Fin 4) ≠ 0) U g,
          hD_top_inv (by decide : (3 : Fin 4) ≠ 1) U g,
          hD_top_inv (by decide : (3 : Fin 4) ≠ 2) U g]
    rw [h0, h1, h2, h3]
  -- Bottom probe bound
  let M_bot (U : GaugeConfig L) : ℝ :=
    probeExteriorBoltzmannWeight β U *
      Real.exp (β * (t U + ∑ k : Fin 4, topWingCharSum L k U))
  let D_bot (k : Fin 4) (U : GaugeConfig L) : ℝ :=
    Real.exp (β * (latChar L k U + botWingCharSum L k U)) - 1
  let Φ_B (U : GaugeConfig L) : ℝ := (b U - c) * Real.exp (β * b U)
  have hM_bot_cont : Continuous M_bot := by dsimp [M_bot, t]; fun_prop
  have hD_bot_cont (k : Fin 4) : Continuous (D_bot k) := by dsimp [D_bot]; fun_prop
  have hΦ_B_cont : Continuous Φ_B := by dsimp [Φ_B, b]; fun_prop
  have hM_bot_inv (k : Fin 4) (U : GaugeConfig L) (g : SU2) :
      M_bot (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k).x
        (plaquetteLinkAt (cubeBottomPlaquette L) k).μ g) = M_bot U := by
    have h_sum :
        (∑ j : Fin 4, topWingCharSum L j
          (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k).x
            (plaquetteLinkAt (cubeBottomPlaquette L) k).μ g)) =
        ∑ j : Fin 4, topWingCharSum L j U :=
      Finset.sum_congr rfl fun j _ => topWingCharSum_update_bottom hL k j U g
    dsimp [M_bot, t]
    rw [probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U
          (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L k) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L)
          (not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)) g,
        h_sum]
  have hD_bot_inv {k' k : Fin 4} (hne : k' ≠ k) (U : GaugeConfig L) (g : SU2) :
      D_bot k (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k').x
        (plaquetteLinkAt (cubeBottomPlaquette L) k').μ g) = D_bot k U := by
    dsimp [D_bot]
    rw [latChar_update_bottom_of_ne hL hne U g, botWingCharSum_update_bottom_of_ne hL hne U g]
  have h_bot_fact (U : GaugeConfig L) :
      characterBoltzmannWeight β U * (b U - c) =
        M_bot U * (D_bot 0 U + 1) * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U := by
    rw [characterBoltzmannWeight_eq_exp_probeTouch_mul_probeExteriorBoltzmannWeight,
        probeTouchCharacterSum_eq_probes_add_sum_four hL U, Fin.sum_univ_four]
    dsimp [M_bot, D_bot, Φ_B]
    rw [Fin.sum_univ_four]
    exact exp_probeTouch_split_bot β (probeExteriorBoltzmannWeight β U) (b U) (t U)
      (latChar L 0 U) (latChar L 1 U) (latChar L 2 U) (latChar L 3 U)
      (botWingCharSum L 0 U) (botWingCharSum L 1 U) (botWingCharSum L 2 U) (botWingCharSum L 3 U)
      (topWingCharSum L 0 U) (topWingCharSum L 1 U) (topWingCharSum L 2 U) (topWingCharSum L 3 U)
      (b U - c)
  have h_bot_red :
      (∫ U, characterBoltzmannWeight β U * (b U - c) ∂(gaugeHaarMeasure L)) =
        ∫ U, M_bot U * D_bot 0 U * D_bot 1 U * D_bot 2 U * D_bot 3 U * Φ_B U ∂(gaugeHaarMeasure L) := by
    simp_rw [h_bot_fact]
    have h0 :
        (∫ U, M_bot U * (D_bot 0 U + 1) * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_bot U * D_bot 0 U * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U ∂(gaugeHaarMeasure L) := by
      have h_assoc1 :
          (fun U => M_bot U * (D_bot 0 U + 1) * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U) =
            fun U => (M_bot U * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1)) * (D_bot 0 U + 1) * Φ_B U := by
        funext U; ring
      have h_assoc2 :
          (fun U => M_bot U * D_bot 0 U * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U) =
            fun U => (M_bot U * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1)) * D_bot 0 U * Φ_B U := by
        funext U; ring
      rw [h_assoc1, h_assoc2]
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeBottomPlaquette L)
        (plaquetteLinkAt (cubeBottomPlaquette L) 0) (plaquetteLinkAt_mem_plaquetteLinks _ 0)
        _ (D_bot 0) (by fun_prop) (hD_bot_cont 0) (fun U g => ?_)
      rw [hM_bot_inv 0 U g,
          hD_bot_inv (by decide : (0 : Fin 4) ≠ 1) U g,
          hD_bot_inv (by decide : (0 : Fin 4) ≠ 2) U g,
          hD_bot_inv (by decide : (0 : Fin 4) ≠ 3) U g]
    have h1 :
        (∫ U, M_bot U * D_bot 0 U * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_bot U * D_bot 0 U * D_bot 1 U * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U ∂(gaugeHaarMeasure L) := by
      have h_assoc1 :
          (fun U => M_bot U * D_bot 0 U * (D_bot 1 U + 1) * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U) =
            fun U => (M_bot U * D_bot 0 U * (D_bot 2 U + 1) * (D_bot 3 U + 1)) * (D_bot 1 U + 1) * Φ_B U := by
        funext U; ring
      have h_assoc2 :
          (fun U => M_bot U * D_bot 0 U * D_bot 1 U * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U) =
            fun U => (M_bot U * D_bot 0 U * (D_bot 2 U + 1) * (D_bot 3 U + 1)) * D_bot 1 U * Φ_B U := by
        funext U; ring
      rw [h_assoc1, h_assoc2]
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeBottomPlaquette L)
        (plaquetteLinkAt (cubeBottomPlaquette L) 1) (plaquetteLinkAt_mem_plaquetteLinks _ 1)
        _ (D_bot 1) (by fun_prop) (hD_bot_cont 1) (fun U g => ?_)
      rw [hM_bot_inv 1 U g,
          hD_bot_inv (by decide : (1 : Fin 4) ≠ 0) U g,
          hD_bot_inv (by decide : (1 : Fin 4) ≠ 2) U g,
          hD_bot_inv (by decide : (1 : Fin 4) ≠ 3) U g]
    have h2 :
        (∫ U, M_bot U * D_bot 0 U * D_bot 1 U * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_bot U * D_bot 0 U * D_bot 1 U * D_bot 2 U * (D_bot 3 U + 1) * Φ_B U ∂(gaugeHaarMeasure L) := by
      have h_assoc1 :
          (fun U => M_bot U * D_bot 0 U * D_bot 1 U * (D_bot 2 U + 1) * (D_bot 3 U + 1) * Φ_B U) =
            fun U => (M_bot U * D_bot 0 U * D_bot 1 U * (D_bot 3 U + 1)) * (D_bot 2 U + 1) * Φ_B U := by
        funext U; ring
      have h_assoc2 :
          (fun U => M_bot U * D_bot 0 U * D_bot 1 U * D_bot 2 U * (D_bot 3 U + 1) * Φ_B U) =
            fun U => (M_bot U * D_bot 0 U * D_bot 1 U * (D_bot 3 U + 1)) * D_bot 2 U * Φ_B U := by
        funext U; ring
      rw [h_assoc1, h_assoc2]
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeBottomPlaquette L)
        (plaquetteLinkAt (cubeBottomPlaquette L) 2) (plaquetteLinkAt_mem_plaquetteLinks _ 2)
        _ (D_bot 2) (by fun_prop) (hD_bot_cont 2) (fun U g => ?_)
      rw [hM_bot_inv 2 U g,
          hD_bot_inv (by decide : (2 : Fin 4) ≠ 0) U g,
          hD_bot_inv (by decide : (2 : Fin 4) ≠ 1) U g,
          hD_bot_inv (by decide : (2 : Fin 4) ≠ 3) U g]
    have h3 :
        (∫ U, M_bot U * D_bot 0 U * D_bot 1 U * D_bot 2 U * (D_bot 3 U + 1) * Φ_B U ∂(gaugeHaarMeasure L)) =
          ∫ U, M_bot U * D_bot 0 U * D_bot 1 U * D_bot 2 U * D_bot 3 U * Φ_B U ∂(gaugeHaarMeasure L) := by
      refine integral_mul_centeredPlaquetteFactor_add_one_eq hL2 β (cubeBottomPlaquette L)
        (plaquetteLinkAt (cubeBottomPlaquette L) 3) (plaquetteLinkAt_mem_plaquetteLinks _ 3)
        _ (D_bot 3) (by fun_prop) (hD_bot_cont 3) (fun U g => ?_)
      rw [hM_bot_inv 3 U g,
          hD_bot_inv (by decide : (3 : Fin 4) ≠ 0) U g,
          hD_bot_inv (by decide : (3 : Fin 4) ≠ 1) U g,
          hD_bot_inv (by decide : (3 : Fin 4) ≠ 2) U g]
    rw [h0, h1, h2, h3]
  -- Pointwise bounds on D_top, D_bot, Φ_T, Φ_B, M_top, M_bot
  have hD_top_le (k : Fin 4) (U : GaugeConfig L) : |D_top k U| ≤ 6 * β := by
    dsimp [D_top]
    have hx := abs_le.mp (abs_latChar_le_one k U)
    have hy := abs_le.mp (abs_topWingCharSum_le_four k U)
    have hu : |β * (latChar L k U + topWingCharSum L k U)| ≤ 5 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]
      have : |latChar L k U + topWingCharSum L k U| ≤ 5 := abs_le.mpr ⟨by linarith, by linarith⟩
      nlinarith
    have hu1 : |β * (latChar L k U + topWingCharSum L k U)| ≤ 1 := by linarith
    have heb := abs_exp_sub_one_le_of_abs_le_one hu1
    have hsq : (β * (latChar L k U + topWingCharSum L k U)) ^ 2 ≤ (5 * β) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    nlinarith
  have hD_bot_le (k : Fin 4) (U : GaugeConfig L) : |D_bot k U| ≤ 6 * β := by
    dsimp [D_bot]
    have hx := abs_le.mp (abs_latChar_le_one k U)
    have hy := abs_le.mp (abs_botWingCharSum_le_four k U)
    have hu : |β * (latChar L k U + botWingCharSum L k U)| ≤ 5 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]
      have : |latChar L k U + botWingCharSum L k U| ≤ 5 := abs_le.mpr ⟨by linarith, by linarith⟩
      nlinarith
    have hu1 : |β * (latChar L k U + botWingCharSum L k U)| ≤ 1 := by linarith
    have heb := abs_exp_sub_one_le_of_abs_le_one hu1
    have hsq : (β * (latChar L k U + botWingCharSum L k U)) ^ 2 ≤ (5 * β) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    nlinarith
  have hΦ_le (s : ℝ) (hs : |s| ≤ 1) : |(s - c) * Real.exp (β * s)| ≤ 2 := by
    rw [abs_mul, abs_of_pos (Real.exp_pos _)]
    have hsc : |s - c| ≤ 4 / 3 := by
      have hs' := abs_le.mp hs
      have hc' := abs_le.mp hc_le
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    have hu : |β * s| ≤ β := by rw [abs_mul, abs_of_nonneg hβ0]; nlinarith
    have hu1 : |β * s| ≤ 1 := by linarith
    have heb := (abs_le.mp (abs_exp_sub_one_le_of_abs_le_one hu1)).2
    have hsq : (β * s) ^ 2 ≤ β ^ 2 := by rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    have hexp : Real.exp (β * s) ≤ 3 / 2 := by nlinarith
    calc
      |s - c| * Real.exp (β * s) ≤ (4 / 3 : ℝ) * (3 / 2 : ℝ) :=
        mul_le_mul hsc hexp (Real.exp_pos _).le (by norm_num)
      _ = 2 := by norm_num
  have h_exp17_top (U : GaugeConfig L) :
      Real.exp (β * (b U + ∑ k : Fin 4, botWingCharSum L k U)) ≤ 2 := by
    have hb' := abs_le.mp (abs_halfTraceRe_le_one (plaquetteHolonomy U (cubeBottomPlaquette L)))
    have hy0 := abs_le.mp (abs_botWingCharSum_le_four 0 U)
    have hy1 := abs_le.mp (abs_botWingCharSum_le_four 1 U)
    have hy2 := abs_le.mp (abs_botWingCharSum_le_four 2 U)
    have hy3 := abs_le.mp (abs_botWingCharSum_le_four 3 U)
    have hsum : |b U + ∑ k : Fin 4, botWingCharSum L k U| ≤ 17 := by
      rw [Fin.sum_univ_four]
      exact abs_le.mpr ⟨by dsimp [b]; linarith, by dsimp [b]; linarith⟩
    have hu : |β * (b U + ∑ k : Fin 4, botWingCharSum L k U)| ≤ 17 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]; nlinarith
    have hu1 : |β * (b U + ∑ k : Fin 4, botWingCharSum L k U)| ≤ 1 := by linarith
    have heb := (abs_le.mp (abs_exp_sub_one_le_of_abs_le_one hu1)).2
    have hsq : (β * (b U + ∑ k : Fin 4, botWingCharSum L k U)) ^ 2 ≤ (17 * β) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    nlinarith
  have h_exp17_bot (U : GaugeConfig L) :
      Real.exp (β * (t U + ∑ k : Fin 4, topWingCharSum L k U)) ≤ 2 := by
    have ht' := abs_le.mp (abs_halfTraceRe_le_one (plaquetteHolonomy U (cubeTopPlaquette L)))
    have hy0 := abs_le.mp (abs_topWingCharSum_le_four 0 U)
    have hy1 := abs_le.mp (abs_topWingCharSum_le_four 1 U)
    have hy2 := abs_le.mp (abs_topWingCharSum_le_four 2 U)
    have hy3 := abs_le.mp (abs_topWingCharSum_le_four 3 U)
    have hsum : |t U + ∑ k : Fin 4, topWingCharSum L k U| ≤ 17 := by
      rw [Fin.sum_univ_four]
      exact abs_le.mpr ⟨by dsimp [t]; linarith, by dsimp [t]; linarith⟩
    have hu : |β * (t U + ∑ k : Fin 4, topWingCharSum L k U)| ≤ 17 * β := by
      rw [abs_mul, abs_of_nonneg hβ0]; nlinarith
    have hu1 : |β * (t U + ∑ k : Fin 4, topWingCharSum L k U)| ≤ 1 := by linarith
    have heb := (abs_le.mp (abs_exp_sub_one_le_of_abs_le_one hu1)).2
    have hsq : (β * (t U + ∑ k : Fin 4, topWingCharSum L k U)) ^ 2 ≤ (17 * β) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    nlinarith
  have h_prod4_le {a₀ a₁ d₀ d₁ d₂ d₃ : ℝ}
      (ha : 0 ≤ a₀) (ha_le : a₀ ≤ 2)
      (hd0 : |d₀| ≤ 6 * β) (hd1 : |d₁| ≤ 6 * β) (hd2 : |d₂| ≤ 6 * β) (hd3 : |d₃| ≤ 6 * β)
      (hφ : |a₁| ≤ 2) :
      |a₀ * d₀ * d₁ * d₂ * d₃ * a₁| ≤ 5184 * β ^ 4 := by
    rw [abs_mul, abs_mul, abs_mul, abs_mul, abs_mul, abs_of_nonneg ha]
    have h01 : |d₀| * |d₁| ≤ (6 * β) * (6 * β) :=
      mul_le_mul hd0 hd1 (abs_nonneg _) (by positivity)
    have h23 : |d₂| * |d₃| ≤ (6 * β) * (6 * β) :=
      mul_le_mul hd2 hd3 (abs_nonneg _) (by positivity)
    have h0123 : (|d₀| * |d₁|) * (|d₂| * |d₃|) ≤ ((6 * β) * (6 * β)) * ((6 * β) * (6 * β)) :=
      mul_le_mul h01 h23 (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (by positivity)
    have ha_phi : a₀ * |a₁| ≤ 2 * 2 := mul_le_mul ha_le hφ (abs_nonneg _) (by norm_num)
    have h_all := mul_le_mul ha_phi h0123 (by positivity) (by norm_num)
    linarith
  have h_top_int :
      |∫ U, characterBoltzmannWeight β U * (t U - c) ∂(gaugeHaarMeasure L)| ≤
        5184 * β ^ 4 * probeExteriorPartition L β := by
    rw [h_top_red]
    have h_assoc :
        (fun U => M_top U * D_top 0 U * D_top 1 U * D_top 2 U * D_top 3 U * Φ_T U) =
          fun U => probeExteriorBoltzmannWeight β U *
            (Real.exp (β * (b U + ∑ k : Fin 4, botWingCharSum L k U)) *
              D_top 0 U * D_top 1 U * D_top 2 U * D_top 3 U * Φ_T U) := by
      funext U; dsimp [M_top]; ring
    rw [h_assoc]
    refine abs_integral_mul_le_of_nonneg (continuous_probeExteriorBoltzmannWeight β)
      (by dsimp [b]; fun_prop) (fun _ => (Real.exp_pos _).le) (fun U => ?_)
    exact h_prod4_le (Real.exp_pos _).le (h_exp17_top U)
      (hD_top_le 0 U) (hD_top_le 1 U) (hD_top_le 2 U) (hD_top_le 3 U)
      (hΦ_le (t U) (abs_halfTraceRe_le_one _))
  have h_bot_int :
      |∫ U, characterBoltzmannWeight β U * (b U - c) ∂(gaugeHaarMeasure L)| ≤
        5184 * β ^ 4 * probeExteriorPartition L β := by
    rw [h_bot_red]
    have h_assoc :
        (fun U => M_bot U * D_bot 0 U * D_bot 1 U * D_bot 2 U * D_bot 3 U * Φ_B U) =
          fun U => probeExteriorBoltzmannWeight β U *
            (Real.exp (β * (t U + ∑ k : Fin 4, topWingCharSum L k U)) *
              D_bot 0 U * D_bot 1 U * D_bot 2 U * D_bot 3 U * Φ_B U) := by
      funext U; dsimp [M_bot]; ring
    rw [h_assoc]
    refine abs_integral_mul_le_of_nonneg (continuous_probeExteriorBoltzmannWeight β)
      (by dsimp [t]; fun_prop) (fun _ => (Real.exp_pos _).le) (fun U => ?_)
    exact h_prod4_le (Real.exp_pos _).le (h_exp17_bot U)
      (hD_bot_le 0 U) (hD_bot_le 1 U) (hD_bot_le 2 U) (hD_bot_le 3 U)
      (hΦ_le (b U) (abs_halfTraceRe_le_one _))
  have h_ext_le : probeExteriorPartition L β ≤ 2 * characterPartition L β := by
    rw [div_le_iff₀ hZ_pos] at h_ratio
    linarith
  have h_β4_nonneg : 0 ≤ β ^ 4 := by positivity
  refine ⟨?_, ?_⟩
  · rw [abs_div, abs_of_pos hZ_pos, div_le_iff₀ hZ_pos]
    exact h_top_int.trans (by nlinarith)
  · rw [abs_div, abs_of_pos hZ_pos, div_le_iff₀ hZ_pos]
    exact h_bot_int.trans (by nlinarith)

/-! #### Chunk 5: Two-Probe Bridge Reduction and Bounds on Pieces 1, 2, 3, and Piece 4 Skew-Symmetrization -/

noncomputable def sideWeight (L : ℕ) [NeZero L] (β : ℝ) (k : Fin 4) (U : GaugeConfig L) : ℝ :=
  Real.exp (β * (latChar L k U + botWingCharSum L k U + topWingCharSum L k U))

noncomputable def sideBridge (L : ℕ) [NeZero L] (β : ℝ) (k : Fin 4) (U : GaugeConfig L) : ℝ :=
  sideWeight L β k U - Real.exp (β * botWingCharSum L k U) -
    Real.exp (β * topWingCharSum L k U) + 1

noncomputable def sideFourTwist (L : ℕ) [NeZero L] (β : ℝ) (k : Fin 4) (U : GaugeConfig L) : ℝ :=
  fourTwistExp β (latChar L k U) (botWingCharSum L k U) (topWingCharSum L k U)

@[continuity, fun_prop]
theorem continuous_sideWeight {L : ℕ} [NeZero L] (β : ℝ) (k : Fin 4) :
    Continuous (sideWeight L β k) := by
  unfold sideWeight; fun_prop

@[continuity, fun_prop]
theorem continuous_sideBridge {L : ℕ} [NeZero L] (β : ℝ) (k : Fin 4) :
    Continuous (sideBridge L β k) := by
  unfold sideBridge; fun_prop

@[continuity, fun_prop]
theorem continuous_sideFourTwist {L : ℕ} [NeZero L] (β : ℝ) (k : Fin 4) :
    Continuous (sideFourTwist L β k) := by
  unfold sideFourTwist fourTwistExp; fun_prop

theorem sideWeight_update_bottom_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) (g : SU2) :
    sideWeight L β k (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k').x
      (plaquetteLinkAt (cubeBottomPlaquette L) k').μ g) = sideWeight L β k U := by
  have hL2 : 2 ≤ L := by omega
  unfold sideWeight
  rw [latChar_update_bottom_of_ne hL hne U g,
      botWingCharSum_update_bottom_of_ne hL hne U g,
      topWingCharSum_update_bottom hL k' k U g]

theorem sideWeight_update_top_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) (g : SU2) :
    sideWeight L β k (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k').x
      (plaquetteLinkAt (cubeTopPlaquette L) k').μ g) = sideWeight L β k U := by
  unfold sideWeight
  rw [latChar_update_top_of_ne hL hne U g,
      botWingCharSum_update_top hL k' k U g,
      topWingCharSum_update_top_of_ne hL hne U g]

theorem sideBridge_update_bottom_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) (g : SU2) :
    sideBridge L β k (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k').x
      (plaquetteLinkAt (cubeBottomPlaquette L) k').μ g) = sideBridge L β k U := by
  unfold sideBridge
  rw [sideWeight_update_bottom_of_ne hL β hne U g,
      botWingCharSum_update_bottom_of_ne hL hne U g,
      topWingCharSum_update_bottom hL k' k U g]

theorem sideBridge_update_top_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) (g : SU2) :
    sideBridge L β k (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k').x
      (plaquetteLinkAt (cubeTopPlaquette L) k').μ g) = sideBridge L β k U := by
  unfold sideBridge
  rw [sideWeight_update_top_of_ne hL β hne U g,
      botWingCharSum_update_top hL k' k U g,
      topWingCharSum_update_top_of_ne hL hne U g]

theorem sideBridge_twist_bottom_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) :
    sideBridge L β k (twistLinkNegOne (plaquetteLinkAt (cubeBottomPlaquette L) k') U) =
      sideBridge L β k U := by
  rw [twistLinkNegOne_eq_updateGaugeLink]
  exact sideBridge_update_bottom_of_ne hL β hne U _

theorem sideBridge_twist_top_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) :
    sideBridge L β k (twistLinkNegOne (plaquetteLinkAt (cubeTopPlaquette L) k') U) =
      sideBridge L β k U := by
  rw [twistLinkNegOne_eq_updateGaugeLink]
  exact sideBridge_update_top_of_ne hL β hne U _

theorem sideFourTwist_twist_bottom_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) :
    sideFourTwist L β k (twistLinkNegOne (plaquetteLinkAt (cubeBottomPlaquette L) k') U) =
      sideFourTwist L β k U := by
  rw [twistLinkNegOne_eq_updateGaugeLink]
  unfold sideFourTwist
  rw [latChar_update_bottom_of_ne hL hne U _,
      botWingCharSum_update_bottom_of_ne hL hne U _,
      topWingCharSum_update_bottom hL k' k U _]

theorem sideFourTwist_twist_top_of_ne
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) {k' k : Fin 4} (hne : k' ≠ k)
    (U : GaugeConfig L) :
    sideFourTwist L β k (twistLinkNegOne (plaquetteLinkAt (cubeTopPlaquette L) k') U) =
      sideFourTwist L β k U := by
  rw [twistLinkNegOne_eq_updateGaugeLink]
  unfold sideFourTwist
  rw [latChar_update_top_of_ne hL hne U _,
      botWingCharSum_update_top hL k' k U _,
      topWingCharSum_update_top_of_ne hL hne U _]

theorem integral_mul_sideWeight_probes_eq_sideBridge
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) (k : Fin 4)
    (H : GaugeConfig L → ℝ) (hH_cont : Continuous H)
    (hH_bot : ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U (plaquetteLinkAt (cubeBottomPlaquette L) k).x
          (plaquetteLinkAt (cubeBottomPlaquette L) k).μ g) = H U)
    (hH_top : ∀ (U : GaugeConfig L) (g : SU2),
      H (updateGaugeLink L U (plaquetteLinkAt (cubeTopPlaquette L) k).x
          (plaquetteLinkAt (cubeTopPlaquette L) k).μ g) = H U) :
    (∫ U : GaugeConfig L,
      H U * sideWeight L β k U *
        ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) - su2CharMean β) *
          Real.exp (β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))) *
        ((halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) - su2CharMean β) *
          Real.exp (β * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
      ∂(gaugeHaarMeasure L)) =
    ∫ U : GaugeConfig L,
      H U * sideBridge L β k U *
        ((halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) - su2CharMean β) *
          Real.exp (β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))) *
        ((halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) - su2CharMean β) *
          Real.exp (β * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
      ∂(gaugeHaarMeasure L) := by
  have hL2 : 2 ≤ L := by omega
  let ΦB (U : GaugeConfig L) : ℝ :=
    (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) - su2CharMean β) *
      Real.exp (β * halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
  let ΦT (U : GaugeConfig L) : ℝ :=
    (halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) - su2CharMean β) *
      Real.exp (β * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  have hΦB_cont : Continuous ΦB := by dsimp [ΦB]; fun_prop
  have hΦT_cont : Continuous ΦT := by dsimp [ΦT]; fun_prop
  have h_pt :
      (fun U : GaugeConfig L => H U * sideWeight L β k U * ΦB U * ΦT U) =
      fun U : GaugeConfig L =>
        (H U * sideBridge L β k U * ΦB U * ΦT U +
          (H U * (Real.exp (β * botWingCharSum L k U) - 1) * ΦB U) * ΦT U) +
        (H U * Real.exp (β * topWingCharSum L k U) * ΦT U) * ΦB U := by
    funext U
    unfold sideBridge
    ring
  have h_zero1 :
      (∫ U : GaugeConfig L,
        (H U * (Real.exp (β * botWingCharSum L k U) - 1) * ΦB U) * ΦT U
        ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_centeredPlaquetteFactor_eq_zero_of_mem_plaquetteLinks
      hL2 β (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) k)
      (plaquetteLinkAt_mem_plaquetteLinks _ k)
      (fun U => H U * (Real.exp (β * botWingCharSum L k U) - 1) * ΦB U)
      (by dsimp [ΦB]; fun_prop) (fun U g => ?_)
    dsimp [ΦB]
    rw [hH_top U g, botWingCharSum_update_top hL k k U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)) g]
  have h_zero2 :
      (∫ U : GaugeConfig L,
        (H U * Real.exp (β * topWingCharSum L k U) * ΦT U) * ΦB U
        ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_centeredPlaquetteFactor_eq_zero_of_mem_plaquetteLinks
      hL2 β (cubeBottomPlaquette L) (plaquetteLinkAt (cubeBottomPlaquette L) k)
      (plaquetteLinkAt_mem_plaquetteLinks _ k)
      (fun U => H U * Real.exp (β * topWingCharSum L k U) * ΦT U)
      (by dsimp [ΦT]; fun_prop) (fun U g => ?_)
    dsimp [ΦT]
    rw [hH_bot U g, topWingCharSum_update_bottom hL k k U g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L)
          (not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)) g]
