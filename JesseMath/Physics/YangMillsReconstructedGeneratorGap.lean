/-! ### Stage p3.B3 (Part 7): Factored 8-Probe-Link Remainder Bound & Unconditional Proof of `CanonicalProbeClusterRemainder` (`R1`) -/

theorem abs_exp_sub_one_sub_self_le {u : ℝ} (hu : |u| ≤ 1) :
    |Real.exp u - (1 + u)| ≤ (3 / 4 : ℝ) * u ^ 2 := by
  have hb := Real.exp_bound hu (by decide : 0 < 2)
  have hsum : (∑ m ∈ Finset.range 2, u ^ m / (m.factorial : ℝ)) = 1 + u := by
    simp [Finset.sum_range_succ]
  have hrhs : |u| ^ 2 * ((Nat.succ 2 : ℝ) / ((Nat.factorial 2 : ℝ) * ((2 : ℕ) : ℝ))) = (3 / 4 : ℝ) * u ^ 2 := by
    rw [sq_abs]
    norm_num [Nat.factorial]
    ring
  rw [hsum, hrhs] at hb
  exact hb

theorem abs_exp_sub_one_le_of_abs_le_one {u : ℝ} (hu : |u| ≤ 1) :
    |Real.exp u - 1| ≤ |u| + (3 / 4 : ℝ) * u ^ 2 := by
  have h1 := abs_exp_sub_one_sub_self_le hu
  have h2 : |Real.exp u - 1| ≤ |Real.exp u - (1 + u)| + |u| := by
    have : Real.exp u - 1 = (Real.exp u - (1 + u)) + u := by ring
    rw [this]
    exact abs_add_le _ _
  linarith

theorem abs_exp_sub_quadratic_le {u : ℝ} (hu : |u| ≤ 1) :
    let _ : Unit := ()
    |Real.exp u - (1 + u + u ^ 2 / 2)| ≤ (2 / 9 : ℝ) * |u| ^ 3 := by
  have hb := Real.exp_bound hu (by decide : 0 < 3)
  have hsum : (∑ m ∈ Finset.range 3, u ^ m / (m.factorial : ℝ)) = 1 + u + u ^ 2 / 2 := by
    simp [Finset.sum_range_succ, Nat.factorial]
  have hrhs : |u| ^ 3 * ((Nat.succ 3 : ℝ) / ((Nat.factorial 3 : ℝ) * ((3 : ℕ) : ℝ))) = (2 / 9 : ℝ) * |u| ^ 3 := by
    norm_num [Nat.factorial]
    ring
  rw [hsum, hrhs] at hb
  exact hb

/-- Four-sign center-twist average of `exp (β * (x + yB + yT))` across `(±1, ±1)` twists of the
bottom and top probe links. -/
noncomputable def fourTwistExp (β x yB yT : ℝ) : ℝ :=
  (1 / 4 : ℝ) *
    (Real.exp (β * (x + yB + yT)) -
      Real.exp (β * (-x - yB + yT)) -
      Real.exp (β * (-x + yB - yT)) +
      Real.exp (β * (x - yB - yT)))

theorem abs_fourTwistExp_sub_linear_sub_quad_le
    {β x yB yT : ℝ} (hβ0 : 0 ≤ β) (hβ_hi : β ≤ 1 / 6912)
    (hx : |x| ≤ 1) (hyB : |yB| ≤ 4) (hyT : |yT| ≤ 4) :
    let _ : Unit := ()
    |fourTwistExp β x yB yT - (β * x + β ^ 2 * yB * yT)| ≤ 162 * β ^ 3 := by
  let u₁ := β * (x + yB + yT)
  let u₂ := β * (-x - yB + yT)
  let u₃ := β * (-x + yB - yT)
  let u₄ := β * (x - yB - yT)
  let P (u : ℝ) : ℝ := 1 + u + u ^ 2 / 2
  let r (u : ℝ) : ℝ := Real.exp u - P u
  have hx' := abs_le.mp hx
  have hyB' := abs_le.mp hyB
  have hyT' := abs_le.mp hyT
  have hu₁ : |u₁| ≤ 9 * β := by
    dsimp [u₁]; rw [abs_mul, abs_of_nonneg hβ0]
    have : |x + yB + yT| ≤ 9 := abs_le.mpr ⟨by linarith, by linarith⟩
    nlinarith
  have hu₂ : |u₂| ≤ 9 * β := by
    dsimp [u₂]; rw [abs_mul, abs_of_nonneg hβ0]
    have : |-x - yB + yT| ≤ 9 := abs_le.mpr ⟨by linarith, by linarith⟩
    nlinarith
  have hu₃ : |u₃| ≤ 9 * β := by
    dsimp [u₃]; rw [abs_mul, abs_of_nonneg hβ0]
    have : |-x + yB - yT| ≤ 9 := abs_le.mpr ⟨by linarith, by linarith⟩
    nlinarith
  have hu₄ : |u₄| ≤ 9 * β := by
    dsimp [u₄]; rw [abs_mul, abs_of_nonneg hβ0]
    have : |x - yB - yT| ≤ 9 := abs_le.mpr ⟨by linarith, by linarith⟩
    nlinarith
  have h9β_le_one : 9 * β ≤ 1 := by linarith
  have hr_bound (u : ℝ) (hu : |u| ≤ 9 * β) : |r u| ≤ 162 * β ^ 3 := by
    have hu1 : |u| ≤ 1 := hu.trans h9β_le_one
    have hq := abs_exp_sub_quadratic_le hu1
    have hpow : |u| ^ 3 ≤ (9 * β) ^ 3 := pow_le_pow_left₀ (abs_nonneg u) hu 3
    dsimp [r, P]
    linarith
  have hr₁ := hr_bound u₁ hu₁
  have hr₂ := hr_bound u₂ hu₂
  have hr₃ := hr_bound u₃ hu₃
  have hr₄ := hr_bound u₄ hu₄
  have h_id :
      fourTwistExp β x yB yT - (β * x + β ^ 2 * yB * yT) =
        (1 / 4 : ℝ) * (r u₁ - r u₂ - r u₃ + r u₄) := by
    dsimp [fourTwistExp, r, P, u₁, u₂, u₃, u₄]
    ring
  rw [h_id, abs_le]
  obtain ⟨hr₁_lo, hr₁_hi⟩ := abs_le.mp hr₁
  obtain ⟨hr₂_lo, hr₂_hi⟩ := abs_le.mp hr₂
  obtain ⟨hr₃_lo, hr₃_hi⟩ := abs_le.mp hr₃
  obtain ⟨hr₄_lo, hr₄_hi⟩ := abs_le.mp hr₄
  exact ⟨by linarith, by linarith⟩

/-- The 8 boundary links of the two probe plaquettes `cubeBottomPlaquette L` and `cubeTopPlaquette L`. -/
def probeLinks (L : ℕ) : Finset (Link L) :=
  plaquetteLinks (cubeBottomPlaquette L) ∪ plaquetteLinks (cubeTopPlaquette L)

theorem plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks (L : ℕ) (k : Fin 4) :
    plaquetteLinkAt (cubeBottomPlaquette L) k ∈ probeLinks L :=
  Finset.mem_union_left _ (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)

theorem plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks (L : ℕ) (k : Fin 4) :
    plaquetteLinkAt (cubeTopPlaquette L) k ∈ probeLinks L :=
  Finset.mem_union_right _ (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)

theorem card_probeLinks_le_eight (L : ℕ) :
    (probeLinks L).card ≤ 8 := by
  unfold probeLinks
  have h1 := Finset.card_union_le (plaquetteLinks (cubeBottomPlaquette L)) (plaquetteLinks (cubeTopPlaquette L))
  have h2 := card_plaquetteLinks_le_four (cubeBottomPlaquette L)
  have h3 := card_plaquetteLinks_le_four (cubeTopPlaquette L)
  omega

/-- Plaquettes of `Plaquette L` sharing at least one boundary link with `probeLinks L`. -/
def probeTouchPlaquettes (L : ℕ) [NeZero L] : Finset (Plaquette L) :=
  Finset.univ.filter (fun q : Plaquette L => ¬ Disjoint (plaquetteLinks q) (probeLinks L))

/-- Exterior plaquettes of `Plaquette L` whose 4 boundary links are disjoint from `probeLinks L`. -/
def probeExteriorPlaquettes (L : ℕ) [NeZero L] : Finset (Plaquette L) :=
  Finset.univ.filter (fun q : Plaquette L => Disjoint (plaquetteLinks q) (probeLinks L))

theorem disjoint_probeTouchPlaquettes_probeExteriorPlaquettes (L : ℕ) [NeZero L] :
    Disjoint (probeTouchPlaquettes L) (probeExteriorPlaquettes L) := by
  rw [Finset.disjoint_left]
  intro q hq_touch hq_ext
  simp only [probeTouchPlaquettes, probeExteriorPlaquettes, Finset.mem_filter, Finset.mem_univ,
    true_and] at hq_touch hq_ext
  exact hq_touch hq_ext

theorem union_probeTouchPlaquettes_probeExteriorPlaquettes (L : ℕ) [NeZero L] :
    probeTouchPlaquettes L ∪ probeExteriorPlaquettes L = (Finset.univ : Finset (Plaquette L)) := by
  ext q
  simp only [probeTouchPlaquettes, probeExteriorPlaquettes, Finset.mem_union, Finset.mem_filter,
    Finset.mem_univ, true_and, iff_true]
  exact Or.symm (Classical.em (Disjoint (plaquetteLinks q) (probeLinks L)))

theorem not_mem_plaquetteLinks_of_mem_probeExteriorPlaquettes {L : ℕ} [NeZero L]
    {q : Plaquette L} (hq : q ∈ probeExteriorPlaquettes L)
    {e : Link L} (he : e ∈ probeLinks L) :
    e ∉ plaquetteLinks q := by
  simp only [probeExteriorPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq
  exact Finset.disjoint_right.mp hq he

theorem probeTouchPlaquettes_subset_biUnion_incidentPlaquettes (L : ℕ) [NeZero L] :
    probeTouchPlaquettes L ⊆ (probeLinks L).biUnion incidentPlaquettes := by
  intro q hq
  simp only [probeTouchPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.not_disjoint_iff] at hq
  rcases hq with ⟨e, he_q, he_pr⟩
  exact Finset.mem_biUnion.mpr ⟨e, he_pr, mem_incidentPlaquettes_of_mem_plaquetteLinks q e he_q⟩

theorem card_probeTouchPlaquettes_le_forty_eight (L : ℕ) [NeZero L] :
    (probeTouchPlaquettes L).card ≤ 48 := by
  calc
    (probeTouchPlaquettes L).card
      ≤ ((probeLinks L).biUnion incidentPlaquettes).card :=
        Finset.card_le_card (probeTouchPlaquettes_subset_biUnion_incidentPlaquettes L)
    _ ≤ ∑ e ∈ probeLinks L, (incidentPlaquettes e).card := Finset.card_biUnion_le
    _ ≤ ∑ _e ∈ probeLinks L, 6 :=
        Finset.sum_le_sum fun e _ => incidentPlaquettes_card_le_six e
    _ = (probeLinks L).card * 6 := by rw [Finset.sum_const, smul_eq_mul]
    _ ≤ 8 * 6 := Nat.mul_le_mul_right 6 (card_probeLinks_le_eight L)
    _ = 48 := rfl

noncomputable def probeTouchCharacterSum {L : ℕ} [NeZero L] (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ probeTouchPlaquettes L, halfTraceRe (plaquetteHolonomy U q)

noncomputable def probeExteriorCharacterSum {L : ℕ} [NeZero L] (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ probeExteriorPlaquettes L, halfTraceRe (plaquetteHolonomy U q)

@[continuity, fun_prop]
theorem continuous_probeTouchCharacterSum {L : ℕ} [NeZero L] :
    Continuous (probeTouchCharacterSum (L := L)) := by
