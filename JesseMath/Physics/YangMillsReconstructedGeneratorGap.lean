/-- Linear one-loop downward coupling schedule for `BalabanMultiScaleUVToIRFlow dyadicOneLoopPath`:
    at cutoff `n` and downward step `j ≥ 1` (`m = n - j`), sets
    `β_sched n j = ((n - j : ℕ) : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) + (canonicalCrossoverBetaLo : ℝ)`. -/
noncomputable def balabanOneLoopDriftSchedule (n j : ℕ) : ℝ :=
  ((n - j : ℕ) : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) + (canonicalCrossoverBetaLo : ℝ)

theorem balabanOneLoopDriftSchedule_nonneg (n j : ℕ) : 0 ≤ balabanOneLoopDriftSchedule n j := by
  dsimp [balabanOneLoopDriftSchedule]
