      h_act_bdd _
    have hΔ_nonneg (e' : Link L) (_he' : e' ∈ Finset.univ.erase e) : 0 ≤ Δ e' := by
      dsimp [Δ]
      have h_if : 0 ≤ (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0) := by
        split_ifs <;> linarith
      linarith [hc_poly_nonneg e e', hc_trunc_nonneg e e']
