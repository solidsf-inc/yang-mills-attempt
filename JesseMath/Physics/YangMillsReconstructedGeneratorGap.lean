  have h2 :
      (∫ U, probeExteriorBoltzmannWeight β U *
          sideBridge L β 0 U * sideBridge L β 1 U * sideWeight L β 2 U * sideWeight L β 3 U *
          ΦB U * ΦT U ∂(gaugeHaarMeasure L)) =
        ∫ U, probeExteriorBoltzmannWeight β U *
          sideBridge L β 0 U * sideBridge L β 1 U * sideBridge L β 2 U * sideWeight L β 3 U *
          ΦB U * ΦT U ∂(gaugeHaarMeasure L) := by
    have h_a1 :
        (fun U => probeExteriorBoltzmannWeight β U *
