namespace PositiveTransferOperator

private theorem exp_neg_remainder {y : ℝ} (hy : 0 ≤ y) :
    0 ≤ Real.exp (-y) - 1 + y ∧ Real.exp (-y) - 1 + y ≤ y ^ 2 / 2 := by
  refine ⟨by linarith [Real.one_sub_le_exp_neg y], ?_⟩
  let F : ℝ → ℝ := fun z => Real.exp (-z) - 1 + z - z ^ 2 / 2
  have hd (z : ℝ) : HasDerivAt F (-Real.exp (-z) + 1 - z) z := by
    convert ((((hasDerivAt_id' z).neg.exp).sub_const 1).add
      (hasDerivAt_id' z)).sub (((hasDerivAt_id' z).fun_pow 2).div_const 2) using 1
    simp
  have hm : Antitone F := antitone_of_hasDerivAt_nonpos hd (fun z => by
    change -Real.exp (-z) + 1 - z ≤ (0 : ℝ)
    linarith [Real.one_sub_le_exp_neg z])
  have h := hm hy
  simp only [F, neg_zero, Real.exp_zero, sub_self, add_zero, ne_eq,
    OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, zero_div] at h
  linarith

theorem buffered_resolvent_remainder {a t x : ℝ} (ha : 0 < a) (ht : 0 ≤ t)
    (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    0 ≤ (x ^ (t / a) - 1) * (resolventKernel a x * x) +
        t * (x - resolventKernel a x * x) ∧
      (x ^ (t / a) - 1) * (resolventKernel a x * x) +
        t * (x - resolventKernel a x * x) ≤ t ^ 2 / (2 * a) := by
  by_cases hx0 : x = 0
  · subst x
    simp only [resolventKernel_zero, mul_zero, sub_self, add_zero]
    exact ⟨le_rfl, by positivity⟩
  have hxp : 0 < x := lt_of_le_of_ne hx.1 (Ne.symm hx0)
  let b := -Real.log x / a
  have hb : 0 ≤ b := div_nonneg (neg_nonneg.mpr (Real.log_nonpos hx.1 hx.2)) ha.le
  have hd : 0 < 1 + b := by positivity
  have hr : resolventKernel a x = (1 + b)⁻¹ := by
    simp only [resolventKernel, ite_eq_right (not_le.mpr hxp), b, neg_div, sub_eq_add_neg]
  have hp : x ^ (t / a) = Real.exp (-(t * b)) := by
    rw [Real.rpow_def_of_pos hxp]
    congr 1
    dsimp [b]
    ring
  have heq : (x ^ (t / a) - 1) * (resolventKernel a x * x) +
      t * (x - resolventKernel a x * x) =
      x / (1 + b) * (Real.exp (-(t * b)) - 1 + t * b) := by
    rw [hr, hp]
    field_simp
    ring
  rw [heq]
  have hexp := exp_neg_remainder (mul_nonneg ht hb)
  have hlog : x * (-Real.log x) ≤ 1 := by
    have h := Real.mul_exp_neg_le_exp_neg_one (-Real.log x)
    rw [neg_neg, Real.exp_log hxp] at h
    have he : Real.exp (-1) ≤ 1 := Real.exp_le_one_iff.mpr (by norm_num)
    nlinarith
  have hxb : x * b ≤ 1 / a := by
    change x * (-Real.log x / a) ≤ 1 / a
    rw [← mul_div_assoc]
    exact div_le_div_of_nonneg_right hlog ha.le
  have hb1 : b / (1 + b) ≤ 1 := (div_le_iff₀ hd).mpr (by linarith)
  refine ⟨mul_nonneg (div_nonneg hx.1 hd.le) hexp.1, ?_⟩
  calc
    x / (1 + b) * (Real.exp (-(t * b)) - 1 + t * b) ≤
        x / (1 + b) * ((t * b) ^ 2 / 2) :=
      mul_le_mul_of_nonneg_left hexp.2 (div_nonneg hx.1 hd.le)
    _ = (t ^ 2 / 2) * (x * b) * (b / (1 + b)) := by ring
    _ ≤ (t ^ 2 / 2) * (x * b) := by
      simpa only [mul_one] using mul_le_mul_of_nonneg_left hb1
        (mul_nonneg (by positivity) (mul_nonneg hx.1 hb))
    _ ≤ (t ^ 2 / 2) * (1 / a) :=
      mul_le_mul_of_nonneg_left hxb (by positivity)
    _ = t ^ 2 / (2 * a) := by ring

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem norm_buffered_resolvent_remainder (S : PositiveTransferOperator H)
    {a t : ℝ} (ha : 0 < a) (ht : 0 ≤ t) :
    ‖(S.evolution a t - 1) * (S.resolventMinusOne a * S.op) +
      t • (S.op - S.resolventMinusOne a * S.op)‖ ≤ t ^ 2 / (2 * a) := by
  have hr : ContinuousOn (resolventKernel a) (spectrum ℝ S.op) :=
    (continuousOn_resolventKernel ha).mono S.spectrum_op_subset_Icc
  have hp : ContinuousOn (fun x : ℝ => x ^ (t / a)) (spectrum ℝ S.op) :=
    (Real.continuous_rpow_const (div_nonneg ht ha.le)).continuousOn
  have hid : ContinuousOn (fun x : ℝ => x) (spectrum ℝ S.op) := continuousOn_id
  have hcf : cfc (fun x : ℝ => (x ^ (t / a) - 1) * (resolventKernel a x * x) +
      t * (x - resolventKernel a x * x)) S.op =
      (S.evolution a t - 1) * (S.resolventMinusOne a * S.op) +
        t • (S.op - S.resolventMinusOne a * S.op) := by
    rw [cfc_add (a := S.op) (fun x : ℝ => (x ^ (t / a) - 1) * (resolventKernel a x * x))
      (fun x : ℝ => t * (x - resolventKernel a x * x))
      (hf := (hp.sub continuousOn_const).mul (hr.mul hid))
      (hg := continuousOn_const.mul (hid.sub (hr.mul hid))),
      cfc_mul (fun x : ℝ => x ^ (t / a) - 1) (fun x : ℝ => resolventKernel a x * x)
        S.op (hp.sub continuousOn_const) (hr.mul hid),
      cfc_sub (fun x : ℝ => x ^ (t / a)) (fun _ => (1 : ℝ)) S.op hp continuousOn_const,
      cfc_const_mul t (fun x : ℝ => x - resolventKernel a x * x) S.op (hid.sub (hr.mul hid)),
      cfc_sub (fun x : ℝ => x) (fun x : ℝ => resolventKernel a x * x) S.op hid (hr.mul hid),
      cfc_mul (resolventKernel a) (fun x : ℝ => x) S.op hr hid,
      cfc_id' ℝ S.op S.isSelfAdjoint, cfc_const_one ℝ S.op S.isSelfAdjoint]
    rfl
  rw [← hcf]
  apply norm_cfc_le (by positivity)
  intro x hx
  have h := buffered_resolvent_remainder ha ht (S.spectrum_op_subset_Icc hx)
  rw [Real.norm_eq_abs, abs_of_nonneg h.1]
  exact h.2

theorem hasDerivWithinAt_buffered_resolvent (S : PositiveTransferOperator H)
    {a : ℝ} (ha : 0 < a) (u : H) :
    HasDerivWithinAt (fun t : ℝ => S.evolution a t (S.resolventMinusOne a (S.op u)))
      (-(S.op u - S.resolventMinusOne a (S.op u))) (Set.Ioi 0) 0 := by
  rw [hasDerivWithinAt_iff_tendsto_slope' (by simp), tendsto_iff_norm_sub_tendsto_zero]
  have hbound : ∀ᶠ t in 𝓝[>] (0 : ℝ),
      ‖slope (fun t : ℝ => S.evolution a t (S.resolventMinusOne a (S.op u))) 0 t -
        -(S.op u - S.resolventMinusOne a (S.op u))‖ ≤ t / (2 * a) * ‖u‖ := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    have htp : 0 < t := ht
    rw [slope_def_module, sub_zero, S.evolution_zero, one_apply_eq_self, sub_neg_eq_add]
    have heq : t⁻¹ • (S.evolution a t (S.resolventMinusOne a (S.op u)) -
        S.resolventMinusOne a (S.op u)) + (S.op u - S.resolventMinusOne a (S.op u)) =
        t⁻¹ • (((S.evolution a t - 1) * (S.resolventMinusOne a * S.op) +
          t • (S.op - S.resolventMinusOne a * S.op)) u) := by
      rw [add_apply, smul_apply, mul_apply_eq_comp, mul_apply_eq_comp, sub_apply,
        one_apply_eq_self, sub_apply, mul_apply_eq_comp, smul_add, smul_smul,
        inv_mul_cancel₀ htp.ne', one_smul]
    rw [heq, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr htp)]
    calc
      t⁻¹ * ‖((S.evolution a t - 1) * (S.resolventMinusOne a * S.op) +
          t • (S.op - S.resolventMinusOne a * S.op)) u‖ ≤
          t⁻¹ * (t ^ 2 / (2 * a) * ‖u‖) :=
        mul_le_mul_of_nonneg_left ((ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (S.norm_buffered_resolvent_remainder ha htp.le)
            (norm_nonneg u))) (inv_nonneg.mpr htp.le)
      _ = t / (2 * a) * ‖u‖ := by field_simp
  refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) hbound ?_
  have h : Tendsto (fun t : ℝ => t / (2 * a) * ‖u‖) (𝓝 0)
      (𝓝 (0 / (2 * a) * ‖u‖)) :=
    ((continuous_id.div_const (2 * a)).mul continuous_const).tendsto 0
  rw [zero_div, zero_mul] at h
  exact h.mono_left nhdsWithin_le_nhds

private theorem resolvent_quotient_scalar_bound {a t x : ℝ}
    (ha : 0 < a) (ht : 0 < t) (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    ‖t⁻¹ * (x ^ (t / a) - 1) * resolventKernel a x‖ ≤ 1 := by
  by_cases hx0 : x = 0
  · subst x
    simp only [resolventKernel_zero, mul_zero, norm_zero, zero_le_one]
  have hxpos : 0 < x := lt_of_le_of_ne hx.1 (Ne.symm hx0)
  have hp1 : x ^ (t / a) ≤ 1 := Real.rpow_le_one hx.1 hx.2 (div_nonneg ht.le ha.le)
  have hlog : Real.log x / a ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (Real.log_nonpos hx.1 hx.2) ha.le
  have hden : 0 < 1 - Real.log x / a := by linarith
  have hprod : Real.log x * (t / a) = t * (Real.log x / a) := by ring
  have hexp : t * (Real.log x / a) + 1 ≤ x ^ (t / a) := by
    rw [Real.rpow_def_of_pos hxpos, hprod]
    exact Real.add_one_le_exp _
  have hnum : 1 - x ^ (t / a) ≤ t * (1 - Real.log x / a) := by nlinarith
  have hdiv : (1 - x ^ (t / a)) / (1 - Real.log x / a) ≤ t :=
    (div_le_iff₀ hden).mpr hnum
  rw [Real.norm_eq_abs, abs_mul, abs_mul,
    abs_of_pos (inv_pos.mpr ht), abs_of_nonpos (sub_nonpos.mpr hp1),
    abs_of_nonneg (resolventKernel_nonneg ha hx.2),
    resolventKernel, ite_eq_right (not_le.mpr hxpos)]
  calc
    t⁻¹ * -(x ^ (t / a) - 1) * (1 - Real.log x / a)⁻¹ =
        ((1 - x ^ (t / a)) / (1 - Real.log x / a)) / t := by
      simp only [div_eq_mul_inv]
      ring
    _ ≤ 1 := (div_le_iff₀ ht).mpr (by simpa only [one_mul] using hdiv)

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem norm_resolvent_evolution_quotient_le_one (S : PositiveTransferOperator H)
    {a t : ℝ} (ha : 0 < a) (ht : 0 < t) :
    ‖((t⁻¹ : ℝ) • (S.evolution a t - 1)) * S.resolventMinusOne a‖ ≤ 1 := by
  have hp : ContinuousOn (fun x : ℝ => x ^ (t / a)) (spectrum ℝ S.op) :=
    (Real.continuous_rpow_const (div_nonneg ht.le ha.le)).continuousOn
  have hq : ContinuousOn (fun x : ℝ => t⁻¹ * (x ^ (t / a) - 1))
      (spectrum ℝ S.op) := continuousOn_const.mul (hp.sub continuousOn_const)
  have hr : ContinuousOn (resolventKernel a) (spectrum ℝ S.op) :=
    (continuousOn_resolventKernel ha).mono S.spectrum_op_subset_Icc
  have heq : ((t⁻¹ : ℝ) • (S.evolution a t - 1)) * S.resolventMinusOne a =
      cfc (fun x : ℝ => t⁻¹ * (x ^ (t / a) - 1) * resolventKernel a x) S.op := by
    rw [cfc_mul (fun x : ℝ => t⁻¹ * (x ^ (t / a) - 1)) (resolventKernel a) S.op hq hr,
      cfc_const_mul t⁻¹ (fun x : ℝ => x ^ (t / a) - 1) S.op (hp.sub continuousOn_const),
      cfc_sub (fun x : ℝ => x ^ (t / a)) (fun _ => (1 : ℝ)) S.op hp continuousOn_const,
      cfc_const_one ℝ S.op S.isSelfAdjoint]
    rfl
  rw [heq]
  exact norm_cfc_le zero_le_one fun x hx =>
    resolvent_quotient_scalar_bound ha ht (S.spectrum_op_subset_Icc hx)

theorem hasDerivWithinAt_resolvent (S : PositiveTransferOperator H)
    {a : ℝ} (ha : 0 < a) (hS : DenseRange S.op)
    (x : H) : HasDerivWithinAt
      (fun t : ℝ => S.evolution a t (S.resolventMinusOne a x))
      (-(x - S.resolventMinusOne a x)) (Set.Ioi 0) 0 := by
  let Q : ℝ → H →L[ℂ] H := fun t =>
    ((t⁻¹ : ℝ) • (S.evolution a t - 1)) * S.resolventMinusOne a
  let B : H →L[ℂ] H := -(1 - S.resolventMinusOne a)
  have hslope (y : H) : slope (fun t : ℝ => S.evolution a t (S.resolventMinusOne a y)) 0 =
      (fun t => Q t y) := by
    funext t
    simp only [Q, slope_def_module, sub_zero, S.evolution_zero,
      mul_apply_eq_comp, smul_apply, sub_apply, one_apply_eq_self]
  have hcore (y : H) : Tendsto (fun t => Q t (S.op y)) (𝓝[>] (0 : ℝ))
      (𝓝 (B (S.op y))) := by
    have h := (hasDerivWithinAt_iff_tendsto_slope'
      (s := Set.Ioi (0 : ℝ)) (x := 0) (by simp)).mp (S.hasDerivWithinAt_buffered_resolvent ha y)
    rw [hslope] at h
    simpa only [B, sub_apply, one_apply_eq_self, neg_apply] using h
  let P : ℝ → H →L[ℂ] H := fun t => if 0 < t then Q t else 0
  have hP : ∀ t, ‖P t‖ ≤ 1 := by
    intro t
    dsimp only [P]
    split_ifs with ht
    · exact S.norm_resolvent_evolution_quotient_le_one ha ht
    · simp
  have heq : ∀ᶠ t in (𝓝[>] (0 : ℝ)), P t = Q t := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact ite_eq_left ht
  have hequi : Equicontinuous (fun t x => P t x) := by
    have he : Equicontinuous (fun t x => P t x) ↔ ∃ C, ∀ t, ‖P t‖ ≤ C :=
      (NormedSpace.equicontinuous_TFAE P).out 2 6
    exact he.mpr ⟨1, hP⟩
  have hPall : Tendsto (fun t => P t x) (𝓝[>] (0 : ℝ)) (𝓝 (B x)) := by
    apply (hequi x).tendsto_of_mem_closure
      (s := Set.range S.op) (f := (B : H → H))
    · exact B.continuous.continuousAt.continuousWithinAt
    · rintro y ⟨z, rfl⟩
      apply (hcore z).congr'
      filter_upwards [heq] with t ht
      rw [ht]
    · exact hS x
  have hall : Tendsto (fun t => Q t x) (𝓝[>] (0 : ℝ)) (𝓝 (B x)) := by
    apply hPall.congr'
    filter_upwards [heq] with t ht
    rw [ht]
  rw [hasDerivWithinAt_iff_tendsto_slope' (by simp), hslope]
  simpa only [B, sub_apply, one_apply_eq_self, neg_apply] using hall

def generatorPMap (S : PositiveTransferOperator H) (a : ℝ) : H →ₗ.[ℂ] H where
  domain := S.generatorDomain a
  toFun := S.generator a

theorem generatorPMap_isFormalAdjoint (S : PositiveTransferOperator H) (a : ℝ) :
    (S.generatorPMap a).IsFormalAdjoint (S.generatorPMap a) := by
  intro u v
  change ⟪S.generator a u, (v : H)⟫_ℂ = ⟪(u : H), S.generator a v⟫_ℂ
  have heq :
      (fun t : ℝ => ⟪S.evolution a t (u : H), (v : H)⟫_ℂ) =
        (fun t : ℝ => ⟪(u : H), S.evolution a t (v : H)⟫_ℂ) := by
    funext t
    have hsa : IsSelfAdjoint (S.evolution a t) := by
      unfold evolution
      exact IsSelfAdjoint.cfc
    exact hsa.isSymmetric.apply_clm (u : H) (v : H)
  have hleft : HasDerivWithinAt
      (fun t : ℝ => ⟪S.evolution a t (u : H), (v : H)⟫_ℂ)
      (-⟪S.generator a u, (v : H)⟫_ℂ) (Set.Ioi 0) 0 := by
    simpa only [inner_zero_right, zero_add, inner_neg_left] using
      (HasDerivWithinAt.inner ℂ (S.hasDerivWithinAt_generator a u)
        (hasDerivWithinAt_const (0 : ℝ) (Set.Ioi 0) (v : H)))
  have hright : HasDerivWithinAt
      (fun t : ℝ => ⟪(u : H), S.evolution a t (v : H)⟫_ℂ)
      (-⟪(u : H), S.generator a v⟫_ℂ) (Set.Ioi 0) 0 := by
    simpa only [inner_neg_right, inner_zero_left, add_zero] using
      (HasDerivWithinAt.inner ℂ
        (hasDerivWithinAt_const (0 : ℝ) (Set.Ioi 0) (u : H))
        (S.hasDerivWithinAt_generator a v))
  rw [heq] at hleft
  have hneg : -⟪S.generator a u, (v : H)⟫_ℂ =
      -⟪(u : H), S.generator a v⟫_ℂ :=
    (hleft.derivWithin (uniqueDiffWithinAt_Ioi 0)).symm.trans
      (hright.derivWithin (uniqueDiffWithinAt_Ioi 0))
  exact neg_injective hneg

theorem generatorDomain_eq_resolvent_range_and_selfAdjoint
    (S : PositiveTransferOperator H) {a : ℝ} (ha : 0 < a) (hS : DenseRange S.op) :
    S.generatorDomain a = (S.resolventMinusOne a).range ∧
      IsSelfAdjoint (S.generatorPMap a) := by
  have hRD (x : H) : ∃ hx : S.resolventMinusOne a x ∈ S.generatorDomain a,
      S.generator a ⟨S.resolventMinusOne a x, hx⟩ = x - S.resolventMinusOne a x :=
    S.generator_eq_of_hasDerivWithinAt (S.hasDerivWithinAt_resolvent ha hS x)
  let A : H →ₗ.[ℂ] H := S.generatorPMap a
  let R : H →L[ℂ] H := S.resolventMinusOne a
  have hsym : A.IsFormalAdjoint A := S.generatorPMap_isFormalAdjoint a
  have hRsa : IsSelfAdjoint R := S.resolventMinusOne_selfAdjoint a
  have hRker : R.ker = ⊥ := by
    apply LinearMap.ker_eq_bot'.mpr
    intro x hx
    change R x = 0 at hx
    obtain ⟨hm, hv⟩ := hRD x
    have hz : (⟨R x, hm⟩ : S.generatorDomain a) = 0 := Subtype.ext hx
    rw [hz, map_zero] at hv
    change (0 : H) = x - R x at hv
    simpa only [hx, sub_zero] using hv.symm
  have hrecover (u v : H)
      (hp : ∀ w : A.domain, ⟪v, (w : H)⟫_ℂ = ⟪u, A w⟫_ℂ) :
      R (u + v) = u := by
    apply ext_inner_right ℂ
    intro x
    obtain ⟨hx, hgx⟩ := hRD x
    have hpR := hp ⟨R x, hx⟩
    change ⟪v, R x⟫_ℂ = ⟪u, S.generator a ⟨R x, hx⟩⟫_ℂ at hpR
    rw [hgx, inner_sub_right] at hpR
    calc
      ⟪R (u + v), x⟫_ℂ = ⟪u + v, R x⟫_ℂ :=
        hRsa.isSymmetric.apply_clm (u + v) x
      _ = ⟪u, x⟫_ℂ := by rw [inner_add_left, hpR]; abel
  have hdom : A.domain = R.range := by
    apply le_antisymm
    · intro u hu
      exact ⟨u + A ⟨u, hu⟩,
        hrecover u (A ⟨u, hu⟩) (fun w => hsym ⟨u, hu⟩ w)⟩
    · rintro u ⟨x, rfl⟩
      obtain ⟨hx, _⟩ := hRD x
      exact hx
  have hdense : Dense (A.domain : Set H) := by
    rw [hdom, Submodule.dense_iff_topologicalClosure_eq_top,
      Submodule.topologicalClosure_eq_top_iff, R.orthogonal_range, hRsa.adjoint_eq]
    exact hRker
  have hle : A ≤ A.adjoint :=
    LinearPMap.IsFormalAdjoint.le_adjoint hdense hsym
  have hadj : A.adjoint.IsFormalAdjoint A :=
    LinearPMap.adjoint_isFormalAdjoint hdense
  have hback : A.adjoint.domain ≤ A.domain := by
    intro y hy
    have hr := hrecover y (A.adjoint ⟨y, hy⟩) (hadj ⟨y, hy⟩)
    rw [hdom]
    exact ⟨y + A.adjoint ⟨y, hy⟩, hr⟩
  have heq : A = A.adjoint :=
    LinearPMap.eq_of_le_of_domain_eq hle (le_antisymm hle.1 hback)
  exact ⟨hdom, LinearPMap.isSelfAdjoint_def.mpr heq.symm⟩

end PositiveTransferOperator

open JesseMath.Physics.YangMillsRenormalizedObservableLimits
open JesseMath.Physics.YangMillsOsterwalderSchraderInheritance

theorem wilsonLimit_generatorDomain_eq_resolvent_range_and_selfAdjoint
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s : ℚ} (hs : 0 < s) :
    let S := wilsonLimitTransfer P Z hP hZ R ν hν hs.le
    S.generatorDomain (s : ℝ) = (S.resolventMinusOne (s : ℝ)).range ∧
      IsSelfAdjoint (S.generatorPMap (s : ℝ)) := by
  exact (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).generatorDomain_eq_resolvent_range_and_selfAdjoint
    (by exact_mod_cast hs)
      (wilsonLimitTransfer_injective_and_denseRange P Z hP hZ R ν hν hs).2

end OSGeneratorDomain

section OSPhysicalTime

open Filter MeasureTheory
open scoped Topology InnerProductSpace
open JesseMath.Physics.YangMillsPhysicalGap
open JesseMath.Physics.YangMillsRenormalizedObservableLimits
open JesseMath.Physics.YangMillsOsterwalderSchraderInheritance

theorem reconstructedTransfer_eq_cfc_rpow
    (L : ReflectionPositiveLaw)
    (hτ : ∀ r : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift r)) = L.law)
    {s q : ℚ} (hs : 0 < s) (hq : 0 ≤ q) :
    reconstructedTransfer L hq (hτ q) =
      cfc (fun x : ℝ => x ^ ((q : ℝ) / (s : ℝ)))
        (reconstructedTransfer L hs.le (hτ s)) := by
  let T : ℚ → (OSHilbert L →L[ℂ] OSHilbert L) := fun r =>
    if hr : 0 ≤ r then reconstructedTransfer L hr (hτ r) else 1
  have hT : ∀ (r : ℚ) (hr : 0 ≤ r),
      T r = reconstructedTransfer L hr (hτ r) := by
    intro r hr
    simp only [T, dite_eq_left hr]
  have hzero : T 0 = 1 := by
    rw [hT 0 le_rfl]
    exact reconstructedTransfer_zero_of_invariant L hτ
  have hpos : ∀ r : ℚ, 0 ≤ r → 0 ≤ T r := by
    intro r hr
    rw [hT r hr]
    exact (reconstructedTransferOperator L hr (hτ (r / 2))).nonneg
  have hadd : ∀ r t : ℚ, 0 ≤ r → 0 ≤ t → T (r + t)=T r*T t := by
    intro r t hr ht
    rw [hT (r+t) (add_nonneg hr ht), hT r hr, hT t ht]
    exact reconstructedTransfer_add_of_invariant L hτ hr ht
  obtain ⟨m, n, hn, hratio⟩ :
      ∃ m n : ℕ, 0 < n ∧ q / s = (m : ℚ) / n := by
    let z : ℚ := q / s
    have hnum : 0 ≤ z.num := Rat.num_nonneg.mpr (div_nonneg hq hs.le)
    have hcast : (z.num.natAbs : ℚ) = (z.num : ℚ) := by
      rw [Nat.cast_natAbs, abs_of_nonneg (by exact_mod_cast hnum)]
    refine ⟨z.num.natAbs, z.den, z.den_pos, ?_⟩
    rw [hcast, z.num_div_den]
  have hnQ : 0 < (n : ℚ) := by exact_mod_cast hn
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  let r : ℚ := s / n
  have hr : 0 ≤ r := div_nonneg hs.le hnQ.le
  have hnr : (n : ℚ) * r = s := by
    dsimp [r]
    field_simp [hnQ.ne']
  have hmr : (m : ℚ) * r = q := by
    change (m : ℚ) * (s / n) = q
    calc
      (m : ℚ) * (s / n) = ((m : ℚ) / n) * s := by ring
      _ = (q / s) * s := by rw [hratio]
      _ = q := div_mul_cancel₀ q hs.ne'
  let A : OSHilbert L →L[ℂ] OSHilbert L := T r
  have hA : 0 ≤ A := hpos r hr
  have hTs : T s = A ^ n := by
    simpa only [hnr] using
      nonnegativeRatSemigroup_nat_mul (OSHilbert L →L[ℂ] OSHilbert L)
        T hzero hadd r hr n
  have hTq : T q = A ^ m := by
    simpa only [hmr] using
      nonnegativeRatSemigroup_nat_mul (OSHilbert L →L[ℂ] OSHilbert L)
        T hzero hadd r hr m
  have hratioR : (q : ℝ) / (s : ℝ) = (m : ℝ) / (n : ℝ) := by
    have h := congrArg (fun z : ℚ => (z : ℝ)) hratio
    simpa only [Rat.cast_div, Rat.cast_natCast] using h
  have hα : 0 ≤ (q : ℝ) / (s : ℝ) := by
    exact div_nonneg (Rat.cast_nonneg.mpr hq) (Rat.cast_nonneg.mpr hs.le)
  have hmul : (n : ℝ) * ((q : ℝ) / (s : ℝ)) = (m : ℝ) := by
    rw [hratioR]
    field_simp [hnR]
  rw [← hT q hq, ← hT s hs.le]
  calc
    T q = A ^ m := hTq
    _ = CFC.rpow A (m : ℝ) := (CFC.rpow_natCast A m hA).symm
    _ = CFC.rpow A ((n : ℝ) * ((q : ℝ) / (s : ℝ))) := by rw [hmul]
    _ = CFC.rpow (CFC.rpow A (n : ℝ)) ((q : ℝ) / (s : ℝ)) :=
      (CFC.rpow_rpow_of_exponent_nonneg A (n : ℝ)
        ((q : ℝ) / (s : ℝ)) (Nat.cast_nonneg n) hα hA).symm
    _ = CFC.rpow (A ^ n) ((q : ℝ) / (s : ℝ)) :=
      congrArg (fun B : OSHilbert L →L[ℂ] OSHilbert L => CFC.rpow B ((q : ℝ) / (s : ℝ)))
        (CFC.rpow_natCast A n hA)
    _ = CFC.rpow (T s) ((q : ℝ) / (s : ℝ)) := by rw [hTs]
    _ = cfc (fun x : ℝ => x ^ ((q : ℝ) / (s : ℝ))) (T s) :=
      CFC.rpow_eq_cfc_real (hpos s hs.le)

namespace PositiveTransferOperator
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem continuousWithinAt_evolution_zero (S : PositiveTransferOperator H)
    {a : ℝ} (ha : 0 < a) (hS : Function.Injective S.op) (u : H) :
    ContinuousWithinAt (fun t : ℝ => S.evolution a t u) (Set.Ici 0) 0 := by
  have hSd : DenseRange S.op := by
    change Dense (S.op.range : Set H)
    rw [Submodule.dense_iff_topologicalClosure_eq_top,
      Submodule.topologicalClosure_eq_top_iff, S.op.orthogonal_range,
      S.isSelfAdjoint.adjoint_eq]
    exact LinearMap.ker_eq_bot.mpr hS
  have hR := S.resolventMinusOne_denseRange ha hS
  let P : ℝ → H →L[ℂ] H := fun t => if 0 ≤ t then S.evolution a t else 0
  have hP : ∀ t, ‖P t‖ ≤ 1 := by
    intro t
    dsimp only [P]
    split_ifs with ht
    · exact S.norm_evolution_le_one ha ht
    · simp
  have heq : ∀ᶠ t in (𝓝[≥] (0 : ℝ)), P t = S.evolution a t := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact ite_eq_left ht
  have hequi : Equicontinuous (fun t x => P t x) := by
    have he : Equicontinuous (fun t x => P t x) ↔ ∃ C, ∀ t, ‖P t‖ ≤ C :=
      (NormedSpace.equicontinuous_TFAE P).out 2 6
    exact he.mpr ⟨1, hP⟩
  have hPall : Tendsto (fun t => P t u) (𝓝[≥] (0 : ℝ)) (𝓝 u) := by
    apply (hequi u).tendsto_of_mem_closure
      (s := Set.range (S.resolventMinusOne a)) (f := fun x : H => x)
    · exact continuousAt_id.continuousWithinAt
    · rintro y ⟨x, rfl⟩
      have hc := continuousWithinAt_Ioi_iff_Ici.mp
        (S.hasDerivWithinAt_resolvent ha hSd x).continuousWithinAt
      have hl : Tendsto (fun t : ℝ => S.evolution a t (S.resolventMinusOne a x))
          (𝓝[≥] (0 : ℝ)) (𝓝 (S.resolventMinusOne a x)) := by
        simpa only [S.evolution_zero, one_apply_eq_self] using hc.tendsto
      apply hl.congr'
      filter_upwards [heq] with t ht
      rw [ht]
    · exact hR u
  change Tendsto (fun t : ℝ => S.evolution a t u) (𝓝[≥] (0 : ℝ))
    (𝓝 (S.evolution a 0 u))
  rw [S.evolution_zero, one_apply_eq_self]
  apply hPall.congr'
  filter_upwards [heq] with t ht
  rw [ht]

theorem evolution_dist_le_zero (S : PositiveTransferOperator H)
    {a t s : ℝ} (ha : 0 < a) (ht : 0 ≤ t) (hs : 0 ≤ s) (u : H) :
    dist (S.evolution a t u) (S.evolution a s u) ≤
      dist (S.evolution a |t - s| u) u := by
  have hstep (v w : ℝ) (hv : 0 ≤ v) (hvw : v ≤ w) :
      dist (S.evolution a w u) (S.evolution a v u) ≤
        dist (S.evolution a (w - v) u) u := by
    have he : S.evolution a w = S.evolution a v * S.evolution a (w - v) := by
      have h := S.evolution_add ha hv (sub_nonneg.mpr hvw)
      rwa [show v + (w - v) = w by ring] at h
    rw [he, mul_apply_eq_comp]
    exact ((S.evolution a v).dist_le_opNorm _ _).trans (by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right
        (S.norm_evolution_le_one ha hv)
        (dist_nonneg : 0 ≤ dist (S.evolution a (w - v) u) u))
  rcases le_total s t with hst | hts
  · rw [abs_of_nonneg (sub_nonneg.mpr hst)]
    exact hstep s t hs hst
  · rw [dist_comm (S.evolution a t u) (S.evolution a s u),
      abs_of_nonpos (sub_nonpos.mpr hts), neg_sub]
    exact hstep t s ht hts

theorem continuousOn_evolution (S : PositiveTransferOperator H)
    {a : ℝ} (ha : 0 < a) (hS : Function.Injective S.op) (u : H) :
    ContinuousOn (fun t : ℝ => S.evolution a t u) (Set.Ici 0) := by
  have hz := Metric.continuousWithinAt_iff.mp
    (S.continuousWithinAt_evolution_zero ha hS u)
  rw [Metric.continuousOn_iff]
  intro s hs ε hε
  obtain ⟨δ, hδ, hb⟩ := hz ε hε
  refine ⟨δ, hδ, ?_⟩
  intro t ht hts
  have hd : dist |t - s| (0 : ℝ) < δ := by
    simpa only [Real.dist_eq, sub_zero, abs_abs] using hts
  have hbound := hb (abs_nonneg (t - s)) hd
  rw [S.evolution_zero, one_apply_eq_self] at hbound
  exact lt_of_le_of_lt (S.evolution_dist_le_zero ha ht hs u) hbound

theorem generator_form_nonneg (S : PositiveTransferOperator H) {a : ℝ}
    (ha : 0 < a) (u : S.generatorDomain a) :
    0 ≤ (⟪(u : H), S.generator a u⟫_ℂ).re := by
  have h := generator_coercivity_of_decay (S.evolution a) (u : H)
    (S.generator a u) 0 (by rw [S.evolution_zero]; rfl)
    (S.hasDerivWithinAt_generator a u) (fun t ht => by
      simpa only [neg_zero, zero_mul, Real.exp_zero, one_mul] using
        (ContinuousLinearMap.le_opNorm (S.evolution a t) (u : H)).trans
          (mul_le_mul_of_nonneg_right (S.norm_evolution_le_one ha ht.le)
            (norm_nonneg (u : H))))
  simpa only [zero_mul] using h

end PositiveTransferOperator

theorem wilsonLimitTransfer_eq_evolution
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s q : ℚ} (hs : 0 < s) (hq : 0 ≤ q) :
    (wilsonLimitTransfer P Z hP hZ R ν hν hq).op =
      (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).evolution (s : ℝ) (q : ℝ) := by
  let L := wilsonLimitLaw P Z hP hZ R ν hν
  have hτ : ∀ q : ℚ, (L.law : Measure WilsonLoopSpace).map
      (translateObservables (timeShift q)) = L.law := by
    intro q
    exact congrArg (fun μ : ProbabilityMeasure WilsonLoopSpace => (μ : Measure WilsonLoopSpace))
      (R.translation_invariant ν hν (timeShift q))
  exact reconstructedTransfer_eq_cfc_rpow L hτ hs hq

theorem wilsonLimit_evolution_continuousOn
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath) (hP : P.IsDyadic)
    (hZ : HasReflectionInvariantFactors Z) (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s : ℚ} (hs : 0 < s) (u : OSHilbert (wilsonLimitLaw P Z hP hZ R ν hν)) :
    ContinuousOn (fun t : ℝ => (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).evolution
      (s : ℝ) t u) (Set.Ici 0) := by
  exact (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).continuousOn_evolution
    (by exact_mod_cast hs)
    (wilsonLimitTransfer_injective_and_denseRange P Z hP hZ R ν hν hs).1 u

theorem wilsonLimit_generator_selfAdjoint_nonneg_and_vacuum
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic) (hZ : HasReflectionInvariantFactors Z)
    (R : WilsonLimitRegularity P Z) (ν : ProbabilityMeasure WilsonLoopSpace)
    (hν : Z.IsLimitLaw ν) {s : ℚ} (hs : 0 < s) :
    let S := wilsonLimitTransfer P Z hP hZ R ν hν hs.le
    IsSelfAdjoint (S.generatorPMap (s : ℝ)) ∧
    (∀ u : (S.generatorPMap (s : ℝ)).domain,
      0 ≤ (⟪(u : OSHilbert (wilsonLimitLaw P Z hP hZ R ν hν)),
        S.generatorPMap (s : ℝ) u⟫_ℂ).re) ∧
    (∃ h : S.vacuum ∈ (S.generatorPMap (s : ℝ)).domain,
      S.generatorPMap (s : ℝ) ⟨S.vacuum, h⟩ = 0) := by
  let S := wilsonLimitTransfer P Z hP hZ R ν hν hs.le
  have ha : 0 < (s : ℝ) := by exact_mod_cast hs
  exact ⟨(wilsonLimit_generatorDomain_eq_resolvent_range_and_selfAdjoint
    P Z hP hZ R ν hν hs).2, fun u => S.generator_form_nonneg ha u, S.generator_vacuum ha⟩

theorem wilsonLimit_evolution_baseTime_independent
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic) (hZ : HasReflectionInvariantFactors Z)
    (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s r : ℚ} (hs : 0 < s) (hr : 0 < r) {t : ℝ} (ht : 0 ≤ t) :
    (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).evolution (s : ℝ) t =
      (wilsonLimitTransfer P Z hP hZ R ν hν hr.le).evolution (r : ℝ) t := by
  ext u
  let S := wilsonLimitTransfer P Z hP hZ R ν hν hs.le
  let B := wilsonLimitTransfer P Z hP hZ R ν hν hr.le
  have hcs : ContinuousOn (fun v : ℝ => S.evolution (s : ℝ) v u) (Set.Ici 0) :=
    wilsonLimit_evolution_continuousOn P Z hP hZ R ν hν hs u
  have hcr : ContinuousOn (fun v : ℝ => B.evolution (r : ℝ) v u) (Set.Ici 0) :=
    wilsonLimit_evolution_continuousOn P Z hP hZ R ν hν hr u
  let D : Set ℝ := Set.Ioi 0 ∩ Set.range ((↑) : ℚ → ℝ)
  have hopen : Set.Ioi (0 : ℝ) ⊆ closure D :=
    (Rat.denseRange_cast : DenseRange ((↑) : ℚ → ℝ)).open_subset_closure_inter
      isOpen_Ioi
  have hclosed : Set.Ici (0 : ℝ) ⊆ closure D := by
    simpa only [closure_Ioi, closure_closure] using closure_mono hopen
  have heq : Set.EqOn (fun v : ℝ => S.evolution (s : ℝ) v u)
      (fun v : ℝ => B.evolution (r : ℝ) v u) D := by
    rintro v ⟨hv, q, rfl⟩
    have hvp : 0 < (q : ℝ) := hv
    have hq : 0 ≤ q := Rat.cast_nonneg.mp hvp.le
    exact congrArg (fun A : WilsonLimitHilbert P Z hP hZ R ν hν →L[ℂ]
        WilsonLimitHilbert P Z hP hZ R ν hν => A u)
      ((wilsonLimitTransfer_eq_evolution P Z hP hZ R ν hν hs hq).symm.trans
        (wilsonLimitTransfer_eq_evolution P Z hP hZ R ν hν hr hq))
  have hD : D ⊆ Set.Ici 0 := by
    intro v hv
    exact (show (0 : ℝ) < v from hv.1).le
  exact heq.of_subset_closure hcs hcr hD hclosed ht

theorem wilsonLimit_generator_baseTime_independent
    (P : ContinuumCutoffPath) (Z : LoopRenormalization P.toCutoffPath)
    (hP : P.IsDyadic) (hZ : HasReflectionInvariantFactors Z)
    (R : WilsonLimitRegularity P Z)
    (ν : ProbabilityMeasure WilsonLoopSpace) (hν : Z.IsLimitLaw ν)
    {s r : ℚ} (hs : 0 < s) (hr : 0 < r) :
    (wilsonLimitTransfer P Z hP hZ R ν hν hs.le).generatorPMap (s : ℝ) =
      (wilsonLimitTransfer P Z hP hZ R ν hν hr.le).generatorPMap (r : ℝ) := by
  let S := wilsonLimitTransfer P Z hP hZ R ν hν hs.le
  let B := wilsonLimitTransfer P Z hP hZ R ν hν hr.le
  have heq (t : ℝ) (ht : 0 ≤ t) (u : WilsonLimitHilbert P Z hP hZ R ν hν) :
      S.evolution (s : ℝ) t u = B.evolution (r : ℝ) t u :=
    congrArg (fun A : WilsonLimitHilbert P Z hP hZ R ν hν →L[ℂ]
      WilsonLimitHilbert P Z hP hZ R ν hν => A u)
      (wilsonLimit_evolution_baseTime_independent P Z hP hZ R ν hν hs hr ht)
  have hdom : S.generatorDomain (s : ℝ) = B.generatorDomain (r : ℝ) := by
    ext u
    change DifferentiableWithinAt ℝ (fun t : ℝ => S.evolution (s : ℝ) t u) (Set.Ioi 0) 0 ↔
      DifferentiableWithinAt ℝ (fun t : ℝ => B.evolution (r : ℝ) t u) (Set.Ioi 0) 0
    constructor <;> intro hu
    · exact hu.congr (fun t ht => (heq t (show 0 < t from ht).le u).symm)
        (heq 0 le_rfl u).symm
    · exact hu.congr (fun t ht => heq t (show 0 < t from ht).le u) (heq 0 le_rfl u)
  apply LinearPMap.ext hdom
  intro u hu hv
  change -(derivWithin (fun t : ℝ => S.evolution (s : ℝ) t u) (Set.Ioi 0) 0) =
    -(derivWithin (fun t : ℝ => B.evolution (r : ℝ) t u) (Set.Ioi 0) 0)
  exact congrArg Neg.neg (derivWithin_congr
    (fun t ht => heq t (show 0 < t from ht).le u) (heq 0 le_rfl u))

