    refine integral_mul_sideWeight_probes_eq_sideBridge hL β 3 _ (by fun_prop) (fun U g => ?_) (fun U g => ?_)
    · rw [probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 3) g,
