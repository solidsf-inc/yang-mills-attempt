theorem canonicalCrossoverBetaLo_le_half_oneLoopDeltaBeta :
    (canonicalCrossoverBetaLo : ℝ) ≤ (1 / 2 : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) := by
  have hpi_pos : 0 < Real.pi := Real.pi_pos
  have hpi_lt : Real.pi < 4 := Real.pi_lt_four
  have hpi_sq_le : Real.pi ^ 2 ≤ 16 := by nlinarith
  have hlog2_ge : (1 / 2 : ℝ) ≤ Real.log 2 := by
    have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    linarith
  have h_inv_ge : (1 / 48 : ℝ) ≤ 1 / (3 * Real.pi ^ 2) := by
    rw [one_div_le_one_div (by positivity) (by positivity)]
    linarith
  have h_prod : (11 / 192 : ℝ) ≤ (1 / 2 : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) := by
    have h1 : (11 / 48 : ℝ) ≤ 11 / (3 * Real.pi ^ 2) := by
      simpa [div_eq_mul_inv] using mul_le_mul_of_nonneg_left h_inv_ge (by norm_num : (0 : ℝ) ≤ 11)
    nlinarith
  have h_lo : (canonicalCrossoverBetaLo : ℝ) ≤ 11 / 192 := by
    norm_num [canonicalCrossoverBetaLo]
  exact h_lo.trans h_prod

/-- **Set 4 (`Argon`) Obligation `R5` 18/20 Field Reduction Constructor:**
    Unconditionally discharges 18 out of 20 fields of `BalabanMultiScaleUVToIRFlow dyadicOneLoopPath`
    (`ℓstar, hℓstar, K, hK, irSide, instNeZeroIrSide, hside, chain, Δβ_1loop, hΔβ_1loop_pos,
    δ_2loop, hδ_2loop_bounds, h_β_drift, h_β_absorb, h_β_ir_lo, h_polymer_local, Z_tube, hZ_tube_scheme`),
    reducing `BalabanMultiScaleUVToIRFlow dyadicOneLoopPath` to the exact 2 non-perturbative
    remainder obligations (`h_R_mixed` and `h_rem_local_osc`). -/
noncomputable def ARGON_SET4_R5_BalabanMultiScaleUVToIRFlow_of_two_core_obligations
    (h_R_mixed : ∀ n : ℕ, 0 < n →
      ∀ (V : GaugeConfig (dyadicScaleSide (2 ^ n) 0))
        (e e' : Link (dyadicScaleSide (2 ^ n) 0)) (g1 g2 h1 h2 : SU2),
        |twoLinkMixedDifference (dyadicScaleSide (2 ^ n) 0)
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
          if e' ∈ dobrushinNeighbors e then canonicalBalabanDeltaNbStep (n - 0) else 0)
    (h_rem_local_osc : ∀ (n : ℕ) (V : GaugeConfig (2 ^ n)) (e : Link (2 ^ n)) (g1 g2 : SU2),
      InteractingEffectiveActionState.probeLoopOscillationBudget ((1 : ℚ) : ℝ)
        (canonicalSpatialProbe 1 (by norm_num)) *
        |(((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).polymers.eval
            (updateGaugeLink (2 ^ n) V e.x e.μ g1) +
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
            (updateGaugeLink (2 ^ n) V e.x e.μ g1)) -
        (((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).polymers.eval
            (updateGaugeLink (2 ^ n) V e.x e.μ g2) +
          ((scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
            (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)).state 0).R_trunc
            (updateGaugeLink (2 ^ n) V e.x e.μ g2))| ≤
        (canonicalCrossoverCovLo : ℝ) / 24) :
    BalabanMultiScaleUVToIRFlow dyadicOneLoopPath where
  ℓstar := 1
  hℓstar := by norm_num
  K := fun n => n
  hK := by
    filter_upwards with n
    dsimp [dyadicOneLoopPath]
    have hpow : (2 : ℝ) ^ n ≠ 0 := pow_ne_zero n (by norm_num)
    rw [one_div_pow, div_mul_cancel₀ 1 hpow]
    norm_num
  irSide := fun n => 2 ^ n
  instNeZeroIrSide := fun n => ⟨pow_ne_zero n (by decide)⟩
  hside := by
    filter_upwards with n
    dsimp [dyadicOneLoopPath]
    rw [dyadicScaleSide_eq_two_pow_mul, ← Nat.mul_pow]
  chain := fun n =>
    scheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
      (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n)
  Δβ_1loop := 11 / (3 * Real.pi ^ 2) * Real.log 2
  hΔβ_1loop_pos := by
    have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hpi : 0 < Real.pi := Real.pi_pos
    positivity
  δ_2loop := fun _ k => if k = 0 then (canonicalCrossoverBetaLo : ℝ) else 0
  hδ_2loop_bounds := fun _ k => by
    split_ifs with hk
    · exact ⟨by norm_num [canonicalCrossoverBetaLo], canonicalCrossoverBetaLo_le_half_oneLoopDeltaBeta⟩
    · have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
      have hpi : 0 < Real.pi := Real.pi_pos
      exact ⟨le_rfl, by positivity⟩
  h_β_drift := fun n m hm => by
    rw [balabanOneLoopDriftChain_state_beta_eq_of_lt n m hm]
    rcases lt_or_eq_of_le (Nat.succ_le_of_lt hm) with hm1 | hm1
    · have hk_ne : n - 1 - m ≠ 0 := by omega
      rw [balabanOneLoopDriftChain_state_beta_eq_of_lt n (m + 1) hm1]
      simp only [hk_ne, ↓reduceIte, Nat.cast_add, Nat.cast_one]
      linarith
    · have hk_eq : n - 1 - m = 0 := by omega
      have h_m1 : m + 1 = n := hm1
      rw [h_m1, balabanOneLoopDriftChain_state_uv_beta_eq n]
      have h_cast : (n : ℝ) = (m : ℝ) + 1 := by exact_mod_cast hm1.symm
      simp only [hk_eq, ↓reduceIte, h_cast]
      linarith
  h_β_absorb := by
    filter_upwards [eventually_ge_atTop 1] with n hn
    have h_sum :
        (∑ k ∈ Finset.range n, (if k = 0 then (canonicalCrossoverBetaLo : ℝ) else 0)) =
          (canonicalCrossoverBetaLo : ℝ) := by
      have h0 : 0 ∈ Finset.range n := Finset.mem_range.mpr hn
