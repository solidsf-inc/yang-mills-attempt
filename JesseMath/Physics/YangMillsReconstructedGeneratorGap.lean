            ΦB U * ΦT U) =
          fun U => (probeExteriorBoltzmannWeight β U *
            sideWeight L β 1 U * sideWeight L β 2 U * sideWeight L β 3 U) *
            sideWeight L β 0 U * ΦB U * ΦT U := by funext U; ring
    have h_a2 :
        (fun U => probeExteriorBoltzmannWeight β U *
