theorem crossoverLandingChain_state_zero_beta_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) (hK : 0 < K) :
    ((scheduledHaarRGChain L_ir K hβ crossoverLandingSchedule crossoverLandingSchedule_nonneg).state 0).β =
      (canonicalCrossoverBetaLo : ℝ) := by
  obtain ⟨j, hj⟩ : ∃ j, K - 0 = j + 1 := Nat.exists_eq_succ_of_ne_zero (by omega)
  change (scheduledHaarRGState L_ir K β_uv crossoverLandingSchedule 0).β = (canonicalCrossoverBetaLo : ℝ)
  have h0 : 0 ≤ K := Nat.zero_le K
