            sideWeight L β 1 U * sideWeight L β 2 U * sideWeight L β 3 U) *
            sideBridge L β 0 U * ΦB U * ΦT U := by funext U; ring
    rw [h_a1, h_a2]
    refine integral_mul_sideWeight_probes_eq_sideBridge hL β 0 _ (by fun_prop) (fun U g => ?_) (fun U g => ?_)
    · rw [probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 0) g,
          sideWeight_update_bottom_of_ne hL β (by decide : (0 : Fin 4) ≠ 1) U g,
