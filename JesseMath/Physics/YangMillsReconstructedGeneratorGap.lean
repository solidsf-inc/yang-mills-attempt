      refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
        hL2 (cubeBottomPlaquette L) (plaquetteLinkAt (cubeBottomPlaquette L) k)
        (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k) _ h_cont (fun U g => ?_)
      rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ hk1 g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ hk2 g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ hk3 g,
          plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) hk_top g]
  · have hq₁ : q₁ ≠ cubeTopPlaquette L := fun h => h_top (Or.inl h)
    have hq₂ : q₂ ≠ cubeTopPlaquette L := fun h => h_top (Or.inr (Or.inl h))
    have hq₃ : q₃ ≠ cubeTopPlaquette L := fun h => h_top (Or.inr (Or.inr h))
    let Q : Fin 3 → Plaquette L := ![q₁, q₂, q₃]
    have hQ : ∀ j : Fin 3, Q j ≠ cubeTopPlaquette L := by
      intro j; fin_cases j <;> [exact hq₁; exact hq₂; exact hq₃]
    obtain ⟨k, hk⟩ := exists_plaquetteLinkAt_not_mem_of_ne hL (cubeTopPlaquette L) le_rfl Q hQ
    have hk1 : plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks q₁ := hk 0
    have hk2 : plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks q₂ := hk 1
    have hk3 : plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks q₃ := hk 2
    have hk_bot : plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks (cubeBottomPlaquette L) :=
      not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
        (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)
    have h_cont :
        Continuous (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) :=
      (((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃))).mul
