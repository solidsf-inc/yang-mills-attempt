    have h_a2 :
        (fun U => probeExteriorBoltzmannWeight β U *
            sideBridge L β 0 U * sideBridge L β 1 U * sideBridge L β 2 U * sideWeight L β 3 U *
            ΦB U * ΦT U) =
          fun U => (probeExteriorBoltzmannWeight β U *
            sideBridge L β 0 U * sideBridge L β 1 U * sideWeight L β 3 U) *
            sideBridge L β 2 U * ΦB U * ΦT U := by funext U; ring
    rw [h_a1, h_a2]
    refine integral_mul_sideWeight_probes_eq_sideBridge hL β 2 _ (by fun_prop) (fun U g => ?_) (fun U g => ?_)
    · rw [probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U (plaquetteLinkAt_cubeBottomPlaquette_mem_probeLinks L 2) g,
          sideBridge_update_bottom_of_ne hL β (by decide : (2 : Fin 4) ≠ 0) U g,
          sideBridge_update_bottom_of_ne hL β (by decide : (2 : Fin 4) ≠ 1) U g,
