        |groupTwoLinkMixedDifference L st.totalAction V e.x e.μ g 1 e'.x e'.μ (h1 e') (h2 e')| ≤
          Δ e' := by
      have h_ne : e' ≠ e := (Finset.mem_erase.mp he').1
      have h_split :
          groupTwoLinkMixedDifference L st.totalAction V e.x e.μ g 1 e'.x e'.μ (h1 e') (h2 e') =
            groupTwoLinkMixedDifference L (groupWilsonAction su2CompactGaugeClassTrace st.β)
