theorem ARGON_SET4_R3_multiscale_covariance_defect_telescope
    (C δ : ℕ → ℝ) (K : ℕ)
    (hstep : ∀ m < K, |C m - C (m + 1)| ≤ δ m) :
    |C 0 - C K| ≤ ∑ m ∈ Finset.range K, δ m ∧
    |C K| - ∑ m ∈ Finset.range K, δ m ≤ |C 0| := by
  have htel : |C 0 - C K| ≤ ∑ m ∈ Finset.range K, δ m := by
    induction K with
    | zero => simp
    | succ k ih =>
