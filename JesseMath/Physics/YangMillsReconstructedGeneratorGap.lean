/-- Shifting the fine-lattice action `S` by an additive constant `c : ℝ` shifts
    `interactingBlockedEffectiveAction D 0 (fun U => c + S U) V` by exactly `+ c`. -/
theorem interactingBlockedEffectiveAction_zero_add_const
    {L : ℕ} [NeZero L] [NeZero (2 * L)]
    (D : ConditionalBlockFiberDisintegration L)
    (c : ℝ) {S : GaugeConfig (2 * L) → ℝ} {S_lo S_hi : ℝ}
    (hS_meas : Measurable S)
    (hS_bounds : ∀ U : GaugeConfig (2 * L), S_lo ≤ S U ∧ S U ≤ S_hi)
    (V : GaugeConfig L) :
    interactingBlockedEffectiveAction D 0 (fun U => c + S U) V =
      c + interactingBlockedEffectiveAction D 0 S V := by
  have hW_pos : 0 < interactingBlockedFiberWeight D 0 S V :=
    (interactingBlockedFiberWeight_zero_remainder_and_exponential_sandwich
      D le_rfl (measurable_wilsonAction 0) S hS_meas hS_bounds V).2.1.2.2
  have hW_mul :
      interactingBlockedFiberWeight D 0 (fun U => c + S U) V =
        Real.exp (-c) * interactingBlockedFiberWeight D 0 S V := by
    unfold interactingBlockedFiberWeight
    have h_pt : (fun U : GaugeConfig (2 * L) => Real.exp (-wilsonAction 0 U - (c + S U))) =
        fun U => Real.exp (-c) * Real.exp (-wilsonAction 0 U - S U) := by
      funext U
      rw [← Real.exp_add]
      congr 1
      ring
    rw [h_pt, MeasureTheory.integral_const_mul]
  unfold interactingBlockedEffectiveAction
  rw [hW_mul, Real.log_mul (Real.exp_ne_zero (-c)) hW_pos.ne', Real.log_exp (-c)]
  ring

/-- Universal `MultiStepHaarRGChain` total-non-vacuum-action invariance theorem:
    for **every** `C : MultiStepHaarRGChain L_ir K β_uv` (`0 ≤ β_uv`), at every downward step
    `j` and scale `m` with `m + j = K` and every configuration `V : GaugeConfig (dyadicScaleSide L_ir m)`,
    `(C.state m).totalAction V - (C.state m).totalAction (vacuumConfig L_m)` is
    identically equal to the non-vacuum action of `canonicalRGStateAux L_ir β_uv j m`,
    with **zero** extra hypotheses on `C`. -/
theorem MultiStepHaarRGChain.totalAction_sub_vacuum_eq_canonicalRGStateAux
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (C : MultiStepHaarRGChain L_ir K β_uv) :
    ∀ (j m : ℕ) (_hjm : m + j = K) (V : GaugeConfig (dyadicScaleSide L_ir m)),
      let L_m := dyadicScaleSide L_ir m
      let st_c := canonicalRGStateAux L_ir β_uv j m
      (C.state m).totalAction V - (C.state m).totalAction (vacuumConfig L_m) =
        wilsonAction st_c.β V + st_c.polymers.eval V + st_c.R_trunc V
  | 0, m, hjm, V => by
      have hmK : m = K := by omega
      subst hmK
      dsimp only
      rw [C.h_uv]
      dsimp [canonicalRGStateAux, InteractingEffectiveActionState.pureWilson,
        InteractingEffectiveActionState.totalAction]
      simp only [PolymerActivityFamily.eval_empty, wilsonAction_vacuum]
      ring
  | j + 1, m, hjm, V => by
      let L_m := dyadicScaleSide L_ir m
      have hm : m < K := by omega
      have hjm1 : (m + 1) + j = K := by omega
      let st_c_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
      let S_c_prev : GaugeConfig (dyadicScaleSide L_ir (m + 1)) → ℝ :=
        fun U => wilsonAction st_c_prev.β U + st_c_prev.polymers.eval U + st_c_prev.R_trunc U
      have hc_bounds := canonicalRGStateAux_unconditional_R_trunc_bounds L_ir hβ j (m + 1)
      rcases hc_bounds with ⟨_, _, hSc_meas, hSc_vac, hSc_osc, _, _, _⟩
      change S_c_prev (vacuumConfig (dyadicScaleSide L_ir (m + 1))) = 0 at hSc_vac
      let B_S := (Fintype.card (Link (dyadicScaleSide L_ir (m + 1))) : ℝ) * (12 * β_uv)
      have hSc_bdd : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
          -B_S ≤ S_c_prev U ∧ S_c_prev U ≤ B_S := fun U => by
        have h_sub := abs_sub_le_card_mul_singleLink_osc S_c_prev hSc_osc U
          (vacuumConfig (dyadicScaleSide L_ir (m + 1)))
        rw [hSc_vac, sub_zero] at h_sub
        exact abs_le.mp h_sub
      have ih_m1 : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
          (C.state (m + 1)).totalAction U -
            (C.state (m + 1)).totalAction (vacuumConfig (dyadicScaleSide L_ir (m + 1))) =
            S_c_prev U :=
        C.totalAction_sub_vacuum_eq_canonicalRGStateAux hβ j (m + 1) hjm1
      let c_off : ℝ :=
        (C.state (m + 1)).totalAction (vacuumConfig (dyadicScaleSide L_ir (m + 1))) -
          (C.state (m + 1)).c_vac
      have h_S_C_eq :
          (fun U : GaugeConfig (dyadicScaleSide L_ir (m + 1)) =>
            wilsonAction (C.state (m + 1)).β U +
              (C.state (m + 1)).polymers.eval U + (C.state (m + 1)).R_trunc U) =
          fun U => c_off + S_c_prev U := by
        funext U
        have h_u := ih_m1 U
        dsimp only [c_off, InteractingEffectiveActionState.totalAction] at h_u ⊢
        linarith
      have h_step_C := C.step_totalAction_sub_vacuum_eq_blockedEffectiveAction hm V
      have h_step_c := canonicalRGStateAux_totalAction_sub_vacuum_eq_blockedEffectiveAction
        L_ir β_uv j m V
      dsimp only at h_step_C h_step_c ⊢
      rw [h_step_C,
        interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction
          (haarBlockDisintegration L_m) (C.state (m + 1)),
        h_S_C_eq,
        interactingBlockedEffectiveAction_zero_add_const
          (haarBlockDisintegration L_m) c_off hSc_meas hSc_bdd V,
        interactingBlockedEffectiveAction_zero_add_const
          (haarBlockDisintegration L_m) c_off hSc_meas hSc_bdd (vacuumConfig L_m),
        ← interactingBlockedEffectiveAction_eq_zero_beta_totalNonVacuumAction
          (haarBlockDisintegration L_m) st_c_prev]
      let st_c_next := canonicalRGStateAux L_ir β_uv (j + 1) m
      have h_c_vac : st_c_next.totalAction (vacuumConfig L_m) = st_c_next.c_vac :=
        canonicalRGStateAux_totalAction_vacuum_eq_c_vac L_ir β_uv (j + 1) m
      have h_c_decomp :
          st_c_next.totalAction V - st_c_next.totalAction (vacuumConfig L_m) =
            wilsonAction st_c_next.β V + st_c_next.polymers.eval V + st_c_next.R_trunc V := by
        rw [h_c_vac]
        dsimp [InteractingEffectiveActionState.totalAction]
        ring
      linarith [h_step_c, h_c_decomp]

/-- Universal scale-`m` invariance for **every** `C : MultiStepHaarRGChain L_ir K β_uv` (`m ≤ K`):
    the difference `(C.state m).totalAction V₁ - (C.state m).totalAction V₂` between any two
    configurations `V₁, V₂` is completely independent of the choice of chain `C` and equals
    that of `canonicalRGStateAux L_ir β_uv (K - m) m`. -/
theorem MultiStepHaarRGChain.totalAction_sub_eq_canonicalRGStateAux
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m ≤ K) (V₁ V₂ : GaugeConfig (dyadicScaleSide L_ir m)) :
    let st_c := canonicalRGStateAux L_ir β_uv (K - m) m
    let S_c := fun V => wilsonAction st_c.β V + st_c.polymers.eval V + st_c.R_trunc V
    (C.state m).totalAction V₁ - (C.state m).totalAction V₂ = S_c V₁ - S_c V₂ := by
  have hjm : m + (K - m) = K := by omega
  have heq1 := C.totalAction_sub_vacuum_eq_canonicalRGStateAux hβ (K - m) m hjm V₁
  have heq2 := C.totalAction_sub_vacuum_eq_canonicalRGStateAux hβ (K - m) m hjm V₂
  dsimp only at heq1 heq2 ⊢
  linarith

/-- Universal single-link oscillation identity for `polymers.eval + R_trunc` in **every**
    `C : MultiStepHaarRGChain L_ir K β_uv`: at any scale `m ≤ K`, the difference of
    `(C.state m).polymers.eval + (C.state m).R_trunc` between any two configurations `V₁, V₂`
    depends **only** on the scalar coupling `(C.state m).β` and the canonical blocked action `S_c`,
    and is completely independent of how `polymers` and `R_trunc` are split! -/
theorem MultiStepHaarRGChain.polymers_add_R_trunc_sub_eq_canonicalRGStateAux
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m ≤ K) (V₁ V₂ : GaugeConfig (dyadicScaleSide L_ir m)) :
    let st_c := canonicalRGStateAux L_ir β_uv (K - m) m
    let S_c := fun V => wilsonAction st_c.β V + st_c.polymers.eval V + st_c.R_trunc V
    (((C.state m).polymers.eval V₁ + (C.state m).R_trunc V₁) -
      ((C.state m).polymers.eval V₂ + (C.state m).R_trunc V₂)) =
    (S_c V₁ - wilsonAction (C.state m).β V₁) -
      (S_c V₂ - wilsonAction (C.state m).β V₂) := by
  have h_tot := C.totalAction_sub_eq_canonicalRGStateAux hβ hm V₁ V₂
  dsimp only [InteractingEffectiveActionState.totalAction] at h_tot ⊢
  linarith

/-- Universal two-link mixed-difference decomposition for `(C.state m).R_trunc` in **every**
    `C : MultiStepHaarRGChain L_ir K β_uv`: at any scale `m ≤ K`,
    `twoLinkMixedDifference L_m (C.state m).R_trunc` equals the two-link mixed difference of
    `S_c - wilsonAction (C.state m).β` minus the two-link mixed difference of `(C.state m).polymers.eval`. -/
theorem MultiStepHaarRGChain.twoLinkMixedDifference_R_trunc_eq_canonical_sub_wilson_sub_polymers
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m ≤ K)
    (V : GaugeConfig (dyadicScaleSide L_ir m))
    (e e' : Link (dyadicScaleSide L_ir m)) (g1 g2 h1 h2 : SU2) :
    let L_m := dyadicScaleSide L_ir m
    let st_c := canonicalRGStateAux L_ir β_uv (K - m) m
    let S_c := fun W => wilsonAction st_c.β W + st_c.polymers.eval W + st_c.R_trunc W
    twoLinkMixedDifference L_m (C.state m).R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2 =
      twoLinkMixedDifference L_m (fun W => S_c W - wilsonAction (C.state m).β W)
        V e.x e.μ g1 g2 e'.x e'.μ h1 h2 -
      twoLinkMixedDifference L_m (C.state m).polymers.eval
        V e.x e.μ g1 g2 e'.x e'.μ h1 h2 := by
  dsimp only [twoLinkMixedDifference]
  have heq1 := C.polymers_add_R_trunc_sub_eq_canonicalRGStateAux hβ hm
    (updateTwoGaugeLinks (dyadicScaleSide L_ir m) V e.x e.μ g1 e'.x e'.μ h1)
    (updateTwoGaugeLinks (dyadicScaleSide L_ir m) V e.x e.μ g2 e'.x e'.μ h1)
  have heq2 := C.polymers_add_R_trunc_sub_eq_canonicalRGStateAux hβ hm
    (updateTwoGaugeLinks (dyadicScaleSide L_ir m) V e.x e.μ g1 e'.x e'.μ h2)
    (updateTwoGaugeLinks (dyadicScaleSide L_ir m) V e.x e.μ g2 e'.x e'.μ h2)
  dsimp only at heq1 heq2
  linarith

/-- General polymer-split scheduled Haar RG state starting from `pureWilson` at `j = 0` (`m = K`),
    using a prescribed non-negative coupling schedule `β_sched (j + 1)` and a scale-indexed
    polymer family `P_sched m` at each coarse step `j + 1`, with exact remainder
    `R_trunc V = A_norm V - wilsonAction (β_sched (j + 1)) V - (P_sched m).eval V`. -/
noncomputable def polymerScheduledHaarRGStateAux
    (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ)
    (P_sched : ∀ m : ℕ, PolymerActivityFamily (dyadicScaleSide L_ir m)) :
    ∀ (_j m : ℕ), InteractingEffectiveActionState (dyadicScaleSide L_ir m)
  | 0, m => InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv
  | j + 1, m =>
      let L_m := dyadicScaleSide L_ir m
      let st_prev := polymerScheduledHaarRGStateAux L_ir β_uv β_sched P_sched j (m + 1)
      let A_eff : GaugeConfig L_m → ℝ :=
        YangMillsRGBridgeObstruction.interactingBlockedEffectiveAction (haarBlockDisintegration L_m)
          st_prev.β (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
      let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
      let β_next : ℝ := β_sched (j + 1)
      { c_vac := st_prev.c_vac + A_eff (vacuumConfig L_m)
        β := β_next
        polymers := P_sched m
        R_trunc := fun V => A_norm V - wilsonAction β_next V - (P_sched m).eval V }

noncomputable def polymerScheduledHaarRGState
    (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ) (β_sched : ℕ → ℝ)
    (P_sched : ∀ m : ℕ, PolymerActivityFamily (dyadicScaleSide L_ir m))
    (m : ℕ) : InteractingEffectiveActionState (dyadicScaleSide L_ir m) :=
  if m ≤ K then
    polymerScheduledHaarRGStateAux L_ir β_uv β_sched P_sched (K - m) m
  else
    InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv

theorem polymerScheduledHaarRGStateAux_beta_nonneg
    (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    {β_sched : ℕ → ℝ} (hsched : ∀ j : ℕ, 0 ≤ β_sched j)
    (P_sched : ∀ m : ℕ, PolymerActivityFamily (dyadicScaleSide L_ir m)) :
    ∀ (j m : ℕ), 0 ≤ (polymerScheduledHaarRGStateAux L_ir β_uv β_sched P_sched j m).β
  | 0, _ => hβ
  | j + 1, _ => hsched (j + 1)

/-- Explicit inhabitant of `MultiStepHaarRGChain L_ir K β_uv` carrying an arbitrary polymer
    activity family `P_sched m` and running coupling schedule `β_sched`. -/
noncomputable def polymerScheduledHaarRGChain
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (β_sched : ℕ → ℝ) (hsched : ∀ j : ℕ, 0 ≤ β_sched j)
    (P_sched : ∀ m : ℕ, PolymerActivityFamily (dyadicScaleSide L_ir m)) :
    MultiStepHaarRGChain L_ir K β_uv where
  state := polymerScheduledHaarRGState L_ir K β_uv β_sched P_sched
  ε_trunc := fun m V => |((polymerScheduledHaarRGState L_ir K β_uv β_sched P_sched m).R_trunc V)|
  h_uv := by simp [polymerScheduledHaarRGState, polymerScheduledHaarRGStateAux]
  h_β_nonneg := fun m hm => by
    simp only [polymerScheduledHaarRGState, hm, ↓reduceIte]
    exact polymerScheduledHaarRGStateAux_beta_nonneg L_ir hβ hsched P_sched (K - m) m
  h_ε_nonneg := fun _ _ _ => abs_nonneg _
  h_R_trunc_le := fun _ _ _ => le_rfl
  h_step_exact := fun m hm V => by
    have hm_le : m ≤ K := Nat.le_of_lt hm
    have hm1_le : m + 1 ≤ K := hm
    have hsub : K - m = (K - (m + 1)) + 1 := by omega
    have h_lhs : polymerScheduledHaarRGState L_ir K β_uv β_sched P_sched m =
        polymerScheduledHaarRGStateAux L_ir β_uv β_sched P_sched ((K - (m + 1)) + 1) m := by
      simp only [polymerScheduledHaarRGState, hm_le, ↓reduceIte, hsub]
    have h_rhs : polymerScheduledHaarRGState L_ir K β_uv β_sched P_sched (m + 1) =
        polymerScheduledHaarRGStateAux L_ir β_uv β_sched P_sched (K - (m + 1)) (m + 1) := by
      simp only [polymerScheduledHaarRGState, hm1_le, ↓reduceIte]
    rw [h_lhs, h_rhs]
    dsimp [polymerScheduledHaarRGStateAux, InteractingEffectiveActionState.totalAction]
    ring

theorem polymerScheduledHaarRGChain_state_zero_polymers_eq
    (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) (hK : 0 < K)
    (β_sched : ℕ → ℝ) (hsched : ∀ j : ℕ, 0 ≤ β_sched j)
    (P_sched : ∀ m : ℕ, PolymerActivityFamily (dyadicScaleSide L_ir m)) :
    ((polymerScheduledHaarRGChain L_ir K hβ β_sched hsched P_sched).state 0).polymers =
      P_sched 0 := by
  obtain ⟨j, hj⟩ : ∃ j, K - 0 = j + 1 := Nat.exists_eq_succ_of_ne_zero (by omega)
  have h0 : 0 ≤ K := Nat.zero_le K
  change (polymerScheduledHaarRGState L_ir K β_uv β_sched P_sched 0).polymers = P_sched 0
  simp only [polymerScheduledHaarRGState, h0, ↓reduceIte, hj, polymerScheduledHaarRGStateAux]

theorem polymerScheduledHaarRGChain_state_beta_eq_of_lt
    (n m : ℕ) (hm : m < n)
    (P_sched : ∀ k : ℕ, PolymerActivityFamily (dyadicScaleSide (2 ^ n) k)) :
    ((polymerScheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
      (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n) P_sched).state m).β =
      (m : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) + (canonicalCrossoverBetaLo : ℝ) := by
  obtain ⟨j, hj⟩ : ∃ j, n - m = j + 1 := Nat.exists_eq_succ_of_ne_zero (by omega)
  have hm_le : m ≤ n := Nat.le_of_lt hm
  have hsub : n - (j + 1) = m := by omega
  change (polymerScheduledHaarRGState (2 ^ n) n (dyadicOneLoopPath.coupling n)
    (balabanOneLoopDriftSchedule n) P_sched m).β = _
  simp only [polymerScheduledHaarRGState, hm_le, ↓reduceIte, hj, polymerScheduledHaarRGStateAux,
    balabanOneLoopDriftSchedule, hsub]

theorem polymerScheduledHaarRGChain_state_uv_beta_eq
    (n : ℕ)
    (P_sched : ∀ k : ℕ, PolymerActivityFamily (dyadicScaleSide (2 ^ n) k)) :
    ((polymerScheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
      (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n) P_sched).state n).β =
      (n : ℝ) * (11 / (3 * Real.pi ^ 2) * Real.log 2) := by
  change (polymerScheduledHaarRGState (2 ^ n) n (dyadicOneLoopPath.coupling n)
    (balabanOneLoopDriftSchedule n) P_sched n).β = _
  simp only [polymerScheduledHaarRGState, le_rfl, ↓reduceIte, Nat.sub_self,
    polymerScheduledHaarRGStateAux, dyadicOneLoopPath, InteractingEffectiveActionState.pureWilson]
  ring

/-- **Set 4 (`Argon`) Canonical Polymer-Split Constructor for `BalabanMultiScaleUVToIRFlow` (`R5`) & `LandingTube` (`R3`):**
    Reduces **both** `BalabanMultiScaleUVToIRFlow dyadicOneLoopPath` (all 20 fields) and
    `LandingTube dyadicOneLoopPath` (all 18 fields, with `WilsonCharFloor` and `h_floor`
    discharged unconditionally via `BalabanMultiScaleUVToIRFlow.wilsonCharFloor`) to statements
    written **solely** in terms of the canonical $n$-step Haar-blocked effective action
    `S_c n := canonicalRGStateAux (2 ^ n) (dyadicOneLoopPath.coupling n) n 0` and an IR
    polymer family `P_ir n : PolymerActivityFamily (dyadicScaleSide (2 ^ n) 0)`:
    1. `h_poly_ir`: `(4/3)^length`-weighted incident-loop sum of `P_ir n` bounded by `canonicalBalabanEtaStep (n - 0)`,
    2. `h_R_mixed_can`: two-link mixed difference of `S_c n - wilsonAction canonicalCrossoverBetaLo - (P_ir n).eval`
       bounded by `canonicalBalabanDeltaNbStep (n - 0)` on `dobrushinNeighbors e` and `0` off `dobrushinNeighbors e`,
    3. `h_osc_can` (independent of `P_ir`!): single-link oscillation of `S_c n - wilsonAction canonicalCrossoverBetaLo`
       bounded by `(canonicalCrossoverCovLo : ℝ) / 384`. -/
noncomputable def ARGON_SET4_R5_and_R3_of_canonical_polymer_split_obligations
    (P_ir : ∀ n : ℕ, PolymerActivityFamily (dyadicScaleSide (2 ^ n) 0))
    (h_poly_ir : ∀ n : ℕ, 0 < n →
      let L_0 := dyadicScaleSide (2 ^ n) 0
      let P_0 := P_ir n
      ∀ e : Link L_0,
        (∑ i : P_0.idx,
          if e ∈ latticePathSupport L_0 (P_0.bases i) (P_0.loops i) then
            ((P_0.loops i).length : ℝ) *
              ((4 / 3 : ℝ) ^ (P_0.loops i).length * (4 * |P_0.weights i|))
          else 0) ≤ canonicalBalabanEtaStep (n - 0))
    (h_R_mixed_can : ∀ n : ℕ, 0 < n →
      let L_0 := dyadicScaleSide (2 ^ n) 0
      let st_c := canonicalRGStateAux (2 ^ n) (dyadicOneLoopPath.coupling n) n 0
      let S_c := fun W => wilsonAction st_c.β W + st_c.polymers.eval W + st_c.R_trunc W
      ∀ (V : GaugeConfig L_0) (e e' : Link L_0) (g1 g2 h1 h2 : SU2),
        |twoLinkMixedDifference L_0
          (fun W => S_c W - wilsonAction (canonicalCrossoverBetaLo : ℝ) W - (P_ir n).eval W)
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
          if e' ∈ dobrushinNeighbors e then canonicalBalabanDeltaNbStep (n - 0) else 0)
    (h_osc_can : ∀ n : ℕ, 0 < n →
      let L_0 := dyadicScaleSide (2 ^ n) 0
      let st_c := canonicalRGStateAux (2 ^ n) (dyadicOneLoopPath.coupling n) n 0
      let S_c := fun W => wilsonAction st_c.β W + st_c.polymers.eval W + st_c.R_trunc W
      ∀ (V : GaugeConfig L_0) (e : Link L_0) (g1 g2 : SU2),
        |(S_c (updateGaugeLink L_0 V e.x e.μ g1) -
            wilsonAction (canonicalCrossoverBetaLo : ℝ) (updateGaugeLink L_0 V e.x e.μ g1)) -
          (S_c (updateGaugeLink L_0 V e.x e.μ g2) -
            wilsonAction (canonicalCrossoverBetaLo : ℝ) (updateGaugeLink L_0 V e.x e.μ g2))| ≤
          (canonicalCrossoverCovLo : ℝ) / 384) :
    BalabanMultiScaleUVToIRFlow dyadicOneLoopPath × LandingTube dyadicOneLoopPath :=
  let P_sched (n : ℕ) : ∀ m : ℕ, PolymerActivityFamily (dyadicScaleSide (2 ^ n) m)
    | 0 => P_ir n
    | m + 1 => PolymerActivityFamily.empty (dyadicScaleSide (2 ^ n) (m + 1))
  let C (n : ℕ) : MultiStepHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling n) :=
    polymerScheduledHaarRGChain (2 ^ n) n (dyadicOneLoopPath.coupling_nonneg n)
      (balabanOneLoopDriftSchedule n) (balabanOneLoopDriftSchedule_nonneg n) (P_sched n)
  let M : BalabanMultiScaleUVToIRFlow dyadicOneLoopPath :=
    { ℓstar := 1
      hℓstar := by norm_num
      K := fun n => n
      hK := by
        filter_upwards with n
        dsimp [dyadicOneLoopPath]
        have hpow : (2 : ℝ) ^ n ≠ 0 := pow_ne_zero n (by norm_num)
        rw [one_div_pow, div_mul_cancel₀ 1 hpow]
        norm_num
      irSide := fun n => 2 ^ n
      instNeZeroIrSide := fun n => ⟨pow_ne_zero n (by decide)⟩
      hside := by
        filter_upwards with n
        dsimp [dyadicOneLoopPath]
        rw [dyadicScaleSide_eq_two_pow_mul, ← Nat.mul_pow]
      chain := C
      Δβ_1loop := 11 / (3 * Real.pi ^ 2) * Real.log 2
      hΔβ_1loop_pos := by
        have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
        have hpi : 0 < Real.pi := Real.pi_pos
        positivity
      δ_2loop := fun _ k => if k = 0 then (canonicalCrossoverBetaLo : ℝ) else 0
      hδ_2loop_bounds := fun _ k => by
        split_ifs with hk
        · exact ⟨by norm_num [canonicalCrossoverBetaLo], canonicalCrossoverBetaLo_le_half_oneLoopDeltaBeta⟩
        · have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
          have hpi : 0 < Real.pi := Real.pi_pos
          exact ⟨le_rfl, by positivity⟩
      h_β_drift := fun n m hm => by
        dsimp only [C]
        rw [polymerScheduledHaarRGChain_state_beta_eq_of_lt n m hm (P_sched n)]
        rcases lt_or_eq_of_le (Nat.succ_le_of_lt hm) with hm1 | hm1
        · have hk_ne : n - 1 - m ≠ 0 := by omega
          rw [polymerScheduledHaarRGChain_state_beta_eq_of_lt n (m + 1) hm1 (P_sched n)]
          simp only [hk_ne, ↓reduceIte, Nat.cast_add, Nat.cast_one]
          linarith
        · have hk_eq : n - 1 - m = 0 := by omega
          have h_m1 : m + 1 = n := hm1
          rw [h_m1, polymerScheduledHaarRGChain_state_uv_beta_eq n (P_sched n)]
          have h_cast : (n : ℝ) = (m : ℝ) + 1 := by exact_mod_cast hm1.symm
          simp only [hk_eq, ↓reduceIte, h_cast]
          linarith
      h_β_absorb := by
        filter_upwards [eventually_ge_atTop 1] with n hn
        have h_sum :
            (∑ k ∈ Finset.range n, (if k = 0 then (canonicalCrossoverBetaLo : ℝ) else 0)) =
              (canonicalCrossoverBetaLo : ℝ) := by
          have h0 : 0 ∈ Finset.range n := Finset.mem_range.mpr hn
