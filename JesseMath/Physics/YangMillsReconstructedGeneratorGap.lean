/-- Plaquette-neighbor locality of an `InteractingEffectiveActionState L`: the polymer and
truncation remainders have vanishing two-link mixed differences outside `dobrushinNeighbors e`. -/
def IsNeighborLocal {L : ℕ} [NeZero L] (st : InteractingEffectiveActionState L) : Prop :=
  ∀ (e e' : Link L), e' ≠ e → e' ∉ dobrushinNeighbors e →
    ∀ (V : GaugeConfig L) (g h1 h2 : SU2),
      twoLinkMixedDifference L st.polymers.eval V e.x e.μ g 1 e'.x e'.μ h1 h2 = 0 ∧
      twoLinkMixedDifference L st.R_trunc V e.x e.μ g 1 e'.x e'.μ h1 h2 = 0

/-- For any neighbor-local effective action state `st : InteractingEffectiveActionState L`,
`dobrushinSupMatrix SU2 L st.totalAction e e' ≠ 0` implies `e' ∈ dobrushinNeighbors e`,
`linkSupDist e e' ≤ 1`, and `linkTemporalDist e e' ≤ 1`. -/
theorem totalAction_dobrushinSupMatrix_ne_zero_imp_dist_le_one {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L)
    {η_star ε_star : ℝ}
    (hβ0 : 0 ≤ st.β)
    (_h_poly : PolymerDobrushinNormBound st.polymers η_star)
    (h_trunc : TruncationDobrushinNormBound st.R_trunc ε_star)
    (h_loc : st.IsNeighborLocal)
    {e e' : Link L}
    (hne : dobrushinSupMatrix SU2 L st.totalAction e e' ≠ 0) :
    e' ∈ dobrushinNeighbors e ∧ linkSupDist e e' ≤ 1 ∧ linkTemporalDist e e' ≤ 1 := by
  classical
  obtain ⟨⟨B_R, hR_bdd⟩, hR_meas, _⟩ := h_trunc
  let B : ℝ :=
    |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
      (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|) + B_R
  have h_act_bdd (U : GaugeConfig L) : |st.totalAction U| ≤ B := by
    have hW_nonneg : 0 ≤ wilsonAction st.β U := wilsonAction_nonneg hβ0 U
    have hW_le : wilsonAction st.β U ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
      unfold wilsonAction
      exact mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun p _ => plaquetteAction_le_two U p) hβ0
    have hW_abs : |wilsonAction st.β U| ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
      rw [abs_of_nonneg hW_nonneg]
      exact hW_le
    have hP_abs := st.polymers.abs_eval_le U
    have hR_abs := hR_bdd U
    unfold totalAction
    have h1_tri := abs_add_le (st.c_vac + wilsonAction st.β U + st.polymers.eval U) (st.R_trunc U)
    have h2_tri := abs_add_le (st.c_vac + wilsonAction st.β U) (st.polymers.eval U)
    have h3_tri := abs_add_le st.c_vac (wilsonAction st.β U)
    dsimp [B]
    linarith
  have hS_meas (W : GaugeConfig L) :
      Measurable (fun g : SU2 => st.totalAction (updateGroupGaugeLink L W e.x e.μ g)) := by
    have h_loc_cont : Continuous st.localPolymerAction := by
      unfold localPolymerAction
      exact (continuous_const.add (continuous_wilsonAction st.β)).add st.polymers.continuous_eval
    have h_loc_meas :
        Measurable (fun g : SU2 => st.localPolymerAction (updateGaugeLink L W e.x e.μ g)) :=
      (h_loc_cont.comp (continuous_updateGaugeLink_right W e.x e.μ)).measurable
    exact h_loc_meas.add (hR_meas.comp (continuous_updateGaugeLink_right W e.x e.μ).measurable)
  have hS_bdd (W : GaugeConfig L) :
      ∃ B_W : ℝ, ∀ g : SU2, |st.totalAction (updateGroupGaugeLink L W e.x e.μ g)| ≤ B_W :=
    ⟨B, fun g => h_act_bdd _⟩
  have h_mem : e' ∈ dobrushinNeighbors e := by
    by_contra h_not_mem
    refine hne (dobrushinSupMatrix_eq_zero_of_twoLinkMixedDifference_eq_zero
      SU2 st.totalAction hS_meas hS_bdd fun h_ne V g h1 h2 => ?_)
    have h_split :
        groupTwoLinkMixedDifference L st.totalAction V e.x e.μ g 1 e'.x e'.μ h1 h2 =
          groupTwoLinkMixedDifference L (groupWilsonAction su2CompactGaugeClassTrace st.β)
            V e.x e.μ g 1 e'.x e'.μ h1 h2 +
          twoLinkMixedDifference L st.polymers.eval V e.x e.μ g 1 e'.x e'.μ h1 h2 +
          twoLinkMixedDifference L st.R_trunc V e.x e.μ g 1 e'.x e'.μ h1 h2 := by
      dsimp [groupTwoLinkMixedDifference, twoLinkMixedDifference,
        updateTwoGroupGaugeLinks, updateTwoGaugeLinks, updateGroupGaugeLink, updateGaugeLink,
        totalAction, groupWilsonAction, wilsonAction, groupPlaquetteAction, plaquetteAction,
        groupPlaquetteHolonomy, plaquetteHolonomy, su2CompactGaugeClassTrace]
      ring
    have h_w0 :=
      groupTwoLinkMixedDifference_groupWilsonAction_eq_zero_of_not_mem_dobrushinNeighbors
        su2CompactGaugeClassTrace st.β V e e' h_ne h_not_mem g 1 h1 h2
    obtain ⟨h_p0, h_r0⟩ := h_loc e e' h_ne h_not_mem V g h1 h2
    rw [h_split, h_w0, h_p0, h_r0]
    ring
  exact ⟨h_mem,
    linkSupDist_le_one_of_mem_dobrushinNeighbors h_mem,
    linkTemporalDist_le_one_of_mem_dobrushinNeighbors h_mem⟩

/-- Georgii Theorem 8.20 tilted Dobrushin row-sum bound for a nonlocal blocked effective action
`st : InteractingEffectiveActionState L`: if `1 ≤ μ`, `distLink` satisfies
`e' ∈ dobrushinNeighbors e → distLink e e' ≤ 1` (such as `linkSupDist` or `linkTemporalDist`), and
the polymer and truncation two-link mixed differences have `μ`-tilted row sums bounded by
`η_tilde` and `ε_tilde`, then
`∑ e' : Link L, dobrushinTiltedMatrix (dobrushinSupMatrix SU2 L st.totalAction) distLink μ e e' ≤ 4 * (18 * (24 * μ * β_star) + η_tilde + ε_tilde)`. -/
theorem totalAction_dobrushinTiltedMatrix_rowSum_le {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L)
    (distLink : Link L → Link L → ℕ)
    (h_nb_dist : ∀ e e' : Link L, e' ∈ dobrushinNeighbors e → distLink e e' ≤ 1)
    {μ β_star η_star ε_star η_tilde ε_tilde B_R : ℝ}
    (hμ : 1 ≤ μ)
    (hβ0 : 0 ≤ st.β) (hβ_le : st.β ≤ β_star)
    (_hβ_star : 0 ≤ β_star) (_hη_star : 0 ≤ η_star) (_hε_star : 0 ≤ ε_star)
    (h_land : 4 * (18 * (24 * β_star) + η_star + ε_star) < 1)
    (hR_bdd : ∀ V : GaugeConfig L, |st.R_trunc V| ≤ B_R)
    (hR_meas : Measurable st.R_trunc)
    (c_poly c_trunc : Link L → Link L → ℝ)
    (hc_poly_nonneg : ∀ e e' : Link L, 0 ≤ c_poly e e')
    (hc_poly_mix : ∀ (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L st.polymers.eval V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ c_poly e e')
    (hc_poly_sum : ∀ e : Link L, (∑ e' ∈ Finset.univ.erase e, c_poly e e') ≤ η_star)
    (hc_poly_tilt : ∀ e : Link L,
      (∑ e' ∈ Finset.univ.erase e, μ ^ (distLink e e') * c_poly e e') ≤ η_tilde)
    (hc_trunc_nonneg : ∀ e e' : Link L, 0 ≤ c_trunc e e')
    (hc_trunc_mix : ∀ (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L st.R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ c_trunc e e')
    (hc_trunc_sum : ∀ e : Link L, (∑ e' ∈ Finset.univ.erase e, c_trunc e e') ≤ ε_star)
    (hc_trunc_tilt : ∀ e : Link L,
      (∑ e' ∈ Finset.univ.erase e, μ ^ (distLink e e') * c_trunc e e') ≤ ε_tilde)
    (e : Link L) :
    (∑ e' : Link L,
      dobrushinTiltedMatrix (dobrushinSupMatrix SU2 L st.totalAction) distLink μ e e') ≤
      4 * (18 * (24 * μ * β_star) + η_tilde + ε_tilde) := by
  classical
  have hμ0 : 0 ≤ μ := by linarith
  let B : ℝ :=
    |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
      (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|) + B_R
  have h_act_bdd (U : GaugeConfig L) : |st.totalAction U| ≤ B := by
    have hW_nonneg : 0 ≤ wilsonAction st.β U := wilsonAction_nonneg hβ0 U
    have hW_le : wilsonAction st.β U ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
      unfold wilsonAction
      exact mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun p _ => plaquetteAction_le_two U p) hβ0
    have hW_abs : |wilsonAction st.β U| ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
      rw [abs_of_nonneg hW_nonneg]
      exact hW_le
    have hP_abs := st.polymers.abs_eval_le U
    have hR_abs := hR_bdd U
    unfold totalAction
    have h1_tri := abs_add_le (st.c_vac + wilsonAction st.β U + st.polymers.eval U) (st.R_trunc U)
    have h2_tri := abs_add_le (st.c_vac + wilsonAction st.β U) (st.polymers.eval U)
    have h3_tri := abs_add_le st.c_vac (wilsonAction st.β U)
    dsimp [B]
    linarith
  have hS_meas (W : GaugeConfig L) :
      Measurable (fun g : SU2 => st.totalAction (updateGroupGaugeLink L W e.x e.μ g)) := by
    have h_loc_cont : Continuous st.localPolymerAction := by
      unfold localPolymerAction
      exact (continuous_const.add (continuous_wilsonAction st.β)).add st.polymers.continuous_eval
    have h_loc_meas :
        Measurable (fun g : SU2 => st.localPolymerAction (updateGaugeLink L W e.x e.μ g)) :=
      (h_loc_cont.comp (continuous_updateGaugeLink_right W e.x e.μ)).measurable
    exact h_loc_meas.add (hR_meas.comp (continuous_updateGaugeLink_right W e.x e.μ).measurable)
  have hS_bdd (W : GaugeConfig L) :
      ∃ B_W : ℝ, ∀ g : SU2, |st.totalAction (updateGroupGaugeLink L W e.x e.μ g)| ≤ B_W :=
    ⟨B, fun g => h_act_bdd _⟩
  let Δ : Link L → ℝ := fun e' =>
    (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0) + c_poly e e' + c_trunc e e'
  have hΔ_nonneg (e' : Link L) (_he' : e' ∈ Finset.univ.erase e) : 0 ≤ Δ e' := by
    dsimp [Δ]
    have h_if : 0 ≤ (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0) := by
      split_ifs <;> linarith
    linarith [hc_poly_nonneg e e', hc_trunc_nonneg e e']
  have h_mixed (e' : Link L) (he' : e' ∈ Finset.univ.erase e)
      (V : GaugeConfig L) (g h1 h2 : SU2) :
      |groupTwoLinkMixedDifference L st.totalAction V e.x e.μ g 1 e'.x e'.μ h1 h2| ≤ Δ e' := by
    have h_ne : e' ≠ e := (Finset.mem_erase.mp he').1
    have h_split :
        groupTwoLinkMixedDifference L st.totalAction V e.x e.μ g 1 e'.x e'.μ h1 h2 =
          groupTwoLinkMixedDifference L (groupWilsonAction su2CompactGaugeClassTrace st.β)
            V e.x e.μ g 1 e'.x e'.μ h1 h2 +
          twoLinkMixedDifference L st.polymers.eval V e.x e.μ g 1 e'.x e'.μ h1 h2 +
          twoLinkMixedDifference L st.R_trunc V e.x e.μ g 1 e'.x e'.μ h1 h2 := by
      dsimp [groupTwoLinkMixedDifference, twoLinkMixedDifference,
        updateTwoGroupGaugeLinks, updateTwoGaugeLinks, updateGroupGaugeLink, updateGaugeLink,
        totalAction, groupWilsonAction, wilsonAction, groupPlaquetteAction, plaquetteAction,
        groupPlaquetteHolonomy, plaquetteHolonomy, su2CompactGaugeClassTrace]
      ring
    have h_w_le :
        |groupTwoLinkMixedDifference L (groupWilsonAction su2CompactGaugeClassTrace st.β)
          V e.x e.μ g 1 e'.x e'.μ h1 h2| ≤
          if e' ∈ dobrushinNeighbors e then 24 * st.β else 0 := by
      split_ifs with h_mem
      · exact groupTwoLinkMixedDifference_groupWilsonAction_abs_le_twentyFour_mul_beta
          su2CompactGaugeClassTrace hβ0 V e e' g 1 h1 h2
      · rw [groupTwoLinkMixedDifference_groupWilsonAction_eq_zero_of_not_mem_dobrushinNeighbors
          su2CompactGaugeClassTrace st.β V e e' h_ne h_mem g 1 h1 h2, abs_zero]
    have h_p_le := hc_poly_mix V e e' g 1 h1 h2
    have h_r_le := hc_trunc_mix V e e' g 1 h1 h2
    have h_tri1 := abs_add_le
      (groupTwoLinkMixedDifference L (groupWilsonAction su2CompactGaugeClassTrace st.β)
        V e.x e.μ g 1 e'.x e'.μ h1 h2 +
        twoLinkMixedDifference L st.polymers.eval V e.x e.μ g 1 e'.x e'.μ h1 h2)
      (twoLinkMixedDifference L st.R_trunc V e.x e.μ g 1 e'.x e'.μ h1 h2)
    have h_tri2 := abs_add_le
      (groupTwoLinkMixedDifference L (groupWilsonAction su2CompactGaugeClassTrace st.β)
        V e.x e.μ g 1 e'.x e'.μ h1 h2)
      (twoLinkMixedDifference L st.polymers.eval V e.x e.μ g 1 e'.x e'.μ h1 h2)
    rw [h_split]
    dsimp [Δ]
    linarith
  have h_sum_if :
      (∑ e' ∈ Finset.univ.erase e, (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0)) ≤
        18 * (24 * β_star) := by
    have h_eq2 :
        (∑ e' ∈ Finset.univ.erase e, (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0)) =
          ∑ e' ∈ dobrushinNeighbors e,
            (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0) := by
      symm
      apply Finset.sum_subset
      · intro e' he'
        exact Finset.mem_erase.mpr
          ⟨fun h => not_mem_dobrushinNeighbors_self e (h ▸ he'), Finset.mem_univ e'⟩
      · intro e' _ hn
        simp [hn]
    have h_eq3 :
        (∑ e' ∈ dobrushinNeighbors e,
          (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0)) =
          ((dobrushinNeighbors e).card : ℝ) * (24 * st.β) := by
      have h_congr :
          (∑ e' ∈ dobrushinNeighbors e,
            (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0)) =
            ∑ _e' ∈ dobrushinNeighbors e, (24 * st.β) :=
        Finset.sum_congr rfl fun e' he' => by simp [he']
      rw [h_congr, Finset.sum_const, nsmul_eq_mul]
    have hcard : ((dobrushinNeighbors e).card : ℝ) ≤ 18 := by
      exact_mod_cast dobrushinNeighbors_card_le_eighteen e
    rw [h_eq2, h_eq3]
    calc
      ((dobrushinNeighbors e).card : ℝ) * (24 * st.β)
        ≤ 18 * (24 * st.β) := mul_le_mul_of_nonneg_right hcard (by linarith)
      _ ≤ 18 * (24 * β_star) := by linarith
  have h_sum_le :
      (∑ e' ∈ Finset.univ.erase e, Δ e') ≤ 18 * (24 * β_star) + η_star + ε_star := by
    dsimp [Δ]
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
    linarith [hc_poly_sum e, hc_trunc_sum e]
  have h_tilt_if :
      (∑ e' ∈ Finset.univ.erase e,
        μ ^ (distLink e e') * (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0)) ≤
      18 * (24 * μ * β_star) := by
    have h_le_nb :
        (∑ e' ∈ Finset.univ.erase e,
          μ ^ (distLink e e') * (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0)) ≤
        ∑ e' ∈ Finset.univ.erase e,
          (if e' ∈ dobrushinNeighbors e then 24 * μ * β_star else 0) := by
      refine Finset.sum_le_sum fun e' _ => ?_
      split_ifs with h_mem
      · have hd1 : distLink e e' ≤ 1 := h_nb_dist e e' h_mem
        have h_pow_le : μ ^ (distLink e e') ≤ μ := by
          calc
            μ ^ (distLink e e') ≤ μ ^ 1 := pow_le_pow_right₀ hμ hd1
            _ = μ := pow_one μ
        calc
          μ ^ (distLink e e') * (24 * st.β)
            ≤ μ * (24 * st.β) := mul_le_mul_of_nonneg_right h_pow_le (by linarith)
          _ ≤ μ * (24 * β_star) := mul_le_mul_of_nonneg_left (by linarith) hμ0
          _ = 24 * μ * β_star := by ring
      · rw [mul_zero]
    have h_eq2 :
        (∑ e' ∈ Finset.univ.erase e,
          (if e' ∈ dobrushinNeighbors e then 24 * μ * β_star else 0)) =
          ∑ e' ∈ dobrushinNeighbors e,
            (if e' ∈ dobrushinNeighbors e then 24 * μ * β_star else 0) := by
      symm
      apply Finset.sum_subset
      · intro e' he'
        exact Finset.mem_erase.mpr
          ⟨fun h => not_mem_dobrushinNeighbors_self e (h ▸ he'), Finset.mem_univ e'⟩
      · intro e' _ hn
        simp [hn]
    have h_eq3 :
        (∑ e' ∈ dobrushinNeighbors e,
          (if e' ∈ dobrushinNeighbors e then 24 * μ * β_star else 0)) =
          ((dobrushinNeighbors e).card : ℝ) * (24 * μ * β_star) := by
      have h_congr :
          (∑ e' ∈ dobrushinNeighbors e,
            (if e' ∈ dobrushinNeighbors e then 24 * μ * β_star else 0)) =
            ∑ _e' ∈ dobrushinNeighbors e, (24 * μ * β_star) :=
        Finset.sum_congr rfl fun e' he' => by simp [he']
      rw [h_congr, Finset.sum_const, nsmul_eq_mul]
    have hcard : ((dobrushinNeighbors e).card : ℝ) ≤ 18 := by
      exact_mod_cast dobrushinNeighbors_card_le_eighteen e
    have h24_nonneg : 0 ≤ 24 * μ * β_star := by nlinarith
    calc
      (∑ e' ∈ Finset.univ.erase e,
        μ ^ (distLink e e') * (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0))
        ≤ ∑ e' ∈ Finset.univ.erase e,
            (if e' ∈ dobrushinNeighbors e then 24 * μ * β_star else 0) := h_le_nb
      _ = ((dobrushinNeighbors e).card : ℝ) * (24 * μ * β_star) := by rw [h_eq2, h_eq3]
      _ ≤ 18 * (24 * μ * β_star) := mul_le_mul_of_nonneg_right hcard h24_nonneg
  have h_tilted_le :
      (∑ e' ∈ Finset.univ.erase e, μ ^ (distLink e e') * Δ e') ≤
        18 * (24 * μ * β_star) + η_tilde + ε_tilde := by
    have h_distrib :
        (∑ e' ∈ Finset.univ.erase e, μ ^ (distLink e e') * Δ e') =
          (∑ e' ∈ Finset.univ.erase e,
            μ ^ (distLink e e') * (if e' ∈ dobrushinNeighbors e then 24 * st.β else 0)) +
          (∑ e' ∈ Finset.univ.erase e, μ ^ (distLink e e') * c_poly e e') +
          (∑ e' ∈ Finset.univ.erase e, μ ^ (distLink e e') * c_trunc e e') := by
      rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun e' _ => ?_
      dsimp [Δ]
      ring
    rw [h_distrib]
    linarith [hc_poly_tilt e, hc_trunc_tilt e]
  exact dobrushinTiltedMatrix_rowSum_le_four_mul_of_twoLink_sum
    SU2 st.totalAction distLink hμ0 e Δ hS_meas hS_bdd hΔ_nonneg h_mixed h_sum_le h_land h_tilted_le

/-- Unnormalized interacting Boltzmann weight
`exp(-wilsonAction β V - polymers.eval V - R_trunc V)` on `GaugeConfig L` (with `c_vac` factored
out so it cancels between numerator and partition function). -/
noncomputable def boltzmannDensity {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) (V : GaugeConfig L) : ℝ :=
  Real.exp (-wilsonAction st.β V - st.polymers.eval V - st.R_trunc V)

/-- Two-sided Boltzmann density perturbation sandwich: when two effective action states `st1, st2`
have non-vacuum action difference bounded by `δ` at configuration `V`, their Boltzmann densities at
`V` are sandwiched within `exp(±δ)`. -/
theorem boltzmannDensity_sandwich_of_action_diff {L : ℕ} [NeZero L]
    (st1 st2 : InteractingEffectiveActionState L) (V : GaugeConfig L) {δ : ℝ}
    (h_diff :
      |(wilsonAction st1.β V + st1.polymers.eval V + st1.R_trunc V) -
        (wilsonAction st2.β V + st2.polymers.eval V + st2.R_trunc V)| ≤ δ) :
    Real.exp (-δ) * st2.boltzmannDensity V ≤ st1.boltzmannDensity V ∧
    st1.boltzmannDensity V ≤ Real.exp δ * st2.boltzmannDensity V := by
  have habs := abs_le.mp h_diff
  unfold boltzmannDensity
  rw [← Real.exp_add, ← Real.exp_add]
  exact ⟨Real.exp_le_exp.mpr (by linarith [habs.2]), Real.exp_le_exp.mpr (by linarith [habs.1])⟩

/-- Partition function `∫ V, st.boltzmannDensity V ∂(gaugeHaarMeasure L)` of `st`. -/
noncomputable def partitionFunction {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) : ℝ :=
  ∫ V, st.boltzmannDensity V ∂(gaugeHaarMeasure L)

/-- Normalized Gibbs measure on `GaugeConfig L` induced by `st` with respect to product Haar
measure `gaugeHaarMeasure L`. -/
noncomputable def gibbsMeasure {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) : Measure (GaugeConfig L) :=
  (gaugeHaarMeasure L).withDensity (fun V =>
    ENNReal.ofReal (st.boltzmannDensity V / st.partitionFunction))

@[continuity, fun_prop]
theorem continuous_localPolymerAction {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) :
    Continuous st.localPolymerAction := by
  unfold localPolymerAction
  exact (continuous_const.add (continuous_wilsonAction st.β)).add st.polymers.continuous_eval

theorem measurable_totalAction {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L)
    (hR_meas : Measurable st.R_trunc) :
    Measurable st.totalAction := by
  have h_eq : st.totalAction = fun V => st.localPolymerAction V + st.R_trunc V := rfl
  rw [h_eq]
  exact st.continuous_localPolymerAction.measurable.add hR_meas

theorem abs_totalAction_le {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) {ε_star : ℝ}
    (hβ0 : 0 ≤ st.β)
    (hR_bdd : ∀ V : GaugeConfig L, |st.R_trunc V| ≤ ε_star)
    (U : GaugeConfig L) :
    |st.totalAction U| ≤
      |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
        (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|) + ε_star := by
  have hW_nonneg : 0 ≤ wilsonAction st.β U := wilsonAction_nonneg hβ0 U
  have hW_le : wilsonAction st.β U ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
    unfold wilsonAction
    exact mul_le_mul_of_nonneg_left
      (Finset.sum_le_sum fun p _ => plaquetteAction_le_two U p) hβ0
  have hW_abs : |wilsonAction st.β U| ≤ st.β * (∑ _p : Plaquette L, (2 : ℝ)) := by
    rw [abs_of_nonneg hW_nonneg]
    exact hW_le
  have hP_abs := st.polymers.abs_eval_le U
  have hR_abs := hR_bdd U
  unfold totalAction
  have h1_tri := abs_add_le (st.c_vac + wilsonAction st.β U + st.polymers.eval U) (st.R_trunc U)
  have h2_tri := abs_add_le (st.c_vac + wilsonAction st.β U) (st.polymers.eval U)
  have h3_tri := abs_add_le st.c_vac (wilsonAction st.β U)
  linarith

/-- Exact pointwise factorization `exp(-st.totalAction V) = exp(-st.c_vac) * st.boltzmannDensity V`. -/
theorem exp_neg_totalAction_eq {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) (V : GaugeConfig L) :
    Real.exp (-st.totalAction V) = Real.exp (-st.c_vac) * st.boltzmannDensity V := by
  unfold totalAction boltzmannDensity
  rw [← Real.exp_add]
  congr 1
  ring

/-- The unnormalized partition function `groupGibbsPartition SU2 L st.totalAction` equals
`exp(-st.c_vac) * st.partitionFunction`. -/
theorem groupGibbsPartition_totalAction_eq {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) :
    groupGibbsPartition SU2 L st.totalAction = Real.exp (-st.c_vac) * st.partitionFunction := by
  unfold groupGibbsPartition partitionFunction
  change (∫ V, Real.exp (-st.totalAction V) ∂(gaugeHaarMeasure L)) =
    Real.exp (-st.c_vac) * ∫ V, st.boltzmannDensity V ∂(gaugeHaarMeasure L)
  simp_rw [st.exp_neg_totalAction_eq, integral_const_mul]

/-- The normalized Gibbs measure `st.gibbsMeasure` of any `st : InteractingEffectiveActionState L`
is identically equal to `groupGibbsMeasure SU2 L st.totalAction` (the vacuum offset `st.c_vac`
cancels identically between numerator and partition function). -/
theorem gibbsMeasure_eq_groupGibbsMeasure {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L) :
    st.gibbsMeasure = groupGibbsMeasure SU2 L st.totalAction := by
  unfold gibbsMeasure groupGibbsMeasure
  rw [st.groupGibbsPartition_totalAction_eq]
  have h_dens :
      (fun V : GaugeConfig L =>
        ENNReal.ofReal (st.boltzmannDensity V / st.partitionFunction)) =
      (fun V : GaugeConfig L =>
        ENNReal.ofReal (Real.exp (-st.totalAction V) /
          (Real.exp (-st.c_vac) * st.partitionFunction))) := by
    funext V
    rw [st.exp_neg_totalAction_eq,
      mul_div_mul_left (st.boltzmannDensity V) st.partitionFunction (Real.exp_ne_zero (-st.c_vac))]
  rw [h_dens]
  rfl

/-- Unconditional Föllmer–Dobrushin covariance comparison theorem for the actual Gibbs measure
`st.gibbsMeasure` of `st : InteractingEffectiveActionState L`: whenever `0 ≤ st.β ≤ β_star`,
`PolymerDobrushinNormBound st.polymers η_star`, `TruncationDobrushinNormBound st.R_trunc ε_star`,
and `4 * (18 * (24 * β_star) + η_star + ε_star) < 1`, every pair of bounded measurable observables
`f, g : GaugeConfig L → ℝ` satisfies
`|groupGibbsCov st.gibbsMeasure f g| ≤ dobrushinObservableComparison SU2 (dobrushinSupMatrix SU2 L st.totalAction) f g`. -/
theorem gibbsMeasure_abs_cov_le_dobrushinObservableComparison {L : ℕ} [NeZero L]
    (st : InteractingEffectiveActionState L)
    {β_star η_star ε_star : ℝ}
    (hβ0 : 0 ≤ st.β) (hβ_le : st.β ≤ β_star)
    (hβ_star : 0 ≤ β_star) (hη_star : 0 ≤ η_star) (hε_star : 0 ≤ ε_star)
    (h_poly : PolymerDobrushinNormBound st.polymers η_star)
    (h_trunc : TruncationDobrushinNormBound st.R_trunc ε_star)
    (h_land : 4 * (18 * (24 * β_star) + η_star + ε_star) < 1)
    {f g : GaugeConfig L → ℝ} {M_f M_g : ℝ}
    (hf_meas : Measurable f) (hf_bdd : ∀ V : GaugeConfig L, |f V| ≤ M_f)
    (hg_meas : Measurable g) (hg_bdd : ∀ V : GaugeConfig L, |g V| ≤ M_g) :
    |groupGibbsCov st.gibbsMeasure f g| ≤
      dobrushinObservableComparison SU2 (dobrushinSupMatrix SU2 L st.totalAction) f g := by
  obtain ⟨B_R, hR_bdd⟩ := h_trunc.1
  have hR_meas := h_trunc.2.1
  have hS_meas : Measurable st.totalAction := st.measurable_totalAction hR_meas
  have hS_bdd : ∀ U : GaugeConfig L,
      |st.totalAction U| ≤
        |st.c_vac| + st.β * (∑ _p : Plaquette L, (2 : ℝ)) +
          (∑ i : st.polymers.idx, 2 * |st.polymers.weights i|) + B_R :=
    st.abs_totalAction_le hβ0 hR_bdd
  have h_sup := st.totalAction_dobrushinSupMatrix_rowSum_le
    hβ0 hβ_le hβ_star hη_star hε_star h_poly h_trunc h_land
  have hq0 : 0 ≤ 4 * (18 * (24 * β_star) + η_star + ε_star) := by linarith
  rw [st.gibbsMeasure_eq_groupGibbsMeasure]
  exact groupGibbsMeasure_abs_cov_le_dobrushinObservableComparison
    SU2 st.totalAction hq0 h_land
    (fun e => (h_sup.1 e).1) hS_meas hS_bdd f g hf_meas hf_bdd hg_meas hg_bdd

/-- Pure-Wilson initial UV state at bare coupling `β_0` with zero vacuum offset, the empty
polymer family, and zero truncation remainder. -/
def pureWilson (L : ℕ) [NeZero L] (β_0 : ℝ) : InteractingEffectiveActionState L where
  c_vac := 0
  β := β_0
  polymers := PolymerActivityFamily.empty L
  R_trunc := fun _ => 0

/-- The Gibbs measure of `pureWilson L β_0` is identically the actual finite-volume Wilson
measure `wilsonMeasure (gaugeHaarMeasure L) β_0`. -/
theorem gibbsMeasure_pureWilson_eq_wilsonMeasure (L : ℕ) [NeZero L] (β_0 : ℝ) :
    (pureWilson L β_0).gibbsMeasure = wilsonMeasure (gaugeHaarMeasure L) β_0 := by
  unfold gibbsMeasure pureWilson partitionFunction boltzmannDensity
    wilsonMeasure wilsonPartition boltzmannWeight
  simp [PolymerActivityFamily.eval_empty]

end InteractingEffectiveActionState

/-- Dyadic lattice side `2 ^ m * L_ir` at `m` dyadic scales above the IR side `L_ir`, defined
recursively so that `dyadicScaleSide L_ir 0 = L_ir` and
`dyadicScaleSide L_ir (m + 1) = 2 * dyadicScaleSide L_ir m` hold judgmentally. -/
@[reducible] def dyadicScaleSide (L_ir : ℕ) : ℕ → ℕ
  | 0 => L_ir
  | m + 1 => 2 * dyadicScaleSide L_ir m

instance instNeZeroDyadicScaleSide (L_ir : ℕ) [NeZero L_ir] :
    ∀ m : ℕ, NeZero (dyadicScaleSide L_ir m)
  | 0 => ‹NeZero L_ir›
  | m + 1 =>
      letI := instNeZeroDyadicScaleSide L_ir m
      ⟨Nat.mul_ne_zero (by decide) (NeZero.ne (dyadicScaleSide L_ir m))⟩

theorem dyadicScaleSide_eq_two_pow_mul (L_ir : ℕ) :
    ∀ m : ℕ, dyadicScaleSide L_ir m = 2 ^ m * L_ir
  | 0 => by simp [dyadicScaleSide]
  | m + 1 => by
      simp only [dyadicScaleSide, dyadicScaleSide_eq_two_pow_mul L_ir m, pow_succ']
      ring

/-- Exact `K`-step dyadic Haar renormalization-group chain from the UV Wilson measure at scale
`m = K` (`dyadicScaleSide L_ir K = 2 ^ K * L_ir`) down to the landed IR scale `m = 0` (`L_ir`),
where each blocking step `m + 1 → m` (`m < K`) satisfies the exact Haar fiber identity
`(state m).totalAction V = (state (m + 1)).c_vac + interactingBlockedEffectiveAction (haarBlockDisintegration (dyadicScaleSide L_ir m)) (state (m + 1)).β (fun U => (state (m + 1)).polymers.eval U + (state (m + 1)).R_trunc U) V`
with non-negative truncation envelope `|((state m).R_trunc V)| ≤ ε_trunc m V`. -/
structure MultiStepHaarRGChain (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ) where
  state : ∀ m : ℕ, InteractingEffectiveActionState (dyadicScaleSide L_ir m)
  ε_trunc : ∀ m : ℕ, GaugeConfig (dyadicScaleSide L_ir m) → ℝ
  h_uv : state K = InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir K) β_uv
  h_β_nonneg : ∀ m ≤ K, 0 ≤ (state m).β
  h_ε_nonneg : ∀ m < K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m), 0 ≤ ε_trunc m V
  h_R_trunc_le : ∀ m < K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m),
    |((state m).R_trunc V)| ≤ ε_trunc m V
  h_step_exact : ∀ m < K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m),
    (state m).totalAction V =
      (state (m + 1)).c_vac +
        interactingBlockedEffectiveAction
          (haarBlockDisintegration (dyadicScaleSide L_ir m))
          (state (m + 1)).β
          (fun U => (state (m + 1)).polymers.eval U + (state (m + 1)).R_trunc U) V

/-- At the UV scale `m = K`, the Gibbs measure of any `MultiStepHaarRGChain` is identically the
actual finite-volume Wilson measure `wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv`. -/
theorem MultiStepHaarRGChain.uv_gibbsMeasure_eq_wilsonMeasure
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (C : MultiStepHaarRGChain L_ir K β_uv) :
    (C.state K).gibbsMeasure = wilsonMeasure (gaugeHaarMeasure (dyadicScaleSide L_ir K)) β_uv := by
  rw [C.h_uv]
  exact InteractingEffectiveActionState.gibbsMeasure_pureWilson_eq_wilsonMeasure _ _

/-- Approximate RG step bound (Balaban local-action + polymer decomposition): at every step
`m < K`, the local Wilson + polymer action `(C.state m).localPolymerAction V` approximates the
blocked effective action within the truncation envelope `C.ε_trunc m V`. -/
theorem MultiStepHaarRGChain.step_localPolymerAction_approx
    {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ} (C : MultiStepHaarRGChain L_ir K β_uv)
    {m : ℕ} (hm : m < K) (V : GaugeConfig (dyadicScaleSide L_ir m)) :
    |(C.state m).localPolymerAction V -
      ((C.state (m + 1)).c_vac +
        interactingBlockedEffectiveAction
          (haarBlockDisintegration (dyadicScaleSide L_ir m))
          (C.state (m + 1)).β
          (fun U => (C.state (m + 1)).polymers.eval U + (C.state (m + 1)).R_trunc U) V)| ≤
      C.ε_trunc m V := by
  have hstep := C.h_step_exact m hm V
  rw [InteractingEffectiveActionState.totalAction_eq_localPolymerAction_add_R_trunc] at hstep
  have hdiff :
      (C.state m).localPolymerAction V -
        ((C.state (m + 1)).c_vac +
          interactingBlockedEffectiveAction
            (haarBlockDisintegration (dyadicScaleSide L_ir m))
            (C.state (m + 1)).β
            (fun U => (C.state (m + 1)).polymers.eval U + (C.state (m + 1)).R_trunc U) V) =
      -((C.state m).R_trunc V) := by
    linarith
  rw [hdiff, abs_neg]
  exact C.h_R_trunc_le m hm V

/-- Canonical linear single-plaquette coupling extractor on `GaugeConfig L` for any `L ≥ 1`
(`[NeZero L]`), defined by evaluating at the non-commuting plaquette probe configuration
`haarCanonicalNoncommutingProbe L`, whose unit-coupling Wilson action satisfies
`1 ≤ wilsonAction 1 (haarCanonicalNoncommutingProbe L)` and
`wilsonAction 1 (haarCanonicalNoncommutingProbe L) ≠ 0` by
`haarCanonicalNoncommutingProbe_wilsonAction_pos_and_ne_zero`. -/
noncomputable def canonicalHaarProbeExtractor (L : ℕ) [NeZero L] :
    LinearPlaquetteCouplingExtractor L :=
  canonicalPlaquetteProbeExtractor (haarCanonicalNoncommutingProbe L)
    (haarCanonicalNoncommutingProbe_wilsonAction_pos_and_ne_zero L).2.2.1

/-- Canonical `j`-step downward Haar RG state starting from `pureWilson` at `j = 0` (`m = K`),
evolving at each coarse step `j + 1` by extracting the coarse single-plaquette coupling
`β_next = max 0 (extractedCoarseCoupling (canonicalHaarProbeExtractor L_m) A_norm)` from the
vacuum-normalized Haar-blocked effective action `A_norm V = A_eff V - A_eff (vacuumConfig L_m)`,
accumulating `c_vac = st_prev.c_vac + A_eff (vacuumConfig L_m)`, and setting the truncation
remainder `R_trunc V = A_norm V - wilsonAction β_next V` (which equals
`extractedCoarseRemainder (canonicalHaarProbeExtractor L_m) A_norm V` whenever the extracted
coupling is non-negative). -/
noncomputable def canonicalRGStateAux (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) :
    ∀ (_j m : ℕ), InteractingEffectiveActionState (dyadicScaleSide L_ir m)
  | 0, m => InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv
  | j + 1, m =>
      let L_m := dyadicScaleSide L_ir m
      let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
      let A_eff : GaugeConfig L_m → ℝ :=
        interactingBlockedEffectiveAction
          (haarBlockDisintegration L_m)
          st_prev.β
          (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
      let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
      let β_next := max 0 (extractedCoarseCoupling (canonicalHaarProbeExtractor L_m) A_norm)
      { c_vac := st_prev.c_vac + A_eff (vacuumConfig L_m)
        β := β_next
        polymers := PolymerActivityFamily.empty L_m
        R_trunc := fun V => A_norm V - wilsonAction β_next V }

theorem canonicalRGStateAux_β_nonneg (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    ∀ (_j m : ℕ), 0 ≤ (canonicalRGStateAux L_ir β_uv _j m).β
  | 0, _ => hβ
  | _ + 1, _ => le_max_left 0 _

/-- At every RG step `j` and scale `m`, the truncation remainder `R_trunc` of
`canonicalRGStateAux L_ir β_uv j m` vanishes at `vacuumConfig (dyadicScaleSide L_ir m)`. -/
theorem canonicalRGStateAux_R_trunc_vacuum_eq_zero (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ) :
    ∀ (j m : ℕ),
      (canonicalRGStateAux L_ir β_uv j m).R_trunc (vacuumConfig (dyadicScaleSide L_ir m)) = 0
  | 0, _ => rfl
  | j + 1, m => by
      dsimp [canonicalRGStateAux]
      rw [sub_self, wilsonAction_vacuum, sub_zero]

/-- Whenever the probe-extracted coarse coupling at step `j + 1` is non-negative, the truncation
remainder `(canonicalRGStateAux L_ir β_uv (j + 1) m).R_trunc` is identically the projection-orthogonal
remainder `extractedCoarseRemainder (canonicalHaarProbeExtractor L_m) A_norm` and satisfies
`(canonicalHaarProbeExtractor L_m).proj R_trunc = 0`. -/
theorem canonicalRGStateAux_R_trunc_eq_extractedCoarseRemainder (L_ir : ℕ) [NeZero L_ir]
    (β_uv : ℝ) (j m : ℕ)
    (h_ext_nonneg :
      let L_m := dyadicScaleSide L_ir m
      let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
      let A_eff : GaugeConfig L_m → ℝ :=
        interactingBlockedEffectiveAction
          (haarBlockDisintegration L_m)
          st_prev.β
          (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
      let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
      0 ≤ extractedCoarseCoupling (canonicalHaarProbeExtractor L_m) A_norm) :
    let L_m := dyadicScaleSide L_ir m
    let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
    let A_eff : GaugeConfig L_m → ℝ :=
      interactingBlockedEffectiveAction
        (haarBlockDisintegration L_m)
        st_prev.β
        (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
    let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
    (canonicalRGStateAux L_ir β_uv (j + 1) m).β =
      extractedCoarseCoupling (canonicalHaarProbeExtractor L_m) A_norm ∧
    (canonicalRGStateAux L_ir β_uv (j + 1) m).R_trunc =
      extractedCoarseRemainder (canonicalHaarProbeExtractor L_m) A_norm ∧
    (canonicalHaarProbeExtractor L_m).proj
      (canonicalRGStateAux L_ir β_uv (j + 1) m).R_trunc = 0 := by
  dsimp only
  let L_m := dyadicScaleSide L_ir m
  let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
  let A_eff : GaugeConfig L_m → ℝ :=
    interactingBlockedEffectiveAction
      (haarBlockDisintegration L_m)
      st_prev.β
      (fun U => st_prev.polymers.eval U + st_prev.R_trunc U)
  let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
  have hβ_eq :
      (canonicalRGStateAux L_ir β_uv (j + 1) m).β =
        extractedCoarseCoupling (canonicalHaarProbeExtractor L_m) A_norm := by
    dsimp [canonicalRGStateAux]
    exact max_eq_right h_ext_nonneg
  have hR_eq :
      (canonicalRGStateAux L_ir β_uv (j + 1) m).R_trunc =
        extractedCoarseRemainder (canonicalHaarProbeExtractor L_m) A_norm := by
    funext V
    change A_norm V - wilsonAction (canonicalRGStateAux L_ir β_uv (j + 1) m).β V =
      A_norm V - extractedCoarseCoupling (canonicalHaarProbeExtractor L_m) A_norm * wilsonAction 1 V
    rw [hβ_eq, wilsonAction_eq_beta_mul_wilsonAction_one]
  refine ⟨hβ_eq, hR_eq, ?_⟩
  rw [hR_eq]
  exact (effectiveActionDecomposition_unique_of_linearExtractor
    (canonicalHaarProbeExtractor L_m) A_norm).2.1

/-- Canonical `K`-step downward Haar RG state family indexed by scale `m`. -/
noncomputable def canonicalRGState (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ) (m : ℕ) :
    InteractingEffectiveActionState (dyadicScaleSide L_ir m) :=
  if m ≤ K then canonicalRGStateAux L_ir β_uv (K - m) m
  else InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv

theorem canonicalRGState_β_nonneg (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) (m : ℕ) :
    0 ≤ (canonicalRGState L_ir K β_uv m).β := by
  unfold canonicalRGState
  split_ifs
  · exact canonicalRGStateAux_β_nonneg L_ir hβ (K - m) m
  · exact hβ

/-- At zero coupling (`β = 0`) and zero remainder (`K = fun _ => 0`), the interacting blocked
effective action vanishes identically across all coarse configurations `V : GaugeConfig L`. -/
theorem interactingBlockedEffectiveAction_zero {L : ℕ} [NeZero L] [NeZero (2 * L)]
    (dis : ConditionalBlockFiberDisintegration L) (V : GaugeConfig L) :
    interactingBlockedEffectiveAction dis 0 (fun _ => 0) V = 0 := by
  have : IsProbabilityMeasure (dis.fiberKernel V) := dis.fiber_prob V
  simp [interactingBlockedEffectiveAction, interactingBlockedFiberWeight, wilsonAction]

/-- Updating a single coarse link `e : Link L` from `g2` to `g1` in `haarFiberReconstruction L`
updates only the single fine link `YangMillsBlockGeometry.dyadicFineLink L (e, 1) : Link (2 * L)`. -/
theorem haarFiberReconstruction_eq_updateGaugeLink_second {L : ℕ} [NeZero L]
    (V : GaugeConfig L) (e : Link L) (g1 g2 : SU2) (r : HaarFiberCoordinates L) :
    let f₀ := YangMillsBlockGeometry.dyadicFineLink L (e, 1)
    let U1 := haarFiberReconstruction L (updateGaugeLink L V e.x e.μ g1) r
    let U2 := haarFiberReconstruction L (updateGaugeLink L V e.x e.μ g2) r
    U1 = updateGaugeLink (2 * L) U2 f₀.x f₀.μ (U1 f₀) ∧
    U2 = updateGaugeLink (2 * L) U2 f₀.x f₀.μ (U2 f₀) := by
  dsimp only
  set f₀ := YangMillsBlockGeometry.dyadicFineLink L (e, 1)
  set U1 := haarFiberReconstruction L (updateGaugeLink L V e.x e.μ g1) r
  set U2 := haarFiberReconstruction L (updateGaugeLink L V e.x e.μ g2) r
  constructor
  · funext f
    by_cases hf : f = f₀
    · rw [hf]
      exact ((updateGaugeLink_same_and_other (2 * L) U2 f₀.x f₀.μ (U1 f₀)).1).symm
    · rw [(updateGaugeLink_same_and_other (2 * L) U2 f₀.x f₀.μ (U1 f₀)).2 f hf]
      exact haarFiberReconstruction_agree_off_second L V e g1 g2 r f hf
  · funext f
    by_cases hf : f = f₀
    · rw [hf]
      exact ((updateGaugeLink_same_and_other (2 * L) U2 f₀.x f₀.μ (U2 f₀)).1).symm
    · exact ((updateGaugeLink_same_and_other (2 * L) U2 f₀.x f₀.μ (U2 f₀)).2 f hf).symm

/-- Integral representation of `interactingBlockedFiberWeight (haarBlockDisintegration L)` over
`haarFiberReference L`. -/
theorem haarInteractingBlockedFiberWeight_eq_integral {L : ℕ} [NeZero L] [NeZero (2 * L)]
    (β : ℝ) (K : GaugeConfig (2 * L) → ℝ) (hK_meas : Measurable K) (V : GaugeConfig L) :
    interactingBlockedFiberWeight (haarBlockDisintegration L) β K V =
      ∫ r, Real.exp (-wilsonAction β (haarFiberReconstruction L V r) -
        K (haarFiberReconstruction L V r)) ∂(haarFiberReference L) := by
  change (∫ U, Real.exp (-wilsonAction β U - K U) ∂haarBlockKernel L V) = _
  rw [haarBlockKernel_eq_reconstruction_map]
  have h_meas : Measurable (fun U : GaugeConfig (2 * L) => Real.exp (-wilsonAction β U - K U)) :=
    Real.continuous_exp.measurable.comp ((measurable_wilsonAction β).neg.sub hK_meas)
  exact integral_map_of_stronglyMeasurable (measurable_haarFiberReconstruction L V)
    h_meas.stronglyMeasurable

/-- Exact single-link fiber-weight ratio, coarse oscillation, two-link mixed difference, and
canonical RG truncation remainder (`R_trunc`) oscillation bounds for
`interactingBlockedEffectiveAction (haarBlockDisintegration L) β K` when the fine remainder `K` has
single-fine-link oscillation bounded by `δ_K`. -/
theorem haarInteractingBlockedEffectiveAction_singleLink_oscillation_and_twoLink_mixedDifference
    {L : ℕ} [NeZero L] [NeZero (2 * L)]
    {β K_lo K_hi δ_K : ℝ} (hβ : 0 ≤ β)
    (K : GaugeConfig (2 * L) → ℝ) (hK_meas : Measurable K)
    (hK_bounds : ∀ U : GaugeConfig (2 * L), K_lo ≤ K U ∧ K U ≤ K_hi)
    (hK_osc : ∀ (U : GaugeConfig (2 * L)) (f : Link (2 * L)) (h1 h2 : SU2),
      |K (updateGaugeLink (2 * L) U f.x f.μ h1) - K (updateGaugeLink (2 * L) U f.x f.μ h2)| ≤ δ_K)
    (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2) :
    interactingBlockedFiberWeight (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g1) ≤
      Real.exp (12 * β + δ_K) *
        interactingBlockedFiberWeight (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g2) ∧
    |interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g1) -
      interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g2)| ≤
      12 * β + δ_K ∧
    |twoLinkMixedDifference L (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K)
      V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 2 * (12 * β + δ_K) ∧
    |(interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g1) -
        wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g1)) -
      (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g2) -
        wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g2))| ≤
      18 * β + δ_K := by
  have h_ratio : ∀ (W : GaugeConfig L) (f_c : Link L) (u1 u2 : SU2),
      interactingBlockedFiberWeight (haarBlockDisintegration L) β K (updateGaugeLink L W f_c.x f_c.μ u1) ≤
        Real.exp (12 * β + δ_K) *
          interactingBlockedFiberWeight (haarBlockDisintegration L) β K (updateGaugeLink L W f_c.x f_c.μ u2) := by
    intro W f_c u1 u2
    rw [haarInteractingBlockedFiberWeight_eq_integral β K hK_meas,
      haarInteractingBlockedFiberWeight_eq_integral β K hK_meas, ← integral_const_mul]
    have h_int (W' : GaugeConfig L) :
        Integrable (fun r : HaarFiberCoordinates L =>
          Real.exp (-wilsonAction β (haarFiberReconstruction L W' r) -
            K (haarFiberReconstruction L W' r))) (haarFiberReference L) := by
      have hm : Measurable (fun r : HaarFiberCoordinates L =>
          Real.exp (-wilsonAction β (haarFiberReconstruction L W' r) -
            K (haarFiberReconstruction L W' r))) :=
        (Real.continuous_exp.measurable.comp ((measurable_wilsonAction β).neg.sub hK_meas)).comp
          (measurable_haarFiberReconstruction L W')
      apply (integrable_const (Real.exp (-K_lo))).mono' hm.aestronglyMeasurable
      exact Filter.Eventually.of_forall fun r => by
        rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
        refine Real.exp_le_exp.mpr ?_
        have hS0 := wilsonAction_nonneg hβ (haarFiberReconstruction L W' r)
        have hK0 := (hK_bounds (haarFiberReconstruction L W' r)).1
        linarith
    apply integral_mono (h_int _) ((h_int _).const_mul _)
    intro r
    dsimp only
    rw [← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have hS_osc := wilsonAction_oscillation_of_agree_off_link hβ
      (haarFiberReconstruction L (updateGaugeLink L W f_c.x f_c.μ u1) r)
      (haarFiberReconstruction L (updateGaugeLink L W f_c.x f_c.μ u2) r)
      (YangMillsBlockGeometry.dyadicFineLink L (f_c, 1))
      (haarFiberReconstruction_agree_off_second L W f_c u1 u2 r)
    have h_upd := haarFiberReconstruction_eq_updateGaugeLink_second W f_c u1 u2 r
    have hK_r :
        |K (haarFiberReconstruction L (updateGaugeLink L W f_c.x f_c.μ u1) r) -
          K (haarFiberReconstruction L (updateGaugeLink L W f_c.x f_c.μ u2) r)| ≤ δ_K := by
      conv_lhs =>
        rw [h_upd.1]
        arg 1
        arg 2
        rw [h_upd.2]
      exact hK_osc _ (YangMillsBlockGeometry.dyadicFineLink L (f_c, 1)) _ _
    have hS_abs := abs_le.mp hS_osc
    have hK_abs := abs_le.mp hK_r
    linarith
  have h_osc : ∀ (W : GaugeConfig L) (f_c : Link L) (u1 u2 : SU2),
      |interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
          (updateGaugeLink L W f_c.x f_c.μ u1) -
        interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
          (updateGaugeLink L W f_c.x f_c.μ u2)| ≤ 12 * β + δ_K := by
    intro W f_c u1 u2
    have hW1_pos :
        0 < interactingBlockedFiberWeight (haarBlockDisintegration L) β K
          (updateGaugeLink L W f_c.x f_c.μ u1) :=
      (interactingBlockedFiberWeight_zero_remainder_and_exponential_sandwich
        (haarBlockDisintegration L) hβ (measurable_wilsonAction β) K hK_meas hK_bounds _).2.1.2.2
    have hW2_pos :
        0 < interactingBlockedFiberWeight (haarBlockDisintegration L) β K
          (updateGaugeLink L W f_c.x f_c.μ u2) :=
      (interactingBlockedFiberWeight_zero_remainder_and_exponential_sandwich
        (haarBlockDisintegration L) hβ (measurable_wilsonAction β) K hK_meas hK_bounds _).2.1.2.2
    have h12 := Real.log_le_log hW1_pos (h_ratio W f_c u1 u2)
    rw [Real.log_mul (ne_of_gt (Real.exp_pos _)) (ne_of_gt hW2_pos), Real.log_exp] at h12
    have h21 := Real.log_le_log hW2_pos (h_ratio W f_c u2 u1)
    rw [Real.log_mul (ne_of_gt (Real.exp_pos _)) (ne_of_gt hW1_pos), Real.log_exp] at h21
    dsimp [interactingBlockedEffectiveAction]
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have h_mixed :
      |twoLinkMixedDifference L (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K)
        V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ 2 * (12 * β + δ_K) := by
    have h_re :
        twoLinkMixedDifference L (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K)
          V e.x e.μ g1 g2 e'.x e'.μ h1 h2 =
        (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
            (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h1) -
          interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
            (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h2)) -
        (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
            (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h1) -
          interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
            (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h2)) := by
      dsimp [twoLinkMixedDifference, updateTwoGaugeLinks]
      ring
    have h_tri := abs_sub
      (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
          (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h1) -
        interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
          (updateGaugeLink L (updateGaugeLink L V e.x e.μ g1) e'.x e'.μ h2))
      (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
          (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h1) -
        interactingBlockedEffectiveAction (haarBlockDisintegration L) β K
          (updateGaugeLink L (updateGaugeLink L V e.x e.μ g2) e'.x e'.μ h2))
    rw [← h_re] at h_tri
    linarith [h_osc (updateGaugeLink L V e.x e.μ g1) e' h1 h2,
      h_osc (updateGaugeLink L V e.x e.μ g2) e' h1 h2]
  have h_trunc :
      |(interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g1) -
          wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g1)) -
        (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g2) -
          wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g2))| ≤
      18 * β + δ_K := by
    have h_re :
        (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g1) -
            wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g1)) -
          (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g2) -
            wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g2)) =
        (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g1) -
          interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g2)) -
        (wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g1) -
          wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g2)) := by
      ring
    have h_tri := abs_sub
      (interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g1) -
        interactingBlockedEffectiveAction (haarBlockDisintegration L) β K (updateGaugeLink L V e.x e.μ g2))
      (wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g1) -
        wilsonAction ((1 / 2 : ℝ) * β) (updateGaugeLink L V e.x e.μ g2))
    rw [← h_re] at h_tri
    have h_off : ∀ f : Link L, f ≠ e →
        updateGaugeLink L V e.x e.μ g1 f = updateGaugeLink L V e.x e.μ g2 f := fun f hf =>
      ((updateGaugeLink_same_and_other L V e.x e.μ g1).2 f hf).trans
        ((updateGaugeLink_same_and_other L V e.x e.μ g2).2 f hf).symm
    have hW_half := wilsonAction_oscillation_of_agree_off_link (by linarith : 0 ≤ (1 / 2 : ℝ) * β)
      (updateGaugeLink L V e.x e.μ g1) (updateGaugeLink L V e.x e.μ g2) e h_off
    linarith [h_osc V e g1 g2]
  exact ⟨h_ratio V e g1 g2, h_osc V e g1 g2, h_mixed, h_trunc⟩

/-- Derived single-link oscillation and two-link mixed-difference bounds for the probe-extracted
truncation remainder `(canonicalRGStateAux L_ir β_uv (j + 1) m).R_trunc` at step `j + 1`:
whenever the previous-scale remainder `K_prev U = st_prev.polymers.eval U + st_prev.R_trunc U`
has single-link oscillation bounded by `δ_prev`, the extracted truncation remainder `R_trunc` at
scale `m` has single-link oscillation bounded by
`(12 * st_prev.β + δ_prev) + 12 * (canonicalRGStateAux L_ir β_uv (j + 1) m).β` and two-link mixed
difference bounded by `2 * (12 * st_prev.β + δ_prev) + (if e' ∈ dobrushinNeighbors e then 24 * β_next else 0)`. -/
theorem canonicalRGStateAux_step_R_trunc_oscillation_and_mixedDifference
    (L_ir : ℕ) [NeZero L_ir] {β_uv K_lo K_hi δ_prev : ℝ} (hβ : 0 ≤ β_uv) (j m : ℕ)
    (hK_meas : Measurable (fun U : GaugeConfig (dyadicScaleSide L_ir (m + 1)) =>
      (canonicalRGStateAux L_ir β_uv j (m + 1)).polymers.eval U +
        (canonicalRGStateAux L_ir β_uv j (m + 1)).R_trunc U))
    (hK_bounds : ∀ U : GaugeConfig (dyadicScaleSide L_ir (m + 1)),
      K_lo ≤ (canonicalRGStateAux L_ir β_uv j (m + 1)).polymers.eval U +
        (canonicalRGStateAux L_ir β_uv j (m + 1)).R_trunc U ∧
      (canonicalRGStateAux L_ir β_uv j (m + 1)).polymers.eval U +
        (canonicalRGStateAux L_ir β_uv j (m + 1)).R_trunc U ≤ K_hi)
    (hK_osc : ∀ (U : GaugeConfig (dyadicScaleSide L_ir (m + 1)))
      (f : Link (dyadicScaleSide L_ir (m + 1))) (h1 h2 : SU2),
      |((canonicalRGStateAux L_ir β_uv j (m + 1)).polymers.eval
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U f.x f.μ h1) +
        (canonicalRGStateAux L_ir β_uv j (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U f.x f.μ h1)) -
       ((canonicalRGStateAux L_ir β_uv j (m + 1)).polymers.eval
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U f.x f.μ h2) +
        (canonicalRGStateAux L_ir β_uv j (m + 1)).R_trunc
          (updateGaugeLink (dyadicScaleSide L_ir (m + 1)) U f.x f.μ h2))| ≤ δ_prev)
    (V : GaugeConfig (dyadicScaleSide L_ir m))
    (e e' : Link (dyadicScaleSide L_ir m)) (g1 g2 h1 h2 : SU2) :
    let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
    let st_next := canonicalRGStateAux L_ir β_uv (j + 1) m
    |st_next.R_trunc (updateGaugeLink (dyadicScaleSide L_ir m) V e.x e.μ g1) -
      st_next.R_trunc (updateGaugeLink (dyadicScaleSide L_ir m) V e.x e.μ g2)| ≤
      (12 * st_prev.β + δ_prev) + 12 * st_next.β ∧
    (e' ≠ e →
      |twoLinkMixedDifference (dyadicScaleSide L_ir m) st_next.R_trunc
        V e.x e.μ g1 1 e'.x e'.μ h1 h2| ≤
        2 * (12 * st_prev.β + δ_prev) +
          (if e' ∈ dobrushinNeighbors e then 24 * st_next.β else 0)) := by
  dsimp only
  let L_m := dyadicScaleSide L_ir m
  let st_prev := canonicalRGStateAux L_ir β_uv j (m + 1)
  let st_next := canonicalRGStateAux L_ir β_uv (j + 1) m
  have hβ_prev : 0 ≤ st_prev.β := canonicalRGStateAux_β_nonneg L_ir hβ j (m + 1)
  have hβ_next : 0 ≤ st_next.β := canonicalRGStateAux_β_nonneg L_ir hβ (j + 1) m
  let K_prev : GaugeConfig (2 * L_m) → ℝ :=
    fun U => st_prev.polymers.eval U + st_prev.R_trunc U
  have h_haar :=
    haarInteractingBlockedEffectiveAction_singleLink_oscillation_and_twoLink_mixedDifference
      hβ_prev K_prev hK_meas hK_bounds hK_osc V e e' g1 g2 h1 h2
  have h_haar1 :=
    haarInteractingBlockedEffectiveAction_singleLink_oscillation_and_twoLink_mixedDifference
      hβ_prev K_prev hK_meas hK_bounds hK_osc V e e' g1 1 h1 h2
  constructor
  · have h_re :
        st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g1) -
          st_next.R_trunc (updateGaugeLink L_m V e.x e.μ g2) =
        (interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev
            (updateGaugeLink L_m V e.x e.μ g1) -
          interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev
            (updateGaugeLink L_m V e.x e.μ g2)) -
        (wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g1) -
          wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g2)) := by
      dsimp [st_next, canonicalRGStateAux, K_prev]
      ring
    have h_tri := abs_sub
      (interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev
          (updateGaugeLink L_m V e.x e.μ g1) -
        interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev
          (updateGaugeLink L_m V e.x e.μ g2))
      (wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g1) -
        wilsonAction st_next.β (updateGaugeLink L_m V e.x e.μ g2))
    rw [← h_re] at h_tri
    have h_off : ∀ f : Link L_m, f ≠ e →
        updateGaugeLink L_m V e.x e.μ g1 f = updateGaugeLink L_m V e.x e.μ g2 f := fun f hf =>
      ((updateGaugeLink_same_and_other L_m V e.x e.μ g1).2 f hf).trans
        ((updateGaugeLink_same_and_other L_m V e.x e.μ g2).2 f hf).symm
    have hW_osc := wilsonAction_oscillation_of_agree_off_link hβ_next
      (updateGaugeLink L_m V e.x e.μ g1) (updateGaugeLink L_m V e.x e.μ g2) e h_off
    linarith [h_haar.2.1]
  · intro h_ne
    have h_split :
        twoLinkMixedDifference L_m st_next.R_trunc V e.x e.μ g1 1 e'.x e'.μ h1 h2 =
          twoLinkMixedDifference L_m
            (interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev)
            V e.x e.μ g1 1 e'.x e'.μ h1 h2 -
          groupTwoLinkMixedDifference L_m
            (groupWilsonAction su2CompactGaugeClassTrace st_next.β)
            V e.x e.μ g1 1 e'.x e'.μ h1 h2 := by
      dsimp [st_next, canonicalRGStateAux, K_prev, twoLinkMixedDifference,
        groupTwoLinkMixedDifference, updateTwoGaugeLinks, updateTwoGroupGaugeLinks,
        updateGaugeLink, updateGroupGaugeLink, wilsonAction, groupWilsonAction,
        plaquetteAction, groupPlaquetteAction, plaquetteHolonomy, groupPlaquetteHolonomy,
        su2CompactGaugeClassTrace]
      ring
    have h_w_le :
        |groupTwoLinkMixedDifference L_m (groupWilsonAction su2CompactGaugeClassTrace st_next.β)
          V e.x e.μ g1 1 e'.x e'.μ h1 h2| ≤
          if e' ∈ dobrushinNeighbors e then 24 * st_next.β else 0 := by
      split_ifs with h_mem
      · exact groupTwoLinkMixedDifference_groupWilsonAction_abs_le_twentyFour_mul_beta
          su2CompactGaugeClassTrace hβ_next V e e' g1 1 h1 h2
      · rw [groupTwoLinkMixedDifference_groupWilsonAction_eq_zero_of_not_mem_dobrushinNeighbors
          su2CompactGaugeClassTrace st_next.β V e e' h_ne h_mem g1 1 h1 h2, abs_zero]
    have h_tri := abs_sub
      (twoLinkMixedDifference L_m
        (interactingBlockedEffectiveAction (haarBlockDisintegration L_m) st_prev.β K_prev)
        V e.x e.μ g1 1 e'.x e'.μ h1 h2)
      (groupTwoLinkMixedDifference L_m
        (groupWilsonAction su2CompactGaugeClassTrace st_next.β)
        V e.x e.μ g1 1 e'.x e'.μ h1 h2)
    rw [← h_split] at h_tri
    linarith [h_haar1.2.2.1]

/-- At zero bare coupling (`β_uv = 0`), every step `j` of `canonicalRGStateAux` remains identically
equal to `InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0`. -/
theorem canonicalRGStateAux_zero (L_ir : ℕ) [NeZero L_ir] :
    ∀ (j m : ℕ),
      canonicalRGStateAux L_ir 0 j m =
        InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0
  | 0, _ => rfl
  | j + 1, m => by
      dsimp [canonicalRGStateAux]
      rw [canonicalRGStateAux_zero L_ir j (m + 1)]
      dsimp [InteractingEffectiveActionState.pureWilson]
      have h0 :
          (fun U : GaugeConfig (2 * dyadicScaleSide L_ir m) =>
            (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0) =
          fun _ => 0 := by
        funext U
        simp [PolymerActivityFamily.eval_empty]
      have hA_norm_zero :
          (fun V : GaugeConfig (dyadicScaleSide L_ir m) =>
            interactingBlockedEffectiveAction
              (haarBlockDisintegration (dyadicScaleSide L_ir m)) 0
              (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0) V -
            interactingBlockedEffectiveAction
              (haarBlockDisintegration (dyadicScaleSide L_ir m)) 0
              (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0)
              (vacuumConfig (dyadicScaleSide L_ir m))) =
          fun _ => 0 := by
        funext V
        rw [h0, interactingBlockedEffectiveAction_zero, interactingBlockedEffectiveAction_zero,
          sub_self]
      have h_ext_zero :
          extractedCoarseCoupling (canonicalHaarProbeExtractor (dyadicScaleSide L_ir m))
            (fun V =>
              interactingBlockedEffectiveAction
                (haarBlockDisintegration (dyadicScaleSide L_ir m)) 0
                (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0) V -
              interactingBlockedEffectiveAction
                (haarBlockDisintegration (dyadicScaleSide L_ir m)) 0
                (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0)
                (vacuumConfig (dyadicScaleSide L_ir m))) = 0 := by
        rw [hA_norm_zero]
        exact (canonicalHaarProbeExtractor (dyadicScaleSide L_ir m)).proj_const_zero 0
      congr 1
      · rw [h0, interactingBlockedEffectiveAction_zero, add_zero]
      · rw [h_ext_zero, max_self]
      · funext V
        rw [h_ext_zero, max_self, h0, interactingBlockedEffectiveAction_zero,
          interactingBlockedEffectiveAction_zero]
        simp [wilsonAction]

/-- At zero bare coupling (`β_uv = 0`), `canonicalRGState L_ir K 0 m` equals
`InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0` for all `K, m : ℕ`. -/
theorem canonicalRGState_zero (L_ir K : ℕ) [NeZero L_ir] (m : ℕ) :
    canonicalRGState L_ir K 0 m =
      InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0 := by
  unfold canonicalRGState
  split_ifs
  · exact canonicalRGStateAux_zero L_ir (K - m) m
  · rfl

/-- Unconditional zero-coupling (`β_uv = 0`) multi-step Haar RG measure identity: for every
infrared lattice side `L_ir` and every blocking depth `K : ℕ`, the landed IR Gibbs measure of
`canonicalRGState L_ir K 0 0` is identically the uncoupled product Haar measure
`gaugeHaarMeasure L_ir`. -/
theorem canonicalRGState_zero_gibbsMeasure_eq_gaugeHaarMeasure
    (L_ir K : ℕ) [NeZero L_ir] :
    (canonicalRGState L_ir K 0 0).gibbsMeasure = gaugeHaarMeasure L_ir := by
  rw [canonicalRGState_zero L_ir K 0]
  change (InteractingEffectiveActionState.pureWilson L_ir 0).gibbsMeasure = gaugeHaarMeasure L_ir
  rw [InteractingEffectiveActionState.gibbsMeasure_pureWilson_eq_wilsonMeasure, wilsonMeasure_zero]

/-- Every infrared lattice side `L_ir` (`[NeZero L_ir]`), blocking depth `K : ℕ`, and bare UV
coupling `β_uv ≥ 0` admits a canonical inhabitant of `MultiStepHaarRGChain L_ir K β_uv`. -/
theorem exists_multiStepHaarRGChain (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv) :
    Nonempty (MultiStepHaarRGChain L_ir K β_uv) := by
  refine ⟨{
    state := canonicalRGState L_ir K β_uv
    ε_trunc := fun m V => |((canonicalRGState L_ir K β_uv m).R_trunc V)|
    h_uv := by simp [canonicalRGState, canonicalRGStateAux]
    h_β_nonneg := fun m hm => by
      simp only [canonicalRGState, hm, ↓reduceIte]
      exact canonicalRGStateAux_β_nonneg L_ir hβ (K - m) m
    h_ε_nonneg := fun _ _ _ => abs_nonneg _
    h_R_trunc_le := fun _ _ _ => le_rfl
    h_step_exact := fun m hm V => by
      have hm_le : m ≤ K := Nat.le_of_lt hm
      have hm1_le : m + 1 ≤ K := hm
      have hsub : K - m = (K - (m + 1)) + 1 := by omega
      have h_lhs : canonicalRGState L_ir K β_uv m =
          canonicalRGStateAux L_ir β_uv ((K - (m + 1)) + 1) m := by
        simp only [canonicalRGState, hm_le, ↓reduceIte, hsub]
      have h_rhs : canonicalRGState L_ir K β_uv (m + 1) =
          canonicalRGStateAux L_ir β_uv (K - (m + 1)) (m + 1) := by
        simp only [canonicalRGState, hm1_le, ↓reduceIte]
      rw [h_lhs, h_rhs]
      dsimp [canonicalRGStateAux, InteractingEffectiveActionState.totalAction]
      rw [PolymerActivityFamily.eval_empty]
      ring }⟩

/-- Connected two-observable covariance `∫ f g dμ - (∫ f dμ) * (∫ g dμ)` with respect to a
measure `μ` on `GaugeConfig L`. -/
noncomputable def irCov {L : ℕ} (μ : Measure (GaugeConfig L))
    (f g : GaugeConfig L → ℝ) : ℝ :=
  (∫ V, f V * g V ∂μ) - (∫ V, f V ∂μ) * (∫ V, g V ∂μ)

/-- `irCov` on `GaugeConfig L` is judgmentally equal to `groupGibbsCov`. -/
theorem irCov_eq_groupGibbsCov {L : ℕ} (μ : Measure (GaugeConfig L))
    (f g : GaugeConfig L → ℝ) :
    irCov μ f g = groupGibbsCov μ f g := rfl

/-- Bilinear rescaling of `irCov` under constant multiplicative renormalization factors `c1, c2`. -/
theorem irCov_const_mul {L : ℕ} (μ : Measure (GaugeConfig L))
    (c1 c2 : ℝ) (f g : GaugeConfig L → ℝ) :
    irCov μ (fun V => c1 * f V) (fun V => c2 * g V) = c1 * c2 * irCov μ f g := by
  unfold irCov
  have hfg : (fun V => (c1 * f V) * (c2 * g V)) = fun V => (c1 * c2) * (f V * g V) := by
    funext V
    ring
  rw [hfg, integral_const_mul, integral_const_mul, integral_const_mul]
  ring

/-- Invariance of `irCov` under additive constant shifts `a, b` for a probability measure `μ` on
`GaugeConfig L` and integrable observables `f, g, f * g`. -/
theorem irCov_add_const {L : ℕ} (μ : Measure (GaugeConfig L)) [IsProbabilityMeasure μ]
    {f g : GaugeConfig L → ℝ} (hf : Integrable f μ) (hg : Integrable g μ)
    (hfg : Integrable (fun x => f x * g x) μ) (a b : ℝ) :
    irCov μ (fun x => f x + a) (fun x => g x + b) = irCov μ f g := by
  unfold irCov
  have h_prod :
      (fun V => (f V + a) * (g V + b)) =
        fun V => (f V * g V + f V * b) + (a * g V + a * b) := by
    funext V
    ring
  have h1 : Integrable (fun V => f V * g V + f V * b) μ :=
    hfg.add (hf.mul_const b)
  have h2 : Integrable (fun V => a * g V + a * b) μ :=
    (hg.const_mul a).add (integrable_const (a * b))
  rw [h_prod, integral_add h1 h2, integral_add hfg (hf.mul_const b),
    integral_add (hg.const_mul a) (integrable_const (a * b)),
    integral_add hf (integrable_const a), integral_add hg (integrable_const b),
    integral_mul_const, integral_const_mul, integral_const, integral_const,
    integral_const, probReal_univ, one_smul, one_smul, one_smul]
  ring

instance instMeasurableSingletonClassSU2 : MeasurableSingletonClass SU2 :=
  ⟨fun _ => isClosed_singleton.measurableSet⟩

instance instMeasurableSingletonClassGaugeConfig (L : ℕ) [NeZero L] :
    MeasurableSingletonClass (GaugeConfig L) :=
  inferInstanceAs (MeasurableSingletonClass (Link L → SU2))

/-- For any deterministic Dirac measure `Measure.dirac V0` on `GaugeConfig L`, the connected
covariance `irCov (Measure.dirac V0) f g` vanishes identically for all observables `f, g`. -/
theorem irCov_dirac_eq_zero {L : ℕ} [NeZero L] (V0 : GaugeConfig L) (f g : GaugeConfig L → ℝ) :
    irCov (Measure.dirac V0) f g = 0 := by
  simp [irCov]

/-! ### Explicit Finite Link Support, Oscillation & Torus Time-Shift Separation for Multi-Loop Observables -/

/-- Unoriented lattice link `Link L` traversed by an oriented step `s : LatticeStep` starting at `x : Lattice4D L`. -/
def latticeStepLink (L : ℕ) (x : Lattice4D L) : LatticeStep → Link L
  | ⟨μ, true⟩ => ⟨x, μ⟩
  | ⟨μ, false⟩ => ⟨x - unitVec L μ, μ⟩

/-- Finite set of lattice links `Finset (Link L)` traversed by a lattice path `p : List LatticeStep` starting at `x : Lattice4D L`. -/
def latticePathSupport (L : ℕ) : Lattice4D L → List LatticeStep → Finset (Link L)
  | _, [] => ∅
  | x, s :: p => insert (latticeStepLink L x s) (latticePathSupport L (stepTarget x s) p)

/-- Finite link support `Finset (Link L)` of a physical rectangle `ℓ : PhysicalRectangle` at lattice spacing `a`. -/
def physicalRectangleSupport (L : ℕ) (a : ℝ) (ℓ : PhysicalRectangle) : Finset (Link L) :=
  latticePathSupport L (latticeSite L (ℓ.latticeBase a)) (ℓ.latticeLoop a)

/-- Finite link support `Finset (Link L)` of a finite list of physical rectangles `loops : List PhysicalRectangle`
at lattice spacing `a`. -/
def physicalLoopListSupport (L : ℕ) (a : ℝ) : List PhysicalRectangle → Finset (Link L)
  | [] => ∅
  | ℓ :: ls => physicalRectangleSupport L a ℓ ∪ physicalLoopListSupport L a ls

/-- Cardinality of `latticePathSupport L x p` is bounded by the path length `p.length`. -/
theorem card_latticePathSupport_le_length (L : ℕ) :
    ∀ (x : Lattice4D L) (p : List LatticeStep),
      (latticePathSupport L x p).card ≤ p.length
  | _, [] => by simp [latticePathSupport]
  | x, s :: p => by
      dsimp [latticePathSupport]
      exact le_trans (Finset.card_insert_le _ _)
        (Nat.add_le_add_right (card_latticePathSupport_le_length L (stepTarget x s) p) 1)

theorem card_physicalRectangleSupport_le_length (L : ℕ) (a : ℝ) (ℓ : PhysicalRectangle) :
    (physicalRectangleSupport L a ℓ).card ≤ (ℓ.latticeLoop a).length :=
  card_latticePathSupport_le_length L (latticeSite L (ℓ.latticeBase a)) (ℓ.latticeLoop a)

theorem card_physicalLoopListSupport_le_sum_length (L : ℕ) (a : ℝ) :
    ∀ loops : List PhysicalRectangle,
      (physicalLoopListSupport L a loops).card ≤
        (loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum
  | [] => by simp [physicalLoopListSupport]
  | ℓ :: ls => by
      dsimp [physicalLoopListSupport]
      calc
        (physicalRectangleSupport L a ℓ ∪ physicalLoopListSupport L a ls).card
          ≤ (physicalRectangleSupport L a ℓ).card + (physicalLoopListSupport L a ls).card :=
            Finset.card_union_le _ _
        _ ≤ (ℓ.latticeLoop a).length + (ls.map (fun ℓ' => (ℓ'.latticeLoop a).length)).sum :=
            Nat.add_le_add
              (card_physicalRectangleSupport_le_length L a ℓ)
              (card_physicalLoopListSupport_le_sum_length L a ls)

theorem mem_physicalLoopListSupport_iff {L : ℕ} {a : ℝ} {e : Link L} :
    ∀ {loops : List PhysicalRectangle},
      e ∈ physicalLoopListSupport L a loops ↔
        ∃ ℓ ∈ loops, e ∈ physicalRectangleSupport L a ℓ
  | [] => by simp [physicalLoopListSupport]
  | ℓ :: ls => by
      dsimp [physicalLoopListSupport]
      rw [Finset.mem_union, mem_physicalLoopListSupport_iff]
      constructor
      · rintro (he | ⟨ℓ', hℓ', he'⟩)
        · exact ⟨ℓ, List.mem_cons_self, he⟩
        · exact ⟨ℓ', List.mem_cons_of_mem _ hℓ', he'⟩
      · rintro ⟨ℓ', hℓ', he'⟩
        rcases List.mem_cons.mp hℓ' with rfl | h_tail
        · exact Or.inl he'
        · exact Or.inr ⟨ℓ', h_tail, he'⟩

theorem stepHolonomy_updateGroupGaugeLink_eq_of_ne {L : ℕ}
    (U : GaugeConfig L) (x : Lattice4D L) (s : LatticeStep)
    (e : Link L) (hne : e ≠ latticeStepLink L x s) (g : SU2) :
    stepHolonomy (updateGroupGaugeLink L U e.x e.μ g) x s = stepHolonomy U x s := by
  rcases s with ⟨μ, _ | _⟩
  · dsimp [stepHolonomy, latticeStepLink] at *
    rw [(updateGroupGaugeLink_same_and_other L U e.x e.μ g).2 ⟨x - unitVec L μ, μ⟩ (Ne.symm hne)]
  · dsimp [stepHolonomy, latticeStepLink] at *
    exact (updateGroupGaugeLink_same_and_other L U e.x e.μ g).2 ⟨x, μ⟩ (Ne.symm hne)

theorem pathHolonomy_updateGroupGaugeLink_eq_of_not_mem {L : ℕ}
    (U : GaugeConfig L) (e : Link L) (g : SU2) :
    ∀ (x : Lattice4D L) (p : List LatticeStep),
      e ∉ latticePathSupport L x p →
      pathHolonomy (updateGroupGaugeLink L U e.x e.μ g) x p = pathHolonomy U x p
  | _, [], _ => rfl
  | x, s :: p, h_not_mem => by
      dsimp [latticePathSupport] at h_not_mem
      rw [Finset.mem_insert, not_or] at h_not_mem
      dsimp [pathHolonomy]
      rw [stepHolonomy_updateGroupGaugeLink_eq_of_ne U x s e h_not_mem.1 g,
        pathHolonomy_updateGroupGaugeLink_eq_of_not_mem U e g (stepTarget x s) p h_not_mem.2]

theorem physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem {L : ℕ}
    (a : ℝ) (ℓ : PhysicalRectangle) (U : GaugeConfig L) {e : Link L}
    (h_not_mem : e ∉ physicalRectangleSupport L a ℓ) (g : SU2) :
    physicalWilsonLoop L a ℓ (updateGroupGaugeLink L U e.x e.μ g) =
      physicalWilsonLoop L a ℓ U := by
  unfold physicalWilsonLoop wilsonLoop physicalRectangleSupport at *
  rw [pathHolonomy_updateGroupGaugeLink_eq_of_not_mem U e g _ _ h_not_mem]

theorem abs_physicalWilsonLoop_le_one (L : ℕ) (a : ℝ) (ℓ : PhysicalRectangle) (U : GaugeConfig L) :
    |physicalWilsonLoop L a ℓ U| ≤ 1 := by
  rw [physicalWilsonLoop_eq_halfTraceRe]
  exact abs_le.mpr (halfTraceRe_mem_Icc _)

/-- Unrenormalized coarse multi-loop product observable
`V ↦ (F.loops.map (fun ℓ => physicalWilsonLoop L a ℓ V)).prod` at physical block spacing `a`. -/
def irLoopFamilyObservable (L : ℕ) (a : ℝ) (F : DisjointLoopFamily) (U : GaugeConfig L) : ℝ :=
  (F.loops.map (fun ℓ => physicalWilsonLoop L a ℓ U)).prod

theorem list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem {L : ℕ}
    (a : ℝ) (U : GaugeConfig L) {e : Link L} (g : SU2) :
    ∀ (loops : List PhysicalRectangle),
      e ∉ physicalLoopListSupport L a loops →
      (loops.map (fun ℓ => physicalWilsonLoop L a ℓ (updateGroupGaugeLink L U e.x e.μ g))).prod =
        (loops.map (fun ℓ => physicalWilsonLoop L a ℓ U)).prod
  | [], _ => rfl
  | ℓ :: ls, h_not_mem => by
      dsimp [physicalLoopListSupport] at h_not_mem
      rw [Finset.mem_union, not_or] at h_not_mem
      simp only [List.map_cons, List.prod_cons]
      rw [physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a ℓ U h_not_mem.1 g,
        list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a U g ls h_not_mem.2]

theorem linkOscillation_irLoopFamilyObservable_eq_zero_of_not_mem {L : ℕ}
    (a : ℝ) (F : DisjointLoopFamily) {e : Link L}
    (h_not_mem : e ∉ physicalLoopListSupport L a F.loops) :
    linkOscillation SU2 L (irLoopFamilyObservable L a F) e = 0 := by
  refine linkOscillation_eq_zero_of_independent SU2 (irLoopFamilyObservable L a F) e ?_
  intro V g1 g2
  unfold irLoopFamilyObservable
  rw [list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a V g1 F.loops h_not_mem,
    list_prod_physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a V g2 F.loops h_not_mem]

theorem abs_list_prod_physicalWilsonLoop_le_one (L : ℕ) (a : ℝ) (U : GaugeConfig L) :
    ∀ loops : List PhysicalRectangle,
      |(loops.map (fun ℓ => physicalWilsonLoop L a ℓ U)).prod| ≤ 1
  | [] => by simp
  | ℓ :: ls => by
      simp only [List.map_cons, List.prod_cons, abs_mul]
      have h1 := abs_physicalWilsonLoop_le_one L a ℓ U
      have h2 := abs_list_prod_physicalWilsonLoop_le_one L a U ls
      nlinarith [abs_nonneg (physicalWilsonLoop L a ℓ U),
        abs_nonneg (ls.map (fun ℓ' => physicalWilsonLoop L a ℓ' U)).prod]

theorem abs_irLoopFamilyObservable_le_one (L : ℕ) (a : ℝ) (F : DisjointLoopFamily) (U : GaugeConfig L) :
    |irLoopFamilyObservable L a F U| ≤ 1 :=
  abs_list_prod_physicalWilsonLoop_le_one L a U F.loops

theorem continuous_irLoopFamilyObservable (L : ℕ) (a : ℝ) (F : DisjointLoopFamily) :
    Continuous (irLoopFamilyObservable L a F) := by
  unfold irLoopFamilyObservable
  induction F.loops with
  | nil => exact continuous_const
  | cons ℓ ls ih =>
      simp only [List.map_cons, List.prod_cons]
      exact (continuous_physicalWilsonLoop L a ℓ).mul ih

theorem linkOscillation_irLoopFamilyObservable_le_two (L : ℕ) (a : ℝ)
    (F : DisjointLoopFamily) (e : Link L) :
    linkOscillation SU2 L (irLoopFamilyObservable L a F) e ≤ 2 := by
  refine linkOscillation_le_of_forall_le SU2 (irLoopFamilyObservable L a F) e ?_
  intro V g1 g2
  have h1 := abs_irLoopFamilyObservable_le_one L a F (updateGroupGaugeLink L V e.x e.μ g1)
  have h2 := abs_irLoopFamilyObservable_le_one L a F (updateGroupGaugeLink L V e.x e.μ g2)
  have h_tri := abs_sub
    (irLoopFamilyObservable L a F (updateGroupGaugeLink L V e.x e.μ g1))
    (irLoopFamilyObservable L a F (updateGroupGaugeLink L V e.x e.μ g2))
  linarith

theorem sum_linkOscillation_irLoopFamilyObservable_le (L : ℕ) (a : ℝ)
    (F : DisjointLoopFamily) :
    ∑ e ∈ physicalLoopListSupport L a F.loops,
      linkOscillation SU2 L (irLoopFamilyObservable L a F) e ≤
      2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ) := by
  have h_card :
      ((physicalLoopListSupport L a F.loops).card : ℝ) ≤
        (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ) :=
    Nat.cast_le.mpr (card_physicalLoopListSupport_le_sum_length L a F.loops)
  calc
    ∑ e ∈ physicalLoopListSupport L a F.loops,
      linkOscillation SU2 L (irLoopFamilyObservable L a F) e
      ≤ ∑ _e ∈ physicalLoopListSupport L a F.loops, (2 : ℝ) :=
        Finset.sum_le_sum fun e _ => linkOscillation_irLoopFamilyObservable_le_two L a F e
    _ = 2 * ((physicalLoopListSupport L a F.loops).card : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul]
        ring
    _ ≤ 2 * (((F.loops.map (fun ℓ => (ℓ.latticeLoop a).length)).sum : ℕ) : ℝ) :=
        mul_le_mul_of_nonneg_left h_card (by norm_num)

theorem latticePathSupport_append (L : ℕ) :
    ∀ (x : Lattice4D L) (p q : List LatticeStep),
      latticePathSupport L x (p ++ q) =
        latticePathSupport L x p ∪ latticePathSupport L (pathTarget x p) q
  | _, [], _ => by simp [latticePathSupport]
  | x, s :: p, q => by
      dsimp [latticePathSupport, pathTarget]
      rw [latticePathSupport_append L (stepTarget x s) p q, Finset.insert_union]

theorem zmodCyclicDist_stepTarget_le_one (L : ℕ) [NeZero L]
    (x : Lattice4D L) (s : LatticeStep) (i : Fin 4) :
    zmodCyclicDist L (x i) ((stepTarget x s) i) ≤ 1 := by
  rcases s with ⟨μ, _ | _⟩
  · dsimp [stepTarget, unitVec]
    by_cases h : i = μ
    · simp only [h, ↓reduceIte]
      have h_eq :
          zmodCyclicDist L (x μ) (x μ + -1) =
            zmodCyclicDist L ((x μ - 1) + 1) (x μ - 1) := by
        congr 1 <;> ring
      rw [h_eq]
      exact zmodCyclicDist_add_one_left_le_one L (x μ - 1)
    · simp [h, zmodCyclicDist_self]
  · dsimp [stepTarget, unitVec]
    by_cases h : i = μ
    · simp only [h, ↓reduceIte]
      exact zmodCyclicDist_add_one_right_le_one L (x μ)
    · simp [h, zmodCyclicDist_self]

theorem zmodCyclicDist_pathTarget_le_length (L : ℕ) [NeZero L] :
    ∀ (x : Lattice4D L) (r : List LatticeStep) (i : Fin 4),
      zmodCyclicDist L (x i) ((pathTarget x r) i) ≤ r.length
  | x, [], i => by
      dsimp [pathTarget]
      rw [zmodCyclicDist_self]
  | x, s :: r, i => by
      dsimp [pathTarget]
      calc
        zmodCyclicDist L (x i) ((pathTarget (stepTarget x s) r) i)
          ≤ zmodCyclicDist L (x i) ((stepTarget x s) i) +
              zmodCyclicDist L ((stepTarget x s) i) ((pathTarget (stepTarget x s) r) i) :=
            zmodCyclicDist_triangle L (x i) ((stepTarget x s) i)
              ((pathTarget (stepTarget x s) r) i)
        _ ≤ 1 + r.length :=
            Nat.add_le_add (zmodCyclicDist_stepTarget_le_one L x s i)
              (zmodCyclicDist_pathTarget_le_length L (stepTarget x s) r i)
        _ = (s :: r).length := by simp [Nat.add_comm]

theorem exists_take_pathTarget_of_mem_latticePathSupport (L : ℕ) :
    ∀ (x : Lattice4D L) (p : List LatticeStep) {e : Link L},
      e ∈ latticePathSupport L x p →
      ∃ k ≤ p.length, e.x = pathTarget x (p.take k)
  | _, [], _, he => by simp [latticePathSupport] at he
  | x, s :: q, e, he => by
      dsimp [latticePathSupport] at he
      rcases Finset.mem_insert.mp he with rfl | he_tail
      · rcases s with ⟨μ, _ | _⟩
        · refine ⟨1, by simp, ?_⟩
          funext i
          dsimp [latticeStepLink, pathTarget, stepTarget, unitVec]
          by_cases h : i = μ
          · simp [h, sub_eq_add_neg]
          · simp [h]
        · exact ⟨0, Nat.zero_le _, rfl⟩
      · obtain ⟨k, hk_le, hk_eq⟩ :=
          exists_take_pathTarget_of_mem_latticePathSupport L (stepTarget x s) q he_tail
        exact ⟨k + 1, Nat.succ_le_succ hk_le, hk_eq⟩

theorem zmodCyclicDist_pathTarget_take_le (L : ℕ) [NeZero L] (i : Fin 4) :
    ∀ (x : Lattice4D L) (p : List LatticeStep) {a b : ℕ},
      a ≤ b → b ≤ p.length →
      zmodCyclicDist L ((pathTarget x (p.take a)) i) ((pathTarget x (p.take b)) i) ≤ p.length
  | x, p, 0, b, _, hb => by
      dsimp [pathTarget]
      exact ((zmodCyclicDist_pathTarget_le_length L x (p.take b) i).trans
        (List.length_take_le b p)).trans hb
  | _, [], a + 1, b, _, hb => by
      simp at hb
      omega
  | _, _ :: _, _ + 1, 0, hab, _ => by omega
  | x, s :: q, a + 1, b + 1, hab, hb => by
      dsimp [List.take, pathTarget]
      have hab' : a ≤ b := Nat.le_of_succ_le_succ hab
      have hb' : b ≤ q.length := Nat.le_of_succ_le_succ hb
      exact (zmodCyclicDist_pathTarget_take_le L i (stepTarget x s) q hab' hb').trans
        (Nat.le_succ q.length)

/-- Unconditional path-support diameter bound in `linkSupDist`: any two links `e, e'` in the link
support `latticePathSupport L x p` of a lattice path `p` have 4D $\ell_\infty$ cyclic distance
`linkSupDist e e' ≤ p.length`. -/
theorem linkSupDist_le_length_of_mem_latticePathSupport {L : ℕ} [NeZero L]
    {x : Lattice4D L} {p : List LatticeStep} {e e' : Link L}
    (he : e ∈ latticePathSupport L x p) (he' : e' ∈ latticePathSupport L x p) :
    linkSupDist e e' ≤ p.length := by
  obtain ⟨k₁, hk₁, h_eq1⟩ := exists_take_pathTarget_of_mem_latticePathSupport L x p he
  obtain ⟨k₂, hk₂, h_eq2⟩ := exists_take_pathTarget_of_mem_latticePathSupport L x p he'
  unfold linkSupDist
  refine Finset.sup_le fun i _ => ?_
  rw [h_eq1, h_eq2]
  rcases le_total k₁ k₂ with h_le | h_le
  · exact zmodCyclicDist_pathTarget_take_le L i x p h_le hk₂
  · rw [zmodCyclicDist_comm]
    exact zmodCyclicDist_pathTarget_take_le L i x p h_le hk₁

/-- Unconditional path-support diameter bound in `linkTemporalDist`: any two links `e, e'` in the
link support `latticePathSupport L x p` of a lattice path `p` have temporal cyclic distance
`linkTemporalDist e e' ≤ p.length`. -/
theorem linkTemporalDist_le_length_of_mem_latticePathSupport {L : ℕ} [NeZero L]
    {x : Lattice4D L} {p : List LatticeStep} {e e' : Link L}
    (he : e ∈ latticePathSupport L x p) (he' : e' ∈ latticePathSupport L x p) :
    linkTemporalDist e e' ≤ p.length :=
  (linkTemporalDist_le_linkSupDist e e').trans
    (linkSupDist_le_length_of_mem_latticePathSupport he he')

theorem mem_latticePathSupport_spatial_timeCoord {L : ℕ} :
    ∀ (x : Lattice4D L) (p : List LatticeStep),
      (∀ s ∈ p, s.dir ≠ 0) →
      ∀ {e : Link L}, e ∈ latticePathSupport L x p → e.x 0 = x 0
  | _, [], _, _, he => by simp [latticePathSupport] at he
  | x, s :: p, hp, e, he => by
      have hs : s.dir ≠ 0 := hp s List.mem_cons_self
      have ht0 : (stepTarget x s) 0 = x 0 := by
        rcases s with ⟨d, _ | _⟩ <;> simp [stepTarget, unitVec, Ne.symm hs]
      dsimp [latticePathSupport] at he
      rcases Finset.mem_insert.mp he with rfl | he_tail
      · rcases s with ⟨d, _ | _⟩ <;> simp [latticeStepLink, unitVec, Ne.symm hs]
      · rw [mem_latticePathSupport_spatial_timeCoord (stepTarget x s) p
          (fun s' hs' => hp s' (List.mem_cons_of_mem _ hs')) he_tail, ht0]

theorem mem_latticePathSupport_replicate_forward_timeCoord {L : ℕ} :
    ∀ (r : ℕ) (x : Lattice4D L) (m₀ : ℤ),
      x 0 = (m₀ : ZMod L) →
      ∀ {e : Link L}, e ∈ latticePathSupport L x (List.replicate r ⟨0, true⟩) →
      ∃ m : ℤ, m₀ ≤ m ∧ m ≤ m₀ + (r : ℤ) ∧ e.x 0 = (m : ZMod L)
  | 0, _, _, _, _, he => by simp [latticePathSupport] at he
  | k + 1, x, m₀, hx0, e, he => by
      rw [List.replicate_succ] at he
      dsimp [latticePathSupport] at he
      rcases Finset.mem_insert.mp he with rfl | he_tail
      · refine ⟨m₀, le_rfl, by omega, ?_⟩
        simpa [latticeStepLink] using hx0
      · have hx_next : (stepTarget x ⟨0, true⟩) 0 = ((m₀ + 1 : ℤ) : ZMod L) := by
          change x 0 + unitVec L 0 0 = ((m₀ + 1 : ℤ) : ZMod L)
          simp [hx0, unitVec]
        rcases mem_latticePathSupport_replicate_forward_timeCoord k
            (stepTarget x ⟨0, true⟩) (m₀ + 1) hx_next he_tail with ⟨m, hm1, hm2, hm_eq⟩
        exact ⟨m, by omega, by omega, hm_eq⟩

theorem mem_latticePathSupport_replicate_backward_timeCoord {L : ℕ} :
    ∀ (r : ℕ) (x : Lattice4D L) (m₀ : ℤ),
      x 0 = ((m₀ + (r : ℤ) : ℤ) : ZMod L) →
      ∀ {e : Link L}, e ∈ latticePathSupport L x (List.replicate r ⟨0, false⟩) →
      ∃ m : ℤ, m₀ ≤ m ∧ m ≤ m₀ + (r : ℤ) ∧ e.x 0 = (m : ZMod L)
  | 0, _, _, _, _, he => by simp [latticePathSupport] at he
  | k + 1, x, m₀, hx0, e, he => by
      rw [List.replicate_succ] at he
      dsimp [latticePathSupport] at he
      have hx_sub : (x - unitVec L 0) 0 = ((m₀ + (k : ℤ) : ℤ) : ZMod L) := by
        change x 0 - unitVec L 0 0 = ((m₀ + (k : ℤ) : ℤ) : ZMod L)
        rw [hx0]
        simp only [unitVec, ite_true, Nat.cast_add, Nat.cast_one, Int.cast_add, Int.cast_natCast,
          Int.cast_one]
        ring
      rcases Finset.mem_insert.mp he with rfl | he_tail
      · refine ⟨m₀ + (k : ℤ), by omega, by omega, ?_⟩
        simpa [latticeStepLink] using hx_sub
      · have hx_next : (stepTarget x ⟨0, false⟩) 0 = ((m₀ + (k : ℤ) : ℤ) : ZMod L) := by
          change (x + -unitVec L 0) 0 = ((m₀ + (k : ℤ) : ℤ) : ZMod L)
          rw [← sub_eq_add_neg]
          exact hx_sub
        rcases mem_latticePathSupport_replicate_backward_timeCoord k
            (stepTarget x ⟨0, false⟩) m₀ hx_next he_tail with ⟨m, hm1, hm2, hm_eq⟩
        exact ⟨m, hm1, by omega, hm_eq⟩

/-- Every link `e ∈ physicalRectangleSupport L a ℓ` has Euclidean time coordinate
`e.x 0 = (m : ZMod L)` for an integer `m` in the interval
`[ℓ.latticeBase a 0, ℓ.latticeBase a 0 + (if ℓ.μ = 0 then (ℓ.stepsμ a : ℤ) else 0)]`. -/
theorem mem_physicalRectangleSupport_timeCoord_intCast
    (L : ℕ) (a : ℝ) (ℓ : PhysicalRectangle) {e : Link L}
    (he : e ∈ physicalRectangleSupport L a ℓ) :
    ∃ m : ℤ,
      ℓ.latticeBase a 0 ≤ m ∧
      m ≤ ℓ.latticeBase a 0 + (if ℓ.μ = 0 then (ℓ.stepsμ a : ℤ) else 0) ∧
      e.x 0 = (m : ZMod L) := by
  set x₀ := latticeSite L (ℓ.latticeBase a)
  set m₀ := ℓ.latticeBase a 0
  have hx₀ : x₀ 0 = (m₀ : ZMod L) := rfl
  have hν : ℓ.ν ≠ 0 := (lt_of_le_of_lt (Fin.zero_le ℓ.μ) ℓ.plane).ne'
  by_cases hμ : ℓ.μ = 0
  · simp only [hμ, ite_true]
    set r := ℓ.stepsμ a
    set s := ℓ.stepsν a
    have hloop :
        ℓ.latticeLoop a =
          List.replicate r ⟨0, true⟩ ++ List.replicate s ⟨ℓ.ν, true⟩ ++
            List.replicate r ⟨0, false⟩ ++ List.replicate s ⟨ℓ.ν, false⟩ := by
      simp only [PhysicalRectangle.latticeLoop, rectangleSteps, hμ, r, s]
    have hspat (b : Bool) (k : ℕ) :
        ∀ st ∈ List.replicate k (⟨ℓ.ν, b⟩ : LatticeStep), st.dir ≠ 0 := by
      intro st hst
      rw [List.eq_of_mem_replicate hst]
      exact hν
    unfold physicalRectangleSupport at he
    rw [hloop, latticePathSupport_append, latticePathSupport_append,
      latticePathSupport_append] at he
    rcases Finset.mem_union.mp he with he123 | he4
    · rcases Finset.mem_union.mp he123 with he12 | he3
      · rcases Finset.mem_union.mp he12 with he1 | he2
        · exact mem_latticePathSupport_replicate_forward_timeCoord r x₀ m₀ hx₀ he1
        · have h_eq :=
            mem_latticePathSupport_spatial_timeCoord _ _ (hspat true s) he2
          refine ⟨m₀ + (r : ℤ), by omega, le_rfl, ?_⟩
          rw [h_eq, pathTarget_replicate]
          simp [m₀, latticeSite, unitVec]
      · have hx2 :
            (pathTarget x₀ (List.replicate r ⟨0, true⟩ ++ List.replicate s ⟨ℓ.ν, true⟩)) 0 =
              ((m₀ + (r : ℤ) : ℤ) : ZMod L) := by
          rw [pathTarget_append, pathTarget_replicate, pathTarget_replicate]
          simp [x₀, m₀, latticeSite, unitVec, Ne.symm hν]
        exact mem_latticePathSupport_replicate_backward_timeCoord r _ m₀ hx2 he3
    · have h_eq :=
        mem_latticePathSupport_spatial_timeCoord _ _ (hspat false s) he4
      refine ⟨m₀, le_rfl, by omega, ?_⟩
      rw [h_eq, pathTarget_append, pathTarget_append, pathTarget_replicate,
        pathTarget_replicate, pathTarget_replicate]
      simp [m₀, latticeSite, unitVec, Ne.symm hν]
  · simp only [hμ, ite_false, add_zero]
    have hspat : ∀ st ∈ ℓ.latticeLoop a, st.dir ≠ 0 := by
      intro st hst
      simp only [PhysicalRectangle.latticeLoop, rectangleSteps, List.mem_append,
        List.mem_replicate] at hst
      rcases hst with ((⟨_, rfl⟩ | ⟨_, rfl⟩) | ⟨_, rfl⟩) | ⟨_, rfl⟩
      · exact hμ
      · exact hν
      · exact hμ
      · exact hν
    have h_eq := mem_latticePathSupport_spatial_timeCoord x₀ (ℓ.latticeLoop a) hspat he
    exact ⟨m₀, le_rfl, le_rfl, h_eq.trans hx₀⟩

/-- For any positive-time physical rectangle `ℓ` (`0 < ℓ.base 0`) and spacing `0 < a`, every link
`e ∈ physicalRectangleSupport L a ℓ.timeReflect` has strictly negative integer time coordinate
`e.x 0 = (m : ZMod L)` with `ℓ.timeReflect.latticeBase a 0 ≤ m ≤ -1` (`m < 0`). -/
theorem mem_physicalRectangleSupport_timeReflect_timeCoord_neg
    (L : ℕ) {a : ℝ} (ha : 0 < a) {ℓ : PhysicalRectangle} (hpos : ℓ.IsPositiveTime)
    {e : Link L} (he : e ∈ physicalRectangleSupport L a ℓ.timeReflect) :
    ∃ m : ℤ,
      ℓ.timeReflect.latticeBase a 0 ≤ m ∧ m ≤ -1 ∧ e.x 0 = (m : ZMod L) := by
  obtain ⟨m, hm_lo, hm_hi, hm_eq⟩ := mem_physicalRectangleSupport_timeCoord_intCast L a ℓ.timeReflect he
  have hμ_eq : ℓ.timeReflect.μ = ℓ.μ := rfl
  have hsteps_eq : ℓ.timeReflect.stepsμ a = ℓ.stepsμ a := rfl
  rw [hμ_eq, hsteps_eq] at hm_hi
  have hb0_pos : (0 : ℝ) < (ℓ.base 0 : ℝ) := by exact_mod_cast hpos
  have hb0_div_pos : 0 < (ℓ.base 0 : ℝ) / a := div_pos hb0_pos ha
  have h_upper_neg :
      ℓ.timeReflect.latticeBase a 0 + (if ℓ.μ = 0 then (ℓ.stepsμ a : ℤ) else 0) ≤ -1 := by
    by_cases hμ : ℓ.μ = 0
    · simp only [hμ, ite_true]
      have h_side_nonneg : 0 ≤ (ℓ.sideμ : ℝ) / a :=
        div_nonneg (by exact_mod_cast ℓ.sideμ_pos.le) ha.le
      have h_floor_steps : ((ℓ.stepsμ a : ℕ) : ℝ) ≤ (ℓ.sideμ : ℝ) / a :=
        Nat.floor_le h_side_nonneg
      have h_base_eq : (ℓ.timeReflect.base 0 : ℝ) = -(ℓ.base 0 : ℝ) - (ℓ.sideμ : ℝ) :=
        timeReflect_base_zero_of_eq hμ
      have h_floor_le :
          (ℓ.timeReflect.latticeBase a 0 : ℝ) ≤ -((ℓ.base 0 : ℝ) / a) - (ℓ.sideμ : ℝ) / a := by
        have h1 : (ℓ.timeReflect.latticeBase a 0 : ℝ) ≤ (ℓ.timeReflect.base 0 : ℝ) / a :=
          Int.floor_le _
        have h2 : (ℓ.timeReflect.base 0 : ℝ) / a = -((ℓ.base 0 : ℝ) / a) - (ℓ.sideμ : ℝ) / a := by
          rw [h_base_eq]
          ring
        exact h1.trans_eq h2
      have h_lt :
          (ℓ.timeReflect.latticeBase a 0 : ℝ) + ((ℓ.stepsμ a : ℕ) : ℝ) < 0 := by
        linarith
      have h_lt_int : ℓ.timeReflect.latticeBase a 0 + (ℓ.stepsμ a : ℤ) < 0 := by
        exact_mod_cast h_lt
      omega
    · simp only [hμ, ite_false, add_zero]
      have h_base_eq : (ℓ.timeReflect.base 0 : ℝ) = -(ℓ.base 0 : ℝ) :=
        timeReflect_base_zero_of_ne hμ
      have h_floor_le :
          (ℓ.timeReflect.latticeBase a 0 : ℝ) ≤ -((ℓ.base 0 : ℝ) / a) := by
        have h1 : (ℓ.timeReflect.latticeBase a 0 : ℝ) ≤ (ℓ.timeReflect.base 0 : ℝ) / a :=
          Int.floor_le _
        have h2 : (ℓ.timeReflect.base 0 : ℝ) / a = -((ℓ.base 0 : ℝ) / a) := by
          rw [h_base_eq]
          ring
        exact h1.trans_eq h2
      have h_lt : (ℓ.timeReflect.latticeBase a 0 : ℝ) < (0 : ℝ) := by linarith
      have h_lt_int : ℓ.timeReflect.latticeBase a 0 < 0 := by exact_mod_cast h_lt
      omega
  exact ⟨m, hm_lo, hm_hi.trans h_upper_neg, hm_eq⟩

/-- For any positive-time physical rectangle `ℓ` (`0 < ℓ.base 0`) and spacing `0 < a`, every link
`e ∈ physicalRectangleSupport L a ℓ.timeReflect` has time coordinate `e.x 0 = (m : ZMod L)` with
`ℓ.timeReflect.latticeBase a 0 ≤ m ≤ 0`. -/
theorem mem_physicalRectangleSupport_timeReflect_timeCoord_nonpos
    (L : ℕ) {a : ℝ} (ha : 0 < a) {ℓ : PhysicalRectangle} (hpos : ℓ.IsPositiveTime)
    {e : Link L} (he : e ∈ physicalRectangleSupport L a ℓ.timeReflect) :
    ∃ m : ℤ,
      ℓ.timeReflect.latticeBase a 0 ≤ m ∧ m ≤ 0 ∧ e.x 0 = (m : ZMod L) := by
  obtain ⟨m, hm_lo, hm_hi, hm_eq⟩ :=
    mem_physicalRectangleSupport_timeReflect_timeCoord_neg L ha hpos he
  exact ⟨m, hm_lo, by omega, hm_eq⟩

/-- For any positive-time physical rectangle `ℓ` (`0 < ℓ.base 0`), positive rational spacing
`0 < s : ℚ`, and integer time shift `t : ℕ`, every link
`e' ∈ physicalRectangleSupport L (s : ℝ) (ℓ.translate (timeShift (t * s)))` has time coordinate
`e'.x 0 = (m' : ZMod L)` with
`(t : ℤ) ≤ m' ≤ (t : ℤ) + ℓ.latticeBase (s : ℝ) 0 + (ℓ.stepsμ (s : ℝ) : ℤ)`. -/
theorem mem_physicalRectangleSupport_timeShift_timeCoord_bounds
    (L : ℕ) {s : ℚ} (hs : 0 < s) {ℓ : PhysicalRectangle} (hpos : ℓ.IsPositiveTime)
    (t : ℕ) {e' : Link L}
    (he' : e' ∈ physicalRectangleSupport L (s : ℝ) (ℓ.translate (timeShift (t * s)))) :
    ∃ m' : ℤ,
      (t : ℤ) ≤ m' ∧
      m' ≤ (t : ℤ) + ℓ.latticeBase (s : ℝ) 0 + (ℓ.stepsμ (s : ℝ) : ℤ) ∧
      e'.x 0 = (m' : ZMod L) := by
  have ha : (0 : ℝ) < (s : ℝ) := Rat.cast_pos.mpr hs
  obtain ⟨m', hm'_lo, hm'_hi, hm'_eq⟩ :=
    mem_physicalRectangleSupport_timeCoord_intCast L (s : ℝ) (ℓ.translate (timeShift (t * s))) he'
  have h_base_shift :
      (ℓ.translate (timeShift (t * s))).latticeBase (s : ℝ) 0 =
        ℓ.latticeBase (s : ℝ) 0 + (t : ℤ) := by
    unfold PhysicalRectangle.latticeBase PhysicalRectangle.translate timeShift
    simp only [Pi.add_apply, ite_true, Rat.cast_add, Rat.cast_mul, Rat.cast_natCast]
    have h_div :
        ((ℓ.base 0 : ℝ) + (t : ℝ) * (s : ℝ)) / (s : ℝ) =
          (ℓ.base 0 : ℝ) / (s : ℝ) + ((t : ℤ) : ℝ) := by
      rw [add_div, mul_div_cancel_right₀ _ ha.ne', Int.cast_natCast]
    rw [h_div, Int.floor_add_intCast]
  have h_base_nonneg : 0 ≤ ℓ.latticeBase (s : ℝ) 0 := by
    unfold PhysicalRectangle.latticeBase
    exact Int.floor_nonneg.mpr (div_nonneg (by exact_mod_cast hpos.le) ha.le)
  have hμ_eq : (ℓ.translate (timeShift (t * s))).μ = ℓ.μ := rfl
  have hsteps_eq : (ℓ.translate (timeShift (t * s))).stepsμ (s : ℝ) = ℓ.stepsμ (s : ℝ) := rfl
  rw [h_base_shift] at hm'_lo hm'_hi
  rw [hμ_eq, hsteps_eq] at hm'_hi
  have h_if_le : (if ℓ.μ = 0 then (ℓ.stepsμ (s : ℝ) : ℤ) else 0) ≤ (ℓ.stepsμ (s : ℝ) : ℤ) := by
    split_ifs <;> omega
  exact ⟨m', by omega, by omega, hm'_eq⟩

/-- Integer time-span bound for a single rectangle `ℓ` at spacing `a`. -/
noncomputable def loopTimeSpanBound (a : ℝ) (ℓ : PhysicalRectangle) : ℕ :=
  (ℓ.latticeBase a 0).natAbs + ℓ.stepsμ a + (ℓ.timeReflect.latticeBase a 0).natAbs

/-- For any positive-time physical rectangle `ℓ` (`0 < ℓ.base 0`) and spacing `0 < a`, on any torus
of side `L > 2 * loopTimeSpanBound a ℓ`:
1. Every link `e ∈ physicalRectangleSupport L a ℓ.timeReflect` and every link
   `e' ∈ physicalRectangleSupport L a ℓ` are separated by at least `1` lattice time step
   (`1 ≤ linkTemporalDist e e'`) and satisfy `e ≠ e'`, and
2. `physicalRectangleSupport L a ℓ.timeReflect` and `physicalRectangleSupport L a ℓ` sit on
   strictly disjoint lattice links (`Disjoint (physicalRectangleSupport L a ℓ.timeReflect) (physicalRectangleSupport L a ℓ)`). -/
theorem disjoint_physicalRectangleSupport_timeReflect_self
    (L : ℕ) [NeZero L] {a : ℝ} (ha : 0 < a) {ℓ : PhysicalRectangle} (hpos : ℓ.IsPositiveTime)
    (hL : 2 * loopTimeSpanBound a ℓ < L) :
    (∀ e ∈ physicalRectangleSupport L a ℓ.timeReflect,
      ∀ e' ∈ physicalRectangleSupport L a ℓ,
        1 ≤ linkTemporalDist e e' ∧ e ≠ e') ∧
    Disjoint (physicalRectangleSupport L a ℓ.timeReflect) (physicalRectangleSupport L a ℓ) := by
  have h_sep :
      ∀ e ∈ physicalRectangleSupport L a ℓ.timeReflect,
        ∀ e' ∈ physicalRectangleSupport L a ℓ,
          1 ≤ linkTemporalDist e e' ∧ e ≠ e' := by
    intro e he e' he'
    obtain ⟨m, hm_lo, hm_hi, hm_eq⟩ :=
      mem_physicalRectangleSupport_timeReflect_timeCoord_neg L ha hpos he
    obtain ⟨m', hm'_lo, hm'_hi, hm'_eq⟩ :=
      mem_physicalRectangleSupport_timeCoord_intCast L a ℓ he'
    have h_base_nonneg : 0 ≤ ℓ.latticeBase a 0 := by
      unfold PhysicalRectangle.latticeBase
      exact Int.floor_nonneg.mpr (div_nonneg (by exact_mod_cast hpos.le) ha.le)
    have h_if_le : (if ℓ.μ = 0 then (ℓ.stepsμ a : ℤ) else 0) ≤ (ℓ.stepsμ a : ℤ) := by
      split_ifs <;> omega
    have h_diff_lo : ((1 : ℕ) : ℤ) ≤ m' - m := by omega
    have h_diff_hi : m' - m ≤ (loopTimeSpanBound a ℓ : ℤ) := by
      unfold loopTimeSpanBound
      have h_na1 := Int.le_natAbs (a := ℓ.latticeBase a 0)
      have h_na2 := Int.le_natAbs (a := -ℓ.timeReflect.latticeBase a 0)
      rw [Int.natAbs_neg] at h_na2
      omega
    have h_temp : 1 ≤ linkTemporalDist e e' := by
      unfold linkTemporalDist
      rw [hm_eq, hm'_eq]
      exact zmodCyclicDist_intCast_ge_of_le L h_diff_lo h_diff_hi hL
    refine ⟨h_temp, ?_⟩
    rintro rfl
    have h0 : linkTemporalDist e e = 0 := zmodCyclicDist_self L (e.x 0)
    omega
  exact ⟨h_sep, Finset.disjoint_left.mpr fun e he he' => (h_sep e he e he').2 rfl⟩

/-- Maximum integer time-span bound across a list of rectangles `loops` at spacing `a`. -/
noncomputable def loopListTimeSpanBound (a : ℝ) (loops : List PhysicalRectangle) : ℕ :=
  (loops.map (loopTimeSpanBound a)).foldr max 0

theorem loopTimeSpanBound_le_loopListTimeSpanBound (a : ℝ) :
    ∀ {loops : List PhysicalRectangle} {ℓ : PhysicalRectangle},
      ℓ ∈ loops → loopTimeSpanBound a ℓ ≤ loopListTimeSpanBound a loops
  | [], _, h => by cases h
  | ℓ₀ :: ls, ℓ, h => by
      dsimp [loopListTimeSpanBound]
      rcases List.mem_cons.mp h with rfl | h_tail
      · exact le_max_left _ _
      · exact (loopTimeSpanBound_le_loopListTimeSpanBound a h_tail).trans (le_max_right _ _)

/-- For any positive-time loop family `F : DisjointLoopFamily`, positive rational spacing `0 < s`,
and time shift `t : ℕ`, on any torus of side `L > 2 * (t + 2 * loopListTimeSpanBound (s : ℝ) F.loops)`,
every link `e ∈ physicalLoopListSupport L (s : ℝ) F.reflect.loops` and every link
`e' ∈ physicalLoopListSupport L (s : ℝ) (F.translate (timeShift (t * s))).loops` are separated by
at least `t` lattice steps in both `linkTemporalDist` and `linkSupDist`. -/
theorem physicalLoopListSupport_timeShift_sep_of_lt_side
    (L : ℕ) [NeZero L] {s : ℚ} (hs : 0 < s)
    {F : DisjointLoopFamily} (hFpos : F.PositiveTime) (t : ℕ)
    (hL : 2 * (t + 2 * loopListTimeSpanBound (s : ℝ) F.loops) < L)
    {e e' : Link L}
    (he : e ∈ physicalLoopListSupport L (s : ℝ) F.reflect.loops)
    (he' : e' ∈ physicalLoopListSupport L (s : ℝ) (F.translate (timeShift (t * s))).loops) :
    t ≤ linkTemporalDist e e' ∧ t ≤ linkSupDist e e' := by
  rw [mem_physicalLoopListSupport_iff] at he he'
  rcases he with ⟨ℓ_r, hℓ_r_mem, he_rect⟩
  rcases he' with ⟨ℓ_t, hℓ_t_mem, he'_rect⟩
  rcases List.mem_map.mp hℓ_r_mem with ⟨ℓ₁, hℓ₁_mem, rfl⟩
  rcases List.mem_map.mp hℓ_t_mem with ⟨ℓ₂, hℓ₂_mem, rfl⟩
  have ha : (0 : ℝ) < (s : ℝ) := Rat.cast_pos.mpr hs
  obtain ⟨m, hm_lo, hm_hi, hm_eq⟩ :=
    mem_physicalRectangleSupport_timeReflect_timeCoord_nonpos L ha (hFpos ℓ₁ hℓ₁_mem) he_rect
  obtain ⟨m', hm'_lo, hm'_hi, hm'_eq⟩ :=
    mem_physicalRectangleSupport_timeShift_timeCoord_bounds L hs (hFpos ℓ₂ hℓ₂_mem) t he'_rect
  have h_span1 : loopTimeSpanBound (s : ℝ) ℓ₁ ≤ loopListTimeSpanBound (s : ℝ) F.loops :=
    loopTimeSpanBound_le_loopListTimeSpanBound (s : ℝ) hℓ₁_mem
  have h_span2 : loopTimeSpanBound (s : ℝ) ℓ₂ ≤ loopListTimeSpanBound (s : ℝ) F.loops :=
    loopTimeSpanBound_le_loopListTimeSpanBound (s : ℝ) hℓ₂_mem
  have hm_abs : -((loopTimeSpanBound (s : ℝ) ℓ₁ : ℕ) : ℤ) ≤ ℓ₁.timeReflect.latticeBase (s : ℝ) 0 := by
    unfold loopTimeSpanBound
    have h_na := Int.le_natAbs (a := -ℓ₁.timeReflect.latticeBase (s : ℝ) 0)
    rw [Int.natAbs_neg] at h_na
    omega
  have hm'_abs :
      ℓ₂.latticeBase (s : ℝ) 0 + (ℓ₂.stepsμ (s : ℝ) : ℤ) ≤
        ((loopTimeSpanBound (s : ℝ) ℓ₂ : ℕ) : ℤ) := by
    unfold loopTimeSpanBound
    have := Int.le_natAbs (a := ℓ₂.latticeBase (s : ℝ) 0)
    omega
  set D : ℕ := t + 2 * loopListTimeSpanBound (s : ℝ) F.loops
  have h_diff_lo : (t : ℤ) ≤ m' - m := by omega
  have h_diff_hi : m' - m ≤ (D : ℤ) := by omega
  have h_temp : t ≤ linkTemporalDist e e' := by
    unfold linkTemporalDist
    rw [hm_eq, hm'_eq]
    exact zmodCyclicDist_intCast_ge_of_le L h_diff_lo h_diff_hi hL
  exact ⟨h_temp, h_temp.trans (linkTemporalDist_le_linkSupDist e e')⟩

/-! ### Stage 0.1 & p2.A3: Admissible Half-Offset Loop Families (`RectOnGrid`, `rectLinksZ4`, `IsAdmissible`) and Canonical Spatial Probe (`canonicalSpatialProbe`) -/

/-- A physical rectangle `ℓ` lies on the `a`-spaced coset `a · (ℤ⁴ + θ)` with sides positive
integer multiples of `a`. -/
def RectOnGrid (a : ℚ) (θ : Fin 4 → ℚ) (ℓ : PhysicalRectangle) : Prop :=
  (∀ i : Fin 4, ∃ k : ℤ, ℓ.base i = ((k : ℚ) + θ i) * a) ∧
  (∃ r : ℕ, 0 < r ∧ ℓ.sideμ = (r : ℚ) * a) ∧
  (∃ s : ℕ, 0 < s ∧ ℓ.sideν = (s : ℚ) * a)

/-- Standard unit basis vector on the infinite lattice `ℤ⁴` in direction `μ`. -/
def z4UnitVec (μ : Direction) : Fin 4 → ℤ :=
  fun i => if i = μ then 1 else 0

/-- Link set of `ℓ : PhysicalRectangle` on the infinite lattice `ℤ⁴` at spacing `a`
(`n`-independent, with no torus wrap-around). -/
def rectLinksZ4 (a : ℚ) (ℓ : PhysicalRectangle) : Set ((Fin 4 → ℤ) × Direction) :=
  let b := ℓ.latticeBase (a : ℝ)
  let r := ℓ.stepsμ (a : ℝ)
  let s := ℓ.stepsν (a : ℝ)
  { e |
    (∃ i < r, e = (b + (i : ℤ) • z4UnitVec ℓ.μ, ℓ.μ)) ∨
    (∃ i < r, e = (b + (s : ℤ) • z4UnitVec ℓ.ν + (i : ℤ) • z4UnitVec ℓ.μ, ℓ.μ)) ∨
    (∃ j < s, e = (b + (j : ℤ) • z4UnitVec ℓ.ν, ℓ.ν)) ∨
    (∃ j < s, e = (b + (r : ℤ) • z4UnitVec ℓ.μ + (j : ℤ) • z4UnitVec ℓ.ν, ℓ.ν)) }

/-- Admissible loop family on the `a`-spaced coset `a · (ℤ⁴ + θ)`: every loop lies on
`RectOnGrid a θ`, the loop list has no duplicates (`Nodup`), and distinct loops have pairwise
disjoint infinite-lattice link supports `rectLinksZ4 a`. -/
def _root_.JesseMath.Physics.YangMillsOsterwalderSchraderInheritance.DisjointLoopFamily.IsAdmissible
    (a : ℚ) (θ : Fin 4 → ℚ) (F : DisjointLoopFamily) : Prop :=
  (∀ ℓ ∈ F.loops, RectOnGrid a θ ℓ) ∧
  F.loops.Nodup ∧
  F.loops.Pairwise (fun ℓ ℓ' => Disjoint (rectLinksZ4 a ℓ) (rectLinksZ4 a ℓ'))

/-- Half-integer coset offset `θ_i = 1 / 2` in every coordinate `i : Fin 4`. -/
def halfOffset : Fin 4 → ℚ := fun _ => 1 / 2

/-- No duplicate pair `⟨[ℓ, ℓ]⟩` is admissible (excluded by `Nodup`). -/
theorem not_isAdmissible_duplicate (a : ℚ) (θ : Fin 4 → ℚ) (ℓ : PhysicalRectangle) :
    ¬ (⟨[ℓ, ℓ]⟩ : DisjointLoopFamily).IsAdmissible a θ := by
  rintro ⟨_, hnodup, _⟩
  simp at hnodup

/-- Canonical positive-time spatial unit plaquette of side `a` at half-offset base `fun _ => a / 2`
in the `(1, 2)` spatial plane. -/
def canonicalSpatialProbe (a : ℚ) (ha : 0 < a) : PhysicalRectangle where
  base := fun _ => a / 2
  μ := 1
  ν := 2
  plane := by decide
  sideμ := a
  sideν := a
  sideμ_pos := ha
  sideν_pos := ha

theorem canonicalSpatialProbe_rectOnGrid {a : ℚ} (ha : 0 < a) :
    RectOnGrid a halfOffset (canonicalSpatialProbe a ha) := by
  refine ⟨fun i => ⟨0, ?_⟩, ⟨1, Nat.one_pos, ?_⟩, ⟨1, Nat.one_pos, ?_⟩⟩
  · simp [canonicalSpatialProbe, halfOffset]
    ring
  · simp [canonicalSpatialProbe]
  · simp [canonicalSpatialProbe]

theorem timeReflect_canonicalSpatialProbe_rectOnGrid {a : ℚ} (ha : 0 < a) :
    RectOnGrid a halfOffset (canonicalSpatialProbe a ha).timeReflect := by
  refine ⟨fun i => ?_, ⟨1, Nat.one_pos, ?_⟩, ⟨1, Nat.one_pos, ?_⟩⟩
  · by_cases hi : i = 0
    · subst hi
      refine ⟨-1, ?_⟩
      simp [PhysicalRectangle.timeReflect, canonicalSpatialProbe, halfOffset]
      ring
    · refine ⟨0, ?_⟩
      simp [PhysicalRectangle.timeReflect, canonicalSpatialProbe, halfOffset, hi]
      ring
  · simp [PhysicalRectangle.timeReflect, canonicalSpatialProbe]
  · simp [PhysicalRectangle.timeReflect, canonicalSpatialProbe]

/-- Every link in `rectLinksZ4 a ℓ` for a spatial rectangle (`ℓ.μ ≠ 0` and `ℓ.ν ≠ 0`) has integer
time coordinate `e.1 0 = ℓ.latticeBase (a : ℝ) 0`. -/
theorem mem_rectLinksZ4_timeCoord_of_spatial (a : ℚ) {ℓ : PhysicalRectangle}
    (hμ : ℓ.μ ≠ 0) (hν : ℓ.ν ≠ 0) {e : (Fin 4 → ℤ) × Direction}
    (he : e ∈ rectLinksZ4 a ℓ) :
    e.1 0 = ℓ.latticeBase (a : ℝ) 0 := by
  have hzμ : z4UnitVec ℓ.μ 0 = 0 := by simp [z4UnitVec, Ne.symm hμ]
  have hzν : z4UnitVec ℓ.ν 0 = 0 := by simp [z4UnitVec, Ne.symm hν]
  rcases he with ⟨i, _, rfl⟩ | ⟨i, _, rfl⟩ | ⟨j, _, rfl⟩ | ⟨j, _, rfl⟩ <;>
    simp [hzμ, hzν]

theorem latticeBase_zero_canonicalSpatialProbe {a : ℚ} (ha : 0 < a) :
    (canonicalSpatialProbe a ha).latticeBase (a : ℝ) 0 = 0 := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  unfold PhysicalRectangle.latticeBase canonicalSpatialProbe
  dsimp only
  have h_div : ((a / 2 : ℚ) : ℝ) / (a : ℝ) = (1 / 2 : ℝ) := by
    push_cast
    field_simp [ha_real.ne']
  rw [h_div]
  exact Int.floor_eq_iff.mpr ⟨by norm_num, by norm_num⟩

theorem latticeBase_zero_timeReflect_canonicalSpatialProbe {a : ℚ} (ha : 0 < a) :
    (canonicalSpatialProbe a ha).timeReflect.latticeBase (a : ℝ) 0 = -1 := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  unfold PhysicalRectangle.latticeBase PhysicalRectangle.timeReflect canonicalSpatialProbe
  dsimp only
  have hμ : (1 : Direction) ≠ 0 := by decide
  simp only [Function.update_self, hμ, ↓reduceIte, sub_zero]
  have h_div : ((-(a / 2) : ℚ) : ℝ) / (a : ℝ) = (-1 / 2 : ℝ) := by
    push_cast
    field_simp [ha_real.ne']
  rw [h_div]
  exact Int.floor_eq_iff.mpr ⟨by norm_num, by norm_num⟩

/-- Positive control for `IsAdmissible`: the reflected probe pair
`⟨[(canonicalSpatialProbe a ha).timeReflect, canonicalSpatialProbe a ha]⟩` is admissible on the
half-offset grid `(a, halfOffset)` for every `0 < a`. -/
theorem isAdmissible_canonicalSpatialProbe_reflect_pair {a : ℚ} (ha : 0 < a) :
    (⟨[(canonicalSpatialProbe a ha).timeReflect, canonicalSpatialProbe a ha]⟩ :
      DisjointLoopFamily).IsAdmissible a halfOffset := by
  set p := canonicalSpatialProbe a ha
  have hp_base0 : p.latticeBase (a : ℝ) 0 = 0 := latticeBase_zero_canonicalSpatialProbe ha
  have hpr_base0 : p.timeReflect.latticeBase (a : ℝ) 0 = -1 :=
    latticeBase_zero_timeReflect_canonicalSpatialProbe ha
  have h_ne : p.timeReflect ≠ p := by
    intro h_eq
    have h0 : p.timeReflect.latticeBase (a : ℝ) 0 = p.latticeBase (a : ℝ) 0 :=
      congrFun (congrArg (fun ℓ => ℓ.latticeBase (a : ℝ)) h_eq) 0
    omega
  have h_disj : Disjoint (rectLinksZ4 a p.timeReflect) (rectLinksZ4 a p) := by
    have hμ : (1 : Direction) ≠ 0 := by decide
    have hν : (2 : Direction) ≠ 0 := by decide
    rw [Set.disjoint_left]
    intro e he_r he_p
    have h1 : e.1 0 = p.timeReflect.latticeBase (a : ℝ) 0 :=
      mem_rectLinksZ4_timeCoord_of_spatial a hμ hν he_r
    have h2 : e.1 0 = p.latticeBase (a : ℝ) 0 :=
      mem_rectLinksZ4_timeCoord_of_spatial a hμ hν he_p
    omega
  refine ⟨?_, ?_, ?_⟩
  · intro ℓ hℓ
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hℓ
    rcases hℓ with rfl | rfl
    · exact timeReflect_canonicalSpatialProbe_rectOnGrid ha
    · exact canonicalSpatialProbe_rectOnGrid ha
  · simp [h_ne]
  · simp [h_disj]

/-- `canonicalSpatialProbe a ha` has strictly positive Euclidean time `0 < a / 2`. -/
theorem canonicalSpatialProbe_isPositiveTime {a : ℚ} (ha : 0 < a) :
    (canonicalSpatialProbe a ha).IsPositiveTime := by
  show (0 : ℚ) < a / 2
  linarith

/-- Shift rigidity: the reflected canonical probe equals `canonicalSpatialProbe a ha` translated by
`-a` in Euclidean time. -/
theorem canonicalSpatialProbe_timeReflect_eq_translate {a : ℚ} (ha : 0 < a) :
    (canonicalSpatialProbe a ha).timeReflect =
      (canonicalSpatialProbe a ha).translate (timeShift (-a)) := by
  simp only [PhysicalRectangle.timeReflect, PhysicalRectangle.translate, canonicalSpatialProbe,
    PhysicalRectangle.mk.injEq, and_true]
  funext i
  by_cases hi : i = 0
  · subst hi
    have hμ : (1 : Direction) ≠ 0 := by decide
    simp [timeShift, hμ]
    ring
  · simp [timeShift, hi]

/-- At spacing `a`, `canonicalSpatialProbe a ha` is a `1 × 1` unit plaquette (`stepsμ = 1`, `stepsν = 1`). -/
theorem canonicalSpatialProbe_steps {a : ℚ} (ha : 0 < a) :
    (canonicalSpatialProbe a ha).stepsμ (a : ℝ) = 1 ∧
      (canonicalSpatialProbe a ha).stepsν (a : ℝ) = 1 := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  have h1 : (a : ℝ) / (a : ℝ) = ((1 : ℕ) : ℝ) := by
    rw [div_self ha_real.ne']
    norm_num
  refine ⟨?_, ?_⟩
  · unfold PhysicalRectangle.stepsμ canonicalSpatialProbe
    dsimp only
    rw [h1, Nat.floor_natCast]
  · unfold PhysicalRectangle.stepsν canonicalSpatialProbe
    dsimp only
    rw [h1, Nat.floor_natCast]

/-- Full 4-coordinate coarse lattice base `(canonicalSpatialProbe a ha).latticeBase (a : ℝ) = 0`. -/
theorem latticeBase_canonicalSpatialProbe_eq_zero {a : ℚ} (ha : 0 < a) :
    (canonicalSpatialProbe a ha).latticeBase (a : ℝ) = 0 := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  funext i
  unfold PhysicalRectangle.latticeBase canonicalSpatialProbe
  dsimp only [Pi.zero_apply]
  have h_div : ((a / 2 : ℚ) : ℝ) / (a : ℝ) = (1 / 2 : ℝ) := by
    push_cast
    field_simp [ha_real.ne']
  rw [h_div]
  exact Int.floor_eq_iff.mpr ⟨by norm_num, by norm_num⟩

/-- Full 4-coordinate coarse lattice base of the reflected canonical probe
`(canonicalSpatialProbe a ha).timeReflect.latticeBase (a : ℝ) = (-1, 0, 0, 0)`. -/
theorem latticeBase_timeReflect_canonicalSpatialProbe {a : ℚ} (ha : 0 < a) :
    (canonicalSpatialProbe a ha).timeReflect.latticeBase (a : ℝ) =
      fun i => if i = 0 then -1 else 0 := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  funext i
  by_cases hi : i = 0
  · subst hi
    simp only [↓reduceIte]
    exact latticeBase_zero_timeReflect_canonicalSpatialProbe ha
  · simp only [hi, ↓reduceIte]
    unfold PhysicalRectangle.latticeBase PhysicalRectangle.timeReflect canonicalSpatialProbe
    dsimp only
    simp only [Function.update_of_ne hi]
    have h_div : ((a / 2 : ℚ) : ℝ) / (a : ℝ) = (1 / 2 : ℝ) := by
      push_cast
      field_simp [ha_real.ne']
    rw [h_div]
    exact Int.floor_eq_iff.mpr ⟨by norm_num, by norm_num⟩

/-- Singleton admissibility for `canonicalSpatialProbe a ha`. -/
theorem isAdmissible_singleton_canonicalSpatialProbe {a : ℚ} (ha : 0 < a) :
    (⟨[canonicalSpatialProbe a ha]⟩ : DisjointLoopFamily).IsAdmissible a halfOffset := by
  refine ⟨?_, by simp, by simp⟩
  intro ℓ hℓ
  rcases List.mem_singleton.mp hℓ with rfl
  exact canonicalSpatialProbe_rectOnGrid ha

/-- Singleton admissibility for `(canonicalSpatialProbe a ha).timeReflect`. -/
theorem isAdmissible_singleton_timeReflect_canonicalSpatialProbe {a : ℚ} (ha : 0 < a) :
    (⟨[(canonicalSpatialProbe a ha).timeReflect]⟩ : DisjointLoopFamily).IsAdmissible a halfOffset := by
  refine ⟨?_, by simp, by simp⟩
  intro ℓ hℓ
  rcases List.mem_singleton.mp hℓ with rfl
  exact timeReflect_canonicalSpatialProbe_rectOnGrid ha

/-! ### Stage p3.B1: Half-Offset Time-Reflection Closure of `IsAdmissible` -/

/-- Half-offset grid membership `RectOnGrid a halfOffset` is preserved under Euclidean time
reflection `PhysicalRectangle.timeReflect`. -/
theorem rectOnGrid_halfOffset_timeReflect {a : ℚ} {ℓ : PhysicalRectangle}
    (hℓ : RectOnGrid a halfOffset ℓ) : RectOnGrid a halfOffset ℓ.timeReflect := by
  refine ⟨fun i => ?_, hℓ.2.1, hℓ.2.2⟩
  by_cases hi : i = 0
  · subst hi
    obtain ⟨k, hk⟩ := hℓ.1 0
    by_cases hμ : ℓ.μ = 0
    · obtain ⟨r, _, hr⟩ := hℓ.2.1
      refine ⟨-k - (r : ℤ) - 1, ?_⟩
      simp only [PhysicalRectangle.timeReflect, Function.update_self, hμ, ↓reduceIte, halfOffset,
        hk, hr]
      push_cast
      ring
    · refine ⟨-k - 1, ?_⟩
      simp only [PhysicalRectangle.timeReflect, Function.update_self, hμ, ↓reduceIte, halfOffset,
        hk]
      push_cast
      ring
  · obtain ⟨k, hk⟩ := hℓ.1 i
    refine ⟨k, ?_⟩
    simp only [PhysicalRectangle.timeReflect, Function.update_of_ne hi, hk]

/-- Link-level image of time reflection on the half-offset grid (lattice units). A spatial link
(`e.2 ≠ 0`) at time coordinate `t` goes to `-1 - t`; a temporal link (`e.2 = 0`) starting at `t`
goes to `-2 - t`. -/
def z4ReflectLink (e : (Fin 4 → ℤ) × Direction) : (Fin 4 → ℤ) × Direction :=
  (Function.update e.1 0 (if e.2 = 0 then -2 - e.1 0 else -1 - e.1 0), e.2)

theorem z4ReflectLink_involutive : Function.Involutive z4ReflectLink := by
  intro ⟨x, d⟩
  apply Prod.ext
  · funext i
    by_cases hi : i = 0
    · subst hi
      by_cases hd : d = 0 <;> simp [z4ReflectLink, hd]
    · simp [z4ReflectLink, hi]
  · rfl

theorem latticeBase_timeReflect_halfOffset {a : ℚ} (ha : 0 < a) {ℓ : PhysicalRectangle}
    (hℓ : RectOnGrid a halfOffset ℓ) :
    ℓ.timeReflect.latticeBase (a : ℝ) =
      Function.update (ℓ.latticeBase (a : ℝ)) 0
        (-1 - ℓ.latticeBase (a : ℝ) 0 - (if ℓ.μ = 0 then (ℓ.stepsμ (a : ℝ) : ℤ) else 0)) := by
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  funext i
  by_cases hi : i = 0
  · subst hi
    simp only [Function.update_self]
    obtain ⟨k, hk⟩ := hℓ.1 0
    have h_b0 : ℓ.latticeBase (a : ℝ) 0 = k := by
      unfold PhysicalRectangle.latticeBase
      have hdiv : (ℓ.base 0 : ℝ) / (a : ℝ) = (k : ℝ) + 1 / 2 := by
        rw [hk, halfOffset]
        push_cast
        field_simp [ha_real.ne']
      rw [hdiv]
      exact Int.floor_eq_iff.mpr ⟨by linarith, by linarith⟩
    rw [h_b0]
    by_cases hμ : ℓ.μ = 0
    · obtain ⟨r, _, hr⟩ := hℓ.2.1
      have h_steps : ℓ.stepsμ (a : ℝ) = r := by
        unfold PhysicalRectangle.stepsμ
        have hdiv : (ℓ.sideμ : ℝ) / (a : ℝ) = ((r : ℕ) : ℝ) := by
          rw [hr]
          push_cast
          field_simp [ha_real.ne']
        rw [hdiv, Nat.floor_natCast]
      simp only [hμ, ↓reduceIte, h_steps]
      unfold PhysicalRectangle.latticeBase PhysicalRectangle.timeReflect
      dsimp only
      simp only [Function.update_self, hμ, ↓reduceIte]
      have hdiv : (((-(ℓ.base 0) - ℓ.sideμ : ℚ) : ℝ) / (a : ℝ)) =
          ((-1 - k - (r : ℤ) : ℤ) : ℝ) + 1 / 2 := by
        rw [hk, hr, halfOffset]
        push_cast
        field_simp [ha_real.ne']
        ring
      rw [hdiv]
      exact Int.floor_eq_iff.mpr ⟨by linarith, by linarith⟩
    · simp only [hμ, ↓reduceIte, sub_zero]
      unfold PhysicalRectangle.latticeBase PhysicalRectangle.timeReflect
      dsimp only
      simp only [Function.update_self, hμ, ↓reduceIte, sub_zero]
      have hdiv : (((-(ℓ.base 0) : ℚ) : ℝ) / (a : ℝ)) = ((-1 - k : ℤ) : ℝ) + 1 / 2 := by
        rw [hk, halfOffset]
        push_cast
        field_simp [ha_real.ne']
        ring
      rw [hdiv]
      exact Int.floor_eq_iff.mpr ⟨by linarith, by linarith⟩
  · simp only [Function.update_of_ne hi, latticeBase_timeReflect_of_ne ℓ hi]

theorem rectLinksZ4_timeReflect_halfOffset {a : ℚ} (ha : 0 < a) {ℓ : PhysicalRectangle}
    (hℓ : RectOnGrid a halfOffset ℓ) :
    rectLinksZ4 a ℓ.timeReflect = z4ReflectLink '' rectLinksZ4 a ℓ := by
  have h_sub : ∀ {ℓ : PhysicalRectangle}, RectOnGrid a halfOffset ℓ →
      ∀ e ∈ rectLinksZ4 a ℓ, z4ReflectLink e ∈ rectLinksZ4 a ℓ.timeReflect := by
    intro ℓ hℓ e he
    have hν : ℓ.ν ≠ 0 := (lt_of_le_of_lt (Fin.zero_le ℓ.μ) ℓ.plane).ne'
    have hzν : z4UnitVec ℓ.ν 0 = 0 := by simp [z4UnitVec, Ne.symm hν]
    have hb' := latticeBase_timeReflect_halfOffset ha hℓ
    have hμ_eq : ℓ.timeReflect.μ = ℓ.μ := rfl
    have hν_eq : ℓ.timeReflect.ν = ℓ.ν := rfl
    have hr_eq : ℓ.timeReflect.stepsμ (a : ℝ) = ℓ.stepsμ (a : ℝ) := rfl
    have hs_eq : ℓ.timeReflect.stepsν (a : ℝ) = ℓ.stepsν (a : ℝ) := rfl
    dsimp only [rectLinksZ4] at he ⊢
    rw [hμ_eq, hν_eq, hr_eq, hs_eq, hb']
    by_cases hμ : ℓ.μ = 0
    · rcases he with ⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩ | ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
      · left; refine ⟨ℓ.stepsμ (a : ℝ) - 1 - i, by omega, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, z4UnitVec, hμ]; omega
        · simp [z4ReflectLink, z4UnitVec, hμ, hc]
      · right; left; refine ⟨ℓ.stepsμ (a : ℝ) - 1 - i, by omega, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, z4UnitVec, hμ, Ne.symm hν]; omega
        · simp [z4ReflectLink, z4UnitVec, hμ, Ne.symm hν, hc]
      · right; right; right; refine ⟨j, hj, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, z4UnitVec, hμ, hν, Ne.symm hν]
        · simp [z4ReflectLink, z4UnitVec, hμ, hν, Ne.symm hν, hc]
      · right; right; left; refine ⟨j, hj, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, z4UnitVec, hμ, hν, Ne.symm hν]; omega
        · simp [z4ReflectLink, z4UnitVec, hμ, hν, Ne.symm hν, hc]
    · have hzμ : z4UnitVec ℓ.μ 0 = 0 := by simp [z4UnitVec, Ne.symm hμ]
      rcases he with ⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩ | ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
      · left; refine ⟨i, hi, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, hμ, hzμ]
        · simp [z4ReflectLink, hc]
      · right; left; refine ⟨i, hi, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, hμ, hzμ, hzν]
        · simp [z4ReflectLink, hc]
      · right; right; left; refine ⟨j, hj, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, hμ, hν, hzν]
        · simp [z4ReflectLink, hc]
      · right; right; right; refine ⟨j, hj, Prod.ext (funext fun c => ?_) rfl⟩
        rcases eq_or_ne c 0 with rfl | hc
        · simp [z4ReflectLink, hμ, hν, hzμ, hzν]
        · simp [z4ReflectLink, hc]
  ext e
  constructor
  · intro he
    refine ⟨z4ReflectLink e, ?_, z4ReflectLink_involutive e⟩
    have he' := h_sub (rectOnGrid_halfOffset_timeReflect hℓ) e he
    rwa [timeReflect_timeReflect] at he'
  · rintro ⟨e', he', rfl⟩
    exact h_sub hℓ e' he'

theorem _root_.JesseMath.Physics.YangMillsOsterwalderSchraderInheritance.DisjointLoopFamily.isAdmissible_reflect_halfOffset
    {a : ℚ} (ha : 0 < a) {F : DisjointLoopFamily} (hF : F.IsAdmissible a halfOffset) :
    F.reflect.IsAdmissible a halfOffset := by
  have hinj : Function.Injective PhysicalRectangle.timeReflect :=
    Function.Involutive.injective timeReflect_timeReflect
  refine ⟨?_, hF.2.1.map hinj, ?_⟩
  · intro ℓ' hℓ'
    simp only [DisjointLoopFamily.reflect, List.mem_map] at hℓ'
    obtain ⟨ℓ, hℓ, rfl⟩ := hℓ'
    exact rectOnGrid_halfOffset_timeReflect (hF.1 ℓ hℓ)
  · rw [DisjointLoopFamily.reflect, List.pairwise_map]
    refine hF.2.2.imp_of_mem ?_
    intro ℓ₁ ℓ₂ hℓ₁ hℓ₂ hdisj
    rw [rectLinksZ4_timeReflect_halfOffset ha (hF.1 ℓ₁ hℓ₁),
      rectLinksZ4_timeReflect_halfOffset ha (hF.1 ℓ₂ hℓ₂)]
    exact (Set.disjoint_image_iff z4ReflectLink_involutive.injective).mpr hdisj

theorem rectLinksZ4_timeCoord_bounds {a : ℚ} {ℓ : PhysicalRectangle} {e : (Fin 4 → ℤ) × Direction}
    (he : e ∈ rectLinksZ4 a ℓ) :
    ℓ.latticeBase (a : ℝ) 0 ≤ e.1 0 ∧
      e.1 0 ≤ ℓ.latticeBase (a : ℝ) 0 + (if ℓ.μ = 0 then (ℓ.stepsμ (a : ℝ) : ℤ) else 0) := by
  have hν : ℓ.ν ≠ 0 := (lt_of_le_of_lt (Fin.zero_le ℓ.μ) ℓ.plane).ne'
  have hzν : z4UnitVec ℓ.ν 0 = 0 := by simp [z4UnitVec, Ne.symm hν]
  have hz0 : z4UnitVec 0 0 = 1 := rfl
  by_cases hμ : ℓ.μ = 0
  · rcases he with ⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩ | ⟨j, _, rfl⟩ | ⟨j, _, rfl⟩ <;>
      simp [hμ, hz0, hzν] <;> omega
  · have hzμ : z4UnitVec ℓ.μ 0 = 0 := by simp [z4UnitVec, Ne.symm hμ]
    rcases he with ⟨i, _, rfl⟩ | ⟨i, _, rfl⟩ | ⟨j, _, rfl⟩ | ⟨j, _, rfl⟩ <;>
      simp [hμ, hzμ, hzν]

theorem _root_.JesseMath.Physics.YangMillsOsterwalderSchraderInheritance.DisjointLoopFamily.isAdmissible_reflect_append_halfOffset
    {a : ℚ} (ha : 0 < a) {F : DisjointLoopFamily} (hF : F.IsAdmissible a halfOffset)
    (hpos : F.PositiveTime) : (F.reflect.append F).IsAdmissible a halfOffset := by
  have hF_refl : F.reflect.IsAdmissible a halfOffset := F.isAdmissible_reflect_halfOffset ha hF
  have ha_real : (0 : ℝ) < (a : ℝ) := Rat.cast_pos.mpr ha
  have h_base_nonneg : ∀ ℓ ∈ F.loops, 0 ≤ ℓ.latticeBase (a : ℝ) 0 := by
    intro ℓ hℓ
    obtain ⟨k, hk⟩ := (hF.1 ℓ hℓ).1 0
    have h0 : (0 : ℚ) < ℓ.base 0 := hpos ℓ hℓ
    rw [hk, halfOffset] at h0
    have hk_pos : (0 : ℚ) < (k : ℚ) + 1 / 2 := pos_of_mul_pos_left h0 ha.le
    have hk_nonneg : 0 ≤ k := by
      by_contra hlt
      have hk_le : (k : ℚ) ≤ -1 := by exact_mod_cast Int.le_sub_one_of_lt (not_le.mp hlt)
      linarith
    have h_b0 : ℓ.latticeBase (a : ℝ) 0 = k := by
      unfold PhysicalRectangle.latticeBase
      have hdiv : (ℓ.base 0 : ℝ) / (a : ℝ) = (k : ℝ) + 1 / 2 := by
        rw [hk, halfOffset]
        push_cast
        field_simp [ha_real.ne']
      rw [hdiv]
      exact Int.floor_eq_iff.mpr ⟨by linarith, by linarith⟩
    omega
  have h_refl_upper : ∀ ℓ' ∈ F.loops,
      ℓ'.timeReflect.latticeBase (a : ℝ) 0 +
        (if ℓ'.timeReflect.μ = 0 then (ℓ'.timeReflect.stepsμ (a : ℝ) : ℤ) else 0) ≤ -1 := by
    intro ℓ' hℓ'
    have hb' := congrFun (latticeBase_timeReflect_halfOffset ha (hF.1 ℓ' hℓ')) 0
    simp only [Function.update_self] at hb'
    have hμ_eq : ℓ'.timeReflect.μ = ℓ'.μ := rfl
    have hr_eq : ℓ'.timeReflect.stepsμ (a : ℝ) = ℓ'.stepsμ (a : ℝ) := rfl
    rw [hb', hμ_eq, hr_eq]
    have hk' := h_base_nonneg ℓ' hℓ'
    omega
  refine ⟨?_, ?_, ?_⟩
  · intro ℓ hℓ
    simp only [DisjointLoopFamily.append, List.mem_append] at hℓ
    rcases hℓ with hℓ | hℓ
    · exact hF_refl.1 ℓ hℓ
    · exact hF.1 ℓ hℓ
  · rw [DisjointLoopFamily.append, List.nodup_append]
    refine ⟨hF_refl.2.1, hF.2.1, ?_⟩
    intro ℓ₁ hℓ₁ ℓ₂ hℓ₂ heq
    simp only [DisjointLoopFamily.reflect, List.mem_map] at hℓ₁
    obtain ⟨ℓ', hℓ', rfl⟩ := hℓ₁
    have h1 := h_refl_upper ℓ' hℓ'
    have h2 := h_base_nonneg ℓ₂ hℓ₂
    have h_step_nonneg : 0 ≤ (if ℓ'.timeReflect.μ = 0 then (ℓ'.timeReflect.stepsμ (a : ℝ) : ℤ) else 0) := by
      split_ifs <;> omega
    have h0 : ℓ'.timeReflect.latticeBase (a : ℝ) 0 = ℓ₂.latticeBase (a : ℝ) 0 :=
      congrFun (congrArg (fun ℓ => ℓ.latticeBase (a : ℝ)) heq) 0
    omega
  · rw [DisjointLoopFamily.append, List.pairwise_append]
    refine ⟨hF_refl.2.2, hF.2.2, ?_⟩
    intro ℓ₁ hℓ₁ ℓ₂ hℓ₂
    simp only [DisjointLoopFamily.reflect, List.mem_map] at hℓ₁
    obtain ⟨ℓ', hℓ', rfl⟩ := hℓ₁
    rw [Set.disjoint_left]
    intro e he₁ he₂
    have hb₁ := (rectLinksZ4_timeCoord_bounds he₁).2
    have hb₂ := (rectLinksZ4_timeCoord_bounds he₂).1
    have h1 := h_refl_upper ℓ' hℓ'
    have h2 := h_base_nonneg ℓ₂ hℓ₂
    omega

/-- DEGENERACY: a temporal unit rectangle straddling `t = 0` on the half-offset grid
(`base = -(a/2)` in every coordinate, `μ = 0`, `ν = 1`, sides `a`) is its own time reflection. -/
def straddlerProbe (a : ℚ) (ha : 0 < a) : PhysicalRectangle where
  base := fun _ => -(a / 2)
  μ := 0
  ν := 1
  plane := by decide
  sideμ := a
  sideν := a
  sideμ_pos := ha
  sideν_pos := ha

theorem straddlerProbe_timeReflect {a : ℚ} (ha : 0 < a) :
    (straddlerProbe a ha).timeReflect = straddlerProbe a ha := by
  simp only [PhysicalRectangle.timeReflect, straddlerProbe, PhysicalRectangle.mk.injEq, and_true]
  funext i
  by_cases hi : i = 0
  · subst hi
    simp only [Function.update_self, ↓reduceIte]
    ring
  · simp only [Function.update_of_ne hi]

theorem isAdmissible_singleton_straddlerProbe {a : ℚ} (ha : 0 < a) :
    (⟨[straddlerProbe a ha]⟩ : DisjointLoopFamily).IsAdmissible a halfOffset := by
  refine ⟨?_, by simp, by simp⟩
  intro ℓ hℓ
  rcases List.mem_singleton.mp hℓ with rfl
  refine ⟨fun i => ⟨-1, ?_⟩, ⟨1, Nat.one_pos, ?_⟩, ⟨1, Nat.one_pos, ?_⟩⟩
  · simp [straddlerProbe, halfOffset]
    ring
  · simp [straddlerProbe]
  · simp [straddlerProbe]

theorem not_isAdmissible_reflect_append_straddlerProbe {a : ℚ} (ha : 0 < a) :
    ¬ ((⟨[straddlerProbe a ha]⟩ : DisjointLoopFamily).reflect.append
        ⟨[straddlerProbe a ha]⟩).IsAdmissible a halfOffset := by
  have h_eq :
      (⟨[straddlerProbe a ha]⟩ : DisjointLoopFamily).reflect.append ⟨[straddlerProbe a ha]⟩ =
        ⟨[straddlerProbe a ha, straddlerProbe a ha]⟩ := by
    simp [DisjointLoopFamily.reflect, DisjointLoopFamily.append, straddlerProbe_timeReflect ha]
  rw [h_eq]
  exact not_isAdmissible_duplicate a halfOffset (straddlerProbe a ha)

example {a : ℚ} (ha : 0 < a) :
    (⟨[(canonicalSpatialProbe a ha).timeReflect, canonicalSpatialProbe a ha]⟩ :
      DisjointLoopFamily).IsAdmissible a halfOffset :=
  DisjointLoopFamily.isAdmissible_reflect_append_halfOffset ha
    (isAdmissible_singleton_canonicalSpatialProbe ha)
    (fun _ hℓ => (List.mem_singleton.mp hℓ) ▸ canonicalSpatialProbe_isPositiveTime ha)

/-! ### Stage p3.B2: Coordinate-Permutation Closure of `IsAdmissible` -/

def z4PermLink (σ : Equiv.Perm (Fin 4)) (e : (Fin 4 → ℤ) × Direction) : (Fin 4 → ℤ) × Direction :=
  (e.1 ∘ σ.symm, σ e.2)

theorem z4PermLink_injective (σ : Equiv.Perm (Fin 4)) : Function.Injective (z4PermLink σ) := by
  have h_left : Function.LeftInverse (z4PermLink σ.symm) (z4PermLink σ) := by
    intro ⟨x, d⟩
    exact Prod.ext (funext fun i => by simp [z4PermLink]) (by simp [z4PermLink])
  exact h_left.injective

theorem z4UnitVec_comp_symm (σ : Equiv.Perm (Fin 4)) (μ : Direction) :
    z4UnitVec μ ∘ σ.symm = z4UnitVec (σ μ) := by
  funext i
  simp only [Function.comp_apply, z4UnitVec, Equiv.symm_apply_eq]

theorem rectOnGrid_permute {a : ℚ} {θ : Fin 4 → ℚ} {σ : Equiv.Perm (Fin 4)} {ℓ : PhysicalRectangle}
    (hθ : θ ∘ σ.symm = θ) (hℓ : RectOnGrid a θ ℓ) : RectOnGrid a θ (ℓ.permute σ) := by
  refine ⟨fun i => ?_, ?_, ?_⟩
  · obtain ⟨k, hk⟩ := hℓ.1 (σ.symm i)
    refine ⟨k, ?_⟩
    have h_base : (ℓ.permute σ).base i = ℓ.base (σ.symm i) := by
      simp only [PhysicalRectangle.permute]
      split_ifs <;> rfl
    have hθ_i : θ (σ.symm i) = θ i := congrFun hθ i
    rw [h_base, hk, hθ_i]
  · simp only [PhysicalRectangle.permute]
    split_ifs
    · exact hℓ.2.1
    · exact hℓ.2.2
  · simp only [PhysicalRectangle.permute]
    split_ifs
    · exact hℓ.2.2
    · exact hℓ.2.1

theorem rectLinksZ4_permute (a : ℚ) (σ : Equiv.Perm (Fin 4)) (ℓ : PhysicalRectangle) :
    rectLinksZ4 a (ℓ.permute σ) = z4PermLink σ '' rectLinksZ4 a ℓ := by
  have h_perm_inv : ∀ (τ : Equiv.Perm (Fin 4)) (r : PhysicalRectangle),
      (r.permute τ).permute τ.symm = r := by
    intro τ r
    rcases r with ⟨base, μ, ν, plane, sideμ, sideν, hμ_pos, hν_pos⟩
    dsimp only [PhysicalRectangle.permute]
    split_ifs with h1 h2 h3
    · simp only [PhysicalRectangle.mk.injEq, and_true]
      exact ⟨funext fun i => by simp, Equiv.symm_apply_apply τ μ, Equiv.symm_apply_apply τ ν⟩
    · exfalso
      rw [Equiv.symm_apply_apply, Equiv.symm_apply_apply] at h2
      exact h2 plane
    · exfalso
      rw [Equiv.symm_apply_apply, Equiv.symm_apply_apply] at h3
      exact lt_asymm plane h3
    · simp only [PhysicalRectangle.mk.injEq, and_true]
      exact ⟨funext fun i => by simp, Equiv.symm_apply_apply τ μ, Equiv.symm_apply_apply τ ν⟩
  have h_sub : ∀ (τ : Equiv.Perm (Fin 4)) (r : PhysicalRectangle),
      ∀ e ∈ rectLinksZ4 a r, z4PermLink τ e ∈ rectLinksZ4 a (r.permute τ) := by
    intro τ r e he
    have hb := latticeBase_permute τ r (a : ℝ)
    have h_lin1 (b : Fin 4 → ℤ) (k : ℤ) (μ : Direction) :
        (b + k • z4UnitVec μ) ∘ τ.symm = b ∘ τ.symm + k • z4UnitVec (τ μ) := by
      rw [← z4UnitVec_comp_symm τ μ]; rfl
    have h_lin2 (b : Fin 4 → ℤ) (k₁ k₂ : ℤ) (μ₁ μ₂ : Direction) :
        (b + k₁ • z4UnitVec μ₁ + k₂ • z4UnitVec μ₂) ∘ τ.symm =
          b ∘ τ.symm + k₁ • z4UnitVec (τ μ₁) + k₂ • z4UnitVec (τ μ₂) := by
      rw [← z4UnitVec_comp_symm τ μ₁, ← z4UnitVec_comp_symm τ μ₂]; rfl
    dsimp only [rectLinksZ4] at he ⊢
    rw [hb]
    by_cases hlt : τ r.μ < τ r.ν
    · have hμ' : (r.permute τ).μ = τ r.μ := by simp [PhysicalRectangle.permute, hlt]
      have hν' : (r.permute τ).ν = τ r.ν := by simp [PhysicalRectangle.permute, hlt]
      obtain ⟨hr', hs'⟩ := (r.steps_permute τ (a : ℝ)).1 hlt
      rw [hμ', hν', hr', hs']
      rcases he with ⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩ | ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
      · left; exact ⟨i, hi, Prod.ext (h_lin1 _ _ _) rfl⟩
      · right; left; exact ⟨i, hi, Prod.ext (h_lin2 _ _ _ _ _) rfl⟩
      · right; right; left; exact ⟨j, hj, Prod.ext (h_lin1 _ _ _) rfl⟩
      · right; right; right; exact ⟨j, hj, Prod.ext (h_lin2 _ _ _ _ _) rfl⟩
    · have hμ' : (r.permute τ).μ = τ r.ν := by simp [PhysicalRectangle.permute, hlt]
      have hν' : (r.permute τ).ν = τ r.μ := by simp [PhysicalRectangle.permute, hlt]
      obtain ⟨hr', hs'⟩ := (r.steps_permute τ (a : ℝ)).2 hlt
      rw [hμ', hν', hr', hs']
      rcases he with ⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩ | ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩
      · right; right; left; exact ⟨i, hi, Prod.ext (h_lin1 _ _ _) rfl⟩
      · right; right; right; exact ⟨i, hi, Prod.ext (h_lin2 _ _ _ _ _) rfl⟩
      · left; exact ⟨j, hj, Prod.ext (h_lin1 _ _ _) rfl⟩
      · right; left; exact ⟨j, hj, Prod.ext (h_lin2 _ _ _ _ _) rfl⟩
  ext e
  constructor
  · intro he
    refine ⟨z4PermLink σ.symm e, ?_, ?_⟩
    · have he' := h_sub σ.symm (ℓ.permute σ) e he
      rwa [h_perm_inv] at he'
    · rcases e with ⟨x, d⟩
      exact Prod.ext (funext fun i => by simp [z4PermLink]) (by simp [z4PermLink])
  · rintro ⟨e', he', rfl⟩
    exact h_sub σ ℓ e' he'

theorem _root_.JesseMath.Physics.YangMillsOsterwalderSchraderInheritance.DisjointLoopFamily.isAdmissible_permute
    {a : ℚ} {θ : Fin 4 → ℚ} {σ : Equiv.Perm (Fin 4)} (hθ : θ ∘ σ.symm = θ) {F : DisjointLoopFamily}
    (hF : F.IsAdmissible a θ) : (F.permute σ).IsAdmissible a θ := by
  have hinj : Function.Injective (PhysicalRectangle.permute σ) := by
    have h_left : Function.LeftInverse (PhysicalRectangle.permute σ.symm) (PhysicalRectangle.permute σ) := by
      intro ⟨base, μ, ν, plane, sideμ, sideν, hμ_pos, hν_pos⟩
      dsimp only [PhysicalRectangle.permute]
      split_ifs with h1 h2 h3
      · simp only [PhysicalRectangle.mk.injEq, and_true]
        exact ⟨funext fun i => by simp, Equiv.symm_apply_apply σ μ, Equiv.symm_apply_apply σ ν⟩
      · exfalso
        rw [Equiv.symm_apply_apply, Equiv.symm_apply_apply] at h2
        exact h2 plane
      · exfalso
        rw [Equiv.symm_apply_apply, Equiv.symm_apply_apply] at h3
        exact lt_asymm plane h3
      · simp only [PhysicalRectangle.mk.injEq, and_true]
        exact ⟨funext fun i => by simp, Equiv.symm_apply_apply σ μ, Equiv.symm_apply_apply σ ν⟩
    exact h_left.injective
  refine ⟨?_, hF.2.1.map hinj, ?_⟩
  · intro ℓ' hℓ'
    simp only [DisjointLoopFamily.permute, List.mem_map] at hℓ'
    obtain ⟨ℓ, hℓ, rfl⟩ := hℓ'
    exact rectOnGrid_permute hθ (hF.1 ℓ hℓ)
  · rw [DisjointLoopFamily.permute, List.pairwise_map]
    refine hF.2.2.imp ?_
    intro ℓ₁ ℓ₂ hdisj
    rw [rectLinksZ4_permute a σ ℓ₁, rectLinksZ4_permute a σ ℓ₂]
    exact (Set.disjoint_image_iff (z4PermLink_injective σ)).mpr hdisj

theorem halfOffset_comp_symm (σ : Equiv.Perm (Fin 4)) : halfOffset ∘ σ.symm = halfOffset := rfl

theorem isAdmissible_permute_halfOffset {a : ℚ} (σ : Equiv.Perm (Fin 4)) {F : DisjointLoopFamily}
    (hF : F.IsAdmissible a halfOffset) : (F.permute σ).IsAdmissible a halfOffset :=
  F.isAdmissible_permute (halfOffset_comp_symm σ) hF

-- Necessity control for `hθ : θ ∘ σ.symm = θ` in `rectOnGrid_permute`:
example :
    let θ : Fin 4 → ℚ := fun i => if i = 0 then 0 else 1 / 2
    let σ : Equiv.Perm (Fin 4) := Equiv.swap 0 1
    let ℓ : PhysicalRectangle := { canonicalSpatialProbe 1 one_pos with base := θ }
    RectOnGrid 1 θ ℓ ∧ ¬ RectOnGrid 1 θ (ℓ.permute σ) := by
  intro θ σ ℓ
  refine ⟨⟨fun i => ⟨0, by simp [ℓ]⟩, ⟨1, Nat.one_pos, by simp [ℓ, canonicalSpatialProbe]⟩,
    ⟨1, Nat.one_pos, by simp [ℓ, canonicalSpatialProbe]⟩⟩, ?_⟩
  rintro ⟨hbase, _, _⟩
  obtain ⟨k, hk⟩ := hbase 0
  have hlt : σ ℓ.μ < σ ℓ.ν := by decide
  have h0 : (ℓ.permute σ).base 0 = 1 / 2 := by
    simp [PhysicalRectangle.permute, hlt, ℓ, θ, σ]
  have hθ0 : θ 0 = 0 := rfl
  rw [h0, hθ0, add_zero, mul_one] at hk
  have hden := congrArg Rat.den hk
  simp at hden

/-- Gap 1 (H1) uniform multi-scale renormalization-group landing tube along a continuum cutoff
path `P`:
1. Locks the IR physical block scale `ℓstar > 0` via `P.spacing n * 2 ^ K n = ℓstar` and
   matches the UV lattice side via `P.side n = dyadicScaleSide (irSide n) (K n)`,
2. Carries at each cutoff `n` an exact `K n`-step Haar RG chain
   `chain n : MultiStepHaarRGChain (irSide n) (K n) (P.coupling n)` starting at the actual UV
   Wilson measure `wilsonMeasure (gaugeHaarMeasure _) (P.coupling n)` and evolving at every step
   `m < K n` by `interactingBlockedEffectiveAction (haarBlockDisintegration _)`,
3. Lands at IR scale `m = 0` inside the uniform Dobrushin contraction tube
   `18 * β_star + η_star + ε_star < 1` with `((chain n).state 0).β ≤ β_star`,
   `PolymerDobrushinNormBound ((chain n).state 0).polymers η_star`, and uniform truncation
   remainder `|((chain n).state 0).R_trunc V| ≤ ε_star`, and
4. Preserves a uniform positive correlation floor `0 < c_floor ≤ |irCov ...|` on the actual
   landed IR Gibbs measure `((chain n).state 0).gibbsMeasure` for the canonical spatial unit
   plaquette probe `canonicalSpatialProbe ℓstar hℓstar` (`LandingTube.ℓ_probe`) at IR lattice
   spacing `ℓstar`. -/
structure LandingTube (P : ContinuumCutoffPath) where
  ℓstar : ℚ
  hℓstar : 0 < ℓstar
  K : ℕ → ℕ
  hK : ∀ᶠ n in atTop, P.spacing n * (2 : ℝ) ^ K n = (ℓstar : ℝ)
  irSide : ℕ → ℕ
  [instNeZeroIrSide : ∀ n : ℕ, NeZero (irSide n)]
  hside : ∀ᶠ n in atTop, P.side n = dyadicScaleSide (irSide n) (K n)
  chain : ∀ n : ℕ, MultiStepHaarRGChain (irSide n) (K n) (P.coupling n)
  β_star : ℝ
  η_star : ℝ
  ε_star : ℝ
  h_land : 4 * (18 * (24 * β_star) + η_star + ε_star) < 1
  h_tube : ∀ᶠ n in atTop,
    ((chain n).state 0).β ≤ β_star ∧
    PolymerDobrushinNormBound ((chain n).state 0).polymers η_star ∧
    TruncationDobrushinNormBound ((chain n).state 0).R_trunc ε_star
  Z_tube : LoopRenormalization P.toCutoffPath
  hZ_tube_scheme :
    ∃ m c : ℕ → ℝ,
      Z_tube = YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m c
  c_floor : ℝ
  hc_floor : 0 < c_floor
  /-- Under pure decimation this equals a raw UV covariance at coupling → ∞ (`LandingTube.h_floor_raw`); predicted false [physics]; consistency unknown. -/
  h_floor : ∀ᶠ n in atTop,
    c_floor ≤
      |irCov ((chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (irSide n) (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar).timeReflect)
        (physicalWilsonLoop (irSide n) (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar))|

attribute [instance] LandingTube.instNeZeroIrSide

/-- Canonical spatial probe `canonicalSpatialProbe T.ℓstar T.hℓstar` fixed by definition for any
`T : LandingTube P`. -/
abbrev LandingTube.ℓ_probe {P : ContinuumCutoffPath} (T : LandingTube P) : PhysicalRectangle :=
  canonicalSpatialProbe T.ℓstar T.hℓstar

/-- Positive Euclidean time of `T.ℓ_probe`. -/
theorem LandingTube.hℓ_probe_pos {P : ContinuumCutoffPath} (T : LandingTube P) :
    T.ℓ_probe.IsPositiveTime :=
  canonicalSpatialProbe_isPositiveTime T.hℓstar

/-- Unconditional non-negativity `0 ≤ T.β_star` derived from `(T.chain n).h_β_nonneg` and `T.h_tube`. -/
theorem LandingTube.hβ_star_nonneg {P : ContinuumCutoffPath} (T : LandingTube P) :
    0 ≤ T.β_star := by
  obtain ⟨n, hβ, _, _⟩ := T.h_tube.exists
  exact ((T.chain n).h_β_nonneg 0 (Nat.zero_le _)).trans hβ

/-- Unconditional non-negativity `0 ≤ T.η_star` derived from `T.h_tube`. -/
theorem LandingTube.hη_star_nonneg {P : ContinuumCutoffPath} (T : LandingTube P) :
    0 ≤ T.η_star := by
  obtain ⟨n, _, hη, _⟩ := T.h_tube.exists
  exact hη.1

/-- Unconditional non-negativity `0 ≤ T.ε_star` derived from `T.h_tube` and
`TruncationDobrushinNormBound.nonneg`. -/
theorem LandingTube.hε_star_nonneg {P : ContinuumCutoffPath} (T : LandingTube P) :
    0 ≤ T.ε_star := by
  obtain ⟨n, _, _, hε⟩ := T.h_tube.exists
  exact hε.nonneg

/-- Auxiliary square physical rectangle `mkSquareRectangle q hq` of side `q > 0` in the `(0, 1)`
plane at base `(1, 1, 1, 1)`. -/
def mkSquareRectangle (q : ℚ) (hq : 0 < q) : PhysicalRectangle where
  base := fun _ => 1
  μ := 0
  ν := 1
  plane := by decide
  sideμ := q
  sideν := q
  sideμ_pos := hq
  sideν_pos := hq

/-- Exact characterization of `∀ ℓ : PhysicalRectangle, |(perimeterCornerRenormalization P m c).factor n ℓ| ≤ 1`:
because `(perimeterCornerRenormalization P m c).factor n ℓ = exp(m n * (2 * (ℓ.sideμ + ℓ.sideν)) + 4 * c n)`
and `ℓ.sideμ, ℓ.sideν` range over all positive rationals, `|factor n ℓ| ≤ 1` holds for all
`ℓ : PhysicalRectangle` if and only if `m n ≤ 0 ∧ c n ≤ 0`. -/
theorem perimeterCornerRenormalization_abs_factor_le_one_iff
    (P : CutoffPath) (m c : ℕ → ℝ) (n : ℕ) :
    (∀ ℓ : PhysicalRectangle,
      |(YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P m c).factor n ℓ| ≤ 1) ↔
    (m n ≤ 0 ∧ c n ≤ 0) := by
  constructor
  · intro h_all
    have h_sq : ∀ (q : ℚ), 0 < q → m n * (q : ℝ) + c n ≤ 0 := by
      intro q hq
      have h_le := h_all (mkSquareRectangle q hq)
      dsimp [YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization,
        mkSquareRectangle] at h_le
      rw [abs_of_pos (Real.exp_pos _), Real.exp_le_one_iff] at h_le
      linarith
    refine ⟨?_, ?_⟩
    · by_contra hm_not_le
      have hm_pos : 0 < m n := not_le.mp hm_not_le
      let N : ℕ := ⌊|c n| / m n⌋₊ + 1
      have hN_pos_rat : (0 : ℚ) < (N : ℚ) := by positivity
      have h_lt : |c n| / m n < (N : ℝ) := by
        dsimp [N]
        push_cast
        exact Nat.lt_floor_add_one (|c n| / m n)
      have h_mul : |c n| < (N : ℝ) * m n := (div_lt_iff₀ hm_pos).mp h_lt
      have h_neg_abs : -|c n| ≤ c n := neg_abs_le (c n)
      have h_q := h_sq (N : ℚ) hN_pos_rat
      push_cast at h_q
      linarith
    · by_contra hc_not_le
      have hc_pos : 0 < c n := not_le.mp hc_not_le
      let N : ℕ := ⌊|m n| / c n⌋₊ + 1
      have hN_pos_real : (0 : ℝ) < (N : ℝ) := by positivity
      have hq_pos : (0 : ℚ) < 1 / (N : ℚ) := by positivity
      have h_lt : |m n| / c n < (N : ℝ) := by
        dsimp [N]
        push_cast
        exact Nat.lt_floor_add_one (|m n| / c n)
      have h_mul : |m n| < (N : ℝ) * c n := (div_lt_iff₀ hc_pos).mp h_lt
      have h_mul' : |m n| < c n * (N : ℝ) := by linarith
      have h_div : |m n| / (N : ℝ) < c n := (div_lt_iff₀ hN_pos_real).mpr h_mul'
      have h_neg_div : -( |m n| / (N : ℝ) ) ≤ m n * (1 / (N : ℝ)) := by
        have h_neg_abs : -|m n| ≤ m n := neg_abs_le (m n)
        have h_inv_nonneg : (0 : ℝ) ≤ 1 / (N : ℝ) := by positivity
        have := mul_le_mul_of_nonneg_right h_neg_abs h_inv_nonneg
        linarith [div_eq_mul_one_div (|m n|) (N : ℝ)]
      have h_q := h_sq (1 / (N : ℚ)) hq_pos
      push_cast at h_q
      linarith
  · rintro ⟨hm, hc⟩ ℓ
    dsimp [YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization]
    rw [abs_of_pos (Real.exp_pos _), Real.exp_le_one_iff]
    have hμ : (0 : ℝ) < (ℓ.sideμ : ℝ) := Rat.cast_pos.mpr ℓ.sideμ_pos
    have hν : (0 : ℝ) < (ℓ.sideν : ℝ) := Rat.cast_pos.mpr ℓ.sideν_pos
    nlinarith

/-- Negative control explaining why `∀ ℓ, |Z.factor n ℓ| ≤ 1` must **not** be assumed on a
perimeter-corner renormalization scheme: any positive perimeter counterterm `0 < m n` (in particular
the physical UV linear perimeter divergence `m n → +∞`) violates
`∀ ℓ : PhysicalRectangle, |(perimeterCornerRenormalization P m c).factor n ℓ| ≤ 1`. -/
theorem perimeterCornerRenormalization_not_abs_factor_le_one_of_pos_perimeter_counterterm
    (P : CutoffPath) (m c : ℕ → ℝ) (n : ℕ) (hm : 0 < m n) :
    ¬ (∀ ℓ : PhysicalRectangle,
        |(YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P m c).factor n ℓ| ≤ 1) := by
  intro h_all
  have hmc := (perimeterCornerRenormalization_abs_factor_le_one_iff P m c n).mp h_all
  linarith [hmc.1]

/-- Any perimeter-corner renormalization scheme `perimeterCornerRenormalization P.toCutoffPath m c`
with arbitrary counterterm sequences `m, c : ℕ → ℝ` (including diverging positive UV perimeter
counterterms `Tendsto m atTop atTop`) satisfies the `hZ_tube_scheme` specification, is translation-
and permutation-invariant, has reflection-invariant factors, and has
`Tendsto (fun n => (perimeterCornerRenormalization P.toCutoffPath m c).factor n ℓ) atTop atTop`
whenever `Tendsto m atTop atTop` and `c = 0`. -/
theorem perimeterCornerRenormalization_admits_diverging_positive_perimeter_counterterm
    (P : ContinuumCutoffPath) (m : ℕ → ℝ) (hm : Tendsto m atTop atTop) (ℓ : PhysicalRectangle) :
    let Z := YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0)
    (∃ m' c' : ℕ → ℝ,
      Z = YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m' c') ∧
    Z.IsTranslationInvariant ∧
    Z.IsPermutationInvariant ∧
    HasReflectionInvariantFactors Z ∧
    Tendsto (fun n => Z.factor n ℓ) atTop atTop := by
  dsimp only
  let Z := YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m (fun _ => 0)
  have h_perim_pos : (0 : ℝ) < 2 * ((ℓ.sideμ : ℝ) + (ℓ.sideν : ℝ)) := by
    have hμ : (0 : ℝ) < (ℓ.sideμ : ℝ) := Rat.cast_pos.mpr ℓ.sideμ_pos
    have hν : (0 : ℝ) < (ℓ.sideν : ℝ) := Rat.cast_pos.mpr ℓ.sideν_pos
    linarith
  have h_lin : Tendsto (fun n => m n * (2 * ((ℓ.sideμ : ℝ) + (ℓ.sideν : ℝ))) + 4 * (0 : ℝ)) atTop atTop := by
    simpa [mul_zero, add_zero] using Filter.Tendsto.atTop_mul_const h_perim_pos hm
  refine ⟨⟨m, fun _ => 0, rfl⟩,
    YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization_isTranslationInvariant
      P.toCutoffPath m (fun _ => 0),
    YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization_isPermutationInvariant
      P.toCutoffPath m (fun _ => 0),
    YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization_hasReflectionInvariantFactors
      P.toCutoffPath m (fun _ => 0),
    Real.tendsto_exp_atTop.comp h_lin⟩

theorem LandingTube.z_tube_isTranslationInvariant {P : ContinuumCutoffPath} (T : LandingTube P) :
    T.Z_tube.IsTranslationInvariant := by
  obtain ⟨m, c, hZ⟩ := T.hZ_tube_scheme
  rw [hZ]
  exact YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization_isTranslationInvariant
    P.toCutoffPath m c

theorem LandingTube.z_tube_isPermutationInvariant {P : ContinuumCutoffPath} (T : LandingTube P) :
    T.Z_tube.IsPermutationInvariant := by
  obtain ⟨m, c, hZ⟩ := T.hZ_tube_scheme
  rw [hZ]
  exact YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization_isPermutationInvariant
    P.toCutoffPath m c

theorem LandingTube.z_tube_hasReflectionInvariantFactors {P : ContinuumCutoffPath}
    (T : LandingTube P) :
    HasReflectionInvariantFactors T.Z_tube := by
  obtain ⟨m, c, hZ⟩ := T.hZ_tube_scheme
  rw [hZ]
  exact YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization_hasReflectionInvariantFactors
    P.toCutoffPath m c

/-- Any trajectory whose landed IR Gibbs covariance on `ℓ_probe` vanishes eventually
(including the pure-Haar and constant-law controls) cannot inhabit `LandingTube P`. -/
theorem not_landingTube_of_zero_irCov {P : ContinuumCutoffPath} (T : LandingTube P)
    (hzero : ∀ᶠ n in atTop,
      irCov ((T.chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe) = 0) : False := by
  obtain ⟨n, hfl, hz⟩ := (T.h_floor.and hzero).exists
  rw [hz, abs_zero] at hfl
  linarith [T.hc_floor]

/-- No trajectory whose landed IR Gibbs measure is eventually a deterministic Dirac point mass
`Measure.dirac (V0 n)` can inhabit `LandingTube P`. -/
theorem not_landingTube_of_constantLaw {P : ContinuumCutoffPath} (T : LandingTube P)
    (V0 : ∀ n : ℕ, GaugeConfig (T.irSide n))
    (h_dirac : ∀ᶠ n in atTop, ((T.chain n).state 0).gibbsMeasure = Measure.dirac (V0 n)) :
    False := by
  apply not_landingTube_of_zero_irCov T
  filter_upwards [h_dirac] with n hn
  rw [hn, irCov_dirac_eq_zero]

/-- For any measure `μ : Measure (GaugeConfig L)` and continuous observables `f, g : GaugeConfig L → ℝ`,
stochastic independence `ProbabilityTheory.IndepFun f g μ` implies `irCov μ f g = 0`. -/
theorem irCov_eq_zero_of_indepFun {L : ℕ} [NeZero L] {μ : Measure (GaugeConfig L)}
    {f g : GaugeConfig L → ℝ} (hf : Continuous f) (hg : Continuous g)
    (h_ind : ProbabilityTheory.IndepFun f g μ) :
    irCov μ f g = 0 := by
  unfold irCov
  have h := h_ind.integral_mul_eq_mul_integral hf.aestronglyMeasurable hg.aestronglyMeasurable
  simp only [Pi.mul_apply] at h
  rw [h, sub_self]

/-- Single-link center twist multiplying link `e₀ : Link L` on the left by `negOne = -1 ∈ SU(2)`
and leaving all other links `e ≠ e₀` unchanged. -/
def twistLinkNegOne {L : ℕ} (e₀ : Link L) (U : GaugeConfig L) : GaugeConfig L :=
  fun e => (if e = e₀ then negOne else 1) * U e

@[continuity, fun_prop]
theorem continuous_twistLinkNegOne {L : ℕ} (e₀ : Link L) :
    Continuous (twistLinkNegOne e₀) := by
  apply continuous_pi
  intro e
  exact continuous_const.mul (continuous_apply e)

/-- Left Haar invariance on `SU2.haarProbability` implies that `twistLinkNegOne e₀` preserves
the product Haar measure `gaugeHaarMeasure L` for every `e₀ : Link L`. -/
theorem measurePreserving_twistLinkNegOne {L : ℕ} [NeZero L] (e₀ : Link L) :
    MeasurePreserving (twistLinkNegOne e₀) (gaugeHaarMeasure L) (gaugeHaarMeasure L) := by
  change MeasurePreserving
    (fun (U : Link L → SU2) (e : Link L) => (if e = e₀ then negOne else 1) * U e)
    (Measure.pi (fun _ : Link L => SU2.haarProbability))
    (Measure.pi (fun _ : Link L => SU2.haarProbability))
  refine measurePreserving_pi (fun _ : Link L => SU2.haarProbability)
    (fun _ : Link L => SU2.haarProbability)
    (f := fun e x => (if e = e₀ then negOne else 1) * x) ?_
  intro e
  exact measurePreserving_mul_left SU2.haarProbability (if e = e₀ then negOne else 1)

/-- Any continuous observable `f : GaugeConfig L → ℝ` that flips sign under the single-link center
twist `twistLinkNegOne e₀` has zero expectation under `gaugeHaarMeasure L`. -/
theorem integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg {L : ℕ} [NeZero L]
    (e₀ : Link L) {f : GaugeConfig L → ℝ} (hf : Continuous f)
    (h_neg : ∀ U : GaugeConfig L, f (twistLinkNegOne e₀ U) = -f U) :
    (∫ U, f U ∂(gaugeHaarMeasure L)) = 0 := by
  have hmap := (measurePreserving_twistLinkNegOne (L := L) e₀).map_eq
  have h1 : (∫ U, f U ∂(gaugeHaarMeasure L)) =
      ∫ U, f (twistLinkNegOne e₀ U) ∂(gaugeHaarMeasure L) := by
    conv_lhs => rw [← hmap]
    exact integral_map (continuous_twistLinkNegOne e₀).aemeasurable hf.aestronglyMeasurable
  have h2 : (∫ U, f (twistLinkNegOne e₀ U) ∂(gaugeHaarMeasure L)) =
      -(∫ U, f U ∂(gaugeHaarMeasure L)) := by
    simp_rw [h_neg, integral_neg]
  linarith

/-- Unconditional product-Haar zero-covariance theorem via single-link center twist: if `f` flips
sign under `twistLinkNegOne e₀` and `g` is invariant under `twistLinkNegOne e₀`, then
`irCov (gaugeHaarMeasure L) f g = 0` with no external independence hypothesis. -/
theorem irCov_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne {L : ℕ} [NeZero L]
    (e₀ : Link L) {f g : GaugeConfig L → ℝ} (hf : Continuous f) (hg : Continuous g)
    (h_neg : ∀ U : GaugeConfig L, f (twistLinkNegOne e₀ U) = -f U)
    (h_inv : ∀ U : GaugeConfig L, g (twistLinkNegOne e₀ U) = g U) :
    irCov (gaugeHaarMeasure L) f g = 0 := by
  unfold irCov
  have hf0 := integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg e₀ hf h_neg
  have hfg0 : (∫ U, f U * g U ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne_neg e₀ (hf.mul hg) (fun U => ?_)
    rw [h_neg U, h_inv U, neg_mul]
  rw [hfg0, hf0, zero_mul, sub_self]

theorem twistLinkNegOne_agree_off_link {L : ℕ} (e₀ : Link L) (U : GaugeConfig L) :
    ∀ e : Link L, e ≠ e₀ → twistLinkNegOne e₀ U e = U e := by
  intro e he
  simp [twistLinkNegOne, he]

theorem twistLinkNegOne_eq_updateGaugeLink {L : ℕ} (e₀ : Link L) (U : GaugeConfig L) :
    twistLinkNegOne e₀ U = updateGaugeLink L U e₀.x e₀.μ (negOne * U e₀) := by
  funext e
  by_cases he : e = e₀
  · subst he
    simp only [twistLinkNegOne, ite_true]
    exact ((updateGaugeLink_same_and_other L U e.x e.μ (negOne * U e)).1).symm
  · simp only [twistLinkNegOne, he, ite_false, one_mul]
    exact ((updateGaugeLink_same_and_other L U e₀.x e₀.μ (negOne * U e₀)).2 e he).symm

/-- Single-link update oscillation bound for `wilsonAction β`: updating link `⟨x, μ⟩` from `g2` to
`g1` changes `wilsonAction β` by at most `12 * β`, completely independent of lattice side `L`. -/
theorem wilsonAction_singleLink_oscillation_le (L : ℕ) [NeZero L] {β : ℝ} (hβ : 0 ≤ β)
    (V : GaugeConfig L) (x : Lattice4D L) (μ : Direction) (g1 g2 : SU2) :
    |wilsonAction β (updateGaugeLink L V x μ g1) -
      wilsonAction β (updateGaugeLink L V x μ g2)| ≤ 12 * β := by
  refine wilsonAction_oscillation_of_agree_off_link hβ
    (updateGaugeLink L V x μ g1) (updateGaugeLink L V x μ g2) ⟨x, μ⟩ fun f hf => ?_
  exact ((updateGaugeLink_same_and_other L V x μ g1).2 f hf).trans
    ((updateGaugeLink_same_and_other L V x μ g2).2 f hf).symm

/-- Single-link center twist `twistLinkNegOne e₀` changes `wilsonAction β` by at most `12 * β`
for every `U : GaugeConfig L`, completely independent of lattice side `L`. -/
theorem wilsonAction_twistLinkNegOne_abs_sub_le (L : ℕ) [NeZero L] {β : ℝ} (hβ : 0 ≤ β)
    (e₀ : Link L) (U : GaugeConfig L) :
    |wilsonAction β (twistLinkNegOne e₀ U) - wilsonAction β U| ≤ 12 * β :=
  wilsonAction_oscillation_of_agree_off_link hβ (twistLinkNegOne e₀ U) U e₀
    (twistLinkNegOne_agree_off_link e₀ U)

/-- Any link `e₀ ∉ physicalRectangleSupport L a ℓ` leaves `physicalWilsonLoop L a ℓ` invariant
under `twistLinkNegOne e₀`. -/
theorem physicalWilsonLoop_twistLinkNegOne_eq_of_not_mem {L : ℕ}
    (a : ℝ) (ℓ : PhysicalRectangle) (U : GaugeConfig L) {e₀ : Link L}
    (h_not_mem : e₀ ∉ physicalRectangleSupport L a ℓ) :
    physicalWilsonLoop L a ℓ (twistLinkNegOne e₀ U) = physicalWilsonLoop L a ℓ U := by
  rw [twistLinkNegOne_eq_updateGaugeLink]
  exact physicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem a ℓ U h_not_mem (negOne * U e₀)

/-- On any lattice of side `2 ≤ L`, twisting the base `μ`-link `⟨p.x, p.μ⟩` of a plaquette
`p : Plaquette L` by `negOne = -1 ∈ SU(2)` multiplies `plaquetteHolonomy U p` on the left by `negOne`. -/
theorem plaquetteHolonomy_twistLinkNegOne_base_μ {L : ℕ} (hL : 2 ≤ L)
    (p : Plaquette L) (U : GaugeConfig L) :
    plaquetteHolonomy (twistLinkNegOne ⟨p.x, p.μ⟩ U) p = negOne * plaquetteHolonomy U p := by
  have hμν : p.μ ≠ p.ν := p.h.ne
  have h1 : (⟨shift p.x p.μ, p.ν⟩ : Link L) ≠ ⟨p.x, p.μ⟩ := fun h =>
    hμν (congrArg Link.μ h).symm
  have h2 : (⟨shift p.x p.ν, p.μ⟩ : Link L) ≠ ⟨p.x, p.μ⟩ := by
    intro h
    have hx : p.x + unitVec L p.ν = p.x + 0 := by
      rw [add_zero]
      exact congrArg Link.x h
    exact YangMillsOsterwalderSchraderInheritance.unitVec_ne_zero hL p.ν (add_left_cancel hx)
  have h3 : (⟨p.x, p.ν⟩ : Link L) ≠ ⟨p.x, p.μ⟩ := fun h => hμν (congrArg Link.μ h).symm
  simp only [plaquetteHolonomy, twistLinkNegOne, ite_true, h1, h2, h3, ite_false,
    one_mul, mul_assoc]

theorem baseLink_mem_physicalRectangleSupport_of_unitPlaquette (L : ℕ)
    (a : ℝ) (ℓ : PhysicalRectangle)
    (hμ : ℓ.stepsμ a = 1) (hν : ℓ.stepsν a = 1) :
    (⟨latticeSite L (ℓ.latticeBase a), ℓ.μ⟩ : Link L) ∈ physicalRectangleSupport L a ℓ := by
  unfold physicalRectangleSupport PhysicalRectangle.latticeLoop
  rw [hμ, hν, rectangleSteps_one_one]
  simp [latticePathSupport, latticeStepLink]

/-- For any physical rectangle `ℓ` that resolves to a unit plaquette (`ℓ.stepsμ a = 1`, `ℓ.stepsν a = 1`)
on a torus of side `2 ≤ L`, twisting `⟨latticeSite L (ℓ.latticeBase a), ℓ.μ⟩` by `twistLinkNegOne`
flips the sign of `physicalWilsonLoop L a ℓ`. -/
theorem physicalWilsonLoop_unitPlaquette_twistLinkNegOne_neg {L : ℕ} (hL : 2 ≤ L)
    (a : ℝ) (ℓ : PhysicalRectangle)
    (hμ : ℓ.stepsμ a = 1) (hν : ℓ.stepsν a = 1) (U : GaugeConfig L) :
    physicalWilsonLoop L a ℓ (twistLinkNegOne ⟨latticeSite L (ℓ.latticeBase a), ℓ.μ⟩ U) =
      -physicalWilsonLoop L a ℓ U := by
  let p : Plaquette L := ⟨latticeSite L (ℓ.latticeBase a), ℓ.μ, ℓ.ν, ℓ.plane⟩
  have h_loop (W : GaugeConfig L) :
      physicalWilsonLoop L a ℓ W = halfTraceRe (plaquetteHolonomy W p) := by
    unfold physicalWilsonLoop PhysicalRectangle.latticeLoop wilsonLoop
    rw [hμ, hν]
    exact congrArg halfTraceRe (pathHolonomy_rectangleSteps_one_one W p)
  rw [h_loop, h_loop, plaquetteHolonomy_twistLinkNegOne_base_μ hL p U,
    YangMillsOsterwalderSchraderInheritance.halfTraceRe_negOne_mul]

/-- For any positive-time physical rectangle `ℓ` (`ℓ.IsPositiveTime`) that resolves to a unit
plaquette (`ℓ.stepsμ a = 1`, `ℓ.stepsν a = 1`) at spacing `0 < a` on a torus of side
`2 * loopTimeSpanBound a ℓ < L`, twisting `e₀ = ⟨latticeSite L (ℓ.latticeBase a), ℓ.μ⟩` flips the
sign of `physicalWilsonLoop L a ℓ` while leaving `physicalWilsonLoop L a ℓ.timeReflect` invariant. -/
theorem physicalWilsonLoop_unitPlaquette_twistLinkNegOne_sign_and_timeReflect_inv
    (L : ℕ) [NeZero L] {a : ℝ} (ha : 0 < a) {ℓ : PhysicalRectangle} (hpos : ℓ.IsPositiveTime)
    (hμ : ℓ.stepsμ a = 1) (hν : ℓ.stepsν a = 1)
    (hL : 2 * loopTimeSpanBound a ℓ < L) (U : GaugeConfig L) :
    let e₀ : Link L := ⟨latticeSite L (ℓ.latticeBase a), ℓ.μ⟩
    physicalWilsonLoop L a ℓ (twistLinkNegOne e₀ U) = -physicalWilsonLoop L a ℓ U ∧
    physicalWilsonLoop L a ℓ.timeReflect (twistLinkNegOne e₀ U) =
      physicalWilsonLoop L a ℓ.timeReflect U := by
  dsimp only
  have hL2 : 2 ≤ L := by
    unfold loopTimeSpanBound at hL
    omega
  have h_disj := (disjoint_physicalRectangleSupport_timeReflect_self L ha hpos hL).2
  have h_mem := baseLink_mem_physicalRectangleSupport_of_unitPlaquette L a ℓ hμ hν
  have h_not_mem :
      (⟨latticeSite L (ℓ.latticeBase a), ℓ.μ⟩ : Link L) ∉
        physicalRectangleSupport L a ℓ.timeReflect :=
    Finset.disjoint_right.mp h_disj h_mem
  exact ⟨physicalWilsonLoop_unitPlaquette_twistLinkNegOne_neg hL2 a ℓ hμ hν U,
    physicalWilsonLoop_twistLinkNegOne_eq_of_not_mem a ℓ.timeReflect U h_not_mem⟩

/-- No trajectory whose landed IR Gibbs measure is eventually the uncoupled product Haar measure
`gaugeHaarMeasure (T.irSide n)` (at which disjoint time-reflected loops have zero covariance)
can inhabit `LandingTube P`. -/
theorem not_landingTube_of_productHaar {P : ContinuumCutoffPath} (T : LandingTube P)
    (h_haar : ∀ᶠ n in atTop, ((T.chain n).state 0).gibbsMeasure = gaugeHaarMeasure (T.irSide n))
    (h_indep : ∀ n : ℕ,
      irCov (gaugeHaarMeasure (T.irSide n))
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe) = 0) :
    False := by
  apply not_landingTube_of_zero_irCov T
  filter_upwards [h_haar] with n hn
  rw [hn, h_indep n]

/-- Product-Haar negative control from `ProbabilityTheory.IndepFun` without assuming `irCov = 0`
directly: stochastic independence of `ℓ_probe.timeReflect` and `ℓ_probe` under `gaugeHaarMeasure`
refutes `LandingTube P`. -/
theorem not_landingTube_of_productHaar_indepFun {P : ContinuumCutoffPath} (T : LandingTube P)
    (h_haar : ∀ᶠ n in atTop, ((T.chain n).state 0).gibbsMeasure = gaugeHaarMeasure (T.irSide n))
    (h_ind : ∀ n : ℕ,
      ProbabilityTheory.IndepFun
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe)
        (gaugeHaarMeasure (T.irSide n))) :
    False :=
  not_landingTube_of_productHaar T h_haar fun n =>
    irCov_eq_zero_of_indepFun
      (continuous_physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
      (continuous_physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe)
      (h_ind n)

/-- Product-Haar negative control from single-link center-twist invariance (`twistLinkNegOne`)
without any external `IndepFun` or `irCov = 0` hypothesis. -/
theorem not_landingTube_of_productHaar_twistLink {P : ContinuumCutoffPath} (T : LandingTube P)
    (h_haar : ∀ᶠ n in atTop, ((T.chain n).state 0).gibbsMeasure = gaugeHaarMeasure (T.irSide n))
    (e₀ : ∀ n : ℕ, Link (T.irSide n))
    (h_neg : ∀ (n : ℕ) (U : GaugeConfig (T.irSide n)),
      physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect
        (twistLinkNegOne (e₀ n) U) =
      -physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect U)
    (h_inv : ∀ (n : ℕ) (U : GaugeConfig (T.irSide n)),
      physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe
        (twistLinkNegOne (e₀ n) U) =
      physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe U) :
    False :=
  not_landingTube_of_productHaar T h_haar fun n =>
    irCov_gaugeHaarMeasure_eq_zero_of_twistLinkNegOne (e₀ n)
      (continuous_physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
      (continuous_physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe)
      (h_neg n) (h_inv n)

/-- VACUOUS-CONTROL (zero-coupling hypothesis `∀ᶠ n in atTop, P.coupling n = 0` is unsatisfiable
along any `ContinuumCutoffPath` by `ContinuumCutoffPath.coupling_tendsto_atTop`, `ROL:2008`):
Zero-coupling (`β = 0`) negative control without assuming `μ = gaugeHaarMeasure`: if
`P.coupling n = 0` eventually and `(T.chain n).state 0 = canonicalRGState (T.irSide n) (T.K n) (P.coupling n) 0`
eventually, then `((T.chain n).state 0).gibbsMeasure = gaugeHaarMeasure (T.irSide n)` holds
automatically by `canonicalRGState_zero_gibbsMeasure_eq_gaugeHaarMeasure`, refuting `LandingTube P`. -/
theorem not_landingTube_of_zero_coupling {P : ContinuumCutoffPath} (T : LandingTube P)
    (h_zero_β : ∀ᶠ n in atTop, P.coupling n = 0)
    (h_canonical : ∀ᶠ n in atTop,
      (T.chain n).state 0 = canonicalRGState (T.irSide n) (T.K n) (P.coupling n) 0)
    (h_indep : ∀ n : ℕ,
      irCov (gaugeHaarMeasure (T.irSide n))
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe) = 0) :
    False := by
  apply not_landingTube_of_productHaar T _ h_indep
  filter_upwards [h_zero_β, h_canonical] with n hβ hst
  rw [hst, hβ, canonicalRGState_zero_gibbsMeasure_eq_gaugeHaarMeasure]

/-- Uniform Dobrushin contraction ratio
`landingTubeContraction T = max (4 * (18 * (24 * T.β_star) + T.η_star + T.ε_star)) (1 / 2) ∈ (0, 1)`
of a `LandingTube P`, depending only on `(T.β_star, T.η_star, T.ε_star)`. -/
noncomputable def landingTubeContraction {P : ContinuumCutoffPath} (T : LandingTube P) : ℝ :=
  max (4 * (18 * (24 * T.β_star) + T.η_star + T.ε_star)) (1 / 2)

/-- Every `LandingTube P` has contraction factor `q = landingTubeContraction T ∈ (0, 1)`
and strictly positive physical transfer gap rate `0 < transferGapRate T.ℓstar q`. -/
theorem landingTube_contraction_and_transferGapRate_pos {P : ContinuumCutoffPath}
    (T : LandingTube P) :
    let q := landingTubeContraction T
    0 < q ∧ q < 1 ∧ 0 < transferGapRate T.ℓstar q := by
  dsimp only
  set q := landingTubeContraction T
  have hq0 : 0 < q := lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (le_max_right _ _)
  have hq1 : q < 1 := max_lt T.h_land (by norm_num)
  exact ⟨hq0, hq1, transferGapRate_pos (Rat.cast_pos.mpr T.hℓstar) hq0 hq1⟩

/-- On the actual landed IR effective action `((T.chain n).state 0).totalAction` of any
`T : LandingTube P`, the single-link conditional Gibbs expectation interdependence row sum is
eventually bounded by `4 * (18 * (24 * T.β_star) + T.η_star + T.ε_star) < 1`, and the `t`-step
iterated Dobrushin interdependence row sum contracts geometrically as
`dobrushinIteratedRowSum ... t (e_ref n) ≤ (landingTubeContraction T) ^ t`. -/
theorem LandingTube.landed_dobrushinIteratedRowSum_le_contraction_pow
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (V_ref : ∀ n : ℕ, GaugeConfig (T.irSide n))
    (h1_ref h2_ref : ∀ n : ℕ, Link (T.irSide n) → SU2)
    (φ_ref : ℕ → SU2 → ℝ)
    (e_ref : ∀ n : ℕ, Link (T.irSide n))
    (hφ_meas : ∀ n : ℕ, Measurable (φ_ref n))
    (hφ_bounds : ∀ (n : ℕ) (u : SU2), 0 ≤ φ_ref n u ∧ φ_ref n u ≤ 1)
    (t : ℕ) :
    ∀ᶠ n in atTop,
      (∑ e' : Link (T.irSide n),
        singleLinkCondExpInterdependenceMatrix SU2 (T.irSide n)
          ((T.chain n).state 0).totalAction (V_ref n) (h1_ref n) (h2_ref n) (φ_ref n)
          (e_ref n) e' < 1) ∧
      dobrushinIteratedRowSum
        (singleLinkCondExpInterdependenceMatrix SU2 (T.irSide n)
          ((T.chain n).state 0).totalAction (V_ref n) (h1_ref n) (h2_ref n) (φ_ref n))
        t (e_ref n) ≤ (landingTubeContraction T) ^ t := by
  filter_upwards [T.h_tube] with n h_tube
  have hβ0 : 0 ≤ ((T.chain n).state 0).β := (T.chain n).h_β_nonneg 0 (Nat.zero_le _)
  have h_dob :=
    ((T.chain n).state 0).totalAction_singleLinkCondExp_interdependence_sum_le
      hβ0 h_tube.1 T.hβ_star_nonneg T.hη_star_nonneg T.hε_star_nonneg
      h_tube.2.1 h_tube.2.2 T.h_land
      (V_ref n) (h1_ref n) (h2_ref n) (φ_ref n) (hφ_meas n) (hφ_bounds n)
  have h_lt1 :
      ∑ e' : Link (T.irSide n),
        singleLinkCondExpInterdependenceMatrix SU2 (T.irSide n)
          ((T.chain n).state 0).totalAction (V_ref n) (h1_ref n) (h2_ref n) (φ_ref n)
          (e_ref n) e' < 1 :=
    (h_dob.1 (e_ref n)).2
  have h_iter := (h_dob.2 t (e_ref n)).2
  have hq0 : 0 ≤ 4 * (18 * (24 * T.β_star) + T.η_star + T.ε_star) := by
    have := T.hβ_star_nonneg
    have := T.hη_star_nonneg
    have := T.hε_star_nonneg
    linarith
  have hq_le :
      4 * (18 * (24 * T.β_star) + T.η_star + T.ε_star) ≤ landingTubeContraction T :=
    le_max_left _ _
  exact ⟨h_lt1, le_trans h_iter (pow_le_pow_left₀ hq0 hq_le t)⟩

/-- On the actual landed IR effective action `((T.chain n).state 0).totalAction` of any
`T : LandingTube P`, Dobrushin's supremum interdependence matrix
`dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction` (taking the supremum over
all configurations `V`, all exterior link values `h1, h2`, and all `[0, 1]`-valued measurable test
functions `φ`) has row sum eventually bounded by `landingTubeContraction T < 1` at every link `e`,
and its `t`-step matrix powers contract as `(landingTubeContraction T) ^ t`. -/
theorem LandingTube.landed_dobrushinSupMatrix_rowSum_le_contraction
    {P : ContinuumCutoffPath} (T : LandingTube P) (t : ℕ) :
    ∀ᶠ n in atTop,
      let C := dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction
      (∀ e e' : Link (T.irSide n), 0 ≤ C e e') ∧
      (∀ e : Link (T.irSide n), ∑ e' : Link (T.irSide n), C e e' ≤ landingTubeContraction T) ∧
      (∀ e : Link (T.irSide n),
        dobrushinIteratedRowSum C t e ≤ (landingTubeContraction T) ^ t) := by
  filter_upwards [T.h_tube] with n h_tube
  dsimp only
  have hβ0 : 0 ≤ ((T.chain n).state 0).β := (T.chain n).h_β_nonneg 0 (Nat.zero_le _)
  have h_sup :=
    ((T.chain n).state 0).totalAction_dobrushinSupMatrix_rowSum_le
      hβ0 h_tube.1 T.hβ_star_nonneg T.hη_star_nonneg T.hε_star_nonneg
      h_tube.2.1 h_tube.2.2 T.h_land
  have hq0 : 0 ≤ 4 * (18 * (24 * T.β_star) + T.η_star + T.ε_star) := by
    have := T.hβ_star_nonneg
    have := T.hη_star_nonneg
    have := T.hε_star_nonneg
    linarith
  have hq_le :
      4 * (18 * (24 * T.β_star) + T.η_star + T.ε_star) ≤ landingTubeContraction T :=
    le_max_left _ _
  refine ⟨fun e e' =>
    dobrushinSupMatrix_nonneg SU2 (T.irSide n) ((T.chain n).state 0).totalAction e e',
    fun e => le_trans (h_sup.1 e).1 hq_le,
    fun e => le_trans (h_sup.2 t e).2 (pow_le_pow_left₀ hq0 hq_le t)⟩

/-- Support-dependent Dobrushin comparison bound on the landed IR effective action
`((T.chain n).state 0).totalAction` of `T : LandingTube P`: for any two observables `f, g` whose
single-link oscillation supports `supp_f n` and `supp_g n` are separated by distance `≥ t` under a
link metric `distLink n` in which `dobrushinSupMatrix` has range `≤ 1`, the Dobrushin observable
comparison functional `dobrushinObservableComparison` decays as
`((∑ e ∈ supp_f n, linkOscillation SU2 (T.irSide n) (f n) e) * M_g) * (landingTubeContraction T) ^ t / (1 - landingTubeContraction T)`. -/
theorem LandingTube.landed_dobrushinObservableComparison_le_of_support_dist
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (distLink : ∀ n : ℕ, Link (T.irSide n) → Link (T.irSide n) → ℕ)
    (supp_f supp_g : ∀ n : ℕ, Finset (Link (T.irSide n)))
    (f g : ∀ n : ℕ, GaugeConfig (T.irSide n) → ℝ)
    (M_g : ℝ) (hMg_nonneg : 0 ≤ M_g) (t : ℕ)
    (h_refl : ∀ n e, distLink n e e = 0)
    (h_tri : ∀ n e₁ e₂ e₃, distLink n e₁ e₃ ≤ distLink n e₁ e₂ + distLink n e₂ e₃)
    (h_step : ∀ᶠ n in atTop, ∀ e e',
      dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction e e' ≠ 0 →
      distLink n e e' ≤ 1)
    (hf_supp : ∀ᶠ n in atTop, ∀ e ∉ supp_f n, linkOscillation SU2 (T.irSide n) (f n) e = 0)
    (hg_supp : ∀ᶠ n in atTop, ∀ e' ∉ supp_g n, linkOscillation SU2 (T.irSide n) (g n) e' = 0)
    (hg_osc : ∀ᶠ n in atTop, ∀ e' ∈ supp_g n, linkOscillation SU2 (T.irSide n) (g n) e' ≤ M_g)
    (h_sep : ∀ᶠ n in atTop, ∀ e ∈ supp_f n, ∀ e' ∈ supp_g n, t ≤ distLink n e e') :
    ∀ᶠ n in atTop,
      dobrushinObservableComparison SU2
        (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) (f n) (g n) ≤
        (∑ e ∈ supp_f n, linkOscillation SU2 (T.irSide n) (f n) e) * M_g *
          ((landingTubeContraction T) ^ t / (1 - landingTubeContraction T)) := by
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  filter_upwards [T.landed_dobrushinSupMatrix_rowSum_le_contraction t,
    h_step, hf_supp, hg_supp, hg_osc, h_sep]
    with n h_mat h_st hf_s hg_s hg_o h_sp
  exact dobrushinObservableComparison_le_of_support_dist
    SU2 (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) (distLink n)
    (le_of_lt hq0) hq1 hMg_nonneg h_mat.1 h_mat.2.1 (h_refl n) (h_tri n) h_st
    (f n) (g n) (supp_f n) (supp_g n) t hf_s hg_s hg_o h_sp

/-- Unconditional Föllmer–Dobrushin covariance comparison theorem for the actual landed IR Gibbs
measure `((T.chain n).state 0).gibbsMeasure` of any `T : LandingTube P`: eventually in `n`, for
every pair of bounded measurable observables `f, g : GaugeConfig (T.irSide n) → ℝ`,
`|irCov ((T.chain n).state 0).gibbsMeasure f g| ≤ dobrushinObservableComparison SU2 (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) f g`. -/
theorem LandingTube.landed_gibbsMeasure_abs_irCov_le_dobrushinObservableComparison
    {P : ContinuumCutoffPath} (T : LandingTube P) :
    ∀ᶠ n in atTop,
      ∀ (f g : GaugeConfig (T.irSide n) → ℝ) {M_f M_g : ℝ},
        Measurable f → (∀ V : GaugeConfig (T.irSide n), |f V| ≤ M_f) →
        Measurable g → (∀ V : GaugeConfig (T.irSide n), |g V| ≤ M_g) →
        |irCov ((T.chain n).state 0).gibbsMeasure f g| ≤
          dobrushinObservableComparison SU2
            (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) f g := by
  filter_upwards [T.h_tube] with n h_tube f g M_f M_g hf_meas hf_bdd hg_meas hg_bdd
  have hβ0 : 0 ≤ ((T.chain n).state 0).β := (T.chain n).h_β_nonneg 0 (Nat.zero_le _)
  rw [irCov_eq_groupGibbsCov]
  exact ((T.chain n).state 0).gibbsMeasure_abs_cov_le_dobrushinObservableComparison
    hβ0 h_tube.1 T.hβ_star_nonneg T.hη_star_nonneg T.hε_star_nonneg
    h_tube.2.1 h_tube.2.2 T.h_land hf_meas hf_bdd hg_meas hg_bdd

/-- Unconditional divergence of the landed IR lattice side `T.irSide n → ∞` derived directly from
`P.physicalSide_tendsto_atTop`, `T.hK`, and `T.hside`. -/
theorem LandingTube.eventually_gt_irSide {P : ContinuumCutoffPath} (T : LandingTube P) (B : ℕ) :
    ∀ᶠ n in atTop, B < T.irSide n := by
  have hℓ_pos : (0 : ℝ) < (T.ℓstar : ℝ) := Rat.cast_pos.mpr T.hℓstar
  have h_phys :
      ∀ᶠ n in atTop, ((B : ℝ) + 1) * (T.ℓstar : ℝ) ≤ (P.side n : ℝ) * P.spacing n :=
    (tendsto_atTop.mp P.physicalSide_tendsto_atTop) (((B : ℝ) + 1) * (T.ℓstar : ℝ))
  filter_upwards [h_phys, T.hK, T.hside] with n h_le hK hside
  have h_prod_eq : (P.side n : ℝ) * P.spacing n = (T.irSide n : ℝ) * (T.ℓstar : ℝ) := by
    rw [hside, dyadicScaleSide_eq_two_pow_mul, ← hK]
    push_cast
    ring
  rw [h_prod_eq] at h_le
  have h_lt_real : (B : ℝ) < (T.irSide n : ℝ) := by
    have h_le_ir : (B : ℝ) + 1 ≤ (T.irSide n : ℝ) :=
      le_of_mul_le_mul_right h_le hℓ_pos
    linarith
  exact Nat.cast_lt.mp h_lt_real

theorem LandingTube.tendsto_irSide_atTop {P : ContinuumCutoffPath} (T : LandingTube P) :
    Tendsto T.irSide atTop atTop :=
  tendsto_atTop.mpr fun B => (T.eventually_gt_irSide B).mono fun _ h => le_of_lt h

/-- Unconditional large-torus time-shift link-support separation on any `T : LandingTube P`:
for every positive-time loop family `F : DisjointLoopFamily` (`F.PositiveTime`) and every integer
time shift `t : ℕ`, eventually in `n`, every link
`e ∈ physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ) F.reflect.loops` and every link
`e' ∈ physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ) (F.translate (timeShift (t * T.ℓstar))).loops`
satisfies `t ≤ linkTemporalDist e e'` and `t ≤ linkSupDist e e'`. -/
theorem LandingTube.eventually_loop_support_timeShift_sep
    {P : ContinuumCutoffPath} (T : LandingTube P)
    {F : DisjointLoopFamily} (hFpos : F.PositiveTime) (t : ℕ) :
    ∀ᶠ n in atTop,
      ∀ e ∈ physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ) F.reflect.loops,
      ∀ e' ∈ physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ)
        (F.translate (timeShift (t * T.ℓstar))).loops,
      t ≤ linkTemporalDist e e' ∧ t ≤ linkSupDist e e' := by
  filter_upwards [T.eventually_gt_irSide
    (2 * (t + 2 * loopListTimeSpanBound (T.ℓstar : ℝ) F.loops))] with n hL e he e' he'
  exact physicalLoopListSupport_timeShift_sep_of_lt_side
    (T.irSide n) T.hℓstar hFpos t hL he he'

/-- Neighbor-local sufficiency for Dobrushin spatial decay on `T : LandingTube P`: if the landed
effective action `((T.chain n).state 0)` is eventually neighbor-local (`IsNeighborLocal`), then for
every target link set `S` at temporal distance `≥ t` from `e`, the Dobrushin Neumann series sum over
`S` is bounded by `(1 / (1 - landingTubeContraction T)) * (landingTubeContraction T) ^ t`. -/
theorem LandingTube.dobrushin_spatial_decay_of_isNeighborLocal
    {P : ContinuumCutoffPath} (T : LandingTube P)
    (h_loc : ∀ᶠ n in atTop, ((T.chain n).state 0).IsNeighborLocal) :
    ∃ C_spatial : ℝ, 0 ≤ C_spatial ∧
      ∀ (t : ℕ), ∀ᶠ n in atTop,
        ∀ (e : Link (T.irSide n)) (S : Finset (Link (T.irSide n))),
          (∀ e' ∈ S, t ≤ linkTemporalDist e e') →
          (∑ e' ∈ S,
            dobrushinComparisonSeries
              (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e') ≤
            C_spatial * (landingTubeContraction T) ^ t := by
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  set q := landingTubeContraction T
  have h1q_pos : 0 < 1 - q := sub_pos.mpr hq1
  refine ⟨1 / (1 - q), div_nonneg zero_le_one h1q_pos.le, fun t => ?_⟩
  filter_upwards [T.h_tube, T.landed_dobrushinSupMatrix_rowSum_le_contraction t, h_loc]
    with n h_tube h_mat h_lc e S h_sep
  have hβ0 : 0 ≤ ((T.chain n).state 0).β := (T.chain n).h_β_nonneg 0 (Nat.zero_le _)
  have h_step (e₁ e₂ : Link (T.irSide n))
      (hne : dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction e₁ e₂ ≠ 0) :
      linkTemporalDist e₁ e₂ ≤ 1 :=
    (((T.chain n).state 0).totalAction_dobrushinSupMatrix_ne_zero_imp_dist_le_one
      hβ0 h_tube.2.1 h_tube.2.2 h_lc hne).2.2
  have h_vanish (e' : Link (T.irSide n)) (he' : e' ∈ S) (m : ℕ) (hm : m < t) :
      dobrushinMatrixPow
        (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) m e e' = 0 :=
    dobrushinMatrixPow_eq_zero_of_lt_dist
      (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      linkTemporalDist linkTemporalDist_self linkTemporalDist_triangle h_step m e e'
      (lt_of_lt_of_le hm (h_sep e' he'))
  have h_sum :=
    sum_dobrushinComparisonSeries_le_of_vanish_lt
      (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      hq0.le hq1 h_mat.1 h_mat.2.1 e S t h_vanish
  calc
    (∑ e' ∈ S,
      dobrushinComparisonSeries
        (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e')
      ≤ q ^ t / (1 - q) := h_sum
    _ = (1 / (1 - q)) * q ^ t := by ring

/-- Nonlocal Georgii Theorem 8.20 sufficiency for Dobrushin spatial decay on `T : LandingTube P`:
even when multi-step blocking produces nonlocal polymer and truncation terms, if the
`(landingTubeContraction T)⁻¹`-tilted Dobrushin matrix has row sum eventually bounded by
`q_tilde < 1` (for instance via `InteractingEffectiveActionState.totalAction_dobrushinTiltedMatrix_rowSum_le`),
then for every target link set `S` at temporal distance `≥ t` from `e`, the Dobrushin Neumann
series sum over `S` is bounded by `(1 / (1 - q_tilde)) * (landingTubeContraction T) ^ t`. -/
theorem LandingTube.dobrushin_spatial_decay_of_tilted_rowSum
    {P : ContinuumCutoffPath} (T : LandingTube P)
    {q_tilde : ℝ} (hq_tilde_nonneg : 0 ≤ q_tilde) (hq_tilde_lt : q_tilde < 1)
    (h_tilted : ∀ᶠ n in atTop, ∀ e : Link (T.irSide n),
      (∑ e' : Link (T.irSide n),
        dobrushinTiltedMatrix
          (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
          linkTemporalDist (landingTubeContraction T)⁻¹ e e') ≤ q_tilde) :
    ∃ C_spatial : ℝ, 0 ≤ C_spatial ∧
      ∀ (t : ℕ), ∀ᶠ n in atTop,
        ∀ (e : Link (T.irSide n)) (S : Finset (Link (T.irSide n))),
          (∀ e' ∈ S, t ≤ linkTemporalDist e e') →
          (∑ e' ∈ S,
            dobrushinComparisonSeries
              (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e') ≤
            C_spatial * (landingTubeContraction T) ^ t := by
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  set q := landingTubeContraction T
  have h1q_pos : 0 < 1 - q_tilde := sub_pos.mpr hq_tilde_lt
  have hμ_ge_one : 1 ≤ q⁻¹ := ((one_lt_inv₀ hq0).mpr hq1).le
  refine ⟨1 / (1 - q_tilde), div_nonneg zero_le_one h1q_pos.le, fun t => ?_⟩
  filter_upwards [h_tilted] with n h_tilt e S h_sep
  have h_sum :=
    sum_dobrushinComparisonSeries_le_of_tilted_rowSum
      (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      linkTemporalDist hμ_ge_one hq_tilde_nonneg hq_tilde_lt
      (dobrushinSupMatrix_nonneg SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      linkTemporalDist_self linkTemporalDist_triangle h_tilt e S t h_sep
  rw [inv_inv] at h_sum
  calc
    (∑ e' ∈ S,
      dobrushinComparisonSeries
        (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e')
      ≤ q ^ t / (1 - q_tilde) := h_sum
    _ = (1 / (1 - q_tilde)) * q ^ t := by ring

/-- Landed infrared expectation of a multi-loop observable `F : DisjointLoopFamily`
at fixed physical block scale `T.ℓstar` under the landed IR Gibbs measure
`((T.chain n).state 0).gibbsMeasure`.
Note: the renormalization parameter `_Z` is unused in the right-hand side (`irLoopFamilyObservable`
has no `Z.factor` factor), and under pure decimation (`dyadicLinkBlockMap`) the landed loop is a
bare loop. -/
noncomputable def landedIrSchwinger {P : ContinuumCutoffPath}
    (T : LandingTube P) (_Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) (F : DisjointLoopFamily) : ℝ :=
  ∫ V, irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F V
    ∂(((T.chain n).state 0).gibbsMeasure)

/-- Dressed infrared multi-loop observable `V ↦ ∏_{ℓ ∈ F.loops} (Z.factor n ℓ * physicalWilsonLoop L a ℓ V)`. -/
noncomputable def irDressedLoopFamilyObservable {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) (L n : ℕ) (a : ℝ)
    (F : DisjointLoopFamily) (V : GaugeConfig L) : ℝ :=
  (F.loops.map (fun ℓ => Z.factor n ℓ * physicalWilsonLoop L a ℓ V)).prod

theorem list_prod_map_mul_eq_prod_mul_prod {α : Type*} (f g : α → ℝ) :
    ∀ ls : List α, (ls.map (fun x => f x * g x)).prod = (ls.map f).prod * (ls.map g).prod
  | [] => by simp
  | x :: xs => by
      simp only [List.map_cons, List.prod_cons, list_prod_map_mul_eq_prod_mul_prod f g xs]
      ring

theorem irDressedLoopFamilyObservable_eq_prod_mul {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) (L n : ℕ) (a : ℝ)
    (F : DisjointLoopFamily) (V : GaugeConfig L) :
    irDressedLoopFamilyObservable Z L n a F V =
      (F.loops.map (fun ℓ => Z.factor n ℓ)).prod * irLoopFamilyObservable L a F V :=
  list_prod_map_mul_eq_prod_mul_prod (fun ℓ => Z.factor n ℓ) (fun ℓ => physicalWilsonLoop L a ℓ V) F.loops

theorem abs_list_prod_le_one_of_abs_le_one {α : Type*} (f : α → ℝ) :
    ∀ (ls : List α), (∀ x ∈ ls, |f x| ≤ 1) → |(ls.map f).prod| ≤ 1
  | [], _ => by simp
  | x :: xs, h => by
      simp only [List.map_cons, List.prod_cons, abs_mul]
      have hx : |f x| ≤ 1 := h x List.mem_cons_self
      have hxs : |(xs.map f).prod| ≤ 1 :=
        abs_list_prod_le_one_of_abs_le_one f xs (fun y hy => h y (List.mem_cons_of_mem x hy))
      nlinarith [abs_nonneg (f x), abs_nonneg ((xs.map f).prod)]

theorem irCov_irDressedLoopFamilyObservable_eq {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) {L : ℕ} (μ : Measure (GaugeConfig L))
    (n : ℕ) (a : ℝ) (F G : DisjointLoopFamily) :
    irCov μ (irDressedLoopFamilyObservable Z L n a F) (irDressedLoopFamilyObservable Z L n a G) =
      (F.loops.map (fun ℓ => Z.factor n ℓ)).prod *
        (G.loops.map (fun ℓ => Z.factor n ℓ)).prod *
        irCov μ (irLoopFamilyObservable L a F) (irLoopFamilyObservable L a G) := by
  have hF :
      irDressedLoopFamilyObservable Z L n a F =
        fun V => (F.loops.map (fun ℓ => Z.factor n ℓ)).prod * irLoopFamilyObservable L a F V :=
    funext (irDressedLoopFamilyObservable_eq_prod_mul Z L n a F)
  have hG :
      irDressedLoopFamilyObservable Z L n a G =
        fun V => (G.loops.map (fun ℓ => Z.factor n ℓ)).prod * irLoopFamilyObservable L a G V :=
    funext (irDressedLoopFamilyObservable_eq_prod_mul Z L n a G)
  rw [hF, hG, irCov_const_mul]

theorem landedIrSchwinger_reflect_append_sub_mul_eq_irCov {P : ContinuumCutoffPath}
    (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath)
    (n : ℕ) (F G : DisjointLoopFamily) :
    landedIrSchwinger T Z n (F.reflect.append G) -
      landedIrSchwinger T Z n F.reflect * landedIrSchwinger T Z n G =
      irCov ((T.chain n).state 0).gibbsMeasure
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect)
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) G) := by
  unfold landedIrSchwinger irCov irLoopFamilyObservable DisjointLoopFamily.append
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun V => ?_)
  simp [List.map_append, List.prod_append]

/-- Gap 2 (H2) geometric two-cutoff comparison bound on landed effective actions and renormalized
multi-loop Schwinger functions along `P` coupled to `T : LandingTube P`
(refuted: `not_twoCutoffComparison_of_perimeter_tendsto_atTop_and_corner_bddBelow`,
`not_twoCutoffComparison_of_irCov_decay`, `not_twoCutoffComparison_of_balabanMultiScaleUVToIRFlow`):
1. Matches the renormalization scheme `Z = T.Z_tube`,
2. Bounds the adjacent-cutoff difference of the landed IR renormalized couplings
   `|((T.chain n).state 0).β - ((T.chain (n + 1)).state 0).β| ≤ C_act * (landingTubeContraction T) ^ n`,
3. Quantifies a single tube-level constant `∃ C_tube : ℝ, 0 ≤ C_tube` outside `∀ F : DisjointLoopFamily`
   bounding the adjacent-cutoff difference of `landedIrSchwinger T Z n F` and `landedIrSchwinger T Z (n + 1) F`
   by `C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n`, and
4. Bounds the RG observable-dressing defect between `renormalizedSchwinger Z n F` and
   `landedIrSchwinger T Z n F` by `C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n`. -/
structure TwoCutoffComparison {P : ContinuumCutoffPath}
    (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath) : Prop where
  hZ_eq : Z = T.Z_tube
  h_effective_action_comparison :
    ∃ C_act : ℝ, 0 ≤ C_act ∧
      ∀ n : ℕ,
        |((T.chain n).state 0).β - ((T.chain (n + 1)).state 0).β| ≤
          C_act * (landingTubeContraction T) ^ n
  h_landed_and_dressing :
    ∃ C_tube : ℝ, 0 ≤ C_tube ∧
      ∀ F : DisjointLoopFamily,
        (∀ n : ℕ,
          dist (landedIrSchwinger T Z n F) (landedIrSchwinger T Z (n + 1) F) ≤
            C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n) ∧
        (∀ n : ℕ,
          dist (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F) ≤
            C_tube ^ (F.loops.length + 1) * (landingTubeContraction T) ^ n)

/-- Geometric effective-action comparison in `TwoCutoffComparison` implies that the landed IR
renormalized coupling `fun n => ((T.chain n).state 0).β` is a Cauchy sequence. -/
theorem landedBeta_cauchy_of_twoCutoffComparison {P : ContinuumCutoffPath}
    {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) :
    CauchySeq (fun n => ((T.chain n).state 0).β) := by
  obtain ⟨C_act, _, h_act⟩ := hC.h_effective_action_comparison
  have hq1 : landingTubeContraction T < 1 :=
    (landingTube_contraction_and_transferGapRate_pos T).2.1
  refine cauchySeq_of_le_geometric (landingTubeContraction T) C_act hq1 (fun n => ?_)
  rw [Real.dist_eq]
  exact h_act n

/-- Geometric landed two-cutoff comparison and RG observable-dressing bounds imply
`RenormalizedLoopCauchy Z` on every `DisjointLoopFamily` via the triangle inequality through
`landedIrSchwinger T Z n F` and `landedIrSchwinger T Z (n + 1) F`. -/
theorem renormalizedLoopCauchy_of_twoCutoffComparison {P : ContinuumCutoffPath}
    {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) : RenormalizedLoopCauchy Z := by
  obtain ⟨C_tube, _, h_all⟩ := hC.h_landed_and_dressing
  intro F
  set q := landingTubeContraction T
  set C_F := C_tube ^ (F.loops.length + 1)
  have hq1 : q < 1 := (landingTube_contraction_and_transferGapRate_pos T).2.1
  obtain ⟨h_landed, h_dress⟩ := h_all F
  refine cauchySeq_of_le_geometric q (C_F + C_F + C_F * q) hq1
    (fun n => ?_)
  have hd1 := h_dress n
  have hd2 := h_landed n
  have hd3 : dist (landedIrSchwinger T Z (n + 1) F) (renormalizedSchwinger Z (n + 1) F) ≤
      C_F * q ^ (n + 1) := by
    rw [dist_comm]
    exact h_dress (n + 1)
  have htri1 := dist_triangle (renormalizedSchwinger Z n F) (landedIrSchwinger T Z n F)
    (renormalizedSchwinger Z (n + 1) F)
  have htri2 := dist_triangle (landedIrSchwinger T Z n F) (landedIrSchwinger T Z (n + 1) F)
    (renormalizedSchwinger Z (n + 1) F)
  have hpow : C_F * q ^ n + C_F * q ^ n + C_F * q ^ (n + 1) =
      (C_F + C_F + C_F * q) * q ^ n := by
    rw [pow_succ]
    ring
  linarith

/-- Geometric two-cutoff comparison implies convergence of `renormalizedSchwinger Z n F`
for every `DisjointLoopFamily F` to a continuum Schwinger functional `S : DisjointLoopFamily → ℝ`. -/
theorem schwingerConverges_of_twoCutoffComparison {P : ContinuumCutoffPath}
    {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) :
    ∃ S : DisjointLoopFamily → ℝ,
      ∀ F : DisjointLoopFamily, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F)) :=
  schwingerConverges_of_cauchy (renormalizedLoopCauchy_of_twoCutoffComparison hC)

/-- Under `TwoCutoffComparison T Z`, `landedIrSchwinger T Z n F` converges to the same continuum
Schwinger functional `S F` as `renormalizedSchwinger Z n F`. -/
theorem landedIrSchwinger_tendsto_of_twoCutoffComparison {P : ContinuumCutoffPath}
    {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) {S : DisjointLoopFamily → ℝ}
    (hS : ∀ F : DisjointLoopFamily, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F)))
    (F : DisjointLoopFamily) :
    Tendsto (fun n => landedIrSchwinger T Z n F) atTop (𝓝 (S F)) := by
  obtain ⟨C_tube, _, h_all⟩ := hC.h_landed_and_dressing
  obtain ⟨hq0, hq1, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  set q := landingTubeContraction T
  set C_F := C_tube ^ (F.loops.length + 1)
  have h_dress := (h_all F).2
  have h_geom : Tendsto (fun n : ℕ => C_F * q ^ n) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds (x := C_F)).mul
      (tendsto_pow_atTop_nhds_zero_of_lt_one hq0.le hq1)
  have h_le : ∀ᶠ n : ℕ in atTop,
      ‖landedIrSchwinger T Z n F - renormalizedSchwinger Z n F‖ ≤ C_F * q ^ n := by
    refine Filter.Eventually.of_forall fun n => ?_
    rw [Real.norm_eq_abs, abs_sub_comm, ← Real.dist_eq]
    exact h_dress n
  have h_diff_zero :
      Tendsto (fun n => landedIrSchwinger T Z n F - renormalizedSchwinger Z n F) atTop (𝓝 0) :=
    squeeze_zero_norm' h_le h_geom
  have h_sum := (hS F).add h_diff_zero
  rw [add_zero] at h_sum
  refine h_sum.congr fun n => ?_
  ring

/-- Under `TwoCutoffComparison T Z`, the difference between the UV renormalized connected correlator
`reflectedConnected Z n F G` and the landed IR covariance `irCov ((T.chain n).state 0).gibbsMeasure`
of `irLoopFamilyObservable` at physical block scale `T.ℓstar` tends to `0` as `n → ∞`. -/
theorem reflectedConnected_sub_irCov_tendsto_zero_of_twoCutoffComparison
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z) (F G : DisjointLoopFamily) :
    Tendsto (fun n =>
      reflectedConnected Z n F G -
        irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) G))
      atTop (𝓝 0) := by
  obtain ⟨S, hS⟩ := schwingerConverges_of_twoCutoffComparison hC
  have hL : ∀ H : DisjointLoopFamily,
      Tendsto (fun n => landedIrSchwinger T Z n H) atTop (𝓝 (S H)) :=
    landedIrSchwinger_tendsto_of_twoCutoffComparison hC hS
  have h_uv :
      Tendsto (fun n => reflectedConnected Z n F G) atTop
        (𝓝 (S (F.reflect.append G) - S F.reflect * S G)) := by
    simp only [reflectedConnected_eq_schwinger_sub]
    exact (hS (F.reflect.append G)).sub ((hS F.reflect).mul (hS G))
  have h_ir :
      Tendsto (fun n =>
        irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) G))
        atTop (𝓝 (S (F.reflect.append G) - S F.reflect * S G)) := by
    have h_landed := (hL (F.reflect.append G)).sub ((hL F.reflect).mul (hL G))
    exact h_landed.congr fun n =>
      landedIrSchwinger_reflect_append_sub_mul_eq_irCov T Z n F G
  simpa using h_uv.sub h_ir

/-- For any cutoff path `P`, renormalization scheme `Z`, cutoff index `n`, and loop family `F`,
`DisjointLoopFamily.eval Z n F : GaugeConfig (P.side n) → ℝ` is continuous. -/
theorem DisjointLoopFamily.continuous_eval {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (F : DisjointLoopFamily) :
    Continuous (fun U : GaugeConfig (P.side n) => F.eval Z n U) := by
  unfold DisjointLoopFamily.eval
  induction F.loops with
  | nil => exact continuous_const
  | cons ℓ ls ih =>
      simp only [List.map_cons, List.prod_cons]
      exact (continuous_const.mul (continuous_physicalWilsonLoop (P.side n) (P.spacing n) ℓ)).mul ih

/-- Pointwise coordinate-permutation equivariance of `DisjointLoopFamily.eval` under a
permutation-invariant loop renormalization scheme `Z`:
`(F.permute σ).eval Z n (permuteConfig σ U) = F.eval Z n U`. -/
theorem DisjointLoopFamily.eval_permute_eq_of_isPermutationInvariant {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsPermutationInvariant) (n : ℕ)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) (U : GaugeConfig (P.side n)) :
    (F.permute σ).eval Z n (permuteConfig σ U) = F.eval Z n U := by
  simp only [DisjointLoopFamily.eval, DisjointLoopFamily.permute, List.map_map]
  congr 1
  refine List.map_congr_left fun ℓ _ => ?_
  dsimp
  rw [hZ n σ ℓ, physicalWilsonLoop_permute σ (P.spacing n) ℓ U]

/-- Exact coordinate-permutation invariance of `renormalizedSchwinger` at every finite cutoff `n`
for any permutation-invariant loop renormalization scheme `Z`:
`renormalizedSchwinger Z n (F.permute σ) = renormalizedSchwinger Z n F`. -/
theorem renormalizedSchwinger_permute_eq_of_isPermutationInvariant {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsPermutationInvariant) (n : ℕ)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) :
    renormalizedSchwinger Z n (F.permute σ) = renormalizedSchwinger Z n F := by
  unfold renormalizedSchwinger CutoffPath.configLaw
  have hinv := congrArg ProbabilityMeasure.toMeasure
    (wilsonProbability_permute_invariant (P.side n) (P.coupling n) (P.coupling_nonneg n) σ)
  rw [ProbabilityMeasure.toMeasure_map] at hinv
  conv_lhs => rw [← hinv]
  have hcont : Continuous (fun U : GaugeConfig (P.side n) => (F.permute σ).eval Z n U) :=
    DisjointLoopFamily.continuous_eval Z n (F.permute σ)
  rw [integral_map (continuous_permuteConfig σ).aemeasurable hcont.aestronglyMeasurable]
  refine integral_congr_ae (Eventually.of_forall fun U => ?_)
  exact DisjointLoopFamily.eval_permute_eq_of_isPermutationInvariant hZ n σ F U

/-- For any permutation-invariant renormalization scheme `Z`, the hypercubic permutation defect
vanishes identically at every finite cutoff `n`. -/
theorem renormalizedSchwinger_permute_sub_self_eq_zero_of_isPermutationInvariant {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsPermutationInvariant) (n : ℕ)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) :
    renormalizedSchwinger Z n (F.permute σ) - renormalizedSchwinger Z n F = 0 := by
  rw [renormalizedSchwinger_permute_eq_of_isPermutationInvariant hZ n σ F, sub_self]

/-- For any permutation-invariant renormalization scheme `Z`, the hypercubic permutation defect is
bounded by `0 * (P.spacing n) ^ 2` at every finite cutoff `n`. -/
theorem abs_renormalizedSchwinger_permute_sub_le_zero_mul_spacing_sq_of_isPermutationInvariant
    {P : CutoffPath} {Z : LoopRenormalization P} (hZ : Z.IsPermutationInvariant) (n : ℕ)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) :
    |renormalizedSchwinger Z n (F.permute σ) - renormalizedSchwinger Z n F| ≤
      0 * (P.spacing n) ^ 2 := by
  rw [renormalizedSchwinger_permute_sub_self_eq_zero_of_isPermutationInvariant hZ n σ F,
    abs_zero, zero_mul]

/-- Unconditional dimension-6 hypercubic permutation bound (`C_pm = 0`) for any
permutation-invariant renormalization scheme `Z`. -/
theorem exists_permute_dim6_of_isPermutationInvariant {P : ContinuumCutoffPath}
    {Z : LoopRenormalization P.toCutoffPath} (hZ : Z.IsPermutationInvariant)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) :
    ∃ C_pm : ℝ, 0 ≤ C_pm ∧
      ∀ᶠ n in atTop,
        |renormalizedSchwinger Z n (F.permute σ) - renormalizedSchwinger Z n F| ≤
          C_pm * (P.spacing n) ^ 2 :=
  ⟨0, le_rfl, Eventually.of_forall fun n =>
    abs_renormalizedSchwinger_permute_sub_le_zero_mul_spacing_sq_of_isPermutationInvariant
      hZ n σ F⟩

/-- Unconditional vanishing of the hypercubic permutation defect along `atTop` for any
permutation-invariant renormalization scheme `Z`. -/
theorem tendsto_permute_defect_zero_of_isPermutationInvariant {P : CutoffPath}
    {Z : LoopRenormalization P} (hZ : Z.IsPermutationInvariant)
    (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily) :
    Tendsto (fun n => renormalizedSchwinger Z n (F.permute σ) - renormalizedSchwinger Z n F)
      atTop (𝓝 0) := by
  simp only [renormalizedSchwinger_permute_sub_self_eq_zero_of_isPermutationInvariant hZ _ σ F]
  exact tendsto_const_nhds

/-- `TwoCutoffComparison T Z` discharges the UV-to-IR covariance transfer bound
for every loop family `F` and time shift `t` without any sign restriction on `Z.factor`. -/
theorem TwoCutoffComparison.eventually_cov_transfer_le
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z)
    (F : DisjointLoopFamily) (t : ℕ) :
    ∀ᶠ n in atTop,
      reflectedConnected Z n F (F.translate (timeShift (t * T.ℓstar))) ≤
        |irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
            (F.translate (timeShift (t * T.ℓstar))))| +
          (landingTubeContraction T) ^ t := by
  obtain ⟨hq0, _, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  have hqt_pos : 0 < (landingTubeContraction T) ^ t := pow_pos hq0 t
  let G := F.translate (timeShift (t * T.ℓstar))
  have h_tend :=
    (Metric.tendsto_nhds.mp
      (reflectedConnected_sub_irCov_tendsto_zero_of_twoCutoffComparison hC F G))
      ((landingTubeContraction T) ^ t) hqt_pos
  filter_upwards [h_tend] with n hn
  rw [Real.dist_eq, sub_zero] at hn
  have h_diff_lt := (abs_lt.mp hn).2
  have h_le_abs :=
    le_abs_self
      (irCov ((T.chain n).state 0).gibbsMeasure
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect)
        (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) G))
  linarith

/-- `TwoCutoffComparison T Z` together with eventual nonnegativity of `reflectedConnected Z n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩`
on the single probe rectangle `⟨[T.ℓ_probe]⟩` discharges the IR-to-UV probe transfer bound. -/
theorem TwoCutoffComparison.eventually_probe_transfer
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hC : TwoCutoffComparison T Z)
    (h_refl_probe : ∀ᶠ n in atTop, 0 ≤ reflectedConnected Z n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩) :
    ∀ᶠ n in atTop,
      |irCov ((T.chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
        (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe)| -
        T.c_floor / 2 ≤
        reflectedConnected Z n ⟨[T.ℓ_probe]⟩ ⟨[T.ℓ_probe]⟩ := by
  have h_half_pos : 0 < T.c_floor / 2 := half_pos T.hc_floor
  let F_probe : DisjointLoopFamily := ⟨[T.ℓ_probe]⟩
  have h_tend :=
    (Metric.tendsto_nhds.mp
      (reflectedConnected_sub_irCov_tendsto_zero_of_twoCutoffComparison hC F_probe F_probe))
      (T.c_floor / 2) h_half_pos
  filter_upwards [h_tend, h_refl_probe] with n hn h_nonneg
  rw [Real.dist_eq, sub_zero] at hn
  have h_obs_ref :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F_probe.reflect =
        physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect := by
    funext V
    simp [irLoopFamilyObservable, F_probe, DisjointLoopFamily.reflect]
  have h_obs_self :
      irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F_probe =
        physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe := by
    funext V
    simp [irLoopFamilyObservable, F_probe]
  rw [h_obs_ref, h_obs_self] at hn
  set c_ir :=
    irCov ((T.chain n).state 0).gibbsMeasure
      (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe.timeReflect)
      (physicalWilsonLoop (T.irSide n) (T.ℓstar : ℝ) T.ℓ_probe)
  rcases le_or_gt 0 c_ir with hc_nonneg | hc_neg
  · rw [abs_of_nonneg hc_nonneg]
    linarith [(abs_lt.mp hn).1]
  · rw [abs_of_neg hc_neg]
    have h_lt := (abs_lt.mp hn).2
    linarith

/-- Every loop in `F` has time coordinates commensurate with a dyadic subdivision
`ℓstar / 2 ^ m` (`m : ℕ`) of the reference scale `ℓstar`. -/
def DisjointLoopFamily.IsDyadicTime (ℓstar : ℚ) (F : DisjointLoopFamily) : Prop :=
  ∀ ℓ ∈ F.loops, ∃ m : ℕ, IsTimeCommensurate ((ℓstar : ℝ) / (2 : ℝ) ^ m) ℓ

abbrev _root_.JesseMath.Physics.YangMillsOsterwalderSchraderInheritance.DisjointLoopFamily.IsDyadicTime :=
  DisjointLoopFamily.IsDyadicTime

/-- Eventual Osterwalder–Seiler reflection positivity `0 ≤ reflectedConnected Z n F F` for every
positive-time loop family `F` whose loops have `s`-dyadic time coordinates (`F.IsDyadicTime s`). -/
def SchwingerDyadicReflectionPositive {P : CutoffPath} (Z : LoopRenormalization P) (s : ℚ) : Prop :=
  ∀ F : DisjointLoopFamily, F.PositiveTime → F.IsDyadicTime s →
    ∀ᶠ n in atTop, 0 ≤ reflectedConnected Z n F F

/-- Clay-shaped Schwinger-level output along a continuum cutoff path `P`. States only
properties of the renormalized Schwinger functional `S`, the physical scale `s`, the contraction
ratio `q ∈ (0, 1)`, and the positive physical mass gap `m = transferGapRate s q > 0`, without
mentioning `LandingTube` or `TwoCutoffComparison`. -/
def QYMSchwingerGap (P : ContinuumCutoffPath) : Prop :=
  ∃ (Z : LoopRenormalization P.toCutoffPath) (S : DisjointLoopFamily → ℝ)
    (s : ℚ) (q m : ℝ),
    0 < s ∧ 0 < q ∧ q < 1 ∧ m = transferGapRate s q ∧ 0 < m ∧
    (∀ F, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F))) ∧
    SchwingerDyadicReflectionPositive Z s ∧
    SchwingerEuclideanInvariant S ∧
    SchwingerMomentDecay Z s q ∧
    SchwingerExcitationFloor Z

/-- Asymptotic translation defect vanishing and Dobrushin spatial decay along the concrete temporal
torus metric `linkTemporalDist` connecting `T : LandingTube P` to the UV renormalized correlators
`reflectedConnected Z n` (with dyadic reflection positivity, `h_permute_defect`, `h_cov_transfer_le`,
and `h_probe_transfer` proved unconditionally inside `qymSchwingerGap_of_landingTube` from `T` and `hC`). -/
structure ObservableTransferAndSymmetryBridge {P : ContinuumCutoffPath}
    (T : LandingTube P) (Z : LoopRenormalization P.toCutoffPath) : Prop where
  h_translate_defect :
    ∀ (c : Fin 4 → ℚ) (F : DisjointLoopFamily),
      Tendsto (fun n => renormalizedSchwinger Z n (F.translate c) - renormalizedSchwinger Z n F)
        atTop (𝓝 0)
  h_dobrushin_spatial_decay :
    ∃ C_spatial : ℝ, 0 ≤ C_spatial ∧
      ∀ (t : ℕ), ∀ᶠ n in atTop,
        ∀ (e : Link (T.irSide n)) (S : Finset (Link (T.irSide n))),
          (∀ e' ∈ S, t ≤ linkTemporalDist e e') →
          (∑ e' ∈ S,
            dobrushinComparisonSeries
              (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction) e e') ≤
            C_spatial * (landingTubeContraction T) ^ t

/-- Every finite product of renormalized physical Wilson loops
`V ↦ (loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod` is continuous (hence measurable)
and uniformly bounded on `GaugeConfig L`. -/
theorem continuous_and_bdd_list_prod_physicalWilsonLoop
    (L : ℕ) (a : ℝ) (z : PhysicalRectangle → ℝ) :
    ∀ loops : List PhysicalRectangle,
      Continuous (fun V : GaugeConfig L =>
        (loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod) ∧
      ∃ M : ℝ, ∀ V : GaugeConfig L,
        |(loops.map (fun ℓ => z ℓ * physicalWilsonLoop L a ℓ V)).prod| ≤ M
  | [] => ⟨continuous_const, 1, fun _ => by simp⟩
  | ℓ :: ls => by
      obtain ⟨h_cont_ls, M_ls, h_bdd_ls⟩ :=
        continuous_and_bdd_list_prod_physicalWilsonLoop L a z ls
      have h_cont_head : Continuous (fun V : GaugeConfig L => z ℓ * physicalWilsonLoop L a ℓ V) :=
        continuous_const.mul (continuous_physicalWilsonLoop L a ℓ)
      have h_cont_cons :
          Continuous (fun V : GaugeConfig L =>
            (z ℓ * physicalWilsonLoop L a ℓ V) *
              (ls.map (fun ℓ' => z ℓ' * physicalWilsonLoop L a ℓ' V)).prod) :=
        h_cont_head.mul h_cont_ls
      refine ⟨by simpa only [List.map_cons, List.prod_cons] using h_cont_cons,
        |z ℓ| * max M_ls 0, fun V => ?_⟩
      simp only [List.map_cons, List.prod_cons, abs_mul]
      have hW : |physicalWilsonLoop L a ℓ V| ≤ 1 := by
        rw [physicalWilsonLoop_eq_halfTraceRe]
        exact abs_le.mpr (halfTraceRe_mem_Icc _)
      have h_head : |z ℓ| * |physicalWilsonLoop L a ℓ V| ≤ |z ℓ| := by
        nlinarith [abs_nonneg (z ℓ)]
      have h_tail :
          |(ls.map (fun ℓ' => z ℓ' * physicalWilsonLoop L a ℓ' V)).prod| ≤ max M_ls 0 :=
        (h_bdd_ls V).trans (le_max_left _ _)
      exact mul_le_mul h_head h_tail (abs_nonneg _) (abs_nonneg _)

/-- Dobrushin observable comparison bound from a direct target-support Neumann series bound:
if `f` has link support inside `supp_f`, `g` has link support inside `supp_g` with oscillation
`≤ M_g`, and `∑ e' ∈ supp_g, dobrushinComparisonSeries C e e' ≤ B_series` for all `e ∈ supp_f`,
then `dobrushinObservableComparison G C f g ≤ (∑ e ∈ supp_f, linkOscillation G L f e) * M_g * B_series`. -/
theorem dobrushinObservableComparison_le_of_series_bound
    (G : Type*) {L : ℕ} [NeZero L]
    (C : Link L → Link L → ℝ)
    {M_g B_series : ℝ} (hMg : 0 ≤ M_g)
    (hC_nonneg : ∀ e e' : Link L, 0 ≤ C e e')
    (f g : GroupGaugeConfig G L → ℝ)
    (supp_f supp_g : Finset (Link L))
    (hf_supp : ∀ e ∉ supp_f, linkOscillation G L f e = 0)
    (hg_supp : ∀ e' ∉ supp_g, linkOscillation G L g e' = 0)
    (hg_bdd : ∀ e' ∈ supp_g, linkOscillation G L g e' ≤ M_g)
    (h_series : ∀ e ∈ supp_f, (∑ e' ∈ supp_g, dobrushinComparisonSeries C e e') ≤ B_series) :
    dobrushinObservableComparison G C f g ≤
      (∑ e ∈ supp_f, linkOscillation G L f e) * M_g * B_series := by
  unfold dobrushinObservableComparison
  have h_outer :
      (∑ e : Link L, ∑ e' : Link L,
        linkOscillation G L f e * dobrushinComparisonSeries C e e' * linkOscillation G L g e') =
      ∑ e ∈ supp_f, ∑ e' ∈ supp_g,
        linkOscillation G L f e * dobrushinComparisonSeries C e e' * linkOscillation G L g e' := by
    rw [← Finset.sum_subset (Finset.subset_univ supp_f)]
    · refine Finset.sum_congr rfl fun e _ => ?_
      rw [← Finset.sum_subset (Finset.subset_univ supp_g)]
      intro e' _ he'
      rw [hg_supp e' he', mul_zero]
    · intro e _ he
      refine Finset.sum_eq_zero fun e' _ => ?_
      rw [hf_supp e he, zero_mul, zero_mul]
  rw [h_outer]
  have h_inner (e : Link L) (he : e ∈ supp_f) :
      (∑ e' ∈ supp_g,
        linkOscillation G L f e * dobrushinComparisonSeries C e e' * linkOscillation G L g e') ≤
      linkOscillation G L f e * M_g * B_series := by
    have hf_nonneg : 0 ≤ linkOscillation G L f e := linkOscillation_nonneg G L f e
    calc
      (∑ e' ∈ supp_g,
        linkOscillation G L f e * dobrushinComparisonSeries C e e' * linkOscillation G L g e')
        ≤ ∑ e' ∈ supp_g,
            linkOscillation G L f e * M_g * dobrushinComparisonSeries C e e' := by
          refine Finset.sum_le_sum fun e' he' => ?_
          have hD_nonneg := dobrushinComparisonSeries_nonneg C hC_nonneg e e'
          calc
            linkOscillation G L f e * dobrushinComparisonSeries C e e' * linkOscillation G L g e'
              ≤ linkOscillation G L f e * dobrushinComparisonSeries C e e' * M_g :=
                mul_le_mul_of_nonneg_left (hg_bdd e' he') (mul_nonneg hf_nonneg hD_nonneg)
            _ = linkOscillation G L f e * M_g * dobrushinComparisonSeries C e e' := by ring
      _ = linkOscillation G L f e * M_g * (∑ e' ∈ supp_g, dobrushinComparisonSeries C e e') := by
          rw [← Finset.mul_sum]
      _ ≤ linkOscillation G L f e * M_g * B_series :=
          mul_le_mul_of_nonneg_left (h_series e he) (mul_nonneg hf_nonneg hMg)
  calc
    (∑ e ∈ supp_f, ∑ e' ∈ supp_g,
      linkOscillation G L f e * dobrushinComparisonSeries C e e' * linkOscillation G L g e')
      ≤ ∑ e ∈ supp_f, linkOscillation G L f e * M_g * B_series :=
        Finset.sum_le_sum h_inner
    _ = (∑ e ∈ supp_f, linkOscillation G L f e) * M_g * B_series := by
        rw [← Finset.sum_mul, ← Finset.sum_mul]

/-- Exponential IR covariance decay `ir_cov_decay` derived as a theorem for the landed Gibbs measure
`((T.chain n).state 0).gibbsMeasure` from:
1. the unconditional Föllmer–Dobrushin covariance comparison theorem
   (`LandingTube.landed_gibbsMeasure_abs_irCov_le_dobrushinObservableComparison`),
2. the unconditional multi-loop support & oscillation theorems
   (`linkOscillation_irLoopFamilyObservable_eq_zero_of_not_mem`,
   `linkOscillation_irLoopFamilyObservable_le_two`,
   `sum_linkOscillation_irLoopFamilyObservable_le`),
3. the unconditional large-torus time-shift separation theorem
   (`LandingTube.eventually_loop_support_timeShift_sep`), and
4. `h_dobrushin_spatial_decay` (with `h_ir_dobrushin_comparison`, `h_loop_support_separation`,
   `h_permute_defect`, `h_cov_transfer_le`, and `h_probe_transfer` all eliminated from
   `ObservableTransferAndSymmetryBridge`). -/
theorem ObservableTransferAndSymmetryBridge.ir_cov_decay
    {P : ContinuumCutoffPath} {T : LandingTube P} {Z : LoopRenormalization P.toCutoffPath}
    (hTrans : ObservableTransferAndSymmetryBridge T Z)
    (F : DisjointLoopFamily) (hFpos : F.PositiveTime) :
    ∃ C_decay : ℝ, 0 ≤ C_decay ∧
      ∀ (t : ℕ), ∀ᶠ n in atTop,
        |irCov ((T.chain n).state 0).gibbsMeasure
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect)
          (irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
            (F.translate (timeShift (t * T.ℓstar))))| ≤
          C_decay * (landingTubeContraction T) ^ t := by
  obtain ⟨C_spatial, hC_spatial_nonneg, h_spatial⟩ := hTrans.h_dobrushin_spatial_decay
  obtain ⟨hq0, _, _⟩ := landingTube_contraction_and_transferGapRate_pos T
  set q := landingTubeContraction T
  set M_f : ℝ :=
    2 * (((F.reflect.loops.map (fun ℓ => (ℓ.latticeLoop (T.ℓstar : ℝ)).length)).sum : ℕ) : ℝ)
  have hMf_nonneg : 0 ≤ M_f := mul_nonneg (by norm_num) (Nat.cast_nonneg _)
  refine ⟨M_f * 2 * C_spatial,
    mul_nonneg (mul_nonneg hMf_nonneg (by norm_num)) hC_spatial_nonneg, fun t => ?_⟩
  filter_upwards [T.landed_gibbsMeasure_abs_irCov_le_dobrushinObservableComparison,
    T.eventually_loop_support_timeShift_sep hFpos t,
    h_spatial t] with n h_cov h_sep h_sp
  let f_obs := irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect
  let g_obs :=
    irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) (F.translate (timeShift (t * T.ℓstar)))
  let supp_f := physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ) F.reflect.loops
  let supp_g :=
    physicalLoopListSupport (T.irSide n) (T.ℓstar : ℝ)
      (F.translate (timeShift (t * T.ℓstar))).loops
  have hf_meas : Measurable f_obs :=
    (continuous_irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ) F.reflect).measurable
  have hg_meas : Measurable g_obs :=
    (continuous_irLoopFamilyObservable (T.irSide n) (T.ℓstar : ℝ)
      (F.translate (timeShift (t * T.ℓstar)))).measurable
  have hf_bdd : ∀ V : GaugeConfig (T.irSide n), |f_obs V| ≤ 1 :=
    abs_irLoopFamilyObservable_le_one (T.irSide n) (T.ℓstar : ℝ) F.reflect
  have hg_bdd : ∀ V : GaugeConfig (T.irSide n), |g_obs V| ≤ 1 :=
    abs_irLoopFamilyObservable_le_one (T.irSide n) (T.ℓstar : ℝ)
      (F.translate (timeShift (t * T.ℓstar)))
  have h_cov_fg := h_cov f_obs g_obs hf_meas hf_bdd hg_meas hg_bdd
  have h_dob :=
    dobrushinObservableComparison_le_of_series_bound
      SU2 (dobrushinSupMatrix SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      (M_g := 2) (B_series := C_spatial * q ^ t) (by norm_num)
      (dobrushinSupMatrix_nonneg SU2 (T.irSide n) ((T.chain n).state 0).totalAction)
      f_obs g_obs supp_f supp_g
      (fun e he =>
        linkOscillation_irLoopFamilyObservable_eq_zero_of_not_mem (T.ℓstar : ℝ) F.reflect he)
      (fun e' he' =>
        linkOscillation_irLoopFamilyObservable_eq_zero_of_not_mem (T.ℓstar : ℝ)
          (F.translate (timeShift (t * T.ℓstar))) he')
      (fun e' _ =>
        linkOscillation_irLoopFamilyObservable_le_two (T.irSide n) (T.ℓstar : ℝ)
          (F.translate (timeShift (t * T.ℓstar))) e')
      (fun e he => h_sp e supp_g fun e' he' => (h_sep e he e' he').1)
  have hf_sum :
      ∑ e ∈ supp_f, linkOscillation SU2 (T.irSide n) f_obs e ≤ M_f :=
    sum_linkOscillation_irLoopFamilyObservable_le (T.irSide n) (T.ℓstar : ℝ) F.reflect
  have hB_nonneg : 0 ≤ C_spatial * q ^ t :=
    mul_nonneg hC_spatial_nonneg (pow_nonneg hq0.le t)
  have h_prod_le :
      (∑ e ∈ supp_f, linkOscillation SU2 (T.irSide n) f_obs e) * 2 * (C_spatial * q ^ t) ≤
        (M_f * 2 * C_spatial) * q ^ t := by
    calc
      (∑ e ∈ supp_f, linkOscillation SU2 (T.irSide n) f_obs e) * 2 * (C_spatial * q ^ t)
        ≤ M_f * 2 * (C_spatial * q ^ t) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right hf_sum (by norm_num)) hB_nonneg
      _ = (M_f * 2 * C_spatial) * q ^ t := by ring
  linarith

/-- Non-circularity negative control: any cutoff trajectory along which every loop renormalization
`Z` has non-positive reflected connected self-correlators eventually (including zero-coupling
factorized limits and deterministic constant laws) refutes `QYMSchwingerGap P`. -/
theorem not_qymSchwingerGap_of_zero_reflectedConnected (P : ContinuumCutoffPath)
    (h_nonpos : ∀ (Z : LoopRenormalization P.toCutoffPath) (F : DisjointLoopFamily),
      F.PositiveTime → ∀ᶠ n in atTop, reflectedConnected Z n F F ≤ 0) :
    ¬ QYMSchwingerGap P := by
  rintro ⟨Z, _, _, _, _, _, _, _, _, _, _, _, _, _, ⟨F, c, hFpos, hc, hfl⟩⟩
  obtain ⟨n, hle, hnp⟩ := (hfl.and (h_nonpos Z F hFpos)).exists
  linarith

/-- Dimension-four local lattice field-strength-squared composite observable
`(β_n / a_n^4) * plaquetteAction U p` along an arbitrary cutoff path `P : CutoffPath`. -/
noncomputable def localFieldStrengthSqOnCutoffPath (P : CutoffPath) (n : ℕ)
    (p : Plaquette (P.side n)) (U : GaugeConfig (P.side n)) : ℝ :=
  (P.coupling n / (P.spacing n) ^ 4) * plaquetteAction U p

/-- Dimension-four local lattice field-strength-squared composite observable
`(β_n / a_n^4) * plaquetteAction U p` at plaquette `p : Plaquette (P.side n)`. -/
noncomputable def localFieldStrengthSq (P : ContinuumCutoffPath) (n : ℕ)
    (p : Plaquette (P.side n)) (U : GaugeConfig (P.side n)) : ℝ :=
  localFieldStrengthSqOnCutoffPath P.toCutoffPath n p U

/-- Osterwalder–Schrader factorial / linear-growth regularity bound on a continuum Schwinger
functional `S : DisjointLoopFamily → ℝ` (`|S F| ≤ C_os ^ |F| * |F|!`), ensuring distributional
reconstruction of Wightman / OS fields. -/
def OSLinearGrowthBound (S : DisjointLoopFamily → ℝ) : Prop :=
  ∃ C_os : ℝ, 0 < C_os ∧
    ∀ F : DisjointLoopFamily,
      |S F| ≤ C_os ^ F.loops.length * (Nat.factorial F.loops.length : ℝ)

/-- Finite-cutoff connected four-loop Ursell cumulant `schwingerFourLoopUrsell Z n ℓ₁ ℓ₂ ℓ₃ ℓ₄`
of four physical Wilson loops under the renormalized Wilson measure `P.configLaw n`, defined by
subtracting all three Gaussian Wick pairings and the two-and-one-loop disconnected products from
`renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₂, ℓ₃, ℓ₄]⟩`. Vanishes identically for every Gaussian or
deterministic constant limit law. -/
noncomputable def schwingerFourLoopUrsell {P : CutoffPath} (Z : LoopRenormalization P) (n : ℕ)
    (ℓ₁ ℓ₂ ℓ₃ ℓ₄ : PhysicalRectangle) : ℝ :=
  let s1 := renormalizedSchwinger Z n ⟨[ℓ₁]⟩
  let s2 := renormalizedSchwinger Z n ⟨[ℓ₂]⟩
  let s3 := renormalizedSchwinger Z n ⟨[ℓ₃]⟩
  let s4 := renormalizedSchwinger Z n ⟨[ℓ₄]⟩
  let s12 := renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₂]⟩
  let s13 := renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₃]⟩
  let s14 := renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₄]⟩
  let s23 := renormalizedSchwinger Z n ⟨[ℓ₂, ℓ₃]⟩
  let s24 := renormalizedSchwinger Z n ⟨[ℓ₂, ℓ₄]⟩
  let s34 := renormalizedSchwinger Z n ⟨[ℓ₃, ℓ₄]⟩
  let s123 := renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₂, ℓ₃]⟩
  let s124 := renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₂, ℓ₄]⟩
  let s134 := renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₃, ℓ₄]⟩
  let s234 := renormalizedSchwinger Z n ⟨[ℓ₂, ℓ₃, ℓ₄]⟩
  let s1234 := renormalizedSchwinger Z n ⟨[ℓ₁, ℓ₂, ℓ₃, ℓ₄]⟩
  s1234
    - (s123 * s4 + s124 * s3 + s134 * s2 + s234 * s1)
    - (s12 * s34 + s13 * s24 + s14 * s23)
    + 2 * (s12 * s3 * s4 + s13 * s2 * s4 + s14 * s2 * s3 +
           s23 * s1 * s4 + s24 * s1 * s3 + s34 * s1 * s2)
    - 6 * (s1 * s2 * s3 * s4)

/-- Cutoff-path-level local-field and short-distance package on `P : CutoffPath` at one-loop
coefficient `beta0 : ℝ` and renormalization scheme `Z : LoopRenormalization P` (defined on
`CutoffPath` so zero-coupling paths `P.coupling n = 0` are consistent and non-vacuously refuted). -/
structure LocalFieldsAndShortDistanceOnCutoffPath (P : CutoffPath) (beta0 : ℝ)
    (Z : LoopRenormalization P) : Prop where
  h_perimeter_corner :
    ∃ m c : ℕ → ℝ,
      Z = YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P m c
  h_schwinger_cauchy : RenormalizedLoopCauchy Z
  h_os_linear_growth :
    ∀ S : DisjointLoopFamily → ℝ,
      (∀ F, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F))) →
        OSLinearGrowthBound S
  h_field_strength_pos :
    ∃ c_fs : ℝ, 0 < c_fs ∧
      ∀ᶠ n in atTop, ∀ p : Plaquette (P.side n),
        c_fs ≤ ∫ U, localFieldStrengthSqOnCutoffPath P n p U
          ∂(P.configLaw n : Measure (GaugeConfig (P.side n)))
  h_non_gaussian_ursell :
    ∃ (ℓ₁ ℓ₂ ℓ₃ ℓ₄ : PhysicalRectangle) (c_ursell : ℝ),
      ℓ₁.IsPositiveTime ∧ ℓ₂.IsPositiveTime ∧ ℓ₃.IsPositiveTime ∧ ℓ₄.IsPositiveTime ∧
      0 < c_ursell ∧
      ∀ᶠ n in atTop, c_ursell ≤ |schwingerFourLoopUrsell Z n ℓ₁ ℓ₂ ℓ₃ ℓ₄|
  h_short_distance_correlator :
    ∃ (ℓ_uv : ℕ → PhysicalRectangle) (c_uv_lo c_uv_hi : ℝ),
      (∀ k : ℕ, (ℓ_uv k).IsPositiveTime) ∧
      (∀ k : ℕ, ((ℓ_uv k).sideμ + (ℓ_uv k).sideν : ℚ) ≤ (1 / 4 : ℚ) * (1 / 2 : ℚ) ^ k) ∧
      Tendsto (fun k : ℕ => (((ℓ_uv k).sideμ + (ℓ_uv k).sideν : ℚ) : ℝ)) atTop (𝓝 0) ∧
      0 < c_uv_lo ∧ c_uv_lo ≤ c_uv_hi ∧
      ∀ k : ℕ, ∀ᶠ n in atTop,
        (c_uv_lo * beta0) / Real.log ((k : ℝ) + 2) ≤
          reflectedConnected Z n ⟨[ℓ_uv k]⟩
            ⟨[(ℓ_uv k).translate (timeShift ((1 / 2 : ℚ) ^ k))]⟩ ∧
        reflectedConnected Z n ⟨[ℓ_uv k]⟩
            ⟨[(ℓ_uv k).translate (timeShift ((1 / 2 : ℚ) ^ k))]⟩ ≤
          (c_uv_hi * beta0) / Real.log ((k : ℝ) + 2)

/-- Gap 7 (H2) perimeter-corner renormalization scheme, Osterwalder–Schrader linear-growth bound,
non-Gaussian four-loop Ursell cumulant lower bound, composite `localFieldStrengthSq` (`tr F²`)
positivity, and two-sided short-distance asymptotic-freedom correlator sandwich at shrinking
separation `(1 / 2) ^ k` tied to `P.beta0` and `P.coupling n` on the actual Wilson measure
`P.configLaw n`. -/
structure LocalFieldsAndShortDistance {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) : Prop where
  h_perimeter_corner :
    ∃ m c : ℕ → ℝ,
      Z = YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m c
  h_schwinger_cauchy : RenormalizedLoopCauchy Z
  h_os_linear_growth :
    ∀ S : DisjointLoopFamily → ℝ,
      (∀ F, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F))) →
        OSLinearGrowthBound S
  h_field_strength_pos :
    ∃ c_fs : ℝ, 0 < c_fs ∧
      ∀ᶠ n in atTop, ∀ p : Plaquette (P.side n),
        c_fs ≤ ∫ U, localFieldStrengthSq P n p U ∂(P.configLaw n : Measure (GaugeConfig (P.side n)))
  h_non_gaussian_ursell :
    ∃ (ℓ₁ ℓ₂ ℓ₃ ℓ₄ : PhysicalRectangle) (c_ursell : ℝ),
      ℓ₁.IsPositiveTime ∧ ℓ₂.IsPositiveTime ∧ ℓ₃.IsPositiveTime ∧ ℓ₄.IsPositiveTime ∧
      0 < c_ursell ∧
      ∀ᶠ n in atTop, c_ursell ≤ |schwingerFourLoopUrsell Z n ℓ₁ ℓ₂ ℓ₃ ℓ₄|
  h_short_distance_correlator :
    ∃ (ℓ_uv : ℕ → PhysicalRectangle) (c_uv_lo c_uv_hi : ℝ),
      (∀ k : ℕ, (ℓ_uv k).IsPositiveTime) ∧
      (∀ k : ℕ, ((ℓ_uv k).sideμ + (ℓ_uv k).sideν : ℚ) ≤ (1 / 4 : ℚ) * (1 / 2 : ℚ) ^ k) ∧
      Tendsto (fun k : ℕ => (((ℓ_uv k).sideμ + (ℓ_uv k).sideν : ℚ) : ℝ)) atTop (𝓝 0) ∧
      0 < c_uv_lo ∧ c_uv_lo ≤ c_uv_hi ∧
      ∀ k : ℕ, ∀ᶠ n in atTop,
        (c_uv_lo * P.beta0) / Real.log ((k : ℝ) + 2) ≤
          reflectedConnected Z n ⟨[ℓ_uv k]⟩
            ⟨[(ℓ_uv k).translate (timeShift ((1 / 2 : ℚ) ^ k))]⟩ ∧
        reflectedConnected Z n ⟨[ℓ_uv k]⟩
            ⟨[(ℓ_uv k).translate (timeShift ((1 / 2 : ℚ) ^ k))]⟩ ≤
          (c_uv_hi * P.beta0) / Real.log ((k : ℝ) + 2)

/-- Equivalence between `LocalFieldsAndShortDistance Z` on `P : ContinuumCutoffPath` and
`LocalFieldsAndShortDistanceOnCutoffPath P.toCutoffPath P.beta0 Z`. -/
theorem localFieldsAndShortDistance_iff_onCutoffPath
    {P : ContinuumCutoffPath} (Z : LoopRenormalization P.toCutoffPath) :
    LocalFieldsAndShortDistance Z ↔
      LocalFieldsAndShortDistanceOnCutoffPath P.toCutoffPath P.beta0 Z :=
  ⟨fun h => ⟨h.1, h.2, h.3, h.4, h.5, h.6⟩, fun h => ⟨h.1, h.2, h.3, h.4, h.5, h.6⟩⟩

/-- Any renormalization scheme `Z` whose four-loop connected Ursell cumulants vanish eventually
(including every constant, factorized, or Gaussian Wick limit) cannot satisfy
`LocalFieldsAndShortDistance Z`. -/
theorem not_localFieldsAndShortDistance_of_vanishing_ursell
    {P : ContinuumCutoffPath} {Z : LoopRenormalization P.toCutoffPath}
    (h_vanish : ∀ ℓ₁ ℓ₂ ℓ₃ ℓ₄ : PhysicalRectangle,
      ∀ᶠ n in atTop, schwingerFourLoopUrsell Z n ℓ₁ ℓ₂ ℓ₃ ℓ₄ = 0) :
    ¬ LocalFieldsAndShortDistance Z := by
  intro hL
  obtain ⟨ℓ₁, ℓ₂, ℓ₃, ℓ₄, c, _, _, _, _, hc, hfl⟩ := hL.h_non_gaussian_ursell
  obtain ⟨n, hle, hz⟩ := (hfl.and (h_vanish ℓ₁ ℓ₂ ℓ₃ ℓ₄)).exists
  rw [hz, abs_zero] at hle
  linarith

/-- On any `P : CutoffPath` whose bare coupling `P.coupling n` vanishes eventually,
`localFieldStrengthSqOnCutoffPath P n p` vanishes identically and refutes
`LocalFieldsAndShortDistanceOnCutoffPath P beta0 Z` (with no `coupling_tendsto_atTop` hypothesis). -/
theorem not_localFieldsAndShortDistanceOnCutoffPath_of_zero_coupling
    {P : CutoffPath} {beta0 : ℝ} {Z : LoopRenormalization P}
    (h_zero : ∀ᶠ n in atTop, P.coupling n = 0) :
    ¬ LocalFieldsAndShortDistanceOnCutoffPath P beta0 Z := by
  intro hL
  obtain ⟨c_fs, hc_fs, hfs⟩ := hL.h_field_strength_pos
  obtain ⟨n, hle, hβ0⟩ := (hfs.and h_zero).exists
  have p0 : Plaquette (P.side n) := ⟨0, 0, 1, by decide⟩
  have hp0 := hle p0
  have hint0 :
      (∫ U, localFieldStrengthSqOnCutoffPath P n p0 U
        ∂(P.configLaw n : Measure (GaugeConfig (P.side n)))) = 0 := by
    simp [localFieldStrengthSqOnCutoffPath, hβ0]
  linarith

/-- Canonical zero-coupling cutoff path `zeroCouplingCutoffPath : CutoffPath` with `side n = n + 1`,
`spacing n = 1 / (n + 1)`, and `coupling n = 0` (consistent inhabitant of `CutoffPath`). -/
noncomputable def zeroCouplingCutoffPath : CutoffPath where
  side n := n + 1
  spacing n := 1 / ((n : ℝ) + 1)
  coupling _ := 0
  side_pos n := Nat.succ_pos n
  spacing_pos n := one_div_pos.mpr (by positivity)
  coupling_nonneg _ := le_rfl

/-- Unconditional zero-coupling negative control on the inhabited `zeroCouplingCutoffPath`: for
every `beta0 : ℝ` and every renormalization scheme `Z : LoopRenormalization zeroCouplingCutoffPath`,
`¬ LocalFieldsAndShortDistanceOnCutoffPath zeroCouplingCutoffPath beta0 Z` holds with zero
contradictory hypotheses. -/
theorem not_localFieldsAndShortDistanceOnCutoffPath_zeroCouplingCutoffPath
    (beta0 : ℝ) (Z : LoopRenormalization zeroCouplingCutoffPath) :
    ¬ LocalFieldsAndShortDistanceOnCutoffPath zeroCouplingCutoffPath beta0 Z :=
  not_localFieldsAndShortDistanceOnCutoffPath_of_zero_coupling (Eventually.of_forall fun _ => rfl)

/-- Corollary on `ContinuumCutoffPath` via `localFieldsAndShortDistance_iff_onCutoffPath`. -/
theorem not_localFieldsAndShortDistance_of_zero_coupling
    {P : ContinuumCutoffPath} {Z : LoopRenormalization P.toCutoffPath}
    (h_zero : ∀ᶠ n in atTop, P.coupling n = 0) :
    ¬ LocalFieldsAndShortDistance Z := fun hL =>
  not_localFieldsAndShortDistanceOnCutoffPath_of_zero_coupling h_zero
    ((localFieldsAndShortDistance_iff_onCutoffPath Z).mp hL)

/-- Holonomy of a single oriented lattice step `s : LatticeStep` starting at `x : Lattice4D L`
for a gauge configuration `U : GroupGaugeConfig G L` valued in an arbitrary gauge group `G`. -/
def groupStepHolonomy {G : Type*} [Group G] {L : ℕ}
    (U : GroupGaugeConfig G L) (x : Lattice4D L) : LatticeStep → G
  | ⟨μ, true⟩ => U ⟨x, μ⟩
  | ⟨μ, false⟩ => (U ⟨x - unitVec L μ, μ⟩)⁻¹

/-- Ordered product holonomy in `G` along a lattice path `p : List LatticeStep` starting at `x`. -/
def groupPathHolonomy {G : Type*} [Group G] {L : ℕ}
    (U : GroupGaugeConfig G L) (x : Lattice4D L) : List LatticeStep → G
  | [] => 1
  | s :: p => groupStepHolonomy U x s * groupPathHolonomy U (stepTarget x s) p

/-- Physical-scale rectangular Wilson loop observable `tr.normReTrace (groupPathHolonomy U ...)`
on `GroupGaugeConfig G L` at lattice spacing `a` for a general gauge group `G` and class trace `tr`. -/
def groupPhysicalWilsonLoop {G : Type*} [Group G] [TopologicalSpace G]
    (tr : CompactGaugeClassTrace G) (L : ℕ) (a : ℝ) (ℓ : PhysicalRectangle)
    (U : GroupGaugeConfig G L) : ℝ :=
  tr.normReTrace (groupPathHolonomy U (latticeSite L (ℓ.latticeBase a)) (ℓ.latticeLoop a))

/-- Product of renormalized physical `G`-Wilson loops in `F : DisjointLoopFamily` at cutoff `n`. -/
def groupLoopFamilyEval {G : Type*} [Group G] [TopologicalSpace G]
    (tr : CompactGaugeClassTrace G) {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (F : DisjointLoopFamily) (U : GroupGaugeConfig G (P.side n)) : ℝ :=
  (F.loops.map (fun ℓ =>
    Z.factor n ℓ * groupPhysicalWilsonLoop tr (P.side n) (P.spacing n) ℓ U)).prod

/-- Finite-cutoff renormalized multi-loop Schwinger function for gauge group `G` and class trace
`tr`, integrated with respect to the actual `G`-Wilson measure
`groupWilsonMeasure G (P.side n) tr (P.coupling n)`. -/
noncomputable def groupRenormalizedSchwinger (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    (tr : CompactGaugeClassTrace G) {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (F : DisjointLoopFamily) : ℝ :=
  ∫ U, groupLoopFamilyEval tr Z n F U
    ∂(groupWilsonMeasure G (P.side n) tr (P.coupling n))

/-- Reflected connected Schwinger correlator for gauge group `G` and class trace `tr` at cutoff
`n` under `groupWilsonMeasure G (P.side n) tr (P.coupling n)`. -/
noncomputable def groupReflectedConnected (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    (tr : CompactGaugeClassTrace G) {P : CutoffPath} (Z : LoopRenormalization P)
    (n : ℕ) (F H : DisjointLoopFamily) : ℝ :=
  (∫ U, groupLoopFamilyEval tr Z n F.reflect U * groupLoopFamilyEval tr Z n H U
    ∂(groupWilsonMeasure G (P.side n) tr (P.coupling n))) -
    groupRenormalizedSchwinger G tr Z n F.reflect * groupRenormalizedSchwinger G tr Z n H

/-- Predicate characterizing a compact simple topological gauge group `G`:
1. `G` is connected (`ConnectedSpace G`),
2. `G` is non-abelian (`∃ g h : G, g * h ≠ h * g`, ruling out `U(1)` and all abelian tori), and
3. Every proper closed normal subgroup `N : Subgroup G` is central (`N ≠ ⊤ → IsClosed (N : Set G) → N.Normal → ∀ n ∈ N, ∀ g : G, n * g = g * n`, ruling out reducible direct products). -/
structure IsCompactSimpleGaugeGroup (G : Type*) [Group G] [TopologicalSpace G] : Prop where
  h_connected : ConnectedSpace G
  h_nonabelian : ∃ g h : G, g * h ≠ h * g
  h_closed_normal_central :
    ∀ N : Subgroup G, N ≠ ⊤ → IsClosed (N : Set G) → N.Normal →
      ∀ n ∈ N, ∀ g : G, n * g = g * n

/-- No commutative group (such as `U(1)`) can satisfy `IsCompactSimpleGaugeGroup`. -/
theorem not_isCompactSimpleGaugeGroup_of_commGroup (G : Type*) [CommGroup G] [TopologicalSpace G] :
    ¬ IsCompactSimpleGaugeGroup G := by
  intro hG
  obtain ⟨g, h, hne⟩ := hG.h_nonabelian
  exact hne (mul_comm g h)

/-- Continuum cutoff path for a general compact simple gauge group `G` with dual-Coxeter
one-loop asymptotic-freedom coefficient `c_beta0 > 0`:
`spacing n → 0`, `side n * spacing n → ∞`, and `coupling n / log (1 / spacing n) → c_beta0`. -/
structure GroupContinuumCutoffPath (c_beta0 : ℝ) extends CutoffPath where
  hc_beta0 : 0 < c_beta0
  spacing_tendsto_zero : Tendsto spacing atTop (𝓝 0)
  physicalSide_tendsto_atTop : Tendsto (fun n => (side n : ℝ) * spacing n) atTop atTop
  coupling_asymptoticFreedom :
    Tendsto (fun n => coupling n / Real.log (1 / spacing n)) atTop (𝓝 c_beta0)

/-- Along every `GroupContinuumCutoffPath c_beta0`, the bare coupling `coupling n` diverges to
`+∞` as `spacing n → 0`. -/
theorem GroupContinuumCutoffPath.coupling_tendsto_atTop {c_beta0 : ℝ}
    (P : GroupContinuumCutoffPath c_beta0) :
    Tendsto P.coupling atTop atTop := by
  have hlog : Tendsto (fun n => Real.log (1 / P.spacing n)) atTop atTop := by
    have h0 : Tendsto P.spacing atTop (𝓝[>] 0) :=
      tendsto_nhdsWithin_iff.mpr ⟨P.spacing_tendsto_zero, Eventually.of_forall P.spacing_pos⟩
    have hinv : Tendsto (fun n => (P.spacing n)⁻¹) atTop atTop :=
      tendsto_inv_nhdsGT_zero.comp h0
    have hfun : (fun n => Real.log (1 / P.spacing n)) = Real.log ∘ fun n => (P.spacing n)⁻¹ := by
      funext n
      simp only [Function.comp_apply, one_div]
    rw [hfun]
    exact Real.tendsto_log_atTop.comp hinv
  have hmul := Tendsto.pos_mul_atTop P.hc_beta0 P.coupling_asymptoticFreedom hlog
  refine hmul.congr' ?_
  filter_upwards [hlog.eventually (eventually_gt_atTop 0)] with n hn
  exact div_mul_cancel₀ (P.coupling n) hn.ne'

/-- Faithful finite-dimensional continuous unitary representation
`ρ : G →* Matrix.unitaryGroup (Fin N) ℂ` of a compact topological gauge group `G`
(Peter–Weyl embedding input for matrix character and small-field expansions). -/
structure FaithfulUnitaryRep (G : Type*) [Group G] [TopologicalSpace G] (N : ℕ) [NeZero N] where
  ρ : G →* Matrix.unitaryGroup (Fin N) ℂ
  h_cont : Continuous ρ
  h_inj : Function.Injective ρ

/-- Canonical normalized class trace `(1 / N) Re Tr(rep.ρ g)` on `G` induced by a faithful
continuous unitary representation `rep : FaithfulUnitaryRep G N` via `pullbackCompactGaugeClassTrace`. -/
def FaithfulUnitaryRep.classTrace {G : Type*} [Group G] [TopologicalSpace G]
    {N : ℕ} [NeZero N] (rep : FaithfulUnitaryRep G N) : CompactGaugeClassTrace G :=
  pullbackCompactGaugeClassTrace (unitaryCompactGaugeClassTrace N) rep.ρ rep.h_cont

/-- Schwinger-level continuum existence and positive mass gap along a cutoff path `P : CutoffPath`
for a compact simple gauge group `G` and faithful class trace `tr : CompactGaugeClassTrace G`,
evaluated on the actual `G`-Wilson measure `groupWilsonMeasure G (P.side n) tr (P.coupling n)`. -/
def GroupQYMSchwingerGapOnCutoffPath (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    (tr : CompactGaugeClassTrace G) (P : CutoffPath) : Prop :=
  ∃ (Z : LoopRenormalization P) (S : DisjointLoopFamily → ℝ)
    (s : ℚ) (q m : ℝ),
    0 < s ∧ 0 < q ∧ q < 1 ∧ m = transferGapRate s q ∧ 0 < m ∧
    (∀ F, Tendsto (fun n => groupRenormalizedSchwinger G tr Z n F) atTop (𝓝 (S F))) ∧
    (∀ F : DisjointLoopFamily, F.PositiveTime → ∀ᶠ n in atTop, 0 ≤ groupReflectedConnected G tr Z n F F) ∧
    SchwingerEuclideanInvariant S ∧
    (∀ F : DisjointLoopFamily, F.PositiveTime → ∃ C : ℝ, ∀ t : ℕ, ∀ᶠ n in atTop,
      groupReflectedConnected G tr Z n F (F.translate (timeShift (t * s))) ≤ C * q ^ t) ∧
    (∃ (F : DisjointLoopFamily) (c : ℝ), F.PositiveTime ∧ 0 < c ∧
      ∀ᶠ n in atTop, c ≤ groupReflectedConnected G tr Z n F F)

/-- Schwinger-level continuum existence and positive mass gap along a continuum cutoff path `P`
for a compact simple gauge group `G` and faithful class trace `tr : CompactGaugeClassTrace G`,
evaluated on the actual `G`-Wilson measure `groupWilsonMeasure G (P.side n) tr (P.coupling n)`. -/
def GroupQYMSchwingerGap (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    (tr : CompactGaugeClassTrace G) (P : ContinuumCutoffPath) : Prop :=
  GroupQYMSchwingerGapOnCutoffPath G tr P.toCutoffPath

/-- Gap 6 (H3) universal Clay statement across all compact simple gauge groups `G` equipped with
a faithful finite-dimensional unitary representation `rep : FaithfulUnitaryRep G N` (inducing the
canonical normalized representation trace `rep.classTrace : CompactGaugeClassTrace G`) and
group-specific dual-Coxeter one-loop asymptotic-freedom coefficient `c_beta0 > 0`, concluding
`GroupQYMSchwingerGapOnCutoffPath G rep.classTrace P_G.toCutoffPath` along a
`GroupContinuumCutoffPath c_beta0` and `GroupQYMSchwingerGap G rep.classTrace P` along a
`ContinuumCutoffPath` with `P.beta0 = c_beta0`. -/
def AllCompactSimpleQYM : Prop :=
  ∀ (G : Type) [Group G] [TopologicalSpace G] [SecondCountableTopology G]
    [IsTopologicalGroup G] [T2Space G] [CompactSpace G] [MeasurableSpace G] [BorelSpace G]
    (_hSimple : IsCompactSimpleGaugeGroup G)
    {N : ℕ} [NeZero N] (rep : FaithfulUnitaryRep G N)
    {c_beta0 : ℝ} (_hc_beta0 : 0 < c_beta0),
    (∀ g : G, rep.classTrace.normReTrace g = 1 ↔ g = 1) →
    (∃ P_G : GroupContinuumCutoffPath c_beta0,
      GroupQYMSchwingerGapOnCutoffPath G rep.classTrace P_G.toCutoffPath) ∧
    ∃ P : ContinuumCutoffPath, P.beta0 = c_beta0 ∧ GroupQYMSchwingerGap G rep.classTrace P

/-! ### Bucket A.3 & Bucket B.1–B.4: Abstract Smoothing Block Kernel, Inductive Balaban Polymer Contraction, Rational Interval-Arithmetic Crossover Certificate, and Rotated-Lattice `SO(4)` Uniqueness -/

/-- Exact `K`-step renormalization-group chain parameterized by an arbitrary conditional block
probability disintegration family `dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)`,
generalizing `MultiStepHaarRGChain` from raw decimation (`haarBlockDisintegration`) to any
gauge-covariant smoothing block kernel (such as Balaban axial-gauge block averaging or Wilson
gradient flow). -/
structure AbstractBlockKernelChain (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ)
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) where
  state : ∀ m : ℕ, InteractingEffectiveActionState (dyadicScaleSide L_ir m)
  ε_trunc : ∀ m : ℕ, GaugeConfig (dyadicScaleSide L_ir m) → ℝ
  h_uv : state K = InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir K) β_uv
  h_β_nonneg : ∀ m ≤ K, 0 ≤ (state m).β
  h_ε_nonneg : ∀ m < K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m), 0 ≤ ε_trunc m V
  h_R_trunc_le : ∀ m < K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m),
    |((state m).R_trunc V)| ≤ ε_trunc m V
  h_step_exact : ∀ m < K, ∀ V : GaugeConfig (dyadicScaleSide L_ir m),
    (state m).totalAction V =
      (state (m + 1)).c_vac +
        interactingBlockedEffectiveAction
          (dis m)
          (state (m + 1)).β
          (fun U => (state (m + 1)).polymers.eval U + (state (m + 1)).R_trunc U) V

/-- Canonical `j`-step downward RG state for an arbitrary smoothing block disintegration family `dis`,
extracting the coarse Wilson coupling via `canonicalHaarProbeExtractor` (`haarCanonicalNoncommutingProbe`)
at each coarse step `j + 1`. -/
noncomputable def canonicalAbstractRGStateAux (L_ir : ℕ) [NeZero L_ir] (β_uv : ℝ)
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) :
    ∀ (_j m : ℕ), InteractingEffectiveActionState (dyadicScaleSide L_ir m)
  | 0, m => InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv
  | j + 1, m =>
      let L_m := dyadicScaleSide L_ir m
      let st_prev := canonicalAbstractRGStateAux L_ir β_uv dis j (m + 1)
      let A_eff : GaugeConfig L_m → ℝ := fun V =>
        interactingBlockedEffectiveAction
          (dis m)
          st_prev.β
          (fun U => st_prev.polymers.eval U + st_prev.R_trunc U) V
      let A_norm : GaugeConfig L_m → ℝ := fun V => A_eff V - A_eff (vacuumConfig L_m)
      let β_next := max 0 (extractedCoarseCoupling (canonicalHaarProbeExtractor L_m) A_norm)
      { c_vac := st_prev.c_vac + A_eff (vacuumConfig L_m)
        β := β_next
        polymers := PolymerActivityFamily.empty L_m
        R_trunc := fun V => A_norm V - wilsonAction β_next V }

theorem canonicalAbstractRGStateAux_β_nonneg (L_ir : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) :
    ∀ (_j m : ℕ), 0 ≤ (canonicalAbstractRGStateAux L_ir β_uv dis _j m).β
  | 0, _ => hβ
  | _ + 1, _ => le_max_left 0 _

/-- Canonical `K`-step downward RG state family for an arbitrary smoothing disintegration family `dis`. -/
noncomputable def canonicalAbstractRGState (L_ir K : ℕ) [NeZero L_ir] (β_uv : ℝ)
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) (m : ℕ) :
    InteractingEffectiveActionState (dyadicScaleSide L_ir m) :=
  if m ≤ K then canonicalAbstractRGStateAux L_ir β_uv dis (K - m) m
  else InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) β_uv

/-- At zero bare coupling (`β_uv = 0`), every step `j` of `canonicalAbstractRGStateAux` remains
identically `InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0` for any
smoothing disintegration family `dis`. -/
theorem canonicalAbstractRGStateAux_zero (L_ir : ℕ) [NeZero L_ir]
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) :
    ∀ (j m : ℕ),
      canonicalAbstractRGStateAux L_ir 0 dis j m =
        InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0
  | 0, _ => rfl
  | j + 1, m => by
      dsimp [canonicalAbstractRGStateAux]
      rw [canonicalAbstractRGStateAux_zero L_ir dis j (m + 1)]
      dsimp [InteractingEffectiveActionState.pureWilson]
      have h0 :
          (fun U : GaugeConfig (2 * dyadicScaleSide L_ir m) =>
            (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0) =
          fun _ => 0 := by
        funext U
        simp [PolymerActivityFamily.eval_empty]
      have hA0 :
          (fun V : GaugeConfig (dyadicScaleSide L_ir m) =>
            interactingBlockedEffectiveAction
              (dis m)
              0
              (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0) V -
            interactingBlockedEffectiveAction
              (dis m)
              0
              (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0)
              (vacuumConfig (dyadicScaleSide L_ir m))) =
          fun _ => 0 := by
        funext V
        rw [h0, interactingBlockedEffectiveAction_zero, interactingBlockedEffectiveAction_zero,
          sub_self]
      have h_ext_zero :
          extractedCoarseCoupling (canonicalHaarProbeExtractor (dyadicScaleSide L_ir m))
            (fun V =>
              interactingBlockedEffectiveAction
                (dis m)
                0
                (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0) V -
              interactingBlockedEffectiveAction
                (dis m)
                0
                (fun U => (PolymerActivityFamily.empty (2 * dyadicScaleSide L_ir m)).eval U + 0)
                (vacuumConfig (dyadicScaleSide L_ir m))) = 0 := by
        rw [hA0]
        exact (canonicalHaarProbeExtractor (dyadicScaleSide L_ir m)).proj_const_zero 0
      congr 1
      · rw [h0, interactingBlockedEffectiveAction_zero, add_zero]
      · rw [h_ext_zero, max_self]
      · funext V
        rw [h_ext_zero, max_self, h0, interactingBlockedEffectiveAction_zero,
          interactingBlockedEffectiveAction_zero]
        simp [wilsonAction]

/-- At zero bare coupling (`β_uv = 0`), `canonicalAbstractRGState L_ir K 0 dis m` equals
`InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0` for every smoothing kernel
family `dis` and all `K, m : ℕ`. -/
theorem canonicalAbstractRGState_zero (L_ir K : ℕ) [NeZero L_ir]
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) (m : ℕ) :
    canonicalAbstractRGState L_ir K 0 dis m =
      InteractingEffectiveActionState.pureWilson (dyadicScaleSide L_ir m) 0 := by
  unfold canonicalAbstractRGState
  split_ifs
  · exact canonicalAbstractRGStateAux_zero L_ir dis (K - m) m
  · rfl

/-- Unconditional zero-coupling (`β_uv = 0`) RG measure identity for any smoothing block kernel
family `dis`: the landed IR Gibbs measure of `canonicalAbstractRGState L_ir K 0 dis 0` is
identically `gaugeHaarMeasure L_ir` for every blocking depth `K : ℕ`. -/
theorem canonicalAbstractRGState_zero_gibbsMeasure_eq_gaugeHaarMeasure
    (L_ir K : ℕ) [NeZero L_ir]
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) :
    (canonicalAbstractRGState L_ir K 0 dis 0).gibbsMeasure = gaugeHaarMeasure L_ir := by
  rw [canonicalAbstractRGState_zero L_ir K dis 0]
  change (InteractingEffectiveActionState.pureWilson L_ir 0).gibbsMeasure = gaugeHaarMeasure L_ir
  rw [InteractingEffectiveActionState.gibbsMeasure_pureWilson_eq_wilsonMeasure, wilsonMeasure_zero]

/-- Every infrared lattice side `L_ir`, blocking depth `K`, bare UV coupling `β_uv ≥ 0`, and
smoothing block disintegration family `dis` admits a canonical inhabitant of
`AbstractBlockKernelChain L_ir K β_uv dis`. -/
theorem exists_abstractBlockKernelChain (L_ir K : ℕ) [NeZero L_ir] {β_uv : ℝ} (hβ : 0 ≤ β_uv)
    (dis : ∀ m : ℕ, ConditionalBlockFiberDisintegration (dyadicScaleSide L_ir m)) :
    Nonempty (AbstractBlockKernelChain L_ir K β_uv dis) := by
  refine ⟨{
    state := canonicalAbstractRGState L_ir K β_uv dis
    ε_trunc := fun m V => |((canonicalAbstractRGState L_ir K β_uv dis m).R_trunc V)|
    h_uv := by simp [canonicalAbstractRGState, canonicalAbstractRGStateAux]
    h_β_nonneg := fun m hm => by
      simp only [canonicalAbstractRGState, hm, ↓reduceIte]
      exact canonicalAbstractRGStateAux_β_nonneg L_ir hβ dis (K - m) m
    h_ε_nonneg := fun _ _ _ => abs_nonneg _
    h_R_trunc_le := fun _ _ _ => le_rfl
    h_step_exact := fun m hm V => by
      have hm_le : m ≤ K := Nat.le_of_lt hm
      have hm1_le : m + 1 ≤ K := hm
      have hsub : K - m = (K - (m + 1)) + 1 := by omega
      have h_lhs : canonicalAbstractRGState L_ir K β_uv dis m =
          canonicalAbstractRGStateAux L_ir β_uv dis ((K - (m + 1)) + 1) m := by
        simp only [canonicalAbstractRGState, hm_le, ↓reduceIte, hsub]
      have h_rhs : canonicalAbstractRGState L_ir K β_uv dis (m + 1) =
          canonicalAbstractRGStateAux L_ir β_uv dis (K - (m + 1)) (m + 1) := by
        simp only [canonicalAbstractRGState, hm1_le, ↓reduceIte]
      rw [h_lhs, h_rhs]
      dsimp [canonicalAbstractRGStateAux, InteractingEffectiveActionState.totalAction]
      rw [PolymerActivityFamily.eval_empty]
      ring }⟩

/-- Equivalence specialization: every `MultiStepHaarRGChain` is an `AbstractBlockKernelChain` for
`fun m => haarBlockDisintegration (dyadicScaleSide L_ir m)`. -/
def MultiStepHaarRGChain.toAbstractBlockKernelChain {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ}
    (C : MultiStepHaarRGChain L_ir K β_uv) :
    AbstractBlockKernelChain L_ir K β_uv (fun m => haarBlockDisintegration (dyadicScaleSide L_ir m)) where
  state := C.state
  ε_trunc := C.ε_trunc
  h_uv := C.h_uv
  h_β_nonneg := C.h_β_nonneg
  h_ε_nonneg := C.h_ε_nonneg
  h_R_trunc_le := C.h_R_trunc_le
  h_step_exact := C.h_step_exact

/-- Specialization of an `AbstractBlockKernelChain` at `haarBlockDisintegration` back to
`MultiStepHaarRGChain`. -/
def AbstractBlockKernelChain.toMultiStepHaarRGChain {L_ir K : ℕ} [NeZero L_ir] {β_uv : ℝ}
    (C : AbstractBlockKernelChain L_ir K β_uv (fun m => haarBlockDisintegration (dyadicScaleSide L_ir m))) :
    MultiStepHaarRGChain L_ir K β_uv where
  state := C.state
  ε_trunc := C.ε_trunc
  h_uv := C.h_uv
  h_β_nonneg := C.h_β_nonneg
  h_ε_nonneg := C.h_ε_nonneg
  h_R_trunc_le := C.h_R_trunc_le
  h_step_exact := C.h_step_exact

/-- J2.0-verified polynomial normal-form identity for the inductive Balaban–Gawedzki–Kupiainen
polymer contraction step `(1 - θ) * (θ * E + ε) = θ * ((1 - θ) * E) + (1 - θ) * ε`. -/
theorem j20_balaban_inductive_step_identity (θ E ε : ℝ) :
    (1 - θ) * (θ * E + ε) = θ * ((1 - θ) * E) + (1 - θ) * ε := by
  ring

/-- Inductive Balaban–Gawedzki–Kupiainen polymer norm contraction across arbitrarily many RG steps
(uniform in blocking depth `K`): if a non-negative polymer norm sequence `η : ℕ → ℝ` satisfies the
single-step small-field + Peierls large-field contraction `η (k + 1) ≤ θ * η k + ε_step` with
`0 ≤ θ < 1` and UV initialization `η 0 ≤ ε_step / (1 - θ)`, then `η k ≤ ε_step / (1 - θ)` holds for
every RG step `k : ℕ`. -/
theorem inductive_balaban_polymer_contraction_uniform_in_K
    {θ ε_step : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ < 1)
    {η : ℕ → ℝ} (h_init : η 0 ≤ ε_step / (1 - θ))
    (h_step : ∀ k : ℕ, η (k + 1) ≤ θ * η k + ε_step) :
    ∀ k : ℕ, η k ≤ ε_step / (1 - θ)
  | 0 => h_init
  | k + 1 => by
      have ih := inductive_balaban_polymer_contraction_uniform_in_K hθ0 hθ1 h_init h_step k
      have h1_pos : 0 < 1 - θ := sub_pos.mpr hθ1
      have h1_ne : 1 - θ ≠ 0 := ne_of_gt h1_pos
      have h_mul : θ * η k ≤ θ * (ε_step / (1 - θ)) :=
        mul_le_mul_of_nonneg_left ih hθ0
      have h_fixed : θ * (ε_step / (1 - θ)) + ε_step = ε_step / (1 - θ) := by
        field_simp [h1_ne]
        ring
      linarith [h_step k]

/-- J2.0-verified polynomial normal-form identity for the Dobrushin–Shlosman crossover tube margin
`(18 * b + e + r) - (18 * b0 + e0 + r0) = 18 * (b - b0) + (e - e0) + (r - r0)`. -/
theorem j20_crossover_tube_margin_identity (b b0 e e0 r r0 : ℝ) :
    (18 * b + e + r) - (18 * b0 + e0 + r0) = 18 * (b - b0) + (e - e0) + (r - r0) := by
  ring

/-- Computer-assisted rational interval-arithmetic crossover certificate at physical block scale
`ℓstar : ℚ` along `P : ContinuumCutoffPath`: encloses the landed IR effective coupling, polymer
Dobrushin norm, truncation remainder, and physical Wilson loop covariance inside verified rational
bounds `(β_hi, η_hi, ε_hi, c_lo : ℚ)` satisfying `4 * (18 * (24 * β_hi) + η_hi + ε_hi) < 1` and `0 < c_lo`. -/
structure IntervalArithmeticCrossoverCertificate (P : ContinuumCutoffPath) where
  ℓstar : ℚ
  hℓstar : 0 < ℓstar
  K : ℕ → ℕ
  hK : ∀ᶠ n in atTop, P.spacing n * (2 : ℝ) ^ K n = (ℓstar : ℝ)
  irSide : ℕ → ℕ
  [instNeZeroIrSide : ∀ n : ℕ, NeZero (irSide n)]
  hside : ∀ᶠ n in atTop, P.side n = dyadicScaleSide (irSide n) (K n)
  chain : ∀ n : ℕ, MultiStepHaarRGChain (irSide n) (K n) (P.coupling n)
  β_hi : ℚ
  η_hi : ℚ
  ε_hi : ℚ
  c_lo : ℚ
  hc_lo_pos : 0 < c_lo
  h_rational_contraction : 4 * (18 * (24 * β_hi) + η_hi + ε_hi) < 1
  h_enclosure : ∀ᶠ n in atTop,
    ((chain n).state 0).β ≤ (β_hi : ℝ) ∧
    PolymerDobrushinNormBound ((chain n).state 0).polymers (η_hi : ℝ) ∧
    TruncationDobrushinNormBound ((chain n).state 0).R_trunc (ε_hi : ℝ)
  Z_tube : LoopRenormalization P.toCutoffPath
  hZ_tube_scheme :
    ∃ m c : ℕ → ℝ,
      Z_tube = YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m c
  h_cov_enclosure : ∀ᶠ n in atTop,
    (c_lo : ℝ) ≤
      |irCov ((chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (irSide n) (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar).timeReflect)
        (physicalWilsonLoop (irSide n) (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar))|

attribute [instance] IntervalArithmeticCrossoverCertificate.instNeZeroIrSide

/-- Canonical spatial probe `canonicalSpatialProbe C.ℓstar C.hℓstar` fixed by definition for any
`C : IntervalArithmeticCrossoverCertificate P`. -/
abbrev IntervalArithmeticCrossoverCertificate.ℓ_probe {P : ContinuumCutoffPath}
    (C : IntervalArithmeticCrossoverCertificate P) : PhysicalRectangle :=
  canonicalSpatialProbe C.ℓstar C.hℓstar

/-- Positive Euclidean time of `C.ℓ_probe`. -/
theorem IntervalArithmeticCrossoverCertificate.hℓ_probe_pos {P : ContinuumCutoffPath}
    (C : IntervalArithmeticCrossoverCertificate P) :
    C.ℓ_probe.IsPositiveTime :=
  canonicalSpatialProbe_isPositiveTime C.hℓstar

/-- Every verified `IntervalArithmeticCrossoverCertificate P` canonically inhabits `LandingTube P`. -/
def IntervalArithmeticCrossoverCertificate.toLandingTube {P : ContinuumCutoffPath}
    (C : IntervalArithmeticCrossoverCertificate P) : LandingTube P where
  ℓstar := C.ℓstar
  hℓstar := C.hℓstar
  K := C.K
  hK := C.hK
  irSide := C.irSide
  hside := C.hside
  chain := C.chain
  β_star := (C.β_hi : ℝ)
  η_star := (C.η_hi : ℝ)
  ε_star := (C.ε_hi : ℝ)
  h_land := by
    have hq : ((4 * (18 * (24 * C.β_hi) + C.η_hi + C.ε_hi) : ℚ) : ℝ) < (1 : ℝ) := by
      exact_mod_cast C.h_rational_contraction
    push_cast at hq
    exact hq
  h_tube := C.h_enclosure
  Z_tube := C.Z_tube
  hZ_tube_scheme := C.hZ_tube_scheme
  c_floor := (C.c_lo : ℝ)
  hc_floor := Rat.cast_pos.mpr C.hc_lo_pos
  h_floor := C.h_cov_enclosure

/-- Unconditional rational non-negativity `0 ≤ C.β_hi` derived from `C.toLandingTube.hβ_star_nonneg`. -/
theorem IntervalArithmeticCrossoverCertificate.hβ_hi_nonneg {P : ContinuumCutoffPath}
    (C : IntervalArithmeticCrossoverCertificate P) : 0 ≤ C.β_hi :=
  Rat.cast_nonneg.mp C.toLandingTube.hβ_star_nonneg

/-- Unconditional rational non-negativity `0 ≤ C.η_hi` derived from `C.toLandingTube.hη_star_nonneg`. -/
theorem IntervalArithmeticCrossoverCertificate.hη_hi_nonneg {P : ContinuumCutoffPath}
    (C : IntervalArithmeticCrossoverCertificate P) : 0 ≤ C.η_hi :=
  Rat.cast_nonneg.mp C.toLandingTube.hη_star_nonneg

/-- Unconditional rational non-negativity `0 ≤ C.ε_hi` derived from `C.toLandingTube.hε_star_nonneg`. -/
theorem IntervalArithmeticCrossoverCertificate.hε_hi_nonneg {P : ContinuumCutoffPath}
    (C : IntervalArithmeticCrossoverCertificate P) : 0 ≤ C.ε_hi :=
  Rat.cast_nonneg.mp C.toLandingTube.hε_star_nonneg

/-- VACUOUS-CONTROL (zero-coupling hypothesis `∀ᶠ n in atTop, P.coupling n = 0` is unsatisfiable
along any `ContinuumCutoffPath` by `ContinuumCutoffPath.coupling_tendsto_atTop`, `ROL:2008`):
Non-circularity negative control for `IntervalArithmeticCrossoverCertificate`: along any
zero-coupling canonical trajectory (`P.coupling n = 0` eventually), no valid rational
interval-arithmetic crossover certificate can exist. -/
theorem not_intervalArithmeticCrossoverCertificate_of_zero_coupling {P : ContinuumCutoffPath}
    (C : IntervalArithmeticCrossoverCertificate P)
    (h_zero_β : ∀ᶠ n in atTop, P.coupling n = 0)
    (h_canonical : ∀ᶠ n in atTop,
      (C.chain n).state 0 = canonicalRGState (C.irSide n) (C.K n) (P.coupling n) 0)
    (h_indep : ∀ n : ℕ,
      irCov (gaugeHaarMeasure (C.irSide n))
        (physicalWilsonLoop (C.irSide n) (C.ℓstar : ℝ) C.ℓ_probe.timeReflect)
        (physicalWilsonLoop (C.irSide n) (C.ℓstar : ℝ) C.ℓ_probe) = 0) :
    False :=
  not_landingTube_of_zero_coupling C.toLandingTube h_zero_β h_canonical h_indep

/-- Continuum limit agreement across translated and rotated/permuted lattice embeddings: for every
`F : DisjointLoopFamily`, `c : Fin 4 → ℚ`, and `σ : Equiv.Perm (Fin 4)`, both `renormalizedSchwinger Z n F`
and the transformed correlators `renormalizedSchwinger Z n (F.translate c)` and
`renormalizedSchwinger Z n (F.permute σ)` converge to the same continuum Schwinger functional `S F`. -/
structure RotatedLatticeContinuumUniqueness {P : ContinuumCutoffPath}
    (Z : LoopRenormalization P.toCutoffPath) (S : DisjointLoopFamily → ℝ) : Prop where
  h_limit :
    ∀ F : DisjointLoopFamily, Tendsto (fun n => renormalizedSchwinger Z n F) atTop (𝓝 (S F))
  h_translate_agree :
    ∀ (c : Fin 4 → ℚ) (F : DisjointLoopFamily),
      Tendsto (fun n => renormalizedSchwinger Z n (F.translate c)) atTop (𝓝 (S F))
  h_permute_agree :
    ∀ (σ : Equiv.Perm (Fin 4)) (F : DisjointLoopFamily),
      Tendsto (fun n => renormalizedSchwinger Z n (F.permute σ)) atTop (𝓝 (S F))

/-- Continuum limit uniqueness across translated and rotated/permuted lattice embeddings implies
`SchwingerEuclideanInvariant S` by uniqueness of limits in `ℝ`. -/
theorem schwingerEuclideanInvariant_of_rotatedLatticeContinuumUniqueness
    {P : ContinuumCutoffPath} {Z : LoopRenormalization P.toCutoffPath}
    {S : DisjointLoopFamily → ℝ}
    (hU : RotatedLatticeContinuumUniqueness Z S) :
    SchwingerEuclideanInvariant S := by
  intro c σ F
  exact ⟨tendsto_nhds_unique (hU.h_limit (F.translate c)) (hU.h_translate_agree c F),
    tendsto_nhds_unique (hU.h_limit (F.permute σ)) (hU.h_permute_agree σ F)⟩

/-! ### Canonical `norm_num`-Verified Rational Crossover Parameters & Inductive Step-to-Crossover Certificate Constructor -/

/-- Canonical rational upper bound `β_hi = 1 / (18 * 24 * 16)` on the landed IR effective Wilson coupling. -/
def canonicalCrossoverBetaHi : ℚ := 1 / (18 * 24 * 16)

/-- Canonical rational lower bound `β_lo = 1 / (2 * 18 * 24 * 16)` on the landed IR effective
Wilson coupling in the crossover window `[β_lo, β_hi]`. -/
def canonicalCrossoverBetaLo : ℚ := 1 / (2 * 18 * 24 * 16)

/-- Canonical rational upper bound `η_hi = 1 / 16` on the landed IR polymer Dobrushin norm,
matching the fixed point `(1 / 32) / (1 - 1 / 2) = 1 / 16` of the single-step Balaban contraction
with contraction factor `θ = 1 / 2` and step remainder `ε_step = 1 / 32`. -/
def canonicalCrossoverEtaHi : ℚ := 1 / 16

/-- Canonical rational upper bound `ε_hi = 1 / 16` on the landed IR truncation remainder. -/
def canonicalCrossoverEpsHi : ℚ := 1 / 16

/-- Canonical rational lower bound `c_lo = ((1 / 4) ^ 5 * β_lo ^ 4) / 2` on the landed IR
renormalized loop covariance, matching half the leading degree-4 (`d = 4` lateral plaquettes and
`5` independent `SU(2)` link integrals on the 6-face unit 3-cube) strong-coupling character
contribution `(1 / 4) ^ 5 * β ^ 4 = β ^ 4 / 1024` between unit plaquettes at `t = -1` and `t = 0`
for `β ∈ [canonicalCrossoverBetaLo, canonicalCrossoverBetaHi]`, and strictly below the single-link
center-twist upper bound `12 * β_lo ≤ exp(12 * β) - 1`. -/
def canonicalCrossoverCovLo : ℚ := 1 / (2 * 4 * (4 * 2 * 18 * 24 * 16) * (4 * 2 * 18 * 24 * 16) * (4 * 2 * 18 * 24 * 16) * (4 * 2 * 18 * 24 * 16))

theorem canonicalCrossoverCovLo_eq_half_betaLo_div_four_pow_four :
    canonicalCrossoverCovLo = ((1 / 4 : ℚ) ^ 5 * canonicalCrossoverBetaLo ^ 4) / 2 := by
  norm_num [canonicalCrossoverCovLo, canonicalCrossoverBetaLo]

theorem canonicalCrossoverCovLo_pos_and_lt_centerTwist_bound :
    0 < canonicalCrossoverBetaLo ∧
    canonicalCrossoverBetaLo < canonicalCrossoverBetaHi ∧
    0 < canonicalCrossoverCovLo ∧
    canonicalCrossoverCovLo < (1 / 4 : ℚ) ^ 5 * canonicalCrossoverBetaLo ^ 4 ∧
    (1 / 4 : ℚ) ^ 5 * canonicalCrossoverBetaHi ^ 4 < 12 * canonicalCrossoverBetaLo ∧
    canonicalCrossoverCovLo < 1 / 16 := by
  norm_num [canonicalCrossoverCovLo, canonicalCrossoverBetaLo, canonicalCrossoverBetaHi]

/-- J2.0-verified polynomial identity factoring the weighted Dobrushin–polymer–truncation budget
`18 * b + 12 * e + 6 * r = 6 * (3 * b + 2 * e + r)`. -/
theorem j20_crossover_rational_budget_identity (b e r : ℝ) :
    18 * b + 12 * e + 6 * r = 6 * (3 * b + 2 * e + r) := by
  ring

/-- Exact rational arithmetic identity: at
`(β_hi, η_hi, ε_hi) = (1 / (18 * 24 * 16), 1 / 16, 1 / 16)`, the total Dobrushin interdependence
contraction ratio `4 * (18 * (24 * β_hi) + η_hi + ε_hi)` equals `3 / 4`. -/
theorem canonicalCrossover_contraction_eq_three_fourths :
    4 * (18 * (24 * canonicalCrossoverBetaHi) + canonicalCrossoverEtaHi + canonicalCrossoverEpsHi) =
      3 / 4 := by
  norm_num [canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]

/-- Exact `norm_num`-verified Dobrushin interdependence contraction certificate `< 1` at the
canonical rational parameters `(1 / (18 * 24 * 16), 1 / 16, 1 / 16)`. -/
theorem canonicalCrossover_contraction_lt_one :
    4 * (18 * (24 * canonicalCrossoverBetaHi) + canonicalCrossoverEtaHi + canonicalCrossoverEpsHi) <
      1 := by
  norm_num [canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]

/-- Exact rational contraction margin
`1 - 4 * (18 * (24 * β_hi) + η_hi + ε_hi) = 1 / 4 > 0`. -/
theorem canonicalCrossover_margin_eq_one_fourth :
    1 - 4 * (18 * (24 * canonicalCrossoverBetaHi) + canonicalCrossoverEtaHi + canonicalCrossoverEpsHi) =
      1 / 4 := by
  norm_num [canonicalCrossoverBetaHi, canonicalCrossoverEtaHi, canonicalCrossoverEpsHi]

/-- Inductive single-step small-field + Peierls large-field polymer contraction and crossover block
bounds along `P : ContinuumCutoffPath`:
1. At each cutoff `n`, the downward RG polymer norm sequence `η_step n : ℕ → ℝ` starts at the
   UV pure-Wilson value `η_step n 0 ≤ 1 / 16` and satisfies the single-step contraction
   `η_step n (k + 1) ≤ (1 / 2) * η_step n k + 1 / 32` for all `k : ℕ`,
2. The landed IR polymer family `((chain n).state 0).polymers` is bounded by `η_step n (K n)` (which
   is automatically `≤ 1 / 16 = canonicalCrossoverEtaHi` for every blocking depth `K n` by
   `inductive_balaban_polymer_contraction_uniform_in_K`), and
3. At the landed IR block scale `ℓstar`, the effective coupling, truncation remainder, and probe
   covariance are enclosed by `(1 / (18 * 24 * 16), 1 / 16, 1 / 16)`. -/
structure InductiveStepAndBlockBounds (P : ContinuumCutoffPath) where
  ℓstar : ℚ
  hℓstar : 0 < ℓstar
  K : ℕ → ℕ
  hK : ∀ᶠ n in atTop, P.spacing n * (2 : ℝ) ^ K n = (ℓstar : ℝ)
  irSide : ℕ → ℕ
  [instNeZeroIrSide : ∀ n : ℕ, NeZero (irSide n)]
  hside : ∀ᶠ n in atTop, P.side n = dyadicScaleSide (irSide n) (K n)
  chain : ∀ n : ℕ, MultiStepHaarRGChain (irSide n) (K n) (P.coupling n)
  η_step : ℕ → ℕ → ℝ
  hη_init : ∀ n : ℕ, η_step n 0 ≤ (1 / 32 : ℝ) / (1 - (1 / 2 : ℝ))
  hη_contraction : ∀ (n k : ℕ), η_step n (k + 1) ≤ (1 / 2 : ℝ) * η_step n k + (1 / 32 : ℝ)
  h_ir_polymer_le : ∀ n : ℕ,
    PolymerDobrushinNormBound ((chain n).state 0).polymers (η_step n (K n))
  h_ir_β_and_trunc : ∀ᶠ n in atTop,
    ((chain n).state 0).β ≤ (canonicalCrossoverBetaHi : ℝ) ∧
    TruncationDobrushinNormBound ((chain n).state 0).R_trunc (canonicalCrossoverEpsHi : ℝ)
  Z_tube : LoopRenormalization P.toCutoffPath
  hZ_tube_scheme :
    ∃ m c : ℕ → ℝ,
      Z_tube = YangMillsOsterwalderSchraderInheritance.perimeterCornerRenormalization P.toCutoffPath m c
  h_cov_enclosure : ∀ᶠ n in atTop,
    (canonicalCrossoverCovLo : ℝ) ≤
      |irCov ((chain n).state 0).gibbsMeasure
        (physicalWilsonLoop (irSide n) (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar).timeReflect)
        (physicalWilsonLoop (irSide n) (ℓstar : ℝ) (canonicalSpatialProbe ℓstar hℓstar))|

attribute [instance] InductiveStepAndBlockBounds.instNeZeroIrSide

/-- Canonical spatial probe `canonicalSpatialProbe B.ℓstar B.hℓstar` fixed by definition for any
`B : InductiveStepAndBlockBounds P`. -/
abbrev InductiveStepAndBlockBounds.ℓ_probe {P : ContinuumCutoffPath}
    (B : InductiveStepAndBlockBounds P) : PhysicalRectangle :=
  canonicalSpatialProbe B.ℓstar B.hℓstar

/-- Positive Euclidean time of `B.ℓ_probe`. -/
theorem InductiveStepAndBlockBounds.hℓ_probe_pos {P : ContinuumCutoffPath}
    (B : InductiveStepAndBlockBounds P) :
    B.ℓ_probe.IsPositiveTime :=
  canonicalSpatialProbe_isPositiveTime B.hℓstar

/-- Every `B : InductiveStepAndBlockBounds P` satisfies the uniform multi-step polymer bound
`η_step n k ≤ (canonicalCrossoverEtaHi : ℝ) = 1 / 16` across all cutoffs `n` and all RG depths `k`. -/
theorem InductiveStepAndBlockBounds.eta_step_le_canonicalCrossoverEtaHi
    {P : ContinuumCutoffPath} (B : InductiveStepAndBlockBounds P) (n k : ℕ) :
    B.η_step n k ≤ (canonicalCrossoverEtaHi : ℝ) := by
  have h_ind := inductive_balaban_polymer_contraction_uniform_in_K
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1)
    (B.hη_init n) (B.hη_contraction n) k
  have h_eq : (1 / 32 : ℝ) / (1 - (1 / 2 : ℝ)) = (canonicalCrossoverEtaHi : ℝ) := by
    norm_num [canonicalCrossoverEtaHi]
  linarith

/-- Every `InductiveStepAndBlockBounds P` canonically constructs a verified
`IntervalArithmeticCrossoverCertificate P` at `(1 / (18 * 24 * 16), 1 / 16, 1 / 16, 1 / 16)`, with
the rational Dobrushin contraction inequality `< 1` discharged automatically by
`canonicalCrossover_contraction_lt_one`. -/
def InductiveStepAndBlockBounds.toIntervalArithmeticCrossoverCertificate
    {P : ContinuumCutoffPath} (B : InductiveStepAndBlockBounds P) :
    IntervalArithmeticCrossoverCertificate P where
  ℓstar := B.ℓstar
  hℓstar := B.hℓstar
  K := B.K
  hK := B.hK
  irSide := B.irSide
  hside := B.hside
  chain := B.chain
  β_hi := canonicalCrossoverBetaHi
  η_hi := canonicalCrossoverEtaHi
  ε_hi := canonicalCrossoverEpsHi
  c_lo := canonicalCrossoverCovLo
  hc_lo_pos := by norm_num [canonicalCrossoverCovLo]
  h_rational_contraction := canonicalCrossover_contraction_lt_one
  h_enclosure := by
    filter_upwards [B.h_ir_β_and_trunc] with n hβt
    exact ⟨hβt.1,
      (B.h_ir_polymer_le n).mono (B.eta_step_le_canonicalCrossoverEtaHi n (B.K n)),
      hβt.2⟩
  Z_tube := B.Z_tube
  hZ_tube_scheme := B.hZ_tube_scheme
  h_cov_enclosure := B.h_cov_enclosure

/-- VACUOUS-CONTROL (zero-coupling hypothesis `∀ᶠ n in atTop, P.coupling n = 0` is unsatisfiable
along any `ContinuumCutoffPath` by `ContinuumCutoffPath.coupling_tendsto_atTop`, `ROL:2008`):
Non-circularity negative control: no `InductiveStepAndBlockBounds P` can exist along a
zero-coupling canonical trajectory (`P.coupling n = 0` eventually). -/
theorem not_inductiveStepAndBlockBounds_of_zero_coupling {P : ContinuumCutoffPath}
    (B : InductiveStepAndBlockBounds P)
    (h_zero_β : ∀ᶠ n in atTop, P.coupling n = 0)
    (h_canonical : ∀ᶠ n in atTop,
      (B.chain n).state 0 = canonicalRGState (B.irSide n) (B.K n) (P.coupling n) 0)
    (h_indep : ∀ n : ℕ,
      irCov (gaugeHaarMeasure (B.irSide n))
        (physicalWilsonLoop (B.irSide n) (B.ℓstar : ℝ) B.ℓ_probe.timeReflect)
        (physicalWilsonLoop (B.irSide n) (B.ℓstar : ℝ) B.ℓ_probe) = 0) :
    False :=
  not_intervalArithmeticCrossoverCertificate_of_zero_coupling
    B.toIntervalArithmeticCrossoverCertificate h_zero_β h_canonical h_indep

/-- At every cutoff `n`, the landed IR coupling `β_ir = ((T.chain n).state 0).β ≥ 0` of any
`T : LandingTube P` has strictly positive `SU(2)` Haar–Boltzmann partition moment
`0 < su2HaarCharacterMoment β_ir 0`, satisfies the normalized Bessel character-ratio bounds
`su2BesselCharacterRatio β_ir 0 = 1`, `|su2BesselCharacterRatio β_ir 1| ≤ 2`, and
`-1 ≤ su2BesselCharacterRatio β_ir 2 ≤ 3`, and eventually in `n` (derived directly from `T.h_tube`
and `T.h_land` with no extra hypothesis on `β_ir`) satisfies `β_ir ≤ 1 / 8`,
`|su2BesselCharacterRatio β_ir 1| ≤ 1 / 3`, `2 * |su2BesselCharacterRatio β_ir 1| ≤ 2 / 3 < 1`,
and strict `1 / 3` positivity of `su2DipoleTruncatedBoltzmann β_ir x` on `[-1, 1]`. -/
theorem LandingTube.landed_su2HaarCharacterMoment_and_besselRatio_bounds
    {P : ContinuumCutoffPath} (T : LandingTube P) :
    (∀ n : ℕ,
      let β_ir := ((T.chain n).state 0).β
      0 < YangMillsOsterwalderSchraderInheritance.su2HaarCharacterMoment β_ir 0 ∧
      YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio β_ir 0 = 1 ∧
      |YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio β_ir 1| ≤ 2 ∧
      -1 ≤ YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio β_ir 2 ∧
      YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio β_ir 2 ≤ 3) ∧
    (∀ᶠ n in atTop,
      let β_ir := ((T.chain n).state 0).β
      β_ir ≤ 1 / 8 ∧
      |YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio β_ir 1| ≤ 1 / 3 ∧
      2 * |YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio β_ir 1| ≤ 2 / 3 ∧
      2 * |YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio β_ir 1| < 1 ∧
      ∀ x ∈ Set.Icc (-1 : ℝ) 1,
        (1 / 3 : ℝ) ≤ YangMillsOsterwalderSchraderInheritance.su2DipoleTruncatedBoltzmann β_ir x) := by
  refine ⟨fun n => ?_, ?_⟩
  · dsimp only
    have hβ : 0 ≤ ((T.chain n).state 0).β := (T.chain n).h_β_nonneg 0 (Nat.zero_le _)
    exact ⟨YangMillsOsterwalderSchraderInheritance.su2HaarCharacterMoment_zero_pos hβ,
      YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio_zero hβ,
      YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio_one_abs_le hβ,
      (YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio_two_bounds hβ).1,
      (YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio_two_bounds hβ).2⟩
  · filter_upwards [T.h_tube] with n h_tube
    dsimp only
    have hβ : 0 ≤ ((T.chain n).state 0).β := (T.chain n).h_β_nonneg 0 (Nat.zero_le _)
    have hβ_le : ((T.chain n).state 0).β ≤ 1 / 8 := by
      have := h_tube.1
      have := T.h_land
      have := T.hη_star_nonneg
      have := T.hε_star_nonneg
      linarith
    have h_small :=
      YangMillsOsterwalderSchraderInheritance.su2BesselCharacterRatio_one_small_of_beta_le_one_eighth
        hβ hβ_le
    refine ⟨hβ_le, h_small.1, h_small.2.1, h_small.2.2, fun x hx => ?_⟩
    exact (YangMillsOsterwalderSchraderInheritance.su2DipoleTruncatedBoltzmann_pos_of_beta_le_one_eighth
      hβ hβ_le hx.1 hx.2).1

/-- At every cutoff `n`, the single-link conditional Gibbs expectation interdependence sum for the
landed IR local Wilson action `groupWilsonAction su2CompactGaugeClassTrace ((T.chain n).state 0).β`
of `T : LandingTube P` over all `4 (T.irSide n)^4 - 1` exterior links `Finset.univ.erase e`
collapses identically to `dobrushinNeighbors e`. -/
theorem LandingTube.landed_singleLinkCondExp_locality_sum_eq
    {P : ContinuumCutoffPath} (T : LandingTube P) (n : ℕ)
    (V : GaugeConfig (T.irSide n)) (e : Link (T.irSide n))
    (h1 h2 : Link (T.irSide n) → SU2) (φ : SU2 → ℝ) :
    (∑ e' ∈ Finset.univ.erase e,
      |groupSingleLinkCondExp SU2 (T.irSide n)
          (groupWilsonAction su2CompactGaugeClassTrace ((T.chain n).state 0).β)
          (updateGroupGaugeLink (T.irSide n) V e'.x e'.μ (h1 e')) e φ -
        groupSingleLinkCondExp SU2 (T.irSide n)
          (groupWilsonAction su2CompactGaugeClassTrace ((T.chain n).state 0).β)
          (updateGroupGaugeLink (T.irSide n) V e'.x e'.μ (h2 e')) e φ|) =
    (∑ e' ∈ dobrushinNeighbors e,
      |groupSingleLinkCondExp SU2 (T.irSide n)
          (groupWilsonAction su2CompactGaugeClassTrace ((T.chain n).state 0).β)
          (updateGroupGaugeLink (T.irSide n) V e'.x e'.μ (h1 e')) e φ -
        groupSingleLinkCondExp SU2 (T.irSide n)
          (groupWilsonAction su2CompactGaugeClassTrace ((T.chain n).state 0).β)
          (updateGroupGaugeLink (T.irSide n) V e'.x e'.μ (h2 e')) e φ|) :=
  groupWilson_singleLinkCondExp_locality_sum_eq SU2 su2CompactGaugeClassTrace
    ((T.chain n).state 0).β V e h1 h2 φ

/-! ### Explicit Finite Link Support & Oscillation Bounds for General-Group Wilson Loops -/

/-- Updating a link `e ≠ latticeStepLink L x s` leaves `groupStepHolonomy` invariant. -/
theorem groupStepHolonomy_updateGroupGaugeLink_eq_of_ne
    {G : Type*} [Group G] {L : ℕ}
    (U : GroupGaugeConfig G L) (x : Lattice4D L) (s : LatticeStep)
    (e : Link L) (hne : e ≠ latticeStepLink L x s) (g : G) :
    groupStepHolonomy (updateGroupGaugeLink L U e.x e.μ g) x s =
      groupStepHolonomy U x s := by
  rcases s with ⟨μ, _ | _⟩
  · dsimp [groupStepHolonomy, latticeStepLink] at *
    rw [(updateGroupGaugeLink_same_and_other L U e.x e.μ g).2 ⟨x - unitVec L μ, μ⟩ (Ne.symm hne)]
  · dsimp [groupStepHolonomy, latticeStepLink] at *
    exact (updateGroupGaugeLink_same_and_other L U e.x e.μ g).2 ⟨x, μ⟩ (Ne.symm hne)

/-- Updating any link `e ∉ latticePathSupport L x p` leaves the ordered path holonomy
`groupPathHolonomy` strictly invariant. -/
theorem groupPathHolonomy_updateGroupGaugeLink_eq_of_not_mem
    {G : Type*} [Group G] {L : ℕ}
    (U : GroupGaugeConfig G L) (e : Link L) (g : G) :
    ∀ (x : Lattice4D L) (p : List LatticeStep),
      e ∉ latticePathSupport L x p →
      groupPathHolonomy (updateGroupGaugeLink L U e.x e.μ g) x p =
        groupPathHolonomy U x p
  | _, [], _ => rfl
  | x, s :: p, h_not_mem => by
      dsimp [latticePathSupport] at h_not_mem
      rw [Finset.mem_insert, not_or] at h_not_mem
      dsimp [groupPathHolonomy]
      rw [groupStepHolonomy_updateGroupGaugeLink_eq_of_ne U x s e h_not_mem.1 g,
        groupPathHolonomy_updateGroupGaugeLink_eq_of_not_mem U e g (stepTarget x s) p h_not_mem.2]

/-- Updating any link `e ∉ physicalRectangleSupport L a ℓ` leaves `groupPhysicalWilsonLoop` invariant. -/
theorem groupPhysicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem
    {G : Type*} [Group G] [TopologicalSpace G]
    (tr : CompactGaugeClassTrace G) {L : ℕ} (a : ℝ) (ℓ : PhysicalRectangle)
    (U : GroupGaugeConfig G L) {e : Link L}
    (h_not_mem : e ∉ physicalRectangleSupport L a ℓ) (g : G) :
    groupPhysicalWilsonLoop tr L a ℓ (updateGroupGaugeLink L U e.x e.μ g) =
      groupPhysicalWilsonLoop tr L a ℓ U := by
  unfold groupPhysicalWilsonLoop physicalRectangleSupport at *
  rw [groupPathHolonomy_updateGroupGaugeLink_eq_of_not_mem U e g _ _ h_not_mem]

/-- Exact vanishing of the single-link oscillation `linkOscillation` outside `physicalRectangleSupport`
for any renormalized rectangular Wilson loop `fun U => Z_fac * groupPhysicalWilsonLoop tr L a ℓ U`. -/
theorem linkOscillation_mul_groupPhysicalWilsonLoop_eq_zero_of_not_mem
    (G : Type*) [Group G] [TopologicalSpace G]
    (tr : CompactGaugeClassTrace G) {L : ℕ} (a : ℝ) (ℓ : PhysicalRectangle)
    (Z_fac : ℝ) {e : Link L} (h_not_mem : e ∉ physicalRectangleSupport L a ℓ) :
    linkOscillation G L (fun U => Z_fac * groupPhysicalWilsonLoop tr L a ℓ U) e = 0 := by
  refine linkOscillation_eq_zero_of_independent G
    (fun U => Z_fac * groupPhysicalWilsonLoop tr L a ℓ U) e ?_
  intro V g1 g2
  rw [groupPhysicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem tr a ℓ V h_not_mem g1,
    groupPhysicalWilsonLoop_updateGroupGaugeLink_eq_of_not_mem tr a ℓ V h_not_mem g2]

/-- Uniform bound `|groupPhysicalWilsonLoop tr L a ℓ U| ≤ 1` for every `U : GroupGaugeConfig G L`. -/
theorem abs_groupPhysicalWilsonLoop_le_one
    {G : Type*} [Group G] [TopologicalSpace G]
    (tr : CompactGaugeClassTrace G) (L : ℕ) (a : ℝ) (ℓ : PhysicalRectangle)
    (U : GroupGaugeConfig G L) :
    |groupPhysicalWilsonLoop tr L a ℓ U| ≤ 1 :=
  tr.h_abs_le_one _

/-- Uniform single-link oscillation bound `linkOscillation ≤ 2 * |Z_fac|` for any renormalized
rectangular Wilson loop `fun U => Z_fac * groupPhysicalWilsonLoop tr L a ℓ U`. -/
theorem linkOscillation_mul_groupPhysicalWilsonLoop_le_two_mul_abs
    (G : Type*) [Group G] [TopologicalSpace G]
    (tr : CompactGaugeClassTrace G) {L : ℕ} (a : ℝ) (ℓ : PhysicalRectangle)
    (Z_fac : ℝ) (e : Link L) :
    linkOscillation G L (fun U => Z_fac * groupPhysicalWilsonLoop tr L a ℓ U) e ≤ 2 * |Z_fac| := by
  refine linkOscillation_le_of_forall_le G
    (fun U => Z_fac * groupPhysicalWilsonLoop tr L a ℓ U) e ?_
  intro V g1 g2
  have h1 := abs_groupPhysicalWilsonLoop_le_one tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g1)
  have h2 := abs_groupPhysicalWilsonLoop_le_one tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g2)
  calc
    |Z_fac * groupPhysicalWilsonLoop tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g1) -
        Z_fac * groupPhysicalWilsonLoop tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g2)|
      = |Z_fac| *
          |groupPhysicalWilsonLoop tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g1) -
            groupPhysicalWilsonLoop tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g2)| := by
        rw [← mul_sub, abs_mul]
    _ ≤ |Z_fac| *
          (|groupPhysicalWilsonLoop tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g1)| +
            |groupPhysicalWilsonLoop tr L a ℓ (updateGroupGaugeLink L V e.x e.μ g2)|) :=
        mul_le_mul_of_nonneg_left (abs_sub _ _) (abs_nonneg Z_fac)
    _ ≤ |Z_fac| * (1 + 1) :=
        mul_le_mul_of_nonneg_left (add_le_add h1 h2) (abs_nonneg Z_fac)
    _ = 2 * |Z_fac| := by ring

/-- Support-dependent Dobrushin observable comparison theorem for any pair of renormalized
rectangular Wilson loops `ℓ₁, ℓ₂ : PhysicalRectangle` separated by distance `≥ t` in `distLink`:
discharges the support-vanishing and oscillation hypotheses of
`dobrushinObservableComparison_le_of_support_dist` unconditionally via
`physicalRectangleSupport L a ℓ₁` and `physicalRectangleSupport L a ℓ₂`. -/
theorem dobrushinObservableComparison_groupPhysicalWilsonLoop_le_of_support_dist
    (G : Type*) [Group G] [TopologicalSpace G]
    (tr : CompactGaugeClassTrace G) {L : ℕ} [NeZero L]
    (C : Link L → Link L → ℝ) (distLink : Link L → Link L → ℕ)
    {q : ℝ} (hq : 0 ≤ q) (hq_lt : q < 1)
    (hC_nonneg : ∀ e e' : Link L, 0 ≤ C e e')
    (h_row : ∀ e : Link L, (∑ e' : Link L, C e e') ≤ q)
    (h_refl : ∀ e : Link L, distLink e e = 0)
    (h_tri : ∀ e e'' e' : Link L, distLink e e' ≤ distLink e e'' + distLink e'' e')
    (h_step : ∀ e e' : Link L, C e e' ≠ 0 → distLink e e' ≤ 1)
    (a : ℝ) (ℓ₁ ℓ₂ : PhysicalRectangle) (Z₁ Z₂ : ℝ) (t : ℕ)
    (h_sep : ∀ e ∈ physicalRectangleSupport L a ℓ₁,
      ∀ e' ∈ physicalRectangleSupport L a ℓ₂, t ≤ distLink e e') :
    dobrushinObservableComparison G C
      (fun U => Z₁ * groupPhysicalWilsonLoop tr L a ℓ₁ U)
      (fun U => Z₂ * groupPhysicalWilsonLoop tr L a ℓ₂ U) ≤
      (2 * |Z₁| * (physicalRectangleSupport L a ℓ₁).card) * (2 * |Z₂|) *
        (q ^ t / (1 - q)) := by
  have hMg : 0 ≤ 2 * |Z₂| := mul_nonneg (by norm_num) (abs_nonneg Z₂)
  have h_base :=
    dobrushinObservableComparison_le_of_support_dist G C distLink hq hq_lt hMg
      hC_nonneg h_row h_refl h_tri h_step
      (fun U => Z₁ * groupPhysicalWilsonLoop tr L a ℓ₁ U)
      (fun U => Z₂ * groupPhysicalWilsonLoop tr L a ℓ₂ U)
      (physicalRectangleSupport L a ℓ₁)
      (physicalRectangleSupport L a ℓ₂) t
      (fun e he => linkOscillation_mul_groupPhysicalWilsonLoop_eq_zero_of_not_mem G tr a ℓ₁ Z₁ he)
      (fun e' he' => linkOscillation_mul_groupPhysicalWilsonLoop_eq_zero_of_not_mem G tr a ℓ₂ Z₂ he')
      (fun e' _ => linkOscillation_mul_groupPhysicalWilsonLoop_le_two_mul_abs G tr a ℓ₂ Z₂ e')
      h_sep
  have h_sum_f :
      (∑ e ∈ physicalRectangleSupport L a ℓ₁,
        linkOscillation G L (fun U => Z₁ * groupPhysicalWilsonLoop tr L a ℓ₁ U) e) ≤
      2 * |Z₁| * (physicalRectangleSupport L a ℓ₁).card := by
    calc
      (∑ e ∈ physicalRectangleSupport L a ℓ₁,
        linkOscillation G L (fun U => Z₁ * groupPhysicalWilsonLoop tr L a ℓ₁ U) e)
        ≤ ∑ _e ∈ physicalRectangleSupport L a ℓ₁, (2 * |Z₁|) :=
          Finset.sum_le_sum fun e _ =>
            linkOscillation_mul_groupPhysicalWilsonLoop_le_two_mul_abs G tr a ℓ₁ Z₁ e
      _ = 2 * |Z₁| * (physicalRectangleSupport L a ℓ₁).card := by
          rw [Finset.sum_const, nsmul_eq_mul]
          ring
  have h_rhs_nonneg : 0 ≤ (2 * |Z₂|) * (q ^ t / (1 - q)) :=
    mul_nonneg hMg (div_nonneg (pow_nonneg hq t) (sub_nonneg.mpr hq_lt.le))
  calc
    dobrushinObservableComparison G C
      (fun U => Z₁ * groupPhysicalWilsonLoop tr L a ℓ₁ U)
      (fun U => Z₂ * groupPhysicalWilsonLoop tr L a ℓ₂ U)
      ≤ (∑ e ∈ physicalRectangleSupport L a ℓ₁,
          linkOscillation G L (fun U => Z₁ * groupPhysicalWilsonLoop tr L a ℓ₁ U) e) *
          (2 * |Z₂|) * (q ^ t / (1 - q)) := h_base
    _ = (∑ e ∈ physicalRectangleSupport L a ℓ₁,
          linkOscillation G L (fun U => Z₁ * groupPhysicalWilsonLoop tr L a ℓ₁ U) e) *
          ((2 * |Z₂|) * (q ^ t / (1 - q))) := by ring
    _ ≤ (2 * |Z₁| * (physicalRectangleSupport L a ℓ₁).card) *
          ((2 * |Z₂|) * (q ^ t / (1 - q))) :=
        mul_le_mul_of_nonneg_right h_sum_f h_rhs_nonneg
    _ = (2 * |Z₁| * (physicalRectangleSupport L a ℓ₁).card) * (2 * |Z₂|) *
          (q ^ t / (1 - q)) := by ring

/-- Derivation of `TruncationDobrushinNormBound R_trunc (18 * δ_nb)` from a plaquette-neighbor
two-link mixed-difference bound `|twoLinkMixedDifference L R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤ if e' ∈ dobrushinNeighbors e then δ_nb else 0`. -/
theorem truncationDobrushinNormBound_of_dobrushinNeighbors_bound
    {L : ℕ} [NeZero L] (R_trunc : GaugeConfig L → ℝ) {δ_nb B : ℝ} (hδ : 0 ≤ δ_nb)
    (hS_abs : ∀ V : GaugeConfig L, |R_trunc V| ≤ B)
    (hS_meas : Measurable R_trunc)
    (h_mixed : ∀ (V : GaugeConfig L) (e e' : Link L) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference L R_trunc V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
        if e' ∈ dobrushinNeighbors e then δ_nb else 0) :
    TruncationDobrushinNormBound R_trunc (18 * δ_nb) := by
  refine ⟨⟨B, hS_abs⟩, hS_meas, ?_⟩
  refine ⟨fun e e' => if e' ∈ dobrushinNeighbors e then δ_nb else 0, ?_, h_mixed, fun e => ?_⟩
  · intro e e'
    dsimp only
    split_ifs <;> linarith
  · have h_sub :
        (∑ e' ∈ Finset.univ.erase e, (if e' ∈ dobrushinNeighbors e then δ_nb else 0)) =
          ∑ e' ∈ dobrushinNeighbors e, (if e' ∈ dobrushinNeighbors e then δ_nb else 0) := by
      symm
      apply Finset.sum_subset
      · intro e' he'
        exact Finset.mem_erase.mpr
          ⟨fun h => not_mem_dobrushinNeighbors_self e (h ▸ he'), Finset.mem_univ e'⟩
      · intro e' _ hn
        simp [hn]
    have h_const :
        (∑ e' ∈ dobrushinNeighbors e, (if e' ∈ dobrushinNeighbors e then δ_nb else 0)) =
          ((dobrushinNeighbors e).card : ℝ) * δ_nb := by
      have h_congr :
          (∑ e' ∈ dobrushinNeighbors e, (if e' ∈ dobrushinNeighbors e then δ_nb else 0)) =
            ∑ _e' ∈ dobrushinNeighbors e, δ_nb :=
        Finset.sum_congr rfl fun e' he' => by simp [he']
      rw [h_congr, Finset.sum_const, nsmul_eq_mul]
    have hcard : ((dobrushinNeighbors e).card : ℝ) ≤ 18 := by
      exact_mod_cast dobrushinNeighbors_card_le_eighteen e
    rw [h_sub, h_const]
    exact mul_le_mul_of_nonneg_right hcard hδ

/-- Uniform-in-depth (`K`) inductive derivation of `TruncationDobrushinNormBound`:
if at each downward RG step `k : ℕ` on lattice side `L_seq k`, the truncation remainder `R_seq k`
has uniform amplitude `|R_seq k V| ≤ 18 * δ_nb k` and plaquette-neighbor two-link mixed differences
bounded by `δ_nb k ≥ 0` satisfying the single-step contraction `δ_nb (k + 1) ≤ θ * δ_nb k + ε_step`
(`0 ≤ θ < 1`, `0 ≤ ε_step`) from UV initialization `δ_nb 0 ≤ ε_step / (1 - θ)`, then
`TruncationDobrushinNormBound (R_seq k) (18 * (ε_step / (1 - θ)))` holds for every RG step `k : ℕ`. -/
theorem inductive_truncationDobrushinNormBound_uniform_in_K
    (L_seq : ℕ → ℕ) [∀ k : ℕ, NeZero (L_seq k)]
    (R_seq : ∀ k : ℕ, GaugeConfig (L_seq k) → ℝ)
    (δ_nb : ℕ → ℝ) {θ ε_step : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ < 1) (hε_nonneg : 0 ≤ ε_step)
    (h_δ_init : δ_nb 0 ≤ ε_step / (1 - θ))
    (h_δ_step : ∀ k : ℕ, δ_nb (k + 1) ≤ θ * δ_nb k + ε_step)
    (hS_abs : ∀ (k : ℕ) (V : GaugeConfig (L_seq k)), |R_seq k V| ≤ 18 * δ_nb k)
    (hS_meas : ∀ k : ℕ, Measurable (R_seq k))
    (h_mixed : ∀ (k : ℕ) (V : GaugeConfig (L_seq k)) (e e' : Link (L_seq k)) (g1 g2 h1 h2 : SU2),
      |twoLinkMixedDifference (L_seq k) (R_seq k) V e.x e.μ g1 g2 e'.x e'.μ h1 h2| ≤
        if e' ∈ dobrushinNeighbors e then δ_nb k else 0) :
    ∀ k : ℕ, TruncationDobrushinNormBound (R_seq k) (18 * (ε_step / (1 - θ))) := by
  intro k
  have h1_pos : 0 < 1 - θ := sub_pos.mpr hθ1
  have h_fp_nonneg : 0 ≤ ε_step / (1 - θ) := div_nonneg hε_nonneg h1_pos.le
  have h_δ_le : δ_nb k ≤ ε_step / (1 - θ) :=
    inductive_balaban_polymer_contraction_uniform_in_K hθ0 hθ1 h_δ_init h_δ_step k
  refine truncationDobrushinNormBound_of_dobrushinNeighbors_bound
    (R_seq k) h_fp_nonneg
    (hS_abs k)
    (hS_meas k)
    fun V e e' g1 g2 h1 h2 => ?_
  have h_mk := h_mixed k V e e' g1 g2 h1 h2
  split_ifs at h_mk ⊢ with h_mem
  · exact h_mk.trans h_δ_le
  · exact h_mk

