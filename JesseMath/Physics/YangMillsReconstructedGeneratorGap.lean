    (restTouchPlaquettes L) (restTouchPlaquettes L) (restTouchPlaquettes L) h_sub_rest h_sub_rest h_sub_rest
  have h2 := integral_mul_sum_cube_mul_sub_lateral_probes_eq_zero hL H hH_cont hH_inv
    (restTouchPlaquettes L) (restTouchPlaquettes L) (cubeLateralSet L) h_sub_rest h_sub_rest h_sub_lat
  have h3 := integral_mul_sum_cube_mul_sub_lateral_probes_eq_zero hL H hH_cont hH_inv
    (restTouchPlaquettes L) (cubeLateralSet L) (cubeLateralSet L) h_sub_rest h_sub_lat h_sub_lat
  have h4 := integral_mul_sum_cube_mul_sub_lateral_probes_eq_zero hL H hH_cont hH_inv
    (cubeLateralSet L) (cubeLateralSet L) (cubeLateralSet L) h_sub_lat h_sub_lat h_sub_lat
  change (∫ U, H U * (restTouchCharacterSum U * restTouchCharacterSum U * restTouchCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) ∂(gaugeHaarMeasure L)) = 0 at h1
  change (∫ U, H U * (restTouchCharacterSum U * restTouchCharacterSum U * lateralCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) ∂(gaugeHaarMeasure L)) = 0 at h2
  change (∫ U, H U * (restTouchCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) ∂(gaugeHaarMeasure L)) = 0 at h3
  change (∫ U, H U * (lateralCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) ∂(gaugeHaarMeasure L)) = 0 at h4
  let D₁ : GaugeConfig L → ℝ := fun U =>
    H U * (restTouchCharacterSum U * restTouchCharacterSum U * restTouchCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
  let D₂ : GaugeConfig L → ℝ := fun U =>
    H U * (restTouchCharacterSum U * restTouchCharacterSum U * lateralCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
  let D₃ : GaugeConfig L → ℝ := fun U =>
    H U * (restTouchCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
  let D₄ : GaugeConfig L → ℝ := fun U =>
    H U * (lateralCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
      (restTouchCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
