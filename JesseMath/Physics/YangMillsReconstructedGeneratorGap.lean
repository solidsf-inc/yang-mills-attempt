theorem integral_characterBoltzmannWeight_mul_centeredProbes_eq_sideBridge
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) :
    let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
    let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
    let c : ℝ := su2CharMean β
    (∫ U : GaugeConfig L, characterBoltzmannWeight β U * ((b U - c) * (t U - c)) ∂(gaugeHaarMeasure L)) =
      ∫ U : GaugeConfig L,
        probeExteriorBoltzmannWeight β U *
          sideBridge L β 0 U * sideBridge L β 1 U * sideBridge L β 2 U * sideBridge L β 3 U *
          ((b U - c) * Real.exp (β * b U)) * ((t U - c) * Real.exp (β * t U))
        ∂(gaugeHaarMeasure L) := by
  intro b t c
  let ΦB (U : GaugeConfig L) : ℝ := (b U - c) * Real.exp (β * b U)
  let ΦT (U : GaugeConfig L) : ℝ := (t U - c) * Real.exp (β * t U)
  have h_fact (U : GaugeConfig L) :
