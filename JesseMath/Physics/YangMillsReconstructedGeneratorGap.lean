theorem integral_totalCharacterSum_pow_four_probes_sub_cubic_eq
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    (∫ U : GaugeConfig L,
      (totalCharacterSum U) ^ 4 *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) -
    (∫ U : GaugeConfig L,
      (totalCharacterSum U) ^ 3 *
        halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
      ∂(gaugeHaarMeasure L)) -
    (∫ U : GaugeConfig L,
      (totalCharacterSum U) ^ 3 *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
      ∂(gaugeHaarMeasure L)) =
    -3 / 8 -
      (3 / 4) * (∫ U : GaugeConfig L, (restCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) +
      (∫ U : GaugeConfig L,
        (restCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        ∂(gaugeHaarMeasure L)) := by
  have hL2 : 2 ≤ L := by omega
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  let A : GaugeConfig L → ℝ := fun U =>
    halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) +
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
  have hA : Continuous A := hb.add ht
  let T₀ : GaugeConfig L → ℝ := fun U =>
    A U ^ 4 *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
    A U ^ 4
  let H₁ : GaugeConfig L → ℝ := fun U =>
    4 * A U ^ 3 *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
    3 * A U ^ 3
  let H₂ : GaugeConfig L → ℝ := fun U =>
    6 * (A U ^ 2 *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) -
    3 * A U ^ 2
  let H₃ : GaugeConfig L → ℝ := fun U =>
    4 * A U *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) -
    A U
  let T₄ : GaugeConfig L → ℝ := fun U =>
    (restCharacterSum U) ^ 4 *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  have hT₀_cont : Continuous T₀ :=
    (((hA.pow 4).mul hb).mul ht).sub (hA.pow 4)
  have hH₁_cont : Continuous H₁ :=
    ((((continuous_const.mul (hA.pow 3)).mul hb).mul ht).sub (continuous_const.mul (hA.pow 3)))
  have hH₂_cont : Continuous H₂ :=
    (continuous_const.mul (((hA.pow 2).mul hb).mul ht)).sub (continuous_const.mul (hA.pow 2))
  have hH₃_cont : Continuous H₃ :=
    ((((continuous_const.mul hA).mul hb).mul ht).sub hA)
  have hT₄_cont : Continuous T₄ :=
    (continuous_restCharacterSum.pow 4).mul (hb.mul ht)
  have h_T₀_int : (∫ U : GaugeConfig L, T₀ U ∂(gaugeHaarMeasure L)) = -3 / 8 :=
    integral_gaugeHaarMeasure_probeSum_pow_four_sub_eq_neg_three_eighths hL2
  have h_T₁_int :
      (∫ U : GaugeConfig L, H₁ U * restCharacterSum U ∂(gaugeHaarMeasure L)) = 0 := by
    refine (integral_twoProbeObservable_mul_restCharacterSum_eq_zero hL H₁ hH₁_cont
      (fun U e g hbot htop => ?_)).2
    dsimp only [H₁, A]
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) hbot g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) htop g]
  have h_H₂_int : (∫ U : GaugeConfig L, H₂ U ∂(gaugeHaarMeasure L)) = -3 / 4 := by
    dsimp only [H₂]
    rw [integral_sub_apply
          (fun U => 6 * (A U ^ 2 *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
          (fun U => 3 * A U ^ 2)
          (continuous_const.mul (((hA.pow 2).mul hb).mul ht))
          (continuous_const.mul (hA.pow 2)),
        integral_const_mul, integral_const_mul,
        integral_gaugeHaarMeasure_probeSum_sq_mul_probes_eq_eighth hL2,
        integral_gaugeHaarMeasure_probeSum_sq_eq_half hL2]
    norm_num
  have h_T₂_int :
      (∫ U : GaugeConfig L, H₂ U * (restCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) =
        (-3 / 4) * (∫ U : GaugeConfig L, (restCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) := by
    rw [integral_twoProbeObservable_mul_restCharacterSum_sq_eq hL H₂ hH₂_cont
        (fun U e g hbot htop => ?_), h_H₂_int]
    dsimp only [H₂, A]
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) hbot g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) htop g]
  have h_T₃_int :
      (∫ U : GaugeConfig L, H₃ U * (restCharacterSum U) ^ 3 ∂(gaugeHaarMeasure L)) = 0 :=
    integral_probeCubic_mul_restCharacterSum_cube_eq_zero hL
  have h_lhs_combine :
      (∫ U : GaugeConfig L,
        (totalCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        ∂(gaugeHaarMeasure L)) -
      (∫ U : GaugeConfig L,
        (totalCharacterSum U) ^ 3 *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
        ∂(gaugeHaarMeasure L)) -
      (∫ U : GaugeConfig L,
        (totalCharacterSum U) ^ 3 *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) =
      ∫ U : GaugeConfig L,
        ((((T₀ U + H₁ U * restCharacterSum U) + H₂ U * (restCharacterSum U) ^ 2) +
          H₃ U * (restCharacterSum U) ^ 3) + T₄ U)
        ∂(gaugeHaarMeasure L) := by
    rw [← integral_sub_apply
          (fun U => (totalCharacterSum U) ^ 4 *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
          (fun U => (totalCharacterSum U) ^ 3 *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
          ((continuous_totalCharacterSum.pow 4).mul (hb.mul ht))
          ((continuous_totalCharacterSum.pow 3).mul hb),
        ← integral_sub_apply
          (fun U => (totalCharacterSum U) ^ 4 *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) -
            (totalCharacterSum U) ^ 3 *
              halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)))
          (fun U => (totalCharacterSum U) ^ 3 *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
          (((continuous_totalCharacterSum.pow 4).mul (hb.mul ht)).sub
            ((continuous_totalCharacterSum.pow 3).mul hb))
          ((continuous_totalCharacterSum.pow 3).mul ht)]
    congr 1
    funext U
    rw [totalCharacterSum_eq_probeSum_add_restCharacterSum hL2 U]
    dsimp only [T₀, H₁, H₂, H₃, T₄, A]
    ring
  rw [h_lhs_combine,
      integral_add5_apply
        T₀
        (fun U => H₁ U * restCharacterSum U)
        (fun U => H₂ U * (restCharacterSum U) ^ 2)
        (fun U => H₃ U * (restCharacterSum U) ^ 3)
        T₄
        hT₀_cont
        (hH₁_cont.mul continuous_restCharacterSum)
        (hH₂_cont.mul (continuous_restCharacterSum.pow 2))
        (hH₃_cont.mul (continuous_restCharacterSum.pow 3))
        hT₄_cont,
      h_T₀_int, h_T₁_int, h_T₂_int, h_T₃_int]
  ring

/-- Enumeration of the 4 lateral temporal plaquettes of the canonical unit 3-cube on `Lattice4D L`. -/
def cubeLateralAt (L : ℕ) : Fin 4 → Plaquette L
  | ⟨0, _⟩ => cubeLateralPlaquette1 L
  | ⟨1, _⟩ => cubeLateralPlaquette2 L
  | ⟨2, _⟩ => cubeLateralPlaquette3 L
  | ⟨3, _⟩ => cubeLateralPlaquette4 L

/-- The finset of the 4 lateral temporal plaquettes of the canonical unit 3-cube on `Lattice4D L`. -/
def cubeLateralSet (L : ℕ) : Finset (Plaquette L) :=
  {cubeLateralPlaquette1 L, cubeLateralPlaquette2 L, cubeLateralPlaquette3 L, cubeLateralPlaquette4 L}

/-- Sum of the 4 lateral plaquette characters of the canonical unit 3-cube. -/
def lateralCharacterSum {L : ℕ} (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ cubeLateralSet L, halfTraceRe (plaquetteHolonomy U q)

theorem continuous_lateralCharacterSum {L : ℕ} [NeZero L] :
    Continuous (lateralCharacterSum (L := L)) := by
  unfold lateralCharacterSum
  exact continuous_finsetSum _ (fun q _ => continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q))

theorem cubeLateralAt_mem_cubeLateralSet (L : ℕ) (k : Fin 4) :
    cubeLateralAt L k ∈ cubeLateralSet L := by
  fin_cases k <;> simp [cubeLateralAt, cubeLateralSet]

theorem cubeLateralSet_subset_restPlaquettes (L : ℕ) [NeZero L] :
    cubeLateralSet L ⊆ restPlaquettes L := by
  intro q hq
  simp only [cubeLateralSet, Finset.mem_insert, Finset.mem_singleton] at hq
  simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and]
  rcases hq with rfl | rfl | rfl | rfl <;>
    refine ⟨fun h => by
              have hμ := congrArg Plaquette.μ h
              simp [cubeBottomPlaquette, cubeLateralPlaquette1, cubeLateralPlaquette2,
                cubeLateralPlaquette3, cubeLateralPlaquette4] at hμ,
            fun h => by
              have hμ := congrArg Plaquette.μ h
              simp [cubeTopPlaquette, cubeLateralPlaquette1, cubeLateralPlaquette2,
                cubeLateralPlaquette3, cubeLateralPlaquette4] at hμ⟩

theorem cubeLateralAt_ne_cubeTopPlaquette (L : ℕ) (k : Fin 4) :
    cubeLateralAt L k ≠ cubeTopPlaquette L := by
  intro h
  have hμ := congrArg Plaquette.μ h
  fin_cases k <;>
    simp [cubeLateralAt, cubeTopPlaquette, cubeLateralPlaquette1, cubeLateralPlaquette2,
      cubeLateralPlaquette3, cubeLateralPlaquette4] at hμ

theorem plaquetteLinkAt_cubeTopPlaquette_mem_cubeLateralAt (L : ℕ) (k : Fin 4) :
    plaquetteLinkAt (cubeTopPlaquette L) k ∈ plaquetteLinks (cubeLateralAt L k) := by
  fin_cases k
  · simp [plaquetteLinkAt, cubeTopPlaquette, cubeLateralAt, cubeLateralPlaquette1, plaquetteLinks,
      shift_cubeBottomBase_zero]
  · simp [plaquetteLinkAt, cubeTopPlaquette, cubeLateralAt, cubeLateralPlaquette2, plaquetteLinks,
      shift_shift_cubeBottomBase_one_zero]
  · simp [plaquetteLinkAt, cubeTopPlaquette, cubeLateralAt, cubeLateralPlaquette3, plaquetteLinks,
      shift_shift_cubeBottomBase_two_zero]
  · simp [plaquetteLinkAt, cubeTopPlaquette, cubeLateralAt, cubeLateralPlaquette4, plaquetteLinks,
      shift_cubeBottomBase_zero]

theorem not_mem_plaquetteLinks_cubeLateralAt_of_ne
    {L : ℕ} (hL : 3 ≤ L) {k' k : Fin 4} (hne : k' ≠ k) :
    plaquetteLinkAt (cubeTopPlaquette L) k' ∉ plaquetteLinks (cubeLateralAt L k) := by
  intro h
  exact hne (plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL
    (cubeLateralAt_ne_cubeTopPlaquette L k) h
    (plaquetteLinkAt_cubeTopPlaquette_mem_cubeLateralAt L k))

/-- Lateral plaquette characterization on `Lattice4D L` (`L ≥ 3`):
any plaquette `q : Plaquette L` that shares both a boundary link `k_bot` with `cubeBottomPlaquette L`
and a boundary link `k_top` with `cubeTopPlaquette L` must equal `cubeLateralAt L k_bot`. -/
theorem eq_cubeLateralAt_of_mem_plaquetteLinks_bottom_and_top
    {L : ℕ} (hL : 3 ≤ L) {q : Plaquette L} {k_bot k_top : Fin 4}
    (h_bot : plaquetteLinkAt (cubeBottomPlaquette L) k_bot ∈ plaquetteLinks q)
    (h_top : plaquetteLinkAt (cubeTopPlaquette L) k_top ∈ plaquetteLinks q) :
    q = cubeLateralAt L k_bot := by
  have hL2 : 2 ≤ L := by omega
  have h_t_bot : (plaquetteLinkAt (cubeBottomPlaquette L) k_bot).x 0 = -1 :=
    time_coord_of_mem_plaquetteLinks_cubeBottomPlaquette
      (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k_bot)
  have h_t_top : (plaquetteLinkAt (cubeTopPlaquette L) k_top).x 0 = 0 :=
    time_coord_of_mem_plaquetteLinks_cubeTopPlaquette
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k_top)
  have h_dir_bot : (plaquetteLinkAt (cubeBottomPlaquette L) k_bot).μ ≠ 0 := by
    fin_cases k_bot <;> simp [plaquetteLinkAt, cubeBottomPlaquette]
  have h_dir_top : (plaquetteLinkAt (cubeTopPlaquette L) k_top).μ ≠ 0 := by
    fin_cases k_top <;> simp [plaquetteLinkAt, cubeTopPlaquette]
  have hq_nu_ne : q.ν ≠ 0 := ((Fin.zero_le q.μ).trans_lt q.h).ne'
  have hq_mu : q.μ = 0 := by
    by_contra hq_mu_ne
    have h0_ne_mu : (0 : Direction) ≠ q.μ := Ne.symm hq_mu_ne
    have h_all_t : ∀ e ∈ plaquetteLinks q, e.x 0 = q.x 0 := by
      intro e he
      simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
      rcases he with rfl | rfl | rfl | rfl <;> simp [shift, unitVec, h0_ne_mu, hq_nu_ne.symm]
    have h1 : q.x 0 = -1 := (h_all_t _ h_bot).symm.trans h_t_bot
    have h2 : q.x 0 = 0 := (h_all_t _ h_top).symm.trans h_t_top
    exact neg_one_ne_zero_of_two_le hL2 (h1.symm.trans h2)
  have h_nu_link :
      ∀ e ∈ plaquetteLinks q, e.μ ≠ 0 → e = ⟨shift q.x q.μ, q.ν⟩ ∨ e = ⟨q.x, q.ν⟩ := by
    intro e he h_dir
    simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
    rcases he with rfl | rfl | rfl | rfl
    · exfalso; exact h_dir hq_mu
    · exact Or.inl rfl
    · exfalso; exact h_dir hq_mu
    · exact Or.inr rfl
  rcases h_nu_link _ h_bot h_dir_bot with h_bot_eq | h_bot_eq
  · exfalso
    have h_qx0_add : q.x 0 + 1 = -1 := by
      have h := congrFun (congrArg Link.x h_bot_eq) 0
      rw [h_t_bot, hq_mu] at h
      simpa [shift, unitVec] using h.symm
    rcases h_nu_link _ h_top h_dir_top with h_top_eq | h_top_eq
    · have h := congrFun (congrArg Link.x (h_bot_eq.trans h_top_eq.symm)) 0
      rw [h_t_bot, h_t_top] at h
      exact neg_one_ne_zero_of_two_le hL2 h
    · have h_qx0 : q.x 0 = 0 := by
        have h := congrFun (congrArg Link.x h_top_eq) 0
        rw [h_t_top] at h
        exact h.symm
      rw [h_qx0, zero_add] at h_qx0_add
      have h_two : (2 : ZMod L) = 0 :=
        (by ring : (2 : ZMod L) = 1 - (-1)).trans (sub_eq_zero.mpr h_qx0_add)
      exact two_ne_zero_of_three_le hL h_two
  · have hx : q.x = (plaquetteLinkAt (cubeBottomPlaquette L) k_bot).x :=
      (congrArg Link.x h_bot_eq).symm
    have hν : q.ν = (plaquetteLinkAt (cubeBottomPlaquette L) k_bot).μ :=
      (congrArg Link.μ h_bot_eq).symm
    fin_cases k_bot <;>
      { cases q with
        | mk qx qμ qν qh =>
          dsimp [plaquetteLinkAt, cubeBottomPlaquette, cubeLateralAt,
            cubeLateralPlaquette1, cubeLateralPlaquette2,
            cubeLateralPlaquette3, cubeLateralPlaquette4] at hx hq_mu hν ⊢
          subst hx hq_mu hν
          rfl }

/-- Any 4-plaquette product from `restPlaquettes L` containing at least one plaquette
`q₄ ∉ cubeLateralSet L` integrates to `0` against `fΘ * fp` on `gaugeHaarMeasure L` (`L ≥ 3`). -/
theorem integral_quartic_mul_probes_eq_zero_of_not_mem_cubeLateralSet
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) {q₁ q₂ q₃ q₄ : Plaquette L}
    (hq₁ : q₁ ∈ restPlaquettes L) (hq₂ : q₂ ∈ restPlaquettes L)
    (hq₃ : q₃ ∈ restPlaquettes L) (hq₄ : q₄ ∈ restPlaquettes L)
    (hq₄_not_lat : q₄ ∉ cubeLateralSet L) :
    (∫ U : GaugeConfig L,
      halfTraceRe (plaquetteHolonomy U q₁) *
        halfTraceRe (plaquetteHolonomy U q₂) *
        halfTraceRe (plaquetteHolonomy U q₃) *
        halfTraceRe (plaquetteHolonomy U q₄) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hL2 : 2 ≤ L := by omega
  simp only [restPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq₁ hq₂ hq₃ hq₄
  let Q : Fin 4 → Plaquette L := ![q₁, q₂, q₃, q₄]
  have h_uncov :
      (∃ k : Fin 4, ∀ j : Fin 4, plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks (Q j)) ∨
      (∃ k : Fin 4, ∀ j : Fin 4, plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks (Q j)) := by
    by_contra h_neither
    have h_all_bot :
        ∀ k : Fin 4, ∃ j : Fin 4, plaquetteLinkAt (cubeBottomPlaquette L) k ∈ plaquetteLinks (Q j) := by
      intro k; by_contra hk; exact h_neither (Or.inl ⟨k, fun j hj => hk ⟨j, hj⟩⟩)
    have h_all_top :
        ∀ k : Fin 4, ∃ j : Fin 4, plaquetteLinkAt (cubeTopPlaquette L) k ∈ plaquetteLinks (Q j) := by
      intro k; by_contra hk; exact h_neither (Or.inr ⟨k, fun j hj => hk ⟨j, hj⟩⟩)
    choose f_bot hf_bot using h_all_bot
    choose f_top hf_top using h_all_top
    have hQ_bot : ∀ j : Fin 4, Q j ≠ cubeBottomPlaquette L := by
      intro j; fin_cases j <;> [exact hq₁.1; exact hq₂.1; exact hq₃.1; exact hq₄.1]
    have hQ_top : ∀ j : Fin 4, Q j ≠ cubeTopPlaquette L := by
      intro j; fin_cases j <;> [exact hq₁.2; exact hq₂.2; exact hq₃.2; exact hq₄.2]
    have hf_bot_inj : Function.Injective f_bot := by
      intro k₁ k₂ hfk
      exact plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL (hQ_bot (f_bot k₁))
        (hf_bot k₁) (hfk ▸ hf_bot k₂)
    have hf_top_inj : Function.Injective f_top := by
      intro k₁ k₂ hfk
      exact plaquetteLinkAt_eq_of_mem_plaquetteLinks_of_ne hL (hQ_top (f_top k₁))
        (hf_top k₁) (hfk ▸ hf_top k₂)
    obtain ⟨k_bot, hk_bot⟩ := Finite.surjective_of_injective hf_bot_inj (3 : Fin 4)
    obtain ⟨k_top, hk_top⟩ := Finite.surjective_of_injective hf_top_inj (3 : Fin 4)
    have h_mem_bot : plaquetteLinkAt (cubeBottomPlaquette L) k_bot ∈ plaquetteLinks q₄ := by
      have h := hf_bot k_bot
      rw [hk_bot] at h
      exact h
    have h_mem_top : plaquetteLinkAt (cubeTopPlaquette L) k_top ∈ plaquetteLinks q₄ := by
      have h := hf_top k_top
      rw [hk_top] at h
      exact h
    have hq4_eq : q₄ = cubeLateralAt L k_bot :=
      eq_cubeLateralAt_of_mem_plaquetteLinks_bottom_and_top hL h_mem_bot h_mem_top
    exact hq₄_not_lat (hq4_eq ▸ cubeLateralAt_mem_cubeLateralSet L k_bot)
  have h1 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)
  have h2 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂)
  have h3 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)
  have h4 := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₄)
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  rcases h_uncov with ⟨k, hk⟩ | ⟨k, hk⟩
  · have hk_top : plaquetteLinkAt (cubeBottomPlaquette L) k ∉ plaquetteLinks (cubeTopPlaquette L) :=
      not_mem_plaquetteLinks_cubeTopPlaquette_of_mem_cubeBottomPlaquette hL2
        (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k)
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) *
            halfTraceRe (plaquetteHolonomy U q₄) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
        fun U : GaugeConfig L =>
          (halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) *
            halfTraceRe (plaquetteHolonomy U q₄) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      funext U; ring
    rw [h_pt]
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeBottomPlaquette L) (plaquetteLinkAt (cubeBottomPlaquette L) k)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeBottomPlaquette L) k) _
      ((((h1.mul h2).mul h3).mul h4).mul ht) (fun U g => ?_)
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ (hk 0) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ (hk 1) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ (hk 2) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₄ (hk 3) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeTopPlaquette L) hk_top g]
  · have hk_bot : plaquetteLinkAt (cubeTopPlaquette L) k ∉ plaquetteLinks (cubeBottomPlaquette L) :=
      not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
        (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k)
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) *
            halfTraceRe (plaquetteHolonomy U q₄) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
        fun U : GaugeConfig L =>
          (halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) *
            halfTraceRe (plaquetteHolonomy U q₄) *
            halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U; ring
    rw [h_pt]
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) k)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) k) _
      ((((h1.mul h2).mul h3).mul h4).mul hb) (fun U g => ?_)
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₁ (hk 0) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₂ (hk 1) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₃ (hk 2) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q₄ (hk 3) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L) hk_bot g]

theorem integral_sum_cube_mul_sub_lateral_probes_eq_zero
    {L : ℕ} [NeZero L] (hL : 3 ≤ L)
    (S₁ S₂ S₃ : Finset (Plaquette L))
    (hS₁ : S₁ ⊆ restPlaquettes L) (hS₂ : S₂ ⊆ restPlaquettes L) (hS₃ : S₃ ⊆ restPlaquettes L) :
    (∫ U : GaugeConfig L,
      (∑ q₁ ∈ S₁, halfTraceRe (plaquetteHolonomy U q₁)) *
        (∑ q₂ ∈ S₂, halfTraceRe (plaquetteHolonomy U q₂)) *
        (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
        (restCharacterSum U - lateralCharacterSum U) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) = 0 := by
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  have h_sub_eq (U : GaugeConfig L) :
      restCharacterSum U - lateralCharacterSum U =
        ∑ q₄ ∈ restPlaquettes L \ cubeLateralSet L, halfTraceRe (plaquetteHolonomy U q₄) := by
    unfold restCharacterSum lateralCharacterSum
    exact (Finset.sum_sdiff_eq_sub (cubeLateralSet_subset_restPlaquettes L)).symm
  have h_triple (q₁ : Plaquette L) (hq₁ : q₁ ∈ S₁)
      (q₂ : Plaquette L) (hq₂ : q₂ ∈ S₂)
      (q₃ : Plaquette L) (hq₃ : q₃ ∈ S₃) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q₁) *
          halfTraceRe (plaquetteHolonomy U q₂) *
          halfTraceRe (plaquetteHolonomy U q₃) *
          (restCharacterSum U - lateralCharacterSum U) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            halfTraceRe (plaquetteHolonomy U q₃) *
            (restCharacterSum U - lateralCharacterSum U) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
        fun U : GaugeConfig L =>
          ∑ q₄ ∈ restPlaquettes L \ cubeLateralSet L,
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃) *
              halfTraceRe (plaquetteHolonomy U q₄) *
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
      funext U
      rw [h_sub_eq U, Finset.mul_sum, Finset.sum_mul]
    rw [h_pt, integral_finsetSum]
    · refine Finset.sum_eq_zero (fun q₄ hq₄ => ?_)
      rw [Finset.mem_sdiff] at hq₄
      exact integral_quartic_mul_probes_eq_zero_of_not_mem_cubeLateralSet hL
        (hS₁ hq₁) (hS₂ hq₂) (hS₃ hq₃) hq₄.1 hq₄.2
    · intro q₄ _
      exact (((((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃))).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₄))).mul
        (hb.mul ht)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_pair (q₁ : Plaquette L) (hq₁ : q₁ ∈ S₁) (q₂ : Plaquette L) (hq₂ : q₂ ∈ S₂) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q₁) *
          halfTraceRe (plaquetteHolonomy U q₂) *
          (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
          (restCharacterSum U - lateralCharacterSum U) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            halfTraceRe (plaquetteHolonomy U q₂) *
            (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
            (restCharacterSum U - lateralCharacterSum U) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
        fun U : GaugeConfig L =>
          ∑ q₃ ∈ S₃,
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              halfTraceRe (plaquetteHolonomy U q₃) *
              (restCharacterSum U - lateralCharacterSum U) *
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
      funext U
      rw [Finset.mul_sum, Finset.sum_mul, Finset.sum_mul]
    rw [h_pt, integral_finsetSum]
    · exact Finset.sum_eq_zero (fun q₃ hq₃ => h_triple q₁ hq₁ q₂ hq₂ q₃ hq₃)
    · intro q₃ _
      exact (((((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃))).mul
        (continuous_restCharacterSum.sub continuous_lateralCharacterSum)).mul
        (hb.mul ht)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_single (q₁ : Plaquette L) (hq₁ : q₁ ∈ S₁) :
      (∫ U : GaugeConfig L,
        halfTraceRe (plaquetteHolonomy U q₁) *
          (∑ q₂ ∈ S₂, halfTraceRe (plaquetteHolonomy U q₂)) *
          (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
          (restCharacterSum U - lateralCharacterSum U) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        ∂(gaugeHaarMeasure L)) = 0 := by
    have h_pt :
        (fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U q₁) *
            (∑ q₂ ∈ S₂, halfTraceRe (plaquetteHolonomy U q₂)) *
            (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
            (restCharacterSum U - lateralCharacterSum U) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
        fun U : GaugeConfig L =>
          ∑ q₂ ∈ S₂,
            halfTraceRe (plaquetteHolonomy U q₁) *
              halfTraceRe (plaquetteHolonomy U q₂) *
              (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
              (restCharacterSum U - lateralCharacterSum U) *
              (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
                halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
      funext U
      rw [Finset.mul_sum S₂, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul]
    rw [h_pt, integral_finsetSum]
    · exact Finset.sum_eq_zero (fun q₂ hq₂ => h_pair q₁ hq₁ q₂ hq₂)
    · intro q₂ _
      exact (((((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
        (continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂))).mul
        (continuous_finsetSum _ (fun q₃ _ => continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)))).mul
        (continuous_restCharacterSum.sub continuous_lateralCharacterSum)).mul
        (hb.mul ht)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have h_outer :
      (fun U : GaugeConfig L =>
        (∑ q₁ ∈ S₁, halfTraceRe (plaquetteHolonomy U q₁)) *
          (∑ q₂ ∈ S₂, halfTraceRe (plaquetteHolonomy U q₂)) *
          (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
          (restCharacterSum U - lateralCharacterSum U) *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
      fun U : GaugeConfig L =>
        ∑ q₁ ∈ S₁,
          halfTraceRe (plaquetteHolonomy U q₁) *
            (∑ q₂ ∈ S₂, halfTraceRe (plaquetteHolonomy U q₂)) *
            (∑ q₃ ∈ S₃, halfTraceRe (plaquetteHolonomy U q₃)) *
            (restCharacterSum U - lateralCharacterSum U) *
            (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
              halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
    funext U
    rw [Finset.sum_mul, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul]
  rw [h_outer, integral_finsetSum]
  · exact Finset.sum_eq_zero (fun q₁ hq₁ => h_single q₁ hq₁)
  · intro q₁ _
    exact (((((continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₁)).mul
      (continuous_finsetSum _ (fun q₂ _ => continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₂)))).mul
      (continuous_finsetSum _ (fun q₃ _ => continuous_halfTraceRe.comp (continuous_plaquetteHolonomy q₃)))).mul
      (continuous_restCharacterSum.sub continuous_lateralCharacterSum)).mul
      (hb.mul ht)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

theorem integral_restCharacterSum_pow_four_mul_probes_eq_lateral
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    (∫ U : GaugeConfig L,
      (restCharacterSum U) ^ 4 *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) =
    (∫ U : GaugeConfig L,
      (lateralCharacterSum U) ^ 4 *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) := by
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  have hR := continuous_restCharacterSum (L := L)
  have hLat := continuous_lateralCharacterSum (L := L)
  have h_sub := cubeLateralSet_subset_restPlaquettes L
  have h1 := integral_sum_cube_mul_sub_lateral_probes_eq_zero hL
    (restPlaquettes L) (restPlaquettes L) (restPlaquettes L)
    (Finset.Subset.refl _) (Finset.Subset.refl _) (Finset.Subset.refl _)
  have h2 := integral_sum_cube_mul_sub_lateral_probes_eq_zero hL
    (restPlaquettes L) (restPlaquettes L) (cubeLateralSet L)
    (Finset.Subset.refl _) (Finset.Subset.refl _) h_sub
  have h3 := integral_sum_cube_mul_sub_lateral_probes_eq_zero hL
    (restPlaquettes L) (cubeLateralSet L) (cubeLateralSet L)
    (Finset.Subset.refl _) h_sub h_sub
  have h4 := integral_sum_cube_mul_sub_lateral_probes_eq_zero hL
    (cubeLateralSet L) (cubeLateralSet L) (cubeLateralSet L)
    h_sub h_sub h_sub
  change (∫ U : GaugeConfig L,
      restCharacterSum U * restCharacterSum U * restCharacterSum U *
        (restCharacterSum U - lateralCharacterSum U) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) = 0 at h1
  change (∫ U : GaugeConfig L,
      restCharacterSum U * restCharacterSum U * lateralCharacterSum U *
        (restCharacterSum U - lateralCharacterSum U) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) = 0 at h2
  change (∫ U : GaugeConfig L,
      restCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
        (restCharacterSum U - lateralCharacterSum U) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) = 0 at h3
  change (∫ U : GaugeConfig L,
      lateralCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
        (restCharacterSum U - lateralCharacterSum U) *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) = 0 at h4
  let D₁ : GaugeConfig L → ℝ := fun U =>
    restCharacterSum U * restCharacterSum U * restCharacterSum U *
      (restCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  let D₂ : GaugeConfig L → ℝ := fun U =>
    restCharacterSum U * restCharacterSum U * lateralCharacterSum U *
      (restCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  let D₃ : GaugeConfig L → ℝ := fun U =>
    restCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
      (restCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  let D₄ : GaugeConfig L → ℝ := fun U =>
    lateralCharacterSum U * lateralCharacterSum U * lateralCharacterSum U *
      (restCharacterSum U - lateralCharacterSum U) *
      (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
        halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  have hD₁_cont : Continuous D₁ := ((((hR.mul hR).mul hR).mul (hR.sub hLat)).mul (hb.mul ht))
  have hD₂_cont : Continuous D₂ := ((((hR.mul hR).mul hLat).mul (hR.sub hLat)).mul (hb.mul ht))
  have hD₃_cont : Continuous D₃ := ((((hR.mul hLat).mul hLat).mul (hR.sub hLat)).mul (hb.mul ht))
  have hD₄_cont : Continuous D₄ := ((((hLat.mul hLat).mul hLat).mul (hR.sub hLat)).mul (hb.mul ht))
  have h_pt :
      (fun U : GaugeConfig L =>
        (restCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
      fun U : GaugeConfig L =>
        ((((lateralCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) + D₁ U) + D₂ U) + D₃ U) + D₄ U := by
    funext U
    dsimp only [D₁, D₂, D₃, D₄]
    ring
  rw [h_pt,
      integral_add5_apply
        (fun U => (lateralCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))))
        D₁ D₂ D₃ D₄
        ((hLat.pow 4).mul (hb.mul ht)) hD₁_cont hD₂_cont hD₃_cont hD₄_cont,
      h1, h2, h3, h4]
  ring

theorem lateralCharacterSum_eq_sum_four {L : ℕ} (hL : 2 ≤ L) (U : GaugeConfig L) :
    lateralCharacterSum U =
      halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L)) +
        halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L)) +
        halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L)) +
        halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L)) := by
  have h12 : cubeLateralPlaquette1 L ≠ cubeLateralPlaquette2 L := by
    intro h
    have hν := congrArg Plaquette.ν h
    simp [cubeLateralPlaquette1, cubeLateralPlaquette2] at hν
  have h14 : cubeLateralPlaquette1 L ≠ cubeLateralPlaquette4 L := by
    intro h
    have hν := congrArg Plaquette.ν h
    simp [cubeLateralPlaquette1, cubeLateralPlaquette4] at hν
  have h23 : cubeLateralPlaquette2 L ≠ cubeLateralPlaquette3 L := by
    intro h
    have hν := congrArg Plaquette.ν h
    simp [cubeLateralPlaquette2, cubeLateralPlaquette3] at hν
  have h34 : cubeLateralPlaquette3 L ≠ cubeLateralPlaquette4 L := by
    intro h
    have hν := congrArg Plaquette.ν h
    simp [cubeLateralPlaquette3, cubeLateralPlaquette4] at hν
  have h13 : cubeLateralPlaquette1 L ≠ cubeLateralPlaquette3 L := by
    intro h
    exact (one_ne_zero_of_two_le hL).symm
      (by simpa [cubeLateralPlaquette1, cubeLateralPlaquette3, cubeBottomBase, shift, unitVec]
        using congrFun (congrArg Plaquette.x h) 2)
  have h24 : cubeLateralPlaquette2 L ≠ cubeLateralPlaquette4 L := by
    intro h
    exact one_ne_zero_of_two_le hL
      (by simpa [cubeLateralPlaquette2, cubeLateralPlaquette4, cubeBottomBase, shift, unitVec]
        using congrFun (congrArg Plaquette.x h) 1)
  unfold lateralCharacterSum cubeLateralSet
  rw [Finset.sum_insert (by simp [h12, h13, h14]),
      Finset.sum_insert (by simp [h23, h24]),
      Finset.sum_insert (by simp [h34]),
      Finset.sum_singleton]
  ring

theorem integral_lateralCharacterSum_pow_four_mul_probes_eq
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    (∫ U : GaugeConfig L,
      (lateralCharacterSum U) ^ 4 *
        (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
      ∂(gaugeHaarMeasure L)) =
    24 * cubeSixFaceHaarIntegral := by
  have hL2 : 2 ≤ L := by omega
  let x₀ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 0))
  let x₁ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 1))
  let x₂ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 2))
  let x₃ : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeLateralAt L 3))
  have hx₀ : Continuous x₀ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 0))
  have hx₁ : Continuous x₁ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 1))
  have hx₂ : Continuous x₂ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 2))
  have hx₃ : Continuous x₃ := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeLateralAt L 3))
  have hb := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeBottomPlaquette L))
  have ht := continuous_halfTraceRe.comp (continuous_plaquetteHolonomy (cubeTopPlaquette L))
  let P₀ : GaugeConfig L → ℝ := fun U =>
    ((x₁ U + x₂ U + x₃ U) ^ 4 - (x₁ U + x₂ U) ^ 4 - (x₁ U + x₃ U) ^ 4 -
      (x₂ U + x₃ U) ^ 4 + x₁ U ^ 4 + x₂ U ^ 4 + x₃ U ^ 4) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
  let P₁ : GaugeConfig L → ℝ := fun U =>
    ((x₀ U + x₂ U + x₃ U) ^ 4 - (x₀ U + x₂ U) ^ 4 - (x₀ U + x₃ U) ^ 4 + x₀ U ^ 4) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
  let P₂ : GaugeConfig L → ℝ := fun U =>
    ((x₀ U + x₁ U + x₃ U) ^ 4 - (x₀ U + x₁ U) ^ 4) *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
  let P₃ : GaugeConfig L → ℝ := fun U =>
    (x₀ U + x₁ U + x₂ U) ^ 4 *
      halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
  have hP₀_cont : Continuous P₀ := by
    refine ((((((((hx₁.add hx₂).add hx₃).pow 4).sub ((hx₁.add hx₂).pow 4)).sub
      ((hx₁.add hx₃).pow 4)).sub ((hx₂.add hx₃).pow 4)).add (hx₁.pow 4)).add
      (hx₂.pow 4) |>.add (hx₃.pow 4)).mul hb
  have hP₁_cont : Continuous P₁ := by
    refine ((((((hx₀.add hx₂).add hx₃).pow 4).sub ((hx₀.add hx₂).pow 4)).sub
      ((hx₀.add hx₃).pow 4)).add (hx₀.pow 4)).mul hb
  have hP₂_cont : Continuous P₂ :=
    ((((hx₀.add hx₁).add hx₃).pow 4).sub ((hx₀.add hx₁).pow 4)).mul hb
  have hP₃_cont : Continuous P₃ :=
    (((hx₀.add hx₁).add hx₂).pow 4).mul hb
  have hP₀_zero :
      (∫ U : GaugeConfig L,
        P₀ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 0)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 0) P₀ hP₀_cont (fun U g => ?_)
    dsimp only [P₀, x₁, x₂, x₃]
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 1)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (0 : Fin 4) ≠ 1)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 2)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (0 : Fin 4) ≠ 2)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 3)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (0 : Fin 4) ≠ 3)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 0)) g]
  have hP₁_zero :
      (∫ U : GaugeConfig L,
        P₁ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 1)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 1) P₁ hP₁_cont (fun U g => ?_)
    dsimp only [P₁, x₀, x₂, x₃]
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 0)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (1 : Fin 4) ≠ 0)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 2)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (1 : Fin 4) ≠ 2)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 3)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (1 : Fin 4) ≠ 3)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 1)) g]
  have hP₂_zero :
      (∫ U : GaugeConfig L,
        P₂ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 2)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 2) P₂ hP₂_cont (fun U g => ?_)
    dsimp only [P₂, x₀, x₁, x₃]
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 0)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (2 : Fin 4) ≠ 0)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 1)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (2 : Fin 4) ≠ 1)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 3)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (2 : Fin 4) ≠ 3)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 2)) g]
  have hP₃_zero :
      (∫ U : GaugeConfig L,
        P₃ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L)) = 0 := by
    refine integral_gaugeHaarMeasure_mul_plaquetteHolonomy_eq_zero_of_mem_plaquetteLinks
      hL2 (cubeTopPlaquette L) (plaquetteLinkAt (cubeTopPlaquette L) 3)
      (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 3) P₃ hP₃_cont (fun U g => ?_)
    dsimp only [P₃, x₀, x₁, x₂]
    rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 0)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (3 : Fin 4) ≠ 0)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 1)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (3 : Fin 4) ≠ 1)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeLateralAt L 2)
          (not_mem_plaquetteLinks_cubeLateralAt_of_ne hL (by decide : (3 : Fin 4) ≠ 2)) g,
        plaquetteHolonomy_update_of_not_mem_plaquetteLinks U (cubeBottomPlaquette L)
          (not_mem_plaquetteLinks_cubeBottomPlaquette_of_mem_cubeTopPlaquette hL2
            (plaquetteLinkAt_mem_plaquetteLinks (cubeTopPlaquette L) 3)) g]
  let M_six : GaugeConfig L → ℝ := fun U =>
    24 * (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
      halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette1 L)) *
      halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette2 L)) *
      halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette3 L)) *
      halfTraceRe (plaquetteHolonomy U (cubeLateralPlaquette4 L)) *
      halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
  have hM_six_cont : Continuous M_six :=
    continuous_const.mul (((((hb.mul hx₀).mul hx₁).mul hx₂).mul hx₃).mul ht)
  have hM_six_int : (∫ U : GaugeConfig L, M_six U ∂(gaugeHaarMeasure L)) = 24 * cubeSixFaceHaarIntegral := by
    dsimp only [M_six]
    rw [integral_const_mul, integral_gaugeHaarMeasure_cubeSixFace_eq_cubeSixFaceHaarIntegral hL2]
  have h_pt :
      (fun U : GaugeConfig L =>
        (lateralCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))) =
      fun U : GaugeConfig L =>
        ((((M_six U + P₀ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
          P₁ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
          P₂ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) +
          P₃ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))) := by
    funext U
    rw [lateralCharacterSum_eq_sum_four hL2 U]
    dsimp only [M_six, P₀, P₁, P₂, P₃, x₀, x₁, x₂, x₃, cubeLateralAt]
    ring
  rw [h_pt,
      integral_add5_apply
        M_six
        (fun U => P₀ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        (fun U => P₁ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        (fun U => P₂ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        (fun U => P₃ U * halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        hM_six_cont (hP₀_cont.mul ht) (hP₁_cont.mul ht) (hP₂_cont.mul ht) (hP₃_cont.mul ht),
      hM_six_int, hP₀_zero, hP₁_zero, hP₂_zero, hP₃_zero]
  ring

/-- Master Step 2 theorem — Full-torus degree-4 connected Gibbs Taylor coefficient equals
`cubeSixFaceHaarIntegral` (`= 4 ^ (-5)`, `L ≥ 3`):
in the connected Gibbs covariance numerator
`(∫ U, exp (β * S U) * (fΘ U * fp U)) * (∫ U', exp (β * S U')) -
  (∫ U, exp (β * S U) * fΘ U) * (∫ U', exp (β * S U') * fp U')`
with full-torus action sum `S U = totalCharacterSum U = ∑_{q : Plaquette L} halfTraceRe (U_q)`,
the complete degree-4 Cauchy-product coefficient of `β ^ 4` equals `cubeSixFaceHaarIntegral = 4 ^ (-5)`
for every `L ≥ 3`. All volume-dependent `O(L^4)` disconnected vacuum contractions and all probe
fourth-moment self-contractions cancel identically. -/
theorem fullTorus_connected_taylor_coeff_four_eq_cubeSixFaceHaarIntegral
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) :
    let S : GaugeConfig L → ℝ := totalCharacterSum
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    let M₂ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * (fΘ U * fp U) ∂(gaugeHaarMeasure L)
    let M₀ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k ∂(gaugeHaarMeasure L)
    let MΘ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * fΘ U ∂(gaugeHaarMeasure L)
    let Mp (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * fp U ∂(gaugeHaarMeasure L)
    (1 / 24 : ℝ) * M₂ 4 * M₀ 0 + (1 / 6 : ℝ) * M₂ 3 * M₀ 1 +
      (1 / 4 : ℝ) * M₂ 2 * M₀ 2 + (1 / 6 : ℝ) * M₂ 1 * M₀ 3 +
      (1 / 24 : ℝ) * M₂ 0 * M₀ 4 -
    ((1 / 24 : ℝ) * MΘ 4 * Mp 0 + (1 / 6 : ℝ) * MΘ 3 * Mp 1 +
      (1 / 4 : ℝ) * MΘ 2 * Mp 2 + (1 / 6 : ℝ) * MΘ 1 * Mp 3 +
      (1 / 24 : ℝ) * MΘ 0 * Mp 4) =
    cubeSixFaceHaarIntegral := by
  intro S fΘ fp M₂ M₀ MΘ Mp
  have hL2 : 2 ≤ L := by omega
  have hM₂_0 : M₂ 0 = 0 := by
    dsimp [M₂, fΘ, fp]
    have h_pt :
        (fun U : GaugeConfig L =>
          (S U) ^ 0 *
            (physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U *
              physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U)) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      rw [pow_zero, one_mul,
          physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    rw [h_pt, integral_gaugeHaarMeasure_plaquetteHolonomy_mul_eq_ite hL2]
    simp [cubeBottomPlaquette_ne_cubeTopPlaquette hL2]
  have hMΘ_0 : MΘ 0 = 0 := by
    dsimp [MΘ, fΘ]
    have h_pt :
        (fun U : GaugeConfig L =>
          (S U) ^ 0 *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect U) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) := by
      funext U
      rw [pow_zero, one_mul,
          physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U]
    rw [h_pt, integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL2]
  have hMp_0 : Mp 0 = 0 := by
    dsimp [Mp, fp]
    have h_pt :
        (fun U : GaugeConfig L =>
          (S U) ^ 0 *
            physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos) U) =
        fun U : GaugeConfig L =>
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)) := by
      funext U
      rw [pow_zero, one_mul,
          physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
    rw [h_pt, integral_gaugeHaarMeasure_plaquetteHolonomy_eq_zero hL2]
  have hM₀_0 : M₀ 0 = 1 := by
    dsimp [M₀]
    simp_rw [pow_zero, integral_const, probReal_univ, one_smul]
  have hM₀_1 : M₀ 1 = 0 := by
    dsimp [M₀, S]
    simp_rw [pow_one]
    exact integral_gaugeHaarMeasure_totalCharacterSum_eq_zero hL2
  have hM₂_1 : M₂ 1 = 0 := by
    dsimp [M₂, S, fΘ, fp]
    simp_rw [pow_one]
    exact (integral_gaugeHaarMeasure_totalCharacterSum_mul_probes_eq_zero hL).2
  have hMΘ_1 : MΘ 1 = 1 / 4 := by
    dsimp [MΘ, S, fΘ]
    simp_rw [pow_one]
    exact (integral_gaugeHaarMeasure_totalCharacterSum_single_probes_eq_quarter hL2).1
  have hMp_1 : Mp 1 = 1 / 4 := by
    dsimp [Mp, S, fp]
    simp_rw [pow_one]
    exact (integral_gaugeHaarMeasure_totalCharacterSum_single_probes_eq_quarter hL2).2
  have hM₂_2 : M₂ 2 = 1 / 8 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_mul_probes_and_connected_eq_zero hL).1
  have hMΘ_2 : MΘ 2 = 0 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_single_probes_and_cube_eq_zero hL).1
  have hMp_2 : Mp 2 = 0 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_single_probes_and_cube_eq_zero hL).2.1
  have hM₀_3 : M₀ 3 = 0 :=
    (integral_gaugeHaarMeasure_totalCharacterSum_sq_single_probes_and_cube_eq_zero hL).2.2
  have hM₂_3 : M₂ 3 = 0 :=
    integral_gaugeHaarMeasure_totalCharacterSum_cube_mul_probes_eq_zero hL
  have hM₀_2 : M₀ 2 = 1 / 2 + (∫ U : GaugeConfig L, (restCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) :=
    integral_gaugeHaarMeasure_totalCharacterSum_sq_eq_half_add_restCharacterSum_sq hL
  have h_M₂_4_eq :
      M₂ 4 =
      ∫ U : GaugeConfig L,
        (totalCharacterSum U) ^ 4 *
          (halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L)) *
            halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L)))
        ∂(gaugeHaarMeasure L) := by
    dsimp [M₂, S, fΘ, fp]
    congr 1; funext U
    rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U,
        physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
  have h_MΘ_3_eq :
      MΘ 3 =
      ∫ U : GaugeConfig L,
        (totalCharacterSum U) ^ 3 *
          halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
        ∂(gaugeHaarMeasure L) := by
    dsimp [MΘ, S, fΘ]
    congr 1; funext U
    rw [physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U]
  have h_Mp_3_eq :
      Mp 3 =
      ∫ U : GaugeConfig L,
        (totalCharacterSum U) ^ 3 *
          halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
        ∂(gaugeHaarMeasure L) := by
    dsimp [Mp, S, fp]
    congr 1; funext U
    rw [physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U]
  have h_comb :
      M₂ 4 - MΘ 3 - Mp 3 =
      -3 / 8 -
        (3 / 4) * (∫ U : GaugeConfig L, (restCharacterSum U) ^ 2 ∂(gaugeHaarMeasure L)) +
        24 * cubeSixFaceHaarIntegral := by
    rw [h_M₂_4_eq, h_MΘ_3_eq, h_Mp_3_eq,
        integral_totalCharacterSum_pow_four_probes_sub_cubic_eq hL,
        integral_restCharacterSum_pow_four_mul_probes_eq_lateral hL,
        integral_lateralCharacterSum_pow_four_mul_probes_eq hL]
  rw [hM₀_0, hM₂_3, hM₀_1, hM₂_2, hM₀_2, hM₂_1, hM₀_3, hM₂_0,
      hMp_0, hMp_1, hMΘ_2, hMp_2, hMΘ_1, hMΘ_0]
  linear_combination (1 / 24 : ℝ) * h_comb

/-- Complete degree-`≤ 4` Taylor jet of the full-torus connected Gibbs covariance numerator (`L ≥ 3`):
combining `fullTorus_connected_taylor_coeffs_zero_through_three_eq_zero` (degrees `0, 1, 2, 3` vanish)
and `fullTorus_connected_taylor_coeff_four_eq_cubeSixFaceHaarIntegral` (degree `4` equals
`cubeSixFaceHaarIntegral = 4 ^ (-5)`), the entire degree-`≤ 4` Cauchy-product polynomial of the
full-torus connected Gibbs covariance numerator equals `cubeSixFaceHaarIntegral * β ^ 4` for all
`L ≥ 3` and all `β : ℝ`, with partition normalization `M₀ 0 ^ 2 = 1` at `β = 0`.
Note: bounding the remaining degree-`≥ 5` connected tail and partition denominator uniformly in `L`
for `0 < β ≤ canonicalCrossoverBetaHi` (`CanonicalProbeClusterRemainder`, `R1`) remains open. -/
theorem fullTorus_connected_taylor_jet_four_eq_cubeSixFaceHaarIntegral_mul_beta_pow_four
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) :
    let S : GaugeConfig L → ℝ := totalCharacterSum
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    let M₂ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * (fΘ U * fp U) ∂(gaugeHaarMeasure L)
    let M₀ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k ∂(gaugeHaarMeasure L)
    let MΘ (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * fΘ U ∂(gaugeHaarMeasure L)
    let Mp (k : ℕ) : ℝ := ∫ U : GaugeConfig L, (S U) ^ k * fp U ∂(gaugeHaarMeasure L)
    let C₀ : ℝ := M₂ 0 * M₀ 0 - MΘ 0 * Mp 0
    let C₁ : ℝ := M₂ 1 * M₀ 0 + M₂ 0 * M₀ 1 - (MΘ 1 * Mp 0 + MΘ 0 * Mp 1)
    let C₂ : ℝ :=
      (1 / 2 : ℝ) * M₂ 2 * M₀ 0 + M₂ 1 * M₀ 1 + M₂ 0 * ((1 / 2 : ℝ) * M₀ 2) -
        ((1 / 2 : ℝ) * MΘ 2 * Mp 0 + MΘ 1 * Mp 1 + MΘ 0 * ((1 / 2 : ℝ) * Mp 2))
    let C₃ : ℝ :=
      (1 / 6 : ℝ) * M₂ 3 * M₀ 0 + (1 / 2 : ℝ) * M₂ 2 * M₀ 1 +
          M₂ 1 * ((1 / 2 : ℝ) * M₀ 2) + M₂ 0 * ((1 / 6 : ℝ) * M₀ 3) -
        ((1 / 6 : ℝ) * MΘ 3 * Mp 0 + (1 / 2 : ℝ) * MΘ 2 * Mp 1 +
          MΘ 1 * ((1 / 2 : ℝ) * Mp 2) + MΘ 0 * ((1 / 6 : ℝ) * Mp 3))
    let C₄ : ℝ :=
      (1 / 24 : ℝ) * M₂ 4 * M₀ 0 + (1 / 6 : ℝ) * M₂ 3 * M₀ 1 +
          (1 / 4 : ℝ) * M₂ 2 * M₀ 2 + (1 / 6 : ℝ) * M₂ 1 * M₀ 3 +
          (1 / 24 : ℝ) * M₂ 0 * M₀ 4 -
        ((1 / 24 : ℝ) * MΘ 4 * Mp 0 + (1 / 6 : ℝ) * MΘ 3 * Mp 1 +
          (1 / 4 : ℝ) * MΘ 2 * Mp 2 + (1 / 6 : ℝ) * MΘ 1 * Mp 3 +
          (1 / 24 : ℝ) * MΘ 0 * Mp 4)
    (C₀ + C₁ * β + C₂ * β ^ 2 + C₃ * β ^ 3 + C₄ * β ^ 4 =
      cubeSixFaceHaarIntegral * β ^ 4) ∧
    (M₀ 0) ^ 2 = 1 := by
  intro S fΘ fp M₂ M₀ MΘ Mp C₀ C₁ C₂ C₃ C₄
  obtain ⟨h0, h1, h2, h3⟩ := fullTorus_connected_taylor_coeffs_zero_through_three_eq_zero hL
  have h4 := fullTorus_connected_taylor_coeff_four_eq_cubeSixFaceHaarIntegral hL
  change C₀ = 0 at h0
  change C₁ = 0 at h1
  change C₂ = 0 at h2
  change C₃ = 0 at h3
  change C₄ = cubeSixFaceHaarIntegral at h4
  have hM₀_0 : M₀ 0 = 1 := by
    dsimp [M₀]
    simp_rw [pow_zero, integral_const, probReal_univ, one_smul]
  refine ⟨?_, ?_⟩
  · rw [h0, h1, h2, h3, h4]; ring
  · rw [hM₀_0]; ring

/-! #### Stage p3.B3 (Part 5): Volume-Uniform Local-Exterior Action Split & Partition Ratio Sandwich

To bound the normalized connected remainder in `CanonicalProbeClusterRemainder` (`R1`) uniformly in
the torus side `L ≥ 4`, any volume-dependent `O(L^4)` contribution from plaquettes far from the
canonical unit 3-cube must cancel between the 2-replica numerator and the partition denominator
`characterPartition L β ^ 2`. We formalize the local-versus-exterior action decomposition relative
to the 6-face unit-cube link support `cubeLinks L`:
1. `cubeTouchPlaquettes L` consists of plaquettes `q : Plaquette L` sharing at least one boundary link
   with `cubeLinks L`, while `cubeExteriorPlaquettes L` consists of plaquettes link-disjoint from `cubeLinks L`.
2. `cubeExteriorCharacterSum U` is strictly invariant under single-link updates `updateGaugeLink L U e.x e.μ g`
   and center twists `twistLinkNegOne e` for every cube link `e ∈ cubeLinks L`.
3. `|cubeTouchCharacterSum U| ≤ (cubeTouchPlaquettes L).card`, yielding the exact two-sided partition
   sandwich
   `exp (-β * card (cubeTouchPlaquettes L)) * cubeExteriorPartition L β ≤ characterPartition L β ≤ exp (β * card (cubeTouchPlaquettes L)) * cubeExteriorPartition L β`
   and bounding the exterior-to-full squared partition ratio `(cubeExteriorPartition L β / characterPartition L β) ^ 2`
   by `exp (2 * β * card (cubeTouchPlaquettes L))` with zero `O(L^4)` exterior volume factor. -/

/-- The finite set of all 6 faces of the canonical unit 3-cube (`cubeBottomPlaquette L`,
`cubeTopPlaquette L`, and the 4 lateral temporal plaquettes `cubeLateralSet L`). -/
def cubeSixFaceFinset (L : ℕ) : Finset (Plaquette L) :=
  insert (cubeBottomPlaquette L) (insert (cubeTopPlaquette L) (cubeLateralSet L))

/-- The finite set of boundary links belonging to the 6 faces of the canonical unit 3-cube (`≤ 24` links). -/
def cubeLinks (L : ℕ) : Finset (Link L) :=
  (cubeSixFaceFinset L).biUnion plaquetteLinks

/-- Plaquettes of `Plaquette L` that share at least one boundary link with `cubeLinks L`. -/
def cubeTouchPlaquettes (L : ℕ) [NeZero L] : Finset (Plaquette L) :=
  Finset.univ.filter (fun q : Plaquette L => ¬ Disjoint (plaquetteLinks q) (cubeLinks L))

/-- Exterior plaquettes of `Plaquette L` whose 4 boundary links are disjoint from `cubeLinks L`. -/
def cubeExteriorPlaquettes (L : ℕ) [NeZero L] : Finset (Plaquette L) :=
  Finset.univ.filter (fun q : Plaquette L => Disjoint (plaquetteLinks q) (cubeLinks L))

theorem disjoint_cubeTouchPlaquettes_cubeExteriorPlaquettes (L : ℕ) [NeZero L] :
    Disjoint (cubeTouchPlaquettes L) (cubeExteriorPlaquettes L) := by
  rw [Finset.disjoint_left]
  intro q hq_touch hq_ext
  simp only [cubeTouchPlaquettes, cubeExteriorPlaquettes, Finset.mem_filter, Finset.mem_univ,
    true_and] at hq_touch hq_ext
  exact hq_touch hq_ext

theorem union_cubeTouchPlaquettes_cubeExteriorPlaquettes (L : ℕ) [NeZero L] :
    cubeTouchPlaquettes L ∪ cubeExteriorPlaquettes L = (Finset.univ : Finset (Plaquette L)) := by
  ext q
  simp only [cubeTouchPlaquettes, cubeExteriorPlaquettes, Finset.mem_union, Finset.mem_filter,
    Finset.mem_univ, true_and, iff_true]
  exact Or.symm (Classical.em (Disjoint (plaquetteLinks q) (cubeLinks L)))

theorem not_mem_plaquetteLinks_of_mem_cubeExteriorPlaquettes {L : ℕ} [NeZero L]
    {q : Plaquette L} (hq : q ∈ cubeExteriorPlaquettes L)
    {e : Link L} (he : e ∈ cubeLinks L) :
    e ∉ plaquetteLinks q := by
  simp only [cubeExteriorPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and] at hq
  exact Finset.disjoint_right.mp hq he

/-- Local character sum over plaquettes touching `cubeLinks L`. -/
noncomputable def cubeTouchCharacterSum {L : ℕ} [NeZero L] (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ cubeTouchPlaquettes L, halfTraceRe (plaquetteHolonomy U q)

/-- Exterior character sum over plaquettes link-disjoint from `cubeLinks L`. -/
noncomputable def cubeExteriorCharacterSum {L : ℕ} [NeZero L] (U : GaugeConfig L) : ℝ :=
  ∑ q ∈ cubeExteriorPlaquettes L, halfTraceRe (plaquetteHolonomy U q)

@[continuity, fun_prop]
theorem continuous_cubeTouchCharacterSum {L : ℕ} [NeZero L] :
    Continuous (cubeTouchCharacterSum (L := L)) := by
  unfold cubeTouchCharacterSum
  fun_prop

@[continuity, fun_prop]
theorem continuous_cubeExteriorCharacterSum {L : ℕ} [NeZero L] :
    Continuous (cubeExteriorCharacterSum (L := L)) := by
  unfold cubeExteriorCharacterSum
  fun_prop

/-- Exact additive split of the full-torus character sum into local cube-touching and exterior parts:
`totalCharacterSum U = cubeTouchCharacterSum U + cubeExteriorCharacterSum U`. -/
theorem totalCharacterSum_eq_cubeTouch_add_cubeExterior {L : ℕ} [NeZero L]
    (U : GaugeConfig L) :
    totalCharacterSum U = cubeTouchCharacterSum U + cubeExteriorCharacterSum U := by
  unfold totalCharacterSum cubeTouchCharacterSum cubeExteriorCharacterSum
  rw [← union_cubeTouchPlaquettes_cubeExteriorPlaquettes L,
      Finset.sum_union (disjoint_cubeTouchPlaquettes_cubeExteriorPlaquettes L)]

/-- Updating any link `e ∈ cubeLinks L` leaves the exterior character sum `cubeExteriorCharacterSum U`
strictly invariant. -/
theorem cubeExteriorCharacterSum_update_of_mem_cubeLinks {L : ℕ} [NeZero L]
    (U : GaugeConfig L) {e : Link L} (he : e ∈ cubeLinks L) (g : SU2) :
    cubeExteriorCharacterSum (updateGaugeLink L U e.x e.μ g) = cubeExteriorCharacterSum U := by
  unfold cubeExteriorCharacterSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_update_of_not_mem_plaquetteLinks U q
      (not_mem_plaquetteLinks_of_mem_cubeExteriorPlaquettes hq he) g]

/-- Twisting any link `e ∈ cubeLinks L` by `twistLinkNegOne e` leaves the exterior character sum
`cubeExteriorCharacterSum U` strictly invariant. -/
theorem cubeExteriorCharacterSum_twistLinkNegOne_of_mem_cubeLinks {L : ℕ} [NeZero L]
    (U : GaugeConfig L) {e : Link L} (he : e ∈ cubeLinks L) :
    cubeExteriorCharacterSum (twistLinkNegOne e U) = cubeExteriorCharacterSum U := by
  unfold cubeExteriorCharacterSum
  refine Finset.sum_congr rfl fun q hq => ?_
  rw [plaquetteHolonomy_twistLinkNegOne_of_not_mem_plaquetteLinks U q
      (not_mem_plaquetteLinks_of_mem_cubeExteriorPlaquettes hq he)]

/-- Pointwise bound `|cubeTouchCharacterSum U| ≤ (cubeTouchPlaquettes L).card` for every configuration
`U : GaugeConfig L`. -/
theorem abs_cubeTouchCharacterSum_le_card {L : ℕ} [NeZero L] (U : GaugeConfig L) :
    |cubeTouchCharacterSum U| ≤ ((cubeTouchPlaquettes L).card : ℝ) := by
  unfold cubeTouchCharacterSum
  calc
    |∑ q ∈ cubeTouchPlaquettes L, halfTraceRe (plaquetteHolonomy U q)|
      ≤ ∑ q ∈ cubeTouchPlaquettes L, |halfTraceRe (plaquetteHolonomy U q)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _q ∈ cubeTouchPlaquettes L, (1 : ℝ) :=
        Finset.sum_le_sum fun q _ => abs_halfTraceRe_le_one (plaquetteHolonomy U q)
    _ = ((cubeTouchPlaquettes L).card : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_one]

/-- Exterior Boltzmann weight `exp (β * cubeExteriorCharacterSum U)` on `GaugeConfig L`. -/
noncomputable def cubeExteriorBoltzmannWeight {L : ℕ} [NeZero L] (β : ℝ) (U : GaugeConfig L) : ℝ :=
  Real.exp (β * cubeExteriorCharacterSum U)

/-- Exterior partition function `∫ U, cubeExteriorBoltzmannWeight β U ∂(gaugeHaarMeasure L)`. -/
noncomputable def cubeExteriorPartition (L : ℕ) [NeZero L] (β : ℝ) : ℝ :=
  ∫ U : GaugeConfig L, cubeExteriorBoltzmannWeight β U ∂(gaugeHaarMeasure L)

@[continuity, fun_prop]
theorem continuous_cubeExteriorBoltzmannWeight {L : ℕ} [NeZero L] (β : ℝ) :
    Continuous (cubeExteriorBoltzmannWeight (L := L) β) := by
  unfold cubeExteriorBoltzmannWeight
  fun_prop

/-- Exact factorization of `characterBoltzmannWeight β U` into the local cube-touching exponential factor
and the `cubeLinks`-invariant exterior weight `cubeExteriorBoltzmannWeight β U`. -/
theorem characterBoltzmannWeight_eq_exp_cubeTouch_mul_cubeExteriorBoltzmannWeight
    {L : ℕ} [NeZero L] (β : ℝ) (U : GaugeConfig L) :
    characterBoltzmannWeight β U =
      Real.exp (β * cubeTouchCharacterSum U) * cubeExteriorBoltzmannWeight β U := by
  unfold characterBoltzmannWeight cubeExteriorBoltzmannWeight
  rw [← Real.exp_add, ← mul_add, ← totalCharacterSum_eq_cubeTouch_add_cubeExterior U]
  rfl

/-- Two-sided sandwich comparing `characterPartition L β` and `cubeExteriorPartition L β` (`0 ≤ β`):
`exp (-β * card (cubeTouchPlaquettes L)) * cubeExteriorPartition L β ≤ characterPartition L β` and
`characterPartition L β ≤ exp (β * card (cubeTouchPlaquettes L)) * cubeExteriorPartition L β`. -/
theorem characterPartition_sandwich_cubeExteriorPartition
    {L : ℕ} [NeZero L] {β : ℝ} (hβ : 0 ≤ β) :
    Real.exp (-(β * ((cubeTouchPlaquettes L).card : ℝ))) * cubeExteriorPartition L β ≤
      characterPartition L β ∧
    characterPartition L β ≤
      Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ)) * cubeExteriorPartition L β := by
  have h_char_int : Integrable (characterBoltzmannWeight (L := L) β) (gaugeHaarMeasure L) :=
    (continuous_characterBoltzmannWeight β).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_ext_int : Integrable (cubeExteriorBoltzmannWeight (L := L) β) (gaugeHaarMeasure L) :=
    (continuous_cubeExteriorBoltzmannWeight β).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have h_pt (U : GaugeConfig L) :
      Real.exp (-(β * ((cubeTouchPlaquettes L).card : ℝ))) * cubeExteriorBoltzmannWeight β U ≤
        characterBoltzmannWeight β U ∧
      characterBoltzmannWeight β U ≤
        Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ)) * cubeExteriorBoltzmannWeight β U := by
    have h_abs := abs_cubeTouchCharacterSum_le_card U
    obtain ⟨h_lo, h_hi⟩ := abs_le.mp h_abs
    have h_ext_nonneg : 0 ≤ cubeExteriorBoltzmannWeight β U :=
      (Real.exp_pos _).le
    rw [characterBoltzmannWeight_eq_exp_cubeTouch_mul_cubeExteriorBoltzmannWeight]
    refine ⟨?_, ?_⟩
    · refine mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr ?_) h_ext_nonneg
      have h_mul := mul_le_mul_of_nonneg_left h_lo hβ
      linarith
    · refine mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr ?_) h_ext_nonneg
      exact mul_le_mul_of_nonneg_left h_hi hβ
  unfold characterPartition cubeExteriorPartition
  refine ⟨?_, ?_⟩
  · rw [← integral_const_mul]
    exact integral_mono (h_ext_int.const_mul _) h_char_int (fun U => (h_pt U).1)
  · rw [← integral_const_mul]
    exact integral_mono h_char_int (h_ext_int.const_mul _) (fun U => (h_pt U).2)

/-- Uniform-in-exterior-volume upper bound on the squared exterior-to-full partition ratio
`(cubeExteriorPartition L β) ^ 2 / (characterPartition L β) ^ 2 ≤ exp (2 * β * card (cubeTouchPlaquettes L))`
for `L ≥ 2` and `0 ≤ β`. -/
theorem cubeExteriorPartition_sq_div_characterPartition_sq_le_exp
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ : 0 ≤ β) :
    (cubeExteriorPartition L β) ^ 2 / (characterPartition L β) ^ 2 ≤
      Real.exp (2 * β * ((cubeTouchPlaquettes L).card : ℝ)) := by
  have hZ_pos : 0 < characterPartition L β := characterPartition_pos hL β
  have hZ_sq_pos : 0 < (characterPartition L β) ^ 2 := sq_pos_of_pos hZ_pos
  have h_sand := (characterPartition_sandwich_cubeExteriorPartition (L := L) hβ).1
  have h_ext_nonneg : 0 ≤ cubeExteriorPartition L β := by
    unfold cubeExteriorPartition
    exact integral_nonneg (fun _ => (Real.exp_pos _).le)
  have h_ext_le :
      cubeExteriorPartition L β ≤
        Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ)) * characterPartition L β := by
    calc
      cubeExteriorPartition L β
        = Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ)) *
            (Real.exp (-(β * ((cubeTouchPlaquettes L).card : ℝ))) * cubeExteriorPartition L β) := by
          rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
      _ ≤ Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ)) * characterPartition L β :=
          mul_le_mul_of_nonneg_left h_sand (Real.exp_pos _).le
  rw [div_le_iff₀ hZ_sq_pos]
  calc
    (cubeExteriorPartition L β) ^ 2
      ≤ (Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ)) * characterPartition L β) ^ 2 :=
        pow_le_pow_left₀ h_ext_nonneg h_ext_le 2
    _ = (Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ)) *
          Real.exp (β * ((cubeTouchPlaquettes L).card : ℝ))) *
          (characterPartition L β) ^ 2 := by ring
    _ = Real.exp (2 * β * ((cubeTouchPlaquettes L).card : ℝ)) * (characterPartition L β) ^ 2 := by
        rw [← Real.exp_add]
        congr 2
        ring

/-- Every plaquette `p : Plaquette L` has at most `4` boundary links. -/
theorem card_plaquetteLinks_le_four {L : ℕ} (p : Plaquette L) :
    (plaquetteLinks p).card ≤ 4 := by
  unfold plaquetteLinks
  have h1 := Finset.card_insert_le (⟨p.x, p.μ⟩ : Link L)
    {⟨shift p.x p.μ, p.ν⟩, ⟨shift p.x p.ν, p.μ⟩, ⟨p.x, p.ν⟩}
  have h2 := Finset.card_insert_le (⟨shift p.x p.μ, p.ν⟩ : Link L)
    {⟨shift p.x p.ν, p.μ⟩, ⟨p.x, p.ν⟩}
  have h3 := Finset.card_insert_le (⟨shift p.x p.ν, p.μ⟩ : Link L)
    ({⟨p.x, p.ν⟩} : Finset (Link L))
  have h4 : ({⟨p.x, p.ν⟩} : Finset (Link L)).card = 1 := Finset.card_singleton _
  omega

/-- The lateral temporal plaquette set `cubeLateralSet L` has cardinality at most `4`. -/
theorem card_cubeLateralSet_le_four (L : ℕ) :
    (cubeLateralSet L).card ≤ 4 := by
  unfold cubeLateralSet
  have h1 := Finset.card_insert_le (cubeLateralPlaquette1 L)
    {cubeLateralPlaquette2 L, cubeLateralPlaquette3 L, cubeLateralPlaquette4 L}
  have h2 := Finset.card_insert_le (cubeLateralPlaquette2 L)
    {cubeLateralPlaquette3 L, cubeLateralPlaquette4 L}
  have h3 := Finset.card_insert_le (cubeLateralPlaquette3 L)
    ({cubeLateralPlaquette4 L} : Finset (Plaquette L))
  have h4 : ({cubeLateralPlaquette4 L} : Finset (Plaquette L)).card = 1 :=
    Finset.card_singleton _
  omega

/-- The 6-face unit-cube plaquette set `cubeSixFaceFinset L` has cardinality at most `6`. -/
theorem card_cubeSixFaceFinset_le_six (L : ℕ) :
    (cubeSixFaceFinset L).card ≤ 6 := by
  unfold cubeSixFaceFinset
  have h1 := Finset.card_insert_le (cubeBottomPlaquette L)
    (insert (cubeTopPlaquette L) (cubeLateralSet L))
  have h2 := Finset.card_insert_le (cubeTopPlaquette L) (cubeLateralSet L)
  have h3 := card_cubeLateralSet_le_four L
  omega

/-- Uniform cardinality bound on `cubeLinks L`: at most `24` boundary links for all `L : ℕ`. -/
theorem card_cubeLinks_le_twenty_four (L : ℕ) :
    (cubeLinks L).card ≤ 24 := by
  unfold cubeLinks
  calc
    ((cubeSixFaceFinset L).biUnion plaquetteLinks).card
      ≤ ∑ p ∈ cubeSixFaceFinset L, (plaquetteLinks p).card := Finset.card_biUnion_le
    _ ≤ ∑ _p ∈ cubeSixFaceFinset L, 4 :=
        Finset.sum_le_sum fun p _ => card_plaquetteLinks_le_four p
    _ = (cubeSixFaceFinset L).card * 4 := by rw [Finset.sum_const, smul_eq_mul]
    _ ≤ 6 * 4 := Nat.mul_le_mul_right 4 (card_cubeSixFaceFinset_le_six L)
    _ = 24 := rfl

/-- Any plaquette `p : Plaquette L` whose boundary links `plaquetteLinks p` contain `e` belongs to
`incidentPlaquettes e`. -/
theorem mem_incidentPlaquettes_of_mem_plaquetteLinks {L : ℕ} (p : Plaquette L) (e : Link L)
    (he : e ∈ plaquetteLinks p) :
    p ∈ incidentPlaquettes e := by
  classical
  simp only [plaquetteLinks, Finset.mem_insert, Finset.mem_singleton] at he
  have hμν : p.μ ≠ p.ν := ne_of_lt p.h
  have hνμ : p.ν ≠ p.μ := hμν.symm
  have hnot : ¬p.ν < p.μ := not_lt_of_ge p.h.le
  rcases he with rfl | rfl | rfl | rfl
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.ν, hνμ⟩, false), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, p.h]
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.μ, hμν⟩, true), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, hnot, shift]
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.ν, hνμ⟩, true), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, p.h, shift]
  · apply Finset.mem_image.mpr
    refine ⟨(⟨p.μ, hμν⟩, false), Finset.mem_univ _, ?_⟩
    simp [incidentPlaquette, hnot]

/-- Every plaquette in `cubeTouchPlaquettes L` belongs to `incidentPlaquettes e` for some cube link
`e ∈ cubeLinks L`. -/
theorem cubeTouchPlaquettes_subset_biUnion_incidentPlaquettes (L : ℕ) [NeZero L] :
    cubeTouchPlaquettes L ⊆ (cubeLinks L).biUnion incidentPlaquettes := by
  intro q hq
  simp only [cubeTouchPlaquettes, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.not_disjoint_iff] at hq
  rcases hq with ⟨e, he_q, he_cube⟩
  exact Finset.mem_biUnion.mpr ⟨e, he_cube, mem_incidentPlaquettes_of_mem_plaquetteLinks q e he_q⟩

/-- Uniform-in-volume cardinality bound on `cubeTouchPlaquettes L`:
`(cubeTouchPlaquettes L).card ≤ 24 * 6` for every torus size `L ≥ 1`. -/
theorem card_cubeTouchPlaquettes_le_twenty_four_mul_six (L : ℕ) [NeZero L] :
    (cubeTouchPlaquettes L).card ≤ 24 * 6 := by
  calc
    (cubeTouchPlaquettes L).card
      ≤ ((cubeLinks L).biUnion incidentPlaquettes).card :=
        Finset.card_le_card (cubeTouchPlaquettes_subset_biUnion_incidentPlaquettes L)
    _ ≤ ∑ e ∈ cubeLinks L, (incidentPlaquettes e).card := Finset.card_biUnion_le
    _ ≤ ∑ _e ∈ cubeLinks L, 6 :=
        Finset.sum_le_sum fun e _ => incidentPlaquettes_card_le_six e
    _ = (cubeLinks L).card * 6 := by rw [Finset.sum_const, smul_eq_mul]
    _ ≤ 24 * 6 := Nat.mul_le_mul_right 6 (card_cubeLinks_le_twenty_four L)

/-- Uniform-in-volume pointwise bound `|cubeTouchCharacterSum U| ≤ 24 * 6` for every configuration
`U : GaugeConfig L` (`L ≥ 1`). -/
theorem abs_cubeTouchCharacterSum_le_twenty_four_mul_six {L : ℕ} [NeZero L] (U : GaugeConfig L) :
    |cubeTouchCharacterSum U| ≤ 24 * 6 := by
  have h_card : ((cubeTouchPlaquettes L).card : ℝ) ≤ 24 * 6 := by
    exact_mod_cast card_cubeTouchPlaquettes_le_twenty_four_mul_six L
  exact (abs_cubeTouchCharacterSum_le_card U).trans h_card

/-- Uniform-in-volume bound `|β * cubeTouchCharacterSum U| ≤ (24 * 6) * β` for `0 ≤ β`. -/
theorem abs_beta_mul_cubeTouchCharacterSum_le_twenty_four_mul_six_mul_beta
    {L : ℕ} [NeZero L] {β : ℝ} (hβ : 0 ≤ β) (U : GaugeConfig L) :
    |β * cubeTouchCharacterSum U| ≤ (24 * 6) * β := by
  rw [abs_mul, abs_of_nonneg hβ, mul_comm]
  exact mul_le_mul_of_nonneg_right (abs_cubeTouchCharacterSum_le_twenty_four_mul_six U) hβ

/-- Throughout the canonical weak-coupling window `0 ≤ β ≤ canonicalCrossoverBetaHi = 1 / 6912`,
the local cube-touching action satisfies `|β * cubeTouchCharacterSum U| ≤ 1 / 48` pointwise in `U`
and uniformly in `L ≥ 1`. -/
theorem abs_beta_mul_cubeTouchCharacterSum_le_one_div_48
    {L : ℕ} [NeZero L] {β : ℝ} (hβ0 : 0 ≤ β)
    (hβ_hi : β ≤ (canonicalCrossoverBetaHi : ℝ)) (U : GaugeConfig L) :
    |β * cubeTouchCharacterSum U| ≤ 1 / 48 := by
  have h_beta_val : (canonicalCrossoverBetaHi : ℝ) = 1 / 6912 := by
    norm_num [canonicalCrossoverBetaHi]
  have h1 := abs_beta_mul_cubeTouchCharacterSum_le_twenty_four_mul_six_mul_beta hβ0 U
  linarith

/-- Explicit volume-independent partition sandwich (`0 ≤ β`):
`exp (-((24 * 6) * β)) * cubeExteriorPartition L β ≤ characterPartition L β ≤ exp ((24 * 6) * β) * cubeExteriorPartition L β`. -/
theorem characterPartition_sandwich_cubeExteriorPartition_twenty_four_mul_six
    {L : ℕ} [NeZero L] {β : ℝ} (hβ : 0 ≤ β) :
    Real.exp (-((24 * 6) * β)) * cubeExteriorPartition L β ≤ characterPartition L β ∧
    characterPartition L β ≤ Real.exp ((24 * 6) * β) * cubeExteriorPartition L β := by
  have h_sand := characterPartition_sandwich_cubeExteriorPartition (L := L) hβ
  have h_card : ((cubeTouchPlaquettes L).card : ℝ) ≤ 24 * 6 := by
    exact_mod_cast card_cubeTouchPlaquettes_le_twenty_four_mul_six L
  have h_ext_nonneg : 0 ≤ cubeExteriorPartition L β := by
    unfold cubeExteriorPartition
    exact integral_nonneg (fun _ => (Real.exp_pos _).le)
  refine ⟨?_, ?_⟩
  · refine (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr ?_) h_ext_nonneg).trans h_sand.1
    have h_mul := mul_le_mul_of_nonneg_left h_card hβ
    linarith
  · refine h_sand.2.trans (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr ?_) h_ext_nonneg)
    have h_mul := mul_le_mul_of_nonneg_left h_card hβ
    linarith

/-- Explicit volume-independent upper bound on the squared exterior-to-full partition ratio (`L ≥ 2`, `0 ≤ β`):
`(cubeExteriorPartition L β) ^ 2 / (characterPartition L β) ^ 2 ≤ exp (288 * β)`. -/
theorem cubeExteriorPartition_sq_div_characterPartition_sq_le_exp_288_beta
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ : 0 ≤ β) :
    (cubeExteriorPartition L β) ^ 2 / (characterPartition L β) ^ 2 ≤
      Real.exp (288 * β) := by
  have h_card : ((cubeTouchPlaquettes L).card : ℝ) ≤ 24 * 6 := by
    exact_mod_cast card_cubeTouchPlaquettes_le_twenty_four_mul_six L
  refine (cubeExteriorPartition_sq_div_characterPartition_sq_le_exp hL hβ).trans ?_
  refine Real.exp_le_exp.mpr ?_
  have h_mul := mul_le_mul_of_nonneg_left h_card (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hβ)
  linarith

/-- Throughout `0 ≤ β ≤ canonicalCrossoverBetaHi = 1 / 6912`, the squared exterior-to-full partition
ratio satisfies `(cubeExteriorPartition L β) ^ 2 / (characterPartition L β) ^ 2 ≤ exp (1 / 24)`
uniformly for all `L ≥ 2`. -/
theorem cubeExteriorPartition_sq_div_characterPartition_sq_le_exp_one_div_24
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ0 : 0 ≤ β)
    (hβ_hi : β ≤ (canonicalCrossoverBetaHi : ℝ)) :
    (cubeExteriorPartition L β) ^ 2 / (characterPartition L β) ^ 2 ≤
      Real.exp (1 / 24) := by
  have h_beta_val : (canonicalCrossoverBetaHi : ℝ) = 1 / 6912 := by
    norm_num [canonicalCrossoverBetaHi]
  refine (cubeExteriorPartition_sq_div_characterPartition_sq_le_exp_288_beta hL hβ0).trans ?_
  refine Real.exp_le_exp.mpr ?_
  linarith

/-- Every face `q ∈ cubeSixFaceFinset L` has its boundary links contained in `cubeLinks L`. -/
theorem plaquetteLinks_subset_cubeLinks_of_mem_cubeSixFaceFinset
    {L : ℕ} {q : Plaquette L} (hq : q ∈ cubeSixFaceFinset L) :
