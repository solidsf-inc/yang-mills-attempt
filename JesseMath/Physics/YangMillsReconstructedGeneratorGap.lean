    · rw [probeExteriorBoltzmannWeight_update_of_mem_probeLinks β U (plaquetteLinkAt_cubeTopPlaquette_mem_probeLinks L 2) g,
          sideBridge_update_top_of_ne hL β (by decide : (2 : Fin 4) ≠ 0) U g,
          sideBridge_update_top_of_ne hL β (by decide : (2 : Fin 4) ≠ 1) U g,
          sideWeight_update_top_of_ne hL β (by decide : (2 : Fin 4) ≠ 3) U g]
  have h3 :
      (∫ U, probeExteriorBoltzmannWeight β U *
          sideBridge L β 0 U * sideBridge L β 1 U * sideBridge L β 2 U * sideWeight L β 3 U *
          ΦB U * ΦT U ∂(gaugeHaarMeasure L)) =
        ∫ U, probeExteriorBoltzmannWeight β U *
