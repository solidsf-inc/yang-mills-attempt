    (fun u y => 12 * u * y ^ 2 - 3 * u + 4 * y ^ 4 - 9 * y ^ 2 + 3 / 2)
    (by fun_prop) (by fun_prop) (fun _ => 0) (fun _ => 0) continuous_const continuous_const).2.1
  have hK2 := (integral_mul_restTouchCharacterSum_pow_probeTemplate_eq_zero hL H hH_cont hH_inv
    (fun x v => 6 * x * (x ^ 2 + v - 1)) (fun _ _ => 0) (by fun_prop) continuous_const
    (fun x => 3 * (x ^ 2 - 1 / 4)) (fun _ => 0) (by fun_prop) continuous_const).2.2.1
  have hK3 := (integral_mul_restTouchCharacterSum_pow_probeTemplate_eq_zero hL H hH_cont hH_inv
    (fun x _ => 4 * x ^ 2 - 1) (fun _ y => 4 * y ^ 2 - 1)
    (by fun_prop) (by fun_prop) (fun _ => 0) (fun _ => 0) continuous_const continuous_const).2.2.2
  have h_pt :
      (fun U => H U * (S U ^ 4 * (b U * t U) - S U ^ 3 * b U - S U ^ 3 * t U + (3 / 4) * S U ^ 2)) =
      fun U =>
        ((((H U * (t U * (b U ^ 5 + 6 * b U ^ 3 * t U ^ 2 - 4 * b U ^ 3 + b U * (t U ^ 2) ^ 2 -
                4 * b U * t U ^ 2 + (3 / 2) * b U) +
              b U * 0 +
              (b U ^ 4 - (3 / 4) * b U ^ 2) * (4 * t U ^ 2 - 1) +
              (t U ^ 4 - (3 / 4) * t U ^ 2) * (4 * b U ^ 2 - 1)) +
            H U * restTouchCharacterSum U *
              (t U * (4 * b U ^ 4 + 12 * b U ^ 2 * t U ^ 2 - 9 * b U ^ 2 - 3 * t U ^ 2 + 3 / 2) +
                b U * (12 * b U ^ 2 * t U ^ 2 - 3 * b U ^ 2 + 4 * t U ^ 4 - 9 * t U ^ 2 + 3 / 2) +
                0 * (4 * t U ^ 2 - 1) + 0 * (4 * b U ^ 2 - 1))) +
            H U * restTouchCharacterSum U ^ 2 *
              (t U * (6 * b U * (b U ^ 2 + t U ^ 2 - 1)) + b U * 0 +
                (3 * (b U ^ 2 - 1 / 4)) * (4 * t U ^ 2 - 1) + 0 * (4 * b U ^ 2 - 1))) +
            H U * restTouchCharacterSum U ^ 3 *
              (t U * (4 * b U ^ 2 - 1) + b U * (4 * t U ^ 2 - 1) +
                0 * (4 * t U ^ 2 - 1) + 0 * (4 * b U ^ 2 - 1))) +
          H U * ((restTouchCharacterSum U) ^ 4 * (b U * t U))) := by
    funext U
    dsimp only [S, b, t]
    rw [cubeTouchCharacterSum_eq_probeSum_add_restTouchCharacterSum hL2 U]
    ring
  rw [h_pt,
      integral_add5_cont
        (by dsimp only [S, b, t]; fun_prop)
        (by dsimp only [S, b, t]; fun_prop)
        (by dsimp only [S, b, t]; fun_prop)
        (by dsimp only [S, b, t]; fun_prop)
        (by dsimp only [S, b, t]; fun_prop),
      hK0, hK1, hK2, hK3,
      integral_mul_restTouchCharacterSum_pow_four_mul_probes_eq hL H hH_cont hH_inv]
  ring

/-- Master Step C theorem — Under the actual `β`-dependent exterior Boltzmann weight
`cubeExteriorBoltzmannWeight β U`, the connected Taylor coefficients of `cubeTouchCharacterSum U`
satisfy `C_0^ext = C_1^ext = C_2^ext = C_3^ext = 0` and
`C_4^ext = cubeSixFaceHaarIntegral * (cubeExteriorPartition L β ^ 2)` for every `L ≥ 3` and `β ∈ ℝ`. -/
theorem cubeExterior_connected_taylor_coeffs_zero_through_four_eq
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) :
    let w := cubeExteriorBoltzmannWeight (L := L) β
    let S := cubeTouchCharacterSum (L := L)
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    let M₂ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * (fΘ U * fp U)) ∂(gaugeHaarMeasure L)
    let M₀ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * S U ^ n ∂(gaugeHaarMeasure L)
    let MΘ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * fΘ U) ∂(gaugeHaarMeasure L)
    let Mp (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * fp U) ∂(gaugeHaarMeasure L)
    (M₂ 0 * M₀ 0 - MΘ 0 * Mp 0 = 0) ∧
    (M₂ 1 * M₀ 0 + M₂ 0 * M₀ 1 - (MΘ 1 * Mp 0 + MΘ 0 * Mp 1) = 0) ∧
    ((1 / 2) * M₂ 2 * M₀ 0 + M₂ 1 * M₀ 1 + (1 / 2) * M₂ 0 * M₀ 2 -
      ((1 / 2) * MΘ 2 * Mp 0 + MΘ 1 * Mp 1 + (1 / 2) * MΘ 0 * Mp 2) = 0) ∧
    ((1 / 6) * M₂ 3 * M₀ 0 + (1 / 2) * M₂ 2 * M₀ 1 + (1 / 2) * M₂ 1 * M₀ 2 + (1 / 6) * M₂ 0 * M₀ 3 -
      ((1 / 6) * MΘ 3 * Mp 0 + (1 / 2) * MΘ 2 * Mp 1 + (1 / 2) * MΘ 1 * Mp 2 + (1 / 6) * MΘ 0 * Mp 3) = 0) ∧
    ((1 / 24) * M₂ 4 * M₀ 0 + (1 / 6) * M₂ 3 * M₀ 1 + (1 / 4) * M₂ 2 * M₀ 2 +
      (1 / 6) * M₂ 1 * M₀ 3 + (1 / 24) * M₂ 0 * M₀ 4 -
      ((1 / 24) * MΘ 4 * Mp 0 + (1 / 6) * MΘ 3 * Mp 1 + (1 / 4) * MΘ 2 * Mp 2 +
        (1 / 6) * MΘ 1 * Mp 3 + (1 / 24) * MΘ 0 * Mp 4) =
      cubeSixFaceHaarIntegral * (cubeExteriorPartition L β ^ 2)) := by
  intro w S fΘ fp M₂ M₀ MΘ Mp
  have hL2 : 2 ≤ L := by omega
  have hw_cont : Continuous w := continuous_cubeExteriorBoltzmannWeight β
  have hw_inv : ∀ e ∈ cubeLinks L, ∀ (U : GaugeConfig L) (g : SU2),
      w (updateGaugeLink L U e.x e.μ g) = w U :=
    fun e he U g => cubeExteriorBoltzmannWeight_update_of_mem_cubeLinks β U he g
  let b : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeBottomPlaquette L))
  let t : GaugeConfig L → ℝ := fun U => halfTraceRe (plaquetteHolonomy U (cubeTopPlaquette L))
  have hb_eq (U : GaugeConfig L) : fΘ U = b U :=
    physicalWilsonLoop_timeReflect_canonicalSpatialProbe_eq_cubeBottomPlaquette L one_pos U
  have ht_eq (U : GaugeConfig L) : fp U = t U :=
    physicalWilsonLoop_canonicalSpatialProbe_eq_cubeTopPlaquette L one_pos U
  have h_M₂_eq (n : ℕ) : M₂ n = ∫ U, w U * (S U ^ n * (b U * t U)) ∂(gaugeHaarMeasure L) := by
    dsimp only [M₂]; congr 1; funext U; rw [hb_eq U, ht_eq U]
  have h_MΘ_eq (n : ℕ) : MΘ n = ∫ U, w U * (S U ^ n * b U) ∂(gaugeHaarMeasure L) := by
    dsimp only [MΘ]; congr 1; funext U; rw [hb_eq U]
  have h_Mp_eq (n : ℕ) : Mp n = ∫ U, w U * (S U ^ n * t U) ∂(gaugeHaarMeasure L) := by
    dsimp only [Mp]; congr 1; funext U; rw [ht_eq U]
  have hM₀_0 : M₀ 0 = cubeExteriorPartition L β := by
    dsimp only [M₀, cubeExteriorPartition]; congr 1; funext U; ring
  have hM₀_1 : M₀ 1 = 0 := by
    dsimp only [M₀]; simpa using integral_mul_cubeTouchCharacterSum_eq_zero hL2 w hw_cont hw_inv
  obtain ⟨h_b0, h_t0, h_bt0, h_Sb, h_St, h_Sbt, h_S2b, h_S2t, h_S2bt, h_S3bt⟩ :=
    integral_mul_cubeTouchCharacterSum_low_moments_eq hL w hw_cont hw_inv
  have hMΘ_0 : MΘ 0 = 0 := by rw [h_MΘ_eq 0]; simpa using h_b0
  have hMp_0 : Mp 0 = 0 := by rw [h_Mp_eq 0]; simpa using h_t0
  have hM₂_0 : M₂ 0 = 0 := by rw [h_M₂_eq 0]; simpa using h_bt0
  have hMΘ_1 : MΘ 1 = (1 / 4) * cubeExteriorPartition L β := by
    rw [h_MΘ_eq 1]; dsimp only [cubeExteriorPartition, w]; simpa using h_Sb
  have hMp_1 : Mp 1 = (1 / 4) * cubeExteriorPartition L β := by
    rw [h_Mp_eq 1]; dsimp only [cubeExteriorPartition, w]; simpa using h_St
  have hM₂_1 : M₂ 1 = 0 := by rw [h_M₂_eq 1]; simpa using h_Sbt
  have hMΘ_2 : MΘ 2 = 0 := by rw [h_MΘ_eq 2]; exact h_S2b
  have hMp_2 : Mp 2 = 0 := by rw [h_Mp_eq 2]; exact h_S2t
  have hM₂_2 : M₂ 2 = (1 / 8) * cubeExteriorPartition L β := by
    rw [h_M₂_eq 2]; dsimp only [cubeExteriorPartition, w]; exact h_S2bt
  have hM₂_3 : M₂ 3 = 0 := by rw [h_M₂_eq 3]; exact h_S3bt
  have h_deg4_comb : M₂ 4 - MΘ 3 - Mp 3 + (3 / 4) * M₀ 2 =
      cubeExteriorPartition L β * (24 * cubeSixFaceHaarIntegral) := by
    rw [h_M₂_eq 4, h_MΘ_eq 3, h_Mp_eq 3]
    dsimp only [M₀, cubeExteriorPartition]
    rw [← integral_sub_cont (by dsimp only [w, S, b, t]; fun_prop) (by dsimp only [w, S, b, t]; fun_prop),
        ← integral_sub_cont (by dsimp only [w, S, b, t]; fun_prop) (by dsimp only [w, S, b, t]; fun_prop),
        ← integral_const_mul (3 / 4),
        ← integral_add_cont (by dsimp only [w, S, b, t]; fun_prop) (by dsimp only [w, S, b, t]; fun_prop)]
    have h_pt : (fun U => ((w U * (S U ^ 4 * (b U * t U)) - w U * (S U ^ 3 * b U)) -
          w U * (S U ^ 3 * t U)) + (3 / 4) * (w U * S U ^ 2)) =
        fun U => w U * (S U ^ 4 * (b U * t U) - S U ^ 3 * b U - S U ^ 3 * t U + (3 / 4) * S U ^ 2) := by
      funext U; ring
    rw [h_pt]
    exact integral_mul_cubeTouchCharacterSum_degFour_combination_eq hL w hw_cont hw_inv
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [hM₂_0, hMΘ_0]; ring
  · rw [hM₂_1, hM₂_0, hMp_0, hMΘ_0]; ring
  · rw [hM₂_2, hM₀_0, hM₂_1, hM₂_0, hMp_0, hMΘ_1, hMp_1, hMΘ_0]; ring
  · rw [hM₂_3, hM₀_1, hM₂_1, hM₂_0, hMp_0, hMΘ_2, hMp_2, hMΘ_0]; ring
  · calc
      (1 / 24) * M₂ 4 * M₀ 0 + (1 / 6) * M₂ 3 * M₀ 1 + (1 / 4) * M₂ 2 * M₀ 2 +
          (1 / 6) * M₂ 1 * M₀ 3 + (1 / 24) * M₂ 0 * M₀ 4 -
          ((1 / 24) * MΘ 4 * Mp 0 + (1 / 6) * MΘ 3 * Mp 1 + (1 / 4) * MΘ 2 * Mp 2 +
            (1 / 6) * MΘ 1 * Mp 3 + (1 / 24) * MΘ 0 * Mp 4) =
        (1 / 24) * cubeExteriorPartition L β * (M₂ 4 - MΘ 3 - Mp 3 + (3 / 4) * M₀ 2) +
          (1 / 24) * M₂ 4 * (M₀ 0 - cubeExteriorPartition L β) +
          (1 / 6) * M₂ 3 * M₀ 1 +
          (1 / 4) * (M₂ 2 - (1 / 8) * cubeExteriorPartition L β) * M₀ 2 +
          (1 / 6) * M₂ 1 * M₀ 3 +
          (1 / 24) * M₂ 0 * M₀ 4 -
          (1 / 24) * MΘ 4 * Mp 0 -
          (1 / 6) * MΘ 3 * (Mp 1 - (1 / 4) * cubeExteriorPartition L β) -
          (1 / 4) * MΘ 2 * Mp 2 -
          (1 / 6) * (MΘ 1 - (1 / 4) * cubeExteriorPartition L β) * Mp 3 -
          (1 / 24) * MΘ 0 * Mp 4 := by ring
      _ = cubeSixFaceHaarIntegral * (cubeExteriorPartition L β ^ 2) := by
        rw [h_deg4_comb, hM₀_0, hM₀_1, hM₂_2, hM₂_1, hM₂_0, hMp_0, hMp_1, hMΘ_2, hMΘ_1, hMΘ_0]
        ring

/-- Complete exterior-weighted degree-at-most-4 Taylor polynomial identity (`L ≥ 3`, `β ∈ ℝ`):
consumed directly in the local-exterior normalized covariance expansion around
`r(L, β) * (cubeSixFaceHaarIntegral * β ^ 4)` where
`r(L, β) = (cubeExteriorPartition L β / characterPartition L β) ^ 2`. -/
theorem cubeExterior_connected_taylor_jet_four_eq_cubeSixFaceHaarIntegral_mul_extPartition_sq_mul_beta_pow_four
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) (β : ℝ) :
    let w := cubeExteriorBoltzmannWeight (L := L) β
    let S := cubeTouchCharacterSum (L := L)
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    let M₂ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * (fΘ U * fp U)) ∂(gaugeHaarMeasure L)
    let M₀ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * S U ^ n ∂(gaugeHaarMeasure L)
    let MΘ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * fΘ U) ∂(gaugeHaarMeasure L)
    let Mp (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * fp U) ∂(gaugeHaarMeasure L)
    let C₀ : ℝ := M₂ 0 * M₀ 0 - MΘ 0 * Mp 0
    let C₁ : ℝ := M₂ 1 * M₀ 0 + M₂ 0 * M₀ 1 - (MΘ 1 * Mp 0 + MΘ 0 * Mp 1)
    let C₂ : ℝ := (1 / 2) * M₂ 2 * M₀ 0 + M₂ 1 * M₀ 1 + (1 / 2) * M₂ 0 * M₀ 2 -
      ((1 / 2) * MΘ 2 * Mp 0 + MΘ 1 * Mp 1 + (1 / 2) * MΘ 0 * Mp 2)
    let C₃ : ℝ := (1 / 6) * M₂ 3 * M₀ 0 + (1 / 2) * M₂ 2 * M₀ 1 + (1 / 2) * M₂ 1 * M₀ 2 + (1 / 6) * M₂ 0 * M₀ 3 -
      ((1 / 6) * MΘ 3 * Mp 0 + (1 / 2) * MΘ 2 * Mp 1 + (1 / 2) * MΘ 1 * Mp 2 + (1 / 6) * MΘ 0 * Mp 3)
    let C₄ : ℝ := (1 / 24) * M₂ 4 * M₀ 0 + (1 / 6) * M₂ 3 * M₀ 1 + (1 / 4) * M₂ 2 * M₀ 2 +
      (1 / 6) * M₂ 1 * M₀ 3 + (1 / 24) * M₂ 0 * M₀ 4 -
      ((1 / 24) * MΘ 4 * Mp 0 + (1 / 6) * MΘ 3 * Mp 1 + (1 / 4) * MΘ 2 * Mp 2 +
        (1 / 6) * MΘ 1 * Mp 3 + (1 / 24) * MΘ 0 * Mp 4)
    (C₀ + C₁ * β + C₂ * β ^ 2 + C₃ * β ^ 3 + C₄ * β ^ 4 =
      cubeSixFaceHaarIntegral * (cubeExteriorPartition L β ^ 2) * β ^ 4) ∧
    ((C₀ + C₁ * β + C₂ * β ^ 2 + C₃ * β ^ 3 + C₄ * β ^ 4) / (characterPartition L β ^ 2) =
      (cubeExteriorPartition L β ^ 2 / characterPartition L β ^ 2) *
        (cubeSixFaceHaarIntegral * β ^ 4)) := by
  intro w S fΘ fp M₂ M₀ MΘ Mp C₀ C₁ C₂ C₃ C₄
  obtain ⟨h0, h1, h2, h3, h4⟩ := cubeExterior_connected_taylor_coeffs_zero_through_four_eq hL β
  change C₀ = 0 at h0
  change C₁ = 0 at h1
  change C₂ = 0 at h2
  change C₃ = 0 at h3
  change C₄ = cubeSixFaceHaarIntegral * (cubeExteriorPartition L β ^ 2) at h4
  have h_sum : C₀ + C₁ * β + C₂ * β ^ 2 + C₃ * β ^ 3 + C₄ * β ^ 4 =
      cubeSixFaceHaarIntegral * (cubeExteriorPartition L β ^ 2) * β ^ 4 := by
    rw [h0, h1, h2, h3, h4]; ring
  refine ⟨h_sum, ?_⟩
  rw [h_sum]
  ring

/-- Uniform volume-independent bound on the exterior-to-full partition-function ratio deviation
`|(Z_ext(L, β) / Z_char(L, β))^2 - 1| ≤ exp(288 * β) - 1`, specializing on the canonical
crossover window `0 ≤ β ≤ 1 / 6912` to `≤ exp(1 / 24) - 1 ≤ 1 / (24 - 1) < 1 / 4`. -/
theorem abs_cubeExteriorPartition_sq_div_characterPartition_sq_sub_one_le
    {L : ℕ} [NeZero L] (hL : 2 ≤ L) {β : ℝ} (hβ_lo : 0 ≤ β) :
    |(cubeExteriorPartition L β ^ 2 / characterPartition L β ^ 2) - 1| ≤
      Real.exp (288 * β) - 1 ∧
    (β ≤ canonicalCrossoverBetaHi →
      |(cubeExteriorPartition L β ^ 2 / characterPartition L β ^ 2) - 1| ≤
        Real.exp (1 / 24) - 1) ∧
    Real.exp (1 / 24 : ℝ) - 1 ≤ 1 / (24 - 1) ∧
    Real.exp (1 / 24 : ℝ) - 1 < 1 / 4 := by
  have h_hi := cubeExteriorPartition_sq_div_characterPartition_sq_le_exp_288_beta hL hβ_lo
  have hZ_pos : 0 < characterPartition L β := lt_of_lt_of_le one_pos (one_le_characterPartition hL β)
  have hZ_sq_pos : 0 < characterPartition L β ^ 2 := sq_pos_of_pos hZ_pos
  have h_sand2 := (characterPartition_sandwich_cubeExteriorPartition_twenty_four_mul_six (L := L) hβ_lo).2
  have h_lo : Real.exp (-(288 * β)) ≤ cubeExteriorPartition L β ^ 2 / characterPartition L β ^ 2 := by
    rw [le_div_iff₀ hZ_sq_pos]
    have h_sq : characterPartition L β ^ 2 ≤ Real.exp (288 * β) * cubeExteriorPartition L β ^ 2 := by
      calc characterPartition L β ^ 2
        _ ≤ (Real.exp ((24 * 6) * β) * cubeExteriorPartition L β) ^ 2 := pow_le_pow_left₀ hZ_pos.le h_sand2 2
        _ = (Real.exp ((24 * 6) * β) * Real.exp ((24 * 6) * β)) * cubeExteriorPartition L β ^ 2 := by ring
        _ = Real.exp (288 * β) * cubeExteriorPartition L β ^ 2 := by rw [← Real.exp_add]; congr 2; ring
    calc Real.exp (-(288 * β)) * characterPartition L β ^ 2
      _ ≤ Real.exp (-(288 * β)) * (Real.exp (288 * β) * cubeExteriorPartition L β ^ 2) :=
          mul_le_mul_of_nonneg_left h_sq (Real.exp_pos _).le
      _ = (Real.exp (-(288 * β)) * Real.exp (288 * β)) * cubeExteriorPartition L β ^ 2 := by ring
      _ = cubeExteriorPartition L β ^ 2 := by rw [← Real.exp_add, neg_add_cancel, Real.exp_zero, one_mul]
  have h_cosh (x : ℝ) : 1 - Real.exp (-x) ≤ Real.exp x - 1 := by
    have h_prod : Real.exp (-x) * Real.exp x = 1 := by rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
    have h_sq : 0 ≤ Real.exp (-x) * (Real.exp x - 1) ^ 2 := mul_nonneg (Real.exp_pos (-x)).le (sq_nonneg _)
    have h_id : Real.exp (-x) * (Real.exp x - 1) ^ 2 = Real.exp x + Real.exp (-x) - 2 := by
      calc Real.exp (-x) * (Real.exp x - 1) ^ 2
        _ = (Real.exp (-x) * Real.exp x) * Real.exp x - 2 * (Real.exp (-x) * Real.exp x) + Real.exp (-x) := by ring
        _ = Real.exp x + Real.exp (-x) - 2 := by rw [h_prod]; ring
    linarith
  have h_abs : |(cubeExteriorPartition L β ^ 2 / characterPartition L β ^ 2) - 1| ≤ Real.exp (288 * β) - 1 := by
    rw [abs_le]
    refine ⟨?_, by linarith [h_hi]⟩
    have h_c := h_cosh (288 * β)
    linarith [h_lo]
  have h_e24 : Real.exp (1 / 24 : ℝ) - 1 ≤ 1 / (24 - 1) := by
    have h_neg := Real.add_one_le_exp (-(1 / 24 : ℝ))
    have h_prod : Real.exp (-(1 / 24 : ℝ)) * Real.exp (1 / 24 : ℝ) = 1 := by
      rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
    have h_mul : (-(1 / 24 : ℝ) + 1) * Real.exp (1 / 24 : ℝ) ≤ 1 := by
      calc (-(1 / 24 : ℝ) + 1) * Real.exp (1 / 24 : ℝ)
        _ ≤ Real.exp (-(1 / 24 : ℝ)) * Real.exp (1 / 24 : ℝ) :=
            mul_le_mul_of_nonneg_right h_neg (Real.exp_pos _).le
        _ = 1 := h_prod
    linarith
  refine ⟨h_abs, fun hβ_hi => ?_, h_e24, by linarith⟩
  have h_le : Real.exp (288 * β) ≤ Real.exp (1 / 24) := by
    apply Real.exp_le_exp.mpr
    rw [canonicalCrossoverBetaHi] at hβ_hi
    linarith
  linarith

/-- Step E local-exterior decomposition of the normalized probe covariance deviation
`wilsonProbeCov L β - cubeSixFaceHaarIntegral * β ^ 4` into:
1. the exterior-partition ratio deviation `((Z_ext / Z_char)^2 - 1) * (4^{-5} β^4)`, and
2. the normalized local-touch Taylor remainder `(N_ext(L, β) - J_4^ext(L, β)) / Z_char(L, β)^2`. -/
theorem wilsonProbeCov_sub_cubeSixFaceHaarIntegral_eq_partitionRatio_dev_add_localTouchRemainder
    {L : ℕ} [NeZero L] (hL : 3 ≤ L) {β : ℝ} (hβ : 0 ≤ β) :
    let w := cubeExteriorBoltzmannWeight (L := L) β
    let S := cubeTouchCharacterSum (L := L)
    let fΘ : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos).timeReflect
    let fp : GaugeConfig L → ℝ :=
      physicalWilsonLoop L ((1 : ℚ) : ℝ) (canonicalSpatialProbe 1 one_pos)
    let M₂ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * (fΘ U * fp U)) ∂(gaugeHaarMeasure L)
    let M₀ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * S U ^ n ∂(gaugeHaarMeasure L)
    let MΘ (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * fΘ U) ∂(gaugeHaarMeasure L)
    let Mp (n : ℕ) : ℝ := ∫ U : GaugeConfig L, w U * (S U ^ n * fp U) ∂(gaugeHaarMeasure L)
    let C₀ : ℝ := M₂ 0 * M₀ 0 - MΘ 0 * Mp 0
    let C₁ : ℝ := M₂ 1 * M₀ 0 + M₂ 0 * M₀ 1 - (MΘ 1 * Mp 0 + MΘ 0 * Mp 1)
    let C₂ : ℝ := (1 / 2) * M₂ 2 * M₀ 0 + M₂ 1 * M₀ 1 + (1 / 2) * M₂ 0 * M₀ 2 -
