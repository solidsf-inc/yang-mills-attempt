/-!
# Rigged Hilbert Spaces (Gelfand Triplets) for Quantum Yang-Mills Theory
========================================================================
Formalization based on Arno Bohm & Mark Loewe,
*Quantum Mechanics: Foundations and Applications*, Chapters 1 & 2.

### Theoretical Foundations
In standard von Neumann Hilbert spaces ℋ:
1. Continuous spectra of self-adjoint operators (such as the Hamiltonian H in the
   continuum, 4-momentum P_μ, and field operators) have NO eigenvectors in ℋ (L² space).
   Dirac kets |p⟩, |x⟩, |E⟩ are not elements of ℋ.
2. Observables are unbounded on ℋ; their domains 𝒟(A) ⊊ ℋ cannot be invariant under
   powers Aⁿ or Lie algebra enveloping algebras (such as the Poincaré or gauge algebras).
3. Field operators A_μᵃ(x) in Quantum Yang-Mills are operator-valued distributions
   that require test function smearing.

Arno Bohm and Mark Loewe resolve these foundational problems using the
Rigged Hilbert Space (RHS) or Gelfand Triplet:
    Φ ⊂ ℋ ⊂ Φˣ

where:
- Φ is a countably-normed nuclear space dense in ℋ with a finer topology,
  serving as an invariant test space for the observable algebra: A Φ ⊆ Φ.
- ℋ is the complete inner product space (physical Hilbert space).
- Φˣ is the conjugate dual space of continuous functionals on Φ, representing
  generalized state vectors (Dirac kets |F⟩).
- The canonical embedding j : ℋ ↪ Φˣ is injective and continuous via Riesz representation.
- Self-adjoint operators A on Φ extend to Aˣ on Φˣ, where the Gelfand-Maurin
  Nuclear Spectral Theorem provides a complete basis of generalized eigenvectors.

In Quantum Yang-Mills theory on ℝ⁴:
- The nuclear test space Φ_YM is generated by smeared field strengths F_μνᵃ(f) and Wilson loops.
- Local gauge invariance (Gauss law / BRST cohomology) isolates the physical nuclear space Φ_phys.
- The physical Gelfand triplet Φ_phys ⊂ ℋ_phys ⊂ Φ_physˣ supports the continuum Hamiltonian H.
- The continuum mass gap Δ > 0 is realized as a lower bound on the generalized spectrum of Hˣ
  on the orthogonal complement of the unique physical vacuum |Ω⟩.
-/

/-! ## 1. Countably-Normed Seminorm Families (Bohm & Loewe Chapter 1) -/

/--
A directed family of seminorms pₙ on a complex vector space Φ,
which defines the locally convex nuclear topology in Bohm & Loewe's formulation.
-/
structure SeminormFamily (Φ : Type*) [AddCommGroup Φ] [Module ℂ Φ] where
  /-- The countable sequence of seminorms indexed by n ∈ ℕ -/
  p : ℕ → Φ → ℝ
  /-- Seminorms map zero to zero -/
  p_zero : ∀ n, p n 0 = 0
  /-- Seminorms are non-negative -/
  p_nonneg : ∀ n x, 0 ≤ p n x
  /-- Triangle inequality -/
  p_add : ∀ n x y, p n (x + y) ≤ p n x + p n y
  /-- Absolute homogeneity under complex scalar multiplication -/
  p_smul : ∀ n (c : ℂ) x, p n (c • x) = ‖c‖ * p n x
  /-- Directed family / monotonicity: each seminorm dominates the previous -/
  p_monotone : ∀ n x, p n x ≤ p (n + 1) x

namespace SeminormFamily

variable {Φ : Type*} [AddCommGroup Φ] [Module ℂ Φ] (fam : SeminormFamily Φ)

/-- Convergence of a sequence in the countably-normed projective topology of Φ. -/
def TendsTo (seq : ℕ → Φ) (limit : Φ) : Prop :=
  ∀ n, Tendsto (fun k => fam.p n (seq k - limit)) atTop (nhds 0)

/--
An operator A : Φ →ₗ[ℂ] Φ is nuclear-continuous if for every seminorm pₙ,
there exists a dominating seminorm pₘ and constant C ≥ 0 such that
pₙ(A x) ≤ C · pₘ(x) for all x ∈ Φ.
(Bohm & Loewe, Chapter 1, Section 1.5).
-/
def IsNuclearContinuous (A : Φ →ₗ[ℂ] Φ) : Prop :=
  ∀ n, ∃ (m : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ x, fam.p n (A x) ≤ C * fam.p m x

end SeminormFamily

/-! ## 2. The Abstract Bohm & Loewe Rigged Hilbert Space (Gelfand Triplet) -/

/--
The conjugate dual space Φˣ of continuous linear functionals on the test space Φ.
In Bohm & Loewe, elements of Φˣ represent generalized state vectors (Dirac kets |F⟩).
-/
abbrev DualSpace (Φ : Type*) [NormedAddCommGroup Φ] [NormedSpace ℂ Φ] :=
  Φ →L[ℂ] ℂ

/--
The Dirac bra-ket duality pairing:
  ⟨ϕ | F⟩_D := F(ϕ)
for a test vector ϕ ∈ Φ and a generalized ket F ∈ Φˣ.
-/
def diracBracket {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (ϕ : Φ) (F : DualSpace Φ) : ℂ :=
  F ϕ

@[inherit_doc diracBracket]
scoped notation "⟪" ϕ " | " F "⟫_D" => diracBracket ϕ F

/-- Dirac pairing is linear in the ket F. -/
theorem diracBracket_add_ket {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (ϕ : Φ) (F₁ F₂ : DualSpace Φ) :
    ⟪ϕ | F₁ + F₂⟫_D = ⟪ϕ | F₁⟫_D + ⟪ϕ | F₂⟫_D :=
  rfl

/-- Dirac pairing satisfies scalar scaling in the ket F. -/
theorem diracBracket_smul_ket {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (ϕ : Φ) (c : ℂ) (F : DualSpace Φ) :
    ⟪ϕ | c • F⟫_D = c * ⟪ϕ | F⟫_D :=
  rfl

/-- Dirac pairing with the zero vector in Φ vanishes. -/
theorem diracBracket_zero_bra {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (F : DualSpace Φ) :
    ⟪(0 : Φ) | F⟫_D = 0 := by
  dsimp [diracBracket]
  exact ContinuousLinearMap.map_zero F

/--
Dual extension of an observable A : Φ →L[ℂ] Φ to the generalized ket space Φˣ:
For any generalized ket F ∈ Φˣ, the dual action Aˣ F is defined by:
  ⟨ϕ | Aˣ F⟩_D = ⟨A ϕ | F⟩_D = F(A ϕ)
(Bohm & Loewe, Chapter 2, Section 2.2).
-/
def dualOperator {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (A : Φ →L[ℂ] Φ) (F : DualSpace Φ) : DualSpace Φ :=
  F.comp A

/-- Duality bracket relation: ⟨ϕ | Aˣ F⟩_D = ⟨A ϕ | F⟩_D. -/
theorem dualOperator_bracket {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (A : Φ →L[ℂ] Φ) (F : DualSpace Φ) (ϕ : Φ) :
    ⟪ϕ | dualOperator A F⟫_D = ⟪A ϕ | F⟫_D :=
  rfl

/-- Dual operator preserves addition of functionals. -/
theorem dualOperator_add {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (A : Φ →L[ℂ] Φ) (F₁ F₂ : DualSpace Φ) :
    dualOperator A (F₁ + F₂) = dualOperator A F₁ + dualOperator A F₂ :=
  ContinuousLinearMap.add_comp F₁ F₂ A

/-- Dual operator preserves scalar multiplication. -/
theorem dualOperator_smul {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (A : Φ →L[ℂ] Φ) (c : ℂ) (F : DualSpace Φ) :
    dualOperator A (c • F) = c • dualOperator A F :=
  ContinuousLinearMap.smul_comp c F A

/-- Dual of operator composition satisfies (A ∘ B)ˣ = Bˣ ∘ Aˣ. -/
theorem dualOperator_comp {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (A B : Φ →L[ℂ] Φ) (F : DualSpace Φ) :
    dualOperator (A.comp B) F = dualOperator B (dualOperator A F) := by
  dsimp [dualOperator]
  rfl

/--
A generalized eigenvector (Dirac ket) |λ⟩ ∈ Φˣ of an observable A with eigenvalue λ ∈ ℂ:
Satisfies Aˣ |λ⟩ = λ |λ⟩, meaning:
  ⟨A ϕ | λ⟩_D = λ · ⟨ϕ | λ⟩_D   for all ϕ ∈ Φ.
(Bohm & Loewe, Chapter 2, Definition 2.3).
-/
structure GeneralizedEigenvector {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (A : Φ →L[ℂ] Φ) where
  /-- The generalized state vector in Φˣ -/
  ket : DualSpace Φ
  /-- Non-triviality: |λ⟩ ≠ 0 -/
  ket_ne_zero : ket ≠ 0
  /-- Generalized eigenvalue λ ∈ ℂ -/
  eigenvalue : ℂ
  /-- Eigenvalue equation in the dual space: Aˣ |λ⟩ = λ |λ⟩ -/
  eigen_eq : dualOperator A ket = eigenvalue • ket

/--
The Dirac eigenvalue relation in bracket notation:
  ⟨A ϕ | λ⟩_D = λ · ⟨ϕ | λ⟩_D
-/
theorem generalized_eigen_bracket {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (A : Φ →L[ℂ] Φ) (v : GeneralizedEigenvector A) (ϕ : Φ) :
    ⟪A ϕ | v.ket⟫_D = v.eigenvalue * ⟪ϕ | v.ket⟫_D := by
  have h := congr_arg (fun (F : DualSpace Φ) => F ϕ) v.eigen_eq
  dsimp [dualOperator, diracBracket] at h ⊢
  exact h

/--
Generalized eigenvalues with vanishing imaginary part are purely real.
-/
theorem generalized_eigenvalue_real {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    {A : Φ →L[ℂ] Φ} (v : GeneralizedEigenvector A)
    (h_real_ev : v.eigenvalue.im = 0) :
    v.eigenvalue = (v.eigenvalue.re : ℂ) := by
  apply Complex.ext
  · rfl
  · exact h_real_ev

/--
A Bohm & Loewe Gelfand Triplet (Rigged Hilbert Space) Φ ⊂ ℋ ⊂ Φˣ:
Consists of a dense nuclear test space Φ continuously embedded into a Hilbert space ℋ.
-/
structure BohmLoeweGelfandTriplet (Φ : Type*) (H : Type*)
    [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  /-- The canonical continuous linear injection i : Φ ↪ ℋ -/
  embed : Φ →L[ℂ] H
  /-- The embedding is injective (Φ is a subspace of ℋ) -/
  embed_injective : Function.Injective embed
  /-- The embedding has dense image in ℋ (Φ is dense in ℋ) -/
  embed_dense : DenseRange embed

namespace BohmLoeweGelfandTriplet

variable {Φ H : Type*}
variable [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/--
A continuous linear operator A : Φ →L[ℂ] Φ is symmetric on the Gelfand triplet
if ⟨i(ϕ), i(A ψ)⟩_ℋ = ⟨i(A ϕ), i(ψ)⟩_ℋ for all ϕ, ψ ∈ Φ.
-/
def IsSymmetricOn (trip : BohmLoeweGelfandTriplet Φ H) (A : Φ →L[ℂ] Φ) : Prop :=
  ∀ ϕ ψ : Φ, inner (𝕜 := ℂ) (trip.embed ϕ) (trip.embed (A ψ)) = inner (𝕜 := ℂ) (trip.embed (A ϕ)) (trip.embed ψ)

/--
The canonical Riesz embedding j : ℋ ↪ Φˣ:
For any Hilbert space vector h ∈ ℋ, the functional j(h) ∈ Φˣ is defined by:
  ⟨ϕ | j(h)⟩_D = ⟨h, i(ϕ)⟩_ℋ
which is continuous on Φ as the composition of the Riesz map on ℋ and the embedding i.
-/
def rieszMap (trip : BohmLoeweGelfandTriplet Φ H) (h : H) : DualSpace Φ :=
  (InnerProductSpace.toDualMap ℂ H h).comp trip.embed

/--
Evaluation of the canonical Riesz embedding on a test vector ϕ ∈ Φ:
  (j(h))(ϕ) = ⟨h, i(ϕ)⟩_ℋ
-/
@[simp]
theorem rieszMap_apply (trip : BohmLoeweGelfandTriplet Φ H) (h : H) (ϕ : Φ) :
    trip.rieszMap h ϕ = inner (𝕜 := ℂ) h (trip.embed ϕ) :=
  rfl

/-- The Riesz embedding maps the zero vector of ℋ to the zero functional of Φˣ. -/
@[simp]
theorem rieszMap_zero (trip : BohmLoeweGelfandTriplet Φ H) :
    trip.rieszMap 0 = 0 := by
  ext ϕ
  simp [rieszMap]

/--
Duality Compatibility Theorem (Bohm & Loewe, Chapter 1, Section 1.5):
For any test vectors ϕ, ψ ∈ Φ, the Dirac pairing of ϕ with the embedded vector j(i(ψ))
agrees exactly with the Hilbert space inner product:
  ⟨ϕ | j(i(ψ))⟩_D = ⟨i(ψ), i(ϕ)⟩_ℋ
-/
theorem duality_compatibility (trip : BohmLoeweGelfandTriplet Φ H) (ϕ ψ : Φ) :
    ⟪ϕ | trip.rieszMap (trip.embed ψ)⟫_D = inner (𝕜 := ℂ) (trip.embed ψ) (trip.embed ϕ) :=
  rfl

/--
Injectivity of the canonical embedding j : ℋ ↪ Φˣ (Bohm & Loewe Theorem 1.5.1):
Because the test space Φ is dense in ℋ, if j(h₁) = j(h₂), then h₁ = h₂.
-/
theorem rieszMap_injective (trip : BohmLoeweGelfandTriplet Φ H) :
    Function.Injective trip.rieszMap := by
  intro (h₁ : H) (h₂ : H) h_eq
  have h_inner : ∀ ϕ : Φ, inner (𝕜 := ℂ) h₁ (trip.embed ϕ) = inner (𝕜 := ℂ) h₂ (trip.embed ϕ) := by
    intro ϕ
    have h := congr_arg (fun (F : DualSpace Φ) => F ϕ) h_eq
    exact h
  have h_sub : ∀ ϕ : Φ, inner (𝕜 := ℂ) (h₁ - h₂) (trip.embed ϕ) = (0 : ℂ) := by
    intro ϕ
    rw [inner_sub_left, h_inner ϕ, sub_self]
  have h_closed : IsClosed {y : H | inner (𝕜 := ℂ) (h₁ - h₂) y = (0 : ℂ)} :=
    isClosed_eq (continuous_const.inner continuous_id) continuous_const
  have h_range : Set.range trip.embed ⊆ {y : H | inner (𝕜 := ℂ) (h₁ - h₂) y = (0 : ℂ)} := by
    rintro _ ⟨ϕ, rfl⟩
    exact h_sub ϕ
  have h_univ : Set.univ ⊆ {y : H | inner (𝕜 := ℂ) (h₁ - h₂) y = (0 : ℂ)} := by
    rw [← trip.embed_dense.closure_range]
    exact closure_minimal h_range h_closed
  have h_self : inner (𝕜 := ℂ) (h₁ - h₂) (h₁ - h₂) = (0 : ℂ) :=
    h_univ (Set.mem_univ _)
  have h_diff_zero : h₁ - h₂ = 0 := inner_self_eq_zero.mp h_self
  exact sub_eq_zero.mp h_diff_zero

end BohmLoeweGelfandTriplet

/-! ## 3. Physical Quantum Yang-Mills Rigged Hilbert Space -/

/--
The physical Gelfand triplet for Quantum Yang-Mills theory:
  Φ_phys ⊂ ℋ_phys ⊂ Φ_physˣ
where Φ_phys consists of gauge-invariant localized quantum states
satisfying the non-abelian Gauss law constraints (or BRST invariance Q_BRST |ψ⟩ = 0).
-/
structure PhysicalYangMillsTriplet where
  /-- The nuclear test space Φ_phys of smooth gauge-invariant field states -/
  TestSpace : Type
  /-- The physical Hilbert space ℋ_phys -/
  HilbertSpace : Type
  [normedTest : NormedAddCommGroup TestSpace]
  [spaceTest : NormedSpace ℂ TestSpace]
  [normedHilb : NormedAddCommGroup HilbertSpace]
  [innerHilb : InnerProductSpace ℂ HilbertSpace]
  [completeHilb : CompleteSpace HilbertSpace]
  /-- The underlying Bohm-Loewe Gelfand triplet -/
  triplet : BohmLoeweGelfandTriplet TestSpace HilbertSpace

attribute [instance] PhysicalYangMillsTriplet.normedTest
attribute [instance] PhysicalYangMillsTriplet.spaceTest
attribute [instance] PhysicalYangMillsTriplet.normedHilb
attribute [instance] PhysicalYangMillsTriplet.innerHilb
attribute [instance] PhysicalYangMillsTriplet.completeHilb

/--
Continuum Hamiltonian and Physical Vacuum for Quantum Yang-Mills
in the Bohm & Loewe Rigged Hilbert Space framework.
-/
structure ContinuumYangMillsRHS (YM : PhysicalYangMillsTriplet) where
  /-- Continuum physical Hamiltonian operator H acting continuously on Φ_phys -/
  H : YM.TestSpace →L[ℂ] YM.TestSpace
  /-- Symmetry of the Hamiltonian on the test space -/
  H_symmetric : YM.triplet.IsSymmetricOn H
  /-- Quadratic-form non-negativity of H on the dense test space Φ_phys ⊂ ℋ_phys:
      Re ⟨i(ϕ), i(H ϕ)⟩_ℋ ≥ 0 for all ϕ ∈ Φ_phys -/
  H_quadratic_nonneg :
    ∀ (ϕ : YM.TestSpace),
      0 ≤ (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H ϕ))).re
  /-- The unique Poincaré-invariant physical vacuum state |Ω⟩ ∈ Φ_phys -/
  vacuum : YM.TestSpace
  /-- Normalization of the vacuum: ‖i(Ω)‖ = 1 -/
  vacuum_normalized : ‖YM.triplet.embed vacuum‖ = 1
  /-- Vacuum energy is zero: H |Ω⟩ = 0 -/
  vacuum_zero_energy : H vacuum = 0
  /-- The continuum physical mass gap Δ_phys > 0 -/
  massGap : ℝ
  /-- Positivity of the continuum mass gap -/
  massGap_pos : 0 < massGap
  /--
  Hilbert-Space Quadratic-Form Mass Gap Condition (Full-Spectrum Exclusion):
  Every test vector ϕ ∈ Φ_phys orthogonal to the vacuum in ℋ_phys
  (⟨i(Ω), i(ϕ)⟩_ℋ = 0) satisfies the quadratic-form spectral lower bound:
    Re ⟨i(ϕ), i(H ϕ)⟩_ℋ ≥ Δ_phys · ‖i(ϕ)‖_ℋ².
  This rules out both point eigenvalues and continuous spectrum in (0, Δ_phys)
  (eliminating the gapless multiplication operator countermodel M_x on L²(0, 1/2)).
  -/
  quadratic_mass_gap :
    ∀ (ϕ : YM.TestSpace),
      inner (𝕜 := ℂ) (YM.triplet.embed vacuum) (YM.triplet.embed ϕ) = (0 : ℂ) →
      massGap * ‖YM.triplet.embed ϕ‖ ^ 2 ≤
        (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H ϕ))).re
  /--
  Rigged Hilbert Space Mass Gap Condition (Bohm & Loewe formulation):
  Every generalized eigenvector |E⟩ ∈ Φ_physˣ of Hˣ orthogonal to the vacuum
  (⟨Ω | E⟩_D = 0) has real energy eigenvalue bounded below by the mass gap:
    Re(E) ≥ Δ_phys > 0.
  -/
  rigged_spectrum_gap :
    ∀ (v : GeneralizedEigenvector H),
      diracBracket vacuum v.ket = 0 →
      massGap ≤ v.eigenvalue.re

namespace ContinuumYangMillsRHS

variable {YM : PhysicalYangMillsTriplet} (sys : ContinuumYangMillsRHS YM)

/-- Theorem: The continuum Yang-Mills mass gap is strictly positive. -/
theorem massGap_positive : 0 < sys.massGap :=
  sys.massGap_pos

/-- Theorem: Every normalized vacuum-orthogonal test state `ϕ ∈ Φ_phys` (`‖i(ϕ)‖ = 1`
    and `⟨i(Ω), i(ϕ)⟩_ℋ = 0`) has quadratic energy expectation bounded below by `sys.massGap`. -/
theorem normalized_quadratic_expectation_ge_massGap
    (ϕ : YM.TestSpace)
    (h_norm : ‖YM.triplet.embed ϕ‖ = 1)
    (h_orth : inner (𝕜 := ℂ) (YM.triplet.embed sys.vacuum) (YM.triplet.embed ϕ) = (0 : ℂ)) :
    sys.massGap ≤ (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (sys.H ϕ))).re := by
  have hq := sys.quadratic_mass_gap ϕ h_orth
  rw [h_norm, one_pow, mul_one] at hq
  exact hq

/-- Theorem (Refutation of Gapless Continuous-Spectrum Countermodel):
    No normalized vacuum-orthogonal state packet `f_eps ∈ Φ_phys` (such as
    `f_eps(x) = eps^{-1/2} 1_{(0, eps)}(x)` for multiplication by `x` on `L²(0, 1/2)`)
    can have quadratic expectation `⟨i(f_eps), i(H f_eps)⟩ = eps / 2 < sys.massGap`. -/
theorem refutes_gapless_continuous_spectrum_packet
    (f_eps : YM.TestSpace) (eps : ℝ)
    (h_norm : ‖YM.triplet.embed f_eps‖ = 1)
    (h_orth : inner (𝕜 := ℂ) (YM.triplet.embed sys.vacuum) (YM.triplet.embed f_eps) = (0 : ℂ))
    (h_packet : (inner (𝕜 := ℂ) (YM.triplet.embed f_eps) (YM.triplet.embed (sys.H f_eps))).re = eps / 2)
    (h_eps_lt : eps / 2 < sys.massGap) :
    False := by
  have hge := sys.normalized_quadratic_expectation_ge_massGap f_eps h_norm h_orth
  linarith

/--
Theorem: Vacuum is a generalized eigenvector of Hˣ with eigenvalue 0.
-/
def vacuum_eigenvector : GeneralizedEigenvector sys.H where
  ket := YM.triplet.rieszMap (YM.triplet.embed sys.vacuum)
  ket_ne_zero := by
    intro h_zero
    have h_inj := YM.triplet.rieszMap_injective
    have h_vac_embed_zero : YM.triplet.embed sys.vacuum = 0 := by
      apply h_inj
      rw [h_zero]
      have h_zero_map : YM.triplet.rieszMap 0 = 0 := by
        ext ϕ
        change (YM.triplet.rieszMap 0) ϕ = 0
        rw [BohmLoeweGelfandTriplet.rieszMap_apply, inner_zero_left]
      exact h_zero_map.symm
    have h_norm : ‖YM.triplet.embed sys.vacuum‖ = 0 := by rw [h_vac_embed_zero, norm_zero]
    rw [sys.vacuum_normalized] at h_norm
    exact one_ne_zero h_norm
  eigenvalue := (0 : ℂ)
  eigen_eq := by
    have h_zero_smul : ((0 : ℂ) • YM.triplet.rieszMap (YM.triplet.embed sys.vacuum)) = 0 :=
      zero_smul ℂ (YM.triplet.rieszMap (YM.triplet.embed sys.vacuum))
    rw [h_zero_smul]
    ext ϕ
    change inner (𝕜 := ℂ) (YM.triplet.embed sys.vacuum) (YM.triplet.embed (sys.H ϕ)) = (0 : DualSpace YM.TestSpace) ϕ
    rw [sys.H_symmetric sys.vacuum ϕ]
    rw [sys.vacuum_zero_energy]
    rw [map_zero]
    rw [inner_zero_left]
    rfl

/--
Theorem: Exponential decay of glueball correlations in the continuum RHS:
For any Euclidean time separation t > 0, the correlation damping factor
Δ · t is strictly positive.
-/
theorem glueball_clustering_positive (t : ℝ) (ht : 0 < t) :
    0 < sys.massGap * t :=
  mul_pos sys.massGap_pos ht

/--
Reflection positivity / energy non-negativity in Euclidean time:
E² ≥ 0 for any generalized real excitation energy E.
-/
theorem energy_squared_nonneg (E : ℝ) : 0 ≤ E ^ 2 :=
  sq_nonneg E

end ContinuumYangMillsRHS

/-! ## 4. Bridge from Lattice Yang-Mills to Continuum Rigged Hilbert Space -/

/--
Bridge Structure connecting the discrete lattice transfer matrix mass gap
from `JesseMath.Physics.LatticeYangMills` to the continuum Bohm & Loewe
Rigged Hilbert Space mass gap.
-/
structure LatticeToRiggedContinuumBridge
    (H_lat : Type) [NormedAddCommGroup H_lat] [InnerProductSpace ℂ H_lat] where
  /-- The discrete lattice transfer matrix system on an inhabitable Hilbert space `H_lat` -/
  latticeSys : TransferMatrixSystem H_lat
  /-- The continuum physical Yang-Mills Gelfand triplet -/
  continuumYM : PhysicalYangMillsTriplet
  /-- The continuum RHS Hamiltonian and vacuum system -/
  continuumRHS : ContinuumYangMillsRHS continuumYM
  /--
  Continuum limit consistency: The continuum mass gap is realized as the limit
  of the lattice mass gap sequence Δ_lattice = (1/a) ln(λ₀/λ₁).
  -/
  lattice_gap_eq : continuumRHS.massGap = latticeSys.massGap

namespace LatticeToRiggedContinuumBridge

variable {H_lat : Type} [NormedAddCommGroup H_lat] [InnerProductSpace ℂ H_lat]
variable (bridge : LatticeToRiggedContinuumBridge H_lat)

/--
Theorem: The continuum Rigged Hilbert Space mass gap inherits strict positivity
directly from the lattice transfer matrix spectral ordering λ₁ < λ₀.
-/
theorem rigged_massGap_pos_of_lattice : 0 < bridge.continuumRHS.massGap := by
  rw [bridge.lattice_gap_eq]
  exact bridge.latticeSys.massGap_pos

end LatticeToRiggedContinuumBridge

/-! ## 5. Centered Smeared-Field States, Connected Correlators & Vacuum-Only Refutation -/

/-- Centered smeared-field state `(O - ⟨i(Ω), i(O Ω)⟩ I) Ω` in `YM.TestSpace`.
    Represents the vacuum-subtracted fluctuation vector created from the physical vacuum `Ω`
    by a smeared field observable `O : YM.TestSpace →L[ℂ] YM.TestSpace`. -/
noncomputable def centeredFieldState (YM : PhysicalYangMillsTriplet)
    (O : YM.TestSpace →L[ℂ] YM.TestSpace) (Ω : YM.TestSpace) : YM.TestSpace :=
  O Ω - (inner (𝕜 := ℂ) (YM.triplet.embed Ω) (YM.triplet.embed (O Ω))) • Ω

/-- Diagonal connected vacuum two-point correlation function
    `S₂ᵀ(O, O) = ‖i((O - ⟨i(Ω), i(O Ω)⟩ I) Ω)‖_ℋ²`
    on the physical Hilbert space `YM.HilbertSpace`. -/
noncomputable def connectedTwoPointCorrelator (YM : PhysicalYangMillsTriplet)
    (O : YM.TestSpace →L[ℂ] YM.TestSpace) (Ω : YM.TestSpace) : ℝ :=
  ‖YM.triplet.embed (centeredFieldState YM O Ω)‖ ^ 2

/-- Theorem (Automatic Vacuum Orthogonality of Centered Field States):
    For any normalized vacuum state `Ω` (`‖i(Ω)‖ = 1`) and any smeared field operator `O`,
    the embedded centered field state `i((O - ⟨i(Ω), i(O Ω)⟩ I) Ω)` is strictly orthogonal
    to `i(Ω)` in `YM.HilbertSpace`. -/
theorem centeredFieldState_orthogonal_to_vacuum (YM : PhysicalYangMillsTriplet)
    (O : YM.TestSpace →L[ℂ] YM.TestSpace) (Ω : YM.TestSpace)
    (h_norm : ‖YM.triplet.embed Ω‖ = 1) :
    inner (𝕜 := ℂ) (YM.triplet.embed Ω) (YM.triplet.embed (centeredFieldState YM O Ω)) = 0 := by
  dsimp [centeredFieldState]
  rw [map_sub, map_smul, inner_sub_right, inner_smul_right]
  have h_self : inner (𝕜 := ℂ) (YM.triplet.embed Ω) (YM.triplet.embed Ω) = (1 : ℂ) := by
    rw [inner_self_eq_norm_sq_to_K, h_norm]
    norm_num
  rw [h_self, mul_one, sub_self]

/-- Theorem (Refutation of Vacuum-Only 1D Hilbert Spaces via Connected Correlators):
    If every vector `ψ ∈ YM.HilbertSpace` is proportional to the vacuum `i(Ω)`
    (`∀ ψ, ψ = ⟨i(Ω), ψ⟩ • i(Ω)`, as holds in any 1-dimensional Hilbert space `ℋ ≅ ℂ`),
    then the connected two-point correlation function `connectedTwoPointCorrelator YM O Ω`
    vanishes identically (`= 0`) for EVERY operator `O`, and therefore cannot equal any
    strictly positive two-point witness `W > 0`. -/
theorem one_dim_hilbert_space_connected_correlator_zero (YM : PhysicalYangMillsTriplet)
    (O : YM.TestSpace →L[ℂ] YM.TestSpace) (Ω : YM.TestSpace)
    (h_one_dim : ∀ ψ : YM.HilbertSpace,
      ψ = (inner (𝕜 := ℂ) (YM.triplet.embed Ω) ψ) • (YM.triplet.embed Ω)) :
    connectedTwoPointCorrelator YM O Ω = 0 := by
  dsimp [connectedTwoPointCorrelator, centeredFieldState]
  rw [map_sub, map_smul]
  have h_eq := h_one_dim (YM.triplet.embed (O Ω))
  have h_sub : YM.triplet.embed (O Ω) -
      (inner (𝕜 := ℂ) (YM.triplet.embed Ω) (YM.triplet.embed (O Ω))) • YM.triplet.embed Ω = 0 :=
    sub_eq_zero.mpr h_eq
  rw [h_sub, norm_zero, sq, mul_zero]

/-- Corollary: A positive connected two-point correlation (`0 < connectedTwoPointCorrelator YM O Ω`)
    for a normalized vacuum `Ω` forces the centered field state to be a nonzero vector in
    `YM.TestSpace` whose embedding in `YM.HilbertSpace` is nonzero and orthogonal to `i(Ω)`,
    and whose quadratic Hamiltonian expectation in any `sys : ContinuumYangMillsRHS YM` is at
    least `sys.massGap * connectedTwoPointCorrelator YM O sys.vacuum > 0`. -/
theorem positive_connected_correlator_forces_excited_state
    {YM : PhysicalYangMillsTriplet} (sys : ContinuumYangMillsRHS YM)
    (O : YM.TestSpace →L[ℂ] YM.TestSpace)
    (h_pos : 0 < connectedTwoPointCorrelator YM O sys.vacuum) :
    let ψ_c := centeredFieldState YM O sys.vacuum
    YM.triplet.embed ψ_c ≠ 0 ∧
    inner (𝕜 := ℂ) (YM.triplet.embed sys.vacuum) (YM.triplet.embed ψ_c) = 0 ∧
    sys.massGap * connectedTwoPointCorrelator YM O sys.vacuum ≤
      (inner (𝕜 := ℂ) (YM.triplet.embed ψ_c) (YM.triplet.embed (sys.H ψ_c))).re ∧
    0 < (inner (𝕜 := ℂ) (YM.triplet.embed ψ_c) (YM.triplet.embed (sys.H ψ_c))).re := by
  intro ψ_c
  have h_orth : inner (𝕜 := ℂ) (YM.triplet.embed sys.vacuum) (YM.triplet.embed ψ_c) = 0 :=
    centeredFieldState_orthogonal_to_vacuum YM O sys.vacuum sys.vacuum_normalized
  have h_ne : YM.triplet.embed ψ_c ≠ 0 := by
    intro h0
    dsimp [connectedTwoPointCorrelator, ψ_c] at h_pos
    rw [h0, norm_zero] at h_pos
    norm_num at h_pos
  have h_gap : sys.massGap * connectedTwoPointCorrelator YM O sys.vacuum ≤
      (inner (𝕜 := ℂ) (YM.triplet.embed ψ_c) (YM.triplet.embed (sys.H ψ_c))).re :=
    sys.quadratic_mass_gap ψ_c h_orth
  have h_energy_pos : 0 < (inner (𝕜 := ℂ) (YM.triplet.embed ψ_c) (YM.triplet.embed (sys.H ψ_c))).re :=
    lt_of_lt_of_le (mul_pos sys.massGap_pos h_pos) h_gap
  exact ⟨h_ne, h_orth, h_gap, h_energy_pos⟩

/-! ## 6. Graded-Seminorm Continuity & Unbounded Relativistic Dispersion Tower -/

/-- Graph-Sobolev graded seminorm family `p_n(ϕ) = (1 + E)^n ‖ϕ‖` associated to an energy scale
    `E ≥ 0` on any normed complex test space `Φ`. Demonstrates how a countable projective family
    of seminorms (`SeminormFamily Φ`) shifts index `n mapsto n + 1` under multiplication by `E`. -/
noncomputable def graphSobolevSeminormFamily
    (Φ : Type*) [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    (E : ℝ) (hE : 0 ≤ E) : SeminormFamily Φ where
  p := fun n x => (1 + E) ^ n * ‖x‖
  p_zero := fun n => by simp
  p_nonneg := fun n x => mul_nonneg (pow_nonneg (by linarith) n) (norm_nonneg x)
  p_add := fun n x y => by
    have h1 : 0 ≤ (1 + E) ^ n := pow_nonneg (by linarith) n
    calc (1 + E) ^ n * ‖x + y‖
      _ ≤ (1 + E) ^ n * (‖x‖ + ‖y‖) := mul_le_mul_of_nonneg_left (norm_add_le x y) h1
      _ = (1 + E) ^ n * ‖x‖ + (1 + E) ^ n * ‖y‖ := mul_add _ _ _
  p_smul := fun n c x => by
    rw [norm_smul]
    ring
  p_monotone := fun n x => by
    have h_base : 1 ≤ 1 + E := by linarith
    have h_pow : (1 + E) ^ n ≤ (1 + E) ^ (n + 1) := by
      rw [pow_succ]
      exact le_mul_of_one_le_right (pow_nonneg (by linarith) n) h_base
    exact mul_le_mul_of_nonneg_right h_pow (norm_nonneg x)

/-- Relativistic Poincaré mass-shell dispersion energy `E(Δ, p) = √(Δ² + p²)` for rest mass gap
    `Δ > 0` and spatial momentum `p ∈ ℝ`:
    1. Satisfies the uniform mass-gap lower bound `Δ ≤ √(Δ² + p²)` for all momenta `p ∈ ℝ`,
    2. Is strictly unbounded above as `|p| → ∞` (`∀ M : ℝ, ∃ p : ℝ, M < √(Δ² + p²)`), showing why
       relativistic boost orbits require an unbounded energy spectrum rather than a single
       uniformly bounded operator norm. -/
theorem relativistic_dispersion_gap_and_unbounded
    {Δ : ℝ} (hΔ : 0 < Δ) :
    (∀ p : ℝ, Δ ≤ Real.sqrt (Δ ^ 2 + p ^ 2)) ∧
    (∀ M : ℝ, ∃ p : ℝ, M < Real.sqrt (Δ ^ 2 + p ^ 2)) := by
  refine ⟨?_, ?_⟩
  · intro p
    have h_le : Δ ^ 2 ≤ Δ ^ 2 + p ^ 2 := by nlinarith [sq_nonneg p]
    calc Δ
      _ = Real.sqrt (Δ ^ 2) := (Real.sqrt_sq (le_of_lt hΔ)).symm
      _ ≤ Real.sqrt (Δ ^ 2 + p ^ 2) := Real.sqrt_le_sqrt h_le
  · intro M
    use max M 0 + 1
    have h_pos : 0 < max M 0 + 1 := by positivity
    have h_le : (max M 0 + 1) ^ 2 ≤ Δ ^ 2 + (max M 0 + 1) ^ 2 := by nlinarith [sq_nonneg Δ]
    have h_sqrt : max M 0 + 1 ≤ Real.sqrt (Δ ^ 2 + (max M 0 + 1) ^ 2) := by
      calc max M 0 + 1
        _ = Real.sqrt ((max M 0 + 1) ^ 2) := (Real.sqrt_sq (le_of_lt h_pos)).symm
        _ ≤ Real.sqrt (Δ ^ 2 + (max M 0 + 1) ^ 2) := Real.sqrt_le_sqrt h_le
    have hM_le : M ≤ max M 0 := le_max_left M 0
    linarith

/-- Theorem (Graded Index-Shift Nuclear Continuity `p_n(A x) ≤ p_{n+1}(x)`):
    Any linear operator `A : Φ →L[ℂ] Φ` with operator bound `∀ x, ‖A x‖ ≤ E * ‖x‖` (`E ≥ 0`)
    satisfies `SeminormFamily.IsNuclearContinuous` with respect to `graphSobolevSeminormFamily Φ E hE`
    via the graded index shift `m = n + 1` and constant `C = 1`. -/
theorem graphSobolevSeminormFamily_isNuclearContinuous
    {Φ : Type*} [NormedAddCommGroup Φ] [NormedSpace ℂ Φ]
    {E : ℝ} (hE : 0 ≤ E) (A : Φ →L[ℂ] Φ)
    (hA_bound : ∀ x : Φ, ‖A x‖ ≤ E * ‖x‖) :
    (graphSobolevSeminormFamily Φ E hE).IsNuclearContinuous A.toLinearMap := by
  intro n
  refine ⟨n + 1, 1, zero_le_one, ?_⟩
  intro x
  dsimp [graphSobolevSeminormFamily]
  have h1 : 0 ≤ (1 + E) ^ n := pow_nonneg (by linarith) n
  have h2 : ‖A x‖ ≤ (1 + E) * ‖x‖ := by
    have hAx := hA_bound x
    have hE_le : E * ‖x‖ ≤ (1 + E) * ‖x‖ :=
      mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg x)
    linarith
  calc (1 + E) ^ n * ‖A x‖
    _ ≤ (1 + E) ^ n * ((1 + E) * ‖x‖) := mul_le_mul_of_nonneg_left h2 h1
    _ = 1 * ((1 + E) ^ (n + 1) * ‖x‖) := by rw [pow_succ]; ring

/-- Positive-Measure Interval Unboundedness of Relativistic Mass-Shell Dispersion:
    For any rest mass gap `Δ > 0` and energy threshold `M ∈ ℝ`, there exists a compact momentum
    interval `[a, b] ⊂ ℝ` of length `b - a ≥ 1` (hence Lebesgue measure `≥ 1 > 0`) on which
    every momentum `p ∈ [a, b]` satisfies `M < √(Δ² + p²)`. -/
theorem relativistic_dispersion_interval_unbounded
    {Δ : ℝ} (_hΔ : 0 < Δ) (M : ℝ) :
    ∃ a b : ℝ,
      1 ≤ b - a ∧
      ∀ p : ℝ, a ≤ p → p ≤ b → M < Real.sqrt (Δ ^ 2 + p ^ 2) := by
  let a : ℝ := max M 0 + 1
  let b : ℝ := max M 0 + 2
  refine ⟨a, b, by dsimp [a, b]; linarith, ?_⟩
  intro p hap _hpb
  have ha_pos : 0 < a := by dsimp [a]; positivity
  have hp_pos : 0 < p := lt_of_lt_of_le ha_pos hap
  have h_sq : p ^ 2 ≤ Δ ^ 2 + p ^ 2 := by nlinarith [sq_nonneg Δ]
  have hp_le_sqrt : p ≤ Real.sqrt (Δ ^ 2 + p ^ 2) := by
    calc p
      _ = Real.sqrt (p ^ 2) := (Real.sqrt_sq (le_of_lt hp_pos)).symm
      _ ≤ Real.sqrt (Δ ^ 2 + p ^ 2) := Real.sqrt_le_sqrt h_sq
  have hM_le : M ≤ max M 0 := le_max_left M 0
  have hM_lt_a : M < a := by dsimp [a]; linarith
  linarith

/-- Formal Refutation of the Null-Set Integer Spike Counterexample (`H_spike(p)`):
    Any momentum-indexed energy profile `E_spike : ℝ → ℝ` that is bounded by `Δ` outside the
    Lebesgue-null integer lattice `ℤ ⊂ ℝ` (`∀ p ∉ ℤ, E_spike p ≤ Δ`, which includes any spike
    supported on `ℕ ⊂ ℝ` with `H_spike(p) = diag(0, 1)` for `p ∉ ℕ`) provably violates the
    unit-interval essential unboundedness requirement
    `∀ M : ℝ, ∃ a b : ℝ, 1 ≤ b - a ∧ ∀ p ∈ [a, b], M < E_spike p`, because every interval `[a, b]`
    of length `b - a ≥ 1` contains the half-integer `p* = (⌊a + 1/2⌋ : ℝ) + 1/2 ∈ [a, b] \ ℤ`. -/
theorem null_set_integer_spike_rejected_by_interval_unboundedness
    (Δ : ℝ) (E_spike : ℝ → ℝ)
    (h_ae_const : ∀ p : ℝ, (∀ n : ℤ, p ≠ (n : ℝ)) → E_spike p ≤ Δ) :
    ¬ (∀ M : ℝ, ∃ a b : ℝ, 1 ≤ b - a ∧ ∀ p : ℝ, a ≤ p → p ≤ b → M < E_spike p) := by
  intro h_unb
  rcases h_unb Δ with ⟨a, b, hab, hp_gt⟩
  let m : ℤ := ⌊a + 1 / 2⌋
  let p : ℝ := (m : ℝ) + 1 / 2
  have hm_le : (m : ℝ) ≤ a + 1 / 2 := Int.floor_le (a + 1 / 2)
  have hm_gt : a + 1 / 2 < (m : ℝ) + 1 := Int.lt_floor_add_one (a + 1 / 2)
  have hap : a ≤ p := by dsimp [p]; linarith
  have hpb : p ≤ b := by dsimp [p]; linarith
  have hp_non_int : ∀ n : ℤ, p ≠ (n : ℝ) := by
    intro n hn
    have h2 : ((2 * m + 1 : ℤ) : ℝ) = ((2 * n : ℤ) : ℝ) := by
      push_cast
      dsimp [p] at hn
      linarith
    have h_int : 2 * m + 1 = 2 * n := Int.cast_injective h2
    omega
  have h_le : E_spike p ≤ Δ := h_ae_const p hp_non_int
  have h_gt : Δ < E_spike p := hp_gt p hap hpb
  linarith

/-- Separated-vacuum global momentum-weighted Sobolev norm-squared of order `n : ℕ`
    on `ℋ_global = ℂ|Ω⟩ ⊕ ℋ_exc`:
    separates the unique translation-invariant zero-momentum vacuum amplitude `c_vac ∈ ℝ`
    from the excited momentum-mode section `ψ_exc : ℕ → ℝ` weighted by `(1 + √(Δ² + k²))^n`. -/
noncomputable def separatedVacuumSobolevNormSq
    (Δ : ℝ) (n : ℕ) (c_vac : ℝ) (ψ_exc : ℕ → ℝ) (N : ℕ) : ℝ :=
  c_vac ^ 2 + ∑ k ∈ Finset.range N, ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n * ψ_exc k) ^ 2

/-- Global Hamiltonian quadratic form on the separated-vacuum assembly `ℂ|Ω⟩ ⊕ ℋ_exc`:
    assigns zero energy to the unique vacuum ray `c_vac` and mass-shell energy `√(Δ² + k²)`
    to each excited momentum mode `k`. -/
noncomputable def separatedVacuumEnergyExpectation
    (Δ : ℝ) (ψ_exc : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ k ∈ Finset.range N, Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2) * (ψ_exc k) ^ 2

/-- Global momentum magnitude quadratic form `⟨Ψ, |P| Ψ⟩` on `ℂ|Ω⟩ ⊕ ℋ_exc`:
    assigns zero momentum to the translation-invariant vacuum ray `c_vac` and momentum `k`
    to each excited mode `k`. -/
noncomputable def separatedVacuumMomentumExpectation
    (ψ_exc : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ k ∈ Finset.range N, (k : ℝ) * (ψ_exc k) ^ 2

/-- Separated-Vacuum Relativistic Assembly & Momentum-Weighted Sobolev Hierarchy Theorem:
    By separating the single physical vacuum ray `ℂ|Ω⟩` from the excited momentum fibers `ℋ_exc`
    (rather than forming the naive full-fiber product `L²(ℝ, dp; ℂ²)` with an infinite-dimensional
    zero-energy vacuum subspace):
    1. Every global state `(c_vac, ψ_exc)` satisfies the relativistic cone bound `⟨Ψ, |P| Ψ⟩ ≤ ⟨Ψ, H Ψ⟩`,
    2. Every vacuum-orthogonal state (`c_vac = 0`) satisfies the global mass-gap bound
       `Δ · ‖Ψ‖_{L²}² ≤ ⟨Ψ, H Ψ⟩`,
    3. The momentum-weighted Sobolev norms form a monotone projective hierarchy `q_n(Ψ)² ≤ q_{n+1}(Ψ)²`, and
    4. Across momentum modes `k → ∞`, both the global energy expectation and the consecutive
       Sobolev norm ratio `q_{n+1}(Ψ)² / q_n(Ψ)²` are strictly unbounded above (proving that
       `q_{n+1}` is not topologically equivalent to `q_n` on the global domain). -/
theorem separatedVacuumRelativisticAssembly_mass_shell_and_sobolev
    {Δ : ℝ} (hΔ : 0 < Δ) (c_vac : ℝ) (ψ_exc : ℕ → ℝ) (N n : ℕ) :
    separatedVacuumMomentumExpectation ψ_exc N ≤ separatedVacuumEnergyExpectation Δ ψ_exc N ∧
    Δ * separatedVacuumSobolevNormSq Δ 0 0 ψ_exc N ≤ separatedVacuumEnergyExpectation Δ ψ_exc N ∧
    separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N ≤
      separatedVacuumSobolevNormSq Δ (n + 1) c_vac ψ_exc N ∧
    (∀ M : ℝ, 0 < M → ∃ (K : ℕ) (ψ_K : ℕ → ℝ),
      separatedVacuumSobolevNormSq Δ 0 0 ψ_K (K + 1) = 1 ∧
      M < separatedVacuumEnergyExpectation Δ ψ_K (K + 1) ∧
      M ^ 2 * separatedVacuumSobolevNormSq Δ n 0 ψ_K (K + 1) <
        separatedVacuumSobolevNormSq Δ (n + 1) 0 ψ_K (K + 1)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · dsimp [separatedVacuumMomentumExpectation, separatedVacuumEnergyExpectation]
    apply Finset.sum_le_sum
    intro k _
    have hk_nonneg : 0 ≤ (k : ℝ) := Nat.cast_nonneg k
    have h_sq : (k : ℝ) ^ 2 ≤ Δ ^ 2 + (k : ℝ) ^ 2 := by nlinarith [sq_nonneg Δ]
    have hk_le : (k : ℝ) ≤ Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2) := by
      calc (k : ℝ)
        _ = Real.sqrt ((k : ℝ) ^ 2) := (Real.sqrt_sq hk_nonneg).symm
        _ ≤ Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2) := Real.sqrt_le_sqrt h_sq
    exact mul_le_mul_of_nonneg_right hk_le (sq_nonneg (ψ_exc k))
  · dsimp [separatedVacuumSobolevNormSq, separatedVacuumEnergyExpectation]
    rw [zero_pow (by decide), zero_add, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro k _
    have h_disp := (relativistic_dispersion_gap_and_unbounded hΔ).1 (k : ℝ)
    simp only [pow_zero, one_mul]
    exact mul_le_mul_of_nonneg_right h_disp (sq_nonneg (ψ_exc k))
  · dsimp [separatedVacuumSobolevNormSq]
    have h_sum_le :
        (∑ k ∈ Finset.range N, ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n * ψ_exc k) ^ 2) ≤
          ∑ k ∈ Finset.range N, ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ (n + 1) * ψ_exc k) ^ 2 := by
      apply Finset.sum_le_sum
      intro k _
      have h_sqrt_nonneg : 0 ≤ Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2) := Real.sqrt_nonneg _
      have h_base : 1 ≤ 1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2) := by linarith
      have h_base_nonneg : 0 ≤ 1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2) := by linarith
      have h_pow : (1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n ≤
          (1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ (n + 1) := by
        rw [pow_succ (1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) n]
        exact le_mul_of_one_le_right (pow_nonneg h_base_nonneg n) h_base
      have h_rewrite1 : ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n * ψ_exc k) ^ 2 =
          ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n) ^ 2 * (ψ_exc k) ^ 2 := by ring
      have h_rewrite2 : ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ (n + 1) * ψ_exc k) ^ 2 =
          ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ (n + 1)) ^ 2 * (ψ_exc k) ^ 2 := by ring
      rw [h_rewrite1, h_rewrite2]
      have h_pow_sq : ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n) ^ 2 ≤
          ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ (n + 1)) ^ 2 :=
        pow_le_pow_left₀ (pow_nonneg h_base_nonneg n) h_pow 2
      exact mul_le_mul_of_nonneg_right h_pow_sq (sq_nonneg (ψ_exc k))
    linarith
  · intro M hM
    let K : ℕ := ⌈M⌉₊ + 1
    let ψ_K : ℕ → ℝ := fun k => if k = K then 1 else 0
    refine ⟨K, ψ_K, ?_, ?_, ?_⟩
    · dsimp [separatedVacuumSobolevNormSq, ψ_K]
      rw [zero_pow (by decide), zero_add]
      have h_mem : K ∈ Finset.range (K + 1) := Finset.mem_range.mpr (Nat.lt_succ_self K)
      rw [Finset.sum_eq_single K]
      · simp
      · intro k _ hkK
        simp [hkK]
      · intro h_absurd
        exact False.elim (h_absurd h_mem)
    · dsimp [separatedVacuumEnergyExpectation, ψ_K]
      have h_mem : K ∈ Finset.range (K + 1) := Finset.mem_range.mpr (Nat.lt_succ_self K)
      rw [Finset.sum_eq_single K]
      · simp only [↓reduceIte, one_pow, mul_one]
        have hK_gt : M < (K : ℝ) := by
          dsimp [K]
          push_cast
          linarith [Nat.le_ceil M]
        have hK_pos : 0 ≤ (K : ℝ) := Nat.cast_nonneg K
        have h_sq : (K : ℝ) ^ 2 ≤ Δ ^ 2 + (K : ℝ) ^ 2 := by nlinarith [sq_nonneg Δ]
        have hK_le_sqrt : (K : ℝ) ≤ Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2) := by
          calc (K : ℝ)
            _ = Real.sqrt ((K : ℝ) ^ 2) := (Real.sqrt_sq hK_pos).symm
            _ ≤ Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2) := Real.sqrt_le_sqrt h_sq
        linarith
      · intro k _ hkK
        simp [hkK]
      · intro h_absurd
        exact False.elim (h_absurd h_mem)
    · dsimp [separatedVacuumSobolevNormSq, ψ_K]
      rw [zero_pow (by decide), zero_add, zero_add]
      have h_mem : K ∈ Finset.range (K + 1) := Finset.mem_range.mpr (Nat.lt_succ_self K)
      rw [Finset.sum_eq_single K, Finset.sum_eq_single K]
      · simp only [↓reduceIte, mul_one]
        have hK_gt : M < (K : ℝ) := by
          dsimp [K]
          push_cast
          linarith [Nat.le_ceil M]
        have hK_pos : 0 ≤ (K : ℝ) := Nat.cast_nonneg K
        have h_sq : (K : ℝ) ^ 2 ≤ Δ ^ 2 + (K : ℝ) ^ 2 := by nlinarith [sq_nonneg Δ]
        have hK_le_sqrt : (K : ℝ) ≤ Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2) := by
          calc (K : ℝ)
            _ = Real.sqrt ((K : ℝ) ^ 2) := (Real.sqrt_sq hK_pos).symm
            _ ≤ Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2) := Real.sqrt_le_sqrt h_sq
        have h_base_gt : M < 1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2) := by linarith
        have h_base_pos : 0 < 1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2) := by linarith
        have h_pow_pos : 0 < ((1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2)) ^ n) ^ 2 :=
          sq_pos_of_pos (pow_pos h_base_pos n)
        have hM_sq_lt : M ^ 2 < (1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2)) ^ 2 :=
          sq_lt_sq.mpr (by rw [abs_of_pos hM, abs_of_pos h_base_pos]; exact h_base_gt)
        have h_rhs_eq : ((1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2)) ^ (n + 1)) ^ 2 =
            (1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2)) ^ 2 *
              ((1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2)) ^ n) ^ 2 := by
          rw [pow_succ (1 + Real.sqrt (Δ ^ 2 + (K : ℝ) ^ 2)) n]
          ring
        rw [h_rhs_eq]
        exact mul_lt_mul_of_pos_right hM_sq_lt h_pow_pos
      · intro k _ hkK
        simp [hkK]
      · intro h_absurd
        exact False.elim (h_absurd h_mem)
      · intro k _ hkK
        simp [hkK]
      · intro h_absurd
        exact False.elim (h_absurd h_mem)

/-- Strict Positive-Definiteness on the Finite-Mode State Domain & Single-Mode Mass-Shell Identity
    (`separatedVacuumSobolevNormSq_pos_def_on_finite_mode_domain`):
    Addresses the truncation kernel on unrestricted sequences `ℕ → ℝ` (`ψ_k = 1_{k=N}`) by proving:
    1. `0 ≤ separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N` for all `c_vac, ψ_exc`,
    2. `separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N = 0 ↔ c_vac = 0 ∧ ∀ k < N, ψ_exc k = 0`,
    3. On the `N`-mode state domain `{ψ : ℕ → ℝ | ∀ k ≥ N, ψ k = 0} ≅ ℝ^N`,
       `separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N = 0 ↔ c_vac = 0 ∧ ∀ k : ℕ, ψ_exc k = 0`
       (strict positive-definiteness with trivial kernel `{(0, 0)}`), and
    4. For any fixed momentum `p : ℝ` and mode amplitude `a : ℝ` (`0 ≤ Δ`), the single-mode
       energy `E = √(Δ² + p²) · a²` and momentum `P = p · a²` satisfy the exact relativistic
       mass-shell identity `E² - P² = Δ² · (a²)²`. -/
theorem separatedVacuumSobolevNormSq_pos_def_on_finite_mode_domain
    (Δ : ℝ) (n : ℕ) (c_vac : ℝ) (ψ_exc : ℕ → ℝ) (N : ℕ) (p a : ℝ) :
    0 ≤ separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N ∧
    (separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N = 0 ↔
      c_vac = 0 ∧ ∀ k < N, ψ_exc k = 0) ∧
    ((∀ k : ℕ, N ≤ k → ψ_exc k = 0) →
      (separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N = 0 ↔
        c_vac = 0 ∧ ∀ k : ℕ, ψ_exc k = 0)) ∧
    (Real.sqrt (Δ ^ 2 + p ^ 2) * a ^ 2) ^ 2 - (p * a ^ 2) ^ 2 = Δ ^ 2 * (a ^ 2) ^ 2 := by
  have h_sum_nonneg :
      0 ≤ ∑ k ∈ Finset.range N, ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n * ψ_exc k) ^ 2 :=
    Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have h_nonneg : 0 ≤ separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N := by
    dsimp [separatedVacuumSobolevNormSq]
    linarith [sq_nonneg c_vac]
  have h_iff_range :
      separatedVacuumSobolevNormSq Δ n c_vac ψ_exc N = 0 ↔
        c_vac = 0 ∧ ∀ k < N, ψ_exc k = 0 := by
    constructor
    · intro h_zero
      dsimp [separatedVacuumSobolevNormSq] at h_zero
      have hc_sq : c_vac ^ 2 = 0 := by linarith [sq_nonneg c_vac, h_sum_nonneg]
      have h_sum_zero :
          ∑ k ∈ Finset.range N, ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n * ψ_exc k) ^ 2 = 0 := by
        linarith
      have hc : c_vac = 0 := sq_eq_zero_iff.mp hc_sq
      refine ⟨hc, ?_⟩
      intro k hk
      have hk_mem : k ∈ Finset.range N := Finset.mem_range.mpr hk
      have h_term_zero :
          ((1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n * ψ_exc k) ^ 2 = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg (fun _ _ => sq_nonneg _)).mp h_sum_zero k hk_mem
      have h_prod_zero : (1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n * ψ_exc k = 0 :=
        sq_eq_zero_iff.mp h_term_zero
      have h_weight_pos : 0 < (1 + Real.sqrt (Δ ^ 2 + (k : ℝ) ^ 2)) ^ n :=
        pow_pos (by linarith [Real.sqrt_nonneg (Δ ^ 2 + (k : ℝ) ^ 2)]) n
      rcases mul_eq_zero.mp h_prod_zero with h_w | h_psi
      · linarith
      · exact h_psi
    · rintro ⟨hc, h_psi⟩
      dsimp [separatedVacuumSobolevNormSq]
      rw [hc, zero_pow (by decide), zero_add]
      apply Finset.sum_eq_zero
      intro k hk
      rw [h_psi k (Finset.mem_range.mp hk), mul_zero, zero_pow (by decide)]
  refine ⟨h_nonneg, h_iff_range, ?_, ?_⟩
  · intro h_supp
    rw [h_iff_range]
    constructor
    · rintro ⟨hc, h_lt⟩
      refine ⟨hc, fun k => ?_⟩
      by_cases hk : k < N
      · exact h_lt k hk
      · exact h_supp k (not_lt.mp hk)
    · rintro ⟨hc, h_all⟩
      exact ⟨hc, fun k _ => h_all k⟩
  · have h_sq_nonneg : 0 ≤ Δ ^ 2 + p ^ 2 := by positivity
    calc (Real.sqrt (Δ ^ 2 + p ^ 2) * a ^ 2) ^ 2 - (p * a ^ 2) ^ 2
      _ = (Real.sqrt (Δ ^ 2 + p ^ 2)) ^ 2 * (a ^ 2) ^ 2 - p ^ 2 * (a ^ 2) ^ 2 := by ring
      _ = (Δ ^ 2 + p ^ 2) * (a ^ 2) ^ 2 - p ^ 2 * (a ^ 2) ^ 2 := by
        rw [Real.sq_sqrt h_sq_nonneg]
      _ = Δ ^ 2 * (a ^ 2) ^ 2 := by ring

/-- Refutation of the Three-State Non-Dispersive Low-Branch Counterexample
    (`three_state_low_branch_counterexample_rejected_by_universal_mass_shell`):
    Consider the three-state operator `H_3(p) = diag(0, Δ, √(Δ² + p²))` on `ℂ³` with vacuum `e_0`,
    constant low-energy excited branch `e_1` (energy `Δ` independent of `p`), and dispersive high
    branch `e_2` (energy `√(Δ² + p²)`), whose vacuum-orthogonal quadratic form is
    `Q_3(p, c_1, c_2) = Δ · c_1² + √(Δ² + p²) · c_2²`.
    1. `Q_3` satisfies the existential mass-shell witness (`∃ (c_1, c_2)` with `c_1² + c_2² = 1`,
       namely `(0, 1)`, such that `√(Δ² + p²) ≤ Q_3(p, c_1, c_2)`),
    2. `Q_3` satisfies the constant rest-gap bound `Δ · (c_1² + c_2²) ≤ Q_3(p, c_1, c_2)` for all `(c_1, c_2)`,
    3. Yet at `Δ = 1, p = 2` on the normalized vacuum-orthogonal low branch `e_1 = (1, 0)`,
       `Q_3(2, 1, 0) = 1 < 2 < √5 = √(1² + 2²)`, so `Q_3` strictly violates the universal
       vacuum-orthogonal mass-shell dispersion bound
       `∀ p c_1 c_2, √(Δ² + p²) · (c_1² + c_2²) ≤ Δ · c_1² + √(Δ² + p²) · c_2²`! -/
theorem three_state_low_branch_counterexample_rejected_by_universal_mass_shell :
    let Q3 (Δ p c1 c2 : ℝ) : ℝ := Δ * c1 ^ 2 + Real.sqrt (Δ ^ 2 + p ^ 2) * c2 ^ 2
    (∀ p : ℝ, ∃ c1 c2 : ℝ, c1 ^ 2 + c2 ^ 2 = 1 ∧ Real.sqrt (1 ^ 2 + p ^ 2) ≤ Q3 1 p c1 c2) ∧
    Q3 1 2 1 0 = 1 ∧
    (1 : ℝ) < 2 ∧
    (2 : ℝ) < Real.sqrt (1 ^ 2 + 2 ^ 2) ∧
    ¬ (∀ p c1 c2 : ℝ,
      Real.sqrt (1 ^ 2 + p ^ 2) * (c1 ^ 2 + c2 ^ 2) ≤ Q3 1 p c1 c2) := by
  intro Q3
  have h2_lt_sqrt5 : (2 : ℝ) < Real.sqrt (1 ^ 2 + 2 ^ 2) := by
    have h4_lt_5 : (2 : ℝ) ^ 2 < 1 ^ 2 + 2 ^ 2 := by norm_num
    calc (2 : ℝ)
      _ = Real.sqrt (2 ^ 2) := (Real.sqrt_sq (by norm_num)).symm
      _ < Real.sqrt (1 ^ 2 + 2 ^ 2) := Real.sqrt_lt_sqrt (by norm_num) h4_lt_5
  refine ⟨?_, ?_, by norm_num, h2_lt_sqrt5, ?_⟩
  · intro p
    refine ⟨0, 1, by norm_num, ?_⟩
    dsimp [Q3]
    linarith
  · dsimp [Q3]
    norm_num
  · intro h_univ
    have h_at_2 := h_univ 2 1 0
    dsimp [Q3] at h_at_2
    linarith

/-- Direct-Integral Relativistic Momentum-Fiber Rigged Hilbert Space (`RelativisticMomentumFiberRHS`):
    Addresses the bounded-operator obstruction of single-norm `Φ →L[ℂ] Φ` interfaces, excludes
    Lebesgue-null-set momentum spikes (`H_spike`), and excludes non-dispersive low-branch states
    (`diag(0, Δ, √(Δ² + p²))`) by decomposing the continuum Hamiltonian across spatial momentum
    fibers `p ∈ ℝ` (`H(p)` with mass-shell dispersion `E(p) = √(Δ_phys² + p²)`), where:
    1. Each fiber `p ∈ ℝ` is governed by a countable graded `SeminormFamily` satisfying
       `IsNuclearContinuous` (`p_n(H(p) ϕ) ≤ C · p_m(ϕ)`),
    2. Every fiber `H(p)` satisfies the uniform vacuum-orthogonal quadratic-form mass gap
       `Δ_phys · ‖i(ϕ)‖² ≤ Re ⟨i(ϕ), i(H(p) ϕ)⟩` with the same rest mass gap `Δ_phys > 0`,
    3. Every vacuum-orthogonal state `ϕ ⊥ Ω` in every fiber `p ∈ ℝ` satisfies the universal
       relativistic mass-shell dispersion lower bound
       `√(Δ_phys² + p²) · ‖i(ϕ)‖² ≤ Re ⟨i(ϕ), i(H(p) ϕ)⟩`,
    4. Every fiber `p ∈ ℝ` possesses a normalized vacuum-orthogonal excited state `‖i(ϕ)‖ = 1`
       with energy `≥ √(Δ_phys² + p²)`, and
    5. For every energy threshold `M ∈ ℝ`, there exists a compact momentum interval `[a, b] ⊂ ℝ`
       of length `b - a ≥ 1` (positive Lebesgue measure `≥ 1 > 0`) on which **every** momentum
       fiber `p ∈ [a, b]` has a normalized vacuum-orthogonal state with energy `> M`. -/
structure RelativisticMomentumFiberRHS (YM : PhysicalYangMillsTriplet) where
  /-- Momentum-indexed family of fiber Hamiltonians `H(p)` for `p ∈ ℝ` -/
  H_fiber : ℝ → (YM.TestSpace →L[ℂ] YM.TestSpace)
  /-- Momentum-indexed family of graded graph-Sobolev seminorms on `YM.TestSpace` -/
  seminorms : ℝ → SeminormFamily YM.TestSpace
  /-- Graded nuclear continuity of `H_fiber p` with respect to `seminorms p` for every `p ∈ ℝ` -/
  H_fiber_nuclear : ∀ p : ℝ, (seminorms p).IsNuclearContinuous (H_fiber p).toLinearMap
  /-- Symmetry of `H_fiber p` on `YM.triplet` for every `p ∈ ℝ` -/
  H_fiber_symmetric : ∀ p : ℝ, YM.triplet.IsSymmetricOn (H_fiber p)
  /-- Non-negativity of the quadratic form of `H_fiber p` for every `p ∈ ℝ` -/
  H_fiber_nonneg : ∀ (p : ℝ) (ϕ : YM.TestSpace),
    0 ≤ (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H_fiber p ϕ))).re
  /-- Unique translation-invariant vacuum state `|Ω⟩ ∈ YM.TestSpace` -/
  vacuum : YM.TestSpace
  vacuum_normalized : ‖YM.triplet.embed vacuum‖ = 1
  vacuum_zero_energy : ∀ p : ℝ, H_fiber p vacuum = 0
  /-- Rest-frame continuum mass gap `Δ_phys > 0` -/
  massGap : ℝ
  massGap_pos : 0 < massGap
  /-- Uniform vacuum-orthogonal quadratic-form mass gap across all momentum fibers `p ∈ ℝ` -/
  uniform_quadratic_mass_gap :
    ∀ (p : ℝ) (ϕ : YM.TestSpace),
      inner (𝕜 := ℂ) (YM.triplet.embed vacuum) (YM.triplet.embed ϕ) = (0 : ℂ) →
      massGap * ‖YM.triplet.embed ϕ‖ ^ 2 ≤
        (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H_fiber p ϕ))).re
  /-- Universal vacuum-orthogonal relativistic mass-shell dispersion lower bound `√(Δ_phys² + p²) · ‖i(ϕ)‖²` -/
  mass_shell_dispersion_lower_bound :
    ∀ (p : ℝ) (ϕ : YM.TestSpace),
      inner (𝕜 := ℂ) (YM.triplet.embed vacuum) (YM.triplet.embed ϕ) = (0 : ℂ) →
      Real.sqrt (massGap ^ 2 + p ^ 2) * ‖YM.triplet.embed ϕ‖ ^ 2 ≤
        (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H_fiber p ϕ))).re
  /-- Pointwise existence of a normalized vacuum-orthogonal excited state at every momentum `p ∈ ℝ` -/
  exists_normalized_excited_state :
    ∀ p : ℝ, ∃ ϕ : YM.TestSpace,
      ‖YM.triplet.embed ϕ‖ = 1 ∧
      inner (𝕜 := ℂ) (YM.triplet.embed vacuum) (YM.triplet.embed ϕ) = (0 : ℂ) ∧
      Real.sqrt (massGap ^ 2 + p ^ 2) ≤
        (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H_fiber p ϕ))).re
  /-- Essential positive-measure interval unboundedness across boost momenta `p ∈ [a, b]` (`b - a ≥ 1`) -/
  essential_interval_unbounded_energy :
    ∀ M : ℝ, ∃ a b : ℝ,
      1 ≤ b - a ∧
      ∀ p : ℝ, a ≤ p → p ≤ b →
        ∃ ϕ : YM.TestSpace,
          ‖YM.triplet.embed ϕ‖ = 1 ∧
          inner (𝕜 := ℂ) (YM.triplet.embed vacuum) (YM.triplet.embed ϕ) = (0 : ℂ) ∧
          M < (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H_fiber p ϕ))).re
  /-- Global unboundedness of the relativistic energy spectrum across boost momenta `p ∈ ℝ` -/
  unbounded_relativistic_energy :
    ∀ M : ℝ, ∃ (p : ℝ) (ϕ : YM.TestSpace),
      ‖YM.triplet.embed ϕ‖ = 1 ∧
      inner (𝕜 := ℂ) (YM.triplet.embed vacuum) (YM.triplet.embed ϕ) = (0 : ℂ) ∧
      M < (inner (𝕜 := ℂ) (YM.triplet.embed ϕ) (YM.triplet.embed (H_fiber p ϕ))).re

/-- Sign Anti-Symmetry of the Centered Smeared-Field State (`centeredFieldState_neg`):
    Negating the smeared field observable `O ↦ -O` negates the vacuum-subtracted centered
    field state `centeredFieldState YM (-O) Ω = - centeredFieldState YM O Ω`. -/
theorem centeredFieldState_neg (YM : PhysicalYangMillsTriplet)
    (O : YM.TestSpace →L[ℂ] YM.TestSpace) (Ω : YM.TestSpace) :
    centeredFieldState YM (-O) Ω = - centeredFieldState YM O Ω := by
  dsimp [centeredFieldState]
  change - (O Ω) - (inner (𝕜 := ℂ) (YM.triplet.embed Ω) (YM.triplet.embed (- (O Ω)))) • Ω =
    - (O Ω - (inner (𝕜 := ℂ) (YM.triplet.embed Ω) (YM.triplet.embed (O Ω))) • Ω)
  rw [map_neg, inner_neg_right, neg_smul]
  abel

/-- Sign-Invariance of Scalar Connected Correlators & Positive-Ray Operator Refutation of `O_{K,m} = -O`
    (`connectedTwoPointCorrelator_neg_and_ray_refutation`):
    1. For any observable `O`, `connectedTwoPointCorrelator YM (-O) Ω = connectedTwoPointCorrelator YM O Ω`
       (the quadratic scalar correlator alone cannot distinguish `O` from `-O`),
    2. Whenever `0 < connectedTwoPointCorrelator YM O Ω`, the operator `O` is non-zero (`O ≠ 0`) and
       the sign-flipped operator `-O` lies at strictly positive operator-norm distance `0 < ‖(-O) - O‖`,
    3. For any `0 < S_inf`, the sign-flipped operator `-O` provably violates the positive-ray operator
       coherence condition `(Real.sqrt S_inf : ℂ) • (-O) = (Real.sqrt S_inf : ℂ) • O`. -/
theorem connectedTwoPointCorrelator_neg_and_ray_refutation
    (YM : PhysicalYangMillsTriplet)
    (O : YM.TestSpace →L[ℂ] YM.TestSpace) (Ω : YM.TestSpace)
    {S_inf : ℝ} (hS_pos : 0 < S_inf)
    (h_corr_pos : 0 < connectedTwoPointCorrelator YM O Ω) :
    connectedTwoPointCorrelator YM (-O) Ω = connectedTwoPointCorrelator YM O Ω ∧
    O ≠ 0 ∧
    0 < ‖(-O) - O‖ ∧
    ¬ ((Real.sqrt S_inf : ℂ) • (-O) = (Real.sqrt S_inf : ℂ) • O) := by
  have h_sign : connectedTwoPointCorrelator YM (-O) Ω = connectedTwoPointCorrelator YM O Ω := by
    dsimp [connectedTwoPointCorrelator]
    rw [centeredFieldState_neg, map_neg, norm_neg]
  have hO_ne : O ≠ 0 := by
    intro h0
    subst h0
    dsimp [connectedTwoPointCorrelator, centeredFieldState] at h_corr_pos
    simp at h_corr_pos
  have h_diff_ne : (-O) - O ≠ 0 := by
    intro h_sub
    have h_two : (2 : ℂ) • O = 0 := by
      have h_neg_two : - ((2 : ℂ) • O) = (-O) - O := by
        rw [two_smul]
        abel
      exact neg_eq_zero.mp (h_neg_two.trans h_sub)
    have h2_ne : (2 : ℂ) ≠ 0 := by norm_num
    exact hO_ne ((smul_eq_zero.mp h_two).resolve_left h2_ne)
  have h_norm_pos : 0 < ‖(-O) - O‖ := norm_pos_iff.mpr h_diff_ne
  refine ⟨h_sign, hO_ne, h_norm_pos, ?_⟩
  intro h_ray
  have h_sqrt_pos : 0 < Real.sqrt S_inf := Real.sqrt_pos.mpr hS_pos
  have h_sqrt_ne : (Real.sqrt S_inf : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt h_sqrt_pos)
  have h_sub_zero : (Real.sqrt S_inf : ℂ) • ((-O) - O) = 0 := by
    rw [smul_sub, h_ray, sub_self]
  exact h_diff_ne ((smul_eq_zero.mp h_sub_zero).resolve_left h_sqrt_ne)

end JesseMath.Physics

